@namespace OAS.Client

<CascadingAuthenticationState>
    <ErrorBoundary>
        <ChildContent>
            <Router AppAssembly="@typeof(ClientAssemblyMarker).Assembly">
                <Found Context="routeData">
                    @if (routeData.PageType.GetCustomAttributes(typeof(AllowAnonymousAttribute), true).Length > 0)
                    {
                        <RouteView RouteData="@routeData" DefaultLayout="@typeof(EmptyLayout)" />
                    }
                    else
                    {
                        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                            <NotAuthorized><RedirectToLogin /></NotAuthorized>
                        </AuthorizeRouteView>
                    }
                </Found>
                <NotFound>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <UiAlert Tone="AlertTone.Warning" Message="Page not found." />
                    </LayoutView>
                </NotFound>
            </Router>
        </ChildContent>
        <ErrorContent Context="renderError">
            <LayoutView Layout="@typeof(EmptyLayout)">
                <UiPage>
                    <UiCard Width="SurfaceWidth.Medium">
                        <UiAlert Tone="AlertTone.Danger" Message="@L["Error_Generic"]" />
                    </UiCard>
                </UiPage>
            </LayoutView>
        </ErrorContent>
    </ErrorBoundary>
</CascadingAuthenticationState>

<UiDialogHost />
<UiSnackbarHost />
