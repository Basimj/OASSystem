@namespace OAS.UiLib.Components.Purchasing
@using OAS.UiLib.Core.Models.Purchasing
@using OAS.UiLib.Core.Models

<UiPurchasingEditorShell Title="@Model.RequestCode" Subtitle="طلب شراء واحتياج تشغيلي" StatusText="@Model.StatusText">
    <UiPurchasingSection Title="البيانات الأساسية">
        <UiPurchasingFormGrid>
            <UiSelect Label="نوع الطلب" Value="@Model.RequestType.ToString()" Options="RequestTypeOptions" Disabled="@(!IsEditable)" OnValueChanged="RequestTypeChanged" />
            <UiLookup Label="المخزن" Required="true" Value="@GuidText(Model.WarehouseId)" SelectedItem="@Selected(Model.WarehouseId,Model.WarehouseName,"fa-solid fa-warehouse")" SearchAsync="WarehouseSearchAsync" ValueChanged="WarehouseChanged" Disabled="@(!IsEditable)" />
            <UiInputDate Label="تاريخ الطلب" Value="@Model.RequestDate" ValueChanged="RequestDateChanged" Disabled="@(!IsEditable)" Required="true" />
            <UiInputDate Label="التاريخ المطلوب" Value="@Model.RequiredDate" ValueChanged="RequiredDateChanged" Disabled="@(!IsEditable)" />
            @if (Model.RequestType == 1)
            {
                <UiInputText Label="مرجع طلب العميل" Value="@(Model.CustomerOrderId?.ToString("D"))" ValueChanged="CustomerOrderChanged" Disabled="@(!IsEditable)" />
            }
            <UiInputText Label="سبب الطلب" Value="@Model.Reason" ValueChanged="ReasonChanged" Disabled="@(!IsEditable)" MaxLength="500" />
            <UiInputText Label="ملاحظات" Value="@Model.Notes" ValueChanged="NotesChanged" Disabled="@(!IsEditable)" MaxLength="1000" />
        </UiPurchasingFormGrid>
    </UiPurchasingSection>
    <UiPurchasingSection Title="بنود الطلب" Subtitle="المنتجات والكميات المطلوبة">
        @if (IsEditable)
        {
            <UiButton Text="إضافة بند" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small" Variant="ButtonVariant.Secondary" OnClick="AddLineAsync" />
        }
        <UiPurchasingLineTable>
            @foreach (var line in Model.Lines.OrderBy(x=>x.LineSequence))
            {
                <div class="ui-purchasing-line-card">
                    <div class="ui-purchasing-line-card__head"><strong>البند @line.LineSequence</strong>@if(IsEditable){<UiButton Text="حذف" IconCssClass="fa-regular fa-trash-can" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="@(_=>RemoveLineAsync(line))" />}</div>
                    <UiPurchasingFormGrid>
                        <UiLookup Label="المنتج" Required="true" Value="@GuidText(line.ProductVariantId)" SelectedItem="@Selected(line.ProductVariantId,line.ProductName,"fa-solid fa-box")" SearchAsync="ProductSearchAsync" ValueChanged="@(v=>ProductChanged(line,v))" Disabled="@(!IsEditable)" />
                        <UiPurchasingNumberField Label="الكمية المطلوبة" Value="@line.RequestedQuantity" ValueChanged="@(v=>LineQuantityChanged(line,v))" Disabled="@(!IsEditable)" />
                        <UiInputDate Label="التاريخ المطلوب" Value="@line.RequiredDate" ValueChanged="@(v=>LineDateChanged(line,v))" Disabled="@(!IsEditable)" />
                        <UiLookup Label="المورد المفضل" Value="@GuidText(line.PreferredSupplierId)" SelectedItem="@Selected(line.PreferredSupplierId,line.PreferredSupplierName,"fa-solid fa-truck-field")" SearchAsync="SupplierSearchAsync" ValueChanged="@(v=>LineSupplierChanged(line,v))" Disabled="@(!IsEditable)" />
                        <UiInputText Label="ملاحظات البند" Value="@line.Notes" ValueChanged="@(v=>LineNotesChanged(line,v))" Disabled="@(!IsEditable)" />
                    </UiPurchasingFormGrid>
                    @if (line.Id.HasValue)
                    {
                        <div class="ui-purchasing-line-card__summary">مخصص لأوامر الشراء: @line.AllocatedQuantity.ToString("N3") · المتبقي: @line.RemainingQuantity.ToString("N3")</div>
                    }
                </div>
            }
        </UiPurchasingLineTable>
    </UiPurchasingSection>
</UiPurchasingEditorShell>

@code {
    [Parameter, EditorRequired] public UiPurchaseRequestEditorModel Model { get; set; }=new();
    [Parameter] public bool IsEditable { get; set; }=true;
    [Parameter] public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? WarehouseSearchAsync { get; set; }
    [Parameter] public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? ProductSearchAsync { get; set; }
    [Parameter] public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? SupplierSearchAsync { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private static readonly IReadOnlyList<UiSelectOption> RequestTypeOptions=[new("1","طلب عميل"),new("2","إعادة تعبئة"),new("3","يدوي")];
    private static string? GuidText(Guid? id)=>id?.ToString("D");
    private static Guid? Parse(string? v)=>Guid.TryParse(v,out var id)?id:null;
    private static UiLookupItem? Selected(Guid? id,string? text,string icon)=>id.HasValue?new(id.Value.ToString("D"),text??id.Value.ToString("D"),null,icon):null;
    private async Task Changed(){await OnChanged.InvokeAsync();}
    private async Task RequestTypeChanged(string? v){if(byte.TryParse(v,out var x))Model.RequestType=x;await Changed();}
    private async Task WarehouseChanged(string? v){Model.WarehouseId=Parse(v);await Changed();}
    private async Task RequestDateChanged(DateOnly? v){if(v.HasValue)Model.RequestDate=v.Value;await Changed();}
    private async Task RequiredDateChanged(DateOnly? v){Model.RequiredDate=v;await Changed();}
    private async Task CustomerOrderChanged(string? v){Model.CustomerOrderId=Parse(v);await Changed();}
    private async Task ReasonChanged(string? v){Model.Reason=v;await Changed();}
    private async Task NotesChanged(string? v){Model.Notes=v;await Changed();}
    private async Task AddLineAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs _){Model.Lines.Add(new(){LineSequence=Model.Lines.Count+1,RequiredDate=Model.RequiredDate});await Changed();}
    private async Task RemoveLineAsync(UiPurchaseRequestLineModel line){Model.Lines.Remove(line);for(var i=0;i<Model.Lines.Count;i++)Model.Lines[i].LineSequence=i+1;await Changed();}
    private async Task ProductChanged(UiPurchaseRequestLineModel l,string? v){l.ProductVariantId=Parse(v);await Changed();}
    private async Task LineQuantityChanged(UiPurchaseRequestLineModel l,decimal v){l.RequestedQuantity=v;await Changed();}
    private async Task LineDateChanged(UiPurchaseRequestLineModel l,DateOnly? v){l.RequiredDate=v;await Changed();}
    private async Task LineSupplierChanged(UiPurchaseRequestLineModel l,string? v){l.PreferredSupplierId=Parse(v);await Changed();}
    private async Task LineNotesChanged(UiPurchaseRequestLineModel l,string? v){l.Notes=v;await Changed();}
}
