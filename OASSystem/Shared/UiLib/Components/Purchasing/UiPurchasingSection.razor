@namespace OAS.UiLib.Components.Purchasing
<section class="ui-purchasing-section"><header><h3>@Title</h3>@if(!string.IsNullOrWhiteSpace(Subtitle)){<small>@Subtitle</small>}</header><div class="ui-purchasing-section__body">@ChildContent</div></section>
@code { [Parameter] public string Title { get; set; } = string.Empty; [Parameter] public string? Subtitle { get; set; } [Parameter] public RenderFragment? ChildContent { get; set; } }
