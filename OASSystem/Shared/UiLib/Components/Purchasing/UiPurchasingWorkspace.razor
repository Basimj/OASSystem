@namespace OAS.UiLib.Components.Purchasing

<UiWorkspaceLayout ShowFilters="false" ShowAside="false" ScrollableMain="true">
    <Actions>@Actions</Actions>
    <Content>
        <div class="ui-purchasing-workspace">
            @Content
        </div>
    </Content>
</UiWorkspaceLayout>

@code {
    [Parameter] public RenderFragment? Actions { get; set; }
    // Kept for compatibility; cross-document tab-strip is intentionally not rendered.
    [Parameter] public RenderFragment? Tabs { get; set; }
    [Parameter, EditorRequired] public RenderFragment? Content { get; set; }
}
