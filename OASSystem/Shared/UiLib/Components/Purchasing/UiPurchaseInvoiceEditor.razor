@using static OAS.UiLib.Core.Formatting.PurchasingDisplayFormat
@namespace OAS.UiLib.Components.Purchasing
@using OAS.UiLib.Core.Models.Purchasing
@using OAS.UiLib.Core.Models

<UiPurchasingEditorShell Title="@Model.PurchaseInvoiceCode" StatusText="@Model.StatusText">
    @if (!string.IsNullOrWhiteSpace(Model.MatchingNotice))
    {
        <div class="alert alert-warning py-2 mb-2 small" role="alert" aria-live="polite">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            @Model.MatchingNotice
        </div>
    }

    @if(Model.Id is null)
    {
        <UiPurchasingSection Title="إنشاء الفاتورة من استلام مرحّل">
            <p class="ui-invoice-help">اختر سند استلام مرحّلًا؛ سنجلب المورد والعملة والأصناف والكميات والأسعار تلقائيًا. لا تحتاج إلى إعادة إدخال البنود.</p>
            <UiLookup UsePopover="true" Label="سند الاستلام" Required="true"
                Value="@GuidText(Model.SourceReceiptId)"
                SelectedItem="@Selected(Model.SourceReceiptId, Model.SourceReceiptCode, "fa-solid fa-truck-ramp-box")"
                SearchAsync="PostedReceiptSearchAsync" ValueChanged="ReceiptChangedAsync"
                Placeholder="ابحث برقم الاستلام أو المورد..."
                EmptyText="لا توجد استلامات مرحلة مطابقة للبحث. رحّل الاستلام أولًا."
                Disabled="@(!IsEditable)" />
            @if(Model.SourceReceiptId.HasValue)
            {
                <div class="ui-invoice-origin" role="status"><i class="fa-solid fa-check-circle" aria-hidden="true"></i>
                    استلام @Model.SourceReceiptCode جاهز. راجع بيانات الفاتورة واحفظها؛ سيحاول النظام مطابقتها تلقائيًا.
                </div>
            }
        </UiPurchasingSection>
    }

    @if(Model.Id.HasValue || Model.SourceReceiptId.HasValue)
    {
        <UiPurchasingSection Title="بيانات الفاتورة">
            <UiPurchasingFormGrid>
                <UiInputText Label="رقم فاتورة المورد (إن وجد)" Value="@Model.SupplierInvoiceCode" ValueChanged="SupplierInvoiceCodeChanged" Disabled="@(!IsEditable)" MaxLength="100" />
                <UiInputText Label="المورد" Value="@Model.SupplierName" ReadOnly="true" />
                <UiInputDate Label="تاريخ الفاتورة" Value="@Model.InvoiceDate" ValueChanged="InvoiceDateChanged" Disabled="@(!IsEditable)" />
                <UiInputDate Label="تاريخ الترحيل" Value="@Model.PostingDate" ValueChanged="PostingDateChanged" Disabled="@(!IsEditable)" />
                <UiInputText Label="العملة" Value="@Model.CurrencyCode" ReadOnly="true" />
            </UiPurchasingFormGrid>
            <details class="ui-purchasing-advanced ui-invoice-advanced">
                <summary>بيانات إضافية: سعر الصرف والضريبة والملاحظات</summary>
                <UiPurchasingFormGrid>
                    <UiPurchasingNumberField Label="سعر الصرف" Value="@Model.ExchangeRate" ValueChanged="ExchangeRateChanged" Disabled="@(!IsEditable)" Step="0.00000001" Min="0.00000001" />
                    <UiInputDate Label="تاريخ سعر الصرف" Value="@Model.ExchangeRateDate" ValueChanged="ExchangeRateDateChanged" Disabled="@(!IsEditable)" />
                    <UiSelect Label="طريقة الضريبة" Value="@Model.TaxCalculationMode.ToString()" Options="TaxModeOptions" Disabled="@(!IsEditable)" OnValueChanged="TaxModeChanged" />
                    <UiInputText Label="ملاحظات" Value="@Model.Notes" ValueChanged="NotesChanged" Disabled="@(!IsEditable)" MaxLength="1000" />
                </UiPurchasingFormGrid>
            </details>
        </UiPurchasingSection>

        <UiPurchasingSection Title="الأصناف والكميات">
            <p class="ui-invoice-help">تم جلب الأصناف من أمر الشراء والاستلام. عدّل السعر أو الكمية فقط إذا اختلفت فاتورة المورد الفعلية. قد تتطلب الفروقات اعتمادًا قبل الترحيل.</p>
            <UiPurchasingLineTable>
                @foreach(var line in Model.Lines.OrderBy(x=>x.LineSequence))
                {
                    <div class="ui-purchasing-invoice-line ui-invoice-simple-line" @key="line">
                        <div class="ui-purchasing-invoice-line__head">
                            <strong>@line.LineSequence — @(line.ProductName ?? "صنف")</strong>
                            @if(IsEditable && Model.Id is null && Model.Lines.Count>1)
                            {
                                <UiButton Text="استبعاد الصنف" IconCssClass="fa-regular fa-trash-can" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="@(_=>RemoveLineAsync(line))" />
                            }
                        </div>
                        <UiPurchasingFormGrid>
                            <UiPurchasingNumberField Label="الكمية" Value="@line.Quantity" ValueChanged="@(v=>QuantityChanged(line,v))" Disabled="@(!IsEditable)" Min="0.001" />
                            <UiPurchasingNumberField Label="سعر الوحدة" Value="@line.UnitPrice" ValueChanged="@(v=>PriceChanged(line,v))" Disabled="@(!IsEditable)" Step="0.0001" Min="0" />
                        </UiPurchasingFormGrid>
                        <details class="ui-purchasing-advanced ui-invoice-line-advanced">
                            <summary>الخصم والضريبة وربط أمر الشراء</summary>
                            <UiPurchasingFormGrid>
                                <UiPurchasingNumberField Label="الخصم" Value="@line.DiscountAmount" ValueChanged="@(v=>DiscountChanged(line,v))" Disabled="@(!IsEditable)" Step="0.0001" />
                                <UiPurchasingNumberField Label="نسبة الضريبة" Value="@line.TaxRate" ValueChanged="@(v=>TaxChanged(line,v))" Disabled="@(!IsEditable)" Step="0.000001" />
                                <UiInputText Label="الربط بالمشتريات" Value="@PurchaseOrderLinkText(line)" ReadOnly="true" />
                            </UiPurchasingFormGrid>
                        </details>
                    </div>
                }
            </UiPurchasingLineTable>
        </UiPurchasingSection>

        <UiPurchasingSection Title="ملخص الفاتورة">
            @if(IsEditable){<p class="ui-invoice-help">الإجماليات الموضحة هنا من آخر تعبئة أو حفظ؛ يتم احتساب المبلغ النهائي بدقة عند الحفظ.</p>}
            <div class="ui-purchasing-invoice-totals">
                <span><small>الصافي</small><strong>@Model.Subtotal.ToString("#,##0.##")</strong></span>
                <span><small>الخصم</small><strong>@Model.DiscountAmount.ToString("#,##0.##")</strong></span>
                <span><small>الضريبة</small><strong>@Model.TaxAmount.ToString("#,##0.##")</strong></span>
                <span><small>الإجمالي</small><strong>@Model.TotalAmount.ToString("#,##0.##")</strong></span>
            </div>
            <p class="ui-invoice-next">@NextActionText</p>
        </UiPurchasingSection>
    }

    @if(ShowPaymentSummary)
    {
        <UiPurchasingSection Title="حالة سداد الفاتورة">
            @if(PaymentSummaryLoading)
            {
                <div class="ui-purchasing-empty">جاري تحميل حالة السداد...</div>
            }
            else if(PaymentTotalAmount.HasValue && PaymentPaidAmount.HasValue && PaymentOutstandingAmount.HasValue)
            {
                <div class="ui-purchasing-invoice-totals">
                    <span><small>إجمالي الفاتورة</small><strong>@FormatPaymentAmount(PaymentTotalAmount.Value)</strong></span>
                    <span><small>المدفوع نقدًا/بنك</small><strong>@FormatPaymentAmount(PaymentPaidAmount.Value)</strong></span>
                    @if(PaymentCreditAmount.HasValue && PaymentCreditAmount.Value > 0m)
                    {
                        <span><small>مرتجعات / ائتمان مطبق</small><strong>@FormatPaymentAmount(PaymentCreditAmount.Value)</strong></span>
                    }
                    <span><small>المتبقي الحقيقي</small><strong>@FormatPaymentAmount(PaymentOutstandingAmount.Value)</strong></span>
                    <span><small>حالة السداد</small><strong>@(string.IsNullOrWhiteSpace(PaymentStatusText) ? "غير محددة" : PaymentStatusText)</strong></span>
                </div>

                @if(PaymentBaseTotalAmount.HasValue)
                {
                    <details class="ui-purchasing-advanced">
                        <summary>التفاصيل المحاسبية بالعملة الأساسية</summary>
                        <div class="ui-purchasing-invoice-totals">
                        <span><small>القيمة التاريخية الأساسية</small><strong>@FormatBaseAmount(PaymentBaseTotalAmount.Value)</strong></span>
                        <span><small>المسدد من حساب المورد</small><strong>@FormatBaseAmount(PaymentAppliedBaseAmount ?? 0m)</strong></span>
                        @if(PaymentCreditBaseAmount is > 0m)
                        {
                            <span><small>ائتمان المورد - أساسي</small><strong>@FormatBaseAmount(PaymentCreditBaseAmount.Value)</strong></span>
                        }
                        <span><small>المتبقي الأساسي</small><strong>@FormatBaseAmount(PaymentOutstandingBaseAmount ?? 0m)</strong></span>
                        @if(PaymentRealizedExchangeDifferenceBase is { } fx && fx != 0m)
                        {
                            <span><small>@(fx > 0m ? "خسارة صرف محققة" : "ربح صرف محقق")</small><strong>@FormatBaseAmount(Math.Abs(fx))</strong></span>
                        }
                        </div>
                    </details>
                }

                @if(PaymentSettlements.Count > 0)
                {
                    <details class="ui-purchasing-advanced">
                        <summary>تفاصيل التسويات وفروق الصرف (@PaymentSettlements.Count)</summary>
                        <UiPurchasingLineTable>
                        @foreach(var settlement in PaymentSettlements.OrderBy(x=>x.AllocatedAtUtc))
                        {
                            <div class="ui-purchasing-invoice-line">
                                <div class="ui-purchasing-invoice-line__head">
                                    <strong>@FormatSettlementTitle(settlement)</strong>
                                    @if(settlement.RealizedExchangeJournalEntryId is Guid fxJournalId)
                                    {
                                        <UiButton Text="عرض قيد فرق الصرف" IconCssClass="fa-solid fa-book-journal-whills" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="@(_=>OpenFxJournalAsync(fxJournalId))" />
                                    }
                                </div>
                                <div class="ui-purchasing-invoice-totals">
                                    <span><small>مبلغ السداد</small><strong>@FormatSettlementSource(settlement)</strong></span>
                                    <span><small>سعر السداد</small><strong>@FormatSettlementRate(settlement)</strong></span>
                                    <span><small>القيمة الأساسية للسداد</small><strong>@FormatBaseAmount(settlement.SourceBaseAmount)</strong></span>
                                    <span><small>المسوى من الفاتورة</small><strong>@FormatPaymentAmount(settlement.TargetDocumentAmount)</strong></span>
                                    <span><small>القيمة التاريخية المسواة</small><strong>@FormatBaseAmount(settlement.TargetBaseAmount)</strong></span>
                                    <span><small>فرق الصرف</small><strong>@FormatFx(settlement.RealizedExchangeDifferenceBase)</strong></span>
                                </div>
                                <small>@FormatSettlementSourceInfo(settlement)</small>
                            </div>
                        }
                        </UiPurchasingLineTable>
                    </details>
                }
            }
            else
            {
                <div class="ui-purchasing-empty">تعذر تحميل ملخص السداد. استخدم زر التحديث لإعادة المحاولة.</div>
            }
        </UiPurchasingSection>
    }

    @if(Model.Match is not null)
    {
        <UiPurchaseMatchPanel Model="@Model.Match" />
        <UiPurchaseVariancePanel Model="@Model.Match" />
    }
</UiPurchasingEditorShell>

@code {
    [Parameter,EditorRequired] public UiPurchaseInvoiceEditorModel Model {get;set;}=new();
    [Parameter] public bool IsEditable {get;set;}=true;
    [Parameter] public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? PostedReceiptSearchAsync {get;set;}
    [Parameter] public EventCallback<Guid?> OnReceiptSelected {get;set;}
    [Parameter] public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? SupplierSearchAsync {get;set;}
    [Parameter] public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? CurrencySearchAsync {get;set;}
    [Parameter] public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? ProductSearchAsync {get;set;}
    [Parameter] public Func<string,int,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? ProductSearchPageAsync {get;set;}
    [Parameter] public bool ShowPaymentSummary {get;set;}
    [Parameter] public bool PaymentSummaryLoading {get;set;}
    [Parameter] public decimal? PaymentTotalAmount {get;set;}
    [Parameter] public decimal? PaymentPaidAmount {get;set;}
    [Parameter] public decimal? PaymentCreditAmount {get;set;}
    [Parameter] public decimal? PaymentOutstandingAmount {get;set;}
    [Parameter] public string? PaymentStatusText {get;set;}
    [Parameter] public decimal? PaymentBaseTotalAmount {get;set;}
    [Parameter] public decimal? PaymentAppliedBaseAmount {get;set;}
    [Parameter] public decimal? PaymentCreditBaseAmount {get;set;}
    [Parameter] public decimal? PaymentOutstandingBaseAmount {get;set;}
    [Parameter] public decimal? PaymentRealizedExchangeDifferenceBase {get;set;}
    [Parameter] public string? PaymentBaseCurrencyCode {get;set;}
    [Parameter] public IReadOnlyList<UiPurchaseInvoicePaymentSettlementModel> PaymentSettlements {get;set;}=Array.Empty<UiPurchaseInvoicePaymentSettlementModel>();
    [Parameter] public EventCallback<Guid> OnOpenFxJournal {get;set;}
    [Parameter] public EventCallback OnChanged {get;set;}
    private string NextActionText => Model.Status switch
    {
        1 when Model.Id is null => "بعد المراجعة اضغط حفظ؛ ستجري محاولة المطابقة مع الاستلام المختار تلقائيًا.",
        1 => "الفاتورة مسودة. إذا اكتملت المطابقة، اضغط تأكيد ثم ترحيل الفاتورة.",
        2 => "الفاتورة مؤكدة. راجع المطابقة ثم اضغط ترحيل الفاتورة.",
        3 => "توجد فروقات تحتاج إلى اعتماد قبل الترحيل.",
        _ => "يمكنك مراجعة حالة الفاتورة والمطابقة من الأزرار أعلى الشاشة."
    };
    private Task ReceiptChangedAsync(string? value)=>OnReceiptSelected.InvokeAsync(Parse(value));
    private static readonly IReadOnlyList<UiSelectOption> TaxModeOptions=[new("1","غير شامل"),new("2","شامل")];
    private static string? GuidText(Guid? id)=>id?.ToString("D"); private static Guid? Parse(string? v)=>Guid.TryParse(v,out var x)?x:null;
    private static UiLookupItem? Selected(Guid? id,string? text,string icon)=>id.HasValue?new(id.Value.ToString("D"),text??id.Value.ToString("D"),null,icon):null;
    private static string PurchaseOrderLinkText(UiPurchaseInvoiceLineModel line)=>line.PurchaseOrderLineId.HasValue?"مرتبط بسطر أمر شراء":"غير مرتبط";
    private string FormatPaymentAmount(decimal value)=>$"{value:#,##0.##} {Model.CurrencyCode}".Trim();
    private string FormatBaseAmount(decimal value)=>$"{value:#,##0.##} {PaymentBaseCurrencyCode}".Trim();
    private static string FormatSettlementSource(UiPurchaseInvoicePaymentSettlementModel x)=>$"{x.SourceAmount:#,##0.##} {x.SourceCurrencyCode}".Trim();
    private static string FormatSettlementRate(UiPurchaseInvoicePaymentSettlementModel x)=>x.SourceExchangeRate.HasValue?x.SourceExchangeRate.Value.ToString("#,##0.########"):"—";
    private string FormatFx(decimal value)=>value==0m?"لا يوجد":$"{(value>0m?"خسارة":"ربح")} {Math.Abs(value):#,##0.##} {PaymentBaseCurrencyCode}".Trim();
    private static string FormatSettlementTitle(UiPurchaseInvoicePaymentSettlementModel x)=>$"تسوية {DisplayDateTime(x.AllocatedAtUtc.ToLocalTime())}";
    private static string FormatSettlementSourceInfo(UiPurchaseInvoicePaymentSettlementModel x)
    {
        var date=DisplayDate(x.SourceExchangeRateDate);
        var type=string.IsNullOrWhiteSpace(x.SourceExchangeRateTypeText)?"—":x.SourceExchangeRateTypeText;
        var source=string.IsNullOrWhiteSpace(x.SourceExchangeRateSourceText)?"—":x.SourceExchangeRateSourceText;
        return $"تاريخ السعر: {date} · النوع: {type} · المصدر: {source}";
    }
    private Task OpenFxJournalAsync(Guid id)=>OnOpenFxJournal.InvokeAsync(id);
    private Task Changed()=>OnChanged.InvokeAsync();
    private async Task SupplierInvoiceCodeChanged(string? v){Model.SupplierInvoiceCode=v;await Changed();}
    private async Task SupplierChanged(string? v){Model.SupplierId=Parse(v);await Changed();}
    private async Task InvoiceDateChanged(DateOnly? v){if(v.HasValue)Model.InvoiceDate=v.Value;await Changed();}
    private async Task PostingDateChanged(DateOnly? v){if(v.HasValue)Model.PostingDate=v.Value;await Changed();}
    private async Task CurrencyChanged(string? v){Model.CurrencyId=Parse(v);await Changed();}
    private async Task ExchangeRateChanged(decimal v){Model.ExchangeRate=v;await Changed();}
    private async Task ExchangeRateDateChanged(DateOnly? v){if(v.HasValue)Model.ExchangeRateDate=v.Value;await Changed();}
    private async Task TaxModeChanged(string? v){if(byte.TryParse(v,out var x))Model.TaxCalculationMode=x;await Changed();}
    private async Task NotesChanged(string? v){Model.Notes=v;await Changed();}
    private async Task AddLineAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs _){Model.Lines.Add(new(){LineSequence=Model.Lines.Count+1});await Changed();}
    private async Task RemoveLineAsync(UiPurchaseInvoiceLineModel l){Model.Lines.Remove(l);for(var i=0;i<Model.Lines.Count;i++)Model.Lines[i].LineSequence=i+1;await Changed();}
    private static void ProductSelectionChanged(UiPurchaseInvoiceLineModel l,UiLookupItem? item)=>l.ProductName=item?.PrimaryText;
    private async Task ProductChanged(UiPurchaseInvoiceLineModel l,string? v){l.ProductVariantId=Parse(v);await Changed();}
    private async Task QuantityChanged(UiPurchaseInvoiceLineModel l,decimal v){l.Quantity=v;await Changed();}
    private async Task PriceChanged(UiPurchaseInvoiceLineModel l,decimal v){l.UnitPrice=v;await Changed();}
    private async Task DiscountChanged(UiPurchaseInvoiceLineModel l,decimal v){l.DiscountAmount=v;await Changed();}
    private async Task TaxChanged(UiPurchaseInvoiceLineModel l,decimal v){l.TaxRate=v;await Changed();}
}
