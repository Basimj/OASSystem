@namespace OAS.UiLib.Components.Purchasing
@using System.Globalization
<div class="ui-purchasing-number">
    @if (!string.IsNullOrWhiteSpace(Label)) { <label>@Label</label> }
    <input type="number" class="@(HasError || _wholeNumberError is not null ? "ui-purchasing-number__invalid" : null)" value="@Value.ToString("0.############################", CultureInfo.InvariantCulture)" min="@Min" step="@(WholeNumbersOnly ? "1" : Step)" inputmode="@(WholeNumbersOnly ? "numeric" : "decimal")" disabled="@Disabled" aria-invalid="@(HasError || _wholeNumberError is not null ? "true" : null)" aria-describedby="@(HasError || _wholeNumberError is not null ? _errorId : null)" @onchange="ChangedAsync" />
    @if (HasError || _wholeNumberError is not null) { <small id="@_errorId" class="ui-purchasing-number__error" role="alert">@(ErrorText ?? _wholeNumberError)</small> }
</div>
@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public decimal Value { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    private readonly string _errorId = $"oas-number-error-{Guid.NewGuid():N}";
    private string? _wholeNumberError;
    private bool HasError => !string.IsNullOrWhiteSpace(ErrorText);
    protected override void OnParametersSet()
    {
        if (!WholeNumbersOnly) _wholeNumberError = null;
    }
    [Parameter] public EventCallback<decimal> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Step { get; set; } = "0.001";
    [Parameter] public bool WholeNumbersOnly { get; set; }
    [Parameter] public string? Min { get; set; } = "0";
    private async Task ChangedAsync(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        if (decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out var value) || decimal.TryParse(raw, out value))
        {
            if (WholeNumbersOnly && value != decimal.Truncate(value))
            {
                _wholeNumberError = OAS.UiLib.Core.Formatting.QuantityInputRules.WholeNumberMessage;
                await ValueChanged.InvokeAsync(value);
                return;
            }
            _wholeNumberError = null;
            await ValueChanged.InvokeAsync(value);
        }
    }
}
