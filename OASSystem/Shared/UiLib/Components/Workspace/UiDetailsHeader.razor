<div class="ui-details-header">
    <UiAvatar Initials="@Initials" ImageUrl="@ImageUrl" AltText="@Title" />
    <div class="ui-details-header__identity">
        <strong>@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <span>@Subtitle</span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(StatusText))
    {
        <UiBadge Text="@StatusText" Tone="@StatusTone" />
    }
</div>
