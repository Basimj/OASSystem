<div class="ui-avatar-editor">
    <div class="ui-avatar-editor__avatar">
        <UiAvatar Initials="@Initials" ImageUrl="@ImageUrl" AltText="@AltText" Size="@Size" />
        @if (!ReadOnly)
        {
            <label class="ui-avatar-editor__edit" title="@EditText">
                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                <InputFile class="ui-avatar-editor__file" accept="@Accept" OnChange="HandleFileAsync" />
            </label>
        }
    </div>
    @if (!ReadOnly && ShowRemove && !string.IsNullOrWhiteSpace(ImageUrl))
    {
        <button type="button" class="ui-avatar-editor__remove" @onclick="RemoveAsync">
            <i class="fa-regular fa-trash-can" aria-hidden="true"></i><span>@RemoveText</span>
        </button>
    }
</div>
