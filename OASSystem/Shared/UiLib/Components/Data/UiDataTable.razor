@typeparam TItem
<div class="@ContainerCssClass">
    <table class="@TableCssClass">
        <thead>
            <tr>
                @if (Headers.Count > 0)
                {
                    @foreach (var header in Headers)
                    {
                        <th scope="col">@header</th>
                    }
                }
                else
                {
                    @foreach (var column in Columns)
                    {
                        <th scope="col">@column.Header</th>
                    }
                }
            </tr>
        </thead>
        <tbody>
            @if (Items.Count == 0)
            {
                <tr>
                    <td colspan="@ColumnCount" class="ui-data-table__empty">@EmptyText</td>
                </tr>
            }
            else
            {
                @foreach (var item in Items)
                {
                    <tr class="@GetRowCss(item)" @onclick="() => HandleRowClickAsync(item)">
                        @if (RowTemplate is not null)
                        {
                            @RowTemplate(item)
                        }
                        else
                        {
                            @foreach (var column in Columns)
                            {
                                <td>@column.ValueSelector(item)</td>
                            }
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
