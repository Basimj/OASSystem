<section class="ui-employee-workspace" dir="rtl">
    @if (Actions is not null)
    {
        <div class="ui-employee-workspace__actions">@Actions</div>
    }
    @if (Tabs is not null)
    {
        <div class="ui-employee-workspace__tabs">@Tabs</div>
    }
    <div class="ui-employee-workspace__content">@Content</div>
</section>
