@namespace OAS.UiLib.Components.Spreadsheets
@if (CanImport)
{
    <UiButton Text="@(Compact ? "استيراد" : "استيراد Excel")" IconCssClass="fa-solid fa-file-import" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="Busy" OnClick="@(_ => OnImport.InvokeAsync())" />
    <UiButton Text="@(Compact ? "القالب" : "تنزيل القالب")" IconCssClass="fa-solid fa-download" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="Busy" OnClick="@(_ => OnTemplate.InvokeAsync())" />
}
<UiButton Text="@(Compact ? "تصدير" : "تصدير Excel")" IconCssClass="fa-solid fa-file-export" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="Busy" OnClick="@(_ => OnExport.InvokeAsync())" />
@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool CanImport { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnImport { get; set; }
    [Parameter] public EventCallback OnTemplate { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
}
