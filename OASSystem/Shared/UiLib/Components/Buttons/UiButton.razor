<button type="@Type"
        class="@ButtonCssClass"
        disabled="@(Disabled || Loading)"
        aria-busy="@Loading.ToString().ToLowerInvariant()"
        @onclick="HandleClickAsync"
        @attributes="SafeAdditionalAttributes">
    @if (Loading)
    {
        <span class="ui-button__spinner" aria-hidden="true"></span>
        <span>@L["Loading"]</span>
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (!string.IsNullOrWhiteSpace(TextResourceKey))
    {
        @L[TextResourceKey]
    }
    else
    {
        @Text
    }
</button>
