@namespace OAS.UiLib.Components.Optical
@using OAS.UiLib.Core.Models.Sales
@using OAS.UiLib.Core.Models

<div class="oas-lab oas-lab-list" dir="rtl">
    <div class="oas-lab-heading"><div><h2><i class="fa-solid fa-glasses"></i> أوامر المعمل</h2><p>متابعة أوامر المعمل وحالات التنفيذ — دون بيانات مالية</p></div><span class="oas-lab-route">المبيعات / المعمل / أوامر المعمل</span></div>
    <div class="oas-lab-metrics" aria-label="حالات الأوامر في الصفحة الحالية">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="oas-lab-metric @(Filter.Status == metric.Key ? "is-selected" : "")" @onclick="() => TabSelectedAsync(metric.Key)">
                <span>@metric.Title</span><strong>@Count(metric.Key)</strong><small>في الصفحة الحالية</small>
            </button>
        }
    </div>
    <div class="oas-lab-status-tabs" role="tablist" aria-label="حالة أمر المعمل">
        @foreach (var tab in Tabs)
        {
            <button type="button" role="tab" aria-selected="@(Filter.Status == tab.Key)" class="@(Filter.Status == tab.Key ? "active" : "")" @onclick="() => TabSelectedAsync(tab.Key)">@tab.Title</button>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(ErrorText)) { <div class="oas-lab-notice" role="alert">@ErrorText</div> }
    <section class="oas-lab-card oas-lab-filters">
        <div class="oas-lab-filter-top">
            <div class="oas-lab-search"><UiSearchInput Value="@Filter.Search" ValueChanged="v => Filter.Search = v" OnSearch="_ => OnApplyFilters.InvokeAsync()" Placeholder="بحث برقم أمر المعمل أو الطلب أو العميل أو الجوال" /></div>
            <UiButton Text="بحث وتحديث" IconCssClass="fa-solid fa-magnifying-glass" Size="ControlSize.Small" Loading="@IsBusy" OnClick="_ => OnApplyFilters.InvokeAsync()" />
            <UiButton Text="مسح الفلاتر" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="_ => OnClearFilters.InvokeAsync()" />
        </div>
        <div class="oas-lab-filter-secondary">
            <UiLookup Label="الفني" Value="@Filter.TechnicianId" SelectedItem="@TechnicianFilterItem" SearchAsync="SearchTechniciansAsync" ValueChanged="TechnicianFilterChangedAsync" Placeholder="كل الفنيين" />
            <label>موعد الإنجاز من <UiInputDate Value="@Filter.RequiredDateFrom" ValueChanged="RequiredDateFromChangedAsync" /></label>
            <label>إلى <UiInputDate Value="@Filter.RequiredDateTo" ValueChanged="RequiredDateToChangedAsync" /></label>
            <label>الكسر<select class="form-select form-select-sm" value="@FlagValue(Filter.HasBreakage)" @onchange="BreakageFilterChangedAsync"><option value="">كل الحالات</option><option value="true">يوجد كسر مفتوح</option><option value="false">دون كسر مفتوح</option></select></label>
            <label>إعادة التصنيع<select class="form-select form-select-sm" value="@FlagValue(Filter.HasRemake)" @onchange="RemakeFilterChangedAsync"><option value="">كل الحالات</option><option value="true">إعادة مفتوحة</option><option value="false">دون إعادة مفتوحة</option></select></label>
        </div>
    </section>
    <section class="oas-lab-card oas-lab-table-card">
        <div class="oas-lab-card-title"><h3>قائمة أوامر المعمل</h3><span>إجمالي النتائج المطابقة: @TotalCount</span></div>
        <div class="oas-lab-table-wrap">
            <table class="oas-lab-table"><thead><tr><th>أمر المعمل</th><th>طلب العميل</th><th>العميل</th><th>الإطار</th><th>الفني</th><th>موعد الإنجاز</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>
            @if (Rows.Count == 0)
            {
                <tr><td colspan="8" class="oas-lab-empty">@(IsBusy ? "جارٍ تحميل الأوامر..." : "لا توجد أوامر معمل تطابق البحث الحالي")</td></tr>
            }
            else
            {
                @foreach (var row in Rows)
                {
                    <tr @key="row.Id">
                        <td><strong>@row.JobCode</strong>@if(row.HasOpenBreakage){<span class="oas-lab-alert" title="يوجد كسر مفتوح"> ⚠</span>}@if(row.HasOpenRemake){<span class="oas-lab-alert" title="إعادة تصنيع مفتوحة"> ↻</span>}</td>
                        <td>@(row.OrderCode ?? "—")</td><td>@row.CustomerText</td><td>@(row.Frame ?? "—")</td><td>@(row.Technician ?? "غير معيّن")</td><td>@(row.RequiredDate ?? "—")</td>
                        <td><span class="ui-sales-status @row.StatusCss">@row.StatusText</span></td>
                        <td><button class="oas-lab-link" type="button" @onclick="() => OnOpen.InvokeAsync(row)">فتح التصنيع <i class="fa-solid fa-arrow-up-right-from-square"></i></button></td>
                    </tr>
                }
            }
            </tbody></table>
        </div>
        <div class="oas-lab-table-footer">
            <label>عدد الأوامر في الصفحة <select class="form-select form-select-sm" value="@PageSize" @onchange="PageSizeChangedAsync"><option value="5">5</option><option value="10">10</option><option value="15">15</option><option value="25">25</option></select></label>
            <span>صفحة @PageNumber من @Math.Max(1,TotalPages) — إجمالي @TotalCount</span>
            <div><button type="button" disabled="@(PageNumber <= 1 || IsBusy)" @onclick="() => OnPrevious.InvokeAsync()">السابق</button><button type="button" disabled="@(PageNumber >= TotalPages || IsBusy)" @onclick="() => OnNext.InvokeAsync()">التالي</button></div>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public UiOpticalJobFilterModel Filter { get; set; } = new();
    [Parameter] public IReadOnlyList<UiOpticalJobRowModel> Rows { get; set; } = [];
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public int PageNumber { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? SearchTechniciansAsync { get; set; }
    [Parameter] public EventCallback OnApplyFilters { get; set; }
    [Parameter] public EventCallback OnClearFilters { get; set; }
    [Parameter] public EventCallback<string> OnTabSelected { get; set; }
    [Parameter] public EventCallback<UiOpticalJobRowModel> OnOpen { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }

    // Counts are explicitly page-level. Never describe them as entire-database totals.
    private string Count(string status) => !string.IsNullOrEmpty(Filter.Status) && Filter.Status != status ? "—" : (string.IsNullOrEmpty(status) ? Rows.Count : Rows.Count(r => r.StatusKey == status)).ToString();
    private static readonly (string Key, string Title)[] Metrics = [
        ("", "المعروضة"), ("AwaitingMaterials", "بانتظار مواد"), ("MaterialsAvailable", "مواد متوفرة"),
        ("InProduction", "قيد التصنيع"), ("AwaitingQC", "بانتظار الجودة"), ("ReadyForDelivery", "جاهزة للتسليم")];
    private static readonly (string Key, string Title)[] Tabs = [
        ("", "الكل"), ("Approved", "معتمد"), ("AwaitingMaterials", "بانتظار مواد"),
        ("MaterialsAvailable", "مواد متوفرة"), ("MaterialsIssued", "مواد مصروفة"),
        ("InProduction", "قيد التصنيع"), ("AwaitingQC", "بانتظار الجودة"),
        ("QCPassed", "اجتاز الجودة"), ("ReadyForDelivery", "جاهز للتسليم"), ("Delivered", "تم التسليم"), ("Cancelled", "ملغى")];
    private UiLookupItem? TechnicianFilterItem => string.IsNullOrWhiteSpace(Filter.TechnicianId) || string.IsNullOrWhiteSpace(Filter.TechnicianDisplay) ? null : new(Filter.TechnicianId, Filter.TechnicianDisplay, null, "fa-solid fa-user-gear");
    private Task TabSelectedAsync(string key) => OnTabSelected.InvokeAsync(key);
    private async Task TechnicianFilterChangedAsync(string? id) { Filter.TechnicianId = id ?? ""; Filter.TechnicianDisplay = null; await OnApplyFilters.InvokeAsync(); }
    private async Task RequiredDateFromChangedAsync(DateOnly? date) { Filter.RequiredDateFrom = date; await OnApplyFilters.InvokeAsync(); }
    private async Task RequiredDateToChangedAsync(DateOnly? date) { Filter.RequiredDateTo = date; await OnApplyFilters.InvokeAsync(); }
    private async Task BreakageFilterChangedAsync(ChangeEventArgs e) { Filter.HasBreakage = ParseFlag(e.Value?.ToString()); await OnApplyFilters.InvokeAsync(); }
    private async Task RemakeFilterChangedAsync(ChangeEventArgs e) { Filter.HasRemake = ParseFlag(e.Value?.ToString()); await OnApplyFilters.InvokeAsync(); }
    private Task PageSizeChangedAsync(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var size) ? OnPageSizeChanged.InvokeAsync(size) : Task.CompletedTask;
    private static bool? ParseFlag(string? s) => s == "true" ? true : s == "false" ? false : null;
    private static string FlagValue(bool? x) => x.HasValue ? (x.Value ? "true" : "false") : "";
}
