@namespace OAS.UiLib.Components.Optical
@using OAS.UiLib.Core.Models.Sales

<div class="ui-sales-workspace" dir="rtl">
    <UiSectionTabStrip Tabs="@Tabs" OnSelect="TabSelectedAsync" />
    <UiWorkspaceFilterBar Compact="true">
        <UiSearchInput Value="@Filter.Search" ValueChanged="v => Filter.Search=v" OnSearch="_ => OnApplyFilters.InvokeAsync()" Placeholder="Job / الطلب / العميل" />
        <UiLookup Value="@Filter.TechnicianId" SelectedItem="@TechnicianFilterItem" SearchAsync="SearchTechniciansAsync" ValueChanged="TechnicianFilterChangedAsync" Placeholder="الفني" />
        <UiInputDate Value="@Filter.RequiredDate" ValueChanged="RequiredDateChangedAsync" />
        <UiButton Text="مسح الفلاتر" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="_ => OnClearFilters.InvokeAsync()" />
        <UiButton Text="تحديث" Variant="ButtonVariant.Secondary" IconCssClass="fa-solid fa-rotate" Size="ControlSize.Small" Loading="@IsBusy" OnClick="_ => OnApplyFilters.InvokeAsync()" />
    </UiWorkspaceFilterBar>
    @if(!string.IsNullOrWhiteSpace(ErrorText)){<UiAlert Tone="AlertTone.Danger">@ErrorText</UiAlert>}
    @if(!string.IsNullOrWhiteSpace(SuccessText)){<UiAlert Tone="AlertTone.Success">@SuccessText</UiAlert>}
    <UiDataGridPanel Title="المعمل" Subtitle="طابور العمل الفني بدون أية بيانات مالية.">
        <Body>
            <UiDataTable TItem="UiOpticalJobRowModel" Items="@Rows" Headers="@Headers" Compact="true" OnRowClick="@((UiOpticalJobRowModel row) => OpenAsync(row))" EmptyText="لا توجد Jobs مطابقة للفلاتر.">
                <RowTemplate Context="row">
                    <td><strong>@row.JobCode</strong></td><td>@(row.OrderCode ?? "—")</td><td>@row.CustomerText<br/><small>@(row.Mobile ?? "—")</small></td><td>@(row.RequiredDate ?? "—")</td>
                    <td>@(row.Frame ?? "—")</td><td>@(row.OD ?? "—")</td><td>@(row.OS ?? "—")</td><td>@(row.Technician ?? "—")</td><td><span class="ui-sales-status @row.StatusCss">@row.StatusText</span></td>
                </RowTemplate>
            </UiDataTable>
        </Body>
        <Footer><UiPagination PageNumber="@PageNumber" TotalPages="@TotalPages" TotalCount="@TotalCount" OnPrevious="OnPrevious" OnNext="OnNext" /></Footer>
    </UiDataGridPanel>
</div>

@if(Selected is not null)
{
    <div class="ui-workflow-drawer-backdrop" @onclick="CloseAsync"></div>
    <aside class="ui-workflow-drawer" dir="rtl">
        <header class="ui-workflow-drawer__header"><div><strong>@Selected.JobCode</strong><span>@Selected.CustomerText • @(Selected.Mobile ?? "—")</span></div><button type="button" @onclick="CloseAsync">×</button></header>
        <div class="ui-workflow-drawer__body">
            <div class="ui-workflow-detail-grid"><span>الطلب<strong>@(Selected.OrderCode ?? "—")</strong></span><span>الموعد<strong>@(Selected.RequiredDate ?? "—")</strong></span><span>الحالة<strong>@Selected.StatusText</strong></span><span>الفني<strong>@(Selected.Technician ?? "—")</strong></span></div>
            <UiLookup Label="تعيين الفني" Value="@Selected.TechnicianId" SelectedItem="@SelectedTechnicianItem" SearchAsync="SearchTechniciansAsync" ValueChanged="SelectedTechnicianChangedAsync" />
            <section><h4>مواد ومواصفات العمل</h4><UiDataTable Items="@Selected.Lines" Headers="@LineHeaders" Compact="true"><RowTemplate Context="line"><td>@line.LineNumber</td><td>@line.TypeText</td><td>@line.ProductText</td><td>@(line.EyeText ?? "—")</td><td>@line.Quantity.ToString("N3")</td><td>@(line.OpticalSummary ?? "—")</td><td>@(line.Notes ?? "—")</td></RowTemplate></UiDataTable></section>
        </div>
        <footer class="ui-workflow-drawer__footer">
            <UiButton Text="حفظ الفني" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Loading="@IsBusy" OnClick="_ => OnAssign.InvokeAsync()" />
            @if(Selected.StatusKey is "MaterialsAvailable" or "MaterialsIssued")
            {<UiButton Text="بدء العمل" IconCssClass="fa-solid fa-play" Size="ControlSize.Small" Loading="@IsBusy" OnClick="_ => OnStart.InvokeAsync()" />}
            @if(Selected.StatusKey is "InProduction" or "AwaitingQC" or "QCPassed")
            {<UiButton Text="جاهز للتسليم" IconCssClass="fa-solid fa-circle-check" Size="ControlSize.Small" Loading="@IsBusy" OnClick="_ => OnReady.InvokeAsync()" />}
        </footer>
    </aside>
}

@code{
    [Parameter,EditorRequired] public UiOpticalJobFilterModel Filter{get;set;}=new();[Parameter] public IReadOnlyList<UiOpticalJobRowModel> Rows{get;set;}=[];[Parameter] public UiOpticalJobDetailsModel? Selected{get;set;}[Parameter] public bool IsBusy{get;set;}[Parameter] public string? ErrorText{get;set;}[Parameter] public string? SuccessText{get;set;}
    [Parameter] public int PageNumber{get;set;}=1;[Parameter] public int TotalPages{get;set;}[Parameter] public long TotalCount{get;set;}[Parameter] public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? SearchTechniciansAsync{get;set;}
    [Parameter] public EventCallback OnApplyFilters{get;set;}[Parameter] public EventCallback OnClearFilters{get;set;}[Parameter] public EventCallback<string> OnTabSelected{get;set;}[Parameter] public EventCallback<UiOpticalJobRowModel> OnOpen{get;set;}[Parameter] public EventCallback OnCloseDetails{get;set;}[Parameter] public EventCallback OnAssign{get;set;}[Parameter] public EventCallback OnStart{get;set;}[Parameter] public EventCallback OnReady{get;set;}[Parameter] public EventCallback OnPrevious{get;set;}[Parameter] public EventCallback OnNext{get;set;}
    private static readonly IReadOnlyList<string> Headers=["Job","الطلب","العميل","الموعد","الإطار","OD","OS","الفني","الحالة"];private static readonly IReadOnlyList<string> LineHeaders=["#","النوع","الصنف","العين","الكمية","المواصفات","ملاحظات"];
    private IReadOnlyList<UiSectionTabItem> Tabs=>new[]{("","الكل"),("AwaitingMaterials","بانتظار مواد"),("MaterialsAvailable","جاهز للبدء"),("InProduction","قيد العمل"),("ReadyForDelivery","جاهز للتسليم")}.Select(x=>new UiSectionTabItem(x.Item1,x.Item2,string.Equals(Filter.Status,x.Item1,StringComparison.OrdinalIgnoreCase))).ToArray();
    private UiLookupItem? TechnicianFilterItem=>Item(Filter.TechnicianId,Filter.TechnicianDisplay);private UiLookupItem? SelectedTechnicianItem=>Item(Selected?.TechnicianId,Selected?.Technician);private static UiLookupItem? Item(string? id,string? text)=>string.IsNullOrWhiteSpace(id)||string.IsNullOrWhiteSpace(text)?null:new(id,text,null,"fa-solid fa-user-gear");
    private Task OpenAsync(UiOpticalJobRowModel row)=>OnOpen.InvokeAsync(row);private Task CloseAsync()=>OnCloseDetails.InvokeAsync();private Task TabSelectedAsync(string key){Filter.Status=key;return OnTabSelected.InvokeAsync(key);}private async Task TechnicianFilterChangedAsync(string? v){Filter.TechnicianId=v??"";Filter.TechnicianDisplay=null;await OnApplyFilters.InvokeAsync();}private async Task RequiredDateChangedAsync(DateOnly? v){Filter.RequiredDate=v;await OnApplyFilters.InvokeAsync();}private Task SelectedTechnicianChangedAsync(string? v){if(Selected is not null){Selected.TechnicianId=v??"";Selected.Technician=null;}return Task.CompletedTask;}
}
