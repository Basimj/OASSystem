@inherits InputBase<DateOnly?>

<div class="ui-input-date">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <UiTextLabel For="@InputId" Text="@Label" Required="@Required" Size="@Size" />
    }
    <input id="@InputId"
           type="date"
           class="@InputCssClass"
           value="@CurrentValueAsString"
           @onchange="HandleChange"
           disabled="@Disabled"
           readonly="@ReadOnly"
           required="@(Required && EnableNativeValidation)"
           aria-required="@Required.ToString().ToLowerInvariant()"
           aria-invalid="@AriaInvalid"
           aria-describedby="@(HasError ? ErrorId : null)" />
    @if (HasError)
    {
        <div id="@ErrorId" class="ui-input-date__error" role="alert">@ErrorText</div>
    }
</div>
