@inherits InputBase<string?>
<div class="ui-input-text">
    @if (!string.IsNullOrWhiteSpace(Label) || !string.IsNullOrWhiteSpace(LabelResourceKey))
    {
        <UiTextLabel For="@InputId" Text="@Label" TextResourceKey="@LabelResourceKey" Required="@Required" Size="@Size" />
    }
    <div class="ui-input-text__field">
        <input id="@InputId"
               type="@EffectiveType"
               class="@InputCssClass"
               value="@CurrentValueAsString"
               placeholder="@ResolvedPlaceholder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               required="@(Required && EnableNativeValidation)"
               aria-required="@Required.ToString().ToLowerInvariant()"
               maxlength="@MaxLength"
               autocomplete="@AutoComplete"
               inputmode="@InputMode"
               @oninput="HandleInput"
               @attributes="SafeAdditionalAttributes" />
        @if (CanRevealPassword)
        {
            <button type="button"
                    class="ui-input-text__reveal"
                    disabled="@Disabled"
                    aria-label="@RevealButtonLabel"
                    aria-pressed="@_passwordRevealed.ToString().ToLowerInvariant()"
                    @onclick="TogglePasswordVisibility">
                @if (_passwordRevealed)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M3 3l18 18M10.7 10.7a2 2 0 002.6 2.6M9.9 4.2A10.8 10.8 0 0112 4c5.5 0 9.5 4.7 10 6-.3.8-1.8 2.8-4 4.3M6.2 6.2C3.8 7.7 2.3 9.7 2 10.5 2.5 11.8 6.5 16 12 16c1 0 2-.2 2.9-.5" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M2 12s3.7-6 10-6 10 6 10 6-3.7 6-10 6S2 12 2 12z" />
                        <circle cx="12" cy="12" r="2.5" />
                    </svg>
                }
            </button>
        }
    </div>
    @if (ShowValidationMessage && ValueExpression is not null)
    {
        <ValidationMessage For="@ValueExpression" />
    }
</div>
