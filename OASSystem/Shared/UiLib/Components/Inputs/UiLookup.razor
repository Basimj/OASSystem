@namespace OAS.UiLib.Components.Inputs
@using System.Threading
@implements IAsyncDisposable

<div class="ui-lookup">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="ui-lookup__label">
            @Label
            @if (Required)
            {
                <span class="ui-lookup__required">*</span>
            }
        </label>
    }

    @if (UsePopover)
    {
        @* Popovers are placed in the browser top layer, avoiding clipping by purchase-workspace containers. *@
        <button type="button" class="@PopoverTriggerClass" disabled="@Disabled"
                aria-invalid="@(HasError ? "true" : null)" aria-describedby="@(HasError ? _errorId : null)"
                popovertarget="@_popoverId" aria-haspopup="dialog" aria-controls="@_popoverId"
                @onclick="OpenPopoverAsync">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="ui-lookup__popover-value">@(!string.IsNullOrWhiteSpace(Value) ? SelectedItem?.PrimaryText ?? _query : Placeholder)</span>
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        <div id="@_popoverId" class="ui-lookup__popover" popover="auto" role="dialog"
             aria-label="@(string.IsNullOrWhiteSpace(Label) ? "اختيار عنصر" : $"اختيار {Label}")" dir="rtl">
            <div class="ui-lookup__popover-header">
                <strong>@(string.IsNullOrWhiteSpace(Label) ? "اختر عنصرًا" : $"اختر {Label}")</strong>
                <button type="button" class="ui-lookup__popover-close" popovertarget="@_popoverId"
                        popovertargetaction="hide" aria-label="إغلاق القائمة">×</button>
            </div>
            <input type="search" class="ui-lookup__popover-search" value="@_query" autofocus
                   placeholder="@Placeholder" aria-label="البحث في @Label" autocomplete="off"
                   @oninput="HandlePopoverInputAsync" />
            <div class="ui-lookup__popover-options" tabindex="0" role="group" aria-label="خيارات @Label"
                 @onwheel:stopPropagation="true" @ontouchmove:stopPropagation="true">
                @if (_loading)
                {
                    <div class="ui-lookup__empty">جاري البحث...</div>
                }
                else if (_items.Count == 0)
                {
                    <div class="ui-lookup__empty">@EmptyText</div>
                }
                else
                {
                    @foreach (var item in _items)
                    {
                        <button type="button" @key="item.Value" class="ui-lookup__item"
                                disabled="@item.Disabled" popovertarget="@_popoverId"
                                popovertargetaction="hide" @onclick="() => SelectAsync(item)">
                            @if (!string.IsNullOrWhiteSpace(item.IconCssClass))
                            {
                                <i class="@item.IconCssClass" aria-hidden="true"></i>
                            }
                            <span class="ui-lookup__item-text">
                                <strong>@item.PrimaryText</strong>
                                @if (!string.IsNullOrWhiteSpace(item.SecondaryText))
                                {
                                    <small>@item.SecondaryText</small>
                                }
                            </span>
                        </button>
                    }
                    @if (SearchPageAsync is not null && _hasMore)
                    {
                        <button type="button" class="ui-lookup__more" disabled="@_loadingMore"
                                @onclick="LoadMoreAsync">@(_loadingMore ? "جاري تحميل المزيد..." : "عرض المزيد من المنتجات")</button>
                    }
                }
            </div>
            <div class="ui-lookup__popover-footer">
                <span>النتائج المعروضة: @_items.Count</span>
                @if (!string.IsNullOrWhiteSpace(Value))
                {
                    <button type="button" popovertarget="@_popoverId" popovertargetaction="hide"
                            class="ui-lookup__popover-clear" @onclick="ClearAsync">مسح الاختيار</button>
                }
            </div>
        </div>
    }
    else
    {
    <div class="@RootClass">
        <i class="ui-lookup__search-icon fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input class="ui-lookup__input"
               aria-invalid="@(HasError ? "true" : null)" aria-describedby="@(HasError ? _errorId : null)"
               value="@_query"
               placeholder="@Placeholder"
               disabled="@Disabled"
               autocomplete="off"
               aria-label="@AriaLabel"
               @oninput="HandleInputAsync"
               @onfocus="HandleFocusAsync"
               @onkeydown="HandleKeyDownAsync" />

        @if (_loading)
        {
            <i class="ui-lookup__spinner fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i>
        }
        else if (!Disabled && !string.IsNullOrWhiteSpace(Value))
        {
            <button type="button"
                    class="ui-lookup__clear"
                    title="@ClearText"
                    aria-label="@ClearText"
                    @onclick="ClearAsync">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        }
    </div>

    @if (_open && !Disabled)
    {
        <div class="ui-lookup__results"
             tabindex="0"
             @onwheel:stopPropagation="true"
             @ontouchmove:stopPropagation="true">
            @if (_loading)
            {
                <div class="ui-lookup__empty">جاري البحث...</div>
            }
            else if (_items.Count == 0)
            {
                <div class="ui-lookup__empty">@EmptyText</div>
            }
            else
            {
                @foreach (var item in _items)
                {
                    <button type="button"
                            class="ui-lookup__item"
                            disabled="@item.Disabled"
                            @onclick="() => SelectAsync(item)">
                        @if (!string.IsNullOrWhiteSpace(item.IconCssClass))
                        {
                            <i class="@item.IconCssClass" aria-hidden="true"></i>
                        }
                        <span class="ui-lookup__item-text">
                            <strong>@item.PrimaryText</strong>
                            @if (!string.IsNullOrWhiteSpace(item.SecondaryText))
                            {
                                <small>@item.SecondaryText</small>
                            }
                        </span>
                    </button>
                }
            }
        </div>
    }
    }
    @if (HasError)
    {
        <div id="@_errorId" class="ui-lookup__error" role="alert">@ErrorText</div>
    }
</div>

@code {
    private readonly List<UiLookupItem> _items = [];
    private readonly string _errorId = $"oas-lookup-error-{Guid.NewGuid():N}";
    private readonly string _popoverId = $"oas-lookup-options-{Guid.NewGuid():N}";
    private int _nextSkip;
    private bool _hasMore;
    private bool _loadingMore;
    private CancellationTokenSource? _searchCts;
    private string _query = string.Empty;
    private bool _open;
    private bool _loading;
    private string? _lastExternalValue;
    private long _searchVersion;
    private bool _disposed;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback<UiLookupItem?> SelectedItemChanged { get; set; }
    [Parameter] public UiLookupItem? SelectedItem { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchAsync { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string Placeholder { get; set; } = "ابحث...";
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string EmptyText { get; set; } = "لا توجد نتائج.";
    [Parameter] public string ClearText { get; set; } = "مسح الاختيار";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public int DebounceMilliseconds { get; set; } = 250;
    [Parameter] public int MinimumSearchLength { get; set; } = 0;
    [Parameter] public bool UsePopover { get; set; }
    [Parameter] public int PageSize { get; set; } = 30;
    [Parameter] public Func<string, int, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchPageAsync { get; set; }

    private bool HasError => !string.IsNullOrWhiteSpace(ErrorText);
    private string PopoverTriggerClass => HasError
        ? "ui-lookup__popover-trigger ui-lookup__popover-trigger--invalid"
        : "ui-lookup__popover-trigger";
    private string RootClass =>
        $"ui-lookup__control{(Disabled ? " ui-lookup__control--disabled" : string.Empty)}{(HasError ? " ui-lookup__control--invalid" : string.Empty)}";

    protected override void OnParametersSet()
    {
        if (string.Equals(_lastExternalValue, Value, StringComparison.Ordinal))
            return;

        _lastExternalValue = Value;

        if (string.IsNullOrWhiteSpace(Value))
        {
            _query = string.Empty;
        }
        else if (SelectedItem is not null &&
                 string.Equals(SelectedItem.Value, Value, StringComparison.Ordinal))
        {
            _query = SelectedItem.PrimaryText;
        }
    }

    private Task OpenPopoverAsync()
    {
        // Always start with all available items rather than searching with a selected item's name.
        _query = string.Empty;
        return QueueSearchAsync(string.Empty);
    }

    private Task HandlePopoverInputAsync(ChangeEventArgs args)
    {
        // Searching does not clear the previously selected value until a new choice is made.
        _query = args.Value?.ToString() ?? string.Empty;
        return QueueSearchAsync(_query);
    }

    private async Task LoadMoreAsync()
    {
        if (_disposed || _loading || _loadingMore || !_hasMore || SearchPageAsync is null)
            return;

        var version = Volatile.Read(ref _searchVersion);
        var skip = _nextSkip;
        _loadingMore = true;
        try
        {
            var rows = await SearchPageAsync(_query.Trim(), skip, CancellationToken.None);
            if (_disposed || version != Volatile.Read(ref _searchVersion))
                return;

            _nextSkip += rows.Count;
            _hasMore = rows.Count >= Math.Clamp(PageSize, 1, 50);
            foreach (var item in rows)
            {
                if (_items.All(existing => existing.Value != item.Value))
                    _items.Add(item);
            }
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(Value))
        {
            _lastExternalValue = null;
            await SelectedItemChanged.InvokeAsync((UiLookupItem?)null);
            await ValueChanged.InvokeAsync((string?)null);
        }

        await QueueSearchAsync(_query);
    }

    private Task HandleFocusAsync(FocusEventArgs _) =>
        QueueSearchAsync(_query);

    private Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _open = false;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private async Task QueueSearchAsync(string query)
    {
        if (_disposed || Disabled || (SearchAsync is null && SearchPageAsync is null))
            return;

        var version = Interlocked.Increment(ref _searchVersion);
        _nextSkip = 0;
        _hasMore = false;
        _loadingMore = false;
        _items.Clear();

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var debounceToken = _searchCts.Token;

        if (query.Trim().Length < MinimumSearchLength)
        {
            _items.Clear();
            _open = true;
            _loading = false;
            return;
        }

        try
        {
            _loading = true;
            _open = true;
            StateHasChanged();

            if (DebounceMilliseconds > 0)
            {
                await Task.Delay(DebounceMilliseconds, debounceToken);
            }

            if (!IsCurrentSearch(version, debounceToken))
                return;

            var results = SearchPageAsync is not null
                ? await SearchPageAsync(query.Trim(), 0, CancellationToken.None)
                : await SearchAsync!(query.Trim(), CancellationToken.None);

            if (!IsCurrentSearch(version, debounceToken))
                return;

            _items.Clear();
            _items.AddRange(results);
            if (SearchPageAsync is not null)
            {
                _nextSkip = results.Count;
                _hasMore = results.Count >= Math.Clamp(PageSize, 1, 50);
            }
        }
        catch (OperationCanceledException)
        {
            // Debounce/disposal cancellation is expected for a lookup.
        }
        finally
        {
            if (!_disposed && version == Volatile.Read(ref _searchVersion))
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool IsCurrentSearch(long version, CancellationToken debounceToken) =>
        !_disposed &&
        !debounceToken.IsCancellationRequested &&
        version == Volatile.Read(ref _searchVersion);

    private async Task SelectAsync(UiLookupItem item)
    {
        if (item.Disabled)
            return;

        Interlocked.Increment(ref _searchVersion);
        _searchCts?.Cancel();

        _query = item.PrimaryText;
        _open = false;
        _items.Clear();
        _lastExternalValue = item.Value;

        await SelectedItemChanged.InvokeAsync(item);
        await ValueChanged.InvokeAsync(item.Value);
    }

    private async Task ClearAsync()
    {
        Interlocked.Increment(ref _searchVersion);
        _searchCts?.Cancel();

        _query = string.Empty;
        _open = false;
        _items.Clear();
        _lastExternalValue = null;

        await SelectedItemChanged.InvokeAsync((UiLookupItem?)null);
        await ValueChanged.InvokeAsync((string?)null);
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _searchVersion);

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;

        return ValueTask.CompletedTask;
    }
}
