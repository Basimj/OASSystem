@namespace OAS.UiLib.Components.Layout
@using OAS.UiLib.Core.Models
@using Microsoft.AspNetCore.Components.Authorization

<div class="oas-theme-studio @(Model.ThemeMode == "Dark" ? "oas-theme-studio--dark" : "")" dir="rtl">
    <header class="oas-theme-studio__intro">
        <div class="oas-theme-studio__intro-copy">
            <div class="oas-theme-studio__breadcrumbs"><a href="/settings">الإعدادات</a><i class="fa-solid fa-angle-left"></i><span>المظهر</span></div>
            <h1><i class="fa-solid fa-palette" aria-hidden="true"></i> إعدادات المظهر</h1>
            <p>تخصيص ألوان النظام والخطوط وشكل الواجهات لتناسب تفضيلاتك الشخصية في حسابك.</p>
        </div>
    </header>



    @if (Loading)
    {
        <section class="oas-theme-studio__panel" aria-busy="true">جارٍ تحميل إعدادات المظهر من قاعدة البيانات...</section>
    }
    else
    {
        <div class="oas-theme-studio__dashboard">
            <!-- RTL grid: first cell is on the right, second on the left. -->
            <section class="oas-theme-studio__panel oas-theme-studio__presets" aria-label="الثيمات الجاهزة">
                <div class="oas-theme-studio__panel-head">
                    <div><h2><i class="fa-solid fa-palette"></i> الثيمات الجاهزة</h2><p>اختر ثيمًا جاهزًا، ثم غيّر أي لون كما تريد</p></div>
                </div>
                <div class="oas-theme-studio__presets-grid">
                    <button type="button" class="@(Model.ThemePreset == "Ocean" ? "oas-theme-studio__preset is-selected" : "oas-theme-studio__preset")" @onclick="ApplyOceanPresetAsync" aria-pressed="@(Model.ThemePreset == "Ocean")">
                        <span class="oas-theme-studio__preset-shot ocean"><span class="side"></span><span class="top"></span><span class="tile a"></span><span class="tile b"></span><span class="tile c"></span></span>
                        @if (Model.ThemePreset == "Ocean") { <i class="fa-solid fa-circle-check oas-theme-studio__check"></i> }
                        <strong>Ocean</strong><small>الافتراضي</small>
                        <span class="oas-theme-studio__swatches"><i style="background:#DDF3F8"></i><i style="background:#F1FBFD"></i><i style="background:#0B8095"></i><i style="background:#B9E5F1"></i></span>
                    </button>
                    <button type="button" class="@(Model.ThemePreset == "SkyYellow" ? "oas-theme-studio__preset is-selected" : "oas-theme-studio__preset")" @onclick="ApplySkyYellowPresetAsync" aria-pressed="@(Model.ThemePreset == "SkyYellow")" title="أزرق فاتح مع أصفر ناعم ومقروء">
                        <span class="oas-theme-studio__preset-shot sky-yellow"><span class="side"></span><span class="top"></span><span class="tile a"></span><span class="tile b"></span><span class="tile c"></span></span>
                        @if (Model.ThemePreset == "SkyYellow") { <i class="fa-solid fa-circle-check oas-theme-studio__check"></i> }
                        <strong>سماء وشمس</strong><small>أزرق فاتح وأصفر</small>
                        <span class="oas-theme-studio__swatches"><i style="background:#D9F0FF"></i><i style="background:#0B6FAF"></i><i style="background:#FFF1B8"></i><i style="background:#FFFFFF"></i></span>
                    </button>
                    <button type="button" class="@(Model.ThemePreset == "Midnight" ? "oas-theme-studio__preset is-selected" : "oas-theme-studio__preset")" @onclick="ApplyMidnightPresetAsync" aria-pressed="@(Model.ThemePreset == "Midnight")">
                        <span class="oas-theme-studio__preset-shot midnight"><span class="side"></span><span class="top"></span><span class="tile a"></span><span class="tile b"></span><span class="tile c"></span></span>
                        @if (Model.ThemePreset == "Midnight") { <i class="fa-solid fa-circle-check oas-theme-studio__check"></i> }
                        <strong>الوضع المظلم</strong><small>Midnight</small>
                        <span class="oas-theme-studio__swatches"><i style="background:#0F1012"></i><i style="background:#191B1F"></i><i style="background:#2879A8"></i><i style="background:#2D3138"></i></span>
                    </button>
                    <button type="button" class="@(Model.ThemePreset == "Slate" ? "oas-theme-studio__preset is-selected" : "oas-theme-studio__preset")" @onclick="ApplySlatePresetAsync" aria-pressed="@(Model.ThemePreset == "Slate")">
                        <span class="oas-theme-studio__preset-shot slate"><span class="side"></span><span class="top"></span><span class="tile a"></span><span class="tile b"></span><span class="tile c"></span></span>
                        @if (Model.ThemePreset == "Slate") { <i class="fa-solid fa-circle-check oas-theme-studio__check"></i> }
                        <strong>Slate</strong><small>فاتح هادئ</small>
                        <span class="oas-theme-studio__swatches"><i style="background:#1F3347"></i><i style="background:#B5C8D7"></i><i style="background:#78899C"></i><i style="background:#DAE5ED"></i></span>
                    </button>
                </div>
            </section>

            <section class="oas-theme-studio__panel oas-theme-studio__live" aria-label="معاينة مباشرة">
                <div class="oas-theme-studio__panel-head">
                    <div><h2><i class="fa-regular fa-eye"></i> معاينة مباشرة</h2><p>شاهد التغييرات مباشرة كما ستظهر في النظام</p></div>
                </div>
                <div class="oas-theme-studio__mini @(Model.ThemeMode == "Dark" ? "is-dark" : "")" aria-label="معاينة تفصيلية للنظام" style="--preview-accent:@Model.PrimaryColor;--oas-preview-canvas:@(Model.ThemePreset == "SkyYellow" ? "#F4FAFF" : Model.ThemePreset == "Slate" ? "#F5F8FC" : "#F1FBFD")">
                    <div class="oas-theme-studio__mini-stage">
                        <div class="oas-theme-studio__mini-side" style="background:@Model.SidebarBackground;color:@Model.SidebarTextColor">
                            <div class="oas-theme-studio__mini-brand"><span class="oas-theme-studio__mini-brand-mark"><i class="fa-solid fa-cube" aria-hidden="true"></i></span> OASSystem</div>
                            <div class="oas-theme-studio__mini-side-link"><i class="fa-solid fa-house" style="color:@Model.SidebarIconColor"></i> الرئيسية</div>
                            <div class="oas-theme-studio__mini-side-link"><i class="fa-solid fa-calculator" style="color:@Model.SidebarIconColor"></i> المحاسبة <i class="fa-solid fa-chevron-down arrow"></i></div>
                            <div class="oas-theme-studio__mini-side-sub">شجرة الحسابات</div>
                            <div class="oas-theme-studio__mini-side-link"><i class="fa-solid fa-cart-shopping" style="color:@Model.SidebarIconColor"></i> المبيعات</div>
                            <div class="oas-theme-studio__mini-side-link"><i class="fa-solid fa-bag-shopping" style="color:@Model.SidebarIconColor"></i> المشتريات</div>
                            <div class="oas-theme-studio__mini-side-link"><i class="fa-solid fa-boxes-stacked" style="color:@Model.SidebarIconColor"></i> المخزون</div>
                            <div class="oas-theme-studio__mini-side-link is-active" style="background:@Model.SidebarActiveBackground;color:@Model.SidebarActiveTextColor"><i class="fa-solid fa-gear" style="color:@Model.SidebarActiveIconColor"></i> الإعدادات</div>
                        </div>
                        <div class="oas-theme-studio__mini-workspace">
                            <div class="oas-theme-studio__mini-header" style="background:@Model.HeaderBackground;color:@Model.HeaderTextColor">
                                <div class="oas-theme-studio__mini-profile"><i class="fa-regular fa-circle-user" style="color:@Model.HeaderIconColor"></i> أحمد محمد</div>
                                <div class="oas-theme-studio__mini-header-chip"><i class="fa-regular fa-bell" style="color:@Model.HeaderIconColor"></i></div>
                                <div class="oas-theme-studio__mini-header-chip">2026 <i class="fa-regular fa-calendar" style="color:@Model.HeaderIconColor"></i></div>
                                <div class="oas-theme-studio__mini-header-chip">شركة العالم للتجارة <i class="fa-solid fa-building" style="color:@Model.HeaderIconColor"></i></div>
                                <div class="oas-theme-studio__mini-search">البحث في النظام... <i class="fa-solid fa-magnifying-glass" style="color:@Model.HeaderIconColor"></i></div>
                            </div>
                            <div class="oas-theme-studio__mini-tabs" style="background:@Model.TabsBarBackground">
                                <span style="background:@Model.TabsActiveBackground;color:@Model.TabsActiveTextColor;border-color:@Model.TabsBorderColor"><i class="fa-solid fa-house" style="color:@Model.TabsActiveIconColor"></i> لوحة التحكم</span>
                                <span style="background:@Model.TabsBackground;color:@Model.TabsTextColor;border-color:@Model.TabsBorderColor"><i class="fa-solid fa-calculator" style="color:@Model.TabsIconColor"></i> المحاسبة</span>
                                <span style="background:@Model.TabsBackground;color:@Model.TabsTextColor;border-color:@Model.TabsBorderColor"><i class="fa-solid fa-gear" style="color:@Model.TabsIconColor"></i> المظهر</span>
                            </div>
                            <div class="oas-theme-studio__mini-main">
                                <div class="oas-theme-studio__mini-page-heading">لوحة المعلومات <small>نظرة عامة على مؤشرات النظام</small></div>
                                <div class="oas-theme-studio__mini-stats">
                                    <div><i class="fa-solid fa-cart-shopping"></i><small>إجمالي المبيعات</small><b>2,420,000 <em>ر.س</em></b><span class="oas-theme-studio__mini-trend">▲ 12%</span></div>
                                    <div><i class="fa-solid fa-cube"></i><small>إجمالي المشتريات</small><b>1,180,000 <em>ر.س</em></b><span class="oas-theme-studio__mini-trend">▲ 8%</span></div>
                                    <div><i class="fa-solid fa-users"></i><small>عدد العملاء</small><b>856</b><span class="oas-theme-studio__mini-trend">▲ 5%</span></div>
                                    <div><i class="fa-solid fa-warehouse"></i><small>قيمة المخزون</small><b>3,420,000 <em>ر.س</em></b><span class="oas-theme-studio__mini-trend">▲ 3%</span></div>
                                </div>
                                <div class="oas-theme-studio__mini-chart">
                                    <div class="oas-theme-studio__mini-chart-head"><strong>المبيعات خلال الفترة</strong><small>يناير — يونيو 2026</small></div>
                                    <svg viewBox="0 0 320 110" preserveAspectRatio="none" aria-hidden="true">
                                        <defs><linearGradient id="oastsGraph" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="@Model.PrimaryColor" stop-opacity=".24"/><stop offset="1" stop-color="@Model.PrimaryColor" stop-opacity="0"/></linearGradient></defs>
                                        <path d="M7 101 L58 70 L107 82 L157 51 L210 48 L260 20 L312 27 L312 110 L7 110 Z" fill="url(#oastsGraph)"/>
                                        <path d="M7 101 L58 70 L107 82 L157 51 L210 48 L260 20 L312 27" stroke="@Model.PrimaryColor" stroke-width="3" fill="none"/>
                                        <g fill="@Model.PrimaryColor"><circle cx="7" cy="101" r="3"/><circle cx="58" cy="70" r="3"/><circle cx="107" cy="82" r="3"/><circle cx="157" cy="51" r="3"/><circle cx="210" cy="48" r="3"/><circle cx="260" cy="20" r="3"/><circle cx="312" cy="27" r="3"/></g>
                                    </svg>
                                    <div class="oas-theme-studio__mini-months"><span>يناير</span><span>فبراير</span><span>مارس</span><span>أبريل</span><span>مايو</span><span>يونيو</span></div>
                                </div>
                                <div class="oas-theme-studio__mini-table"><div class="oas-theme-studio__mini-table-head">آخر العمليات <span>عرض الكل</span></div><div>فاتورة مبيعات <span>1,200 ر.س</span></div><div>سند قبض <span>750 ر.س</span></div></div>
                            </div>
                        </div>
                    </div>
                </div>
                <small class="oas-theme-studio__mini-caption">المؤشرات داخل المعاينة أمثلة توضيحية وليست بيانات حسابك. التخصيص يُطبّق على واجهة النظام الحقيقية.</small>
            </section>

            <section class="oas-theme-studio__panel oas-theme-studio__sidebar-panel">
                <div class="oas-theme-studio__panel-head"><div><h2><i class="fa-solid fa-table-columns"></i> الشريط الجانبي</h2><p>تخصيص ألوان القائمة الجانبية والعناصر النشطة</p></div></div>
                <div class="oas-theme-studio__colors">
                    @ColorInput("خلفية الشريط", "sidebarBg")
                    @ColorInput("لون النص", "sidebarText")
                    @ColorInput("لون الأيقونات", "sidebarIcon")
                    @ColorInput("خلفية العنصر النشط", "activeBg")
                    @ColorInput("لون النص النشط", "activeText")
                    @ColorInput("لون الأيقونة النشطة", "activeIcon")
                    @ColorInput("خلفية المرور", "sidebarHover")
                </div>
            </section>

            <section class="oas-theme-studio__panel oas-theme-studio__header-panel">
                <div class="oas-theme-studio__panel-head"><div><h2><i class="fa-solid fa-display"></i> الشريط العلوي</h2><p>تخصيص الشريط العلوي في النظام</p></div></div>
                <div class="oas-theme-studio__colors">
                    @ColorInput("خلفية الشريط العلوي", "headerBg")
                    @ColorInput("لون النص", "headerText")
                    @ColorInput("لون الأيقونات", "headerIcon")
                    @ColorInput("اللون الأساسي", "primary")
                </div>
                <h3 class="oas-theme-studio__option-title">نمط التصميم</h3>
                <div class="oas-theme-studio__option-pills">
                    <button type="button" class="@(Model.HeaderLayout == "Classic" ? "is-active" : "")" @onclick="SetHeaderClassicAsync"><i class="fa-solid fa-bars"></i> كلاسيكي</button>
                    <button type="button" class="@(Model.HeaderLayout == "Compact" ? "is-active" : "")" @onclick="SetHeaderCompactAsync"><i class="fa-solid fa-grip-lines"></i> مضغوط</button>
                    <button type="button" class="@(Model.HeaderLayout == "Minimal" ? "is-active" : "")" @onclick="SetHeaderMinimalAsync"><i class="fa-solid fa-minus"></i> بسيط</button>
                </div>
                <div class="oas-theme-studio__form-group"><label>ترتيب عناصر الشريط العلوي</label>
                    <div class="oas-theme-studio__header-order">
                        @foreach (var key in Model.HeaderOrder)
                        {
                            <div @key="key"><span>@HeaderLabel(key)</span><button type="button" title="تحريك إلى الأمام" @onclick="() => MoveHeaderAsync(key,-1)">↑</button><button type="button" title="تحريك إلى الخلف" @onclick="() => MoveHeaderAsync(key,1)">↓</button></div>
                        }
                    </div>
                </div>
            </section>

            <section class="oas-theme-studio__panel oas-theme-studio__tabs-panel">
                <div class="oas-theme-studio__panel-head"><div><h2><i class="fa-regular fa-window-maximize"></i> شريط تبويبات الصفحات</h2><p>تخصيص مظهر تبويبات الصفحات المفتوحة في النظام</p></div></div>
                <div class="oas-theme-studio__colors tabs-colors">
                    @ColorInput("خلفية شريط التبويبات", "tabsBarBg")
                    @ColorInput("التبويب النشط", "tabsActiveBg")
                    @ColorInput("التبويب غير النشط", "tabsBg")
                    @ColorInput("لون الحدود", "tabsBorder")
                    @ColorInput("نص التبويب", "tabsText")
                    @ColorInput("أيقونة التبويب", "tabsIcon")
                    @ColorInput("نص التبويب النشط", "tabsActiveText")
                    @ColorInput("أيقونة التبويب النشط", "tabsActiveIcon")
                </div>
                <h3 class="oas-theme-studio__option-title">شكل التبويبات</h3>
                <div class="oas-theme-studio__form-group"><select aria-label="شكل التبويبات" @bind="Model.TabsStyle" @bind:after="PreviewAsync"><option value="Classic">كلاسيكي</option><option value="Pills">كبسولات</option><option value="Underline">خط سفلي</option></select></div>
                <h3 class="oas-theme-studio__option-title">حجم التبويبات</h3>
                <div class="oas-theme-studio__option-pills">
                    <button type="button" class="@(Model.TabsSize == "Compact" ? "is-active" : "")" @onclick="SetTabsCompactAsync">صغير</button>
                    <button type="button" class="@(Model.TabsSize == "Normal" ? "is-active" : "")" @onclick="SetTabsNormalAsync">متوسط</button>
                    <button type="button" class="@(Model.TabsSize == "Comfortable" ? "is-active" : "")" @onclick="SetTabsComfortableAsync">كبير</button>
                </div>
            </section>

            <section class="oas-theme-studio__panel oas-theme-studio__typography-panel">
                <div class="oas-theme-studio__panel-head"><div><h2><i class="fa-solid fa-font"></i> الخطوط</h2><p>اختيار نوع الخط وحجمه ومظهره</p></div></div>
                <div class="oas-theme-studio__font-grid">
                    <div class="oas-theme-studio__form-group"><label for="appearance-font">نوع الخط</label><select id="appearance-font" @bind="Model.FontFamily" @bind:after="PreviewAsync"><option value="Cairo">Cairo — الخط الافتراضي</option><option value="Tajawal">Tajawal</option><option value="IBM Plex Sans Arabic">IBM Plex Sans Arabic</option><option value="Segoe UI">Segoe UI</option></select></div>
                    <div class="oas-theme-studio__form-group"><label for="appearance-font-scale">حجم الخط — @((int)(Model.FontScale * 100))%</label><input id="appearance-font-scale" type="range" min="0.85" max="1.25" step="0.05" @bind="Model.FontScale" @bind:event="oninput" @bind:after="PreviewAsync" /><div class="oas-theme-studio__range-labels"><span>صغير</span><span>كبير</span></div></div>
                </div>
                <div class="oas-theme-studio__font-grid">
                    <div class="oas-theme-studio__form-group"><label>نمط الواجهة</label><select @bind="Model.ThemeMode" @bind:after="ApplyThemeModeAsync"><option value="Light">فاتح</option><option value="Dark">مظلم (أسود فحمي)</option></select></div>
                    <div class="oas-theme-studio__form-group"><label>الشريط الجانبي</label><select @bind="Model.SidebarMode" @bind:after="PreviewAsync"><option value="Expanded">موسّع</option><option value="Collapsed">مطوي</option></select></div>
                </div>
            </section>
        </div>

        <div class="oas-theme-studio__footer">
            <button type="button" class="oas-theme-studio__save" disabled="@Busy" @onclick="OnSave"><i class="fa-regular fa-floppy-disk"></i> @(Busy ? "جارٍ الحفظ..." : "حفظ التغييرات")</button>
            <button type="button" class="oas-theme-studio__cancel" disabled="@Busy" @onclick="OnCancel">إلغاء</button>
            <button type="button" class="oas-theme-studio__reset" disabled="@Busy" @onclick="OnReset"><i class="fa-solid fa-rotate-left"></i> استعادة الافتراضي</button>
        </div>
    }
</div>
@code {
    [Parameter, EditorRequired] public AppearanceSettingsModel Model { get; set; } = new();
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnPreview { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    private Task PreviewAsync() => OnPreview.InvokeAsync();

    private Task ApplyOceanPresetAsync() => ApplyPresetAsync("Ocean");
    private Task ApplyMidnightPresetAsync() => ApplyPresetAsync("Midnight");
    private Task ApplySlatePresetAsync() => ApplyPresetAsync("Slate");
    private Task ApplySkyYellowPresetAsync() => ApplyPresetAsync("SkyYellow");
    private Task SetHeaderClassicAsync() => SetHeaderLayoutAsync("Classic");
    private Task SetHeaderCompactAsync() => SetHeaderLayoutAsync("Compact");
    private Task SetHeaderMinimalAsync() => SetHeaderLayoutAsync("Minimal");
    private Task SetTabsCompactAsync() => SetTabsSizeAsync("Compact");
    private Task SetTabsNormalAsync() => SetTabsSizeAsync("Normal");
    private Task SetTabsComfortableAsync() => SetTabsSizeAsync("Comfortable");

    // Keep the chosen palette when switching modes. Only the Midnight-specific
    // palette needs a light replacement when returning to Light from the selector.
    private Task ApplyThemeModeAsync() =>
        Model.ThemeMode == "Light" && Model.ThemePreset == "Midnight"
            ? ApplyPresetAsync("Ocean")
            : OnPreview.InvokeAsync();

    private Task SetHeaderLayoutAsync(string value)
    {
        Model.HeaderLayout = value;
        return PreviewAsync();
    }

    private Task SetTabsSizeAsync(string value)
    {
        Model.TabsSize = value;
        return PreviewAsync();
    }


    private async Task ApplyPresetAsync(string preset)
    {
        switch (preset)
        {
            case "Ocean":
                // Default Ocean now uses a soft aqua sidebar, not the old petrol tone.
                Model.ThemeMode = "Light";
                Model.PrimaryColor = "#0B8095"; Model.SidebarBackground = "#DDF3F8";
                Model.SidebarTextColor = "#174558"; Model.SidebarIconColor = "#28667B";
                Model.SidebarHoverBackground = "#C8EAF2"; Model.SidebarActiveBackground = "#B9E5F1";
                Model.SidebarActiveTextColor = "#123D56"; Model.SidebarActiveIconColor = "#086C87";
                Model.HeaderBackground = "#FFFFFF"; Model.HeaderTextColor = "#21485C";
                Model.HeaderIconColor = "#3B7185";
                Model.TabsBarBackground = "#FFFFFF"; Model.TabsBackground = "#FFFFFF";
                Model.TabsTextColor = "#42657B"; Model.TabsIconColor = "#42657B";
                Model.TabsActiveBackground = "#D7F1F8"; Model.TabsActiveTextColor = "#126078";
                Model.TabsActiveIconColor = "#0B8095"; Model.TabsBorderColor = "#C8E5EE";
                break;
            case "SkyYellow":
                // Sky blue for navigation and actions; soft yellow ONLY for selection/highlights.
                // Dark ink on both pastels ensures readable labels and navigation items.
                Model.ThemeMode = "Light";
                Model.PrimaryColor = "#0B6FAF"; Model.SidebarBackground = "#D9F0FF";
                Model.SidebarTextColor = "#163E5E"; Model.SidebarIconColor = "#24547C";
                Model.SidebarHoverBackground = "#C1E5FF"; Model.SidebarActiveBackground = "#FFF1B8";
                Model.SidebarActiveTextColor = "#634C00"; Model.SidebarActiveIconColor = "#634C00";
                Model.HeaderBackground = "#FFFFFF"; Model.HeaderTextColor = "#173B59";
                Model.HeaderIconColor = "#24547C";
                Model.TabsBarBackground = "#F4FAFF"; Model.TabsBackground = "#FFFFFF";
                Model.TabsTextColor = "#24547C"; Model.TabsIconColor = "#24547C";
                Model.TabsActiveBackground = "#FFF1B8"; Model.TabsActiveTextColor = "#634C00";
                Model.TabsActiveIconColor = "#634C00"; Model.TabsBorderColor = "#BEDDF1";
                break;
            case "Midnight":
                Model.ThemeMode = "Dark";
                Model.PrimaryColor = "#2786B7"; Model.SidebarBackground = "#101114";
                Model.SidebarTextColor = "#F2F4F7"; Model.SidebarIconColor = "#C5CBD3";
                Model.SidebarHoverBackground = "#25282D"; Model.SidebarActiveBackground = "#234E65";
                Model.SidebarActiveTextColor = "#FFFFFF"; Model.SidebarActiveIconColor = "#F2F7FB";
                Model.HeaderBackground = "#17191E"; Model.HeaderTextColor = "#F1F3F6";
                Model.HeaderIconColor = "#C8CDD6";
                Model.TabsBarBackground = "#17191E"; Model.TabsBackground = "#202329";
                Model.TabsTextColor = "#D4D9E0"; Model.TabsIconColor = "#C6CCD4";
                Model.TabsActiveBackground = "#2C3844"; Model.TabsActiveTextColor = "#F4F6F9";
                Model.TabsActiveIconColor = "#83C8F3"; Model.TabsBorderColor = "#393E46";
                break;
            case "Slate":
                Model.ThemeMode = "Light";
                Model.PrimaryColor = "#526C8B"; Model.SidebarBackground = "#273847";
                Model.SidebarTextColor = "#FFFFFF"; Model.SidebarIconColor = "#D5E2EB";
                Model.SidebarHoverBackground = "#405361"; Model.SidebarActiveBackground = "#425E7D";
                Model.SidebarActiveTextColor = "#FFFFFF"; Model.SidebarActiveIconColor = "#FFFFFF";
                Model.HeaderBackground = "#FFFFFF"; Model.HeaderTextColor = "#253A4D";
                Model.HeaderIconColor = "#4C637D";
                Model.TabsBarBackground = "#FFFFFF"; Model.TabsBackground = "#FFFFFF";
                Model.TabsTextColor = "#5F6F84"; Model.TabsIconColor = "#5F6F84";
                Model.TabsActiveBackground = "#EDF2F8"; Model.TabsActiveTextColor = "#314A66";
                Model.TabsActiveIconColor = "#314A66"; Model.TabsBorderColor = "#CDD7E4";
                break;
            default: return;
        }
        Model.ThemePreset = preset;
        await OnPreview.InvokeAsync();
    }

    private async Task MoveHeaderAsync(string key, int delta)
    {
        var i = Array.IndexOf(Model.HeaderOrder, key);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= Model.HeaderOrder.Length) return;
        (Model.HeaderOrder[i], Model.HeaderOrder[j]) = (Model.HeaderOrder[j], Model.HeaderOrder[i]);
        await PreviewAsync();
    }

    private static string HeaderLabel(string key) => key switch
    {
        "user" => "المستخدم", "notifications" => "الإشعارات", "session" => "الشركة والسنة المالية", _ => key
    };

    private RenderFragment ColorInput(string label, string key) => @<label class="oas-theme-studio__color-field">
        <span>@label</span>
        <span class="oas-theme-studio__color-control">
            <input type="color" value="@GetColor(key)" @oninput="e => UpdateColorAsync(key, e.Value?.ToString())" aria-label="@label" />
            <input class="oas-theme-studio__hex" dir="ltr" type="text" value="@GetColor(key)"
                   maxlength="7" spellcheck="false" @onchange="e => UpdateColorAsync(key, e.Value?.ToString())"
                   aria-label="رمز لون @label" />
        </span>
    </label>;

    private string GetColor(string key) => key switch
    {
        "primary" => Model.PrimaryColor,
        "sidebarBg" => Model.SidebarBackground,
        "sidebarText" => Model.SidebarTextColor,
        "sidebarIcon" => Model.SidebarIconColor,
        "sidebarHover" => Model.SidebarHoverBackground,
        "activeBg" => Model.SidebarActiveBackground,
        "activeText" => Model.SidebarActiveTextColor,
        "headerBg" => Model.HeaderBackground,
        "headerText" => Model.HeaderTextColor,
        "headerIcon" => Model.HeaderIconColor,
        "tabsBarBg" => Model.TabsBarBackground,
        "tabsBg" => Model.TabsBackground,
        "tabsText" => Model.TabsTextColor,
        "tabsIcon" => Model.TabsIconColor,
        "tabsActiveBg" => Model.TabsActiveBackground,
        "tabsActiveText" => Model.TabsActiveTextColor,
        "tabsActiveIcon" => Model.TabsActiveIconColor,
        "tabsBorder" => Model.TabsBorderColor,
        "activeIcon" => Model.SidebarActiveIconColor,
        _ => "#FFFFFF"
    };

    private async Task UpdateColorAsync(string key, string? value)
    {
        if (value?.Length != 7 || value[0] != '#') return;
        switch (key)
        {
            case "primary": Model.PrimaryColor=value; break;
            case "sidebarBg": Model.SidebarBackground=value; break;
            case "sidebarText": Model.SidebarTextColor=value; break;
            case "sidebarIcon": Model.SidebarIconColor=value; break;
            case "sidebarHover": Model.SidebarHoverBackground=value; break;
            case "activeBg": Model.SidebarActiveBackground=value; break;
            case "activeText": Model.SidebarActiveTextColor=value; break;
            case "headerBg": Model.HeaderBackground=value; break;
            case "headerText": Model.HeaderTextColor=value; break;
            case "headerIcon": Model.HeaderIconColor=value; break;
            case "tabsBarBg": Model.TabsBarBackground=value; break;
            case "tabsBg": Model.TabsBackground=value; break;
            case "tabsText": Model.TabsTextColor=value; break;
            case "tabsIcon": Model.TabsIconColor=value; break;
            case "tabsActiveBg": Model.TabsActiveBackground=value; break;
            case "tabsActiveText": Model.TabsActiveTextColor=value; break;
            case "tabsActiveIcon": Model.TabsActiveIconColor=value; break;
            case "tabsBorder": Model.TabsBorderColor=value; break;
            case "activeIcon": Model.SidebarActiveIconColor=value; break;
        }
        // Keep Sky & Sun's blue/yellow surface palette when its individual colors
        // are customized; otherwise custom edits would unexpectedly revert the canvas.
        if (Model.ThemePreset != "SkyYellow") Model.ThemePreset = "Custom";
        await PreviewAsync();
    }
}
