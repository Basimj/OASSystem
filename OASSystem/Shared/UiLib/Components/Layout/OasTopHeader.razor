@implements IDisposable

<header class="oas-top-header">

    <!-- =====================================================
         LEFT / SYSTEM
         ===================================================== -->

    <div class="oas-header-system">

       


        <!-- OAS Logo -->
        <div class="oas-header-logo">

            <span class="oas-header-logo-mark">
                OAS
            </span>

        </div>


        <!-- System Name -->
        <div class="oas-header-system-name">

            <span>
                OAS System
            </span>

            <small>
                نظام الإدارة
            </small>

        </div>

    </div>


    <!-- =====================================================
         CENTER INFORMATION
         ===================================================== -->

    <div class="oas-header-info">

        <!-- Hijri Date -->
        <div class="oas-header-info-item">

            <span class="oas-header-info-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M16 3v4" />
                    <path d="M8 3v4" />
                    <path d="M3 10h18" />

                </svg>

            </span>

            <div class="oas-header-info-text">

                <small>
                    التاريخ الهجري
                </small>

                <strong>
                    @HijriDate
                </strong>

            </div>

        </div>


        <span class="oas-header-divider"></span>


        <!-- Time -->
        <div class="oas-header-info-item">

            <span class="oas-header-info-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="12" cy="12" r="9" />

                    <path d="M12 7v5l3 2" />

                </svg>

            </span>

            <div class="oas-header-info-text">

                <small>
                    الوقت
                </small>

                <strong>
                    @CurrentTime
                </strong>

            </div>

        </div>


        <span class="oas-header-divider"></span>


        <!-- Version -->
        <div class="oas-header-version">
            الإصدار 1.0.0
        </div>


        <span class="oas-header-divider"></span>


        <!-- Connection -->
        <div class="oas-header-status">

            <span class="oas-status-dot"></span>

            <span>
                متصل
            </span>

        </div>


        <span class="oas-header-divider"></span>


        <!-- Notifications -->
        <button type="button"
                class="oas-header-icon-button"
                title="الإشعارات"
                aria-label="الإشعارات">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.7"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />

                <path d="M10 21h4" />

            </svg>

            <span class="oas-notification-badge">
                3
            </span>

        </button>


        <!-- Settings -->
        <button type="button"
                class="oas-header-icon-button"
                title="الإعدادات"
                aria-label="الإعدادات"
                @onclick="OpenSettings">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.7"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <circle cx="12" cy="12" r="3" />

                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6h.01A1.65 1.65 0 0 0 10 3.09V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.13.61.66 1 1.27 1H21a2 2 0 1 1 0 4h-.09c-.61 0-1.14.39-1.51 1z" />

            </svg>

        </button>

    </div>


    <!-- =====================================================
         RIGHT / USER
         ===================================================== -->

    <div class="oas-header-user">

        <!-- User Details -->
        <div class="oas-user-details">

            <strong>
                @UserName
            </strong>

            <span>
                @UserJobTitle
            </span>

        </div>


        <!-- Avatar -->
        <div class="oas-user-avatar">
            @UserInitial
        </div>


        <!-- Dropdown -->
        <button type="button"
                class="oas-user-dropdown"
                aria-label="قائمة المستخدم">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <path d="m7 10 5 5 5-5" />

            </svg>

        </button>

    </div>

</header>