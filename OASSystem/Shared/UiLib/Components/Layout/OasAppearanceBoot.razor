@namespace OAS.UiLib.Components.Layout
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

@code {
    [Parameter] public EventCallback<string> OnSidebarModeLoaded { get; set; }
    [Parameter] public EventCallback<string> OnThemeModeLoaded { get; set; }
    private IJSObjectReference? _module;
    private DotNetObjectReference<OasAppearanceBoot>? _reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/OAS.UiLib/js/oas-appearance.js");
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initialize", _reference);
        }
        catch (JSException) { /* The default Ocean theme remains usable. */ }
        catch (InvalidOperationException) { /* Not yet interactive. */ }
    }

    [JSInvokable]
    public Task AppearanceChanged(string sidebarMode) => OnSidebarModeLoaded.InvokeAsync(sidebarMode);

    [JSInvokable]
    public Task ThemeModeChanged(string mode) => OnThemeModeLoaded.InvokeAsync(mode);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach"); }
            catch (JSDisconnectedException) { }
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _reference?.Dispose();
    }
}
