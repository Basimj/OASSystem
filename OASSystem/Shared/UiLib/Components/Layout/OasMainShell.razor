<div class="oas-shell @(isSidebarCollapsed ? "sidebar-collapsed" : "") @(isMobileMenuOpen ? "mobile-menu-open" : "")">
    <OasAppearanceBoot OnSidebarModeLoaded="ApplyStoredSidebarModeAsync" />
    <div class="oas-mobile-overlay" @onclick="CloseMobileMenu"></div>

    <header class="oas-workspace-topbar">
        <div class="oas-global-header-row">
            <button type="button" class="oas-mobile-menu-btn" aria-label="فتح القائمة" title="فتح القائمة" @onclick="ToggleMobileMenu">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>

            <OasTopHeader @ref="_topHeader" SystemName="@SystemName"
                          SystemLogoUrl="@SystemLogoUrl"
                          DatabaseName="@DatabaseName"
                          ConnectionStatus="@ConnectionStatus"
                          VersionText="@VersionText"
                          UserDisplayName="@UserDisplayName"
                          UserName="@UserName"
                          UserEmail="@UserEmail"
                          UserImageUrl="@UserImageUrl"
                          OnEditProfile="OnEditProfile"
                          OnSettings="OnSettings"
                          OnSupport="OnSupport"
                          OnLogout="OnLogout" />
            <OasModuleSearch Modules="@VisibleModules.ToArray()" OnNavigate="NavigateModuleAsync" />
        </div>

        <div class="oas-global-tabs-row" @onclick="CloseHeaderAccountMenu" @oncontextmenu="CloseHeaderAccountMenu">
            <div class="oas-application-tabs-host">
                <UiApplicationTabStrip @ref="_applicationTabStrip" Tabs="@ApplicationTabs"
                                       OnSelect="SelectApplicationTabAsync"
                                       OnClose="CloseApplicationTabAsync"
                                       OnCloseOthers="CloseOtherApplicationTabsAsync"
                                       OnCloseAll="CloseAllApplicationTabsAsync" />
            </div>
        </div>
    </header>

    <aside class="oas-sidebar" aria-label="القائمة الجانبية" @onclick="CloseHeaderAccountMenu">
        <div class="oas-sidebar-toolbar">
            <div class="oas-sidebar-brand" title="@SystemName">
                @if (!string.IsNullOrWhiteSpace(SystemLogoUrl))
                {
                    <img class="oas-sidebar-brand__logo" src="@SystemLogoUrl" alt="" />
                }
                else
                {
                    <span class="oas-sidebar-brand__mark" aria-hidden="true">
                        <i class="fa-solid fa-cube"></i>
                    </span>
                }
                <span class="oas-sidebar-brand__name" dir="ltr">@SystemName</span>
            </div>
            <button type="button"
                    class="oas-collapse-btn"
                    title="@(isSidebarCollapsed ? "توسيع القائمة" : "طي القائمة")"
                    aria-label="@(isSidebarCollapsed ? "توسيع القائمة" : "طي القائمة")"
                    @onclick="ToggleAppearanceSidebarAsync">
                <i class="fa-solid @(isSidebarCollapsed ? "fa-chevron-left" : "fa-chevron-right")" aria-hidden="true"></i>
            </button>
        </div>

        <nav class="oas-nav" aria-label="التنقل الرئيسي">
            @{
                var standaloneSettings = VisibleNavigationGroups
                    .SelectMany(g => GetVisibleGroupModules(g))
                    .FirstOrDefault(m => string.Equals(m.Href, "/settings", StringComparison.OrdinalIgnoreCase)
                                      || string.Equals(m.Href, "/settings/appearance", StringComparison.OrdinalIgnoreCase));
            }
            @foreach (var module in VisibleUngroupedModules)
            {
                <button type="button"
                        class="@(IsModuleActive(module) ? "oas-nav-item oas-nav-item--root active" : "oas-nav-item oas-nav-item--root")"
                        title="@module.Title"
                        aria-current="@(IsModuleActive(module) ? "page" : null)"
                        @onclick="() => NavigateModuleAsync(module)">
                    <span class="oas-nav-icon" aria-hidden="true"><i class="@module.IconCssClass"></i></span>
                    <span class="oas-nav-text">@module.Title</span>
                </button>
            }

            @foreach (var group in VisibleNavigationGroups)
            {
                var groupModules = GetVisibleGroupModules(group)
                    .Where(m => standaloneSettings is null || !string.Equals(m.Href, standaloneSettings.Href, StringComparison.OrdinalIgnoreCase))
                    .ToArray();
                var active = groupModules.Any(IsModuleActive);
                var expanded = IsGroupExpanded(group);
                @if (groupModules.Any())
                {
                    <div class="@(active ? "oas-nav-group active" : "oas-nav-group")">
                    @if (group.Key == "accounting" && groupModules.Any(m => m.Href == "/accounting"))
                    {
                        // The accounting group has a landing page; navigation and expansion are separate.
                        var accountingHome = groupModules.First(m => m.Href == "/accounting");
                        <button type="button"
                                class="oas-nav-group__header oas-nav-group__header--landing"
                                title="فتح المحاسبة العامة"
                                aria-label="فتح المحاسبة العامة"
                                aria-current="@(_currentPath == "/accounting" ? "page" : null)"
                                @onclick="() => NavigateModuleAsync(accountingHome)">
                            <span class="oas-nav-icon" aria-hidden="true"><i class="@group.IconCssClass"></i></span>
                            <span class="oas-nav-text">@group.Title</span>
                        </button>
                        @if (!isSidebarCollapsed)
                        {
                            <button type="button"
                                    class="oas-nav-group__expand"
                                    title="@(expanded ? "طي صفحات المحاسبة" : "عرض صفحات المحاسبة")"
                                    aria-label="@(expanded ? "طي صفحات المحاسبة" : "عرض صفحات المحاسبة")"
                                    aria-expanded="@expanded"
                                    @onclick="() => HandleGroupClickAsync(group)">
                                <i class="fa-solid @(expanded ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
                            </button>
                        }
                    }
                    else
                    {
                        <button type="button"
                                class="oas-nav-group__header"
                                title="@group.Title"
                                aria-expanded="@(!isSidebarCollapsed && expanded)"
                                @onclick="() => HandleGroupClickAsync(group)">
                            <span class="oas-nav-icon" aria-hidden="true"><i class="@group.IconCssClass"></i></span>
                            <span class="oas-nav-text">@group.Title</span>
                            @if (!isSidebarCollapsed)
                            {
                                <i class="oas-nav-group__chevron fa-solid @(expanded ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
                            }
                        </button>
                    }

                    @if (!isSidebarCollapsed && expanded)
                    {
                        <div class="oas-nav-group__items">
                            @foreach (var module in groupModules)
                            {
                                <button type="button"
                                        class="@(IsModuleActive(module) ? "oas-nav-item oas-nav-item--child active" : "oas-nav-item oas-nav-item--child")"
                                        title="@module.Title"
                                        aria-current="@(IsModuleActive(module) ? "page" : null)"
                                        @onclick="() => NavigateModuleAsync(module)">
                                    <span class="oas-nav-icon" aria-hidden="true"><i class="@module.IconCssClass"></i></span>
                                    <span class="oas-nav-text">@module.Title</span>
                                </button>
                            }
                        </div>
                    }

                    @if (isSidebarCollapsed && group.Key != "accounting")
                    {
                        <UiContextMenu Visible="@string.Equals(_contextGroupKey, group.Key, StringComparison.Ordinal)"
                                       Title="@group.Title"
                                       Items="@BuildContextItems(group)"
                                       OnSelect="SelectCollapsedGroupItemAsync" />
                    }
                    </div>
                }
            }

            @if (standaloneSettings is not null)
            {
                var settingsActive = _currentPath.StartsWith("/settings", StringComparison.OrdinalIgnoreCase);
                <div class="@(settingsActive ? "oas-nav-group oas-nav-settings-group active" : "oas-nav-group oas-nav-settings-group")">
                    <button type="button" class="oas-nav-group__header"
                            title="الإعدادات" aria-label="عرض صفحات الإعدادات"
                            aria-expanded="@(!isSidebarCollapsed && _settingsGroupExpanded)"
                            @onclick="ToggleSettingsGroupAsync">
                        <span class="oas-nav-icon"><i class="fa-solid fa-gear" aria-hidden="true"></i></span>
                        <span class="oas-nav-text">الإعدادات</span>
                        @if (!isSidebarCollapsed)
                        {
                            <i class="oas-nav-group__chevron fa-solid @(_settingsGroupExpanded ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
                        }
                    </button>
                    @if (!isSidebarCollapsed && _settingsGroupExpanded)
                    {
                        <div class="oas-nav-group__items">
                            <button type="button" class="@(_currentPath.Equals("/settings", StringComparison.OrdinalIgnoreCase) ? "oas-nav-item oas-nav-item--child active" : "oas-nav-item oas-nav-item--child")"
                                    title="الإعدادات العامة" @onclick="NavigateSettingsHomeAsync">
                                <span class="oas-nav-icon"><i class="fa-solid fa-sliders" aria-hidden="true"></i></span><span class="oas-nav-text">الإعدادات العامة</span>
                            </button>
                            <button type="button" class="@(_currentPath.StartsWith("/settings/appearance", StringComparison.OrdinalIgnoreCase) ? "oas-nav-item oas-nav-item--child active" : "oas-nav-item oas-nav-item--child")"
                                    title="المظهر" @onclick="NavigateSettingsAppearanceAsync">
                                <span class="oas-nav-icon"><i class="fa-solid fa-palette" aria-hidden="true"></i></span><span class="oas-nav-text">المظهر</span>
                            </button>
                            @foreach (var option in VisibleModules.Where(m => m.Key is "users" or "roles"))
                            {
                                <button type="button" class="@(IsModuleActive(option) ? "oas-nav-item oas-nav-item--child active" : "oas-nav-item oas-nav-item--child")"
                                        title="@option.Title" @onclick="() => NavigateModuleAsync(option)">
                                    <span class="oas-nav-icon"><i class="@option.IconCssClass" aria-hidden="true"></i></span>
                                    <span class="oas-nav-text">@(option.Key == "users" ? "إدارة المستخدمين" : "الأدوار والصلاحيات")</span>
                                </button>
                            }
                        </div>
                    }
                    @if (isSidebarCollapsed)
                    {
                        <UiContextMenu Visible="@string.Equals(_contextGroupKey, SettingsContextKey, StringComparison.Ordinal)"
                                       Title="الإعدادات" Items="@BuildSettingsContextItems()"
                                       OnSelect="SelectSettingsContextItemAsync" />
                    }
                </div>
            }
        </nav>
    </aside>

    <main class="oas-main-content" @onclick="CloseTransientMenus">
        <div class="oas-main-inner">
            @ChildContent
        </div>
    </main>
</div>
