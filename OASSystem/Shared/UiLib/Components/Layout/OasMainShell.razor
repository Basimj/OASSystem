<div class="oas-shell @(isSidebarCollapsed ? "sidebar-collapsed" : "") @(isMobileMenuOpen ? "mobile-menu-open" : "")">
    <div class="oas-mobile-overlay" @onclick="CloseMobileMenu"></div>

    <aside class="oas-sidebar">
        <div class="oas-sidebar-brand">
            <div class="oas-brand-copy">
                <strong class="oas-brand-mark">OAS</strong>
                <span class="oas-brand-subtitle">نظام إدارة المحلات البصرية</span>
            </div>

            <button type="button"
                    class="oas-collapse-btn"
                    title="@(isSidebarCollapsed ? "توسيع القائمة" : "طي القائمة")"
                    aria-label="@(isSidebarCollapsed ? "توسيع القائمة" : "طي القائمة")"
                    @onclick="ToggleSidebar">
                <i class="fa-solid @(isSidebarCollapsed ? "fa-chevron-left" : "fa-chevron-right")" aria-hidden="true"></i>
            </button>
        </div>

        <nav class="oas-nav" aria-label="التنقل الرئيسي">
            @foreach (var module in VisibleModules)
            {
                @if (module.DividerBefore)
                {
                    <div class="oas-nav-divider" aria-hidden="true"></div>
                }

                <button type="button"
                        class="@(IsModuleActive(module) ? "oas-nav-item active" : "oas-nav-item")"
                        title="@module.Title"
                        aria-current="@(IsModuleActive(module) ? "page" : null)"
                        @onclick="() => NavigateModuleAsync(module)">
                    <span class="oas-nav-icon" aria-hidden="true">
                        <i class="@module.IconCssClass"></i>
                    </span>
                    <span class="oas-nav-text">@module.Title</span>
                </button>
            }
        </nav>

        <div class="oas-sidebar-footer">
            <button type="button" class="oas-support-btn" title="دعم المستخدم">
                <span class="oas-nav-icon" aria-hidden="true"><i class="fa-solid fa-headset"></i></span>
                <span class="oas-support-text">دعم المستخدم</span>
            </button>

            <button type="button" class="oas-logout-btn" @onclick="LogoutAsync" title="تسجيل الخروج">
                <span class="oas-nav-icon" aria-hidden="true"><i class="fa-solid fa-arrow-right-from-bracket"></i></span>
                <span class="oas-logout-text">تسجيل الخروج</span>
            </button>
        </div>
    </aside>

    <header class="oas-workspace-topbar">
        <div class="oas-global-header-row">
            <button type="button" class="oas-mobile-menu-btn" aria-label="فتح القائمة" title="فتح القائمة" @onclick="ToggleMobileMenu">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>

            <OasTopHeader SystemName="@SystemName"
                          DatabaseName="@DatabaseName"
                          ConnectionStatus="@ConnectionStatus"
                          VersionText="@VersionText" />
        </div>

        <div class="oas-global-tabs-row">
            <div class="oas-application-tabs-host">
                <UiApplicationTabStrip Tabs="@ApplicationTabs"
                                       OnSelect="SelectApplicationTabAsync"
                                       OnClose="CloseApplicationTabAsync" />
            </div>
        </div>
    </header>

    <main class="oas-main-content">
        <div class="oas-main-inner">
            @ChildContent
        </div>
    </main>
</div>
