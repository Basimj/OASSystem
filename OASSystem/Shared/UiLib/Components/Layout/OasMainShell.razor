<div class="oas-shell @(isSidebarCollapsed ? "sidebar-collapsed" : "") @(isMobileMenuOpen ? "mobile-menu-open" : "")">

    <!-- =========================================================
         TOP HEADER
         ========================================================= -->

    <OasTopHeader />


    <!-- =========================================================
         MOBILE OVERLAY
         ========================================================= -->

    <div class="oas-mobile-overlay"
         @onclick="CloseMobileMenu">
    </div>


    <!-- =========================================================
         RIGHT SIDEBAR
         ========================================================= -->

    <aside class="oas-sidebar">

        <!-- Sidebar Header -->
        <div class="oas-sidebar-header">

            <button type="button"
                    class="oas-collapse-btn"
                    aria-label="طي القائمة"
                    title="طي القائمة"
                    @onclick="ToggleSidebar">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M15 18l-6-6 6-6" />

                </svg>

            </button>

        </div>


        <!-- =====================================================
             NAVIGATION
             ===================================================== -->

        <nav class="oas-nav">

            <!-- Dashboard -->
            <NavLink href="/"
                     Match="NavLinkMatch.All"
                     class="oas-nav-item"
                     @onclick="CloseMobileMenu">

                <span class="oas-nav-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />

                    </svg>
                </span>

                <span class="oas-nav-text">
                    لوحة التحكم
                </span>

            </NavLink>


            <!-- Customers -->
            <NavLink href="/customers"
                     class="oas-nav-item"
                     @onclick="CloseMobileMenu">

                <span class="oas-nav-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />

                    </svg>
                </span>

                <span class="oas-nav-text">
                    العملاء
                </span>

            </NavLink>


            <!-- Products -->
            <NavLink href="/products"
                     class="oas-nav-item"
                     @onclick="CloseMobileMenu">

                <span class="oas-nav-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                        <line x1="12" y1="22.08" x2="12" y2="12" />

                    </svg>
                </span>

                <span class="oas-nav-text">
                    المنتجات
                </span>

            </NavLink>


            <!-- Inventory -->
            <NavLink href="/inventory"
                     class="oas-nav-item"
                     @onclick="CloseMobileMenu">

                <span class="oas-nav-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M3 21h18" />
                        <path d="M5 21V7l7-4 7 4v14" />
                        <path d="M9 21v-5h6v5" />
                        <path d="M8 9h1" />
                        <path d="M15 9h1" />
                        <path d="M8 12h1" />
                        <path d="M15 12h1" />

                    </svg>
                </span>

                <span class="oas-nav-text">
                    المخزون
                </span>

            </NavLink>


            <!-- Purchases -->
            <NavLink href="/purchases"
                     class="oas-nav-item"
                     @onclick="CloseMobileMenu">

                <span class="oas-nav-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M6 2v6" />
                        <path d="M18 2v6" />
                        <path d="M4 8h16" />
                        <path d="M5 8v13h14V8" />
                        <path d="M9 12h6" />
                        <path d="M9 16h6" />

                    </svg>
                </span>

                <span class="oas-nav-text">
                    المشتريات
                </span>

            </NavLink>


            <!-- Sales -->
            <NavLink href="/sales"
                     class="oas-nav-item"
                     @onclick="CloseMobileMenu">

                <span class="oas-nav-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="9" cy="20" r="1" />
                        <circle cx="19" cy="20" r="1" />
                        <path d="M3 4h2l2.4 11.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H6" />

                    </svg>
                </span>

                <span class="oas-nav-text">
                    المبيعات
                </span>

            </NavLink>


            <!-- Daily Orders -->
            <NavLink href="/daily-orders"
                     class="oas-nav-item"
                     @onclick="CloseMobileMenu">

                <span class="oas-nav-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="3" y="4" width="18" height="17" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="9" x2="21" y2="9" />
                        <path d="M8 13h2" />
                        <path d="M14 13h2" />
                        <path d="M8 17h2" />
                        <path d="M14 17h2" />

                    </svg>
                </span>

                <span class="oas-nav-text">
                    الطلبات اليومية
                </span>

            </NavLink>


            <!-- Finance -->
            <NavLink href="/finance"
                     class="oas-nav-item"
                     @onclick="CloseMobileMenu">

                <span class="oas-nav-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                        <path d="M7 15h3" />
                        <circle cx="16" cy="15" r="1.2" />

                    </svg>
                </span>

                <span class="oas-nav-text">
                    المالية
                </span>

            </NavLink>


            <!-- Reports -->
            <NavLink href="/reports"
                     class="oas-nav-item"
                     @onclick="CloseMobileMenu">

                <span class="oas-nav-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <line x1="4" y1="20" x2="4" y2="10" />
                        <line x1="10" y1="20" x2="10" y2="4" />
                        <line x1="16" y1="20" x2="16" y2="13" />
                        <line x1="22" y1="20" x2="22" y2="7" />

                    </svg>
                </span>

                <span class="oas-nav-text">
                    التقارير
                </span>

            </NavLink>


            <!-- =================================================
                 SETTINGS
                 ================================================= -->

            <div class="oas-settings-box">

                <button type="button"
                        class="oas-settings-toggle"
                        @onclick="ToggleSettings">

                    <span class="oas-settings-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12" cy="12" r="3" />

                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6h.01A1.65 1.65 0 0 0 10 3.09V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.13.61.66 1 1.27 1H21a2 2 0 1 1 0 4h-.09c-.61 0-1.14.39-1.51 1z" />

                        </svg>

                    </span>

                    <span class="oas-settings-text">
                        الإعدادات
                    </span>

                    <span class="oas-settings-arrow @(isSettingsOpen ? "open" : "")">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <polyline points="6 9 12 15 18 9" />

                        </svg>

                    </span>

                </button>


                @if (isSettingsOpen)
                {
                    <div class="oas-settings-items">

                        <!-- Employees -->
                        <NavLink href="/employees"
                                 class="oas-settings-item"
                                 ActiveClass="active"
                                 @onclick="CloseMobileMenu">

                            <span class="oas-settings-item-text">
                                الموظفون
                            </span>

                        </NavLink>


                        <!-- Departments -->
                        <NavLink href="/departments"
                                 class="oas-settings-item"
                                 ActiveClass="active"
                                 @onclick="CloseMobileMenu">

                            <span class="oas-settings-item-text">
                                الأقسام
                            </span>

                        </NavLink>


                        <!-- Suppliers -->
                        <NavLink href="/suppliers"
                                 class="oas-settings-item"
                                 ActiveClass="active"
                                 @onclick="CloseMobileMenu">

                            <span class="oas-settings-item-text">
                                الموردون
                            </span>

                        </NavLink>


                        <!-- Users -->
                        @if (IsAdministrator)
                        {
                            <NavLink href="/identity/users"
                                     class="oas-settings-item"
                                     ActiveClass="active"
                                     @onclick="CloseMobileMenu">

                                <span class="oas-settings-item-text">
                                    المستخدمون
                                </span>

                            </NavLink>
                        }


                        <!-- General Settings -->
                        <NavLink href="/settings"
                                 class="oas-settings-item"
                                 ActiveClass="active"
                                 @onclick="CloseMobileMenu">

                            <span class="oas-settings-item-text">
                                الإعدادات العامة
                            </span>

                        </NavLink>

                    </div>
                }

            </div>

        </nav>


        <!-- =====================================================
             LOGOUT
             ===================================================== -->

        <div class="oas-sidebar-footer">

            <button type="button"
                    class="oas-logout-btn"
                    @onclick="LogoutAsync">

                <span class="oas-logout-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />

                    </svg>

                </span>

                <span class="oas-logout-text">
                    تسجيل الخروج
                </span>

            </button>

        </div>

    </aside>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <main class="oas-main-content">

        <div class="oas-main-inner">
            @ChildContent
        </div>

    </main>

</div>