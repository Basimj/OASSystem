@if (Visible)
{
    <div class="ui-account-menu" @onclick:stopPropagation="true">
        <div class="ui-account-menu__profile">
            <div class="ui-account-menu__photo-column">
                <button type="button" class="ui-account-menu__avatar-button" title="@EditProfileText" aria-label="@EditProfileText" @onclick="EditProfileAsync">
                    <UiAvatar Initials="@Initials" ImageUrl="@ImageUrl" AltText="@DisplayName" Size="56" />
                    <span class="ui-account-menu__edit"><i class="fa-solid fa-pen" aria-hidden="true"></i></span>
                </button>
            </div>
            <div class="ui-account-menu__identity-column">
                <strong>@DisplayName</strong>
                <span>@UserName</span>
                @if (!string.IsNullOrWhiteSpace(Email))
                {
                    <span>@Email</span>
                }
            </div>
        </div>
        <div class="ui-account-menu__actions">
            <button type="button" title="@SettingsText" aria-label="@SettingsText" @onclick="SettingsAsync"><i class="fa-solid fa-gear"></i></button>
            <button type="button" title="@SupportText" aria-label="@SupportText" @onclick="SupportAsync"><i class="fa-solid fa-headset"></i></button>
            <button type="button" class="danger" title="@LogoutText" aria-label="@LogoutText" @onclick="LogoutAsync"><i class="fa-solid fa-arrow-right-from-bracket"></i></button>
        </div>
    </div>
}
