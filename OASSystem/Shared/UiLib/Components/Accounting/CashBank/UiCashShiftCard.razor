@namespace OAS.UiLib.Components.Accounting.CashBank

<div class="ui-acc-card">

    <div class="ui-acc-card__header">

        <div class="ui-acc-card__title">

            <i class="fa-solid fa-cash-register" aria-hidden="true"></i>

            <span>
                وردية رقم: @ShiftNumber
            </span>

            @if (!string.IsNullOrWhiteSpace(CashAccountName))
            {
                <span class="text-muted small">
                    (@CashAccountName)
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(CashierName))
            {
                <span class="text-muted small">
                    — @CashierName
                </span>
            }

        </div>

        <OAS.UiLib.Components.Accounting.Workspace.UiAccountingStatusBadge Text="@StatusText"
                                                                           State="@StatusState" />

    </div>


    <div class="ui-acc-card__body">

        <div>
            <strong>وقت البدء:</strong>
            @StartedAtText
        </div>

        @if (!string.IsNullOrWhiteSpace(EndedAtText) && EndedAtText != "-")
        {
            <div>
                <strong>وقت الإغلاق:</strong>
                @EndedAtText
            </div>
        }

        <div>
            <strong>رصيد الافتتاح:</strong>
            @OpeningBalance.ToString("N2") ر.س
        </div>

        <div>
            <strong>الرصيد المتوقع:</strong>
            @ExpectedCashAmount.ToString("N2") ر.س
        </div>

        @if (ActualCashAmount.HasValue)
        {
            <div>
                <strong>رصيد الإغلاق الفعلي:</strong>
                @ActualCashAmount.Value.ToString("N2") ر.س
            </div>
        }

        @if (DifferenceAmount.HasValue)
        {
            <div>
                <strong>الفارق:</strong>

                <span class="@GetDifferenceCssClass()">
                    @DifferenceAmount.Value.ToString("N2") ر.س
                </span>
            </div>
        }

    </div>


    <div class="ui-acc-card__footer">

        @if (OnView.HasDelegate)
        {
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    @onclick:stopPropagation="true"
                    @onclick="OnView">

                <i class="fa-solid fa-eye" aria-hidden="true"></i>

                عرض الوردية

            </button>
        }

    </div>

</div>


@code {

    [Parameter]
    public string ShiftNumber { get; set; } = string.Empty;


    [Parameter]
    public string CashierName { get; set; } = string.Empty;


    [Parameter]
    public string CashAccountName { get; set; } = string.Empty;


    [Parameter]
    public string StartedAtText { get; set; } = string.Empty;


    [Parameter]
    public string EndedAtText { get; set; } = string.Empty;


    [Parameter]
    public decimal OpeningBalance { get; set; }


    [Parameter]
    public decimal ExpectedCashAmount { get; set; }


    [Parameter]
    public decimal? ActualCashAmount { get; set; }


    [Parameter]
    public decimal? DifferenceAmount { get; set; }


    [Parameter]
    public string StatusText { get; set; } = string.Empty;


    [Parameter]
    public string StatusState { get; set; } = "open";


    [Parameter]
    public EventCallback OnView { get; set; }


    private string GetDifferenceCssClass()
    {
        if (!DifferenceAmount.HasValue)
        {
            return string.Empty;
        }

        if (DifferenceAmount.Value == 0)
        {
            return "text-success";
        }

        if (DifferenceAmount.Value > 0)
        {
            return "text-success fw-bold";
        }

        return "text-danger fw-bold";
    }
}