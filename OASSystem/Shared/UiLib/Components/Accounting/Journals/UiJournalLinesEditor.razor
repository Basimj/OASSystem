@namespace OAS.UiLib.Components.Accounting.Journals
@using OAS.UiLib.Components.Buttons
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Core.Models

<div class="ui-acc-lines-editor" dir="rtl">
    <div class="table-responsive">
        <table class="ui-acc-grid-table ui-acc-journal-lines-table ui-acc-journal-lines-table--multicurrency">
            <thead>
                <tr>
                    <th style="width: 40px;">#</th>
                    <th class="ui-acc-journal-account-col">الحساب المحاسبي</th>
                    <th class="ui-acc-journal-description-col">البيان</th>
                    <th class="ui-acc-journal-dimension-col">مركز التكلفة</th>
                    <th class="ui-acc-journal-party-col">العميل</th>
                    <th class="ui-acc-journal-party-col">المورد</th>
                    <th class="ui-acc-journal-party-col">الموظف</th>
                    <th class="ui-acc-journal-currency-col">العملة</th>
                    <th class="ui-acc-journal-rate-col">سعر الصرف</th>
                    <th class="ui-acc-journal-amount-col">مدين (أصلي)</th>
                    <th class="ui-acc-journal-amount-col">دائن (أصلي)</th>
                    <th class="ui-acc-journal-base-col">مدين أساسي</th>
                    <th class="ui-acc-journal-base-col">دائن أساسي</th>
                    @if (IsEditable)
                    {
                        <th style="width: 40px;">إجراء</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Lines.Count == 0)
                {
                    <tr>
                        <td colspan="@(IsEditable ? 14 : 13)" class="text-center text-muted py-3">
                            لا توجد أسطر بعد. انقر على «إضافة سطر» بالأسفل.
                        </td>
                    </tr>
                }
                else
                {
                    var idx = 1;
                    foreach (var line in Lines)
                    {
                        var currentLine = line;
                        <tr>
                            <td>@idx</td>
                            <td>
                                @if (IsEditable)
                                {
                                    <UiLookup Value='@currentLine.AccountId?.ToString("D")'
                                              ValueChanged="@(val => OnAccountSelected(currentLine, val))"
                                              SelectedItem="@currentLine.AccountLookupItem"
                                              SearchAsync="AccountSearchAsync"
                                              Placeholder="ابحث برقم أو اسم الحساب..."
                                              Required="true"
                                              MinimumSearchLength="0"
                                              DebounceMilliseconds="250" />
                                }
                                else
                                {
                                    <span>@(currentLine.AccountLookupItem?.PrimaryText ?? currentLine.AccountDisplay)</span>
                                }
                            </td>
                            <td>
                                @if (IsEditable)
                                {
                                    <UiInputText Value="@currentLine.Description"
                                                 ValueExpression="@(() => currentLine.Description)"
                                                 ValueChanged="@(val => OnDescriptionChanged(currentLine, val))"
                                                 Placeholder="بيان السطر..."
                                                 Size="ControlSize.Small" />
                                }
                                else
                                {
                                    <span>@currentLine.Description</span>
                                }
                            </td>
                            <td>
                                @if (IsEditable)
                                {
                                    <UiLookup Value='@currentLine.CostCenterId?.ToString("D")'
                                              ValueChanged="@(val => OnCostCenterSelected(currentLine, val))"
                                              SelectedItem="@currentLine.CostCenterLookupItem"
                                              SearchAsync="CostCenterSearchAsync"
                                              Placeholder="اختياري: مركز التكلفة..."
                                              MinimumSearchLength="0"
                                              DebounceMilliseconds="250" />
                                }
                                else
                                {
                                    <span>@(currentLine.CostCenterLookupItem?.PrimaryText ?? currentLine.CostCenterDisplay ?? "-")</span>
                                }
                            </td>
                            <td>
                                @if (IsEditable)
                                {
                                    <UiLookup Value='@currentLine.CustomerId?.ToString("D")'
                                              ValueChanged="@(val => OnCustomerSelected(currentLine, val))"
                                              SelectedItem="@currentLine.CustomerLookupItem"
                                              SearchAsync="CustomerSearchAsync"
                                              Placeholder="اختياري: العميل..."
                                              MinimumSearchLength="0"
                                              DebounceMilliseconds="250" />
                                }
                                else
                                {
                                    <span>@(currentLine.CustomerLookupItem?.PrimaryText ?? "-")</span>
                                }
                            </td>
                            <td>
                                @if (IsEditable)
                                {
                                    <UiLookup Value='@currentLine.SupplierId?.ToString("D")'
                                              ValueChanged="@(val => OnSupplierSelected(currentLine, val))"
                                              SelectedItem="@currentLine.SupplierLookupItem"
                                              SearchAsync="SupplierSearchAsync"
                                              Placeholder="اختياري: المورد..."
                                              MinimumSearchLength="0"
                                              DebounceMilliseconds="250" />
                                }
                                else
                                {
                                    <span>@(currentLine.SupplierLookupItem?.PrimaryText ?? "-")</span>
                                }
                            </td>
                            <td>
                                @if (IsEditable)
                                {
                                    <UiLookup Value='@currentLine.EmployeeId?.ToString("D")'
                                              ValueChanged="@(val => OnEmployeeSelected(currentLine, val))"
                                              SelectedItem="@currentLine.EmployeeLookupItem"
                                              SearchAsync="EmployeeSearchAsync"
                                              Placeholder="اختياري: الموظف..."
                                              MinimumSearchLength="0"
                                              DebounceMilliseconds="250" />
                                }
                                else
                                {
                                    <span>@(currentLine.EmployeeLookupItem?.PrimaryText ?? "-")</span>
                                }
                            </td>
                            <td>
                                @if (IsEditable)
                                {
                                    <UiLookup Value='@currentLine.TransactionCurrencyId?.ToString("D")'
                                              ValueChanged="@(val => OnCurrencySelected(currentLine, val))"
                                              SelectedItem="@currentLine.CurrencyLookupItem"
                                              SearchAsync="CurrencySearchAsync"
                                              Placeholder="العملة الأساسية افتراضياً..."
                                              MinimumSearchLength="0"
                                              DebounceMilliseconds="250" />
                                }
                                else
                                {
                                    <span>@(currentLine.CurrencyLookupItem?.PrimaryText ?? currentLine.CurrencyCode ?? "-")</span>
                                }
                            </td>
                            <td class="ui-acc-journal-rate-col">
                                @if (IsEditable)
                                {
                                    <div class="ui-acc-journal-rate-editor">
                                        <span class="text-muted small">
                                            تلقائي: @(currentLine.ResolvedExchangeRate?.ToString("N8") ?? "-")
                                        </span>
                                        <UiAccountingNumberField Label=""
                                                                 Value="@(currentLine.ManualExchangeRate ?? 0m)"
                                                                 ValueChanged="@(value => OnManualRateChanged(currentLine, value))"
                                                                 Min="0"
                                                                 Step="0.00000001"
                                                                 Tone="@UiAccountingNumberField.NumberTone.Default" />
                                        <span class="text-muted small">0 = استخدام السعر التلقائي</span>
                                    </div>
                                }
                                else
                                {
                                    <span>@(currentLine.EffectiveExchangeRate?.ToString("N8") ?? "-")</span>
                                }
                            </td>
                            <td class="ui-acc-journal-amount-col">
                                @if (IsEditable)
                                {
                                    <UiAccountingNumberField Label=""
                                                             Value="@currentLine.DebitAmount"
                                                             ValueChanged="@(value => OnDebitChanged(currentLine, value))"
                                                             Min="0"
                                                             Step="0.01"
                                                             Tone="@UiAccountingNumberField.NumberTone.Success" />
                                }
                                else
                                {
                                    <span class="ui-acc-val--debit">
                                        @(currentLine.DebitAmount > 0 ? currentLine.DebitAmount.ToString("N4") : "-")
                                    </span>
                                }
                            </td>
                            <td class="ui-acc-journal-amount-col">
                                @if (IsEditable)
                                {
                                    <UiAccountingNumberField Label=""
                                                             Value="@currentLine.CreditAmount"
                                                             ValueChanged="@(value => OnCreditChanged(currentLine, value))"
                                                             Min="0"
                                                             Step="0.01"
                                                             Tone="@UiAccountingNumberField.NumberTone.Danger" />
                                }
                                else
                                {
                                    <span class="ui-acc-val--credit">
                                        @(currentLine.CreditAmount > 0 ? currentLine.CreditAmount.ToString("N4") : "-")
                                    </span>
                                }
                            </td>
                            <td class="ui-acc-journal-base-col ui-acc-val--debit">
                                @(currentLine.BaseDebitAmount > 0 ? currentLine.BaseDebitAmount.ToString("N4") : "-")
                            </td>
                            <td class="ui-acc-journal-base-col ui-acc-val--credit">
                                @(currentLine.BaseCreditAmount > 0 ? currentLine.BaseCreditAmount.ToString("N4") : "-")
                            </td>
                            @if (IsEditable)
                            {
                                <td>
                                    <UiButton Text=""
                                              IconCssClass="fa-solid fa-trash-can"
                                              Variant="ButtonVariant.Ghost"
                                              Size="ControlSize.Small"
                                              OnClick="@(() => RemoveLine(currentLine))" />
                                </td>
                            }
                        </tr>
                        idx++;
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="11" class="text-start font-bold">
                        <span>الإجمالي بالعملة الأساسية</span>
                        <span class="ms-3">
                            @if (IsBalanced)
                            {
                                <span class="badge bg-success-subtle text-success p-1 ms-2">
                                    <i class="fa-solid fa-check me-1"></i> متوازن ✓
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger p-1 ms-2">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                    غير متوازن (الفرق: @Difference.ToString("N4"))
                                </span>
                            }
                        </span>
                    </td>
                    <td class="ui-acc-val--debit font-bold">@TotalDebit.ToString("N4")</td>
                    <td class="ui-acc-val--credit font-bold">@TotalCredit.ToString("N4")</td>
                    @if (IsEditable)
                    {
                        <td></td>
                    }
                </tr>
            </tfoot>
        </table>
    </div>

    @if (IsEditable)
    {
        <div class="ui-acc-lines-editor__actions">
            <UiButton Text="إضافة سطر جديد"
                      IconCssClass="fa-solid fa-plus"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      OnClick="AddLine" />
        </div>
    }
</div>

@code {
    public sealed class EditableJournalLine
    {
        public Guid? AccountId { get; set; }
        public string AccountDisplay { get; set; } = string.Empty;
        public UiLookupItem? AccountLookupItem { get; set; }

        public string Description { get; set; } = string.Empty;

        public Guid? CostCenterId { get; set; }
        public string? CostCenterDisplay { get; set; }
        public UiLookupItem? CostCenterLookupItem { get; set; }

        public Guid? CustomerId { get; set; }
        public UiLookupItem? CustomerLookupItem { get; set; }

        public Guid? SupplierId { get; set; }
        public UiLookupItem? SupplierLookupItem { get; set; }

        public Guid? EmployeeId { get; set; }
        public UiLookupItem? EmployeeLookupItem { get; set; }

        public Guid? ProductVariantId { get; set; }
        public Guid? WarehouseId { get; set; }

        public Guid? TransactionCurrencyId { get; set; }
        public string? CurrencyCode { get; set; }
        public UiLookupItem? CurrencyLookupItem { get; set; }

        // System rate is preview-only. ManualExchangeRate is sent only when the user
        // explicitly enters a non-zero override, so normal users do not accidentally
        // trigger the override permission rule.
        public decimal? ResolvedExchangeRate { get; set; }
        public decimal? ManualExchangeRate { get; set; }

        // Debit/Credit here are transaction-currency amounts.
        public decimal DebitAmount { get; set; }
        public decimal CreditAmount { get; set; }

        public decimal? EffectiveExchangeRate =>
            ManualExchangeRate is > 0 ? ManualExchangeRate : ResolvedExchangeRate;

        public decimal BaseDebitAmount =>
            DebitAmount <= 0 ? 0m : DebitAmount * (EffectiveExchangeRate ?? 1m);

        public decimal BaseCreditAmount =>
            CreditAmount <= 0 ? 0m : CreditAmount * (EffectiveExchangeRate ?? 1m);
    }

    [Parameter] public List<EditableJournalLine> Lines { get; set; } = [];
    [Parameter] public bool IsEditable { get; set; } = true;
    [Parameter] public DateOnly RateDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);

    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? AccountSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CostCenterSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CustomerSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SupplierSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? EmployeeSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CurrencySearchAsync { get; set; }
    [Parameter] public Func<Guid, DateOnly, CancellationToken, Task<decimal?>>? EffectiveRateAsync { get; set; }

    [Parameter] public EventCallback OnLinesChanged { get; set; }

    public decimal TotalDebit => Lines.Sum(l => l.BaseDebitAmount);
    public decimal TotalCredit => Lines.Sum(l => l.BaseCreditAmount);
    public decimal Difference => Math.Abs(TotalDebit - TotalCredit);
    public bool IsBalanced => TotalDebit == TotalCredit && TotalDebit > 0;

    private async Task AddLine()
    {
        Lines.Add(new EditableJournalLine());
        await OnLinesChanged.InvokeAsync();
    }

    private async Task RemoveLine(EditableJournalLine line)
    {
        Lines.Remove(line);
        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnAccountSelected(EditableJournalLine line, string? val)
    {
        line.AccountId = Parse(val);
        line.AccountLookupItem = await ResolveAsync(AccountSearchAsync, line.AccountId);
        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnCostCenterSelected(EditableJournalLine line, string? val)
    {
        line.CostCenterId = Parse(val);
        line.CostCenterLookupItem = await ResolveAsync(CostCenterSearchAsync, line.CostCenterId);
        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnCustomerSelected(EditableJournalLine line, string? val)
    {
        line.CustomerId = Parse(val);
        if (line.CustomerId.HasValue)
        {
            line.SupplierId = null;
            line.SupplierLookupItem = null;
            line.EmployeeId = null;
            line.EmployeeLookupItem = null;
        }
        line.CustomerLookupItem = await ResolveAsync(CustomerSearchAsync, line.CustomerId);
        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnSupplierSelected(EditableJournalLine line, string? val)
    {
        line.SupplierId = Parse(val);
        if (line.SupplierId.HasValue)
        {
            line.CustomerId = null;
            line.CustomerLookupItem = null;
            line.EmployeeId = null;
            line.EmployeeLookupItem = null;
        }
        line.SupplierLookupItem = await ResolveAsync(SupplierSearchAsync, line.SupplierId);
        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnEmployeeSelected(EditableJournalLine line, string? val)
    {
        line.EmployeeId = Parse(val);
        if (line.EmployeeId.HasValue)
        {
            line.CustomerId = null;
            line.CustomerLookupItem = null;
            line.SupplierId = null;
            line.SupplierLookupItem = null;
        }
        line.EmployeeLookupItem = await ResolveAsync(EmployeeSearchAsync, line.EmployeeId);
        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnCurrencySelected(EditableJournalLine line, string? val)
    {
        line.TransactionCurrencyId = Parse(val);
        line.CurrencyLookupItem = await ResolveAsync(CurrencySearchAsync, line.TransactionCurrencyId);
        line.CurrencyCode = line.CurrencyLookupItem?.PrimaryText?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        line.ManualExchangeRate = null;
        line.ResolvedExchangeRate = null;

        if (line.TransactionCurrencyId is Guid currencyId && EffectiveRateAsync is not null)
        {
            line.ResolvedExchangeRate = await EffectiveRateAsync(currencyId, RateDate, CancellationToken.None);
        }

        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnManualRateChanged(EditableJournalLine line, decimal value)
    {
        line.ManualExchangeRate = value > 0 ? value : null;
        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnDescriptionChanged(EditableJournalLine line, string? val)
    {
        line.Description = val ?? string.Empty;
        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnDebitChanged(EditableJournalLine line, decimal amount)
    {
        line.DebitAmount = Math.Max(0, amount);
        if (line.DebitAmount > 0) line.CreditAmount = 0;
        await OnLinesChanged.InvokeAsync();
    }

    private async Task OnCreditChanged(EditableJournalLine line, decimal amount)
    {
        line.CreditAmount = Math.Max(0, amount);
        if (line.CreditAmount > 0) line.DebitAmount = 0;
        await OnLinesChanged.InvokeAsync();
    }

    private static Guid? Parse(string? value) =>
        Guid.TryParse(value, out var id) ? id : null;

    private static async Task<UiLookupItem?> ResolveAsync(
        Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? search,
        Guid? id)
    {
        if (!id.HasValue || search is null) return null;
        var items = await search(string.Empty, CancellationToken.None);
        return items.FirstOrDefault(x =>
            string.Equals(x.Value, id.Value.ToString("D"), StringComparison.OrdinalIgnoreCase));
    }
}
