@namespace OAS.UiLib.Components.Accounting.Workspace

<div class="ui-acc-clickable-surface" role="button" tabindex="0" @onclick="HandleClickAsync" @onkeydown="HandleKeyDownAsync">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private Task HandleClickAsync() => OnClick.InvokeAsync();

    private Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
            return OnClick.InvokeAsync();
        return Task.CompletedTask;
    }
}
