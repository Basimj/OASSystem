@namespace OAS.UiLib.Components.Accounting.Workspace

<section class="@CssClass" dir="rtl">
    @if (InlineTabsWithActions && ShowTabs && Tabs is not null)
    {
        @* شجرة الحسابات: تبويبات الحسابات وأوامر الصفحة في شريط واحد. *@
        <div class="ui-acc-workspace__combined-toolbar">
            <div class="ui-acc-workspace__tabs">
                @Tabs
            </div>
            @if (Actions is not null)
            {
                <div class="ui-acc-workspace__actions">
                    @Actions
                </div>
            }
        </div>
    }
    else
    {
        @if (Actions is not null)
        {
            <div class="ui-acc-workspace__actions">
                @Actions
            </div>
        }

        @if (ShowTabs && Tabs is not null)
        {
            <div class="ui-acc-workspace__tabs">
                @Tabs
            </div>
        }
    }

    @if (Metrics is not null)
    {
        <div class="ui-acc-metrics">
            @Metrics
        </div>
    }

    <div class="ui-acc-workspace__body">
        @Body
    </div>
</section>

@code {
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Metrics { get; set; }
    // Compatibility: existing pages may still pass ShowTabs and Tabs.
    [Parameter] public RenderFragment? Tabs { get; set; }
    [Parameter] public bool ShowTabs { get; set; }
    [Parameter] public bool InlineTabsWithActions { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public string? AdditionalCssClass { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(AdditionalCssClass)
        ? "ui-acc-workspace"
        : $"ui-acc-workspace {AdditionalCssClass}";
}
