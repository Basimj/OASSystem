@namespace OAS.UiLib.Components.Accounting.Workspace

<div class="ui-acc-readonly-field">
    <span class="ui-acc-readonly-field__label">@Label</span>
    <span class="@ValueCssClass">@Value</span>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public ValueTone Tone { get; set; }

    private string ValueCssClass => Tone switch
    {
        ValueTone.Primary => "ui-acc-readonly-field__value ui-acc-readonly-field__value--primary",
        ValueTone.Success => "ui-acc-readonly-field__value ui-acc-readonly-field__value--success",
        ValueTone.Danger => "ui-acc-readonly-field__value ui-acc-readonly-field__value--danger",
        _ => "ui-acc-readonly-field__value"
    };

    public enum ValueTone
    {
        Default,
        Primary,
        Success,
        Danger
    }
}
