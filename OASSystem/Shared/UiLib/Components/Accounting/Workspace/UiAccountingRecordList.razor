@namespace OAS.UiLib.Components.Accounting.Workspace

<div class="ui-acc-record-list" dir="rtl">
    @if (Items.Count == 0)
    {
        <UiAccountingEmptyState IconCssClass="@EmptyIconCssClass"
                                Title="@EmptyTitle"
                                Description="@EmptyDescription" />
    }
    else
    {
        @foreach (var item in Items)
        {
            <button type="button"
                    class="ui-acc-record-row"
                    @onclick="() => OpenAsync(item.Id)">
                <span class="ui-acc-record-row__icon" aria-hidden="true">
                    <i class="@item.IconCssClass"></i>
                </span>

                <span class="ui-acc-record-row__content">
                    <span class="ui-acc-record-row__heading">
                        <strong>@item.Title</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                        {
                            <small>@item.Subtitle</small>
                        }
                    </span>

                    @if (item.Details.Count > 0)
                    {
                        <span class="ui-acc-record-row__details">
                            @foreach (var detail in item.Details)
                            {
                                <span class="ui-acc-record-detail">
                                    <small>@detail.Label</small>
                                    <strong class="@detail.ValueCssClass">@detail.Value</strong>
                                </span>
                            }
                        </span>
                    }
                </span>

                <span class="ui-acc-record-row__status">
                    @if (!string.IsNullOrWhiteSpace(item.StatusText))
                    {
                        <UiAccountingStatusBadge Text="@item.StatusText"
                                                 State="@item.StatusState" />
                    }
                    <i class="fa-solid fa-chevron-left ui-acc-record-row__chevron" aria-hidden="true"></i>
                </span>
            </button>
        }
    }
</div>

@code {
    public sealed record DetailItem(string Label, string Value, string? ValueCssClass = null);

    public sealed record RecordItem(
        Guid Id,
        string Title,
        string? Subtitle,
        string IconCssClass,
        IReadOnlyList<DetailItem> Details,
        string? StatusText = null,
        string StatusState = "draft");

    [Parameter] public IReadOnlyList<RecordItem> Items { get; set; } = [];
    [Parameter] public string EmptyTitle { get; set; } = "لا توجد بيانات";
    [Parameter] public string EmptyDescription { get; set; } = "ابدأ بإضافة أول سجل أو غيّر معايير البحث.";
    [Parameter] public string EmptyIconCssClass { get; set; } = "fa-regular fa-folder-open";
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    private Task OpenAsync(Guid id) => OnOpen.InvokeAsync(id);
}
