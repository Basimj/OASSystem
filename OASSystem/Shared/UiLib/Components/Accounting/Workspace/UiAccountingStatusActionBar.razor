@namespace OAS.UiLib.Components.Accounting.Workspace

<div class="ui-acc-status-action-bar">
    <div class="ui-acc-status-action-bar__status">
        <span class="ui-acc-status-action-bar__label">@Label</span>
        <UiAccountingStatusBadge Text="@StatusText" State="@StatusState" />
    </div>
    @if (Actions is not null)
    {
        <div class="ui-acc-status-action-bar__actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "الحالة الحالية";
    [Parameter] public string StatusText { get; set; } = string.Empty;
    [Parameter] public string StatusState { get; set; } = "draft";
    [Parameter] public RenderFragment? Actions { get; set; }
}
