@namespace OAS.UiLib.Components.Accounting.Workspace

<div class="ui-acc-doc-header" dir="rtl">
    <div class="ui-acc-doc-header__info">
        <div class="ui-acc-doc-header__title-row">
            <h3 class="ui-acc-doc-header__title">@Title</h3>
            @if (!string.IsNullOrWhiteSpace(StatusText))
            {
                <UiAccountingStatusBadge Text="@StatusText" State="@StatusState" />
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <div class="ui-acc-doc-header__subtitle">@Subtitle</div>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="ui-acc-doc-header__actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? StatusText { get; set; }
    [Parameter] public string StatusState { get; set; } = "draft";
    [Parameter] public RenderFragment? Actions { get; set; }
}
