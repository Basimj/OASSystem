@namespace OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Core.Models.Accounting
@using System.Linq

<section class="oas-acc-dashboard" dir="rtl" aria-busy="@IsLoading">
    <header class="oas-acc-dashboard__header">
        <div class="oas-acc-dashboard__intro">
            <span class="oas-acc-dashboard__intro-icon" aria-hidden="true"><i class="fa-solid fa-calculator"></i></span>
            <div>
                <div class="oas-acc-dashboard__breadcrumbs" aria-label="المسار الحالي">الرئيسية <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> المحاسبة والمالية</div>
                <h1>@Title</h1>
                <p>@Subtitle</p>
            </div>
        </div>

        <div class="oas-acc-dashboard__header-actions">
            <a class="oas-acc-dashboard__action oas-acc-dashboard__action--primary" href="@PrimaryHref">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                <span>@PrimaryActionText</span>
            </a>
            <button type="button" class="oas-acc-dashboard__action oas-acc-dashboard__action--secondary"
                    disabled="@IsLoading" @onclick="InvokeRefreshAsync">
                <i class="fa-solid fa-rotate @(IsLoading ? "fa-spin" : null)" aria-hidden="true"></i>
                <span>تحديث</span>
            </button>
            <a class="oas-acc-dashboard__period" href="/accounting/fiscal-years" title="عرض السنوات والفترات المالية">
                <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
                <span>الفترة المالية: <strong>@CurrentPeriodName</strong></span>
            </a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorText))
    {
        <div class="oas-acc-dashboard__error" role="alert">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span>تعذر تحديث لوحة المحاسبة. @ErrorText</span>
            <button type="button" disabled="@IsLoading" @onclick="InvokeRefreshAsync">إعادة المحاولة</button>
        </div>
    }

    <section class="oas-acc-dashboard__summary" aria-label="مؤشرات المحاسبة">
        @foreach (var metric in Metrics)
        {
            <a href="@metric.Href" class="oas-acc-dashboard__metric oas-acc-dashboard__metric--@metric.Accent"
               aria-label="@($"{metric.Label}: {metric.Value}. {metric.Meta}")">
                <div class="oas-acc-dashboard__metric-top">
                    <span class="oas-acc-dashboard__metric-title">@metric.Label</span>
                    <span class="oas-acc-dashboard__metric-icon" aria-hidden="true"><i class="@metric.IconCssClass"></i></span>
                </div>
                <strong class="oas-acc-dashboard__metric-value">@metric.Value</strong>
                @if (!string.IsNullOrWhiteSpace(metric.Meta))
                {
                    <span class="oas-acc-dashboard__metric-note">@metric.Meta</span>
                }
                <i class="fa-solid fa-chevron-left oas-acc-dashboard__metric-arrow" aria-hidden="true"></i>
            </a>
        }
    </section>

    <section class="oas-acc-dashboard__navigation" aria-labelledby="accounting-shortcuts-title">
        <div class="oas-acc-dashboard__navigation-header">
            <h2 id="accounting-shortcuts-title">الوصول السريع للوحدات</h2>
            <p>أهم المهام، مرتبة حسب مجال العمل</p>
        </div>
        <div class="oas-acc-dashboard__groups">
            @foreach (var entry in Sections.Select((section, index) => new { Section = section, Index = index }))
            {
                var group = entry.Section;
                <section class="oas-acc-dashboard__group oas-acc-dashboard__group--@entry.Index">
                    <div class="oas-acc-dashboard__group-header">
                        <h3><i class="@group.IconCssClass" aria-hidden="true"></i> @group.Title</h3>
                        @if (group.Tiles.Any(tile => tile.IsSecondary))
                        {
                            <details class="oas-acc-dashboard__group-more">
                                <summary title="المزيد من صفحات @group.Title" aria-label="المزيد من صفحات @group.Title"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></summary>
                                <div class="oas-acc-dashboard__group-menu">
                                    @foreach (var tile in group.Tiles.Where(tile => tile.IsSecondary))
                                    {
                                        <a href="@tile.Href">@tile.Title</a>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                    <div class="oas-acc-dashboard__tiles">
                        @foreach (var tile in group.Tiles.Where(tile => !tile.IsSecondary).Take(4))
                        {
                            <a class="oas-acc-dashboard__tile" href="@tile.Href" title="@tile.Description">
                                <span class="oas-acc-dashboard__tile-icon" aria-hidden="true"><i class="@tile.IconCssClass"></i></span>
                                <span class="oas-acc-dashboard__tile-content"><strong>@tile.Title</strong><small>@tile.Description</small></span>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
    </section>

    <div class="oas-acc-dashboard__work-grid">
        <section class="oas-acc-dashboard__panel oas-acc-dashboard__panel--attention" aria-labelledby="accounting-attention-title">
            <div class="oas-acc-dashboard__panel-header">
                <h2 id="accounting-attention-title"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> تحتاج إلى انتباه</h2>
                <span class="oas-acc-dashboard__panel-count">@AttentionItems.Count</span>
            </div>
            <div class="oas-acc-dashboard__panel-body" tabindex="0" role="region" aria-label="قائمة التنبيهات المحاسبية">
                @if (IsLoading && AttentionItems.Count == 0)
                {
                    <div class="oas-acc-dashboard__empty"><i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i> جارٍ تحميل التنبيهات...</div>
                }
                else if (AttentionItems.Count == 0)
                {
                    <div class="oas-acc-dashboard__empty @(string.IsNullOrWhiteSpace(ErrorText) ? "oas-acc-dashboard__empty--success" : "")">
                        <i class="@(string.IsNullOrWhiteSpace(ErrorText) ? "fa-regular fa-circle-check" : "fa-solid fa-circle-info")" aria-hidden="true"></i>
                        <span>@(string.IsNullOrWhiteSpace(ErrorText) ? "لا توجد مهام محاسبية تحتاج انتباهًا حاليًا." : "تعذر تحميل التنبيهات المحاسبية.")</span>
                    </div>
                }
                else
                {
                    @foreach (var item in AttentionItems.Take(4))
                    {
                        <a href="@item.Href" class="oas-acc-dashboard__attention-row oas-acc-dashboard__attention-row--@item.Severity">
                            <span class="oas-acc-dashboard__attention-icon" aria-hidden="true"><i class="@GetAttentionIcon(item.Href)"></i></span>
                            <span class="oas-acc-dashboard__attention-copy"><strong>@item.Title</strong></span>
                            @if (!string.IsNullOrWhiteSpace(item.Meta))
                            {
                                <span class="oas-acc-dashboard__attention-meta">@item.Meta</span>
                            }
                            <i class="fa-solid fa-chevron-left oas-acc-dashboard__attention-chevron" aria-hidden="true"></i>
                        </a>
                    }
                }
            </div>
        </section>

        <section class="oas-acc-dashboard__panel oas-acc-dashboard__panel--activity" aria-labelledby="accounting-activity-title">
            <div class="oas-acc-dashboard__panel-header">
                <h2 id="accounting-activity-title"><i class="fa-regular fa-clock" aria-hidden="true"></i> آخر الأنشطة</h2>
                <a class="oas-acc-dashboard__panel-link" href="/accounting/journal-report">تقرير القيود <i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
            </div>
            <div class="oas-acc-dashboard__panel-body" tabindex="0" role="region" aria-label="قائمة الأنشطة المحاسبية">
                @if (IsLoading && RecentActivities.Count == 0)
                {
                    <div class="oas-acc-dashboard__empty"><i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i> جارٍ تحميل الأنشطة...</div>
                }
                else if (RecentActivities.Count == 0)
                {
                    <div class="oas-acc-dashboard__empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i> @(string.IsNullOrWhiteSpace(ErrorText) ? "لا توجد أنشطة محاسبية حديثة." : "تعذر تحميل الأنشطة المحاسبية.")</div>
                }
                else
                {
                    @foreach (var item in RecentActivities.Take(4))
                    {
                        <a class="oas-acc-dashboard__activity-row" href="@item.Href">
                            <span class="oas-acc-dashboard__activity-icon oas-acc-dashboard__activity-icon--@item.Tone" aria-hidden="true"><i class="@item.IconCssClass"></i></span>
                            <span class="oas-acc-dashboard__activity-copy"><strong>@item.Title</strong><small>@item.Reference</small></span>
                            <span class="oas-acc-dashboard__activity-time">@item.Meta</span>
                        </a>
                    }
                }
            </div>
        </section>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "المحاسبة العامة";
    [Parameter] public string Subtitle { get; set; } = "متابعة العمليات والحالات المالية اليومية";
    [Parameter] public string PrimaryActionText { get; set; } = "قيد يومي جديد";
    [Parameter] public string PrimaryHref { get; set; } = "/accounting/journals?new=true";
    [Parameter] public string CurrentPeriodName { get; set; } = "—";
    [Parameter] public IReadOnlyList<UiAccountingHomeMetric> Metrics { get; set; } = [];
    [Parameter] public IReadOnlyList<UiAccountingHomeSection> Sections { get; set; } = [];
    [Parameter] public IReadOnlyList<UiAccountingHomeAttentionItem> AttentionItems { get; set; } = [];
    [Parameter] public IReadOnlyList<UiAccountingHomeActivityItem> RecentActivities { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private Task InvokeRefreshAsync() => OnRefresh.InvokeAsync();

    private static string GetAttentionIcon(string href) => href switch
    {
        var path when path.Contains("cash-shifts", StringComparison.OrdinalIgnoreCase) => "fa-solid fa-cash-register",
        var path when path.Contains("fiscal", StringComparison.OrdinalIgnoreCase) => "fa-regular fa-calendar-days",
        var path when path.Contains("journals", StringComparison.OrdinalIgnoreCase) => "fa-solid fa-file-circle-exclamation",
        _ => "fa-solid fa-clipboard-check"
    };
}
