@namespace OAS.UiLib.Components.Accounting.Expenses

<div class="ui-acc-card">
    <div class="ui-acc-card__header">
        <div class="ui-acc-card__title">
            <i class="fa-solid fa-receipt" aria-hidden="true"></i>
            <span>سند مصروف: @ExpenseNumber</span>
            <span class="text-muted small">(@DateText)</span>
        </div>
        <OAS.UiLib.Components.Accounting.Workspace.UiAccountingStatusBadge Text="@StatusText" State="@StatusState" />
    </div>
    <div class="ui-acc-card__body">
        <div><strong>بند المصروف:</strong> @ExpenseTypeName</div>
        <div><strong>المبلغ قبل الضريبة:</strong> @Amount.ToString("N2") ر.س</div>
        <div><strong>مبلغ الضريبة:</strong> @TaxAmount.ToString("N2") ر.س</div>
        <div><strong>المبلغ الإجمالي:</strong> <span class="ui-acc-val--credit fs-6">@TotalAmount.ToString("N2") ر.س</span></div>
        <div><strong>طريقة الدفع:</strong> @PaymentMethodText</div>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <div class="grid-col-span-2"><strong>البيان:</strong> @Description</div>
        }
    </div>
    <div class="ui-acc-card__footer">
        @if (OnView.HasDelegate)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OnView">
                <i class="fa-solid fa-eye" aria-hidden="true"></i> التفاصيل
            </button>
        }
        @if (CanPost && OnPost.HasDelegate)
        {
            <button type="button" class="btn btn-sm btn-success" @onclick="OnPost">
                <i class="fa-solid fa-check" aria-hidden="true"></i> ترحيل المصروف
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string ExpenseNumber { get; set; } = string.Empty;
    [Parameter] public string DateText { get; set; } = string.Empty;
    [Parameter] public string ExpenseTypeName { get; set; } = string.Empty;
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public decimal TaxAmount { get; set; }
    [Parameter] public decimal TotalAmount { get; set; }
    [Parameter] public string PaymentMethodText { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string StatusText { get; set; } = string.Empty;
    [Parameter] public string StatusState { get; set; } = "draft";
    [Parameter] public bool CanPost { get; set; }
    [Parameter] public EventCallback OnView { get; set; }
    [Parameter] public EventCallback OnPost { get; set; }
}
