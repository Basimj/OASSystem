@namespace OAS.UiLib.Components.Accounting.Accounts

@if (Nodes.Count == 0)
{
    <div class="ui-acc-tree ui-acc-tree--empty">
        <div class="ui-acc-tree__empty">
            <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
            <span>لا توجد حسابات مطابقة لعرضها في الشجرة.</span>
        </div>
    </div>
}
else
{
    <div class="ui-acc-tree" role="tree" aria-label="شجرة الحسابات">
        @foreach (var node in Nodes.OrderBy(x => x.Code, StringComparer.OrdinalIgnoreCase))
        {
            @RenderNode(node, 0)
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<AccountTreeNode> Nodes { get; set; } = [];
    [Parameter] public Guid? SelectedAccountId { get; set; }
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }
    [Parameter] public bool AutoExpandAll { get; set; }
    [Parameter] public int ExpandAllRequestKey { get; set; }
    [Parameter] public int CollapseAllRequestKey { get; set; }

    private readonly HashSet<Guid> _expanded = [];
    private int _lastExpandAllRequestKey;
    private int _lastCollapseAllRequestKey;

    protected override void OnParametersSet()
    {
        if (AutoExpandAll)
        {
            _expanded.Clear();
            ExpandNodesRecursively(Nodes);
            return;
        }

        if (ExpandAllRequestKey != _lastExpandAllRequestKey)
        {
            _lastExpandAllRequestKey = ExpandAllRequestKey;
            _expanded.Clear();
            ExpandNodesRecursively(Nodes);
        }

        if (CollapseAllRequestKey != _lastCollapseAllRequestKey)
        {
            _lastCollapseAllRequestKey = CollapseAllRequestKey;
            _expanded.Clear();
        }
    }

    private bool IsExpanded(AccountTreeNode node) =>
        node.Children.Count > 0 && (AutoExpandAll || _expanded.Contains(node.Id));

    private void Toggle(Guid id)
    {
        if (AutoExpandAll)
            return;

        if (!_expanded.Add(id))
            _expanded.Remove(id);
    }

    private void ExpandNodesRecursively(IReadOnlyList<AccountTreeNode> nodes)
    {
        foreach (var node in nodes)
        {
            if (node.Children.Count == 0)
                continue;

            _expanded.Add(node.Id);
            ExpandNodesRecursively(node.Children);
        }
    }

    private Task SelectNodeAsync(Guid id) =>
        OnSelect.HasDelegate
            ? OnSelect.InvokeAsync(id)
            : Task.CompletedTask;

    private static string GetLevelColor(int level) =>
        (level % 7) switch
        {
            0 => "var(--oas-color-primary)",
            1 => "var(--oas-color-primary-hover)",
            2 => "color-mix(in srgb, var(--oas-color-primary) 80%, var(--oas-color-text))",
            3 => "color-mix(in srgb, var(--oas-color-primary) 72%, var(--oas-color-surface))",
            4 => "color-mix(in srgb, var(--oas-color-primary) 60%, var(--oas-color-text))",
            5 => "color-mix(in srgb, var(--oas-color-primary) 85%, var(--oas-color-surface))",
            _ => "var(--oas-color-primary-border)"
        };

    private RenderFragment RenderNode(AccountTreeNode node, int level) => @<div class="ui-acc-tree__node">
        <div class="ui-acc-tree__row @(SelectedAccountId == node.Id ? "is-selected" : null) @(node.Children.Count > 0 ? "is-branch" : "is-leaf") @(level == 0 ? "is-root" : null)"
             style="--ui-acc-tree-level:@level; --ui-acc-tree-level-color:@GetLevelColor(level)"
             role="treeitem"
             aria-expanded="@(node.Children.Count > 0 ? IsExpanded(node) : null)">
            @if (node.Children.Count > 0)
            {
                <button type="button"
                        class="ui-acc-tree__toggle"
                        aria-label="@(IsExpanded(node) ? "طي" : "توسيع")"
                        @onclick="() => Toggle(node.Id)">
                    <i class="fa-solid @(IsExpanded(node) ? "fa-chevron-down" : "fa-chevron-left")" aria-hidden="true"></i>
                </button>
            }
            else
            {
                <span class="ui-acc-tree__toggle ui-acc-tree__toggle--spacer" aria-hidden="true"></span>
            }

            <button type="button"
                    class="ui-acc-tree__link"
                    title="@($"{node.Code} - {node.NameAr}")"
                    @onclick="() => SelectNodeAsync(node.Id)">
                <span class="ui-acc-tree__icon" aria-hidden="true">
                    <i class="fa-solid fa-folder"></i>
                </span>
                <span class="ui-acc-tree__name">@node.NameAr</span>
                <span class="ui-acc-tree__code">@node.Code</span>
                @if (!node.IsActive)
                {
                    <span class="ui-acc-tree__badge">معطل</span>
                }
            </button>
        </div>

        @if (node.Children.Count > 0 && IsExpanded(node))
        {
            <div class="ui-acc-tree__children" role="group">
                @foreach (var child in node.Children.OrderBy(x => x.Code, StringComparer.OrdinalIgnoreCase))
                {
                    @RenderNode(child, level + 1)
                }
            </div>
        }
    </div>;
}
