@namespace OAS.UiLib.Components.Accounting.Accounts

@if (Nodes.Count == 0)
{
    <div class="ui-acc-tree ui-acc-tree--empty">
        <div class="ui-acc-tree__empty">
            <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
            <span>لا توجد حسابات مطابقة لعرضها في الشجرة.</span>
        </div>
    </div>
}
else
{
    <div class="ui-acc-tree" role="tree" aria-label="شجرة الحسابات">
        @foreach (var node in Nodes.OrderBy(x => x.Code, StringComparer.OrdinalIgnoreCase))
        {
            @RenderNode(node, 0)
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<AccountTreeNode> Nodes { get; set; } = [];
    [Parameter] public Guid? SelectedAccountId { get; set; }
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }

    private readonly HashSet<Guid> _expanded = [];

    protected override void OnParametersSet()
    {
        EnsureExpandedState(Nodes, 0);
    }

    private void EnsureExpandedState(IEnumerable<AccountTreeNode> nodes, int level)
    {
        foreach (var node in nodes)
        {
            if (node.Children.Count > 0 && (level == 0 || ContainsSelected(node)))
            {
                _expanded.Add(node.Id);
            }

            EnsureExpandedState(node.Children, level + 1);
        }
    }

    private bool ContainsSelected(AccountTreeNode node)
    {
        if (!SelectedAccountId.HasValue)
            return false;

        if (node.Id == SelectedAccountId.Value)
            return true;

        return node.Children.Any(ContainsSelected);
    }

    private bool IsExpanded(AccountTreeNode node) =>
        node.Children.Count == 0 || _expanded.Contains(node.Id);

    private void Toggle(Guid id)
    {
        if (!_expanded.Add(id))
            _expanded.Remove(id);
    }

    private Task SelectNodeAsync(Guid id) =>
        OnSelect.HasDelegate
            ? OnSelect.InvokeAsync(id)
            : Task.CompletedTask;

    private RenderFragment RenderNode(AccountTreeNode node, int level) => @<div class="ui-acc-tree__node">
        <div class="ui-acc-tree__row @(SelectedAccountId == node.Id ? "is-selected" : null)"
             style="--ui-acc-tree-level:@level"
             role="treeitem"
             aria-expanded="@(node.Children.Count > 0 ? IsExpanded(node) : null)">
            @if (node.Children.Count > 0)
            {
                <button type="button"
                        class="ui-acc-tree__toggle"
                        aria-label="@(IsExpanded(node) ? "طي" : "توسيع")"
                        @onclick="() => Toggle(node.Id)">
                    <i class="fa-solid @(IsExpanded(node) ? "fa-chevron-down" : "fa-chevron-left")" aria-hidden="true"></i>
                </button>
            }
            else
            {
                <span class="ui-acc-tree__toggle ui-acc-tree__toggle--spacer" aria-hidden="true"></span>
            }

            <button type="button"
                    class="ui-acc-tree__link"
                    @onclick="() => SelectNodeAsync(node.Id)">
                <span class="ui-acc-tree__icon" aria-hidden="true">
                    <i class="fa-solid @(node.Children.Count > 0 ? "fa-folder-tree" : "fa-file-lines")"></i>
                </span>
                <span class="ui-acc-tree__text">
                    <span class="ui-acc-tree__code">@node.Code</span>
                    <span class="ui-acc-tree__name">@node.NameAr</span>
                </span>
                @if (!node.IsActive)
                {
                    <span class="ui-acc-tree__badge">معطل</span>
                }
            </button>
        </div>

        @if (node.Children.Count > 0 && IsExpanded(node))
        {
            <div class="ui-acc-tree__children" role="group">
                @foreach (var child in node.Children.OrderBy(x => x.Code, StringComparer.OrdinalIgnoreCase))
                {
                    @RenderNode(child, level + 1)
                }
            </div>
        }
    </div>;
}
