@namespace OAS.UiLib.Components.Accounting.Inputs

<div class="input-group">
    <span class="input-group-text bg-light text-muted small">@Currency</span>
    <input type="number"
           class="form-control text-end @(IsDebit ? "ui-acc-val--debit" : (IsCredit ? "ui-acc-val--credit" : ""))"
           step="@Step"
           min="0"
           value="@Value"
           disabled="@Disabled"
           @onchange="HandleChangeAsync" />
</div>

@code {
    [Parameter] public decimal Value { get; set; }
    [Parameter] public EventCallback<decimal> ValueChanged { get; set; }
    [Parameter] public string Currency { get; set; } = "ر.س";
    [Parameter] public string Step { get; set; } = "0.01";
    [Parameter] public bool IsDebit { get; set; }
    [Parameter] public bool IsCredit { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task HandleChangeAsync(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            Value = val;
            await ValueChanged.InvokeAsync(val);
        }
    }
}
