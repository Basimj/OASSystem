@namespace OAS.UiLib.Components.Accounting.Vouchers

<div class="ui-acc-card">
    <div class="ui-acc-card__header">
        <div class="ui-acc-card__title">
            <i class="fa-solid @(IsReceipt ? "fa-file-invoice-dollar" : "fa-money-bill-transfer")" aria-hidden="true"></i>
            <span>@(IsReceipt ? "سند قبض" : "سند صرف") رقم: @VoucherNumber</span>
            <span class="text-muted small">(@DateText)</span>
        </div>
        <OAS.UiLib.Components.Accounting.Workspace.UiAccountingStatusBadge Text="@StatusText" State="@StatusState" />
    </div>
    <div class="ui-acc-card__body">
        <div><strong>المبلغ:</strong> <span class="ui-acc-val--debit fs-5">@Amount.ToString("N2") ر.س</span></div>
        <div><strong>الطرف:</strong> @PartyName</div>
        <div><strong>طريقة الدفع:</strong> @PaymentMethodText</div>
        <div><strong>الحساب المستلم/الدافع:</strong> @AccountName</div>
        @if (!string.IsNullOrWhiteSpace(ReferenceNumber))
        {
            <div><strong>المرجع:</strong> @ReferenceNumber</div>
        }
        <div><strong>المبلغ المخصص:</strong> @AllocatedAmount.ToString("N2") ر.س</div>
    </div>
    <div class="ui-acc-card__footer">
        @if (OnView.HasDelegate)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OnView">
                <i class="fa-solid fa-eye" aria-hidden="true"></i> التفاصيل والتخصيص
            </button>
        }
        @if (CanPost && OnPost.HasDelegate)
        {
            <button type="button" class="btn btn-sm btn-success" @onclick="OnPost">
                <i class="fa-solid fa-check" aria-hidden="true"></i> اعتماد وترحيل
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsReceipt { get; set; } = true;
    [Parameter] public string VoucherNumber { get; set; } = string.Empty;
    [Parameter] public string DateText { get; set; } = string.Empty;
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public string PartyName { get; set; } = string.Empty;
    [Parameter] public string PaymentMethodText { get; set; } = string.Empty;
    [Parameter] public string AccountName { get; set; } = string.Empty;
    [Parameter] public string? ReferenceNumber { get; set; }
    [Parameter] public decimal AllocatedAmount { get; set; }
    [Parameter] public string StatusText { get; set; } = string.Empty;
    [Parameter] public string StatusState { get; set; } = "draft";
    [Parameter] public bool CanPost { get; set; }
    [Parameter] public EventCallback OnView { get; set; }
    [Parameter] public EventCallback OnPost { get; set; }
}
