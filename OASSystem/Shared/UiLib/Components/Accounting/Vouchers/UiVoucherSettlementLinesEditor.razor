@namespace OAS.UiLib.Components.Accounting.Vouchers
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<div class="ui-acc-settlement-lines oas-voucher-lines oas-voucher-lines--ledger" dir="rtl">
    <div class="oas-voucher-lines__top-grid">
    <section class="oas-voucher-lines__entry-card" aria-label="بيانات السند والسطر المحدد">
        @VoucherHeader
        @if (ShowDetailContent)
        {
        <div class="oas-voucher-lines__entry-head">
            <div>
                <h3><i class="fa-solid fa-file-lines" aria-hidden="true"></i> بيانات السطر المحدد <span class="oas-voucher-lines__selected-badge">@(SelectedIndex >= 0 ? $"سطر {SelectedIndex + 1} من {Lines.Count}" : "لا توجد أسطر")</span></h3>
            </div>
            <button type="button" class="oas-voucher-lines__toggle" @onclick="ToggleAdvancedAsync" aria-expanded="@ShowAdvanced">
                <i class="fa-solid @(ShowAdvanced ? "fa-compress" : "fa-sliders")" aria-hidden="true"></i>
                @(ShowAdvanced ? "إخفاء الخيارات المتقدمة" : "خيارات متقدمة")
            </button>
        </div>
        @if (SelectedLine is { } line)
        {
            @if (!string.IsNullOrWhiteSpace(line.ValidationError))
            {
                <div class="oas-voucher-lines__error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> @line.ValidationError</div>
            }
            <UiAccountingFormGrid Columns="4" AdditionalCssClass="oas-voucher-lines__fields">
                <UiSelect Label="نوع الطرف"
                          Value="@line.PartyTypeValue"
                          ValueExpression="@(() => line.PartyTypeValue)"
                          ValueChanged="@(value => PartyTypeChangedAsync(line, value))"
                          Options="@PartyTypeOptions"
                          Disabled="@(!IsEditable)"
                          Size="ControlSize.Small" />

                @switch (line.PartyType)
                {
                    case SettlementPartyKind.Customer:
                        <UiLookup Label="العميل"
                                  Value='@line.CustomerId?.ToString("D")'
                                  ValueChanged="@(value => CustomerChangedAsync(line, value))"
                                  SelectedItem="@line.PartyLookupItem"
                                  SearchAsync="CustomerSearchAsync"
                                  Placeholder="ابحث باسم أو كود العميل..."
                                  Disabled="@(!IsEditable)"
                                  Required="true"
                                  MinimumSearchLength="0"
                                  DebounceMilliseconds="250" />
                        break;

                    case SettlementPartyKind.Supplier:
                        <UiLookup Label="المورد"
                                  Value='@line.SupplierId?.ToString("D")'
                                  ValueChanged="@(value => SupplierChangedAsync(line, value))"
                                  SelectedItem="@line.PartyLookupItem"
                                  SearchAsync="SupplierSearchAsync"
                                  Placeholder="ابحث باسم أو كود المورد..."
                                  Disabled="@(!IsEditable)"
                                  Required="true"
                                  MinimumSearchLength="0"
                                  DebounceMilliseconds="250" />
                        break;

                    case SettlementPartyKind.Employee:
                        <UiLookup Label="الموظف"
                                  Value='@line.EmployeeId?.ToString("D")'
                                  ValueChanged="@(value => EmployeeChangedAsync(line, value))"
                                  SelectedItem="@line.PartyLookupItem"
                                  SearchAsync="EmployeeSearchAsync"
                                  Placeholder="ابحث عن موظف مفعل محاسبياً..."
                                  Disabled="@(!IsEditable)"
                                  Required="true"
                                  MinimumSearchLength="0"
                                  DebounceMilliseconds="250" />
                        break;

                    default:
                        <UiInputText Label="اسم الطرف"
                                     Value="@line.PartyName"
                                     ValueExpression="@(() => line.PartyName)"
                                     ValueChanged="@(value => PartyNameChangedAsync(line, value))"
                                     Disabled="@(!IsEditable)"
                                     Required="true"
                                     Placeholder="اسم الشخص أو الجهة..." />

                        <UiLookup Label="الحساب المقابل"
                                  Value='@line.CounterpartyAccountId?.ToString("D")'
                                  ValueChanged="@(value => CounterpartyAccountChangedAsync(line, value))"
                                  SelectedItem="@line.CounterpartyAccountLookupItem"
                                  SearchAsync="CounterpartyAccountSearchAsync"
                                  Placeholder="اختر حساباً مقابلاً صالحاً..."
                                  Disabled="@(!IsEditable)"
                                  Required="true"
                                  MinimumSearchLength="0"
                                  DebounceMilliseconds="250" />
                        break;
                }

                <UiSelect Label="طريقة الدفع"
                          Value="@line.PaymentMethodValue"
                          ValueExpression="@(() => line.PaymentMethodValue)"
                          ValueChanged="@(value => PaymentMethodChangedAsync(line, value))"
                          Options="@PaymentMethodOptions"
                          Disabled="@(!IsEditable)"
                          Size="ControlSize.Small" />

                <UiLookup Label="العملة"
                          Value='@line.CurrencyId?.ToString("D")'
                          ValueChanged="@(value => CurrencyChangedAsync(line, value))"
                          SelectedItem="@line.CurrencyLookupItem"
                          SearchAsync="CurrencySearchAsync"
                          Placeholder="اختر العملة..."
                          Disabled="@(!IsEditable)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />

                <UiAccountingNumberField Label="المبلغ"
                                         Value="@line.Amount"
                                         ValueChanged="@(value => AmountChangedAsync(line, value))"
                                         Min="0.0001"
                                         Disabled="@(!IsEditable)"
                                         Tone="@UiAccountingNumberField.NumberTone.Primary" />

                <div class="ui-acc-settlement-line__rate">
                    <span class="oas-voucher-lines__rate-label">سعر الصرف: @(line.ManualRatePending ? "سعر يدوي مطلوب" : line.EffectiveExchangeRate?.ToString("0.########") ?? "غير متاح")</span>
                    @if (ShowAdvanced)
                    {
                        <label class="oas-voucher-lines__rate-select-label">مصدر سعر الصرف
                            <select class="form-select form-select-sm" value="@(UsesManualRate(line) ? "manual" : "auto")"
                                    @onchange="@(e => ChangeRateModeAsync(line, e.Value?.ToString()))" disabled="@(!IsEditable)">
                                <option value="auto">تلقائي من إعدادات النظام</option>
                                <option value="manual">إدخال يدوي</option>
                            </select>
                        </label>
                        @if (UsesManualRate(line))
                        {
                            <UiAccountingNumberField Label="سعر الصرف اليدوي"
                                                     Value="@(line.ManualExchangeRate ?? 0m)"
                                                     ValueChanged="@(value => RateChangedAsync(line, value))"
                                                     Min="0.00000001"
                                                     Disabled="@(!IsEditable)"
                                                     Tone="@UiAccountingNumberField.NumberTone.Default" />
                        }
                    }
                </div>

                @if (line.PaymentMethod == PaymentMethodKind.Cash)
                {
                    <UiLookup Label="الصندوق"
                              Value='@line.CashAccountId?.ToString("D")'
                              ValueChanged="@(value => CashAccountChangedAsync(line, value))"
                              SelectedItem="@line.SettlementLookupItem"
                              SearchAsync="@((text, ct) => SearchCashAccountsForLineAsync(line, text, ct))"
                              Placeholder="اختر صندوقاً بنفس عملة السطر..."
                              Disabled="@(!IsEditable)"
                              Required="true"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />
                }
                else if (line.PaymentMethod is PaymentMethodKind.BankTransfer or PaymentMethodKind.Cheque or PaymentMethodKind.Card)
                {
                    <UiLookup Label="الحساب البنكي"
                              Value='@line.BankAccountId?.ToString("D")'
                              ValueChanged="@(value => BankAccountChangedAsync(line, value))"
                              SelectedItem="@line.SettlementLookupItem"
                              SearchAsync="@((text, ct) => SearchBankAccountsForLineAsync(line, text, ct))"
                              Placeholder="اختر حساباً بنكياً بنفس عملة السطر..."
                              Disabled="@(!IsEditable)"
                              Required="true"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />
                }
                else
                {
                    <UiLookup Label="حساب التسوية"
                              Value='@line.SettlementAccountId?.ToString("D")'
                              ValueChanged="@(value => SettlementAccountChangedAsync(line, value))"
                              SelectedItem="@line.SettlementLookupItem"
                              SearchAsync="SettlementAccountSearchAsync"
                              Placeholder="اختر حساب تسوية صالحاً..."
                              Disabled="@(!IsEditable)"
                              Required="true"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />
                }

                <UiInputText Label="رقم المرجع"
                             Value="@line.ReferenceNumber"
                             ValueExpression="@(() => line.ReferenceNumber)"
                             ValueChanged="@(value => ReferenceNumberChangedAsync(line, value))"
                             Disabled="@(!IsEditable)"
                             Required="@(line.PaymentMethod == PaymentMethodKind.Cheque)"
                             Placeholder="رقم شيك/تحويل/مرجع..." />

                @if (ShowAdvanced || line.PaymentMethod == PaymentMethodKind.Cheque)
                {
                <UiInputDate Label="تاريخ المرجع"
                             Value="@line.ReferenceDate"
                             ValueExpression="@(() => line.ReferenceDate)"
                             ValueChanged="@(value => ReferenceDateChangedAsync(line, value))"
                             Disabled="@(!IsEditable)"
                             Size="ControlSize.Small" />
                }
            </UiAccountingFormGrid>
            <UiAccountingStack>
                <UiInputText Label="بيان السطر"
                             Value="@line.Description"
                             ValueExpression="@(() => line.Description)"
                             ValueChanged="@(value => DescriptionChangedAsync(line, value))"
                             Disabled="@(!IsEditable)"
                             Placeholder="وصف الحركة أو المرجع المحاسبي..." />
            </UiAccountingStack>
            @if (line.BaseAmount.HasValue || line.ExchangeRateDate.HasValue)
            {
                <div class="ui-acc-settlement-line__snapshot">
                    @if (line.BaseAmount.HasValue)
                    {
                        <span>المبلغ الأساسي: <strong>@line.BaseAmount.Value.ToString("N4")</strong></span>
                    }
                    @if (line.ExchangeRateDate.HasValue)
                    {
                        <span>تاريخ السعر: @line.ExchangeRateDate.Value.ToString("yyyy-MM-dd")</span>
                    }
                    @if (line.ExchangeRateSource.HasValue)
                    {
                        <span>المصدر: @(line.ExchangeRateSource == ExchangeRateSourceKind.Manual ? "يدوي" : "تلقائي")</span>
                    }
                </div>
            }
        }
        else
        {
            <UiAccountingEmptyState Title="لا توجد أسطر"
                                    Description="استخدم إضافة سطر لبدء إدخال المستند."
                                    IconCssClass="fa-solid fa-list-check" />
        }
        }
        @VoucherFooter
    </section>
    @SummaryContent
    </div>

    @if (ShowDetailContent)
    {
    <section class="oas-voucher-lines__ledger-card" aria-label="جدول أسطر السند">
        <div class="oas-voucher-lines__ledger-head">
            <div>
                <h3><i class="fa-solid fa-table-list" aria-hidden="true"></i> أسطر السند</h3>
                <span>انقر تحرير لتغيير السطر في النموذج العلوي. تعرض القيم الحالية دون انتظار الحفظ.</span>
            </div>
            @if (IsEditable)
            {
                <button type="button" class="oas-voucher-lines__add" @onclick="AddAsync">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i> إضافة سطر جديد
                </button>
            }
        </div>
        <div class="oas-voucher-lines__table-scroll" role="region" aria-label="أسطر سند القبض أو الصرف" tabindex="0">
            <table class="oas-voucher-lines__table">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">الحساب / نوع الطرف</th>
                        <th scope="col">الطرف</th>
                        <th scope="col">البيان</th>
                        <th scope="col">العملة</th>
                        <th scope="col">سعر الصرف</th>
                        <th scope="col">المبلغ</th>
                        <th scope="col">طريقة الدفع / المصدر</th>
                        <th scope="col">المرجع</th>
                        <th scope="col">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Lines.Count; index++)
                    {
                        var row = Lines[index];
                        var rowNumber = index + 1;
                        <tr class="@(ReferenceEquals(SelectedLine, row) ? "is-selected" : "")" @key="row">
                            <td>@(index + 1)</td>
                            <td>@AccountDisplay(row)</td>
                            <td>@PartyDisplay(row)</td>
                            <td class="oas-voucher-lines__ellipsis" title="@row.Description">@(string.IsNullOrWhiteSpace(row.Description) ? "—" : row.Description)</td>
                            <td><span class="oas-voucher-lines__currency">@(row.CurrencyCodeSnapshot ?? "—")</span></td>
                            <td class="oas-voucher-lines__amount" dir="ltr">@(row.EffectiveExchangeRate is > 0 && !row.ManualRatePending ? row.EffectiveExchangeRate.Value.ToString("0.########") : "—")</td>
                            <td class="oas-voucher-lines__amount" dir="ltr">@row.Amount.ToString("N2")</td>
                            <td>@PaymentSourceDisplay(row)</td>
                            <td dir="ltr">@(row.ReferenceNumber ?? "—")</td>
                            <td>
                                <div class="oas-voucher-lines__row-actions">
                                    <button type="button" class="oas-voucher-lines__row-button" @onclick="@(() => SelectLine(row))" aria-label="@(IsEditable ? "تحرير" : "عرض") السطر @rowNumber" title="عرض السطر المحدد">
                                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                    </button>
                                    @if (IsEditable)
                                    {
                                        <button type="button" class="oas-voucher-lines__row-button oas-voucher-lines__row-button--danger" @onclick="@(() => RemoveAsync(row))" aria-label="حذف السطر @rowNumber" title="حذف السطر">
                                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="oas-voucher-lines__ledger-footer">
            <span><i class="fa-solid fa-layer-group" aria-hidden="true"></i> @Lines.Count سطر</span>
            @if (Lines.Any(row => row.ManualRatePending || (row.CurrencyId.HasValue && row.CurrencyId != BaseCurrencyId && row.EffectiveExchangeRate is not > 0)))
            {
                <span class="oas-voucher-lines__pending">تحقق من أسعار الصرف المطلوبة قبل الاعتماد</span>
            }
            else
            {
                <span>الإجماليات المفصلة حسب العملة في المراجعة المالية أدناه</span>
            }
        </div>
    </section>
    }
</div>

@code {
    public enum SettlementPartyKind : byte
    {
        Customer = 1,
        Supplier = 2,
        Employee = 3,
        Other = 4
    }

    public enum PaymentMethodKind : byte
    {
        Cash = 1,
        Card = 2,
        BankTransfer = 3,
        Cheque = 4,
        Other = 5
    }

    public enum ExchangeRateSourceKind : byte
    {
        System = 1,
        Manual = 2
    }

    public sealed class EditableSettlementLine
    {
        public SettlementPartyKind PartyType { get; set; } = SettlementPartyKind.Customer;
        public Guid? CustomerId { get; set; }
        public Guid? SupplierId { get; set; }
        public Guid? EmployeeId { get; set; }
        public string? PartyName { get; set; }
        public Guid? CounterpartyAccountId { get; set; }

        public PaymentMethodKind PaymentMethod { get; set; } = PaymentMethodKind.Cash;
        public Guid? CashAccountId { get; set; }
        public Guid? BankAccountId { get; set; }
        public Guid? SettlementAccountId { get; set; }

        public Guid? CurrencyId { get; set; }
        public string? CurrencyCodeSnapshot { get; set; }
        public decimal Amount { get; set; }
        [System.Text.Json.Serialization.JsonIgnore]
        public string? ValidationError { get; set; }
        [System.Text.Json.Serialization.JsonIgnore]
        public bool ManualRatePending { get; set; }
        public decimal? ResolvedExchangeRate { get; set; }
        public decimal? ManualExchangeRate { get; set; }
        public DateOnly? ExchangeRateDate { get; set; }
        public ExchangeRateSourceKind? ExchangeRateSource { get; set; }
        public decimal? BaseAmount { get; set; }

        public decimal? EffectiveExchangeRate =>
            ManualExchangeRate is > 0 ? ManualExchangeRate : ResolvedExchangeRate;

        public string? ReferenceNumber { get; set; }
        public DateOnly? ReferenceDate { get; set; }
        public string? ReferenceType { get; set; }
        public Guid? ReferenceId { get; set; }
        public string? Description { get; set; }

        public UiLookupItem? PartyLookupItem { get; set; }
        public UiLookupItem? CounterpartyAccountLookupItem { get; set; }
        public UiLookupItem? SettlementLookupItem { get; set; }
        public UiLookupItem? CurrencyLookupItem { get; set; }

        public string PartyTypeValue
        {
            get => PartyType.ToString();
            set { if (Enum.TryParse<SettlementPartyKind>(value, out var parsed)) PartyType = parsed; }
        }

        public string PaymentMethodValue
        {
            get => PaymentMethod.ToString();
            set { if (Enum.TryParse<PaymentMethodKind>(value, out var parsed)) PaymentMethod = parsed; }
        }
    }

    // Keep the same line objects when switching between the table and its editor;
    // this avoids losing unsaved inputs and does not change the API payload.
    private EditableSettlementLine? _selectedLine;
    private EditableSettlementLine? SelectedLine =>
        _selectedLine is not null && Lines.Contains(_selectedLine) ? _selectedLine : Lines.FirstOrDefault();
    private int SelectedIndex => SelectedLine is { } line ? Lines.IndexOf(line) : -1;
    private void SelectLine(EditableSettlementLine line) => _selectedLine = line;

    private static string AccountDisplay(EditableSettlementLine line) => line.PartyType switch
    {
        SettlementPartyKind.Customer => "عميل (حساب مرتبط)",
        SettlementPartyKind.Supplier => "مورد (حساب مرتبط)",
        SettlementPartyKind.Employee => "حساب الموظف",
        _ => line.CounterpartyAccountLookupItem?.PrimaryText ?? "حساب مقابل غير محدد"
    };
    private static string PartyDisplay(EditableSettlementLine line) => line.PartyType == SettlementPartyKind.Other
        ? line.PartyName ?? "—"
        : line.PartyLookupItem?.PrimaryText ?? "لم يُحدد";
    private static string PaymentSourceDisplay(EditableSettlementLine line)
    {
        var method = line.PaymentMethod switch
        {
            PaymentMethodKind.Cash => "نقدي",
            PaymentMethodKind.Card => "بطاقة",
            PaymentMethodKind.BankTransfer => "تحويل بنكي",
            PaymentMethodKind.Cheque => "شيك",
            _ => "تسوية أخرى"
        };
        var source = line.SettlementLookupItem?.PrimaryText;
        return string.IsNullOrWhiteSpace(source) ? method : $"{method} · {source}";
    }

    private bool _advanced;
    private bool _advancedUserSet;
    private readonly HashSet<EditableSettlementLine> _manualRateLines = [];
    private bool ShowAdvanced => _advancedUserSet ? _advanced : Lines.Count > 1;
    private Task ToggleAdvancedAsync()
    {
        _advanced = !ShowAdvanced;
        _advancedUserSet = true;
        return Task.CompletedTask;
    }
    private bool UsesManualRate(EditableSettlementLine line) => line.ManualExchangeRate is > 0 || line.ManualRatePending || _manualRateLines.Contains(line);
    private async Task ChangeRateModeAsync(EditableSettlementLine line, string? mode)
    {
        if (mode == "manual")
        {
            _manualRateLines.Add(line);
            line.ManualExchangeRate ??= line.ResolvedExchangeRate;
        }
        else
        {
            _manualRateLines.Remove(line);
            line.ManualExchangeRate = null;
        }
        line.ManualRatePending = mode == "manual" && line.ManualExchangeRate is not > 0;
        InvalidateSnapshot(line);
        await ChangedAsync();
    }
    private static void InvalidateSnapshot(EditableSettlementLine line)
    {
        line.BaseAmount = null;
        line.ExchangeRateDate = null;
        line.ExchangeRateSource = null;
    }

    [Parameter] public RenderFragment? VoucherHeader { get; set; }
    [Parameter] public RenderFragment? VoucherFooter { get; set; }
    [Parameter] public RenderFragment? SummaryContent { get; set; }
    [Parameter] public bool ShowDetailContent { get; set; } = true;
    [Parameter] public List<EditableSettlementLine> Lines { get; set; } = [];
    [Parameter] public Guid? BaseCurrencyId { get; set; }
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public SettlementPartyKind DefaultPartyType { get; set; } = SettlementPartyKind.Customer;
    [Parameter] public IReadOnlyList<UiSelectOption> PartyTypeOptions { get; set; } = [];
    [Parameter] public IReadOnlyList<UiSelectOption> PaymentMethodOptions { get; set; } = [];
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CustomerSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SupplierSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? EmployeeSearchAsync { get; set; }
    [Parameter] public Func<Guid?, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CashAccountSearchAsync { get; set; }
    [Parameter] public Func<Guid?, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? BankAccountSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CurrencySearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CounterpartyAccountSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SettlementAccountSearchAsync { get; set; }
    [Parameter] public Func<Guid, DateOnly, CancellationToken, Task<decimal?>>? EffectiveRateAsync { get; set; }
    [Parameter] public DateOnly RateDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public EventCallback OnLinesChanged { get; set; }

    private async Task AddAsync()
    {
        var line = new EditableSettlementLine { PartyType = DefaultPartyType };
        Lines.Add(line);
        _selectedLine = line;
        await ChangedAsync();
    }

    private async Task RemoveAsync(EditableSettlementLine line)
    {
        Lines.Remove(line);
        if (ReferenceEquals(_selectedLine, line)) _selectedLine = Lines.FirstOrDefault();
        _manualRateLines.Remove(line);
        await ChangedAsync();
    }

    private async Task PartyTypeChangedAsync(EditableSettlementLine line, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value) && Enum.TryParse<SettlementPartyKind>(value, out var parsed))
            line.PartyType = parsed;
        line.CustomerId = null;
        line.SupplierId = null;
        line.EmployeeId = null;
        line.PartyLookupItem = null;
        if (line.PartyType != SettlementPartyKind.Other)
        {
            line.PartyName = null;
            line.CounterpartyAccountId = null;
            line.CounterpartyAccountLookupItem = null;
        }
        await ChangedAsync();
    }

    private async Task PaymentMethodChangedAsync(EditableSettlementLine line, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value) && Enum.TryParse<PaymentMethodKind>(value, out var parsed))
            line.PaymentMethod = parsed;
        line.CashAccountId = null;
        line.BankAccountId = null;
        line.SettlementAccountId = null;
        line.SettlementLookupItem = null;
        await ChangedAsync();
    }

    private async Task CustomerChangedAsync(EditableSettlementLine line, string? value)
    {
        line.CustomerId = Parse(value); line.SupplierId = null; line.EmployeeId = null;
        line.PartyLookupItem = await ResolveAsync(CustomerSearchAsync, line.CustomerId);
        await ChangedAsync();
    }

    private async Task SupplierChangedAsync(EditableSettlementLine line, string? value)
    {
        line.SupplierId = Parse(value); line.CustomerId = null; line.EmployeeId = null;
        line.PartyLookupItem = await ResolveAsync(SupplierSearchAsync, line.SupplierId);
        await ChangedAsync();
    }

    private async Task EmployeeChangedAsync(EditableSettlementLine line, string? value)
    {
        line.EmployeeId = Parse(value); line.CustomerId = null; line.SupplierId = null;
        line.PartyLookupItem = await ResolveAsync(EmployeeSearchAsync, line.EmployeeId);
        await ChangedAsync();
    }

    private async Task CounterpartyAccountChangedAsync(EditableSettlementLine line, string? value)
    {
        line.CounterpartyAccountId = Parse(value);
        line.CounterpartyAccountLookupItem = await ResolveAsync(CounterpartyAccountSearchAsync, line.CounterpartyAccountId);
        await ChangedAsync();
    }

    private async Task CashAccountChangedAsync(EditableSettlementLine line, string? value)
    {
        line.CashAccountId = Parse(value);
        line.BankAccountId = null;
        line.SettlementAccountId = null;

        line.SettlementLookupItem = null;
        if (line.CashAccountId.HasValue)
        {
            var items = await SearchCashAccountsForLineAsync(
                line,
                string.Empty,
                CancellationToken.None);

            line.SettlementLookupItem = items.FirstOrDefault(
                x => string.Equals(
                    x.Value,
                    line.CashAccountId.Value.ToString("D"),
                    StringComparison.OrdinalIgnoreCase));
        }

        await ChangedAsync();
    }

    private async Task BankAccountChangedAsync(EditableSettlementLine line, string? value)
    {
        line.BankAccountId = Parse(value);
        line.CashAccountId = null;
        line.SettlementAccountId = null;

        line.SettlementLookupItem = null;
        if (line.BankAccountId.HasValue)
        {
            var items = await SearchBankAccountsForLineAsync(
                line,
                string.Empty,
                CancellationToken.None);

            line.SettlementLookupItem = items.FirstOrDefault(
                x => string.Equals(
                    x.Value,
                    line.BankAccountId.Value.ToString("D"),
                    StringComparison.OrdinalIgnoreCase));
        }

        await ChangedAsync();
    }

    private async Task SettlementAccountChangedAsync(EditableSettlementLine line, string? value)
    {
        line.SettlementAccountId = Parse(value); line.CashAccountId = null; line.BankAccountId = null;
        line.SettlementLookupItem = await ResolveAsync(SettlementAccountSearchAsync, line.SettlementAccountId);
        await ChangedAsync();
    }

    private async Task CurrencyChangedAsync(EditableSettlementLine line, string? value)
    {
        var oldCurrencyId = line.CurrencyId;

        line.CurrencyId = Parse(value);
        line.CurrencyLookupItem = await ResolveAsync(CurrencySearchAsync, line.CurrencyId);
        line.CurrencyCodeSnapshot = line.CurrencyLookupItem?.PrimaryText?
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault();

        // A cash/bank account is currency-specific. If the currency changes,
        // any previously selected settlement source must be cleared.
        if (oldCurrencyId != line.CurrencyId)
        {
            line.CashAccountId = null;
            line.BankAccountId = null;

            if (line.PaymentMethod != PaymentMethodKind.Other)
                line.SettlementAccountId = null;

            line.SettlementLookupItem = null;
        }

        line.ManualExchangeRate = null;
        line.ResolvedExchangeRate = null;
        line.ExchangeRateDate = null;
        line.ExchangeRateSource = null;
        line.BaseAmount = null;

        if (line.CurrencyId is Guid currencyId && EffectiveRateAsync is not null)
            line.ResolvedExchangeRate = await EffectiveRateAsync(
                currencyId,
                RateDate,
                CancellationToken.None);

        await ChangedAsync();
    }

    private async Task<IReadOnlyList<UiLookupItem>> SearchCashAccountsForLineAsync(
        EditableSettlementLine line,
        string text,
        CancellationToken cancellationToken)
    {
        if (!line.CurrencyId.HasValue || CashAccountSearchAsync is null)
            return Array.Empty<UiLookupItem>();

        return await CashAccountSearchAsync(
            line.CurrencyId,
            text,
            cancellationToken);
    }

    private async Task<IReadOnlyList<UiLookupItem>> SearchBankAccountsForLineAsync(
        EditableSettlementLine line,
        string text,
        CancellationToken cancellationToken)
    {
        if (!line.CurrencyId.HasValue || BankAccountSearchAsync is null)
            return Array.Empty<UiLookupItem>();

        return await BankAccountSearchAsync(
            line.CurrencyId,
            text,
            cancellationToken);
    }

    private async Task PartyNameChangedAsync(EditableSettlementLine line, string? value) { line.PartyName = value; await ChangedAsync(); }
    private async Task AmountChangedAsync(EditableSettlementLine line, decimal value) { line.Amount = value; InvalidateSnapshot(line); await ChangedAsync(); }
    private async Task RateChangedAsync(EditableSettlementLine line, decimal value)
    {
        line.ManualExchangeRate = value > 0 ? value : null;
        line.ManualRatePending = _manualRateLines.Contains(line) && value <= 0;
        InvalidateSnapshot(line);
        await ChangedAsync();
    }
    private async Task ReferenceNumberChangedAsync(EditableSettlementLine line, string? value) { line.ReferenceNumber = value; await ChangedAsync(); }
    private async Task ReferenceDateChangedAsync(EditableSettlementLine line, DateOnly? value) { line.ReferenceDate = value; await ChangedAsync(); }
    private async Task DescriptionChangedAsync(EditableSettlementLine line, string? value) { line.Description = value; await ChangedAsync(); }

    private Task ChangedAsync()
    {
        foreach (var line in Lines) line.ValidationError = null;
        return OnLinesChanged.InvokeAsync();
    }

    private static Guid? Parse(string? value) => Guid.TryParse(value, out var id) ? id : null;

    private static async Task<UiLookupItem?> ResolveAsync(
        Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? search,
        Guid? id)
    {
        if (!id.HasValue || search is null) return null;
        var items = await search(string.Empty, CancellationToken.None);
        return items.FirstOrDefault(x => string.Equals(x.Value, id.Value.ToString("D"), StringComparison.OrdinalIgnoreCase));
    }
}
