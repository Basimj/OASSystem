@namespace OAS.UiLib.Components.Accounting.Parties
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Spreadsheets
@using OAS.UiLib.Core.Models.Accounting

<UiAccountingWorkspace ShowTabs="false">
    <Actions>
        <UiWorkspaceActionBar>
            @if (!EditorOpen)
            {
                <UiButton Text="جديد" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small" Disabled="Busy" OnClick="@(_ => OnNew.InvokeAsync())" />
                <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Loading="Busy" OnClick="@(_ => OnRefresh.InvokeAsync())" />
                <UiSpreadsheetActions CanImport="true" Busy="Busy" OnImport="OnImport" OnTemplate="OnTemplate" OnExport="OnExport" />
                <UiSelect Label="فلتر" Value="@Filter" ValueChanged="FilterChanged" Options="@FilterOptions" Disabled="Busy" />
                <UiSearchInput Value="@Search" ValueChanged="SearchChanged" OnSearch="OnSearch" Placeholder="@SearchPlaceholder" DebounceMilliseconds="300" />
            }
            else
            {
                <UiButton Text="حفظ" IconCssClass="fa-solid fa-floppy-disk" Size="ControlSize.Small" Loading="Busy" Disabled="Busy" OnClick="@(_ => OnSave.InvokeAsync())" />
                <UiButton Text="إلغاء" IconCssClass="fa-solid fa-arrow-rotate-left" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="Busy" OnClick="@(_ => OnCancel.InvokeAsync())" />
                @if (!IsNew && Form.Id.HasValue)
                {
                    <UiButton Text="@(Form.IsActive ? "تعطيل" : "تفعيل")" IconCssClass="@(Form.IsActive ? "fa-solid fa-ban" : "fa-solid fa-circle-check")" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Disabled="Busy" OnClick="@(_ => OnToggleStatus.InvokeAsync())" />
                }
            }
        </UiWorkspaceActionBar>
    </Actions>
    <Body>
        @if (!EditorOpen)
        {
            <UiAccountingRecordList Items="@RecordItems" OnOpen="OnOpen" EmptyTitle="@(IsSupplier ? "لا يوجد موردون" : "لا يوجد عملاء")" EmptyDescription="ابدأ بإضافة أول سجل أو غيّر معايير البحث." EmptyIconCssClass="@(IsSupplier ? "fa-solid fa-truck-field" : "fa-solid fa-users")" />
            <div class="ui-acc-pager" dir="rtl">
                <UiButton Text="السابق" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Disabled="@(Busy || PageNumber <= 1)" OnClick="@(_ => OnPreviousPage.InvokeAsync())" />
                <span>صفحة @PageNumber من @Math.Max(1, TotalPages) — @TotalCount سجل</span>
                <UiButton Text="التالي" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Disabled="@(Busy || PageNumber >= TotalPages)" OnClick="@(_ => OnNextPage.InvokeAsync())" />
            </div>
        }
        else
        {
            <UiAccountingEditorSurface>
                <UiAccountingFormSection Title="البيانات الأساسية" Subtitle="الهوية التشغيلية والبيانات التجارية" IconCssClass="fa-solid fa-address-card">
                    <UiAccountingFormGrid Columns="3">
                        <UiInputText Label="@(IsSupplier ? "كود المورد" : "كود العميل")" Value="@Form.Code" ReadOnly="true" Disabled="true" Placeholder="يتم حجزه تلقائيًا عند الضغط على جديد" />
                        <UiInputText Label="كود الحساب" Value="@Form.AccountCode" ReadOnly="true" Disabled="true" Placeholder="ينشأ تلقائيًا عند الحفظ" />
                        <UiSelect Label="الحساب الرئيسي" Value="@Form.ParentAccountId" ValueChanged="SetParent" Options="@ParentOptions" Placeholder="اختر حساب المراقبة" Required="true" Disabled="@(!IsNew || Busy)" />
                        <UiSelect Label="نوع الكيان" Value="@Form.EntityType" ValueChanged="SetEntityType" Options="@EntityTypeOptions" Required="true" Disabled="Busy" />
                        @if (IsSupplier)
                        {
                            <UiSelect Label="نطاق المورد" Value="@Form.SupplierScope" ValueChanged="SetSupplierScope" Options="@SupplierScopeOptions" Required="true" Disabled="Busy" />
                        }
                        <UiInputText Label="الاسم العربي" Value="@Form.NameAr" ValueChanged="SetNameAr" Required="true" Disabled="Busy" MaxLength="150" />
                        <UiInputText Label="الاسم الإنجليزي" Value="@Form.NameEn" ValueChanged="SetNameEn" Disabled="Busy" MaxLength="150" />
                        <UiInputText Label="الاسم التجاري" Value="@Form.TradeName" ValueChanged="SetTradeName" Disabled="Busy" MaxLength="150" />
                        <UiInputText Label="رقم الهوية" Value="@Form.NationalId" ValueChanged="SetNationalId" Disabled="Busy" MaxLength="50" />
                        <UiInputText Label="السجل التجاري" Value="@Form.CommercialRegistrationNo" ValueChanged="SetCommercialRegistration" Disabled="Busy" MaxLength="50" />
                        <UiInputText Label="الرقم الضريبي" Value="@Form.TaxNumber" ValueChanged="SetTaxNumber" Disabled="Busy" MaxLength="50" />
                        @if (!IsSupplier)
                        {
                            <UiInputDate Label="تاريخ الميلاد" Value="@Form.DateOfBirth" ValueChanged="SetDateOfBirth" Disabled="Busy" />
                            <UiSelect Label="الجنس" Value="@Form.Gender" ValueChanged="SetGender" Options="@GenderOptions" Disabled="Busy" />
                        }
                        <UiInputDate Label="@(IsSupplier ? "بداية التعامل مع المورد" : "بداية التعامل مع العميل")" Value="@Form.Since" ValueChanged="SetSince" Disabled="Busy" />
                    </UiAccountingFormGrid>
                </UiAccountingFormSection>

                <UiAccountingFormSection Title="التواصل" Subtitle="وسائل التواصل ومسؤول الاتصال" IconCssClass="fa-solid fa-address-book" Collapsible="true">
                    <UiAccountingFormGrid Columns="3">
                        <UiInputText Label="مسؤول التواصل" Value="@Form.ContactPersonName" ValueChanged="SetContactPersonName" Disabled="Busy" MaxLength="150" />
                        <UiInputText Label="صفة مسؤول التواصل" Value="@Form.ContactPersonTitle" ValueChanged="SetContactPersonTitle" Disabled="Busy" MaxLength="100" />
                        <UiSelect Label="وسيلة التواصل المفضلة" Value="@Form.PreferredContactMethod" ValueChanged="SetPreferredContactMethod" Options="@ContactOptions" Required="true" Disabled="Busy" />
                        <UiInputText Label="الهاتف" Value="@Form.Phone" ValueChanged="SetPhone" Disabled="Busy" MaxLength="32" />
                        <UiInputText Label="الجوال" Value="@Form.Mobile" ValueChanged="SetMobile" Disabled="Busy" MaxLength="32" />
                        <UiInputText Label="رقم بديل" Value="@Form.AlternatePhone" ValueChanged="SetAlternatePhone" Disabled="Busy" MaxLength="32" />
                        <UiInputText Label="واتساب" Value="@Form.WhatsAppNumber" ValueChanged="SetWhatsApp" Disabled="Busy" MaxLength="32" />
                        <UiInputText Label="البريد الإلكتروني" Value="@Form.Email" ValueChanged="SetEmail" Disabled="Busy" MaxLength="256" />
                        <UiInputText Label="الموقع الإلكتروني" Value="@Form.Website" ValueChanged="SetWebsite" Disabled="Busy" MaxLength="300" />
                    </UiAccountingFormGrid>
                </UiAccountingFormSection>

                <UiAccountingFormSection Title="العنوان" Subtitle="بيانات العنوان التفصيلية" IconCssClass="fa-solid fa-location-dot" Collapsible="true">
                    <UiAccountingFormGrid Columns="4">
                        <UiInputText Label="الدولة" Value="@Form.Country" ValueChanged="SetCountry" Disabled="Busy" MaxLength="100" />
                        <UiInputText Label="المحافظة" Value="@Form.Governorate" ValueChanged="SetGovernorate" Disabled="Busy" MaxLength="100" />
                        <UiInputText Label="المدينة" Value="@Form.City" ValueChanged="SetCity" Disabled="Busy" MaxLength="100" />
                        <UiInputText Label="الحي / المنطقة" Value="@Form.District" ValueChanged="SetDistrict" Disabled="Busy" MaxLength="100" />
                        <UiInputText Label="الشارع" Value="@Form.Street" ValueChanged="SetStreet" Disabled="Busy" MaxLength="150" />
                        <UiInputText Label="المبنى" Value="@Form.Building" ValueChanged="SetBuilding" Disabled="Busy" MaxLength="100" />
                        <UiInputText Label="الرمز البريدي" Value="@Form.PostalCode" ValueChanged="SetPostalCode" Disabled="Busy" MaxLength="24" />
                        <UiInputText Label="تفاصيل إضافية" Value="@Form.AddressDetails" ValueChanged="SetAddressDetails" Disabled="Busy" MaxLength="300" />
                    </UiAccountingFormGrid>
                </UiAccountingFormSection>

                <UiAccountingFormSection Title="@(IsSupplier ? "الشروط التجارية" : "الائتمان")" Subtitle="حدود وشروط السداد" IconCssClass="fa-solid fa-money-check-dollar">
                    <UiAccountingFormGrid Columns="3">
                        @if (!IsSupplier)
                        {
                            <UiCheckbox Label="السماح بالبيع الآجل" Value="@Form.IsCreditAllowed" ValueChanged="SetCreditAllowed" Disabled="Busy" />
                        }
                        <UiAccountingNumberField Label="الحد الائتماني" Value="@Form.CreditLimit" ValueChanged="SetCreditLimit" Disabled="@(Busy || (!IsSupplier && !Form.IsCreditAllowed))" Min="0" />
                        <UiAccountingNumberField Label="أيام السداد" Value="@Form.PaymentTermDays" ValueChanged="SetPaymentTermDays" Disabled="@(Busy || (!IsSupplier && !Form.IsCreditAllowed))" Min="0" Step="1" />
                        @if (IsSupplier)
                        {
                            <UiAccountingNumberField Label="مدة التوريد الافتراضية بالأيام" Value="@(Form.DefaultLeadTimeDays ?? 0)" ValueChanged="SetLeadTime" Disabled="Busy" Min="0" Step="1" />
                        }
                        <UiCheckbox Label="نشط" Value="@Form.IsActive" ValueChanged="SetActive" Disabled="@(Busy || !IsNew)" />
                        <UiInputText Label="ملاحظات" Value="@Form.Notes" ValueChanged="SetNotes" Disabled="Busy" MaxLength="1000" />
                    </UiAccountingFormGrid>
                </UiAccountingFormSection>
            </UiAccountingEditorSurface>
        }
    </Body>
</UiAccountingWorkspace>

@code {
    [Parameter] public bool IsSupplier { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool EditorOpen { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public UiAccountingPartyFormModel Form { get; set; } = new();
    [Parameter] public IReadOnlyList<UiAccountingPartyListItem> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<UiAccountingPartyParentOption> Parents { get; set; } = [];
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public string Filter { get; set; } = "all";
    [Parameter] public int PageNumber { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public EventCallback<string?> SearchChanged { get; set; }
    [Parameter] public EventCallback<string?> FilterChanged { get; set; }
    [Parameter] public EventCallback<string?> OnSearch { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnToggleStatus { get; set; }
    [Parameter] public EventCallback OnPreviousPage { get; set; }
    [Parameter] public EventCallback OnNextPage { get; set; }
    [Parameter] public EventCallback OnImport { get; set; }
    [Parameter] public EventCallback OnTemplate { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }

    private string SearchPlaceholder => IsSupplier ? "ابحث بكود المورد أو الحساب أو الاسم أو الجوال أو الرقم الضريبي..." : "ابحث بكود العميل أو الحساب أو الاسم أو الجوال أو الرقم الضريبي...";
    private IReadOnlyList<UiAccountingRecordList.RecordItem> RecordItems => Items.Select(x => new UiAccountingRecordList.RecordItem(
        x.Id, $"{x.Code} · {x.Name}", string.IsNullOrWhiteSpace(x.SecondaryName) ? x.AccountCode : $"{x.AccountCode} · {x.SecondaryName}", IsSupplier ? "fa-solid fa-truck-field" : "fa-solid fa-user-tie",
        new[] { new UiAccountingRecordList.DetailItem("النوع", x.EntityLabel), new UiAccountingRecordList.DetailItem("الجوال", x.Mobile ?? "—"), new UiAccountingRecordList.DetailItem("الموقع", x.Location ?? "—"), new UiAccountingRecordList.DetailItem("بيانات", x.CommercialInfo ?? "—"), new UiAccountingRecordList.DetailItem(IsSupplier ? "الشروط" : "الائتمان", x.CreditOrTerms) },
        x.IsActive ? "نشط" : "غير نشط", x.IsActive ? "active" : "inactive")).ToArray();
    private IReadOnlyList<UiSelectOption> ParentOptions => Parents.Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.Code} - {x.Name}")).ToArray();
    private static readonly IReadOnlyList<UiSelectOption> EntityTypeOptions = [new("1", "فرد"), new("2", "منشأة")];
    private static readonly IReadOnlyList<UiSelectOption> SupplierScopeOptions = [new("1", "محلي"), new("2", "دولي")];
    private static readonly IReadOnlyList<UiSelectOption> GenderOptions = [new("0", "غير محدد"), new("1", "ذكر"), new("2", "أنثى")];
    private static readonly IReadOnlyList<UiSelectOption> ContactOptions = [new("1", "هاتف"), new("2", "جوال"), new("3", "واتساب"), new("4", "بريد إلكتروني")];
    private IReadOnlyList<UiSelectOption> FilterOptions => IsSupplier
        ? [new("all", "الكل"), new("active", "نشط"), new("inactive", "غير نشط"), new("individual", "أفراد"), new("organization", "منشآت"), new("local", "محلي"), new("international", "دولي")]
        : [new("all", "الكل"), new("active", "نشط"), new("inactive", "غير نشط"), new("individual", "أفراد"), new("organization", "منشآت"), new("credit", "بيع آجل"), new("cash", "نقدي فقط")];

    private Task Changed() => InvokeAsync(StateHasChanged);
    private Task SetParent(string? v) { Form.ParentAccountId = v ?? ""; return Changed(); }
    private Task SetEntityType(string? v) { Form.EntityType = v ?? "1"; return Changed(); }
    private Task SetSupplierScope(string? v) { Form.SupplierScope = v ?? "1"; return Changed(); }
    private Task SetGender(string? v) { Form.Gender = v ?? "0"; return Changed(); }
    private Task SetPreferredContactMethod(string? v) { Form.PreferredContactMethod = v ?? "2"; return Changed(); }
    private Task SetNameAr(string? v) { Form.NameAr = v ?? ""; return Changed(); }
    private Task SetNameEn(string? v) { Form.NameEn = v; return Changed(); }
    private Task SetTradeName(string? v) { Form.TradeName = v; return Changed(); }
    private Task SetNationalId(string? v) { Form.NationalId = v; return Changed(); }
    private Task SetCommercialRegistration(string? v) { Form.CommercialRegistrationNo = v; return Changed(); }
    private Task SetTaxNumber(string? v) { Form.TaxNumber = v; return Changed(); }
    private Task SetDateOfBirth(DateOnly? v) { Form.DateOfBirth = v; return Changed(); }
    private Task SetSince(DateOnly? v) { Form.Since = v; return Changed(); }
    private Task SetContactPersonName(string? v) { Form.ContactPersonName = v; return Changed(); }
    private Task SetContactPersonTitle(string? v) { Form.ContactPersonTitle = v; return Changed(); }
    private Task SetPhone(string? v) { Form.Phone = v; return Changed(); }
    private Task SetMobile(string? v) { Form.Mobile = v; return Changed(); }
    private Task SetAlternatePhone(string? v) { Form.AlternatePhone = v; return Changed(); }
    private Task SetWhatsApp(string? v) { Form.WhatsAppNumber = v; return Changed(); }
    private Task SetEmail(string? v) { Form.Email = v; return Changed(); }
    private Task SetWebsite(string? v) { Form.Website = v; return Changed(); }
    private Task SetCountry(string? v) { Form.Country = v; return Changed(); }
    private Task SetGovernorate(string? v) { Form.Governorate = v; return Changed(); }
    private Task SetCity(string? v) { Form.City = v; return Changed(); }
    private Task SetDistrict(string? v) { Form.District = v; return Changed(); }
    private Task SetStreet(string? v) { Form.Street = v; return Changed(); }
    private Task SetBuilding(string? v) { Form.Building = v; return Changed(); }
    private Task SetPostalCode(string? v) { Form.PostalCode = v; return Changed(); }
    private Task SetAddressDetails(string? v) { Form.AddressDetails = v; return Changed(); }
    private Task SetCreditAllowed(bool v) { Form.IsCreditAllowed = v; if (!v) { Form.CreditLimit = 0; Form.PaymentTermDays = 0; } return Changed(); }
    private Task SetCreditLimit(decimal v) { Form.CreditLimit = v; return Changed(); }
    private Task SetPaymentTermDays(decimal v) { Form.PaymentTermDays = (int)v; return Changed(); }
    private Task SetLeadTime(decimal v) { Form.DefaultLeadTimeDays = (int)v; return Changed(); }
    private Task SetActive(bool v) { Form.IsActive = v; return Changed(); }
    private Task SetNotes(string? v) { Form.Notes = v; return Changed(); }
}

