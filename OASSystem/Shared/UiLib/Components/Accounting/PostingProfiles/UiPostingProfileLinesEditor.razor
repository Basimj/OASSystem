@namespace OAS.UiLib.Components.Accounting.PostingProfiles

<div class="ui-acc-lines-editor" dir="rtl">
    <div class="table-responsive">
        <table class="ui-acc-grid-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الدور المحاسبي</th>
                    <th>الحساب المرتبط</th>
                    <th>إلزامي</th>
                    @if (IsEditable)
                    {
                        <th>إجراء</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Lines.Count == 0)
                {
                    <tr>
                        <td colspan="@(IsEditable ? 5 : 4)" class="text-center text-muted py-3">لا توجد أدوار محاسبية في هذا الملف.</td>
                    </tr>
                }
                else
                {
                    @for (var i = 0; i < Lines.Count; i++)
                    {
                        var line = Lines[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>
                                @if (IsEditable)
                                {
                                    <UiInputText Value="@line.AccountRole"
                                                 ValueChanged="@(value => RoleChangedAsync(line, value))"
                                                 Placeholder="مثال: Cash أو ARControl" />
                                }
                                else
                                {
                                    <strong>@line.AccountRole</strong>
                                }
                            </td>
                            <td>
                                @if (IsEditable)
                                {
                                    <UiLookup Value='@line.AccountId?.ToString("D")'
                                              ValueChanged="@(value => AccountChangedAsync(line, value))"
                                              SelectedItem="@line.AccountLookupItem"
                                              SearchAsync="AccountSearchAsync"
                                              Placeholder="اختر الحساب..."
                                              Required="true"
                                              MinimumSearchLength="0"
                                              DebounceMilliseconds="250" />
                                }
                                else
                                {
                                    <span>@(line.AccountLookupItem?.PrimaryText ?? line.AccountDisplay)</span>
                                }
                            </td>
                            <td>
                                <UiCheckbox Value="@line.IsRequired"
                                            ValueChanged="@(value => RequiredChangedAsync(line, value))"
                                            Disabled="@(!IsEditable)" />
                            </td>
                            @if (IsEditable)
                            {
                                <td>
                                    <UiButton Text=""
                                              IconCssClass="fa-solid fa-trash-can"
                                              Variant="ButtonVariant.Ghost"
                                              Size="ControlSize.Small"
                                              OnClick="@(() => RemoveAsync(line))" />
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (IsEditable)
    {
        <div class="ui-acc-lines-editor__actions">
            <UiButton Text="إضافة دور محاسبي"
                      IconCssClass="fa-solid fa-plus"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      OnClick="AddAsync" />
        </div>
    }
</div>

@code {
    public sealed class EditablePostingProfileLine
    {
        public string AccountRole { get; set; } = "Cash";
        public Guid? AccountId { get; set; }
        public string AccountDisplay { get; set; } = string.Empty;
        public UiLookupItem? AccountLookupItem { get; set; }
        public bool IsRequired { get; set; } = true;
    }

    [Parameter] public List<EditablePostingProfileLine> Lines { get; set; } = [];
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? AccountSearchAsync { get; set; }
    [Parameter] public EventCallback OnLinesChanged { get; set; }

    private async Task AddAsync()
    {
        Lines.Add(new EditablePostingProfileLine());
        await OnLinesChanged.InvokeAsync();
    }

    private async Task RemoveAsync(EditablePostingProfileLine line)
    {
        Lines.Remove(line);
        await OnLinesChanged.InvokeAsync();
    }

    private async Task RoleChangedAsync(EditablePostingProfileLine line, string? value)
    {
        line.AccountRole = value?.Trim() ?? string.Empty;
        await OnLinesChanged.InvokeAsync();
    }

    private async Task AccountChangedAsync(EditablePostingProfileLine line, string? value)
    {
        line.AccountId = Guid.TryParse(value, out var id) ? id : null;
        if (line.AccountId is Guid accountId && AccountSearchAsync is not null)
        {
            var items = await AccountSearchAsync(string.Empty, CancellationToken.None);
            line.AccountLookupItem = items.FirstOrDefault(x => string.Equals(x.Value, accountId.ToString("D"), StringComparison.OrdinalIgnoreCase));
            if (line.AccountLookupItem is not null)
                line.AccountDisplay = line.AccountLookupItem.PrimaryText;
        }
        await OnLinesChanged.InvokeAsync();
    }

    private async Task RequiredChangedAsync(EditablePostingProfileLine line, bool value)
    {
        line.IsRequired = value;
        await OnLinesChanged.InvokeAsync();
    }
}
