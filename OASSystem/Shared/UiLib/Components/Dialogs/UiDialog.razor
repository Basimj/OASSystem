<section class="@CssClass"
         role="dialog"
         aria-modal="true"
         aria-label="@Title"
         @onclick:stopPropagation="true">
    @if (!string.IsNullOrWhiteSpace(Title) || ShowCloseButton)
    {
        <header class="ui-dialog__header">
            <UiTextLabel Text="@Title" Weight="TextWeight.Semibold" />
            @if (ShowCloseButton)
            {
                <button type="button" class="ui-dialog__close" aria-label="@L["Close"]" @onclick="CloseAsync">×</button>
            }
        </header>
    }
    <div class="ui-dialog__body">@ChildContent</div>
    @if (Footer is not null)
    {
        <footer class="ui-dialog__footer">@Footer</footer>
    }
</section>
