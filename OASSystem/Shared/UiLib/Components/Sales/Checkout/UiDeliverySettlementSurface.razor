@namespace OAS.UiLib.Components.Sales.Checkout
@using OAS.UiLib.Core.Models.Sales

<div class="ui-sales-flow ui-sales-delivery" dir="rtl"><div class="ui-sales-flow__topbar"><div><h2>تسليم للعميل</h2><p>تحصيل المتبقي عند الحاجة ثم إغلاق الطلب.</p></div><UiButton Text="تحصيل وتسليم" IconCssClass="fa-solid fa-hand-holding" Size="ControlSize.Small" Loading="@IsBusy" OnClick="DeliverClicked"/></div>@if(!string.IsNullOrWhiteSpace(ErrorText)){<div class="ui-sales-flow__message is-error">@ErrorText</div>}@if(!string.IsNullOrWhiteSpace(SuccessText)){<div class="ui-sales-flow__message is-success">@SuccessText</div>}<div class="ui-sales-flow__cards ui-sales-flow__cards--4"><div class="ui-sales-flow__metric"><span>الطلب</span><strong>@Model.OrderCode</strong></div><div class="ui-sales-flow__metric"><span>العميل</span><strong>@Model.CustomerText</strong></div><div class="ui-sales-flow__metric"><span>الفاتورة</span><strong>@(Model.InvoiceCode??"—")</strong></div><div class="ui-sales-flow__metric"><span>خطة السداد</span><strong>@Model.PaymentPlan</strong></div></div><section class="ui-sales-flow__section ui-sales-flow__summary"><div><span>الإجمالي</span><strong>@Money(Model.Total) @Model.CurrencyCode</strong></div><div><span>المدفوع</span><strong>@Money(Model.Paid)</strong></div><div><span>العربون المطبق</span><strong>@Money(Model.AppliedAdvances)</strong></div><div class="is-outstanding"><span>المتبقي</span><strong>@Money(Model.Outstanding)</strong></div></section>
@if(Model.Outstanding>0 && Model.PaymentPlan!="AccountCredit"){<section class="ui-sales-flow__section"><header><div><i class="fa-solid fa-wallet"></i><span><strong>تحصيل المتبقي</strong><small>يجب أن تغطي الدفعات المبلغ المستحق وفق سياسة التسليم</small></span></div></header><div class="ui-sales-flow__payment-lines">@for(var i=0;i<Model.PaymentLines.Count;i++){var p=Model.PaymentLines[i];var idx=i;<div class="ui-sales-flow__payment-line"><label><span>الطريقة</span><select @bind="p.PaymentMethod"><option value="Cash">نقدي</option><option value="Card">بطاقة</option><option value="BankTransfer">تحويل بنكي</option><option value="Cheque">شيك</option><option value="Other">أخرى</option></select></label><UiLookup Label="العملة" Value="@p.CurrencyId" ValueChanged="v=>CurrencyChanged(p,v)" SelectedItem="@CurrencyItem(p)" SearchAsync="SearchCurrenciesAsync" Placeholder="العملة"/><label><span>المبلغ</span><input type="number" step="0.01" min="0" @bind="p.Amount"/></label>@if(p.PaymentMethod=="Cash"){<UiLookup Label="الصندوق" Value="@p.CashAccountId" ValueChanged="v=>CashChanged(p,v)" SelectedItem="@CashItem(p)" SearchAsync="(q,ct)=>SearchCashAccountsAsync is null?Task.FromResult<IReadOnlyList<UiLookupItem>>([]):SearchCashAccountsAsync(p,q,ct)"/>}@if(p.PaymentMethod is "Card" or "BankTransfer" or "Cheque"){<UiLookup Label="البنك" Value="@p.BankAccountId" ValueChanged="v=>BankChanged(p,v)" SelectedItem="@BankItem(p)" SearchAsync="(q,ct)=>SearchBankAccountsAsync is null?Task.FromResult<IReadOnlyList<UiLookupItem>>([]):SearchBankAccountsAsync(p,q,ct)"/>}@if(p.PaymentMethod=="Other"){<UiLookup Label="حساب التسوية" Value="@p.SettlementAccountId" ValueChanged="v=>SettlementChanged(p,v)" SelectedItem="@SettlementItem(p)" SearchAsync="SearchSettlementAccountsAsync"/>}<button type="button" class="ui-sales-flow__remove" @onclick="()=>Remove(idx)"><i class="fa-solid fa-trash"></i></button></div>}<UiButton Text="إضافة دفعة" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="AddClicked"/></div></section>}
@if(Model.PaymentPlan=="AccountCredit" && Model.Outstanding>0){<div class="ui-sales-flow__message is-info"><i class="fa-solid fa-circle-info"></i><span>العملية بيع آجل؛ يسمح بالتسليم مع بقاء المبلغ ضمن الذمم المدينة.</span></div>}</div>

@code{
 [Parameter,EditorRequired]public UiDeliverySettlementModel Model{get;set;}=new();[Parameter]public bool IsBusy{get;set;}[Parameter]public string? ErrorText{get;set;}[Parameter]public string? SuccessText{get;set;}[Parameter]public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? SearchCurrenciesAsync{get;set;}[Parameter]public Func<UiCheckoutPaymentLineModel,string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? SearchCashAccountsAsync{get;set;}[Parameter]public Func<UiCheckoutPaymentLineModel,string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? SearchBankAccountsAsync{get;set;}[Parameter]public Func<string,CancellationToken,Task<IReadOnlyList<UiLookupItem>>>? SearchSettlementAccountsAsync{get;set;}[Parameter]public EventCallback OnDeliver{get;set;}[Parameter]public EventCallback OnChanged{get;set;}
 private Task DeliverClicked(MouseEventArgs _)=>OnDeliver.InvokeAsync();private async Task AddClicked(MouseEventArgs _){Model.PaymentLines.Add(new(){PaymentMethod="Cash",CurrencyId=Model.CurrencyId,CurrencyDisplay=Model.CurrencyCode,Amount=0m});await OnChanged.InvokeAsync();}private async Task Remove(int i){if(i>=0&&i<Model.PaymentLines.Count)Model.PaymentLines.RemoveAt(i);await OnChanged.InvokeAsync();}private async Task CurrencyChanged(UiCheckoutPaymentLineModel p,string? v){p.CurrencyId=v??string.Empty;p.CurrencyDisplay=null;await OnChanged.InvokeAsync();}private async Task CashChanged(UiCheckoutPaymentLineModel p,string? v){p.CashAccountId=v??string.Empty;p.CashAccountDisplay=null;await OnChanged.InvokeAsync();}private async Task BankChanged(UiCheckoutPaymentLineModel p,string? v){p.BankAccountId=v??string.Empty;p.BankAccountDisplay=null;await OnChanged.InvokeAsync();}private async Task SettlementChanged(UiCheckoutPaymentLineModel p,string? v){p.SettlementAccountId=v??string.Empty;await OnChanged.InvokeAsync();}private static UiLookupItem? CurrencyItem(UiCheckoutPaymentLineModel p)=>string.IsNullOrWhiteSpace(p.CurrencyId)?null:new(p.CurrencyId,p.CurrencyDisplay??p.CurrencyId);private static UiLookupItem? CashItem(UiCheckoutPaymentLineModel p)=>string.IsNullOrWhiteSpace(p.CashAccountId)?null:new(p.CashAccountId,p.CashAccountDisplay??p.CashAccountId);private static UiLookupItem? BankItem(UiCheckoutPaymentLineModel p)=>string.IsNullOrWhiteSpace(p.BankAccountId)?null:new(p.BankAccountId,p.BankAccountDisplay??p.BankAccountId);private static UiLookupItem? SettlementItem(UiCheckoutPaymentLineModel p)=>string.IsNullOrWhiteSpace(p.SettlementAccountId)?null:new(p.SettlementAccountId,p.SettlementAccountId);private static string Money(decimal v)=>v.ToString("N2");
}
