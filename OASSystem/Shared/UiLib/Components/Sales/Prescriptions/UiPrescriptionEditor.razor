@namespace OAS.UiLib.Components.Sales.Prescriptions
@using OAS.UiLib.Core.Models.Sales

<div class="oas-rx-prescription-editor" dir="rtl">
    <div class="oas-rx-prescription-editor__fields">
        <UiInputText Label="كود الوصفة" Value="@Model.PrescriptionCode" ValueChanged="CodeChanged" ReadOnly="true" />
        <UiLookup Label="العميل" Value="@Model.CustomerId" ValueChanged="CustomerChanged" SearchAsync="SearchCustomersAsync"
                  SelectedItem="@CustomerItem" Placeholder="ابحث بالكود أو الاسم أو الجوال..." Required="true" Disabled="@(ReadOnly || Model.Id.HasValue)" />
        <UiInputText Label="الطبيب / الفاحص" Value="@Model.PrescribedBy" ValueChanged="PrescriberChanged" ReadOnly="@ReadOnly" />
        <UiInputText Label="العيادة" Value="@Model.ClinicName" ValueChanged="ClinicChanged" ReadOnly="@ReadOnly" />
        <UiInputDate Label="تاريخ الوصفة" Value="@Model.PrescriptionDate" ValueChanged="DateChanged" Required="true" ReadOnly="@ReadOnly" />
    </div>
    @if (ShowNotes)
    {
        <div class="oas-rx-prescription-editor__notes">
            <UiInputText Label="ملاحظات الوصفة" Value="@Model.Notes" ValueChanged="NotesChanged" ReadOnly="@ReadOnly" />
        </div>
    }
</div>

<!-- Historic revisions are rendered in UiPrescriptionRevisionHistory to keep the form compact. -->

@code {
    [Parameter, EditorRequired] public UiPrescriptionFormModel Model { get; set; } = new();
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ShowNotes { get; set; } = true;
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchCustomersAsync { get; set; }
    [Parameter] public EventCallback<string?> OnCustomerSelected { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private UiLookupItem? CustomerItem => string.IsNullOrWhiteSpace(Model.CustomerId) ? null : new(Model.CustomerId, Model.CustomerDisplay ?? Model.CustomerId);
    private async Task CodeChanged(string? value) { Model.PrescriptionCode = value ?? string.Empty; await OnChanged.InvokeAsync(); }
    private async Task CustomerChanged(string? value) { Model.CustomerId = value ?? string.Empty; await OnCustomerSelected.InvokeAsync(value); await OnChanged.InvokeAsync(); }
    private async Task DateChanged(DateOnly? value) { Model.PrescriptionDate = value; await OnChanged.InvokeAsync(); }
    private async Task PrescriberChanged(string? value) { Model.PrescribedBy = value; await OnChanged.InvokeAsync(); }
    private async Task ClinicChanged(string? value) { Model.ClinicName = value; await OnChanged.InvokeAsync(); }
    private async Task NotesChanged(string? value) { Model.Notes = value; await OnChanged.InvokeAsync(); }
}
