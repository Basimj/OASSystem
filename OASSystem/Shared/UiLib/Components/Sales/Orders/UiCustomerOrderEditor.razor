@namespace OAS.UiLib.Components.Sales.Orders
@using OAS.UiLib.Core.Models.Sales

<div class="oas-order-form" dir="rtl">
<UiSalesFormSection Title="بيانات الطلب" IconCss="fa-solid fa-clipboard-list">
    <div class="ui-sales-form-grid oas-order-form__fields">
        <UiInputText Label="كود الطلب" Value="@Model.OrderCode" ReadOnly="true" />
        <UiLookup Label="العميل" Value="@Model.CustomerId" ValueChanged="CustomerChanged" SelectedItem="@CustomerItem"
                  SearchAsync="SearchCustomersAsync" UsePopover="true" Placeholder="ابحث عن العميل..." Required="true" Disabled="@ReadOnly" ErrorText="@CustomerError" />
        <UiLookup Label="إصدار الوصفة" Value="@Model.PrescriptionRevisionId" ValueChanged="PrescriptionChanged" SelectedItem="@PrescriptionItem"
                  SearchAsync="SearchPrescriptionsAsync" UsePopover="true" Placeholder="اختياري" Disabled="@ReadOnly" />
        <UiInputDate Label="تاريخ الطلب" Value="@Model.OrderDate" ValueChanged="OrderDateChanged" Required="true" ReadOnly="@ReadOnly" ErrorText="@OrderDateError" />
        <UiInputDate Label="التاريخ المطلوب" Value="@Model.RequiredDate" ValueChanged="RequiredDateChanged" ReadOnly="@ReadOnly" ErrorText="@RequiredDateError" />
        <UiLookup Label="العملة" Value="@Model.CurrencyId" ValueChanged="CurrencyChanged" SelectedItem="@CurrencyItem"
                  SearchAsync="SearchCurrenciesAsync" UsePopover="true" Placeholder="اختر العملة..." Required="true" Disabled="@ReadOnly" ErrorText="@CurrencyError" />
        <UiSelect Label="طريقة الضريبة" Value="@Model.TaxCalculationMode" ValueChanged="TaxModeChanged" Disabled="@ReadOnly" Options="@TaxOptions" />
        <UiInputText Label="خطة السداد" Value="تُحدد عند إتمام البيع" ReadOnly="true" />
        <UiInputText Label="ملاحظات" Value="@Model.Notes" ValueChanged="NotesChanged" ReadOnly="@ReadOnly" />
    </div>
</UiSalesFormSection>

<UiSalesFormSection Title="بنود الطلب" Description="محرر واسع للبند: نوع المنتج ثم التصنيف ثم المنتج/الصنف والمخزن، مع بيانات الوصفة عند الحاجة." IconCss="fa-solid fa-list">
    @if (LinesError is not null) { <p class="oas-order-field-error" role="alert">@LinesError</p> }
    <UiSalesLinesEditor @ref="_salesLinesEditor" CompactMode="true" Model="@Model.Lines" ReadOnly="@ReadOnly" SearchProductTypesAsync="SearchProductTypesAsync" SearchCategoriesAsync="SearchCategoriesAsync" SearchProductsAsync="SearchProductsAsync"
                        SearchWarehousesAsync="SearchWarehousesAsync" SearchPrescriptionRevisionsAsync="SearchPrescriptionRevisionsAsync"
                        HeaderPrescriptionRevisionId="@Model.PrescriptionRevisionId" HeaderPrescriptionRevisionDisplay="@Model.PrescriptionDisplay"
                        OnProductTypeSelected="OnProductTypeSelected" OnCategorySelected="OnCategorySelected" OnProductSelected="OnProductSelected" OnWarehouseSelected="OnWarehouseSelected" OnChanged="OnChanged" />
</UiSalesFormSection>

<div class="oas-order-form__bottom-panels">
    <section class="oas-order-optical-panel" aria-label="ملخص قياسات العدسات">
        <h3><i class="fa-solid fa-glasses" aria-hidden="true"></i> قياسات العدسات المرتبطة بالطلب</h3>
        @if (!Model.Lines.Any(x => x.LineType == "Lens"))
        {
            <p class="oas-order-optical-panel__hint">عند إضافة بند عدسة ستظهر قياساته هنا؛ ويمكن تعديل المصدر والقياسات من محرر البند.</p>
        }
        else
        {
            <div class="oas-order-optical-table-wrap">
                <table>
                    <thead><tr><th>العين</th><th>المصدر</th><th>SPH</th><th>CYL</th><th>Axis</th><th>ADD</th></tr></thead>
                    <tbody>
                    @foreach (var line in Model.Lines.Where(x => x.LineType == "Lens"))
                    {
                        <tr @key="line"><td>@EyeLabel(line.PrescriptionEye)</td><td>@MeasurementSource(line)</td>
                            <td>@MeasurementValue(line.SPH, line)</td><td>@MeasurementValue(line.CYL, line)</td>
                            <td>@MeasurementAxis(line)</td><td>@MeasurementValue(line.ADD, line)</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <aside class="oas-order-form__state-panel">
        <h3><i class="fa-solid fa-wave-square" aria-hidden="true"></i> الحالة والمتابعة</h3>
        <div><span>حالة الطلب</span><b>@OrderStatusText(Model.Status)</b></div>
        <div><span>إصدار الوصفة</span><b>@(string.IsNullOrWhiteSpace(Model.PrescriptionDisplay) ? "غير محدد" : Model.PrescriptionDisplay)</b></div>
        <div><span>التوفر / المخزون</span><b>يُفحص عند إتمام البيع</b></div>
        <div><span>خطة السداد</span><b>تُحدد عند إتمام البيع</b></div>
    </aside>
</div>
<section class="oas-order-form__totals" aria-label="ملخص الطلب المالي">
    <h3><i class="fa-solid fa-calculator" aria-hidden="true"></i> ملخص الطلب</h3>
    <UiSalesTotalsPanel CurrencyCode="@Model.CurrencyCode" Subtotal="@Model.Subtotal" DiscountAmount="@Model.DiscountAmount" TaxAmount="@Model.TaxAmount" TotalAmount="@Model.TotalAmount" />
</section>
</div>

@code {
    private UiSalesLinesEditor? _salesLinesEditor;
    public void ShowOpticalValidationIssues(IReadOnlyList<(int LineNumber, string Message)> issues)
    {
        _salesLinesEditor?.ShowOpticalValidationIssues(issues);
        StateHasChanged();
    }
    public bool HasInputErrors => _salesLinesEditor?.HasInputErrors == true;
    private bool _showErrors;
    private static bool IsValidGuid(string? value) => Guid.TryParse(value, out var id) && id != Guid.Empty;
    private string? CustomerError => _showErrors && !IsValidGuid(Model.CustomerId) ? "يجب تحديد العميل قبل الحفظ." : null;
    private string? CurrencyError => _showErrors && !IsValidGuid(Model.CurrencyId) ? "يجب تحديد العملة قبل الحفظ." : null;
    private string? OrderDateError => _showErrors && !Model.OrderDate.HasValue ? "يجب تحديد تاريخ الطلب." : null;
    private string? RequiredDateError => _showErrors && Model.OrderDate.HasValue && Model.RequiredDate < Model.OrderDate
        ? "التاريخ المطلوب لا يمكن أن يسبق تاريخ الطلب." : null;
    private string? LinesError => _showErrors && Model.Lines.Count == 0 ? "أضف بندًا واحدًا على الأقل." : null;
    public bool ValidateRequiredInputs()
    {
        _showErrors = true;
        var pricingIsValid = _salesLinesEditor?.ValidatePricingInputs() ?? true;
        StateHasChanged();
        return CustomerError is null && CurrencyError is null && OrderDateError is null
            && RequiredDateError is null && LinesError is null && pricingIsValid && !HasInputErrors;
    }
    private static string EyeLabel(string? eye) => eye switch { "RightOD" => "اليمنى OD", "LeftOS" => "اليسرى OS", _ => "غير محددة" };
    private static string MeasurementSource(UiSalesLineModel line) => line.OpticalMeasurementSource == "Manual" ? "يدوي" : "وصفة محفوظة";
    private static string MeasurementValue(decimal? value, UiSalesLineModel line) => line.OpticalMeasurementSource == "StoredPrescription" ? "من الإصدار المحفوظ" : value?.ToString("0.##") ?? "—";
    private static string MeasurementAxis(UiSalesLineModel line) => line.OpticalMeasurementSource == "StoredPrescription" ? "من الإصدار المحفوظ" : line.Axis?.ToString() ?? "—";
    private static string OrderStatusText(string status) => status switch { "Draft" => "مسودة", "Confirmed" => "مؤكد", "AwaitingStock" => "بانتظار المخزون", "PartiallyAvailable" => "متوفر جزئيًا", "ReadyForProduction" => "جاهز للمعمل", "InProduction" => "قيد التجهيز", "ReadyForDelivery" => "جاهز للتسليم", "Completed" => "مكتمل", "Cancelled" => "ملغى", _ => status };
    private static readonly IReadOnlyList<UiSelectOption> TaxOptions = [new("Exclusive", "غير شامل الضريبة"), new("Inclusive", "شامل الضريبة")];
    [Parameter, EditorRequired] public UiCustomerOrderFormModel Model { get; set; } = new();
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchCustomersAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchPrescriptionsAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchCurrenciesAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchProductTypesAsync { get; set; }
    [Parameter] public Func<UiSalesLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchCategoriesAsync { get; set; }
    [Parameter] public Func<UiSalesLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchProductsAsync { get; set; }
    [Parameter] public Func<UiSalesLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchWarehousesAsync { get; set; }
    [Parameter] public Func<UiSalesLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchPrescriptionRevisionsAsync { get; set; }
    [Parameter] public EventCallback<UiSalesSelectionChange> OnSelectionChanged { get; set; }
    [Parameter] public EventCallback<UiSalesLineSelectionChange> OnProductTypeSelected { get; set; }
    [Parameter] public EventCallback<UiSalesLineSelectionChange> OnCategorySelected { get; set; }
    [Parameter] public EventCallback<UiSalesLineSelectionChange> OnProductSelected { get; set; }
    [Parameter] public EventCallback<UiSalesLineSelectionChange> OnWarehouseSelected { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private UiLookupItem? CustomerItem => string.IsNullOrWhiteSpace(Model.CustomerId) ? null : new(Model.CustomerId, Model.CustomerDisplay ?? Model.CustomerId);
    private UiLookupItem? PrescriptionItem => string.IsNullOrWhiteSpace(Model.PrescriptionRevisionId) ? null : new(Model.PrescriptionRevisionId, Model.PrescriptionDisplay ?? Model.PrescriptionRevisionId);
    private UiLookupItem? CurrencyItem => string.IsNullOrWhiteSpace(Model.CurrencyId) ? null : new(Model.CurrencyId, Model.CurrencyDisplay ?? Model.CurrencyCode ?? Model.CurrencyId);
    private async Task CustomerChanged(string? v) { Model.CustomerId = v ?? string.Empty; await OnSelectionChanged.InvokeAsync(new("Customer", v)); await OnChanged.InvokeAsync(); }
    private async Task PrescriptionChanged(string? v) { Model.PrescriptionRevisionId = v ?? string.Empty; await OnSelectionChanged.InvokeAsync(new("PrescriptionRevision", v)); await OnChanged.InvokeAsync(); }
    private async Task CurrencyChanged(string? v) { Model.CurrencyId = v ?? string.Empty; await OnSelectionChanged.InvokeAsync(new("Currency", v)); await OnChanged.InvokeAsync(); }
    private async Task OrderDateChanged(DateOnly? v) { Model.OrderDate = v; await OnChanged.InvokeAsync(); }
    private async Task RequiredDateChanged(DateOnly? v) { Model.RequiredDate = v; await OnChanged.InvokeAsync(); }
    private async Task TaxModeChanged(string? v) { Model.TaxCalculationMode = v ?? "Exclusive"; await OnChanged.InvokeAsync(); }
    private async Task NotesChanged(string? v) { Model.Notes = v; await OnChanged.InvokeAsync(); }
}
