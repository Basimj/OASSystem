@namespace OAS.UiLib.Components.Sales.Invoices
@using OAS.UiLib.Core.Models.Sales
@using OAS.UiLib.Components.Sales.Orders
@using OAS.UiLib.Components.Sales.Checkout

<UiSalesFormSection Title="بيانات الفاتورة" Description="فاتورة البيع المباشر تستخدم عند توفر الصنف الآن. الطلبات المرتبطة بطلب عميل يتم إصدار فاتورتها تلقائيًا من شاشة بيع جديد / Checkout." IconCss="fa-solid fa-file-invoice-dollar">
    <div class="ui-sales-form-grid">
        <UiInputText Label="كود الفاتورة" Value="@Model.InvoiceCode" ReadOnly="true" />
        @if (!string.IsNullOrWhiteSpace(Model.CustomerOrderId))
        {
            <UiInputText Label="طلب العميل المصدر" Value="@(Model.CustomerOrderDisplay ?? Model.CustomerOrderId)" ReadOnly="true" />
        }

        <UiInputText Label="كود العميل" Value="@Model.CustomerCode" ReadOnly="true" />
        <UiLookup Label="العميل" Value="@Model.CustomerId" ValueChanged="CustomerChanged" SelectedItem="@CustomerItem" SearchAsync="SearchCustomersAsync" Placeholder="ابحث بكود العميل أو الاسم..." Required="true" Disabled="@ReadOnly" />

        <UiLookup Label="موظف المبيعات" Value="@Model.SalesEmployeeId" ValueChanged="SalesEmployeeChanged" SelectedItem="@SalesEmployeeItem" SearchAsync="SearchEmployeesAsync" Placeholder="اختياري - اختر موظف المبيعات" Disabled="@ReadOnly" />
        <UiInputText Label="كود الوصفة" Value="@Model.PrescriptionCode" ReadOnly="true" />
        <UiLookup Label="الوصفة / الإصدار" Value="@Model.PrescriptionRevisionId" ValueChanged="PrescriptionChanged" SelectedItem="@PrescriptionItem" SearchAsync="SearchPrescriptionsAsync" Placeholder="اختياري" Disabled="@ReadOnly" />

        <UiInputDate Label="تاريخ الفاتورة" Value="@Model.InvoiceDate" ValueChanged="InvoiceDateChanged" Required="true" ReadOnly="@ReadOnly" />
        <UiInputDate Label="تاريخ الترحيل" Value="@Model.PostingDate" ValueChanged="PostingDateChanged" Required="true" ReadOnly="@ReadOnly" />
        <UiLookup Label="العملة" Value="@Model.CurrencyId" ValueChanged="CurrencyChanged" SelectedItem="@CurrencyItem" SearchAsync="SearchCurrenciesAsync" Placeholder="اختر العملة..." Required="true" Disabled="@ReadOnly" />
        <UiSelect Label="طريقة الضريبة" Value="@Model.TaxCalculationMode" ValueChanged="TaxModeChanged" Disabled="@ReadOnly" Options="@TaxOptions" />
        <UiSelect Label="خطة السداد" Value="@Model.PaymentPlan" ValueChanged="PaymentPlanChanged" Disabled="@ReadOnly" Options="@PaymentPlanOptions" />
        <UiInputText Label="البيان" Value="@Model.Description" ValueChanged="DescriptionChanged" ReadOnly="@ReadOnly" />
    </div>
</UiSalesFormSection>

<UiSalesFormSection Title="بنود الفاتورة" Description="البيع المباشر مخصص للأصناف المتاحة؛ إذا كان الصنف يحتاج توريدًا خارجيًا أنشئ طلب عميل واستخدم Checkout." IconCss="fa-solid fa-list-check">
    <UiSalesLinesEditor Model="@Model.Lines" ReadOnly="@ReadOnly" SearchProductTypesAsync="SearchProductTypesAsync" SearchCategoriesAsync="SearchCategoriesAsync" SearchProductsAsync="SearchProductsAsync" SearchWarehousesAsync="SearchWarehousesAsync"
                        SearchPrescriptionRevisionsAsync="SearchPrescriptionRevisionsAsync" OnProductTypeSelected="OnProductTypeSelected" OnCategorySelected="OnCategorySelected" OnProductSelected="OnProductSelected" OnWarehouseSelected="OnWarehouseSelected"
                        EnablePriceOverride="true" OnRequestPriceOverride="OnRequestPriceOverride" OnChanged="OnChanged" />
</UiSalesFormSection>

@if (ShowSettlement)
{
    <UiSalesFormSection Title="تحصيل البيع المباشر" Description="الدفع الكامل أو الجزئي يمكن توزيعه على أكثر من طريقة. البيع الآجل لا يقبل دفعات عند الترحيل الأولي." IconCss="fa-solid fa-wallet">
        <UiSalesPaymentLinesEditor Lines="@Model.PaymentLines"
                                   SearchCurrenciesAsync="SearchCurrenciesAsync"
                                   SearchCashAccountsAsync="SearchPaymentCashAccountsAsync"
                                   SearchBankAccountsAsync="SearchPaymentBankAccountsAsync"
                                   SearchSettlementAccountsAsync="SearchSettlementAccountsAsync"
                                   OnAdd="AddPaymentLineAsync"
                                   OnRemove="RemovePaymentLineAsync"
                                   OnChanged="PaymentLinesChangedAsync" />
    </UiSalesFormSection>
}

<div class="ui-sales-summary-grid">
    <UiSalesTotalsPanel CurrencyCode="@Model.CurrencyCode" Subtotal="@Model.Subtotal" DiscountAmount="@Model.DiscountAmount" TaxAmount="@Model.TaxAmount" TotalAmount="@Model.TotalAmount" />
    <UiSalesPaymentSummary CurrencyCode="@Model.CurrencyCode" InvoiceTotal="@Model.TotalAmount" PaidAmount="@Model.PaidAmount" ReturnedAmount="@Model.ReturnedAmount" OutstandingAmount="@Model.OutstandingAmount" />
</div>

<UiSalesPostingSummary JournalEntryId="@Model.JournalEntryId" JournalEntryNumber="@Model.JournalEntryNumber" Issues="@Model.PostingIssues" />

@code {
    private static readonly IReadOnlyList<UiSelectOption> TaxOptions = [new("Exclusive", "غير شامل الضريبة"), new("Inclusive", "شامل الضريبة")];
    private static readonly IReadOnlyList<UiSelectOption> PaymentPlanOptions =
    [
        new("FullNow", "دفع كامل الآن"),
        new("PartialNow", "دفع جزئي الآن"),
        new("AccountCredit", "آجل على الحساب")
    ];

    [Parameter, EditorRequired] public UiSalesInvoiceFormModel Model { get; set; } = new();
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchCustomersAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchEmployeesAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchPrescriptionsAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchCurrenciesAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchProductTypesAsync { get; set; }
    [Parameter] public Func<UiSalesLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchCategoriesAsync { get; set; }
    [Parameter] public Func<UiCheckoutPaymentLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchPaymentCashAccountsAsync { get; set; }
    [Parameter] public Func<UiCheckoutPaymentLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchPaymentBankAccountsAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchSettlementAccountsAsync { get; set; }
    [Parameter] public Func<UiSalesLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchProductsAsync { get; set; }
    [Parameter] public Func<UiSalesLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchWarehousesAsync { get; set; }
    [Parameter] public Func<UiSalesLineModel, string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SearchPrescriptionRevisionsAsync { get; set; }
    [Parameter] public EventCallback<UiSalesSelectionChange> OnSelectionChanged { get; set; }
    [Parameter] public EventCallback<UiSalesLineSelectionChange> OnProductTypeSelected { get; set; }
    [Parameter] public EventCallback<UiSalesLineSelectionChange> OnCategorySelected { get; set; }
    [Parameter] public EventCallback<UiSalesLineSelectionChange> OnProductSelected { get; set; }
    [Parameter] public EventCallback<UiSalesLineSelectionChange> OnWarehouseSelected { get; set; }
    [Parameter] public EventCallback<UiSalesLineModel> OnRequestPriceOverride { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool ShowSettlement => Model.Status == "Confirmed" && Model.PaymentPlan is "FullNow" or "PartialNow";
    private UiLookupItem? CustomerItem => string.IsNullOrWhiteSpace(Model.CustomerId) ? null : new(Model.CustomerId, Model.CustomerDisplay ?? (string.IsNullOrWhiteSpace(Model.CustomerCode) ? "العميل المحدد" : Model.CustomerCode));
    private UiLookupItem? SalesEmployeeItem => string.IsNullOrWhiteSpace(Model.SalesEmployeeId) ? null : new(Model.SalesEmployeeId, Model.SalesEmployeeDisplay ?? "موظف المبيعات المحدد");
    private UiLookupItem? PrescriptionItem => string.IsNullOrWhiteSpace(Model.PrescriptionRevisionId) ? null : new(Model.PrescriptionRevisionId, Model.PrescriptionDisplay ?? (string.IsNullOrWhiteSpace(Model.PrescriptionCode) ? "الوصفة المحددة" : Model.PrescriptionCode));
    private UiLookupItem? CurrencyItem => string.IsNullOrWhiteSpace(Model.CurrencyId) ? null : new(Model.CurrencyId, Model.CurrencyDisplay ?? (string.IsNullOrWhiteSpace(Model.CurrencyCode) ? "العملة المحددة" : Model.CurrencyCode));

    private async Task CustomerChanged(string? v) { Model.CustomerId = v ?? string.Empty; await OnSelectionChanged.InvokeAsync(new("Customer", v)); await OnChanged.InvokeAsync(); }
    private async Task SalesEmployeeChanged(string? v) { Model.SalesEmployeeId = v ?? string.Empty; await OnSelectionChanged.InvokeAsync(new("SalesEmployee", v)); await OnChanged.InvokeAsync(); }
    private async Task PrescriptionChanged(string? v) { Model.PrescriptionRevisionId = v ?? string.Empty; await OnSelectionChanged.InvokeAsync(new("PrescriptionRevision", v)); await OnChanged.InvokeAsync(); }
    private async Task CurrencyChanged(string? v) { Model.CurrencyId = v ?? string.Empty; await OnSelectionChanged.InvokeAsync(new("Currency", v)); await OnChanged.InvokeAsync(); }
    private async Task InvoiceDateChanged(DateOnly? v) { Model.InvoiceDate = v; await OnChanged.InvokeAsync(); }
    private async Task PostingDateChanged(DateOnly? v) { Model.PostingDate = v; await OnChanged.InvokeAsync(); }
    private async Task TaxModeChanged(string? v) { Model.TaxCalculationMode = v ?? "Exclusive"; await OnChanged.InvokeAsync(); }
    private async Task PaymentPlanChanged(string? v)
    {
        Model.PaymentPlan = v ?? "FullNow";
        Model.PaymentTermType = Model.PaymentPlan == "AccountCredit" ? "Credit" : "Immediate";
        if (Model.PaymentPlan == "AccountCredit") Model.PaymentLines.Clear();
        await OnSelectionChanged.InvokeAsync(new("PaymentPlan", Model.PaymentPlan));
        await OnChanged.InvokeAsync();
    }
    private async Task DescriptionChanged(string? v) { Model.Description = v; await OnChanged.InvokeAsync(); }

    // Payment lines are transient posting inputs; changing them must not mark a Confirmed invoice as dirty.
    private Task PaymentLinesChangedAsync() => Task.CompletedTask;
    private Task AddPaymentLineAsync()
    {
        Model.PaymentLines.Add(new UiCheckoutPaymentLineModel
        {
            PaymentMethod = "Cash",
            CurrencyId = Model.CurrencyId,
            CurrencyDisplay = Model.CurrencyDisplay ?? Model.CurrencyCode,
            Amount = Model.PaymentPlan == "FullNow" && Model.PaymentLines.Count == 0 ? Math.Max(0m, Model.OutstandingAmount) : 0m
        });
        return Task.CompletedTask;
    }
    private Task RemovePaymentLineAsync(UiCheckoutPaymentLineModel line)
    {
        Model.PaymentLines.Remove(line);
        return Task.CompletedTask;
    }
}
