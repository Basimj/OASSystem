@using OAS.Contracts.Features.Employees.Adjustments
@using OAS.Contracts.Features.Employees.Leave
@using OAS.Contracts.Features.Employees.Loans
@using OAS.Contracts.Features.Employees.Time
@using OAS.Contracts.Features.Employees.Payroll

<UiContainer CssClass="employee-hr-summary">
    @if (_loading)
    {
        <UiAlert Message="جاري تحميل بيانات الموظف..." />
    }
    else if (Section == "time")
    {
        <UiCard Title="الدوام والورديات" Subtitle="السجل التشغيلي للموظف">
            @if (_assignments.Count == 0) { <UiAlert Message="لا توجد وردية معينة للموظف." /> }
            else
            {
                <UiContainer CssClass="employee-hr-summary__list">
                    @foreach (var x in _assignments)
                    {
                        <UiInline Strong="true">@($"{x.ShiftCode} - {x.ShiftName} | {x.EffectiveFrom:yyyy-MM-dd} → {x.EffectiveTo?.ToString("yyyy-MM-dd") ?? "مفتوح"}")</UiInline>
                    }
                </UiContainer>
            }
        </UiCard>
        <UiCard Title="آخر سجلات الحضور">
            @if (_attendance.Count == 0) { <UiAlert Message="لا توجد سجلات حضور." /> }
            else
            {
                <UiContainer CssClass="employee-hr-summary__list">
                    @foreach (var x in _attendance.Take(12))
                    {
                        <UiInline>@($"{x.AttendanceDate:yyyy-MM-dd} | {x.ShiftName ?? "بدون وردية"} | عمل {x.WorkedMinutes} د | تأخير {x.LateMinutes} د | إضافي {x.OvertimeMinutes} د")</UiInline>
                    }
                </UiContainer>
            }
        </UiCard>
    }
    else if (Section == "leave")
    {
        <UiCard Title="أرصدة الإجازات">
            @if (_balances.Count == 0) { <UiAlert Message="لا توجد أرصدة إجازات." /> }
            else
            {
                <UiContainer CssClass="employee-hr-summary__list">
                    @foreach (var x in _balances)
                    {
                        <UiInline Strong="true">@($"{x.LeaveTypeName}: متاح {x.AvailableDays:0.##} يوم — مستخدم {x.UsedDays:0.##}")</UiInline>
                    }
                </UiContainer>
            }
        </UiCard>
        <UiCard Title="طلبات الإجازة">
            @if (_leaveRequests.Count == 0) { <UiAlert Message="لا توجد طلبات إجازة." /> }
            else
            {
                <UiContainer CssClass="employee-hr-summary__list">
                    @foreach (var x in _leaveRequests.Take(12))
                    {
                        <UiInline>@($"{x.LeaveRequestCode} | {x.LeaveTypeName} | {x.StartDate:yyyy-MM-dd} → {x.EndDate:yyyy-MM-dd} | {StatusName(x.Status)}")</UiInline>
                    }
                </UiContainer>
            }
        </UiCard>
    }
    else if (Section == "loans")
    {
        <UiCard Title="السلف والقروض">
            @if (_loans.Count == 0) { <UiAlert Message="لا توجد سلف للموظف." /> }
            else
            {
                <UiContainer CssClass="employee-hr-summary__list">
                    @foreach (var x in _loans)
                    {
                        <UiInline Strong="true">@($"{x.LoanCode} | الأصل {x.PrincipalAmount:N2} {x.CurrencyCode} | المتبقي {x.OutstandingAmount:N2} | {LoanStatusName(x.Status)}")</UiInline>
                    }
                </UiContainer>
            }
        </UiCard>
    }

    else if (Section == "payroll")
    {
        <UiCard Title="سجل الرواتب" Subtitle="الرواتب التاريخية للموظف">
            @if (_payrollHistory.Count == 0) { <UiAlert Message="لا توجد رواتب محتسبة للموظف." /> }
            else
            {
                <UiContainer CssClass="employee-hr-summary__list">
                    @foreach (var x in _payrollHistory.OrderByDescending(x => x.CoverageTo).Take(24))
                    {
                        <UiInline Strong="true">@($"{x.CoverageFrom:yyyy-MM-dd} → {x.CoverageTo:yyyy-MM-dd} | صافي {x.NetPay:N2} {x.CurrencyCode} | {PayrollStatusName(x.Status)} | {PaymentStatusName(x.PaymentStatus)}")</UiInline>
                    }
                </UiContainer>
            }
        </UiCard>
    }

    else if (Section == "adjustments")
    {
        <UiCard Title="المكافآت والخصومات والتعديلات">
            @if (_adjustments.Count == 0) { <UiAlert Message="لا توجد تعديلات للموظف." /> }
            else
            {
                <UiContainer CssClass="employee-hr-summary__list">
                    @foreach (var x in _adjustments.Take(20))
                    {
                        <UiInline>@($"{x.AdjustmentCode} | {x.ComponentName} | {x.Amount:N2} {x.CurrencyCode} | {StatusName(x.Status)}")</UiInline>
                    }
                </UiContainer>
            }
        </UiCard>
    }
</UiContainer>
