
@page "/employees/new"
@page "/employees/edit/{EmployeeId:guid}"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using OAS.Client.Common.Feedback.Services
@using OAS.Client.Features.Employees.Services
@using OAS.Client.Services.Http
@using OAS.Contracts.Features.Employees
@using OAS.UiLib.Components.Buttons
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Enums
@using OAS.UiLib.Services.Feedback

@attribute [Authorize(Roles = "Administrator")]

@inject IEmployeeClientService EmployeeService
@inject IApiFeedbackService ApiFeedback
@inject IUiSnackbarService Snackbar
@inject NavigationManager Navigation

<PageTitle>
    @(IsEditMode ? "تعديل الموظف" : "إضافة موظف")
</PageTitle>

<UiElement Tag="div" class="employee-editor-page" dir="rtl">

    @if (_isLoading)
    {
        <UiElement Tag="div" class="employee-editor-loading">
            <UiElement Tag="div" class="employee-editor-spinner"></UiElement>
            <UiElement Tag="span">
                @(IsEditMode
                            ? "جاري تحميل بيانات الموظف..."
                            : "جاري توليد كود الموظف...")
        </UiElement>
    </UiElement>
        }
    else
    {
        <EditForm Model="_form" OnSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <UiElement Tag="div" class="employee-editor-shell">

                <!-- HEADER -->
                <UiElement Tag="div" class="employee-editor-header">

                    <UiElement Tag="div" class="employee-editor-heading">

                        <UiElement Tag="button" type="button"
                                class="employee-editor-back"
                                OnClick="BackToEmployees">

                            <UiElement Tag="span" class="employee-editor-back-icon">
                                <UiElement Tag="i" class="fa-solid fa-arrow-right"></UiElement>
                            </UiElement>

                            <UiElement Tag="span">العودة إلى الموظفين</UiElement>

                        </UiElement>

                        <UiElement Tag="div">

                            <UiElement Tag="h1">
                                @(IsEditMode
                                                            ? "تعديل الموظف"
                                                            : "إضافة موظف جديد")
                                                                            </UiElement>

                            <UiElement Tag="p">
                                @(IsEditMode
                                                            ? "تعديل بيانات الموظف وحفظ التغييرات."
                                                            : "أدخل بيانات الموظف الأساسية لإنشاء سجل جديد.")
                        </UiElement>

                        </UiElement>

                    </UiElement>

                    <UiElement Tag="div" class="employee-editor-header-actions">

                        <UiButton Text="إلغاء"
                                  Variant="ButtonVariant.Secondary"
                                  AdditionalCssClass="editor-cancel-button"
                                  Disabled="@_isSaving"
                                  OnClick="CancelClicked">
                        </UiButton>

                    @if (!IsEditMode)
                        {
                            <UiButton Text="حفظ"
                                      Variant="ButtonVariant.Ghost"
                                      AdditionalCssClass="editor-save-button"
                                      Disabled="@_isSaving"
                                      OnClick="SaveOnlyClicked">
                            </UiButton>
                        }

                        <UiButton Text="حفظ وإغلاق"
                                  Variant="ButtonVariant.Primary"
                                  Disabled="@_isSaving"
                                  Loading="@_isSaving"
                                  OnClick="SaveAndCloseClicked">
                        </UiButton>

                    </UiElement>

                </UiElement>

                <!-- TABS -->
                <UiElement Tag="div" class="employee-editor-tabs">

                    <UiElement Tag="button" type="button"
                            class="@GetTabCssClass(TabBasic)"
                            OnClick="() => SetTab(TabBasic)">
                        البيانات الأساسية
                    </UiElement>

                    <UiElement Tag="button" type="button"
                            class="@GetTabCssClass(TabJob)"
                            OnClick="() => SetTab(TabJob)">
                        الوظيفة
                    </UiElement>

                    <UiElement Tag="button" type="button"
                            class="@GetTabCssClass(TabContact)"
                            OnClick="() => SetTab(TabContact)">
                        التواصل
                    </UiElement>

                    <UiElement Tag="button" type="button"
                            class="@GetTabCssClass(TabFiles)"
                            OnClick="() => SetTab(TabFiles)">
                        الملفات
                    </UiElement>

                    <UiElement Tag="button" type="button"
                            class="@GetTabCssClass(TabNotes)"
                            OnClick="() => SetTab(TabNotes)">
                        الملاحظات
                    </UiElement>

                </UiElement>

                <!-- BASIC -->
                @if (IsTab(TabBasic))
                {
                    <UiElement Tag="section" class="employee-editor-card">

                        <UiElement Tag="div" class="employee-editor-card-header">
                            <UiElement Tag="div">
                                <UiElement Tag="h2">البيانات الأساسية</UiElement>
                                <UiElement Tag="p">المعلومات الرئيسية للموظف.</UiElement>
                            </UiElement>
                        </UiElement>

                        <UiElement Tag="div" class="employee-editor-grid">

                            <!-- EMPLOYEE CODE -->
                            <UiElement Tag="div" class="employee-editor-field">

                                <UiInputText Id="employee-code"
                                             Label="كود الموظف"
                                             @bind-Value="_form.EmployeeCode"
                                             Required="true"
                                             MaxLength="32"
                                             ReadOnly="true"
                                             Placeholder="جاري توليد الكود..." />

                                <ValidationMessage For="@(() => _form.EmployeeCode)" />

                            </UiElement>

                            <!-- FIRST NAME -->
                            <UiElement Tag="div" class="employee-editor-field">

                                <UiInputText Id="employee-first-name"
                                             Label="الاسم الأول"
                                             @bind-Value="_form.FirstName"
                                             Required="true"
                                             MaxLength="100"
                                             Placeholder="الاسم الأول" />

                                <ValidationMessage For="@(() => _form.FirstName)" />

                            </UiElement>

                            <!-- LAST NAME -->
                            <UiElement Tag="div" class="employee-editor-field">

                                <UiInputText Id="employee-last-name"
                                             Label="اسم العائلة"
                                             @bind-Value="_form.LastName"
                                             Required="true"
                                             MaxLength="100"
                                             Placeholder="اسم العائلة" />

                                <ValidationMessage For="@(() => _form.LastName)" />

                            </UiElement>

                            <!-- HIRE DATE -->
                            <UiElement Tag="div" class="employee-editor-field">

                                <UiElement Tag="label" class="employee-editor-label"
                                       for="employee-hire-date">
                                    تاريخ التوظيف
                                </UiElement>

                                <UiElement Tag="input" id="employee-hire-date"
                                       type="date"
                                       class="employee-editor-native-input"
                                       value="@_form.HireDateText"
                                       OnChange="OnHireDateChanged" />

                            </UiElement>

                        </UiElement>

                        @if (!IsEditMode)
                        {
                            <UiElement Tag="div" class="employee-editor-status-box">

                                <UiElement Tag="div">
                                    <UiElement Tag="strong">حالة الموظف عند الإنشاء</UiElement>

                                    <UiElement Tag="span">
                                        يمكنك إنشاء الموظف نشطًا أو غير نشط.
                                    </UiElement>
                                </UiElement>

                                <UiCheckbox Label="الموظف نشط"
                                            Value="_form.IsActive"
                                            ValueChanged="SetActive" />

                            </UiElement>
                        }
                        else
                        {
                            <UiElement Tag="div" class="employee-editor-info-box">

                                <UiElement Tag="div">
                                    <UiElement Tag="strong">الحالة الحالية</UiElement>

                                    <UiElement Tag="span">
                                        يمكن تغيير الحالة من صفحة الموظفين.
                                    </UiElement>
                                </UiElement>

                                <UiElement Tag="span" class="@(_form.IsActive
                                                                                    ? "employee-status-active"
                                                                                    : "employee-status-inactive")">

                        @(_form.IsActive ? "نشط" : "غير نشط")

                                </UiElement>

                            </UiElement>
                                }

                    </UiElement>
                }

                <!-- JOB -->
                @if (IsTab(TabJob))
                {
                    <UiElement Tag="section" class="employee-editor-card">

                        <UiElement Tag="div" class="employee-editor-card-header">

                            <UiElement Tag="div">
                                <UiElement Tag="h2">الوظيفة والأدوار التشغيلية</UiElement>
                                <UiElement Tag="p">حدد المسمى الوظيفي والمهام التشغيلية.</UiElement>
                            </UiElement>

                        </UiElement>

                        <UiElement Tag="div" class="employee-editor-grid">

                            <UiElement Tag="div" class="employee-editor-field employee-editor-field-full">

                                <UiInputText Id="employee-job-title"
                                             Label="المسمى الوظيفي"
                                             @bind-Value="_form.JobTitle"
                                             MaxLength="100"
                                             Placeholder="مثال: فني نظارات" />

                                <ValidationMessage For="@(() => _form.JobTitle)" />

                            </UiElement>

                        </UiElement>

                        <UiElement Tag="div" class="employee-editor-capabilities">

                            <UiElement Tag="div" class="employee-editor-capability">

                                <UiCheckbox Label="موظف مبيعات"
                                            Value="_form.IsSalesperson"
                                            ValueChanged="SetSalesperson" />

                                <UiElement Tag="span">
                                    يعمل ضمن فريق المبيعات.
                                </UiElement>

                            </UiElement>

                            <UiElement Tag="div" class="employee-editor-capability">

                                <UiCheckbox Label="فني"
                                            Value="_form.IsTechnician"
                                            ValueChanged="SetTechnician" />

                                <UiElement Tag="span">
                                    يمكنه تنفيذ الأعمال الفنية.
                                </UiElement>

                            </UiElement>

                            <UiElement Tag="div" class="employee-editor-capability">

                                <UiCheckbox Label="مستحق للعمولة"
                                            Value="_form.IsCommissionEligible"
                                            ValueChanged="SetCommissionEligible" />

                                <UiElement Tag="span">
                                    يسمح باحتساب العمولة.
                                </UiElement>

                            </UiElement>

                        </UiElement>

                    </UiElement>
                }

                <!-- CONTACT -->
                @if (IsTab(TabContact))
                {
                    <UiElement Tag="section" class="employee-editor-card">

                        <UiElement Tag="div" class="employee-editor-card-header">

                            <UiElement Tag="div">
                                <UiElement Tag="h2">بيانات التواصل</UiElement>
                                <UiElement Tag="p">بيانات الاتصال المتاحة للموظف.</UiElement>
                            </UiElement>

                        </UiElement>

                        <UiElement Tag="div" class="employee-editor-grid">

                            <UiElement Tag="div" class="employee-editor-field">

                                <UiInputText Id="employee-phone"
                                             Label="رقم الهاتف"
                                             @bind-Value="_form.Phone"
                                             MaxLength="32"
                                             InputMode="tel"
                                             AutoComplete="tel"
                                             Placeholder="مثال: 777123456" />

                                <ValidationMessage For="@(() => _form.Phone)" />

                            </UiElement>

                        </UiElement>

                    </UiElement>
                }

                <!-- FILES -->
                @if (IsTab(TabFiles))
                {
                    <UiElement Tag="section" class="employee-editor-card">

                        <UiElement Tag="div" class="employee-editor-card-header">

                            <UiElement Tag="div">
                                <UiElement Tag="h2">ملفات الموظف</UiElement>
                                <UiElement Tag="p">قسم الملفات جاهز للتطوير لاحقًا.</UiElement>
                            </UiElement>

                        </UiElement>

                        <UiElement Tag="div" class="employee-editor-placeholder">

                            <UiElement Tag="div" class="employee-editor-placeholder-icon">
                                <UiElement Tag="i" class="fa-solid fa-folder-open"></UiElement>
                            </UiElement>

                            <UiElement Tag="strong">لا توجد ملفات حاليًا</UiElement>

                            <UiElement Tag="span">
                                رفع الملفات ليس جزءًا من عقد Employees الحالي.
                            </UiElement>

                        </UiElement>

                    </UiElement>
                }

                <!-- NOTES -->
                @if (IsTab(TabNotes))
                {
                    <UiElement Tag="section" class="employee-editor-card">

                        <UiElement Tag="div" class="employee-editor-card-header">

                            <UiElement Tag="div">
                                <UiElement Tag="h2">الملاحظات</UiElement>
                                <UiElement Tag="p">أضف أي معلومات أو ملاحظات إضافية.</UiElement>
                            </UiElement>

                        </UiElement>

                        <UiElement Tag="div" class="employee-editor-field employee-editor-field-full">

                            <UiElement Tag="label" class="employee-editor-label"
                                   for="employee-notes">
                                الملاحظات
                            </UiElement>

                            <UiElement Tag="textarea" id="employee-notes"
                                      class="employee-editor-textarea"
                                      maxlength="1000"
                                      @bind-Value="_form.Notes"
                                      placeholder="أدخل الملاحظات هنا...">
                                    </UiElement>

                            <ValidationMessage For="@(() => _form.Notes)" />

                        </UiElement>

                    </UiElement>
                }

                <ValidationSummary class="employee-editor-validation-summary" />

                <!-- FOOTER -->
                <UiElement Tag="div" class="employee-editor-footer">

                    <UiElement Tag="div" class="employee-editor-footer-info">
                        <UiElement Tag="span">
                            الحقول الأساسية مطلوبة.
                        </UiElement>
                    </UiElement>

                    <UiElement Tag="div" class="employee-editor-footer-actions">

                        <UiButton Text="إلغاء"
                                  Variant="ButtonVariant.Secondary"
                                  AdditionalCssClass="editor-cancel-button"
                                  Disabled="@_isSaving"
                                  OnClick="CancelClicked">
                        </UiButton>

                        <UiButton Text="حفظ وإغلاق"
                                  Variant="ButtonVariant.Primary"
                                  AdditionalCssClass="editor-save-close-button"
                                  Disabled="@_isSaving"
                                  Loading="@_isSaving"
                                  OnClick="SaveAndCloseClicked">
                        </UiButton>

                    </UiElement>

                </UiElement>

            </UiElement>

        </EditForm>
    }

</UiElement>

@code {

    [Parameter]
    public Guid? EmployeeId { get; set; }

    private EmployeeFormModel _form = new();

    private string? _rowVersion;

    private bool _isLoading;
    private bool _isSaving;

    private bool _parametersInitialized;
    private Guid? _loadedEmployeeId;

    private const string TabBasic = "basic";
    private const string TabJob = "job";
    private const string TabContact = "contact";
    private const string TabFiles = "files";
    private const string TabNotes = "notes";

    private string _activeTab = TabBasic;

    private bool IsEditMode =>
        EmployeeId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        if (_parametersInitialized &&
            EmployeeId == _loadedEmployeeId)
        {
            return;
        }

        _parametersInitialized = true;
        _loadedEmployeeId = EmployeeId;

        if (EmployeeId is null)
        {
            await InitializeNewAsync();
            return;
        }

        await LoadEmployeeAsync(EmployeeId.Value);
    }

    private async Task InitializeNewAsync()
    {
        _form = new EmployeeFormModel
        {
            EmployeeCode = string.Empty,
            FirstName = string.Empty,
            LastName = string.Empty,
            Phone = string.Empty,
            JobTitle = string.Empty,
            HireDateText = string.Empty,
            Notes = string.Empty,
            IsSalesperson = false,
            IsTechnician = false,
            IsCommissionEligible = false,
            IsActive = true
        };

        _rowVersion = null;
        _activeTab = TabBasic;
        _isLoading = true;

        try
        {
            var employeeCode =
                await EmployeeService.GetNextEmployeeCodeAsync();

            if (string.IsNullOrWhiteSpace(employeeCode))
            {
                Snackbar.Error(
                    "تعذر الحصول على كود الموظف الجديد.");

                return;
            }

            _form.EmployeeCode =
                employeeCode.Trim();

            /*
             * إجبار Blazor على إعادة رسم المكون
             * بعد استلام الكود من API.
             */
            await InvokeAsync(
                StateHasChanged);
        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(ex.Error);
        }
        catch
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _isLoading = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }

    private async Task LoadEmployeeAsync(
        Guid employeeId)
    {
        _isLoading = true;

        try
        {
            var employee =
                await EmployeeService.GetByIdAsync(
                    employeeId);

            if (employee is null)
            {
                Snackbar.Error(
                    "لم يتم العثور على الموظف.");

                Navigation.NavigateTo(
                    "/employees");

                return;
            }

            _form = new EmployeeFormModel
            {
                EmployeeCode =
                    employee.EmployeeCode,

                FirstName =
                    employee.FirstName,

                LastName =
                    employee.LastName,

                Phone =
                    employee.Phone ??
                    string.Empty,

                JobTitle =
                    employee.JobTitle ??
                    string.Empty,

                HireDateText =
                    employee.HireDate?
                        .ToString("yyyy-MM-dd")
                    ?? string.Empty,

                Notes =
                    employee.Notes ??
                    string.Empty,

                IsSalesperson =
                    employee.IsSalesperson,

                IsTechnician =
                    employee.IsTechnician,

                IsCommissionEligible =
                    employee.IsCommissionEligible,

                IsActive =
                    employee.IsActive
            };

            _rowVersion =
                employee.RowVersion;

            _activeTab = TabBasic;
        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(ex.Error);

            Navigation.NavigateTo(
                "/employees");
        }
        catch
        {
            ApiFeedback.ShowUnexpected();

            Navigation.NavigateTo(
                "/employees");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync(
        EditContext _)
    {
        await SaveCoreAsync(true);
    }

    private async Task SaveOnlyClicked(
        MouseEventArgs _)
    {
        await SaveCoreAsync(false);
    }

    private async Task SaveAndCloseClicked(
        MouseEventArgs _)
    {
        await SaveCoreAsync(true);
    }

    private async Task SaveCoreAsync(
        bool closeAfterSave)
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;

        try
        {
            if (!ValidateForm())
            {
                return;
            }

            var hireDate =
                ParseHireDate();

            // ==================================================
            // CREATE
            // ==================================================
            if (EmployeeId is null)
            {
                var employeeCode =
                    _form.EmployeeCode.Trim();

                if (string.IsNullOrWhiteSpace(
                        employeeCode))
                {
                    Snackbar.Error(
                        "كود الموظف غير متوفر.");

                    SetTab(TabBasic);

                    return;
                }

                var request =
                    new CreateEmployeeRequest(
                        EmployeeCode:
                            employeeCode,

                        FirstName:
                            _form.FirstName.Trim(),

                        LastName:
                            _form.LastName.Trim(),

                        Phone:
                            NullIfEmpty(
                                _form.Phone),

                        JobTitle:
                            NullIfEmpty(
                                _form.JobTitle),

                        HireDate:
                            hireDate,

                        Notes:
                            NullIfEmpty(
                                _form.Notes),

                        IsSalesperson:
                            _form.IsSalesperson,

                        IsTechnician:
                            _form.IsTechnician,

                        IsCommissionEligible:
                            _form.IsCommissionEligible,

                        IsActive:
                            _form.IsActive,

                        UserAccountId:
                            null);

                var result =
                    await EmployeeService.CreateAsync(
                        request);

                if (!result.Succeeded)
                {
                    if (result.Error is not null)
                    {
                        ApiFeedback.Show(
                            result.Error);
                    }
                    else
                    {
                        ApiFeedback.ShowUnexpected();
                    }

                    return;
                }

                if (result.Value is null)
                {
                    Snackbar.Error(
                        "تم الإنشاء ولكن لم تتم إعادة بيانات الموظف.");

                    if (closeAfterSave)
                    {
                        Navigation.NavigateTo(
                            "/employees");
                    }

                    return;
                }

                Snackbar.Success(
                    "تم إنشاء الموظف بنجاح.");

                // ==================================================
                // حفظ وإغلاق
                // ==================================================
                if (closeAfterSave)
                {
                    Navigation.NavigateTo(
                        "/employees");

                    return;
                }

                // ==================================================
                // حفظ فقط
                // ==================================================
                // نبقى في صفحة الإضافة.
                // يتم تنظيف النموذج.
                // ثم يتم طلب رقم جديد من SQL SEQUENCE.
                await InitializeNewAsync();

                return;
            }

            // ==================================================
            // UPDATE
            // ==================================================
            if (string.IsNullOrWhiteSpace(
                    _rowVersion))
            {
                Snackbar.Error(
                    "تعذر الحصول على RowVersion الحالي للموظف.");

                return;
            }

            var updateRequest =
                new UpdateEmployeeRequest(
                    EmployeeCode:
                        _form.EmployeeCode.Trim(),

                    FirstName:
                        _form.FirstName.Trim(),

                    LastName:
                        _form.LastName.Trim(),

                    Phone:
                        NullIfEmpty(
                            _form.Phone),

                    JobTitle:
                        NullIfEmpty(
                            _form.JobTitle),

                    HireDate:
                        hireDate,

                    Notes:
                        NullIfEmpty(
                            _form.Notes),

                    IsSalesperson:
                        _form.IsSalesperson,

                    IsTechnician:
                        _form.IsTechnician,

                    IsCommissionEligible:
                        _form.IsCommissionEligible,

                    UserAccountId:
                        null,

                    RowVersion:
                        _rowVersion);

            EmployeeDto updatedEmployee;

            try
            {
                updatedEmployee =
                    await EmployeeService.UpdateAsync(
                        EmployeeId.Value,
                        updateRequest);
            }
            catch (ApiClientException ex)
                when (ex.StatusCode == 409)
            {
                ApiFeedback.Show(
                    ex.Error);

                await LoadEmployeeAsync(
                    EmployeeId.Value);

                return;
            }

            if (updatedEmployee is null)
            {
                Snackbar.Error(
                    "تعذر تحديث الموظف.");

                return;
            }

            _rowVersion =
                updatedEmployee.RowVersion;

            Snackbar.Success(
                "تم تحديث بيانات الموظف بنجاح.");

            if (closeAfterSave)
            {
                Navigation.NavigateTo(
                    "/employees");
            }
        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(
                ex.Error);
        }
        catch
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(
                _form.EmployeeCode))
        {
            Snackbar.Error(
                "كود الموظف غير متوفر.");

            SetTab(TabBasic);

            return false;
        }

        if (string.IsNullOrWhiteSpace(
                _form.FirstName))
        {
            Snackbar.Error(
                "الاسم الأول مطلوب.");

            SetTab(TabBasic);

            return false;
        }

        if (string.IsNullOrWhiteSpace(
                _form.LastName))
        {
            Snackbar.Error(
                "اسم العائلة مطلوب.");

            SetTab(TabBasic);

            return false;
        }

        if (_form.EmployeeCode.Trim().Length > 32)
        {
            Snackbar.Error(
                "كود الموظف يجب ألا يتجاوز 32 حرفًا.");

            SetTab(TabBasic);

            return false;
        }

        if (_form.FirstName.Trim().Length > 100)
        {
            Snackbar.Error(
                "الاسم الأول يجب ألا يتجاوز 100 حرف.");

            SetTab(TabBasic);

            return false;
        }

        if (_form.LastName.Trim().Length > 100)
        {
            Snackbar.Error(
                "اسم العائلة يجب ألا يتجاوز 100 حرف.");

            SetTab(TabBasic);

            return false;
        }

        if (!string.IsNullOrWhiteSpace(
                _form.Phone) &&
            _form.Phone.Trim().Length > 32)
        {
            Snackbar.Error(
                "رقم الهاتف يجب ألا يتجاوز 32 حرفًا.");

            SetTab(TabContact);

            return false;
        }

        if (!string.IsNullOrWhiteSpace(
                _form.JobTitle) &&
            _form.JobTitle.Trim().Length > 100)
        {
            Snackbar.Error(
                "المسمى الوظيفي يجب ألا يتجاوز 100 حرف.");

            SetTab(TabJob);

            return false;
        }

        if (!string.IsNullOrEmpty(
                _form.Notes) &&
            _form.Notes.Length > 1000)
        {
            Snackbar.Error(
                "الملاحظات يجب ألا تتجاوز 1000 حرف.");

            SetTab(TabNotes);

            return false;
        }

        return true;
    }

    private DateOnly? ParseHireDate()
    {
        if (string.IsNullOrWhiteSpace(
                _form.HireDateText))
        {
            return null;
        }

        return DateOnly.TryParseExact(
            _form.HireDateText,
            "yyyy-MM-dd",
            out var value)
            ? value
            : null;
    }

    private void OnHireDateChanged(
        ChangeEventArgs args)
    {
        _form.HireDateText =
            args.Value?.ToString()
            ?? string.Empty;
    }

    private void SetActive(
        bool value)
    {
        _form.IsActive = value;
    }

    private void SetSalesperson(
        bool value)
    {
        _form.IsSalesperson = value;
    }

    private void SetTechnician(
        bool value)
    {
        _form.IsTechnician = value;
    }

    private void SetCommissionEligible(
        bool value)
    {
        _form.IsCommissionEligible = value;
    }

    private void SetTab(
        string tab)
    {
        _activeTab = tab;
    }

    private bool IsTab(
        string tab)
    {
        return string.Equals(
            _activeTab,
            tab,
            StringComparison.OrdinalIgnoreCase);
    }

    private string GetTabCssClass(
        string tab)
    {
        return IsTab(tab)
            ? "employee-editor-tab active"
            : "employee-editor-tab";
    }

    private void CancelClicked(
        MouseEventArgs _)
    {
        BackToEmployees();
    }

    private void BackToEmployees()
    {
        Navigation.NavigateTo(
            "/employees");
    }

    private static string? NullIfEmpty(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

