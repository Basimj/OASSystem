@using OAS.Client.Features.Employees.Services
@using OAS.Client.Services.Http
@using OAS.Contracts.Features.Employees
@using OAS.Contracts.Features.Employees.Import
@using OAS.Contracts.Features.Employees.JobTitles
@using OAS.UiLib.Core.Models

@inject IEmployeeClientService EmployeeService
@inject IUiSnackbarService Snackbar

<UiElement Tag="div" class="employee-bulk-entry">
    <UiElement Tag="div" class="employee-bulk-entry-header">
        <UiElement Tag="div" class="employee-bulk-entry-title-area">
            <UiElement Tag="div" class="employee-bulk-entry-icon"><UiElement Tag="span">▦</UiElement></UiElement>
            <UiElement Tag="div">
                <UiElement Tag="h2">إدخال الموظفين</UiElement>
                <UiElement Tag="p">أدخل بيانات عدة موظفين؛ كود الموظف يُولد تلقائيًا من قاعدة البيانات.</UiElement>
            </UiElement>
        </UiElement>
        <UiElement Tag="button" type="button" class="employee-bulk-close-button" OnClick="CloseClicked" disabled="@IsBusy">×</UiElement>
    </UiElement>

    <UiElement Tag="div" class="employee-bulk-entry-toolbar">
        <UiElement Tag="div" class="employee-bulk-toolbar-left">
            <UiElement Tag="button" type="button" class="employee-bulk-toolbar-button" OnClick="AddRowClicked" disabled="@IsBusy">＋ إضافة صف</UiElement>
            <UiElement Tag="button" type="button" class="employee-bulk-toolbar-button" OnClick="ClearClicked" disabled="@IsBusy">مسح الكل</UiElement>
        </UiElement>
        <UiElement Tag="div" class="employee-bulk-toolbar-right">
            <UiElement Tag="div" class="employee-bulk-stat"><UiElement Tag="span" class="employee-bulk-stat-label">الصفوف</UiElement><UiElement Tag="strong">@DataRows.Count</UiElement></UiElement>
            <UiElement Tag="div" class="employee-bulk-stat"><UiElement Tag="span" class="employee-bulk-stat-label">الأخطاء</UiElement><UiElement Tag="strong">@_rows.Count(x => x.Errors.Count > 0)</UiElement></UiElement>
        </UiElement>
    </UiElement>

    @if (_isValidating)
    {
        <UiElement Tag="div" class="employee-bulk-entry-status employee-bulk-entry-status-loading">جاري التحقق من البيانات...</UiElement>
    }
    else if (_isSaving)
    {
        <UiElement Tag="div" class="employee-bulk-entry-status employee-bulk-entry-status-saving">جاري حفظ الموظفين... (@_savedCount من @_saveTotal)</UiElement>
    }

    <UiElement Tag="div" class="employee-bulk-entry-table-wrapper">
        <UiElement Tag="table" class="employee-bulk-entry-table">
            <UiElement Tag="thead">
                <UiElement Tag="tr">
                    <UiElement Tag="th" class="employee-bulk-col-number">#</UiElement>
                    <UiElement Tag="th">الاسم الأول *</UiElement>
                    <UiElement Tag="th">اسم العائلة *</UiElement>
                    <UiElement Tag="th">رقم الهاتف</UiElement>
                    <UiElement Tag="th">المسمى الوظيفي *</UiElement>
                    <UiElement Tag="th">تاريخ التوظيف</UiElement>
                    <UiElement Tag="th">عمولة</UiElement>
                    <UiElement Tag="th">نشط</UiElement>
                    <UiElement Tag="th" class="employee-bulk-col-delete"></UiElement>
                </UiElement>
            </UiElement>
            <UiElement Tag="tbody">
                @for (var index = 0; index < _rows.Count; index++)
                {
                    var row = _rows[index];
                    var rowIndex = index + 1;
                    <UiElement Tag="tr" class="@(row.Errors.Count > 0 ? "employee-bulk-row-invalid" : "")">
                        <UiElement Tag="td" class="employee-bulk-row-number">@rowIndex</UiElement>
                        <UiElement Tag="td">
                            <UiInputText Value="@row.FirstName" ValueChanged="v => SetFirstName(row, v)" ValueExpression="@(() => row.FirstName)" Disabled="@IsBusy" Size="ControlSize.Small" />
                        </UiElement>
                        <UiElement Tag="td">
                            <UiInputText Value="@row.LastName" ValueChanged="v => SetLastName(row, v)" ValueExpression="@(() => row.LastName)" Disabled="@IsBusy" Size="ControlSize.Small" />
                        </UiElement>
                        <UiElement Tag="td">
                            <UiInputText Value="@row.Phone" ValueChanged="v => SetPhone(row, v)" ValueExpression="@(() => row.Phone)" Disabled="@IsBusy" Size="ControlSize.Small" InputMode="tel" />
                        </UiElement>
                        <UiElement Tag="td">
                            <UiSelect Value="@row.JobTitleId" ValueChanged="v => SetJobTitle(row, v)" ValueExpression="@(() => row.JobTitleId)"
                                      Options="@JobTitleOptions" Placeholder="اختر المسمى" Disabled="@IsBusy" Size="ControlSize.Small" />
                        </UiElement>
                        <UiElement Tag="td">
                            <UiInputDate Value="@row.HireDate" ValueChanged="v => SetHireDate(row, v)" ValueExpression="@(() => row.HireDate)" Disabled="@IsBusy" Size="ControlSize.Small" />
                        </UiElement>
                        <UiElement Tag="td" class="employee-bulk-checkbox-cell">
                            <UiCheckbox Value="@row.IsCommissionEligible" ValueChanged="v => SetCommission(row, v)" Disabled="@IsBusy" />
                        </UiElement>
                        <UiElement Tag="td" class="employee-bulk-checkbox-cell">
                            <UiCheckbox Value="@row.IsActive" ValueChanged="v => SetActive(row, v)" Disabled="@IsBusy" />
                        </UiElement>
                        <UiElement Tag="td" class="employee-bulk-delete-cell">
                            <UiElement Tag="button" type="button" class="employee-bulk-delete-button" OnClick="() => RemoveRow(row)" disabled="@IsBusy">×</UiElement>
                        </UiElement>
                    </UiElement>

                    @if (row.Errors.Count > 0)
                    {
                        <UiElement Tag="tr" class="employee-bulk-error-row">
                            <UiElement Tag="td" colspan="9">
                                <UiElement Tag="div" class="employee-bulk-errors">
                                    @foreach (var error in row.Errors.Distinct())
                                    {
                                        <UiElement Tag="div" class="employee-bulk-error-item"><UiElement Tag="span">●</UiElement><UiElement Tag="span">@error</UiElement></UiElement>
                                    }
                                </UiElement>
                            </UiElement>
                        </UiElement>
                    }
                }
            </UiElement>
        </UiElement>
    </UiElement>

    <UiElement Tag="div" class="employee-bulk-entry-footer">
        <UiElement Tag="div" class="employee-bulk-footer-info">أدخل البيانات ثم تحقق منها قبل الحفظ.</UiElement>
        <UiElement Tag="div" class="employee-bulk-footer-actions">
            <UiButton Text="إلغاء" Variant="ButtonVariant.Secondary" Disabled="@IsBusy" OnClick="CloseClicked" />
            @if (_validated && DataRows.Count > 0 && _rows.All(x => x.Errors.Count == 0))
            {
                <UiButton Text="إضافة الموظفين" Loading="@_isSaving" Disabled="@IsBusy" OnClick="SaveClicked" />
            }
            else
            {
                <UiButton Text="التحقق من البيانات" Loading="@_isValidating" Disabled="@IsBusy" OnClick="ValidateClicked" />
            }
        </UiElement>
    </UiElement>
</UiElement>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly List<RowModel> _rows = [];
    private IReadOnlyList<JobTitleDto> _jobTitles = [];
    private bool _isValidating;
    private bool _isSaving;
    private bool _validated;
    private int _savedCount;
    private int _saveTotal;

    private bool IsBusy => _isValidating || _isSaving;
    private IReadOnlyList<RowModel> DataRows => _rows.Where(IsNotEmpty).ToArray();
    private IReadOnlyList<UiSelectOption> JobTitleOptions =>
        _jobTitles.Where(x => x.IsActive).OrderBy(x => x.Name)
            .Select(x => new UiSelectOption(x.Id.ToString("D"), x.Name)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        _jobTitles = await EmployeeService.GetJobTitlesAsync(activeOnly: true);
        AddRow();
    }

    private void AddRow() => _rows.Add(new RowModel());
    private void AddRowClicked() { if (!IsBusy) { AddRow(); ResetValidation(); } }
    private void RemoveRow(RowModel row) { if (!IsBusy) { _rows.Remove(row); if (_rows.Count == 0) AddRow(); ResetValidation(); } }
    private void ClearClicked() { if (!IsBusy) { _rows.Clear(); AddRow(); ResetValidation(); } }
    private Task CloseClicked() => IsBusy ? Task.CompletedTask : OnClose.InvokeAsync();

    private void SetFirstName(RowModel row, string? value) { row.FirstName = value ?? ""; ResetRow(row); }
    private void SetLastName(RowModel row, string? value) { row.LastName = value ?? ""; ResetRow(row); }
    private void SetPhone(RowModel row, string? value) { row.Phone = value ?? ""; ResetRow(row); }
    private void SetJobTitle(RowModel row, string? value) { row.JobTitleId = value; ResetRow(row); }
    private void SetHireDate(RowModel row, DateOnly? value) { row.HireDate = value; ResetRow(row); }
    private void SetCommission(RowModel row, bool value) { row.IsCommissionEligible = value; ResetRow(row); }
    private void SetActive(RowModel row, bool value) { row.IsActive = value; ResetRow(row); }

    private async Task ValidateClicked()
    {
        if (IsBusy) return;
        _isValidating = true;
        foreach (var row in _rows) row.Errors.Clear();
        try
        {
            var dataRows = DataRows;
            if (dataRows.Count == 0) { Snackbar.Error("لا توجد بيانات للتحقق."); return; }

            var requestRows = dataRows.Select(row => new EmployeeBulkValidationRowDto(
                _rows.IndexOf(row) + 1,
                row.FirstName.Trim(),
                row.LastName.Trim(),
                NullIfEmpty(row.Phone),
                null,
                null,
                null,
                null,
                null,
                null,
                ResolveJobTitleName(row.JobTitleId),
                row.HireDate,
                row.IsCommissionEligible,
                row.IsActive)).ToArray();

            var result = await EmployeeService.ValidateBulkAsync(new EmployeeBulkValidationRequest(requestRows));
            if (!result.Succeeded || result.Value is null)
            {
                Snackbar.Error(result.Error?.Message ?? "تعذر التحقق من البيانات.");
                return;
            }

            foreach (var error in result.Value.Errors)
            {
                var index = error.RowNumber - 1;
                if (index >= 0 && index < _rows.Count)
                    _rows[index].Errors.Add($"{error.Field}: {error.Message}");
            }

            _validated = true;
            if (_rows.All(x => x.Errors.Count == 0)) Snackbar.Success("جميع البيانات صحيحة.");
            else Snackbar.Error($"يوجد {_rows.Count(x => x.Errors.Count > 0)} صف به أخطاء.");
        }
        catch (ApiClientException ex) { Snackbar.Error(ex.Message); }
        finally { _isValidating = false; }
    }

    private async Task SaveClicked()
    {
        if (IsBusy || !_validated) return;
        var rows = DataRows;
        if (rows.Any(x => x.Errors.Count > 0)) return;

        _isSaving = true;
        _savedCount = 0;
        _saveTotal = rows.Count;
        try
        {
            foreach (var row in rows)
            {
                if (!Guid.TryParse(row.JobTitleId, out var jobTitleId))
                {
                    row.Errors.Add("المسمى الوظيفي مطلوب.");
                    continue;
                }

                var result = await EmployeeService.CreateAsync(new CreateEmployeeRequest(
                    row.FirstName.Trim(),
                    row.LastName.Trim(),
                    NullIfEmpty(row.Phone),
                    null,
                    null,
                    null,
                    null,
                    null,
                    null,
                    jobTitleId,
                    row.HireDate,
                    row.IsCommissionEligible,
                    row.IsActive,
                    null,
                    null));

                if (result.Succeeded) _savedCount++;
                else row.Errors.Add(result.Error?.Message ?? "تعذر إنشاء الموظف.");
            }

            if (_savedCount == _saveTotal)
            {
                Snackbar.Success($"تمت إضافة {_savedCount} موظف بنجاح.");
                await OnClose.InvokeAsync();
            }
            else
            {
                Snackbar.Error($"تمت إضافة {_savedCount} من {_saveTotal} موظف.");
                _validated = true;
            }
        }
        finally { _isSaving = false; }
    }

    private string? ResolveJobTitleName(string? id) =>
        Guid.TryParse(id, out var guid) ? _jobTitles.FirstOrDefault(x => x.Id == guid)?.Name : null;

    private static bool IsNotEmpty(RowModel row) =>
        !string.IsNullOrWhiteSpace(row.FirstName) ||
        !string.IsNullOrWhiteSpace(row.LastName) ||
        !string.IsNullOrWhiteSpace(row.Phone) ||
        !string.IsNullOrWhiteSpace(row.JobTitleId) ||
        row.HireDate.HasValue ||
        row.IsCommissionEligible ||
        !row.IsActive;

    private void ResetRow(RowModel row) { row.Errors.Clear(); _validated = false; }
    private void ResetValidation() { foreach (var row in _rows) row.Errors.Clear(); _validated = false; }
    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class RowModel
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string? Phone { get; set; }
        public string? JobTitleId { get; set; }
        public DateOnly? HireDate { get; set; }
        public bool IsCommissionEligible { get; set; }
        public bool IsActive { get; set; } = true;
        public List<string> Errors { get; } = [];
    }
}
