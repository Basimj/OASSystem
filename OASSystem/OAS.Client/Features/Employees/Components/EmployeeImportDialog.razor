@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using OAS.Client.Features.Employees.Services
@using OAS.Contracts.Features.Employees.Import
@using OAS.UiLib.Components.Buttons
@using OAS.UiLib.Core.Enums

@inject IEmployeeClientService EmployeeService
@inject IUiSnackbarService Snackbar

<UiElement Tag="div" class="employee-import-dialog">

    <UiElement Tag="div" class="employee-import-header">

        <UiElement Tag="div" class="employee-import-title">

            <UiElement Tag="div" class="employee-import-icon">
                <UiElement Tag="i" class="fa-solid fa-file-import"></UiElement>
            </UiElement>

            <UiElement Tag="div">
                <UiElement Tag="h2">استيراد الموظفين من Excel</UiElement>

                <UiElement Tag="p">
                    اختر ملف Excel ثم قم بفحص البيانات قبل إدخالها.
                </UiElement>
            </UiElement>

        </UiElement>

        <UiElement Tag="button" type="button"
                class="employee-import-close"
                OnClick="Close"
                disabled="@_isBusy">
            <UiElement Tag="i" class="fa-solid fa-xmark"></UiElement>
        </UiElement>

    </UiElement>

    <UiElement Tag="div" class="employee-import-content">

        <UiElement Tag="div" class="employee-import-picker"
             style="@(_selectedFile is null ? null : "display:none;")">

            <UiElement Tag="label" class="employee-import-dropzone">

                <InputFile class="employee-import-input"
                           OnChange="OnFileSelected"
                           accept=".xlsx" />

                <UiElement Tag="span" class="employee-import-dropzone-icon">
                    <UiElement Tag="i" class="fa-solid fa-cloud-arrow-up"></UiElement>
                </UiElement>

                <UiElement Tag="strong">
                    اختر ملف Excel
                </UiElement>

                <UiElement Tag="span">
                    الصيغة المدعومة: .xlsx
                </UiElement>

            </UiElement>

        </UiElement>

        @if (_selectedFile is not null)
        {
            <UiElement Tag="div" class="employee-import-file">

                <UiElement Tag="div" class="employee-import-file-icon">
                    <UiElement Tag="i" class="fa-solid fa-file-excel"></UiElement>
                </UiElement>

                <UiElement Tag="div" class="employee-import-file-info">

                    <UiElement Tag="strong" title="@_selectedFile.Name">
                        @_selectedFile.Name
                    </UiElement>

                    <UiElement Tag="span">
                        @FormatFileSize(_selectedFile.Size)
                    </UiElement>

                </UiElement>

                <UiElement Tag="button" type="button"
                        class="employee-import-remove"
                        OnClick="ClearFile"
                        disabled="@_isBusy">

                    <UiElement Tag="i" class="fa-solid fa-xmark"></UiElement>

                </UiElement>

            </UiElement>
        }

        @if (_preview is not null)
        {
            <UiElement Tag="div" class="employee-import-summary">

                <UiElement Tag="div" class="employee-import-stat">
                    <UiElement Tag="strong">@_preview.TotalRows</UiElement>
                    <UiElement Tag="span">إجمالي الصفوف</UiElement>
                </UiElement>

                <UiElement Tag="div" class="employee-import-stat success">
                    <UiElement Tag="strong">@_preview.ValidRows</UiElement>
                    <UiElement Tag="span">صفوف صحيحة</UiElement>
                </UiElement>

                <UiElement Tag="div" class="employee-import-stat danger">
                    <UiElement Tag="strong">@_preview.InvalidRows</UiElement>
                    <UiElement Tag="span">صفوف بها أخطاء</UiElement>
                </UiElement>

            </UiElement>

            @if (_preview.Errors.Count > 0)
            {
                <UiElement Tag="div" class="employee-import-errors">

                    <UiElement Tag="div" class="employee-import-errors-header">
                        <UiElement Tag="strong">أخطاء الملف</UiElement>

                        <UiElement Tag="span">
                            @_preview.Errors.Count خطأ
                        </UiElement>
                    </UiElement>

                    <UiElement Tag="div" class="employee-import-errors-table">

                        <UiElement Tag="table">
                            <UiElement Tag="thead">
                                <UiElement Tag="tr">
                                    <UiElement Tag="th">الصف</UiElement>
                                    <UiElement Tag="th">العمود</UiElement>
                                    <UiElement Tag="th">الخطأ</UiElement>
                                </UiElement>
                            </UiElement>

                            <UiElement Tag="tbody">
                                @foreach (var error in _preview.Errors)
                                {
                                    <UiElement Tag="tr">
                                        <UiElement Tag="td">@error.RowNumber</UiElement>
                                        <UiElement Tag="td">@error.Column</UiElement>
                                        <UiElement Tag="td">@error.Message</UiElement>
                                    </UiElement>
                                }
                            </UiElement>
                        </UiElement>

                    </UiElement>

                </UiElement>
            }
            else if (_preview.IsValid)
            {
                <UiElement Tag="div" class="employee-import-success">

                    <UiElement Tag="i" class="fa-solid fa-circle-check"></UiElement>

                    <UiElement Tag="div">
                        <UiElement Tag="strong">
                            الملف جاهز للاستيراد
                        </UiElement>

                        <UiElement Tag="span">
                            جميع الصفوف اجتازت التحقق.
                        </UiElement>
                    </UiElement>

                </UiElement>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <UiElement Tag="div" class="employee-import-error-message">

                <UiElement Tag="i" class="fa-solid fa-triangle-exclamation"></UiElement>

                <UiElement Tag="div">
                    <UiElement Tag="strong">حدث خطأ</UiElement>

                    <UiElement Tag="span">
                        @_errorMessage
                    </UiElement>
                </UiElement>

            </UiElement>
        }

    </UiElement>

    <UiElement Tag="div" class="employee-import-footer">

        <UiButton Text="إلغاء"
                  Variant="ButtonVariant.Secondary"
                  Disabled="@_isBusy"
                  OnClick="CancelClicked">
        </UiButton>

        @if (_preview is null)
        {
            <UiButton Text="فحص الملف"
                      Variant="ButtonVariant.Primary"
                      Disabled="@(_selectedFile is null || _isBusy)"
                      Loading="@_isBusy"
                      OnClick="ValidateFileAsync">
            </UiButton>
        }
        else
        {
            <UiButton Text="اعتماد الاستيراد"
                      Variant="ButtonVariant.Primary"
                      Disabled="@(!_preview.IsValid || _isBusy)"
                      Loading="@_isBusy"
                      OnClick="ImportFileAsync">
            </UiButton>
        }

    </UiElement>

</UiElement>

@code {

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IBrowserFile? _selectedFile;
    private EmployeeImportPreviewDto? _preview;
    private bool _isBusy;
    private string? _errorMessage;

    private async Task OnFileSelected(
        InputFileChangeEventArgs args)
    {
        _errorMessage = null;
        _preview = null;
        _selectedFile = args.File;

        await InvokeAsync(StateHasChanged);
    }

    private void ClearFile()
    {
        if (_isBusy)
            return;

        _selectedFile = null;
        _preview = null;
        _errorMessage = null;
    }

    private async Task ValidateFileAsync()
    {
        if (_selectedFile is null)
            return;

        _isBusy = true;
        _errorMessage = null;
        _preview = null;

        try
        {
            var file = _selectedFile;

            _preview =
                await EmployeeService.ValidateImportAsync(file);

            if (_preview.IsValid)
            {
                Snackbar.Success("تم فحص الملف بنجاح.");
            }
            else
            {
                Snackbar.Error(
                    $"يوجد {_preview.InvalidRows} صف يحتوي على أخطاء.");
            }
        }
        catch (ApiClientException ex)
        {
            _errorMessage =
                $"تعذر فحص الملف: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        catch (HttpRequestException ex)
        {
            _errorMessage =
                $"تعذر الاتصال بالخادم: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"{ex.GetType().Name}: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ImportFileAsync()
    {
        if (_selectedFile is null ||
            _preview is null ||
            !_preview.IsValid)
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;

        try
        {
            var file = _selectedFile;

            var result =
                await EmployeeService.ImportAsync(file);

            Snackbar.Success(
                $"تم استيراد {result.ImportedRows} موظف بنجاح.");

            await OnClose.InvokeAsync();
        }
        catch (ApiClientException ex)
        {
            _errorMessage =
                $"تعذر استيراد الموظفين: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        catch (HttpRequestException ex)
        {
            _errorMessage =
                $"تعذر الاتصال بالخادم: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"{ex.GetType().Name}: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CancelClicked(MouseEventArgs _)
    {
        await Close();
    }

    private async Task Close()
    {
        if (_isBusy)
            return;

        await OnClose.InvokeAsync();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:0.##} KB";

        return $"{bytes / 1024d / 1024d:0.##} MB";
    }
}