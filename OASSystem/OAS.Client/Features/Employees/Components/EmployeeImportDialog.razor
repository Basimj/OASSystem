@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using OAS.Client.Features.Employees.Services
@using OAS.Contracts.Features.Employees.Import
@using OAS.UiLib.Components.Buttons
@using OAS.UiLib.Core.Enums

@inject IEmployeeClientService EmployeeService
@inject IUiSnackbarService Snackbar

<div class="employee-import-dialog">

    <div class="employee-import-header">

        <div class="employee-import-title">

            <div class="employee-import-icon">
                <i class="fa-solid fa-file-import"></i>
            </div>

            <div>
                <h2>استيراد الموظفين من Excel</h2>

                <p>
                    اختر ملف Excel ثم قم بفحص البيانات قبل إدخالها.
                </p>
            </div>

        </div>

        <button type="button"
                class="employee-import-close"
                @onclick="Close"
                disabled="@_isBusy">
            <i class="fa-solid fa-xmark"></i>
        </button>

    </div>

    <div class="employee-import-content">

        <div class="employee-import-picker"
             style="@(_selectedFile is null ? null : "display:none;")">

            <label class="employee-import-dropzone">

                <InputFile class="employee-import-input"
                           OnChange="OnFileSelected"
                           accept=".xlsx" />

                <span class="employee-import-dropzone-icon">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </span>

                <strong>
                    اختر ملف Excel
                </strong>

                <span>
                    الصيغة المدعومة: .xlsx
                </span>

            </label>

        </div>

        @if (_selectedFile is not null)
        {
            <div class="employee-import-file">

                <div class="employee-import-file-icon">
                    <i class="fa-solid fa-file-excel"></i>
                </div>

                <div class="employee-import-file-info">

                    <strong title="@_selectedFile.Name">
                        @_selectedFile.Name
                    </strong>

                    <span>
                        @FormatFileSize(_selectedFile.Size)
                    </span>

                </div>

                <button type="button"
                        class="employee-import-remove"
                        @onclick="ClearFile"
                        disabled="@_isBusy">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </div>
        }

        @if (_preview is not null)
        {
            <div class="employee-import-summary">

                <div class="employee-import-stat">
                    <strong>@_preview.TotalRows</strong>
                    <span>إجمالي الصفوف</span>
                </div>

                <div class="employee-import-stat success">
                    <strong>@_preview.ValidRows</strong>
                    <span>صفوف صحيحة</span>
                </div>

                <div class="employee-import-stat danger">
                    <strong>@_preview.InvalidRows</strong>
                    <span>صفوف بها أخطاء</span>
                </div>

            </div>

            @if (_preview.Errors.Count > 0)
            {
                <div class="employee-import-errors">

                    <div class="employee-import-errors-header">
                        <strong>أخطاء الملف</strong>

                        <span>
                            @_preview.Errors.Count خطأ
                        </span>
                    </div>

                    <div class="employee-import-errors-table">

                        <table>
                            <thead>
                                <tr>
                                    <th>الصف</th>
                                    <th>العمود</th>
                                    <th>الخطأ</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var error in _preview.Errors)
                                {
                                    <tr>
                                        <td>@error.RowNumber</td>
                                        <td>@error.Column</td>
                                        <td>@error.Message</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>

                </div>
            }
            else if (_preview.IsValid)
            {
                <div class="employee-import-success">

                    <i class="fa-solid fa-circle-check"></i>

                    <div>
                        <strong>
                            الملف جاهز للاستيراد
                        </strong>

                        <span>
                            جميع الصفوف اجتازت التحقق.
                        </span>
                    </div>

                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="employee-import-error-message">

                <i class="fa-solid fa-triangle-exclamation"></i>

                <div>
                    <strong>حدث خطأ</strong>

                    <span>
                        @_errorMessage
                    </span>
                </div>

            </div>
        }

    </div>

    <div class="employee-import-footer">

        <UiButton Text="إلغاء"
                  Variant="ButtonVariant.Secondary"
                  Disabled="@_isBusy"
                  OnClick="CancelClicked">
        </UiButton>

        @if (_preview is null)
        {
            <UiButton Text="فحص الملف"
                      Variant="ButtonVariant.Primary"
                      Disabled="@(_selectedFile is null || _isBusy)"
                      Loading="@_isBusy"
                      OnClick="ValidateFileAsync">
            </UiButton>
        }
        else
        {
            <UiButton Text="اعتماد الاستيراد"
                      Variant="ButtonVariant.Primary"
                      Disabled="@(!_preview.IsValid || _isBusy)"
                      Loading="@_isBusy"
                      OnClick="ImportFileAsync">
            </UiButton>
        }

    </div>

</div>

@code {

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IBrowserFile? _selectedFile;
    private EmployeeImportPreviewDto? _preview;
    private bool _isBusy;
    private string? _errorMessage;

    private async Task OnFileSelected(
        InputFileChangeEventArgs args)
    {
        _errorMessage = null;
        _preview = null;
        _selectedFile = args.File;

        await InvokeAsync(StateHasChanged);
    }

    private void ClearFile()
    {
        if (_isBusy)
            return;

        _selectedFile = null;
        _preview = null;
        _errorMessage = null;
    }

    private async Task ValidateFileAsync()
    {
        if (_selectedFile is null)
            return;

        _isBusy = true;
        _errorMessage = null;
        _preview = null;

        try
        {
            var file = _selectedFile;

            _preview =
                await EmployeeService.ValidateImportAsync(file);

            if (_preview.IsValid)
            {
                Snackbar.Success("تم فحص الملف بنجاح.");
            }
            else
            {
                Snackbar.Error(
                    $"يوجد {_preview.InvalidRows} صف يحتوي على أخطاء.");
            }
        }
        catch (ApiClientException ex)
        {
            _errorMessage =
                $"تعذر فحص الملف: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        catch (HttpRequestException ex)
        {
            _errorMessage =
                $"تعذر الاتصال بالخادم: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"{ex.GetType().Name}: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ImportFileAsync()
    {
        if (_selectedFile is null ||
            _preview is null ||
            !_preview.IsValid)
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;

        try
        {
            var file = _selectedFile;

            var result =
                await EmployeeService.ImportAsync(file);

            Snackbar.Success(
                $"تم استيراد {result.ImportedRows} موظف بنجاح.");

            await OnClose.InvokeAsync();
        }
        catch (ApiClientException ex)
        {
            _errorMessage =
                $"تعذر استيراد الموظفين: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        catch (HttpRequestException ex)
        {
            _errorMessage =
                $"تعذر الاتصال بالخادم: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"{ex.GetType().Name}: {ex.Message}";

            Snackbar.Error(_errorMessage);
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CancelClicked(MouseEventArgs _)
    {
        await Close();
    }

    private async Task Close()
    {
        if (_isBusy)
            return;

        await OnClose.InvokeAsync();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:0.##} KB";

        return $"{bytes / 1024d / 1024d:0.##} MB";
    }
}