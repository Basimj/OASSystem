@page "/employees/salary-components"
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>مكونات الرواتب</PageTitle>

<UiWorkspaceLayout ShowAside="true" ShowFilters="false">
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="جديد" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small" Disabled="@IsEditing" OnClick="BeginCreateAsync" />
            <UiButton Text="حفظ" IconCssClass="fa-solid fa-floppy-disk" Size="ControlSize.Small" Disabled="@(!CanSave)" Loading="@_saving" OnClick="SaveAsync" />
            <UiButton Text="تعديل" IconCssClass="fa-solid fa-pen" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(!CanEdit)" OnClick="BeginEditAsync" />
            <UiButton Text="إلغاء" IconCssClass="fa-solid fa-xmark" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Disabled="@(!IsEditing)" OnClick="CancelEditAsync" />
            <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@IsEditing" Loading="@_loading" OnClick="RefreshAsync" />
            <UiSearchInput @bind-Value="_search" Placeholder="ابحث بالكود أو اسم المكون..." AriaLabel="البحث عن مكون راتب" ClearText="مسح البحث" DebounceMilliseconds="200" OnSearch="SearchChangedAsync" />
        </UiWorkspaceActionBar>
    </Actions>
    <Content>
        <UiDataGridPanel Title="مكونات الرواتب"
                         Subtitle="@($"{FilteredItems.Count} مكون")"
                         HeaderLabels="@SalaryComponentGridHeaders"
                         HeaderCssClass="salary-component-grid-header">
            <Body>
                @if (_loading)
                {
                    <UiAlert Message="جاري تحميل مكونات الرواتب..." />
                }
                else if (FilteredItems.Count == 0)
                {
                    <UiAlert Message="لا توجد مكونات رواتب." />
                }
                else
                {
                    <UiContainer CssClass="salary-component-grid-body">
                        @foreach (var item in FilteredItems)
                        {
                            <UiClickableSurface CssClass="@(item.Id == _selected?.Id ? "salary-component-grid-row salary-component-grid-row--selected" : "salary-component-grid-row")"
                                                OnClick="@(() => SelectItem(item))">
                                <UiInline CssClass="salary-component-code">@item.ComponentCode</UiInline>
                                <UiInline Strong="true">@item.NameAr</UiInline>
                                <UiInline>@TypeName(item.ComponentType)</UiInline>
                                <UiInline>@MethodName(item.CalculationMethod)</UiInline>
                                <UiBadge Text="@(item.IsActive ? "نشط" : "غير نشط")" Tone="@(item.IsActive ? AlertTone.Success : AlertTone.Danger)" />
                            </UiClickableSurface>
                        }
                    </UiContainer>
                }
            </Body>
        </UiDataGridPanel>
    </Content>
    <Aside>
        <UiContainer CssClass="salary-component-aside-card">
            <UiCard Title="@EditorTitle" Subtitle="@EditorSubtitle">
                @if (_mode == EditorMode.Empty)
                {
                    <UiAlert Message="اختر مكونًا من الجدول أو اضغط جديد." />
                }
                else
                {
                    <UiContainer CssClass="salary-component-editor">
                        <UiInputText Value="@(_selected?.ComponentCode ?? "سيولد تلقائيًا")" Label="كود المكون" ReadOnly="true" Size="ControlSize.Small" />
                        <UiInputText @bind-Value="_nameAr" Label="اسم المكون" Required="true" MaxLength="150" Disabled="@(!IsEditing)" Size="ControlSize.Small" />
                        <UiInputText @bind-Value="_nameEn" Label="الاسم الإنجليزي" MaxLength="150" Disabled="@(!IsEditing)" Size="ControlSize.Small" />
                        <UiSelect Value="@_typeValue" ValueChanged="SetTypeAsync" Label="نوع المكون" Options="@TypeOptions" Disabled="@(!IsEditing)" Required="true" Size="ControlSize.Small" />
                        <UiSelect Value="@_methodValue" ValueChanged="SetMethodAsync" Label="طريقة الاحتساب" Options="@MethodOptions" Disabled="@(!IsEditing)" Required="true" Size="ControlSize.Small" />
                        <UiContainer CssClass="salary-component-checks">
                            <UiCheckbox @bind-Value="_isBasic" Label="الراتب الأساسي" Disabled="@(!IsEditing)" />
                            <UiCheckbox @bind-Value="_isRecurring" Label="متكرر" Disabled="@(!IsEditing)" />
                            <UiCheckbox @bind-Value="_isTaxable" Label="خاضع للضريبة" Disabled="@(!IsEditing)" />
                            <UiCheckbox @bind-Value="_isActive" Label="نشط" Disabled="@(!IsEditing)" />
                        </UiContainer>
                        <UiInputText @bind-Value="_debitRole" Label="دور الحساب المدين" MaxLength="50" Disabled="@(!IsEditing)" Size="ControlSize.Small" />
                        <UiInputText @bind-Value="_creditRole" Label="دور الحساب الدائن" MaxLength="50" Disabled="@(!IsEditing)" Size="ControlSize.Small" />
                        <UiInputText @bind-Value="_displayOrderText" Label="ترتيب العرض" InputMode="numeric" Disabled="@(!IsEditing)" Size="ControlSize.Small" />
                        <UiInputText @bind-Value="_notes" Label="ملاحظات" MaxLength="500" Disabled="@(!IsEditing)" Size="ControlSize.Small" />
                    </UiContainer>
                }
            </UiCard>
        </UiContainer>
    </Aside>
</UiWorkspaceLayout>
