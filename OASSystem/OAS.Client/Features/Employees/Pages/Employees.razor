@page "/employees"
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>الموظفون</PageTitle>

@{ var activeEditorTab = ActiveEditorTab; var isListTab = activeEditorTab is null; }

<UiEmployeeWorkspace>
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="جديد"
                      IconCssClass="fa-solid fa-user-plus"
                      Size="ControlSize.Small"
                      Disabled="@(!CanNewAction)"
                      OnClick="NewActionAsync" />
            <UiButton Text="تعديل"
                      IconCssClass="fa-solid fa-pen"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Disabled="@(!CanEditAction)"
                      OnClick="BeginEditActionAsync" />
            <UiButton Text="حفظ"
                      IconCssClass="fa-solid fa-floppy-disk"
                      Size="ControlSize.Small"
                      Disabled="@(!CanSaveAction)"
                      Loading="@(activeEditorTab?.IsSaving == true)"
                      OnClick="SaveActionAsync" />
            <UiButton Text="إغلاق"
                      IconCssClass="fa-solid fa-xmark"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Disabled="@(!CanCloseActive)"
                      OnClick="CloseActiveAsync" />
            <UiButton Text="إلغاء"
                      IconCssClass="fa-solid fa-ban"
                      Variant="ButtonVariant.Ghost"
                      Size="ControlSize.Small"
                      Disabled="@(!CanCancelAction)"
                      OnClick="CancelActionAsync" />
            @if (IsContractsSection)
            {
                <UiButton Text="تفعيل العقد" IconCssClass="fa-solid fa-circle-check" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(_contractsPanel?.CanActivate != true)" OnClick="ActivateContractAsync" />
                <UiButton Text="إنهاء العقد" IconCssClass="fa-solid fa-user-slash" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(_contractsPanel?.CanTerminate != true)" OnClick="TerminateContractAsync" />
                <UiButton Text="إلغاء العقد" IconCssClass="fa-solid fa-ban" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Disabled="@(_contractsPanel?.CanCancelContract != true)" OnClick="CancelContractAsync" />
            }
            else if (IsSalarySection)
            {
                <UiButton Text="تفعيل الهيكل" IconCssClass="fa-solid fa-circle-check" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(_salaryPanel?.CanActivate != true)" OnClick="ActivateSalaryStructureAsync" />
                <UiButton Text="إلغاء الهيكل" IconCssClass="fa-solid fa-ban" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Disabled="@(_salaryPanel?.CanCancelStructure != true)" OnClick="CancelSalaryStructureAsync" />
            }
            else if (IsDocumentsSection)
            {
                <UiButton Text="@(_documentsPanel?.ToggleStatusText ?? "تغيير الحالة")" IconCssClass="fa-solid fa-toggle-on" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(_documentsPanel?.CanToggleStatus != true)" OnClick="ToggleDocumentStatusAsync" />
            }

            <UiButton Text="حذف"
                      IconCssClass="fa-regular fa-trash-can"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Disabled="true" />
            <UiButton Text="تحديث"
                      IconCssClass="fa-solid fa-rotate"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Disabled="@(!CanRefreshAction)"
                      Loading="@(isListTab ? _isLoading : activeEditorTab?.IsLoading == true)"
                      OnClick="RefreshActionAsync" />
            <UiButton Text="استيراد"
                      IconCssClass="fa-solid fa-file-import"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Disabled="@(!isListTab)"
                      OnClick="OpenImportDialog" />
            <UiButton Text="تصدير"
                      IconCssClass="fa-solid fa-file-export"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Disabled="@(!isListTab)"
                      OnClick="OpenExportDialog" />
            <UiSearchInput @bind-Value="Workspace.SearchText"
                           Placeholder="ابحث بكود الموظف أو الاسم أو الجوال أو البريد أو المسمى..."
                           AriaLabel="البحث عن موظف"
                           ClearText="مسح البحث"
                           DebounceMilliseconds="300"
                           Disabled="@(!isListTab)"
                           OnSearch="SearchChangedAsync" />
            <UiEmployeeFilterMenu Value="@Workspace.Filter.ToString()"
                                  ValueChanged="FilterChangedAsync"
                                  Options="@FilterOptions"
                                  Disabled="@(!isListTab)" />
        </UiWorkspaceActionBar>
    </Actions>

    <Tabs>
        <UiApplicationTabStrip Tabs="@WorkspaceTabs"
                               AriaLabel="تبويبات الموظفين"
                               EnableContextMenu="true"
                               OnSelect="SelectWorkspaceTabAsync"
                               OnClose="CloseWorkspaceTabAsync"
                               OnCloseOthers="CloseOtherWorkspaceTabsAsync"
                               OnCloseAll="CloseAllWorkspaceTabsAsync" />
    </Tabs>

    <Content>
        @if (activeEditorTab is null)
        {
            var visibleEmployees = VisibleEmployees;
            <UiEmployeeListSurface Loading="@_isLoading" IsEmpty="@(visibleEmployees.Count == 0)">
                <ChildContent>
                    @foreach (var employee in visibleEmployees)
                    {
                        <UiEmployeeCard Name="@employee.DisplayName"
                                        EmployeeCode="@employee.EmployeeCode"
                                        ImageUrl="@GetEmployeeImageUrl(employee)"
                                        JobTitle="@employee.JobTitleName"
                                        Phone="@employee.Phone"
                                        IsActive="@employee.IsActive"
                                        IsCommissionEligible="@employee.IsCommissionEligible"
                                        OnOpen="@(() => OpenEmployeeAsync(employee.Id))"
                                        OnToggleStatus="@(() => ToggleEmployeeStatusAsync(employee))" />
                    }
                </ChildContent>
                <Footer>
                    <UiEmployeePager PageNumber="@_page.PageNumber"
                                     TotalPages="@_page.TotalPages"
                                     TotalCount="@_page.TotalCount"
                                     PageSize="@PageSize"
                                     OnPageChanged="PageChangedAsync" />
                </Footer>
            </UiEmployeeListSurface>
        }
        else if (activeEditorTab.IsLoading || !activeEditorTab.IsInitialized)
        {
            <UiEmployeeListSurface Loading="true" IsEmpty="false" LoadingText="جاري تحميل بيانات الموظف..." />
        }
        else
        {
            <UiContainer CssClass="employee-editor-sections">
                <UiSectionTabStrip Tabs="@EmployeeSectionTabs" OnSelect="ChangeEmployeeSectionAsync" />
                @if (activeEditorTab.ActiveSectionKey == "core" || activeEditorTab.IsNew)
                {
                    <UiEmployeeEditorForm Model="@activeEditorTab.Form"
                                          IsNew="@activeEditorTab.IsNew"
                                          IsEditable="@(activeEditorTab.IsNew || activeEditorTab.IsEditMode)"
                                          UserAccountLinkLocked="@activeEditorTab.IsUserAccountLinkLocked"
                                          ImageUrl="@activeEditorTab.EffectiveImageUrl"
                                          ShowRemoveImage="@activeEditorTab.ShowRemoveImage"
                                          JobTitleOptions="@ActiveJobTitleOptions"
                                          DepartmentOptions="@ActiveDepartmentOptions"
                                          ManagerEmployeeItem="@ManagerEmployeeItem"
                                          ManagerEmployeeSearchAsync="@SearchManagerEmployeesAsync"
                                          LinkedUserItem="@LinkedUserItem"
                                          UserSearchAsync="@SearchUsersAsync"
                                          OnChanged="EditorChangedAsync"
                                          OnImageSelected="EmployeeImageSelectedAsync"
                                          OnImageRemoved="EmployeeImageRemovedAsync" />
                }
                else if (activeEditorTab.EmployeeId is Guid employeeId && activeEditorTab.ActiveSectionKey == "contracts")
                {
                    <EmployeeContractsPanel @ref="_contractsPanel" EmployeeId="@employeeId" OnStateChanged="HrPanelStateChangedAsync" />
                }
                else if (activeEditorTab.EmployeeId is Guid salaryEmployeeId && activeEditorTab.ActiveSectionKey == "salary")
                {
                    <EmployeeSalaryPanel @ref="_salaryPanel" EmployeeId="@salaryEmployeeId" OnStateChanged="HrPanelStateChangedAsync" />
                }
                else if (activeEditorTab.EmployeeId is Guid timeEmployeeId && activeEditorTab.ActiveSectionKey == "time")
                {
                    <EmployeeHrSummaryPanel EmployeeId="@timeEmployeeId" Section="time" />
                }
                else if (activeEditorTab.EmployeeId is Guid leaveEmployeeId && activeEditorTab.ActiveSectionKey == "leave")
                {
                    <EmployeeHrSummaryPanel EmployeeId="@leaveEmployeeId" Section="leave" />
                }
                else if (activeEditorTab.EmployeeId is Guid loansEmployeeId && activeEditorTab.ActiveSectionKey == "loans")
                {
                    <EmployeeHrSummaryPanel EmployeeId="@loansEmployeeId" Section="loans" />
                }
                else if (activeEditorTab.EmployeeId is Guid adjustmentsEmployeeId && activeEditorTab.ActiveSectionKey == "adjustments")
                {
                    <EmployeeHrSummaryPanel EmployeeId="@adjustmentsEmployeeId" Section="adjustments" />
                }
                else if (activeEditorTab.EmployeeId is Guid payrollEmployeeId && activeEditorTab.ActiveSectionKey == "payroll")
                {
                    <EmployeeHrSummaryPanel EmployeeId="@payrollEmployeeId" Section="payroll" />
                }
                else if (activeEditorTab.EmployeeId is Guid documentsEmployeeId && activeEditorTab.ActiveSectionKey == "documents")
                {
                    <EmployeeDocumentsPanel @ref="_documentsPanel" EmployeeId="@documentsEmployeeId" OnStateChanged="HrPanelStateChangedAsync" />
                }
            </UiContainer>
        }
    </Content>
</UiEmployeeWorkspace>

@if (_importMenuOpen)
{
    <UiEmployeeModalHost OnClose="CloseImportDialog">
        <UiEmployeeImportChoiceDialog OnClose="CloseImportDialog" OnInternalEntry="OpenEmployeeEntry" OnExcelImport="OpenExcelImportDialog" />
    </UiEmployeeModalHost>
}

@if (_importDialogOpen)
{
    <UiEmployeeModalHost OnClose="CloseExcelImportDialog">
        <EmployeeImportDialog OnClose="RefreshAfterImport" />
    </UiEmployeeModalHost>
}

@if (_employeeEntryOpen)
{
    <UiEmployeeModalHost Wide="true" OnClose="CloseEmployeeEntry">
        <EmployeeBulkEntry OnClose="CloseEmployeeEntry" />
    </UiEmployeeModalHost>
}

@if (_exportDialogOpen)
{
    <UiEmployeeModalHost OnClose="CloseExportDialog">
        <UiEmployeeExportChoiceDialog OnClose="CloseExportDialog" OnExport="ExportEmployeesAsync" OnDownloadTemplate="DownloadEmployeeTemplateAsync" />
    </UiEmployeeModalHost>
}
