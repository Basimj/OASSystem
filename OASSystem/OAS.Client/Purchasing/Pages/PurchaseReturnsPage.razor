@using static OAS.UiLib.Core.Formatting.PurchasingDisplayFormat
@page "/purchases/returns"
@attribute [Authorize]
@using OAS.Client.Purchasing.Services
@using OAS.Contracts.Purchasing.PurchaseReturns
@using OAS.Contracts.Purchasing.PurchaseReceipts
@using OAS.Contracts.Purchasing.PurchaseInvoices
@using OAS.Contracts.Purchasing.Enums
@inject IPurchasingClientService Purchasing
@using Microsoft.AspNetCore.Components

<PageTitle>مرتجعات المشتريات | OAS</PageTitle>

<div class="purchasing-module-root">
<UiWorkspaceLayout ShowAside="@(!_creating && _selected is not null)" ShowFilters="false" ScrollableMain="@_creating">
    <Actions>
        <UiWorkspaceActionBar>
            @if (_creating)
            {
                <UiButton Text="العودة إلى القائمة" IconCssClass="fa-solid fa-arrow-right" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="CloseEditorAsync" />
                <UiButton Text="حفظ المسودة" IconCssClass="fa-solid fa-floppy-disk" Size="ControlSize.Small" Loading="@_busy" OnClick="CreateAsync" />
            }
            else
            {
                <UiButton Text="مرتجع جديد" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small" OnClick="BeginCreateAsync" />
                <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Loading="@_busy" OnClick="RefreshAsync" />
                @if (_selected is { Status: PurchaseReturnStatus.Draft })
                {
                    <UiButton Text="تأكيد" IconCssClass="fa-solid fa-check" Size="ControlSize.Small" Loading="@_busy" OnClick="ConfirmAsync" />
                    <UiButton Text="إلغاء" IconCssClass="fa-solid fa-ban" Variant="ButtonVariant.Danger" Size="ControlSize.Small" Loading="@_busy" OnClick="CancelAsync" />
                }
                else if (_selected is { Status: PurchaseReturnStatus.Confirmed })
                {
                    <UiButton Text="ترحيل" IconCssClass="fa-solid fa-arrow-up-right-dots" Size="ControlSize.Small" Loading="@_busy" OnClick="PostAsync" />
                    <UiButton Text="إلغاء" IconCssClass="fa-solid fa-ban" Variant="ButtonVariant.Danger" Size="ControlSize.Small" Loading="@_busy" OnClick="CancelAsync" />
                }
            }
        </UiWorkspaceActionBar>
    </Actions>

    <Content>
        @if (_creating)
        {
            <div class="purchase-return-editor">
                @if (!string.IsNullOrWhiteSpace(_editorError))
                {
                    <UiAlert Message="@_editorError" Tone="AlertTone.Danger" />
                }
                <div class="purchase-return-editor__layout">
                    <section class="purchase-return-editor__meta" aria-labelledby="purchase-return-meta-title">
                        <h3 id="purchase-return-meta-title" class="purchase-return-editor__title">بيانات المرتجع</h3>

                        <div class="purchase-return-editor__field">
                            <UiSelect Label="استلام المشتريات"
                                      Placeholder="اختر استلامًا مرحلًا"
                                      Value="@_receiptIdText"
                                      ValueChanged="ReceiptChangedAsync"
                                      Options="@ReceiptOptions"
                                      Size="ControlSize.Small" />
                        </div>
                        <details class="purchase-return-editor__lookup">
                            <summary>البحث في الاستلامات الأخرى</summary>
                            <div class="purchase-return-editor__lookup-body">
                                <label for="ap07-receipt-search" class="form-label">بحث برقم الاستلام أو المورد</label>
                                <div class="purchase-return-editor__search-row">
                                    <input id="ap07-receipt-search" class="form-control form-control-sm" placeholder="رقم الاستلام أو المورد..." @bind="_receiptSearch" @bind:event="oninput" />
                                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_busy" @onclick="SearchReceiptsAsync">بحث</button>
                                </div>
                                <div class="purchase-return-editor__pager">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_busy || _receiptPageNumber <= 1)" @onclick="PreviousReceiptPageAsync">السابق</button>
                                    <span>صفحة @_receiptPageNumber من @_receiptTotalPages — @_receiptTotalCount استلام</span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_busy || _receiptPageNumber >= _receiptTotalPages)" @onclick="NextReceiptPageAsync">التالي</button>
                                </div>
                            </div>
                        </details>
                        @if (_sourceReceipt is not null)
                        {
                            <div class="purchase-return-editor__receipt-summary">
                                <strong>@_sourceReceipt.ReceiptCode</strong>
                                <span>@(_sourceReceipt.SupplierName ?? _sourceReceipt.SupplierCode ?? "مورد")</span>
                                <span>@(_sourceReceipt.WarehouseName ?? "مخزن غير محدد")</span>
                                <a href="@($"/purchases/receipts?openId={_sourceReceipt.Id:D}")">فتح الاستلام الأصلي</a>
                            </div>
                        }

                        <div class="purchase-return-editor__dates">
                            <div class="purchase-return-editor__field">
                                <UiInputDate Label="تاريخ المرتجع" Value="@_returnDate" ValueChanged="@(value => _returnDate = value)" Size="ControlSize.Small" />
                            </div>
                            <div class="purchase-return-editor__field">
                                <UiInputDate Label="تاريخ الترحيل" Value="@_postingDate" ValueChanged="@(value => _postingDate = value)" Size="ControlSize.Small" />
                            </div>
                        </div>
                        <div class="purchase-return-editor__field">
                            <UiInputText Label="سبب المرتجع (اختياري)" Value="@_reason" ValueChanged="@(value => _reason = value)" Size="ControlSize.Small" MaxLength="1000" />
                        </div>
                        @if (_sourceReceipt is not null)
                        {
                            <details class="purchase-return-editor__lookup">
                                <summary>فاتورة المورد المرتبطة (اختياري)</summary>
                                <div class="purchase-return-editor__lookup-body">
                                    <UiSelect Label="فاتورة المورد" Placeholder="غير مفوتر - عكس GRNI"
                                              Value="@_invoiceIdText"
                                              ValueChanged="@(value => _invoiceIdText = value)"
                                              Options="@InvoiceOptions" Size="ControlSize.Small" />
                                    <label for="ap07-invoice-search" class="form-label">البحث في الفواتير المرتبطة بهذا الاستلام</label>
                                    <div class="purchase-return-editor__search-row">
                                        <input id="ap07-invoice-search" class="form-control form-control-sm" placeholder="رقم الفاتورة أو رقم فاتورة المورد..." @bind="_invoiceSearch" @bind:event="oninput" />
                                        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_busy" @onclick="SearchInvoicesAsync">بحث</button>
                                    </div>
                                    <div class="purchase-return-editor__pager">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_busy || _invoicePageNumber <= 1)" @onclick="PreviousInvoicePageAsync">السابق</button>
                                        <span>صفحة @_invoicePageNumber من @_invoiceTotalPages — @_invoiceTotalCount فاتورة</span>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_busy || _invoicePageNumber >= _invoiceTotalPages)" @onclick="NextInvoicePageAsync">التالي</button>
                                    </div>
                                </div>
                            </details>
                        }
                    </section>

                    <section class="purchase-return-editor__items" aria-labelledby="purchase-return-items-title">
                        <div class="purchase-return-editor__items-head">
                            <h3 id="purchase-return-items-title" class="purchase-return-editor__title">الأصناف المرتجعة</h3>
                            <span>@_returnLines.Count بند</span>
                        </div>
                        @if (_sourceReceipt is null)
                        {
                            <p class="purchase-return-editor__empty">اختر استلام مشتريات مرحلًا لعرض الأصناف والكميات المتاحة للإرجاع.</p>
                        }
                        else
                        {
                            <div class="purchase-return-editor__table-head" aria-hidden="true">
                                <span>إرجاع</span><span>الصنف</span><span>المتاح</span><span>الكمية المرتجعة</span>
                            </div>
                            <div class="purchase-return-editor__lines">
                                @foreach (var line in _returnLines)
                                {
                                    <div @key="line" class="purchase-return-editor__line">
                                        <div class="purchase-return-editor__line-select">
                                            <UiCheckbox Value="@line.Selected"
                                                        ValueChanged="@(value => line.Selected = value)"
                                                        Label="إرجاع" Disabled="@(line.Remaining <= 0m)" />
                                        </div>
                                        <div class="purchase-return-editor__line-product">
                                            <strong>@(line.Line.ProductName ?? line.Line.ProductCode ?? "صنف")</strong>
                                            <span>البند @line.Line.LineSequence</span>
                                        </div>
                                        <div class="purchase-return-editor__line-available">
                                            <span class="purchase-return-editor__mobile-label">المتاح للإرجاع</span>
                                            <strong>@($"{line.Remaining:#,##0.###}")</strong>
                                        </div>
                                        <div class="purchase-return-editor__line-quantity">
                                            <UiInputText Label="الكمية المرتجعة"
                                                         Value="@line.QuantityText"
                                                         ValueChanged="@(value => line.QuantityText = value ?? string.Empty)"
                                                         InputMode="decimal"
                                                         Size="ControlSize.Small"
                                                         Disabled="@(!line.Selected || line.Remaining <= 0m)" />
                                        </div>
                                    </div>
                                }
                            </div>
                            <p class="purchase-return-editor__hint">حدد الأصناف المطلوب إرجاعها، ثم أدخل كمية لا تتجاوز المتاح لكل صنف.</p>
                        }
                    </section>
                </div>
                <div class="purchase-return-editor__footer">
                    <UiButton Text="حفظ المسودة" IconCssClass="fa-solid fa-floppy-disk" Loading="@_busy" Size="ControlSize.Small" OnClick="CreateAsync" />
                    <UiButton Text="إلغاء" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="CloseEditorAsync" />
                </div>
            </div>
        }
        else
        {
            <UiDataGridPanel Title="مرتجعات المشتريات" Subtitle="@($"{_page.TotalCount:N0} مستند")">
                <Toolbar>
                    <UiSearchInput Value="@_search" ValueChanged="@(value => _search = value)" OnSearch="SearchAsync" Placeholder="بحث برقم المرتجع أو السبب..." />
                </Toolbar>
                <Body>
                    <UiStackLayout Gap="StackGap.Small">
                        @if (!string.IsNullOrWhiteSpace(_error))
                        {
                            <UiAlert Message="@_error" Tone="AlertTone.Danger" />
                        }
                        @if (_busy && _page.Items.Count == 0)
                        {
                            <UiAlert Message="جارٍ تحميل مرتجعات المشتريات..." Tone="AlertTone.Info" />
                        }
                        else if (_page.Items.Count == 0)
                        {
                            <UiAlert Message="لا توجد مرتجعات مشتريات مطابقة." Tone="AlertTone.Info" />
                        }
                        else
                        {
                            @foreach (var item in _page.Items)
                            {
                                <UiRecordRow Title="@item.ReturnCode"
                                             Subtitle="@($"{DisplayDate(item.ReturnDate)} • مخزون {item.InventoryCostBaseAmount:#,##0.##}")"
                                             Selected="@(_selected?.Id == item.Id)"
                                             OnClick="@(() => SelectAsync(item.Id))">
                                    <Content>
                                        <UiKeyValue Label="مرجع الفاتورة" Value="@(item.PurchaseInvoiceId.HasValue ? "فاتورة مورد" : "استلام / GRNI")" />
                                    </Content>
                                    <Trailing>
                                        <UiBadge Text="@StatusText(item.Status)" Tone="@StatusTone(item.Status)" />
                                    </Trailing>
                                </UiRecordRow>
                            }
                        }
                    </UiStackLayout>
                </Body>
                <Footer>
                    <UiPagination PageNumber="@_page.PageNumber" TotalPages="@_page.TotalPages" TotalCount="@_page.TotalCount" OnPrevious="PreviousAsync" OnNext="NextAsync" />
                </Footer>
            </UiDataGridPanel>
        }
    </Content>

    <Aside>
        @if (_selected is not null)
        {
            <UiCard Title="@_selected.ReturnCode" Subtitle="@StatusText(_selected.Status)">
                <UiStackLayout Gap="StackGap.Small">
                    <UiGrid Columns="2">
                        <UiKeyValue Label="تاريخ المرتجع" Value="@DisplayDate(_selected.ReturnDate)" />
                        <UiKeyValue Label="تاريخ الترحيل" Value="@DisplayDate(_selected.PostingDate)" />
                        <UiKeyValue Label="تكلفة الاستلام" Value="@_selected.ReceiptCostBaseAmount.ToString("#,##0.##")" />
                        <UiKeyValue Label="قيمة المورد" Value="@_selected.SupplierGrossBaseAmount.ToString("#,##0.##")" />
                        <UiKeyValue Label="قيمة المخزون" Value="@_selected.InventoryCostBaseAmount.ToString("#,##0.##")" />
                        <UiKeyValue Label="فرق سعر الشراء" Value="@_selected.PurchasePriceVarianceBaseAmount.ToString("#,##0.##")" />
                        <UiKeyValue Label="المعالجة" Value="@(_selected.PurchaseInvoiceId.HasValue ? "عكس حساب المورد والضريبة" : "عكس GRNI")" />
                        <UiKeyValue Label="القيد" Value="@(_selected.JournalEntryId.HasValue ? "مرحّل" : "غير مرحل")" />
                    </UiGrid>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-secondary btn-sm" href="@($"/purchases/receipts?openId={_selected.PurchaseReceiptId:D}")">فتح الاستلام</a>
                        @if (_selected.PurchaseInvoiceId.HasValue)
                        {
                            <a class="btn btn-outline-secondary btn-sm" href="@($"/purchases/invoices?openId={_selected.PurchaseInvoiceId.Value:D}")">فتح فاتورة المورد</a>
                        }
                        @if (_selected.JournalEntryId.HasValue)
                        {
                            <a class="btn btn-outline-secondary btn-sm" href="@($"/accounting/journals?journalId={_selected.JournalEntryId.Value:D}")">فتح القيد</a>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_selected.Reason))
                    {
                        <UiAlert Message="@_selected.Reason" Tone="AlertTone.Info" />
                    }
                    <UiCard Title="الأسطر" Subtitle="@($"{_selected.Lines.Count} سطر")">
                        <UiStackLayout Gap="StackGap.Small">
                            @foreach (var line in _selected.Lines)
                            {
                                <UiRecordRow Title="@($"{line.LineNumber} - {line.ProductVariantId:D}")"
                                             Subtitle="@($"كمية {line.Quantity:#,##0.###} • أساسي {line.BaseQuantity:#,##0.###}")">
                                    <Content>
                                        <UiKeyValue Label="تكلفة المخزون" Value="@(line.InventoryCostBaseAmount?.ToString("#,##0.##") ?? "تُلتقط عند الترحيل")" />
                                    </Content>
                                </UiRecordRow>
                            }
                        </UiStackLayout>
                    </UiCard>
                </UiStackLayout>
            </UiCard>
        }
    </Aside>
</UiWorkspaceLayout>
</div>

@code {
    private PagedResult<PurchaseReturnDto> _page = new();
    private PurchaseReturnDto? _selected;
    private PurchaseReceiptDto? _sourceReceipt;
    private IReadOnlyList<PurchaseReceiptDto> _postedReceipts = [];
    private IReadOnlyList<PurchaseInvoiceDto> _postedInvoices = [];
    private readonly List<ReturnLineForm> _returnLines = [];
    [SupplyParameterFromQuery(Name = "receiptId")]
    private Guid? LinkedReceiptId { get; set; }
    private int _receiptPageNumber = 1;
    private int _receiptTotalPages;
    private long _receiptTotalCount;
    private string? _receiptSearch;
    private int _invoicePageNumber = 1;
    private int _invoiceTotalPages;
    private long _invoiceTotalCount;
    private string? _invoiceSearch;
    private bool _creating;
    private bool _busy;
    private int _pageNumber = 1;
    private string? _search;
    private string? _error;
    private string? _editorError;
    private string? _receiptIdText;
    private string? _invoiceIdText;
    private DateOnly? _returnDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _postingDate = DateOnly.FromDateTime(DateTime.Today);
    private string? _reason;

    private IReadOnlyList<UiSelectOption> ReceiptOptions => _postedReceipts
        .Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.ReceiptCode} - {x.SupplierName ?? x.SupplierCode ?? "مورد"}"))
        .ToArray();

    private IReadOnlyList<UiSelectOption> InvoiceOptions => _postedInvoices
        .Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.PurchaseInvoiceCode} - {x.SupplierInvoiceCode ?? "بدون رقم مورد"}"))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        if (LinkedReceiptId.HasValue)
        {
            await BeginCreateAsync();
            var id = LinkedReceiptId.Value;
            await ReceiptChangedAsync(id.ToString("D"));
        }
    }

    private async Task RefreshAsync()
    {
        _busy = true; _error = null;
        try
        {
            _page = await Purchasing.GetPurchaseReturnsAsync(new PageRequest { PageNumber = _pageNumber, PageSize = 20, Search = _search });
            if (_selected is not null) _selected = await Purchasing.GetPurchaseReturnAsync(_selected.Id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SearchAsync(string? value) { _search = value; _pageNumber = 1; await RefreshAsync(); }
    private async Task PreviousAsync() { if (_pageNumber > 1) { _pageNumber--; await RefreshAsync(); } }
    private async Task NextAsync() { if (_page.HasNextPage) { _pageNumber++; await RefreshAsync(); } }

    private async Task SelectAsync(Guid id)
    {
        _creating = false; _editorError = null; _busy = true;
        try { _selected = await Purchasing.GetPurchaseReturnAsync(id); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task BeginCreateAsync()
    {
        _creating = true; _selected = null; _editorError = null; _sourceReceipt = null;
        _returnLines.Clear(); _receiptIdText = null; _invoiceIdText = null; _reason = null;
        _returnDate = DateOnly.FromDateTime(DateTime.Today); _postingDate = _returnDate;
        _receiptSearch = null; _invoiceSearch = null;
        _receiptPageNumber = 1; _invoicePageNumber = 1;
        await LoadReceiptsAsync();
    }

    private async Task SearchReceiptsAsync() { _receiptPageNumber = 1; await LoadReceiptsAsync(); }
    private async Task PreviousReceiptPageAsync() { if (_receiptPageNumber > 1) { _receiptPageNumber--; await LoadReceiptsAsync(); } }
    private async Task NextReceiptPageAsync() { if (_receiptPageNumber < _receiptTotalPages) { _receiptPageNumber++; await LoadReceiptsAsync(); } }

    private async Task LoadReceiptsAsync()
    {
        _busy = true; _editorError = null;
        try
        {
            var page = await Purchasing.GetPurchaseReceiptsAsync(new PageRequest
            {
                PageNumber = _receiptPageNumber, PageSize = 20, Search = _receiptSearch,
                SortBy = "ReceiptDate", SortDirection = SortDirection.Descending
            }, PurchaseReceiptStatus.Posted);
            _postedReceipts = page.Items;
            _receiptTotalPages = page.TotalPages;
            _receiptTotalCount = page.TotalCount;
            // Preserve the active selection when navigating to another page.
            if (_sourceReceipt is not null && !_postedReceipts.Any(x => x.Id == _sourceReceipt.Id))
                _postedReceipts = [ _sourceReceipt, .._postedReceipts ];
        }
        catch (Exception ex) { _editorError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SearchInvoicesAsync() { _invoicePageNumber = 1; await LoadInvoicesAsync(); }
    private async Task PreviousInvoicePageAsync() { if (_invoicePageNumber > 1) { _invoicePageNumber--; await LoadInvoicesAsync(); } }
    private async Task NextInvoicePageAsync() { if (_invoicePageNumber < _invoiceTotalPages) { _invoicePageNumber++; await LoadInvoicesAsync(); } }

    private async Task LoadInvoicesAsync()
    {
        if (_sourceReceipt is null) return;
        _busy = true; _editorError = null;
        try
        {
            var page = await Purchasing.GetMatchedPurchaseInvoicesForReceiptAsync(_sourceReceipt.Id, new PageRequest
            {
                PageNumber = _invoicePageNumber, PageSize = 20, Search = _invoiceSearch,
                SortBy = "InvoiceDate", SortDirection = SortDirection.Descending
            });
            _postedInvoices = page.Items;
            _invoiceTotalPages = page.TotalPages;
            _invoiceTotalCount = page.TotalCount;
            if (Guid.TryParse(_invoiceIdText, out var invoiceId) && !_postedInvoices.Any(x => x.Id == invoiceId))
            {
                var selected = await Purchasing.GetPurchaseInvoiceAsync(invoiceId);
                if (selected is not null && selected.SupplierId == _sourceReceipt.SupplierId)
                    _postedInvoices = [ selected, .._postedInvoices ];
            }
        }
        catch (Exception ex) { _editorError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ReceiptChangedAsync(string? value)
    {
        _receiptIdText = value; _invoiceIdText = null; _sourceReceipt = null; _returnLines.Clear(); _postedInvoices = [];
        if (!Guid.TryParse(value, out var id)) return;
        _busy = true;
        try
        {
            _sourceReceipt = await Purchasing.GetPurchaseReceiptAsync(id);
            if (_sourceReceipt is null) return;
            if (_sourceReceipt.Status != PurchaseReceiptStatus.Posted)
            {
                _editorError = "الاستلام المحدد ليس مرحلًا.";
                _sourceReceipt = null;
                return;
            }
            if (!_postedReceipts.Any(x => x.Id == _sourceReceipt.Id))
                _postedReceipts = [ _sourceReceipt, .._postedReceipts ];
            foreach (var line in _sourceReceipt.Lines)
            {
                var remaining = Math.Max(0m, line.AcceptedQuantity - line.ReturnedQuantity);
                _returnLines.Add(new ReturnLineForm(line, remaining));
            }
            _invoicePageNumber = 1; _invoiceSearch = null;
            // Server enforces that invoice lines actually match this receipt and supplier.
            await LoadInvoicesAsync();
        }
        catch (Exception ex) { _editorError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CreateAsync()
    {
        _editorError = null;
        if (_sourceReceipt is null || !_returnDate.HasValue || !_postingDate.HasValue)
        {
            _editorError = "اختر استلام مشتريات وحدد تاريخ المرتجع والترحيل.";
            return;
        }
        Guid? invoiceId = Guid.TryParse(_invoiceIdText, out var parsedInvoice) ? parsedInvoice : null;
        var lines = new List<CreatePurchaseReturnLineRequest>();
        foreach (var form in _returnLines.Where(x => x.Selected))
        {
            if (!decimal.TryParse(form.QuantityText, out var quantity) || quantity <= 0m || quantity > form.Remaining)
            {
                _editorError = $"تحقق من كمية السطر {form.Line.LineSequence}. الحد الأقصى {form.Remaining:#,##0.###}.";
                return;
            }
            lines.Add(new CreatePurchaseReturnLineRequest(form.Line.Id, quantity));
        }
        if (lines.Count == 0)
        {
            _editorError = "حدد سطرًا واحدًا على الأقل وكمية مرتجعة صحيحة.";
            return;
        }

        _busy = true;
        try
        {
            var created = await Purchasing.CreatePurchaseReturnAsync(new CreatePurchaseReturnRequest(_sourceReceipt.Id, invoiceId, _returnDate.Value, _postingDate.Value, _reason, lines));
            if (created is not null)
            {
                _creating = false; _selected = created; _pageNumber = 1;
                await RefreshAsync();
            }
        }
        catch (Exception ex) { _editorError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmAsync()
    {
        if (_selected is null) return;
        await RunSelectedActionAsync(async () => await Purchasing.ConfirmPurchaseReturnAsync(_selected.Id, new PurchaseReturnActionRequest(_selected.RowVersion)));
    }

    private async Task PostAsync()
    {
        if (_selected is null) return;
        _busy = true; _error = null;
        try
        {
            await Purchasing.PostPurchaseReturnAsync(_selected.Id, new PurchaseReturnActionRequest(_selected.RowVersion));
            _selected = await Purchasing.GetPurchaseReturnAsync(_selected.Id);
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CancelAsync()
    {
        if (_selected is null) return;
        await RunSelectedActionAsync(async () => await Purchasing.CancelPurchaseReturnAsync(_selected.Id, new CancelPurchaseReturnRequest(_selected.RowVersion, "إلغاء من واجهة مرتجعات المشتريات")));
    }

    private async Task RunSelectedActionAsync(Func<Task<PurchaseReturnDto?>> action)
    {
        _busy = true; _error = null;
        try
        {
            var result = await action();
            if (result is not null) _selected = result;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private Task CloseEditorAsync() { _creating = false; _editorError = null; return Task.CompletedTask; }

    private static string StatusText(PurchaseReturnStatus status) => status switch
    {
        PurchaseReturnStatus.Draft => "مسودة",
        PurchaseReturnStatus.Confirmed => "مؤكد",
        PurchaseReturnStatus.Posted => "مرحل",
        PurchaseReturnStatus.Cancelled => "ملغي",
        _ => status.ToString()
    };

    private static AlertTone StatusTone(PurchaseReturnStatus status) => status switch
    {
        PurchaseReturnStatus.Posted => AlertTone.Success,
        PurchaseReturnStatus.Cancelled => AlertTone.Danger,
        PurchaseReturnStatus.Confirmed => AlertTone.Warning,
        _ => AlertTone.Info
    };

    private sealed class ReturnLineForm(PurchaseReceiptLineDto line, decimal remaining)
    {
        public PurchaseReceiptLineDto Line { get; } = line;
        public decimal Remaining { get; } = remaining;
        public bool Selected { get; set; }
        public string QuantityText { get; set; } = remaining > 0m ? Math.Min(remaining, line.AcceptedQuantity).ToString("0.###") : "0";
    }
}
