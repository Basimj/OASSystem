@page "/purchases/receipt-follow-ups"
@attribute [Authorize]
@using OAS.Contracts.Purchasing.PurchaseReceipts
@using OAS.Client.Services.Http
@inject OasApiClient Api

<PageTitle>متابعة تكامل الاستلام | OAS</PageTitle>
<div class="container-fluid py-3" dir="rtl">
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
        <div><h1 class="h5 mb-1">متابعة تحديثات استلام المشتريات</h1>
        <small class="text-muted">المهام المستقلة لطلبات العملاء والمعمل، دون إعادة ترحيل القيد أو المخزون.</small></div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="/purchases/receipts">سندات الاستلام</a>
            <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="LoadAsync">تحديث</button>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-end">
        <div><label class="form-label" for="receipt-job-id">رقم سند الاستلام (اختياري)</label>
            <input id="receipt-job-id" class="form-control form-control-sm" @bind="_receiptId" placeholder="GUID" /></div>
        <div><label class="form-label" for="receipt-job-status">الحالة</label>
            <select id="receipt-job-status" class="form-select form-select-sm" @bind="_status">
                <option value="">جميع الحالات</option><option value="1">بانتظار المعالجة</option>
                <option value="2">قيد المعالجة</option><option value="3">مكتمل</option>
                <option value="4">فشل قابل لإعادة المحاولة</option><option value="5">يحتاج تدخلاً يدويًا</option>
            </select></div>
        <button class="btn btn-outline-primary btn-sm" disabled="@_busy" @onclick="ApplyAsync">بحث</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger">@_error</div> }
    @if (!string.IsNullOrWhiteSpace(_message)) { <div class="alert alert-info">@_message</div> }
    @if (_busy) { <p>جارٍ تحميل المهام...</p> }
    @if (_result is not null)
    {
        <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
          <thead><tr><th>الاستلام</th><th>الهدف</th><th>طلب العميل / طلب الشراء</th>
          <th>الحالة</th><th>المحاولات</th><th>المحاولة التالية (UTC)</th><th>سبب الفشل</th><th>إجراء</th></tr></thead>
          <tbody>
          @foreach (var x in _result.Items)
          {
            <tr>
              <td><a href="@($"/purchases/receipts?openId={x.PurchaseReceiptId:D}")">@x.ReceiptCode</a></td>
              <td>@(x.TargetKind == 1 ? "طلب عميل" : "بديل مواد معمل")</td>
              <td>@(x.CustomerOrderId?.ToString("D") ?? x.PurchaseRequestLineId?.ToString("D"))</td>
              <td>@StatusText(x.Status)</td><td>@x.AttemptCount</td>
              <td>@x.NextAttemptAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
              <td>@(x.LastErrorCode is null ? "—" : x.LastErrorCode + " / " + x.LastErrorSummary)</td>
              <td>@if (x.Status is 4 or 5)
              {<button class="btn btn-outline-warning btn-sm" disabled="@_busy" @onclick="() => RetryAsync(x.Id)">إعادة المحاولة</button>}</td>
            </tr>
          }
          </tbody>
        </table></div>
        @if (_result.TotalCount == 0) { <p class="text-muted">لا توجد مهام مطابقة.</p> }
        <div class="d-flex gap-3 align-items-center justify-content-center">
          <button class="btn btn-outline-secondary btn-sm" disabled="@(_page <= 1 || _busy)" @onclick="PreviousAsync">السابق</button>
          <span>صفحة @_page — عدد المهام @_result.TotalCount</span>
          <button class="btn btn-outline-secondary btn-sm" disabled="@(_page * 50 >= _result.TotalCount || _busy)" @onclick="NextAsync">التالي</button>
        </div>
    }
</div>
@code {
    private string? _receiptId;
    private string? _status;
    private string? _error;
    private string? _message;
    private bool _busy;
    private int _page = 1;
    private PurchaseReceiptFollowUpPageDto? _result;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task ApplyAsync() { _page = 1; await LoadAsync(); }
    private async Task PreviousAsync() { --_page; await LoadAsync(); }
    private async Task NextAsync() { ++_page; await LoadAsync(); }
    private async Task LoadAsync()
    {
        _error = null; _busy = true;
        try
        {
            var url = $"api/purchasing/receipt-follow-ups?pageNumber={_page}&pageSize=50";
            if (!string.IsNullOrWhiteSpace(_receiptId))
            {
                if (!Guid.TryParse(_receiptId, out var id))
                { _error = "رقم سند الاستلام غير صحيح."; return; }
                url += "&purchaseReceiptId=" + id.ToString("D");
            }
            if (byte.TryParse(_status, out var status)) url += "&status=" + status;
            _result = await Api.GetAsync<PurchaseReceiptFollowUpPageDto>(url);
        }
        catch (Exception e) { _error = "تعذر تحميل سجل المتابعة: " + e.Message; }
        finally { _busy = false; }
    }
    private async Task RetryAsync(Guid id)
    {
        _busy = true; _error = null; _message = null;
        try
        {
            await Api.PostAsync($"api/purchasing/receipt-follow-ups/{id:D}/retry");
            _message = "تمت إعادة المهمة إلى قائمة الانتظار، دون إعادة ترحيل الاستلام.";
        }
        catch (Exception e) { _error = "تعذر إعادة المحاولة: " + e.Message; }
        finally { _busy = false; }
        await LoadAsync();
    }
    private static string StatusText(byte status) => status switch
    {
        1 => "بانتظار التنفيذ", 2 => "قيد التنفيذ", 3 => "مكتمل",
        4 => "فشل مؤقت", 5 => "متوقف للمراجعة", _ => "غير معروف"
    };
}
