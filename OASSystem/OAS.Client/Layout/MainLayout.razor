@inherits LayoutComponentBase

@inject IAuthClientService AuthService
@inject OasAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS


<AuthorizeView>

    <Authorized Context="authContext">

        <OasMainShell IsAdministrator="@authContext.User.IsInRole("Administrator")"
                      OnLogout="LogoutAsync">

            @Body

        </OasMainShell>

    </Authorized>


    <NotAuthorized>

        @Body

    </NotAuthorized>

</AuthorizeView>


@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await JS.InvokeVoidAsync("hideOasStartup");

        var state = await AuthState.GetAuthenticationStateAsync();

        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);

        if (state.User.Identity?.IsAuthenticated == true &&
            AuthState.CurrentUser?.MustChangePassword == true &&
            !relative.StartsWith(
                "identity/change-password",
                StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(
                "/identity/change-password",
                replace: true);
        }
    }


    private async Task LogoutAsync(MouseEventArgs _)
    {
        try
        {
            await AuthService.LogoutAsync();
        }
        finally
        {
            AuthState.SetAnonymous();

            Navigation.NavigateTo(
                "/login",
                replace: true);
        }
    }
}