@namespace OAS.Client.Sales.Components
@using OAS.Client.Accounting.Services
@using OAS.Client.Common.Feedback.Services
@using OAS.Client.Services.Http
@using OAS.Client.Sales.Services
@using OAS.Client.Database.State
@using System.Text.Json
@using Microsoft.JSInterop
@using OAS.Contracts.Accounting.BankAccounts
@using OAS.Contracts.Accounting.CashAccounts
@using OAS.Contracts.Accounting.Currencies
@using OAS.Contracts.Common.Pagination
@using OAS.Contracts.Sales.Returns
@using OAS.UiLib.Services.Dialogs
@inject OasApiClient Api
@inject IJSRuntime Js
@inject DatabaseProfileSelectionState DatabaseProfile
@inject IAccountingClientService Accounting
@inject IUiDialogService Dialog
@inject IApiFeedbackService ApiFeedback

<div class="oas-return-refund" dir="rtl">
    @if (_loading)
    {
        <p role="status">جارٍ التحقق من الرصيد والصناديق والحسابات...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="oas-return-refund__error" role="alert">@_loadError</div>
        <button class="oas-return-refund__secondary" type="button" @onclick="LoadAsync">إعادة المحاولة</button>
    }
    else
    {
        <div class="oas-return-refund__summary">
            <div><small>المرتجع</small><strong>@ReturnCode</strong></div>
            <div><small>الرصيد المتاح للاسترداد</small><strong>@AvailableBase.ToString("N2") @BaseCurrencyCode</strong></div>
            <div><small>الاستردادات المسجلة سابقًا</small><strong>@RefundedBase.ToString("N2") @BaseCurrencyCode</strong></div>
        </div>
        @if (!_storageReady)
        {
            <div class="oas-return-refund__error" role="alert">لا يمكن تأمين مفتاح الاسترداد في المتصفح. لم يُرسل أي طلب صرف؛ تحقق من تخزين المتصفح أو تواصل مع الدعم.</div>
        }
        else if (_pending is { } pending)
        {
            <div class="oas-return-refund__notice" role="status">
                توجد تسوية سابقة لم نتأكد من نتيجتها بعد (@(pending.Kind == "refund" ? "رد مبلغ" : "تطبيق رصيد")).
                لا تنشئ استردادًا جديدًا قبل التحقق. يُحتفظ بمعرف الطلب الأصلي حتى بعد إغلاق النافذة أو تحديث الصفحة.
            </div>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="oas-return-refund__error" role="alert">@_error</div>
            }
        }
        else if (AvailableBase <= 0m)
        {
            <div class="oas-return-refund__notice" role="status">لا يوجد رصيد دائن متاح لهذا المرتجع. لا يمكن صرف مبلغ جديد للعميل.</div>
        }
        else
        {
            <div class="oas-return-refund__fields">
                <label>طريقة رد المبلغ
                    <select value="@_method" disabled="@(_busy || _review)" @onchange="ChangeMethod">
                        <option value="1">نقدًا — من الصندوق</option>
                        <option value="3">تحويل بنكي</option>
                    </select>
                </label>
                <label>عملة الاسترداد
                    <select value="@_currencyId" disabled="@(_busy || _review)" @onchange="ChangeCurrency">
                        <option value="@Guid.Empty">اختر العملة</option>
                        @foreach (var c in _currencies.Where(x => x.IsActive))
                        {
                            <option value="@c.Id">@c.Code — @c.NameAr</option>
                        }
                    </select>
                </label>
                @if (_method == 1)
                {
                    <label>صندوق الصرف
                        <select @bind="_cashAccountId" disabled="@(_busy || _review)">
                            <option value="@Guid.Empty">اختر الصندوق</option>
                            @foreach (var x in AvailableCashAccounts)
                            {
                                <option value="@x.Id">@x.Code — @x.Name</option>
                            }
                        </select>
                        @if (_currencyId != Guid.Empty && AvailableCashAccounts.Count == 0)
                        {
                            <small class="oas-return-refund__help">لا يوجد صندوق نشط مرتبط بهذه العملة.</small>
                        }
                    </label>
                }
                else
                {
                    <label>الحساب البنكي
                        <select @bind="_bankAccountId" disabled="@(_busy || _review)">
                            <option value="@Guid.Empty">اختر الحساب البنكي</option>
                            @foreach (var x in AvailableBankAccounts)
                            {
                                <option value="@x.Id">@x.Code — @x.BankName (@x.AccountName)</option>
                            }
                        </select>
                        @if (_currencyId != Guid.Empty && AvailableBankAccounts.Count == 0)
                        {
                            <small class="oas-return-refund__help">لا يوجد حساب بنكي نشط مرتبط بهذه العملة.</small>
                        }
                    </label>
                }
                <label>المبلغ المراد رده
                    <input type="number" min="0.01" step="0.01" @bind="_amount" disabled="@(_busy || _review)" />
                </label>
            </div>
            @if (_review)
            {
                <div class="oas-return-refund__review" role="status">
                    <strong>مراجعة عملية الاسترداد</strong>
                    <div>سيتم صرف <b>@_amount.ToString("N2") @SelectedCurrencyCode</b> للعميل عن طريق @(_method == 1 ? "الصندوق" : "البنك").</div>
                    <div>القيمة المحاسبية: <b>@_baseAmount.ToString("N2") @BaseCurrencyCode</b></div>
                    <div>المتبقي المتوقع بعد الصرف: <b>@(Math.Max(0m, AvailableBase - _baseAmount).ToString("N2")) @BaseCurrencyCode</b></div>
                    <p>عند التأكيد سيُنشئ النظام سند صرف مرحّلًا. لا تكرر العملية إذا لم تتأكد من النتيجة؛ استخدم زر إعادة المحاولة نفسه.</p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="oas-return-refund__error" role="alert">@_error</div>
            }
        }
    }
    <div class="oas-return-refund__actions">
        <button type="button" class="oas-return-refund__secondary" disabled="@_busy" @onclick="CloseAsync">إغلاق</button>
        @if (_pending is not null && _storageReady)
        {
            <button type="button" class="oas-return-refund__secondary" disabled="@_busy" @onclick="() => CheckPendingAsync(true)">التحقق من نتيجة العملية</button>
            <button type="button" class="oas-return-refund__primary" disabled="@_busy" @onclick="RetryPendingAsync">إعادة إرسال الطلب نفسه</button>
            @if (_canDiscardRejected)
            {
                <button type="button" class="oas-return-refund__secondary" disabled="@_busy" @onclick="DiscardRejectedAsync">إلغاء الطلب المرفوض بعد التحقق</button>
            }
        }
        else if (_storageReady && !_loading && string.IsNullOrWhiteSpace(_loadError) && AvailableBase > 0m)
        {
            @if (_review)
            {
                <button type="button" class="oas-return-refund__secondary" disabled="@_busy" @onclick="Edit">تعديل البيانات</button>
                <button type="button" class="oas-return-refund__primary" disabled="@_busy" @onclick="ConfirmRefundAsync">
                    @(_busy ? "جارٍ تنفيذ الاسترداد..." : "تأكيد رد المبلغ وإنشاء سند صرف")
                </button>
            }
            else
            {
                <button type="button" class="oas-return-refund__primary" disabled="@_busy" @onclick="ReviewAsync">مراجعة المبلغ قبل الصرف</button>
            }
        }
    </div>
</div>

@code {
    [Parameter] public Guid CustomerId { get; set; }
    [Parameter] public Guid SalesReturnId { get; set; }
    [Parameter] public string ReturnCode { get; set; } = string.Empty;

    private CustomerCreditBalanceDto? _balance;
    private IReadOnlyList<CurrencyDto> _currencies = [];
    private IReadOnlyList<CashAccountDto> _cash = [];
    private IReadOnlyList<BankAccountDto> _banks = [];
    private Guid _currencyId, _cashAccountId, _bankAccountId;
    private byte _method = 1;
    private decimal _amount, _baseAmount;
    private bool _loading, _busy, _review, _storageReady, _canDiscardRejected;
    private string? _error, _loadError;
    private CustomerCreditPendingOperation? _pending;

    // Use the SAME browser snapshot as the customer's credit workspace. This blocks
    // a fresh settlement from either screen until the previous result is reconciled.
    private string PendingStorageKey =>
        CustomerCreditPendingOperation.StorageKeyFor(CustomerId, DatabaseProfile.SelectedProfileKey);
    private CustomerReturnCreditItemDto? Credit => _balance?.Returns.FirstOrDefault(x => x.SalesReturnId == SalesReturnId);
    private decimal UsedBase => _balance?.Applications.Where(x => x.SalesReturnId == SalesReturnId && x.Status == 1)
        .Sum(x => x.AppliedSourceBaseAmount) ?? 0m;
    private decimal AvailableBase => Credit is { } credit ? Math.Max(0m, credit.EstimatedUnappliedBaseCredit - UsedBase) : 0m;
    private decimal RefundedBase => _balance?.Applications.Where(x => x.SalesReturnId == SalesReturnId && x.Status == 1 && x.SettlementKind == 2)
        .Sum(x => x.AppliedSourceBaseAmount) ?? 0m;
    private string BaseCurrencyCode => Credit?.BaseCurrencyCode ?? "";
    private string SelectedCurrencyCode => _currencies.FirstOrDefault(x => x.Id == _currencyId)?.Code ?? "";
    private IReadOnlyList<CashAccountDto> AvailableCashAccounts => _cash.Where(x => x.IsActive && x.CurrencyId == _currencyId).ToArray();
    private IReadOnlyList<BankAccountDto> AvailableBankAccounts => _banks.Where(x => x.IsActive && x.CurrencyId == _currencyId).ToArray();

    protected override async Task OnInitializedAsync()
    {
        await RestorePendingAsync();
        await LoadAsync();
        if (_storageReady && _pending is not null)
            await CheckPendingAsync(false);
    }

    private async Task RestorePendingAsync()
    {
        _pending = null;
        _storageReady = false;
        try
        {
            var json = await Js.InvokeAsync<string?>("localStorage.getItem", PendingStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var restored = JsonSerializer.Deserialize<CustomerCreditPendingOperation>(json);
                if (restored?.IsValidFor(CustomerId) != true)
                    throw new JsonException("Invalid pending customer settlement snapshot.");
                _pending = restored;
            }
            _storageReady = true;
        }
        catch (Exception ex) when (ex is JSException or JsonException or InvalidOperationException)
        {
            _error = "تعذر استعادة عملية مالية معلّقة. أُوقف الصرف حفاظًا على الرصيد؛ تواصل مع الدعم.";
        }
    }

    private async Task SavePendingAsync(CustomerCreditPendingOperation pending)
    {
        // Re-read immediately before saving so an existing pending operation from
        // the customer credit workspace is never knowingly overwritten.
        await RestorePendingAsync();
        if (!_storageReady)
            throw new InvalidOperationException("Browser storage is unavailable.");
        if (_pending is not null)
            throw new InvalidOperationException("A customer credit settlement is already pending.");
        if (!pending.IsValidFor(CustomerId))
            throw new InvalidOperationException("Invalid refund snapshot.");
        await Js.InvokeVoidAsync("localStorage.setItem", PendingStorageKey,
            JsonSerializer.Serialize(pending));
        _pending = pending;
        _canDiscardRejected = false;
    }

    private Task<CustomerCreditSettlementDto?> LookupPendingAsync(CustomerCreditPendingOperation pending) =>
        Api.GetAsync<CustomerCreditSettlementDto>(
            $"api/sales/customer-credits/{CustomerId:D}/operations/{pending.IdempotencyKey}");

    private async Task FinishPendingAsync(CustomerCreditSettlementDto result)
    {
        await Js.InvokeVoidAsync("localStorage.removeItem", PendingStorageKey);
        _pending = null;
        _canDiscardRejected = false;
        Dialog.Close(result);
    }

    private async Task SendPendingAsync(CustomerCreditPendingOperation pending)
    {
        var result = pending.Kind == "refund"
            ? await Api.PostAsync<RefundCustomerReturnCreditRequest, CustomerCreditSettlementDto>(
                $"api/sales/customer-credits/{CustomerId:D}/refund", pending.Refund!)
            : await Api.PostAsync<ApplyCustomerReturnCreditRequest, CustomerCreditSettlementDto>(
                $"api/sales/customer-credits/{CustomerId:D}/apply", pending.Apply!);
        if (result is null)
            throw new InvalidOperationException("No confirmation received for the settlement.");
        await FinishPendingAsync(result);
    }

    private async Task CheckPendingAsync(bool notify)
    {
        if (_busy || _pending is null || !_storageReady) return;
        _busy = true;
        try
        {
            var result = await LookupPendingAsync(_pending);
            if (result is not null) await FinishPendingAsync(result);
            else if (notify) _error = "لا توجد تسوية مكتملة بهذا المفتاح حتى الآن. يمكنك إعادة إرسال الطلب نفسه فقط.";
        }
        catch (Exception ex)
        {
            _error = "تعذر التحقق من نتيجة التسوية. لا ترسل عملية مالية جديدة.";
            if (ex is ApiClientException apiEx) ApiFeedback.Show(apiEx.Error);
            else ApiFeedback.ShowUnexpected();
        }
        finally { _busy = false; }
    }

    private async Task RetryPendingAsync()
    {
        if (_busy || _pending is null || !_storageReady) return;
        _busy = true;
        _error = null;
        _canDiscardRejected = false;
        try
        {
            var pending = _pending;
            var existing = await LookupPendingAsync(pending);
            if (existing is not null) await FinishPendingAsync(existing);
            else await SendPendingAsync(pending); // Replay identical payload; do not revalidate spent balance.
        }
        catch (Exception ex) { await HandlePendingFailureAsync(ex); }
        finally { _busy = false; }
    }

    private async Task HandlePendingFailureAsync(Exception ex)
    {
        _error = "نتيجة التسوية غير مؤكدة. حُفظت البيانات والمفتاح؛ تحقق من النتيجة أو أعد إرسال الطلب نفسه.";
        if (ex is ApiClientException apiEx && apiEx.Error.Status is 400 or 409 or 422 && _pending is not null)
        {
            try
            {
                var result = await LookupPendingAsync(_pending);
                if (result is not null) { await FinishPendingAsync(result); return; }
                _canDiscardRejected = true;
                _error = "رفض الخادم الطلب دون تسجيل تسوية. يمكنك إلغاء الطلب المرفوض بعد مراجعة النتيجة.";
            }
            catch { /* Keep the operation pending when its status is uncertain. */ }
        }
        if (ex is ApiClientException reported) ApiFeedback.Show(reported.Error);
        else ApiFeedback.ShowUnexpected();
    }

    private async Task DiscardRejectedAsync()
    {
        if (_busy || !_canDiscardRejected || _pending is null) return;
        _busy = true;
        try
        {
            var existing = await LookupPendingAsync(_pending);
            if (existing is not null) { await FinishPendingAsync(existing); return; }
            if (!await Js.InvokeAsync<bool>("confirm", "رفض الخادم الطلب دون تسجيل تسوية. هل تريد إلغاء بيانات المحاولة المرفوضة؟")) return;
            await Js.InvokeVoidAsync("localStorage.removeItem", PendingStorageKey);
            _pending = null;
            _canDiscardRejected = false;
            _review = false;
            _error = null;
            await LoadAsyncAfterReleaseAsync();
        }
        catch { _error = "تعذر التحقق من التسوية المرفوضة؛ احتفظنا بها للحماية."; }
        finally { _busy = false; }
    }

    private async Task LoadAsyncAfterReleaseAsync()
    {
        // LoadAsync checks _busy; refresh balance directly while this operation owns the guard.
        _balance = await Api.GetAsync<CustomerCreditBalanceDto>($"api/sales/customer-credits/{CustomerId:D}");
    }

    private static async Task<IReadOnlyList<T>> LoadPagesAsync<T>(Func<PageRequest, Task<PagedResult<T>>> loader)
    {
        var list = new List<T>();
        for (var pageNo = 1; ; pageNo++)
        {
            var page = await loader(new PageRequest { PageNumber = pageNo, PageSize = PageRequest.MaximumPageSize });
            list.AddRange(page.Items);
            if (!page.HasNextPage) return list;
        }
    }

    private async Task LoadAsync()
    {
        if (_loading || _busy) return;
        _loading = true;
        _loadError = null;
        try
        {
            _balance = await Api.GetAsync<CustomerCreditBalanceDto>($"api/sales/customer-credits/{CustomerId:D}");
            _currencies = await LoadPagesAsync<CurrencyDto>(x => Accounting.GetCurrenciesPageAsync(x));
            _cash = await LoadPagesAsync<CashAccountDto>(x => Accounting.GetCashAccountsPageAsync(x));
            _banks = await LoadPagesAsync<BankAccountDto>(x => Accounting.GetBankAccountsPageAsync(x));
            if (Credit is null) _loadError = "لم يُعثر على رصيد للمرتجع المحدد.";
            else if (_currencyId == Guid.Empty || !_currencies.Any(x => x.Id == _currencyId && x.IsActive))
                _currencyId = Credit.CurrencyId;
            if (Credit is not null && _currencyId == Credit.BaseCurrencyId && _amount == 0m)
                _amount = Math.Round(AvailableBase, _currencies.First(x => x.Id == _currencyId).DecimalPlaces, MidpointRounding.AwayFromZero);
            if (!AvailableCashAccounts.Any(x => x.Id == _cashAccountId)) _cashAccountId = Guid.Empty;
            if (!AvailableBankAccounts.Any(x => x.Id == _bankAccountId)) _bankAccountId = Guid.Empty;
        }
        catch (ApiClientException ex)
        {
            _loadError = ex.Error?.Message ?? "تعذر تحميل بيانات الاسترداد.";
            ApiFeedback.Show(ex.Error);
        }
        catch
        {
            _loadError = "تعذر تحميل الرصيد والصناديق. تحقق من الاتصال والصلاحيات.";
            ApiFeedback.ShowUnexpected();
        }
        finally { _loading = false; }
    }

    private void ChangeMethod(ChangeEventArgs e)
    {
        _method = byte.TryParse(e.Value?.ToString(), out var method) ? method : (byte)1;
        _cashAccountId = _bankAccountId = Guid.Empty;
        _error = null;
    }
    private void ChangeCurrency(ChangeEventArgs e)
    {
        _currencyId = Guid.TryParse(e.Value?.ToString(), out var currency) ? currency : Guid.Empty;
        _cashAccountId = _bankAccountId = Guid.Empty;
        _error = null;
    }
    private void Edit() { _review = false; _error = null; }
    private void CloseAsync() => Dialog.Cancel();
    private bool Reject(string error) { _error = error; return false; }

    private async Task ReviewAsync()
    {
        if (_busy || !_storageReady || _pending is not null) return;
        _busy = true;
        _error = null;
        try
        {
            // Reload the balance to include other cashiers' recent settlements.
            _balance = await Api.GetAsync<CustomerCreditBalanceDto>($"api/sales/customer-credits/{CustomerId:D}");
            if (Credit is null || AvailableBase <= 0m) { Reject("لا يوجد رصيد دائن متاح لهذا المرتجع."); return; }
            var currency = _currencies.FirstOrDefault(x => x.Id == _currencyId && x.IsActive);
            if (currency is null) { Reject("اختر عملة نشطة للاسترداد."); return; }
            if (_method == 1 && !AvailableCashAccounts.Any(x => x.Id == _cashAccountId)) { Reject("اختر صندوق صرف نشطًا مطابقًا للعملة."); return; }
            if (_method == 3 && !AvailableBankAccounts.Any(x => x.Id == _bankAccountId)) { Reject("اختر حسابًا بنكيًا نشطًا مطابقًا للعملة."); return; }
            if (_method is not (1 or 3)) { Reject("طريقة رد المبلغ غير صالحة."); return; }
            var original = _currencies.FirstOrDefault(x => x.Id == Credit.BaseCurrencyId);
            if (original is null) { Reject("تعذر تحديد العملة الأساسية للمرتجع."); return; }
            var rate = await Accounting.GetEffectiveExchangeRateAsync(_currencyId, DateOnly.FromDateTime(DateTime.UtcNow));
            if (rate is null || rate.Rate <= 0m) { Reject("لا يوجد سعر صرف محاسبي فعّال اليوم."); return; }
            var rounded = Math.Round(_amount, currency.DecimalPlaces, MidpointRounding.AwayFromZero);
            if (_amount != rounded || rounded <= 0m) { Reject("أدخل مبلغًا موجبًا بعدد المنازل العشرية المسموح للعملة."); return; }
            _baseAmount = Math.Round(rounded * rate.Rate, original.DecimalPlaces, MidpointRounding.AwayFromZero);
            if (_baseAmount <= 0m || _baseAmount > AvailableBase + 0.0001m)
            { Reject($"المبلغ بعد تحويل العملة ({_baseAmount:N2} {BaseCurrencyCode}) أكبر من الرصيد المتاح ({AvailableBase:N2})."); return; }
            _review = true;
        }
        catch (ApiClientException ex) { _error = ex.Error?.Message ?? "تعذر مراجعة مبلغ الاسترداد."; ApiFeedback.Show(ex.Error); }
        catch { _error = "تعذر مراجعة مبلغ الاسترداد. حاول مجددًا."; ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private async Task ConfirmRefundAsync()
    {
        if (_busy || !_review || Credit is null || AvailableBase <= 0m || !_storageReady || _pending is not null) return;
        _busy = true;
        _error = null;
        try
        {
            var currency = _currencies.First(x => x.Id == _currencyId);
            var rounded = Math.Round(_amount, currency.DecimalPlaces, MidpointRounding.AwayFromZero);
            var pending = new CustomerCreditPendingOperation(CustomerId, "refund", null,
                new RefundCustomerReturnCreditRequest(SalesReturnId, _currencyId, rounded, _method,
                    _method == 1 ? _cashAccountId : null, _method == 3 ? _bankAccountId : null,
                    null, null, $"رد رصيد المرتجع {ReturnCode}", Guid.NewGuid().ToString("N")));
            // Persist BEFORE POST so closing this dialog or F5 cannot lose the key.
            await SavePendingAsync(pending);
            await SendPendingAsync(pending);
        }
        catch (Exception ex) { await HandlePendingFailureAsync(ex); }
        finally { _busy = false; }
    }
}
