@page "/sales/order-tracking"
@attribute [Authorize]
@namespace OAS.Client.Sales.OrderTracking.Pages
@using OAS.UiLib.Components.Sales.OrderTracking

<UiCustomerOrderOperationsSurface Filter="@_filter"
                                  Metrics="@_metrics"
                                  Rows="@_rows"
                                  Selected="@_selected"
                                  IsBusy="@State.IsBusy"
                                  SearchWarehousesAsync="SearchWarehousesAsync"
                                  SearchTechniciansAsync="SearchTechniciansAsync"
                                  PageNumber="@State.Page.PageNumber"
                                  TotalPages="@State.Page.TotalPages"
                                  TotalCount="@State.Page.TotalCount"
                                  OnApplyFilters="ApplyFiltersAsync"
                                  OnClearFilters="ClearFiltersAsync"
                                  OnTabSelected="TabSelectedAsync"
                                  OnMetricSelected="MetricSelectedAsync"
                                  OnOpen="OpenAsync"
                                  OnCloseDetails="CloseDetailsAsync"
                                  OnDeliver="OpenDeliveryAsync"
                                  OnOpenSupply="OpenSupplyAsync"
                                  OnOpenJob="OpenJobAsync"
                                  OnPrevious="PreviousAsync"
                                  OnNext="NextAsync" />

