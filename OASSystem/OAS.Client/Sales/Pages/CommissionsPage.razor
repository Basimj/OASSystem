@page "/sales/commissions"
@attribute [Authorize]
@using OAS.Client.Features.Employees.Services
@using OAS.Contracts.Features.Employees
@using OAS.Contracts.Sales.Commissions
@using OAS.Contracts.Sales.Enums
@using OAS.Contracts.Sales.Lookups
@using OAS.Client.Common.Feedback.Services
@using OAS.Client.Services.Http
@using OAS.UiLib.Services.Feedback
@inject ISalesClientService Sales
@inject OasApiClient Api
@inject IUiSnackbarService Snackbar
@inject IApiFeedbackService ApiFeedback
@inject IEmployeeClientService Employees

<PageTitle>العمولات | OAS</PageTitle>

<UiWorkspaceLayout ShowAside="@(_showRuleEditor || _showStatementEditor || _selectedStatement is not null)" ShowFilters="false">
    <Actions>
        <UiWorkspaceActionBar>
            @if (_mode == StatementsMode)
            {
                <UiButton Text="احتساب دورة" IconCssClass="fa-solid fa-calculator" Size="ControlSize.Small" OnClick="BeginStatementAsync" />
                @if (_selectedStatement is { Status: CommissionStatementStatus.Calculated })
                {
                    <UiButton Text="مراجعة الدورة" IconCssClass="fa-solid fa-magnifying-glass-check" Size="ControlSize.Small" Loading="@_busy" OnClick="ReviewAsync" />
                }
                else if (_selectedStatement is { Status: CommissionStatementStatus.Reviewed })
                {
                    <UiButton Text="الموافقة على الدورة" IconCssClass="fa-solid fa-check-double" Size="ControlSize.Small" Loading="@_busy" OnClick="ApproveAsync" />
                }
                else if (_selectedStatement is { Status: CommissionStatementStatus.Approved })
                {
                    <UiButton Text="تسوية وإغلاق" IconCssClass="fa-solid fa-lock" Size="ControlSize.Small" Loading="@_busy" OnClick="SettleAsync" />
                }
            }
            else
            {
                <UiButton Text="قاعدة عمولة جديدة" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small" OnClick="BeginRuleAsync" />
            }
            <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Loading="@_busy" OnClick="RefreshAsync" />
        </UiWorkspaceActionBar>
    </Actions>
    <Tabs><UiSectionTabStrip Tabs="@Tabs" OnSelect="SetModeAsync" /></Tabs>

    <Content>
        @if (_mode == StatementsMode)
        {
            <UiDataGridPanel Title="دورات العمولات" Subtitle="@($"{_statements.Count} دورة")">
                <Body>
                    <UiStackLayout Gap="StackGap.Small">
                        @if (_statements.Count == 0)
                        {
                            <UiAlert Message="لا توجد دورات عمولات حتى الآن." Tone="AlertTone.Info" />
                        }
                        @foreach (var item in _statements.OrderByDescending(x => x.ToDate).ThenByDescending(x => x.StatementCode))
                        {
                            <UiRecordRow Title="@item.StatementCode"
                                         Subtitle="@($"{item.EmployeeName ?? item.EmployeeId.ToString("D")} • {item.FromDate:yyyy-MM-dd} إلى {item.ToDate:yyyy-MM-dd}")"
                                         Selected="@(_selectedStatement?.Id == item.Id)"
                                         OnClick="@(() => SelectStatementAsync(item.Id))">
                                <Content><UiKeyValue Label="صافي العمولة" Value="@item.CommissionBaseAmount.ToString("N2")" /></Content>
                                <Trailing><UiBadge Text="@StatementStatusText(item.Status)" Tone="@StatementTone(item.Status)" /></Trailing>
                            </UiRecordRow>
                        }
                    </UiStackLayout>
                </Body>
            </UiDataGridPanel>
        }
        else
        {
            <UiDataGridPanel Title="قواعد العمولات" Subtitle="@($"{_rules.Count} قاعدة")">
                <Body>
                    <UiStackLayout Gap="StackGap.Small">
                        @if (_rules.Count == 0)
                        {
                            <UiAlert Message="لا توجد قواعد عمولات." Tone="AlertTone.Info" />
                        }
                        @foreach (var rule in _rules.OrderByDescending(x => x.Priority).ThenByDescending(x => x.EffectiveFrom).ThenBy(x => x.Code))
                        {
                            <UiRecordRow Title="@($"{rule.Code} - {rule.Name}")"
                                         Subtitle="@(rule.EmployeeName ?? "قاعدة عامة لجميع الموظفين المؤهلين")">
                                <Content>
                                    <UiGrid Columns="3">
                                        <UiKeyValue Label="النسبة" Value="@($"{rule.RatePercent:N2}%")" />
                                        <UiKeyValue Label="الأولوية" Value="@rule.Priority.ToString()" />
                                        <UiKeyValue Label="أساس الاحتساب" Value="@BasisText(rule.BasisKind)" />
                                        <UiKeyValue Label="نوع البيع" Value="@(rule.SaleType?.ToString() ?? "الكل")" />
                                        <UiKeyValue Label="من" Value="@rule.EffectiveFrom.ToString("yyyy-MM-dd")" />
                                        <UiKeyValue Label="إلى" Value="@(rule.EffectiveTo?.ToString("yyyy-MM-dd") ?? "مفتوحة")" />
                                    </UiGrid>
                                </Content>
                                <Trailing><UiBadge Text="@(rule.IsActive ? "نشطة" : "غير نشطة")" Tone="@(rule.IsActive ? AlertTone.Success : AlertTone.Warning)" /></Trailing>
                            </UiRecordRow>
                        }
                    </UiStackLayout>
                </Body>
            </UiDataGridPanel>
        }
    </Content>

    <Aside>
        @if (_showRuleEditor)
        {
            <UiCard Title="قاعدة عمولة جديدة" Subtitle="الأكثر أولوية ثم الأكثر تخصيصًا هو الذي يطبق.">
                <UiStackLayout Gap="StackGap.Small">
                    <UiInputText Label="الكود" Value="@_ruleCode" ValueChanged="@(v => _ruleCode = v)" Size="ControlSize.Small" MaxLength="40" />
                    <UiInputText Label="الاسم" Value="@_ruleName" ValueChanged="@(v => _ruleName = v)" Size="ControlSize.Small" MaxLength="160" />
                    <UiSelect Label="الموظف" Placeholder="جميع الموظفين" Value="@_ruleEmployeeId" ValueChanged="@(v => _ruleEmployeeId = v)" Options="@EmployeeOptions" Size="ControlSize.Small" />
                    <UiSelect Label="فئة المنتج" Placeholder="جميع الفئات" Value="@_ruleCategoryId" ValueChanged="@(v => _ruleCategoryId = v)" Options="@CategoryOptions" Size="ControlSize.Small" />
                    <UiSelect Label="المنتج / المتغير" Placeholder="جميع المنتجات" Value="@_ruleVariantId" ValueChanged="@(v => _ruleVariantId = v)" Options="@VariantOptions" Size="ControlSize.Small" />
                    <UiSelect Label="نوع البيع" Placeholder="جميع الأنواع" Value="@_ruleSaleType" ValueChanged="@(v => _ruleSaleType = v)" Options="@SaleTypeOptions" Size="ControlSize.Small" />
                    <UiSelect Label="أساس العمولة" Value="@_ruleBasis" ValueChanged="@(v => _ruleBasis = v)" Options="@BasisOptions" Size="ControlSize.Small" />
                    <UiGrid Columns="2">
                        <UiInputText Label="نسبة العمولة %" Value="@_rateText" ValueChanged="@(v => _rateText = v ?? string.Empty)" InputMode="decimal" Size="ControlSize.Small" />
                        <UiInputText Label="الأولوية" Value="@_priorityText" ValueChanged="@(v => _priorityText = v ?? string.Empty)" InputMode="numeric" Size="ControlSize.Small" />
                    </UiGrid>
                    <UiGrid Columns="2">
                        <UiInputDate Label="سارية من" Value="@_ruleFrom" ValueChanged="@(v => _ruleFrom = v)" Size="ControlSize.Small" />
                        <UiInputDate Label="سارية إلى" Value="@_ruleTo" ValueChanged="@(v => _ruleTo = v)" Size="ControlSize.Small" />
                    </UiGrid>
                    <UiWorkspaceActionBar>
                        <UiButton Text="حفظ القاعدة" IconCssClass="fa-solid fa-floppy-disk" Loading="@_busy" Size="ControlSize.Small" OnClick="CreateRuleAsync" />
                        <UiButton Text="إلغاء" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="CloseEditorsAsync" />
                    </UiWorkspaceActionBar>
                </UiStackLayout>
            </UiCard>
        }
        else if (_showStatementEditor)
        {
            <UiCard Title="احتساب دورة عمولات" Subtitle="المرتجع اللاحق ينشئ عكسًا في الدورة الجديدة بنفس قاعدة ونسبة البيع الأصلية.">
                <UiStackLayout Gap="StackGap.Small">
                    <UiSelect Label="الموظف" Placeholder="اختر موظفًا مؤهلًا" Value="@_statementEmployeeId" ValueChanged="@(v => _statementEmployeeId = v)" Options="@EmployeeOptions" Size="ControlSize.Small" />
                    <UiGrid Columns="2">
                        <UiInputDate Label="من تاريخ" Value="@_statementFrom" ValueChanged="@(v => _statementFrom = v)" Size="ControlSize.Small" />
                        <UiInputDate Label="إلى تاريخ" Value="@_statementTo" ValueChanged="@(v => _statementTo = v)" Size="ControlSize.Small" />
                    </UiGrid>
                    <UiWorkspaceActionBar>
                        <UiButton Text="احتساب" IconCssClass="fa-solid fa-calculator" Loading="@_busy" Size="ControlSize.Small" OnClick="CalculateAsync" />
                        <UiButton Text="إلغاء" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="CloseEditorsAsync" />
                    </UiWorkspaceActionBar>
                </UiStackLayout>
            </UiCard>
        }
        else if (_selectedStatement is not null)
        {
            <UiCard Title="@_selectedStatement.StatementCode" Subtitle="@StatementStatusText(_selectedStatement.Status)">
                <UiStackLayout Gap="StackGap.Small">
                    <UiGrid Columns="2">
                        <UiKeyValue Label="الموظف" Value="@(_selectedStatement.EmployeeName ?? _selectedStatement.EmployeeId.ToString("D"))" />
                        <UiKeyValue Label="الفترة" Value="@($"{_selectedStatement.FromDate:yyyy-MM-dd} — {_selectedStatement.ToDate:yyyy-MM-dd}")" />
                        <UiKeyValue Label="مبيعات أساس" Value="@_selectedStatement.SalesBaseAmount.ToString("N2")" />
                        <UiKeyValue Label="مرتجعات أساس" Value="@_selectedStatement.ReturnsBaseAmount.ToString("N2")" />
                        <UiKeyValue Label="صافي العمولة" Value="@_selectedStatement.CommissionBaseAmount.ToString("N2")" />
                        <UiKeyValue Label="عدد المصادر" Value="@_selectedStatement.Entries.Count.ToString()" />
                    </UiGrid>
                    @foreach (var entry in _selectedStatement.Entries.OrderBy(x => x.SourceDate).ThenBy(x => x.SourceDocumentType))
                    {
                        <UiRecordRow Title="@($"{entry.SourceDocumentType} • {entry.SourceDate:yyyy-MM-dd}")"
                                     Subtitle="@($"{entry.RuleCodeSnapshot} - {entry.RuleNameSnapshot} • {BasisText(entry.BasisKindSnapshot)}")">
                            <Content>
                                <UiGrid Columns="3">
                                    <UiKeyValue Label="الأساس" Value="@entry.BaseSalesAmount.ToString("N2")" />
                                    <UiKeyValue Label="النسبة" Value="@($"{entry.RatePercent:N2}%")" />
                                    <UiKeyValue Label="العمولة" Value="@entry.CommissionBaseAmount.ToString("N2")" />
                                </UiGrid>
                            </Content>
                            <Trailing>@if (entry.IsReversal) { <UiBadge Text="عكس مرتجع" Tone="AlertTone.Warning" /> }</Trailing>
                        </UiRecordRow>
                    }
                </UiStackLayout>
            </UiCard>
        }
    </Aside>
</UiWorkspaceLayout>

@code {
    private const string StatementsMode = "statements";
    private const string RulesMode = "rules";
    private string _mode = StatementsMode;
    private IReadOnlyList<CommissionStatementDto> _statements = [];
    private IReadOnlyList<CommissionRuleDto> _rules = [];
    private IReadOnlyList<EmployeeDto> _employees = [];
    private IReadOnlyList<SalesProductCategoryLookupDto> _categories = [];
    private IReadOnlyList<SalesProductVariantLookupDto> _variants = [];
    private CommissionStatementDto? _selectedStatement;
    private bool _showRuleEditor;
    private bool _showStatementEditor;
    private bool _busy;

    private string? _ruleCode;
    private string? _ruleName;
    private string? _ruleEmployeeId;
    private string? _ruleCategoryId;
    private string? _ruleVariantId;
    private string? _ruleSaleType;
    private string? _ruleBasis = ((byte)CommissionBasisKind.NetAfterDiscountExcludingTax).ToString();
    private string _rateText = "1";
    private string _priorityText = "0";
    private DateOnly? _ruleFrom = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _ruleTo;
    private string? _statementEmployeeId;
    private DateOnly? _statementFrom = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly? _statementTo = DateOnly.FromDateTime(DateTime.Today);

    private IReadOnlyList<UiSectionTabItem> Tabs => [new(StatementsMode, "دورات العمولات", _mode == StatementsMode), new(RulesMode, "قواعد العمولات", _mode == RulesMode)];
    private IReadOnlyList<UiSelectOption> EmployeeOptions => _employees.Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.EmployeeCode} - {x.DisplayName}")).ToArray();
    private IReadOnlyList<UiSelectOption> CategoryOptions => _categories.Where(x => x.IsActive).Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.Code} - {x.Name}")).ToArray();
    private IReadOnlyList<UiSelectOption> VariantOptions => _variants.Where(x => x.IsActive).Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.SKU} - {x.ProductName}")).ToArray();
    private static IReadOnlyList<UiSelectOption> SaleTypeOptions => Enum.GetValues<SalesLineType>().Select(x => new UiSelectOption(((byte)x).ToString(), x.ToString())).ToArray();
    private static IReadOnlyList<UiSelectOption> BasisOptions => Enum.GetValues<CommissionBasisKind>().Select(x => new UiSelectOption(((byte)x).ToString(), BasisText(x))).ToArray();

    protected override async Task OnInitializedAsync()
    {
        _busy = true;
        try
        {
            var employeePage = await Employees.GetPageAsync(new PageRequest { PageNumber = 1, PageSize = 200, SortBy = "EmployeeCode" });
            _employees = employeePage.Items.Where(x => x.IsActive && x.IsCommissionEligible).ToArray();
            _categories = await Sales.SearchProductCategoriesAsync(null, null, 200);
            _variants = await Sales.SearchProductVariantsAsync(null, null, null, 200);
            await LoadDataAsync();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private async Task LoadDataAsync()
    {
        _rules = await Sales.GetCommissionRulesAsync();
        _statements = await Sales.GetCommissionStatementsAsync();
    }

    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            await LoadDataAsync();
            if (_selectedStatement is not null) _selectedStatement = await Sales.GetCommissionStatementAsync(_selectedStatement.Id);
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private Task SetModeAsync(string mode) { _mode = mode; _selectedStatement = null; _showRuleEditor = false; _showStatementEditor = false; return Task.CompletedTask; }
    private Task BeginRuleAsync()
    {
        _showRuleEditor = true; _showStatementEditor = false; _selectedStatement = null;
        _ruleCode = _ruleName = _ruleEmployeeId = _ruleCategoryId = _ruleVariantId = _ruleSaleType = null;
        _ruleBasis = ((byte)CommissionBasisKind.NetAfterDiscountExcludingTax).ToString();
        _rateText = "1"; _priorityText = "0"; _ruleFrom = DateOnly.FromDateTime(DateTime.Today); _ruleTo = null;
        return Task.CompletedTask;
    }
    private Task BeginStatementAsync()
    {
        _showStatementEditor = true; _showRuleEditor = false; _selectedStatement = null; _statementEmployeeId = null;
        _statementFrom = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1); _statementTo = DateOnly.FromDateTime(DateTime.Today);
        return Task.CompletedTask;
    }

    private async Task CreateRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_ruleCode) || string.IsNullOrWhiteSpace(_ruleName) || !_ruleFrom.HasValue)
        { Snackbar.Error("أدخل كود القاعدة واسمها وتاريخ بداية السريان."); return; }
        if (!decimal.TryParse(_rateText, out var rate) || rate < 0m || rate > 100m)
        { Snackbar.Error("نسبة العمولة يجب أن تكون رقمًا بين 0 و100."); return; }
        if (!int.TryParse(_priorityText, out var priority) || priority < 0 || priority > 10000)
        { Snackbar.Error("الأولوية يجب أن تكون بين 0 و10000."); return; }
        if (_ruleTo.HasValue && _ruleTo < _ruleFrom) { Snackbar.Error("تاريخ نهاية القاعدة لا يمكن أن يسبق البداية."); return; }

        Guid? employeeId = Guid.TryParse(_ruleEmployeeId, out var e) ? e : null;
        Guid? categoryId = Guid.TryParse(_ruleCategoryId, out var c) ? c : null;
        Guid? variantId = Guid.TryParse(_ruleVariantId, out var v) ? v : null;
        SalesLineType? saleType = byte.TryParse(_ruleSaleType, out var st) ? (SalesLineType?)st : null;
        var basis = byte.TryParse(_ruleBasis, out var b) ? (CommissionBasisKind)b : CommissionBasisKind.NetAfterDiscountExcludingTax;

        _busy = true;
        try
        {
            var request = new CreateCommissionRuleRequest(_ruleCode.Trim(), _ruleName.Trim(), employeeId, rate, _ruleFrom.Value, _ruleTo,
                variantId, categoryId, saleType, priority, basis);
            var call = await Sales.CreateCommissionRuleResultAsync(request);
            if (!TryGetApiResult(call, out _)) return;
            _showRuleEditor = false;
            Snackbar.Success("تم حفظ قاعدة العمولة.");
            await RefreshAsync();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private async Task CalculateAsync()
    {
        if (!Guid.TryParse(_statementEmployeeId, out var employeeId) || !_statementFrom.HasValue || !_statementTo.HasValue)
        { Snackbar.Error("اختر الموظف وحدد فترة الاحتساب."); return; }
        if (_statementTo < _statementFrom) { Snackbar.Error("تاريخ نهاية الفترة لا يمكن أن يسبق البداية."); return; }
        _busy = true;
        try
        {
            var call = await Sales.CalculateCommissionStatementResultAsync(new CalculateCommissionStatementRequest(employeeId, _statementFrom.Value, _statementTo.Value));
            if (!TryGetApiResult(call, out var result)) return;
            _showStatementEditor = false; _selectedStatement = result;
            Snackbar.Success("تم احتساب دورة العمولة.");
            await RefreshAsync();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private async Task SelectStatementAsync(Guid id)
    {
        _showStatementEditor = false; _showRuleEditor = false; _busy = true;
        try { _selectedStatement = await Sales.GetCommissionStatementAsync(id); }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private Task ReviewAsync() => TransitionAsync("review", "تمت مراجعة دورة العمولة.");
    private Task ApproveAsync() => TransitionAsync("approve", "تمت الموافقة على دورة العمولة.");
    private Task SettleAsync() => TransitionAsync("settle", "تمت تسوية وإغلاق دورة العمولة.");

    private async Task TransitionAsync(string action, string success)
    {
        if (_selectedStatement is null) return;
        _busy = true;
        try
        {
            var request = new CommissionStatementActionRequest(_selectedStatement.RowVersion);
            var call = await Api.PostResultAsync<CommissionStatementActionRequest, CommissionStatementDto>($"api/sales/commissions/statements/{_selectedStatement.Id:D}/{action}", request);
            if (!TryGetApiResult(call, out var result)) return;
            _selectedStatement = result;
            Snackbar.Success(success);
            await LoadDataAsync();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private bool TryGetApiResult<T>(ApiCallResult<T> result, out T? value)
    {
        value = result.Value;
        if (result.Succeeded) return true;
        if (result.Error is not null) ApiFeedback.Show(result.Error); else ApiFeedback.ShowUnexpected();
        return false;
    }

    private Task CloseEditorsAsync() { _showRuleEditor = false; _showStatementEditor = false; return Task.CompletedTask; }

    private static string BasisText(CommissionBasisKind basis) => basis switch
    {
        CommissionBasisKind.NetAfterDiscountExcludingTax => "الصافي بعد الخصم قبل الضريبة",
        CommissionBasisKind.GrossBeforeDiscount => "الإجمالي قبل الخصم",
        CommissionBasisKind.FinalIncludingTax => "الإجمالي شامل الضريبة",
        _ => basis.ToString()
    };

    private static string StatementStatusText(CommissionStatementStatus status) => status switch
    {
        CommissionStatementStatus.Draft => "مسودة",
        CommissionStatementStatus.Calculated => "محسوبة",
        CommissionStatementStatus.Reviewed => "تمت المراجعة",
        CommissionStatementStatus.Approved => "موافق عليها",
        CommissionStatementStatus.Settled => "مسواة ومغلقة",
        CommissionStatementStatus.Finalized => "معتمدة - قديم",
        CommissionStatementStatus.Cancelled => "ملغاة",
        _ => status.ToString()
    };

    private static AlertTone StatementTone(CommissionStatementStatus status) => status switch
    {
        CommissionStatementStatus.Settled or CommissionStatementStatus.Finalized => AlertTone.Success,
        CommissionStatementStatus.Approved or CommissionStatementStatus.Reviewed or CommissionStatementStatus.Calculated => AlertTone.Warning,
        CommissionStatementStatus.Cancelled => AlertTone.Danger,
        _ => AlertTone.Info
    };
}
