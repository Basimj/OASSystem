@page "/sales/reports"
@page "/reports/sales"
@attribute [Authorize]
@using OAS.Contracts.Sales.Reports
@using OAS.UiLib.Components.Reports
<PageTitle>المبيعات | OAS</PageTitle>
<div class="trial-report">
<UiReportWorkspace SearchDisplayOnly="true" Title="المبيعات" TitleIcon="fa-solid fa-chart-line" StatusText="@Status" Search="@_search" SearchChanged="OnSearch" FiltersOpen="@_filtersOpen" FiltersOpenChanged="@(v => _filtersOpen = v)">
    <Toolbar>
        <button type="button" class="oas-report__tool" title="تحديث" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-rotate"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--pdf" title="حفظ PDF لجميع نتائج الفلاتر (دون البحث)" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-regular fa-file-pdf"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--excel" title="Excel — جميع نتائج الفلاتر (دون البحث)" disabled="@(!CanExport)" @onclick="ExportAsync"><i class="fa-regular fa-file-excel"></i></button>
        <button type="button" class="oas-report__tool" title="طباعة جميع نتائج الفلاتر (دون البحث)" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-solid fa-print"></i></button>
        <button type="button" class="oas-report__tool" title="إظهار أو إخفاء الفلاتر" @onclick="@(() => _filtersOpen = !_filtersOpen)"><i class="fa-solid fa-ellipsis-vertical"></i></button>
    </Toolbar>
    <QuickFilters>
        @foreach(var chip in Chips){<div class="oas-report__chip" title="@chip"><strong>@chip</strong></div>}
    </QuickFilters>
    <FilterPanel>
        <div class="trial-fields">
            <label class="oas-report__field">نوع التقرير<select @bind="_draft.Mode" @bind:after="ModeChanged">@foreach(var m in Modes){<option value="@m.Key">@m.Value</option>}</select></label>
            @if (_draft.Mode == "Period")
            { <label class="oas-report__field">التجميع الزمني<select @bind="_draft.PeriodGrouping"><option value="Day">يومي</option><option value="Month">شهري</option><option value="Year">سنوي</option></select></label> }
            <label class="oas-report__field">السنة المالية<select value="@_draft.Year" @onchange="OnYear" disabled="@_busy"><option value="">نطاق مخصص</option>@foreach(var y in _years){<option value="@y.Id">@y.Name</option>}</select></label>
            <label class="oas-report__field">الفترة المالية<select value="@_draft.Period" @onchange="OnPeriod" disabled="@(_busy || string.IsNullOrEmpty(_draft.Year) || !PeriodOptions.Any())"><option value="">جميع الفترات</option>@foreach(var p in PeriodOptions){<option value="@p.Id">@p.Name</option>}</select></label>
            @if (_referenceWarning is not null) { <div class="trial-warning">@_referenceWarning</div> }
            <div class="oas-report__date-pair">
                <label class="oas-report__field">من تاريخ<input type="date" @bind="_draft.From" @bind:format="yyyy-MM-dd" disabled="@(!string.IsNullOrEmpty(_draft.Year))" /></label>
                <label class="oas-report__field">إلى تاريخ<input type="date" @bind="_draft.To" @bind:format="yyyy-MM-dd" disabled="@(!string.IsNullOrEmpty(_draft.Year))" /></label>
            </div>
            <div class="cashbank-notes">خيارات الأطراف والأصناف من الفترة المحملة؛ عند تغيير التاريخ اضغط تطبيق لتحديث القوائم.</div>
            <div class="oas-report__field"><UiReportSearchPicker Label="العميل" DialogTitle="اختيار العميل" Value="@_draft.Customer" ValueChanged="@(v => _draft.Customer = v ?? string.Empty)" Options="@(Options("customer"))" Placeholder="الكل" /></div>
            @if (_draft.Mode != "Collections")
            {
                <label class="oas-report__field">نوع المنتج<select @bind="_draft.ProductType" @bind:after="TypeChanged"><option value="">الكل</option>@foreach(var o in Pick("type")){<option value="@o.Key">@o.Label</option>}</select></label>
                <label class="oas-report__field">تصنيف المنتج<select @bind="_draft.Category" @bind:after="CategoryChanged"><option value="">الكل</option>@foreach(var o in Pick("category")){<option value="@o.Key">@o.Label</option>}</select></label>
                <div class="oas-report__field"><UiReportSearchPicker Label="المنتج / الصنف" DialogTitle="اختيار الصنف" Value="@_draft.Product" ValueChanged="@(v => _draft.Product = v ?? string.Empty)" Options="@(Options("product"))" Placeholder="الكل" /></div>
                <label class="oas-report__field">العلامة التجارية<select @bind="_draft.Brand"><option value="">الكل</option>@foreach(var o in Pick("brand")){<option value="@o.Key">@o.Label</option>}</select></label>
                <label class="oas-report__field">مخزن البيع الأصلي<select @bind="_draft.Warehouse"><option value="">الكل</option>@foreach(var o in Pick("warehouse")){<option value="@o.Key">@o.Label</option>}</select></label>
            }
            <label class="oas-report__field">موظف المبيعات<select @bind="_draft.Employee"><option value="">الكل</option>@foreach(var o in Pick("employee")){<option value="@o.Key">@o.Label</option>}</select></label>
            <label class="oas-report__field">المستخدم المرحّل<select @bind="_draft.Operator"><option value="">الكل</option>@foreach(var o in Pick("operator")){<option value="@o.Key">@o.Label</option>}</select></label>
            <label class="oas-report__field">العملة الأساسية التاريخية<select @bind="_draft.HistoricalBaseCurrency" @bind:after="HistoricalBaseChanged" disabled="@_busy"><option value="*">تلقائي</option>@foreach(var currencyCode in HistoricalBaseOptions){<option value="@currencyCode">@currencyCode</option>}</select></label>
            <label class="oas-report__field">عملة الفاتورة<select @bind="_draft.Currency"><option value="">الكل</option>@foreach(var o in Pick("currency")){<option value="@o.Key">@o.Label</option>}</select></label>
            <label class="oas-report__field">خطة الدفع<select @bind="_draft.Plan"><option value="">الكل</option><option value="1">فوري كامل</option><option value="2">جزئي</option><option value="4">آجل</option></select></label>
            @if (_draft.Mode == "Collections")
            { <label class="oas-report__field">حالة التسوية<select @bind="_draft.Settlement"><option value="">الكل</option><option value="paid">مسددة / مسواة بالكامل</option><option value="partial">جزئية</option><option value="unpaid">غير مسددة</option></select></label> }
            <label class="oas-report__field">عملة العرض<select @bind="_draft.DisplayCurrency"><option value="">@BaseCode (الأساسية)</option>@foreach(var c in _currencies.Where(c=>c.Code!=BaseCode)){<option value="@c.Id">@c.NameAr (@c.Code)</option>}</select></label>
            @if (_validation is not null){<div class="trial-warning" role="alert">@_validation</div>}
        </div>
        <div class="oas-report__apply"><button type="button" class="primary" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-filter"></i> تطبيق</button><button type="button" disabled="@_busy" @onclick="ResetAsync"><i class="fa-solid fa-rotate-left"></i> إعادة تعيين</button></div>
    </FilterPanel>
    <TableContent>
        @if (CanExport && _report is not null && _report.Warnings.Count > 0)
        {<details class="cashbank-notes" open><summary>ملاحظات التقرير</summary>@foreach(var warning in _report.Warnings){<div>@warning</div>}</details>}
        <table class="oas-report__table trial-table cashbank-table">
            <thead><tr>@for(var i=0;i<Columns.Length;i++){var index=i;<UiReportSortHeader Label="@(Columns[index].Label)" Active="@(_sort==index)" Descending="@_descending" OnSort="@(()=>SortBy(index))" />}</tr></thead>
            <tbody>
                @if(_busy){<tr><td colspan="@Columns.Length" class="oas-report__empty">جارٍ تحميل التقرير...</td></tr>}
                else if(_error is not null){<tr><td colspan="@Columns.Length" class="oas-report__empty" role="alert">@_error</td></tr>}
                else if(_visible.Count==0){<tr><td colspan="@Columns.Length" class="oas-report__empty">لا توجد بيانات مطابقة.</td></tr>}
                else
                {
                    @foreach(var row in PageRows)
                    {
                        <tr>@foreach(var c in Columns){var value=c.Value(row);<td class="@(value is decimal ? "oas-report__amount" : "")">
                            @if(c.Key=="label" && row.DocumentId.HasValue){<button type="button" class="trial-link" @onclick="()=>OpenDocument(row)">@Format(value)</button>}
                            else if(c.Key=="journal" && row.JournalId.HasValue){<button type="button" class="trial-link" @onclick="()=>OpenJournal(row)">عرض القيد</button>}
                            else{@Format(value,c.Key=="margin")}
                        </td>}</tr>
                    }
                }
            </tbody>
            @if(CanExport){<tfoot><tr class="trial-total">@foreach(var c in Columns){<td>@Format(TotalValue(c.Key),c.Key=="margin")</td>}</tr></tfoot>}
        </table>
    </TableContent>
    <Pagination>
        <div class="oas-report__pager"><button @onclick="@(()=>GoPage(1))" disabled="@(_page==1)">»</button><button @onclick="@(()=>GoPage(_page-1))" disabled="@(_page==1)">‹</button><button class="active" disabled>@_page</button><button @onclick="@(()=>GoPage(_page+1))" disabled="@(_page>=TotalPages)">›</button><button @onclick="@(()=>GoPage(TotalPages))" disabled="@(_page>=TotalPages)">«</button></div>
        <span>عرض @(_visible.Count==0?0:(_page-1)*_pageSize+1) - @Math.Min(_page*_pageSize,_visible.Count) من @_visible.Count</span>
        <label>لكل صفحة <select value="@_pageSize" @onchange="ChangePageSize"><option>10</option><option>25</option><option>50</option><option>100</option></select></label>
    </Pagination>
    <Metrics>@foreach(var m in Metrics){<UiReportMetric Label="@m.Label" Value="@m.Value" Tone="@m.Tone" Icon="@m.Icon" />}</Metrics>
</UiReportWorkspace>
</div>
