@page "/sales"
@attribute [Authorize]
@using OAS.Client.Services.Http
@using OAS.Contracts.Common.Pagination
@using OAS.Contracts.Sales.Reports
@using OAS.Contracts.Sales.SalesInvoices
@using OAS.Contracts.Sales.Enums
@using OAS.Client.Sales.Services
@inject ISalesClientService Sales
@inject OasApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>المبيعات | OASSystem</PageTitle>

<div class="oas-sales-dashboard" dir="rtl">
    <header class="sd-hero">
        <div class="sd-hero-title">
            <span class="sd-hero-icon"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i></span>
            <div><h1>المبيعات</h1><p>الرئيسية <i class="fa-solid fa-chevron-left" aria-hidden="true"></i> المبيعات</p></div>
        </div>
        <span class="sd-hero-description">ملخص المبيعات والتحصيل والطلبات في مكان واحد</span>
    </header>

    <div class="sd-filters" aria-label="تصفية لوحة المبيعات">
        <div class="sd-filter sd-context-filter">
            <i class="fa-solid fa-database" aria-hidden="true"></i>
            <span><small>مصدر البيانات</small><strong>المبيعات المرحلة</strong></span>
        </div>
        <label class="sd-filter sd-date-filter"><i class="fa-regular fa-calendar" aria-hidden="true"></i><span><small>من تاريخ</small><input type="date" aria-label="من تاريخ" @bind="_fromDate" /></span></label>
        <label class="sd-filter sd-date-filter"><i class="fa-regular fa-calendar" aria-hidden="true"></i><span><small>إلى تاريخ</small><input type="date" aria-label="إلى تاريخ" @bind="_toDate" /></span></label>
        <button type="button" class="sd-filter-apply" disabled="@_loading" @onclick="ApplyPeriodAsync"><i class="fa-solid fa-filter" aria-hidden="true"></i> تطبيق</button>
        <form class="sd-global-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <button aria-label="بحث في جميع الفواتير" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
            <input placeholder="البحث في الفواتير أو بأسماء العملاء ..." aria-label="بحث في المبيعات" @bind="_search" @bind:event="oninput" />
        </form>
        <button type="button" class="sd-action-icon" title="تحديث البيانات" aria-label="تحديث البيانات" disabled="@_loading" @onclick="RefreshAsync"><i class="fa-solid fa-rotate @(_loading ? "fa-spin" : "")" aria-hidden="true"></i></button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="sd-alert" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span>@_error</span><button @onclick="RefreshAsync" type="button">إعادة المحاولة</button></div>
    }
    <div class="sd-freshness" role="status">
        <span><i class="fa-solid fa-circle-info" aria-hidden="true"></i> القيم المالية بعملة الأساس، والإيراد بعد استبعاد الضريبة، حسب تاريخ الترحيل.</span>
        @if (_summary is not null) { <span>آخر تحديث: @(_summary.GeneratedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")) — @_summary.BaseCurrencyLabel</span> }
    </div>

    <section class="sd-metrics" aria-label="مؤشرات المبيعات">
        <article class="sd-metric sd-metric-sales">
            <span class="sd-metric-icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
            <h2>@(_fromDate == _toDate ? "صافي مبيعات اليوم المحدد" : "صافي مبيعات الفترة")</h2>
            <div class="sd-metric-value">@BaseMoney(_summary?.NetSalesBase)</div>
            <p>@(_summary is null ? "جارٍ تحميل المؤشر" : $"من {_summary.InvoiceCount:N0} فاتورة مرحلة")</p>
            <small>الإيراد قبل المرتجعات: @BaseMoney(_summary?.InvoiceRevenueBase)</small>
        </article>
        <article class="sd-metric sd-metric-due">
            <span class="sd-metric-icon"><i class="fa-solid fa-coins" aria-hidden="true"></i></span>
            <h2>الذمم المستحقة</h2>
            <div class="sd-metric-value">@BaseMoney(_summary?.OutstandingBase)</div>
            <p>@(_summary is null ? "جارٍ تحميل المؤشر" : $"{_summary.OutstandingInvoiceCount:N0} فاتورة غير مكتملة السداد")</p>
            <small>رصيد جميع الفواتير المرحلة حتى الآن</small>
        </article>
        <article class="sd-metric sd-metric-orders">
            <span class="sd-metric-icon"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i></span>
            <h2>الطلبات قيد التنفيذ</h2>
            <div class="sd-metric-value">@(_summary?.InProgressOrderCount.ToString("N0") ?? "—")</div>
            <p>طلبات مؤكدة لم تكتمل بعد</p>
            <small>باستثناء المسودات والمكتملة والملغاة</small>
        </article>
        <article class="sd-metric sd-metric-returns">
            <span class="sd-metric-icon"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></span>
            <h2>@(_fromDate == _toDate ? "مرتجعات اليوم المحدد" : "مرتجعات الفترة")</h2>
            <div class="sd-metric-value">@(_summary?.ReturnCount.ToString("N0") ?? "—")</div>
            <p>قيمة المرتجعات: @BaseMoney(_summary?.ReturnedRevenueBase)</p>
            <small>المرتجعات المرحلة فقط</small>
        </article>
    </section>

    <div class="sd-insights-grid">
        <section class="sd-panel sd-alerts-panel" aria-label="تنبيهات ومتابعات">
            <div class="sd-section-head"><h2><i class="fa-regular fa-bell sd-blue-text" aria-hidden="true"></i> تنبيهات ومتابعات</h2></div>
            <button class="sd-alert-row" type="button" @onclick="() => Go(InvoicesRoute)">
                <span class="sd-alert-icon sd-red"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>
                <span class="sd-alert-title"><strong>فواتير متأخرة السداد</strong><small>فواتير تجاوزت تاريخ الاستحقاق</small></span>
                <span class="sd-count sd-count-red">@(_summary?.OverdueInvoiceCount.ToString("N0") ?? "—")</span>
            </button>
            <button class="sd-alert-row" type="button" @onclick="() => Go(OrdersRoute)">
                <span class="sd-alert-icon sd-gold"><i class="fa-solid fa-truck" aria-hidden="true"></i></span>
                <span class="sd-alert-title"><strong>طلبات جاهزة للتسليم</strong><small>طلبات مكتملة تنتظر التسليم</small></span>
                <span class="sd-count sd-count-yellow">@(_summary?.ReadyForDeliveryCount.ToString("N0") ?? "—")</span>
            </button>
            <button class="sd-alert-row" type="button" @onclick="() => Go(ProductionRoute)">
                <span class="sd-alert-icon sd-blue"><i class="fa-solid fa-gears" aria-hidden="true"></i></span>
                <span class="sd-alert-title"><strong>أعمال معملية قيد التنفيذ</strong><small>أعمال قيد التنفيذ أو تحتاج مراجعة جودة</small></span>
                <span class="sd-count sd-count-blue">@(_summary?.InProgressProductionCount.ToString("N0") ?? "—")</span>
            </button>
            <button class="sd-alert-row" type="button" @onclick="() => Go(ReturnsRoute)">
                <span class="sd-alert-icon sd-red"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></span>
                <span class="sd-alert-title"><strong>مرتجعات تتطلب مراجعة</strong><small>مرتجعات مؤكدة ولم تُرحّل بعد</small></span>
                <span class="sd-count sd-count-red">@(_summary?.PendingReturnCount.ToString("N0") ?? "—")</span>
            </button>
        </section>
        <section class="sd-panel sd-chart-panel" aria-label="اتجاه المبيعات الأسبوعي">
            <div class="sd-section-head"><h2><i class="fa-solid fa-chart-line sd-blue-text" aria-hidden="true"></i> اتجاه المبيعات الأسبوعي</h2><span class="sd-chart-filter"><i class="fa-regular fa-calendar" aria-hidden="true"></i> آخر 7 أيام حتى @_toDate.ToString("dd/MM/yyyy")</span></div>
            <div class="sd-chart">
                @if (_summary is null)
                {
                    <div class="sd-chart-empty">@(_loading ? "جارٍ تحميل الرسم البياني..." : "تعذر عرض بيانات الرسم البياني.")</div>
                }
                else if (_summary.Week.All(x => x.NetSalesBase == 0))
                {
                    <div class="sd-chart-empty">لا توجد مبيعات أو مرتجعات مرحلة في الأيام السبعة المحددة.</div>
                }
                else
                {
                    <svg viewBox="0 0 720 215" preserveAspectRatio="none" role="img" aria-label="صافي المبيعات خلال آخر سبعة أيام، بالعملة الأساسية">
                        <defs><linearGradient id="sd-week-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--sd-chart-line)" stop-opacity=".26"/><stop offset="100%" stop-color="var(--sd-chart-line)" stop-opacity=".02"/></linearGradient></defs>
                        @for (int i = 0; i < 5; i++)
                        {
                            <line x1="58" x2="710" y1="@(18 + i * 40)" y2="@(18 + i * 40)" stroke="currentColor" stroke-opacity=".13" stroke-width="1" />
                            @((MarkupString)$"<text x=\"48\" y=\"{22 + i * 40}\" text-anchor=\"end\" font-size=\"12\" fill=\"currentColor\">{ChartTick(i)}</text>")
                        }
                        <polygon points="@ChartArea" fill="url(#sd-week-fill)" />
                        <polyline points="@ChartLine" fill="none" stroke="var(--sd-chart-line)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                        @for (int i = 0; i < 7; i++)
                        {
                            <circle cx="@(64 + i * 106)" cy="@ChartY(i)" r="4.5" fill="var(--sd-surface)" stroke="var(--sd-chart-line)" stroke-width="3" />
                        }
                    </svg>
                }
                <div class="sd-chart-days">
                    @foreach (var day in _summary?.Week ?? Array.Empty<SalesDashboardDayDto>())
                    { <span>@day.Date.ToString("ddd", new System.Globalization.CultureInfo("ar"))<small>@day.Date.ToString("dd/MM")</small></span> }
                </div>
            </div>
            <div class="sd-chart-note">صافي المبيعات بعد المرتجعات، حسب تاريخ الترحيل — @(_summary?.BaseCurrencyLabel ?? "عملة الأساس")</div>
        </section>
    </div>

    <section class="sd-panel sd-quick-panel" aria-label="العمليات السريعة">
        <div class="sd-section-head"><h2><i class="fa-solid fa-bolt sd-yellow-text" aria-hidden="true"></i> العمليات السريعة</h2></div>
        <div class="sd-quick-actions">
            <button class="sd-quick sd-quick-primary" type="button" @onclick="() => Go(CheckoutRoute)"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i><strong>بيع مباشر</strong></button>
            <button class="sd-quick" type="button" @onclick="GoCreateInvoice"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><strong>إنشاء فاتورة</strong></button>
            <button class="sd-quick" type="button" @onclick="GoCreateOrder"><i class="fa-solid fa-user-plus" aria-hidden="true"></i><strong>طلب عميل</strong></button>
            <button class="sd-quick" type="button" @onclick="() => Go(ReturnsRoute)"><i class="fa-solid fa-rotate-left sd-danger-text" aria-hidden="true"></i><strong>مرتجع مبيعات</strong></button>
            <button class="sd-quick" type="button" @onclick="ShowCollectionPicker"><i class="fa-solid fa-coins" aria-hidden="true"></i><strong>تحصيل دفعة</strong></button>
        </div>
    </section>

    <section class="sd-panel sd-table-panel">
        <div class="sd-section-head"><h2><i class="fa-regular fa-file-lines sd-blue-text" aria-hidden="true"></i> @(_appliedSearch is null ? "آخر فواتير المبيعات" : "نتائج البحث عن الفواتير")</h2><button type="button" class="sd-link" @onclick="() => Go(InvoicesRoute)">عرض الكل <i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button></div>
        <div class="sd-table-wrap">
            <table class="sd-invoice-table">
                <thead><tr><th>رقم الفاتورة</th><th>العميل</th><th>التاريخ</th><th>حالة المستند</th><th>حالة السداد</th><th class="sd-num">الإجمالي</th><th class="sd-num">المتبقي</th><th>الإجراء</th></tr></thead>
                <tbody>
                    @if (_invoicesLoading) { <tr><td colspan="8" class="sd-empty">جارٍ تحميل الفواتير...</td></tr> }
                    else if (_invoices.Count == 0) { <tr><td colspan="8" class="sd-empty">@(_appliedSearch is null ? "لا توجد فواتير مسجلة." : "لم تُعثر على فاتورة مطابقة. جرّب رقمًا آخر أو اسم العميل.")</td></tr> }
                    else
                    {
                        @foreach (var item in _invoices)
                        {
                            <tr>
                                <td><button class="sd-invoice-link" type="button" title="فتح الفاتورة في تبويبها" @onclick="() => OpenInvoice(item.Id)">@item.InvoiceCode</button></td>
                                <td>@(item.CustomerName ?? item.CustomerCode ?? "عميل نقدي")</td>
                                <td class="sd-muted">@item.InvoiceDate.ToString("yyyy/MM/dd")</td>
                                <td><span class="sd-status @DocumentStatusClass(item)">@DocumentStatusText(item)</span></td>
                                <td><span class="sd-status @PaymentStatusClass(item)">@PaymentStatusText(item)</span></td>
                                <td class="sd-num">@Money(item.TotalAmount, item.CurrencySymbolSnapshot ?? item.CurrencyCodeSnapshot)</td>
                                <td class="sd-num">@Money(item.PaymentSummary.OutstandingAmount, item.CurrencySymbolSnapshot ?? item.CurrencyCodeSnapshot)</td>
                                <td><button class="sd-more" title="فتح تفاصيل الفاتورة" aria-label="فتح تفاصيل الفاتورة" type="button" @onclick="() => OpenInvoice(item.Id)"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></button></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (_appliedSearch is not null) { <button type="button" class="sd-clear-search" @onclick="ClearSearchAsync">مسح البحث وإظهار أحدث الفواتير</button> }
    </section>

    @if (_showCollectPicker)
    {
        <div class="sd-modal-backdrop" role="presentation">
            <section class="sd-collect-dialog" role="dialog" aria-modal="true" aria-label="اختيار فاتورة للتحصيل">
                <div class="sd-section-head"><h2>اختر فاتورة لتحصيل دفعة</h2><button type="button" class="sd-close" @onclick="HideCollectionPicker" aria-label="إغلاق"><i class="fa-solid fa-xmark"></i></button></div>
                <p>ابحث برقم الفاتورة أو اسم العميل، ثم اختر فاتورة مرحلة لها مبلغ متبقٍ.</p>
                <form class="sd-collect-search" @onsubmit="SearchCollectionAsync" @onsubmit:preventDefault>
                    <input aria-label="البحث عن فاتورة للتحصيل" placeholder="رقم الفاتورة أو اسم العميل" @bind="_collectionSearch" @bind:event="oninput" />
                    <button type="submit" disabled="@_collectionLoading">@(_collectionLoading ? "جارٍ البحث" : "بحث")</button>
                </form>
                @foreach (var item in _collectionInvoices)
                {
                    <button class="sd-collect-choice" type="button" @onclick="() => OpenInvoiceForCollection(item.Id)"><strong>@item.InvoiceCode</strong><span>@(item.CustomerName ?? "عميل نقدي")</span><span>@Money(item.PaymentSummary.OutstandingAmount, item.CurrencySymbolSnapshot ?? item.CurrencyCodeSnapshot)</span></button>
                }
                @if (!_collectionLoading && _collectionInvoices.Count == 0)
                { <div class="sd-empty">لا توجد فاتورة قابلة للتحصيل في النتائج الحالية. استخدم البحث أو افتح قائمة الفواتير.</div> }
                <button type="button" class="sd-modal-footer" @onclick="() => Go(InvoicesRoute)">استعراض جميع الفواتير</button>
            </section>
        </div>
    }
</div>

@code {
    private const string CheckoutRoute = "/sales/checkout";
    private const string InvoicesRoute = "/sales/invoices";
    private const string OrdersRoute = "/sales/customer-orders";
    private const string ReturnsRoute = "/sales/returns";
    private const string ProductionRoute = "/optical/jobs";
    private readonly List<SalesInvoiceDto> _invoices = [];
    private readonly List<SalesInvoiceDto> _collectionInvoices = [];
    private string? _collectionSearch;
    private bool _collectionLoading;
    private SalesDashboardDto? _summary;
    private bool _loading;
    private bool _invoicesLoading;
    private bool _showCollectPicker;
    private bool _disposed;
    private string? _error;
    private string? _search;
    private string? _appliedSearch;
    private DateOnly _fromDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _toDate = DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private void Go(string route) => Navigation.NavigateTo(route);
    private void GoCreateInvoice() => Go(InvoicesRoute + "?create=true");
    private void GoCreateOrder() => Go(OrdersRoute + "?create=true");
    private void OpenInvoice(Guid id) => Go($"{InvoicesRoute}?invoiceId={id:D}");
    private void OpenInvoiceForCollection(Guid id) => Go($"{InvoicesRoute}?invoiceId={id:D}&collect=true");
    private void ShowCollectionPicker()
    {
        _collectionSearch = _search;
        _collectionInvoices.Clear();
        _collectionInvoices.AddRange(_invoices.Where(x =>
            x.Status == SalesInvoiceStatus.Posted && x.PaymentSummary.OutstandingAmount > 0m));
        _showCollectPicker = true;
    }
    private void HideCollectionPicker() => _showCollectPicker = false;
    private async Task SearchCollectionAsync()
    {
        if (_collectionLoading || string.IsNullOrWhiteSpace(_collectionSearch)) return;
        _collectionLoading = true;
        _collectionInvoices.Clear();
        try
        {
            var url = "api/sales/dashboard/invoice-search?search=" + Uri.EscapeDataString(_collectionSearch.Trim());
            var response = await Api.GetResultAsync<IReadOnlyList<SalesInvoiceDto>>(url);
            if (response.Succeeded && response.Value is not null)
                _collectionInvoices.AddRange(response.Value.Where(x =>
                    x.Status == SalesInvoiceStatus.Posted && x.PaymentSummary.OutstandingAmount > 0m));
        }
        catch (Exception) { _error = "تعذر البحث عن فاتورة للتحصيل."; }
        finally { _collectionLoading = false; }
    }
    private Task RefreshAsync() => LoadAsync();
    private Task ApplyPeriodAsync() => LoadAsync();
    private async Task SearchAsync()
    {
        _appliedSearch = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
        await LoadInvoicesAsync();
    }
    private async Task ClearSearchAsync()
    {
        _search = null;
        _appliedSearch = null;
        await LoadInvoicesAsync();
    }
    private async Task LoadAsync()
    {
        if (_loading || _disposed) return;
        if (_fromDate > _toDate) { _error = "تاريخ البداية يجب ألا يكون بعد تاريخ النهاية."; return; }
        if (_toDate.DayNumber - _fromDate.DayNumber > 366) { _error = "الحد الأقصى للفترة سنة واحدة."; return; }
        _loading = true;
        _error = null;
        _summary = null; // Never present a stale financial figure as a newly refreshed number.
        try
        {
            var route = $"api/sales/dashboard?fromDate={_fromDate:yyyy-MM-dd}&toDate={_toDate:yyyy-MM-dd}";
            var summaryTask = Api.GetResultAsync<SalesDashboardDto>(route);
            var invoiceTask = LoadInvoicesAsync();
            try
            {
                var result = await summaryTask;
                if (!result.Succeeded || result.Value is null) _error = "تعذر تحميل المؤشرات المالية. لا تُعرض قيم تقديرية.";
                else if (!_disposed) _summary = result.Value;
            }
            catch (Exception) { _error = "تعذر الاتصال بخدمة مؤشرات المبيعات."; }
            await invoiceTask;
        }
        finally { _loading = false; if (!_disposed) await InvokeAsync(StateHasChanged); }
    }
    private async Task LoadInvoicesAsync()
    {
        if (_disposed) return;
        _invoicesLoading = true;
        _invoices.Clear();
        try
        {
            if (_appliedSearch is not null)
            {
                var route = "api/sales/dashboard/invoice-search?search=" + Uri.EscapeDataString(_appliedSearch);
                var result = await Api.GetResultAsync<IReadOnlyList<SalesInvoiceDto>>(route);
                if (!result.Succeeded || result.Value is null)
                    _error = "تعذر البحث عن الفواتير؛ راجع الاتصال والصلاحيات.";
                else if (!_disposed) _invoices.AddRange(result.Value);
            }
            else
            {
                var page = await Sales.GetSalesInvoicesPageAsync(new PageRequest
                {
                    PageNumber = 1, PageSize = 8,
                    SortBy = "InvoiceDate", SortDirection = SortDirection.Descending
                });
                if (!_disposed) _invoices.AddRange(page.Items);
            }
        }
        catch (Exception) { _error = "تعذر تحميل الفواتير. أعد المحاولة أو تحقق من الصلاحيات."; }
        finally { _invoicesLoading = false; if (!_disposed) await InvokeAsync(StateHasChanged); }
    }
    private string BaseMoney(decimal? value) => value.HasValue ? Money(value.Value, _summary?.BaseCurrencyLabel) : "—";
    private static string Money(decimal value, string? currency) => $"{value:N2} {(string.IsNullOrWhiteSpace(currency) ? "" : currency)}".Trim();
    private static string DocumentStatusText(SalesInvoiceDto x) => x.Status switch
    {
        SalesInvoiceStatus.Draft => "مسودة", SalesInvoiceStatus.Confirmed => "مؤكدة",
        SalesInvoiceStatus.Posted => "مرحلة", SalesInvoiceStatus.Cancelled => "ملغاة", _ => "—"
    };
    private static string DocumentStatusClass(SalesInvoiceDto x) => x.Status switch
    {
        SalesInvoiceStatus.Cancelled => "sd-status-red", SalesInvoiceStatus.Draft => "sd-status-gray",
        SalesInvoiceStatus.Confirmed => "sd-status-amber", SalesInvoiceStatus.Posted => "sd-status-green", _ => "sd-status-gray"
    };
    private static string PaymentStatusText(SalesInvoiceDto x) => x.Status == SalesInvoiceStatus.Cancelled ? "ملغاة" :
        x.Status != SalesInvoiceStatus.Posted ? "غير مرحلة" :
        x.PaymentSummary.OutstandingAmount <= 0m && x.PaymentSummary.ReturnedAmount > 0m && x.PaymentSummary.PaidAmount <= 0m ? "مقفلة بمرتجع" :
        x.PaymentSummary.OutstandingAmount <= 0m ? "مسددة" :
        x.PaymentSummary.PaidAmount > 0m ? "مسددة جزئيًا" : "غير مسددة";
    private static string PaymentStatusClass(SalesInvoiceDto x) => x.Status != SalesInvoiceStatus.Posted ? "sd-status-gray" :
        x.PaymentSummary.OutstandingAmount <= 0m ? "sd-status-green" :
        x.PaymentSummary.PaidAmount > 0m ? "sd-status-amber" : "sd-status-red";
    private IReadOnlyList<SalesDashboardDayDto> Week => _summary?.Week ?? Array.Empty<SalesDashboardDayDto>();
    private decimal ChartMin => Week.Count == 0 ? 0m : Math.Min(0m, Week.Min(x => x.NetSalesBase));
    private decimal ChartMax => Week.Count == 0 ? 1m : Math.Max(1m, Week.Max(x => x.NetSalesBase));
    private int ChartY(int i) => 178 - (int)Math.Round((Week[i].NetSalesBase - ChartMin) /
        Math.Max(1m, ChartMax - ChartMin) * 160m);
    private string ChartLine => string.Join(" ", Enumerable.Range(0, Week.Count)
        .Select(i => $"{64 + i * 106},{ChartY(i)}"));
    private string ChartArea => $"64,178 {ChartLine} 700,178";
    private string ChartTick(int i) => (ChartMax - ((ChartMax - ChartMin) * i / 4m)).ToString("N0");
    public void Dispose() => _disposed = true;
}
