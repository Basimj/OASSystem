@page "/sales/returns"
@attribute [Authorize]
@using OAS.Contracts.Sales.Returns
@using OAS.Contracts.Sales.SalesInvoices
@using OAS.Contracts.Sales.Enums
@using OAS.Contracts.Sales.Lookups
@using OAS.Client.Common.Feedback.Services
@using OAS.Client.Services.Http
@using OAS.UiLib.Services.Feedback
@inject ISalesClientService Sales
@inject OasApiClient ApiClient
@inject IUiSnackbarService Snackbar
@inject IApiFeedbackService ApiFeedback

<PageTitle>مرتجعات المبيعات | OAS</PageTitle>

<UiWorkspaceLayout ShowAside="@(_creating || _selected is not null)" ShowFilters="false">
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="مرتجع جديد" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small" OnClick="BeginCreateAsync" />
            <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Loading="@_busy" OnClick="RefreshAsync" />
            @if (_selected is { Status: SalesReturnStatus.Draft })
            {
                <UiButton Text="تأكيد" IconCssClass="fa-solid fa-check" Size="ControlSize.Small" Loading="@_busy" OnClick="ConfirmAsync" />
                <UiButton Text="إلغاء" IconCssClass="fa-solid fa-ban" Variant="ButtonVariant.Danger" Size="ControlSize.Small" Loading="@_busy" OnClick="CancelAsync" />
            }
            else if (_selected is { Status: SalesReturnStatus.Confirmed })
            {
                <UiButton Text="ترحيل" IconCssClass="fa-solid fa-arrow-up-right-dots" Size="ControlSize.Small" Loading="@_busy" OnClick="PostAsync" />
                <UiButton Text="إلغاء" IconCssClass="fa-solid fa-ban" Variant="ButtonVariant.Danger" Size="ControlSize.Small" Loading="@_busy" OnClick="CancelAsync" />
            }
        </UiWorkspaceActionBar>
    </Actions>
    <Content>
        <UiDataGridPanel Title="مرتجعات المبيعات" Subtitle="@($"{_page.TotalCount:N0} مستند")">
            <Toolbar><UiSearchInput Value="@_search" ValueChanged="@(value => _search = value)" OnSearch="SearchAsync" Placeholder="بحث برقم المرتجع أو السبب..." /></Toolbar>
            <Body>
                <UiStackLayout Gap="StackGap.Small">
                    @if (_busy && _page.Items.Count == 0)
                    {
                        <UiAlert Message="جارٍ تحميل مرتجعات المبيعات..." Tone="AlertTone.Info" />
                    }
                    else if (_page.Items.Count == 0)
                    {
                        <UiAlert Message="لا توجد مرتجعات مبيعات مطابقة." Tone="AlertTone.Info" />
                    }
                    else
                    {
                        @foreach (var item in _page.Items)
                        {
                            <UiRecordRow Title="@item.ReturnCode"
                                         Subtitle="@($"{item.ReturnDate:yyyy-MM-dd} • {item.TotalAmount:N2} {item.CurrencyCode}")"
                                         Selected="@(_selected?.Id == item.Id)" OnClick="@(() => SelectAsync(item.Id))">
                                <Content><UiKeyValue Label="تاريخ الترحيل" Value="@item.PostingDate.ToString("yyyy-MM-dd")" /></Content>
                                <Trailing><UiBadge Text="@StatusText(item.Status)" Tone="@StatusTone(item.Status)" /></Trailing>
                            </UiRecordRow>
                        }
                    }
                </UiStackLayout>
            </Body>
            <Footer><UiPagination PageNumber="@_page.PageNumber" TotalPages="@_page.TotalPages" TotalCount="@_page.TotalCount" OnPrevious="PreviousAsync" OnNext="NextAsync" /></Footer>
        </UiDataGridPanel>
    </Content>
    <Aside>
        @if (_creating)
        {
            <UiCard Title="مرتجع مبيعات جديد" Subtitle="اختر فاتورة مرحلة، وسيضبط النظام التواريخ والمخازن وفق شروطها.">
                <UiStackLayout Gap="StackGap.Small">
                    <UiSelect Label="فاتورة المبيعات" Placeholder="اختر فاتورة مرحلة" Value="@_invoiceIdText"
                              ValueChanged="InvoiceChangedAsync" Options="@InvoiceOptions" Size="ControlSize.Small" />
                    <UiGrid Columns="2">
                        <UiInputDate Label="تاريخ المرتجع" Value="@_returnDate" ValueChanged="OnReturnDateChanged" Size="ControlSize.Small" />
                        <UiInputDate Label="تاريخ الترحيل" Value="@_postingDate" ValueChanged="OnPostingDateChanged" Size="ControlSize.Small" />
                    </UiGrid>
                    <UiInputText Label="السبب" Value="@_reason" ValueChanged="@(value => _reason = value)" Size="ControlSize.Small" MaxLength="1000" />
                    @if (_returnPolicy?.CanOverrideReturnWindow == true)
                    {
                        <UiCheckbox Label="تجاوز مدة الإرجاع النظامية عند الحاجة" Value="@_overrideReturnWindow"
                                    ValueChanged="@(value => _overrideReturnWindow = value)" />
                    }
                    @if (_overrideReturnWindow)
                    {
                        <UiInputText Label="سبب تجاوز مدة الإرجاع" Value="@_returnWindowOverrideReason"
                                     ValueChanged="@(value => _returnWindowOverrideReason = value)" Size="ControlSize.Small" MaxLength="500" />
                    }
                    @if (_sourceInvoice is not null)
                    {
                        <UiCard Title="أسطر الفاتورة" Subtitle="يحدد النظام مخزنًا صالحًا تلقائيًا بحسب قرار المخزون.">
                            <UiStackLayout Gap="StackGap.Small">
                                @foreach (var line in _returnLines)
                                {
                                    <UiCard Title="@($"{line.Line.LineNumber} - {line.Line.ProductNameSnapshot}")"
                                            Subtitle="@($"الكمية الأصلية {line.Line.Quantity:N3} • المتاح {line.Remaining:N3}")">
                                        <UiGrid Columns="2">
                                            <UiCheckbox Value="@line.Selected" ValueChanged="@(value => OnLineSelected(line, value))" Label="إرجاع هذا السطر" Disabled="@(line.Remaining <= 0m)" />
                                            <UiInputText Label="الكمية المرتجعة" Value="@line.QuantityText"
                                                         ValueChanged="@(value => line.QuantityText = value ?? string.Empty)"
                                                         InputMode="decimal" Size="ControlSize.Small" Disabled="@(!line.Selected || line.Remaining <= 0m)" />
                                            @if (line.RequiresInventory)
                                            {
                                                <UiSelect Label="حالة الصنف المرتجع" Value="@line.ReturnConditionText"
                                                          ValueChanged="@(value => OnConditionChanged(line, value))"
                                                          Options="@ConditionOptionsFor(line)" Size="ControlSize.Small"
                                                          Disabled="@(!line.Selected || line.Remaining <= 0m)" />
                                                <UiSelect Label="قرار المخزون" Value="@line.StockDispositionText"
                                                          ValueChanged="@(value => OnDispositionChanged(line, value))"
                                                          Options="@DispositionOptionsFor(line)" Size="ControlSize.Small"
                                                          Disabled="@(!line.Selected || line.Remaining <= 0m)" />
                                                <UiSelect Label="مخزن الإرجاع / الفحص" Placeholder="لا يوجد مخزن صالح"
                                                          Value="@line.ReturnWarehouseIdText"
                                                          ValueChanged="@(value => OnReturnWarehouseChanged(line, value))"
                                                          Options="@WarehouseOptionsFor(line)" Size="ControlSize.Small"
                                                          Disabled="@(!line.Selected || line.Remaining <= 0m)" />
                                            }
                                        </UiGrid>
                                    </UiCard>
                                }
                            </UiStackLayout>
                        </UiCard>
                    }
                    <UiWorkspaceActionBar>
                        <UiButton Text="حفظ المسودة" IconCssClass="fa-solid fa-floppy-disk" Loading="@_busy" Size="ControlSize.Small" OnClick="CreateAsync" />
                        <UiButton Text="إلغاء" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" OnClick="CloseEditorAsync" />
                    </UiWorkspaceActionBar>
                </UiStackLayout>
            </UiCard>
        }
        else if (_selected is not null)
        {
            <UiCard Title="@_selected.ReturnCode" Subtitle="@StatusText(_selected.Status)">
                <UiStackLayout Gap="StackGap.Small">
                    <UiGrid Columns="2">
                        <UiKeyValue Label="تاريخ المرتجع" Value="@_selected.ReturnDate.ToString("yyyy-MM-dd")" />
                        <UiKeyValue Label="تاريخ الترحيل" Value="@_selected.PostingDate.ToString("yyyy-MM-dd")" />
                        <UiKeyValue Label="صافي المرتجع" Value="@($"{_selected.NetAmount:N2} {_selected.CurrencyCode}")" />
                        <UiKeyValue Label="الضريبة" Value="@($"{_selected.TaxAmount:N2} {_selected.CurrencyCode}")" />
                        <UiKeyValue Label="الإجمالي" Value="@($"{_selected.TotalAmount:N2} {_selected.CurrencyCode}")" />
                        <UiKeyValue Label="القيد" Value="@(_selected.JournalEntryId?.ToString("D") ?? "غير مرحل")" />
                    </UiGrid>
                    @if (_selected.ReturnPolicyReferenceDate.HasValue)
                    {
                        <UiAlert Message="@($"مرجع سياسة الإرجاع: {_selected.ReturnPolicyReferenceDate:yyyy-MM-dd} • المدة {_selected.ReturnWindowDaysSnapshot ?? 0} يوم" + (_selected.ReturnWindowOverridden ? " • تم تجاوز المدة بصلاحية موثقة" : string.Empty))"
                                 Tone="@(_selected.ReturnWindowOverridden ? AlertTone.Warning : AlertTone.Info)" />
                    }
                    @if (!string.IsNullOrWhiteSpace(_selected.ReturnWindowOverrideReason))
                    {
                        <UiAlert Message="@($"سبب تجاوز المدة: {_selected.ReturnWindowOverrideReason}")" Tone="AlertTone.Warning" />
                    }
                    @if (!string.IsNullOrWhiteSpace(_selected.Reason))
                    {
                        <UiAlert Message="@_selected.Reason" Tone="AlertTone.Info" />
                    }
                    <UiCard Title="الأسطر" Subtitle="@($"{_selected.Lines.Count} سطر")">
                        <UiStackLayout Gap="StackGap.Small">
                            @foreach (var line in _selected.Lines)
                            {
                                <UiRecordRow Title="@($"{line.LineNumber} - {line.ProductName}")"
                                             Subtitle="@($"كمية {line.Quantity:N3} • إجمالي {line.FinalAmount:N2}")">
                                    <Content>
                                        <UiKeyValue Label="تكلفة المخزون" Value="@(line.TotalCostSnapshot?.ToString("N2") ?? "-")" />
                                        <UiKeyValue Label="حالة المرتجع" Value="@ReturnConditionText(line.ReturnCondition)" />
                                        <UiKeyValue Label="قرار المخزون" Value="@StockDispositionText(line.StockDisposition)" />
                                        @if (line.InspectedAtUtc.HasValue)
                                        {
                                            <UiKeyValue Label="آخر فحص" Value="@line.InspectedAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")" />
                                        }
                                    </Content>
                                </UiRecordRow>
                                @if (_selected.Status == SalesReturnStatus.Posted && line.StockDisposition == SalesReturnStockDisposition.Quarantine)
                                {
                                    var inspection = GetInspectionForm(line.Id);
                                    <UiCard Title="فحص / تسريح من الحجر" Subtitle="تُعرض مخازن البيع النشطة فقط عند التسريح.">
                                        <UiGrid Columns="2">
                                            <UiSelect Label="نتيجة الفحص" Value="@inspection.ConditionText"
                                                      ValueChanged="@(value => OnInspectionConditionChanged(inspection, value))"
                                                      Options="@InspectionConditionOptions" Size="ControlSize.Small" />
                                            @if (inspection.ConditionText == nameof(SalesReturnCondition.Resellable))
                                            {
                                                <UiSelect Label="مخزن التسريح القابل للبيع" Placeholder="لا يوجد مخزن صالح"
                                                          Value="@inspection.DestinationWarehouseIdText"
                                                          ValueChanged="@(value => inspection.DestinationWarehouseIdText = value)"
                                                          Options="@SellableWarehouseOptions" Size="ControlSize.Small" />
                                            }
                                        </UiGrid>
                                        <UiWorkspaceActionBar>
                                            <UiButton Text="حفظ نتيجة الفحص" IconCssClass="fa-solid fa-shield-check"
                                                      Size="ControlSize.Small" Loading="@_busy" OnClick="@(() => InspectLineAsync(line))" />
                                        </UiWorkspaceActionBar>
                                    </UiCard>
                                }
                            }
                        </UiStackLayout>
                    </UiCard>
                </UiStackLayout>
            </UiCard>
        }
    </Aside>
</UiWorkspaceLayout>

@code {
    private PagedResult<SalesReturnDto> _page = new();
    private SalesReturnDto? _selected;
    private SalesInvoiceDto? _sourceInvoice;
    private IReadOnlyList<SalesInvoiceDto> _postedInvoices = [];
    private IReadOnlyList<SalesWarehouseLookupDto> _returnWarehouses = [];
    private readonly List<ReturnLineForm> _returnLines = [];
    private readonly Dictionary<Guid, InspectionLineForm> _inspectionForms = [];
    private bool _creating;
    private bool _busy;
    private int _pageNumber = 1;
    private string? _search;
    private string? _invoiceIdText;
    private DateOnly? _returnDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _postingDate = DateOnly.FromDateTime(DateTime.Today);
    private string? _reason;
    private bool _overrideReturnWindow;
    private string? _returnWindowOverrideReason;
    private SalesReturnCreationPolicyDto? _returnPolicy;

    private IReadOnlyList<UiSelectOption> InvoiceOptions => _postedInvoices
        .Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.InvoiceCode} - {x.CustomerName ?? x.CustomerCode ?? "عميل"}"))
        .ToArray();

    private static readonly IReadOnlyList<UiSelectOption> StandardConditions =
    [
        new(nameof(SalesReturnCondition.Resellable), "قابل لإعادة البيع"),
        new(nameof(SalesReturnCondition.NeedsInspection), "يحتاج فحص"),
        new(nameof(SalesReturnCondition.Damaged), "تالف / متضرر")
    ];
    private static readonly IReadOnlyList<UiSelectOption> QuarantineConditions =
    [
        new(nameof(SalesReturnCondition.NeedsInspection), "يحتاج فحص"),
        new(nameof(SalesReturnCondition.Damaged), "تالف / متضرر")
    ];
    private static readonly IReadOnlyList<UiSelectOption> StandardDispositions =
    [
        new(nameof(SalesReturnStockDisposition.Restock), "إعادة للمخزون القابل للبيع"),
        new(nameof(SalesReturnStockDisposition.Quarantine), "حجر وفحص")
    ];
    private static readonly IReadOnlyList<UiSelectOption> MandatoryQuarantine =
    [new(nameof(SalesReturnStockDisposition.Quarantine), "حجر وفحص")];
    private static readonly IReadOnlyList<UiSelectOption> InspectionConditionOptions =
    [
        new(nameof(SalesReturnCondition.Resellable), "قابل لإعادة البيع — تسريح"),
        new(nameof(SalesReturnCondition.NeedsInspection), "يبقى تحت الفحص"),
        new(nameof(SalesReturnCondition.Damaged), "تالف / يبقى في الحجر")
    ];

    private IReadOnlyList<UiSelectOption> ConditionOptionsFor(ReturnLineForm line) =>
        line.RequiresQualityInspection ? QuarantineConditions : StandardConditions;
    private IReadOnlyList<UiSelectOption> DispositionOptionsFor(ReturnLineForm line) =>
        line.RequiresQualityInspection || line.ReturnConditionText != nameof(SalesReturnCondition.Resellable)
            ? MandatoryQuarantine : StandardDispositions;

    private IReadOnlyList<SalesWarehouseLookupDto> EligibleWarehouses(ReturnLineForm line) =>
        _returnWarehouses.Where(x => x.IsActive &&
            (line.StockDispositionText == nameof(SalesReturnStockDisposition.Quarantine)
                ? !x.AllowsSalesAllocation : x.AllowsSalesAllocation)).ToArray();

    private IReadOnlyList<UiSelectOption> WarehouseOptionsFor(ReturnLineForm line) => EligibleWarehouses(line)
        .Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.Code} - {x.Name}"))
        .ToArray();
    private IReadOnlyList<UiSelectOption> SellableWarehouseOptions => _returnWarehouses
        .Where(x => x.IsActive && x.AllowsSalesAllocation)
        .Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.Code} - {x.Name}"))
        .ToArray();

    // Invalid historical dates are never sent to the API. No under-field error rendering.
    private DateOnly EarliestDate => _returnPolicy?.EarliestReturnDate ?? _sourceInvoice?.PostingDate ?? DateOnly.FromDateTime(DateTime.Today);
    private void OnReturnDateChanged(DateOnly? date)
    {
        _returnDate = Later(date ?? EarliestDate, EarliestDate);
        SynchronizePostingDate();
    }
    private void OnPostingDateChanged(DateOnly? date)
    {
        _postingDate = Later(date ?? _returnDate ?? EarliestDate,
            Later(EarliestDate, _returnDate ?? EarliestDate));
    }
    private static DateOnly Later(DateOnly a, DateOnly b) => a > b ? a : b;
    private void SynchronizePostingDate()
    {
        if (_returnDate.HasValue)
            _postingDate = Later(_postingDate ?? _returnDate.Value,
                Later(_returnDate.Value, EarliestDate));
    }
    private void NormalizeDates()
    {
        if (_sourceInvoice is null) return;
        _returnDate = Later(_returnDate ?? EarliestDate, EarliestDate);
        SynchronizePostingDate();
    }

    private void EnsureWarehouse(ReturnLineForm line)
    {
        if (!line.RequiresInventory) return;
        var eligible = EligibleWarehouses(line);
        if (Guid.TryParse(line.ReturnWarehouseIdText, out var selected) && eligible.Any(x => x.Id == selected)) return;
        // Prefer the source warehouse when it is suitable; otherwise pick the first valid one.
        var warehouse = eligible.FirstOrDefault(x => x.Id == line.Line.WarehouseId) ?? eligible.FirstOrDefault();
        line.ReturnWarehouseIdText = warehouse?.Id.ToString("D");
    }
    private void OnLineSelected(ReturnLineForm line, bool selected)
    {
        line.Selected = selected;
        if (selected) EnsureWarehouse(line);
    }
    private void OnReturnWarehouseChanged(ReturnLineForm line, string? value)
    {
        line.ReturnWarehouseIdText = value;
        EnsureWarehouse(line);
    }
    private void OnConditionChanged(ReturnLineForm line, string? value)
    {
        line.ReturnConditionText = line.RequiresQualityInspection
            ? (value == nameof(SalesReturnCondition.Damaged) ? nameof(SalesReturnCondition.Damaged) : nameof(SalesReturnCondition.NeedsInspection))
            : (value ?? nameof(SalesReturnCondition.NeedsInspection));
        if (line.ReturnConditionText != nameof(SalesReturnCondition.Resellable))
            line.StockDispositionText = nameof(SalesReturnStockDisposition.Quarantine);
        EnsureWarehouse(line);
    }
    private void OnDispositionChanged(ReturnLineForm line, string? value)
    {
        line.StockDispositionText = line.RequiresQualityInspection ||
            line.ReturnConditionText != nameof(SalesReturnCondition.Resellable)
            ? nameof(SalesReturnStockDisposition.Quarantine)
            : value == nameof(SalesReturnStockDisposition.Quarantine)
                ? nameof(SalesReturnStockDisposition.Quarantine)
                : nameof(SalesReturnStockDisposition.Restock);
        EnsureWarehouse(line);
    }
    private void OnInspectionConditionChanged(InspectionLineForm form, string? value)
    {
        form.ConditionText = value ?? nameof(SalesReturnCondition.NeedsInspection);
        if (form.ConditionText != nameof(SalesReturnCondition.Resellable)) form.DestinationWarehouseIdText = null;
        else if (!Guid.TryParse(form.DestinationWarehouseIdText, out var id) ||
                 !_returnWarehouses.Any(x => x.Id == id && x.IsActive && x.AllowsSalesAllocation))
            form.DestinationWarehouseIdText = _returnWarehouses.FirstOrDefault(x => x.IsActive && x.AllowsSalesAllocation)?.Id.ToString("D");
    }

    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            _page = await Sales.GetSalesReturnsPageAsync(new PageRequest { PageNumber = _pageNumber, PageSize = 20, Search = _search });
            if (_selected is not null)
            {
                _selected = await Sales.GetSalesReturnByIdAsync(_selected.Id);
                SyncInspectionForms();
            }
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
    private async Task SearchAsync(string? text) { _search = text; _pageNumber = 1; await RefreshAsync(); }
    private async Task PreviousAsync() { if (_pageNumber > 1) { _pageNumber--; await RefreshAsync(); } }
    private async Task NextAsync() { if (_page.HasNextPage) { _pageNumber++; await RefreshAsync(); } }
    private async Task SelectAsync(Guid id)
    {
        _creating = false;
        _busy = true;
        try
        {
            var selection = Sales.GetSalesReturnByIdAsync(id);
            var warehouses = Sales.SearchWarehousesAsync(null, null, 100, true);
            await Task.WhenAll(selection, warehouses);
            _selected = selection.Result;
            _returnWarehouses = warehouses.Result.Where(x => x.IsActive).ToArray();
            SyncInspectionForms();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
    private async Task BeginCreateAsync()
    {
        _creating = true;
        _selected = null;
        _sourceInvoice = null;
        _returnPolicy = null;
        _returnLines.Clear();
        _invoiceIdText = null;
        _reason = null;
        _overrideReturnWindow = false;
        _returnWindowOverrideReason = null;
        _returnDate = DateOnly.FromDateTime(DateTime.Today);
        _postingDate = _returnDate;
        _busy = true;
        try
        {
            var invoices = Sales.GetSalesInvoicesPageAsync(new PageRequest { PageNumber = 1, PageSize = 200, SortBy = "invoiceDate", SortDirection = SortDirection.Descending });
            var warehouses = Sales.SearchWarehousesAsync(null, null, 100, true);
            await Task.WhenAll(invoices, warehouses);
            _postedInvoices = invoices.Result.Items.Where(x => x.Status == SalesInvoiceStatus.Posted).ToArray();
            _returnWarehouses = warehouses.Result.Where(x => x.IsActive).ToArray();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
    private async Task InvoiceChangedAsync(string? value)
    {
        _invoiceIdText = value;
        _sourceInvoice = null;
        _returnPolicy = null;
        _returnLines.Clear();
        if (!Guid.TryParse(value, out var id)) return;
        _busy = true;
        try
        {
            var invoiceTask = Sales.GetSalesInvoiceByIdAsync(id);
            var policyTask = ApiClient.GetAsync<SalesReturnCreationPolicyDto>(
                $"api/sales/returns/invoices/{id:D}/return-policy");
            await Task.WhenAll(invoiceTask, policyTask);
            _sourceInvoice = invoiceTask.Result;
            _returnPolicy = policyTask.Result;
            if (_sourceInvoice is null || _returnPolicy is null) return;
            if (!_returnPolicy.CanCreate)
            {
                Snackbar.Error(_returnPolicy.Reason ?? "الفاتورة غير متاحة للإرجاع.");
                _sourceInvoice = null;
                return;
            }
            NormalizeDates();
            foreach (var line in _sourceInvoice.Lines.Where(x => x.IsActive))
            {
                var remaining = Math.Max(0m, line.Quantity - line.ReturnedQuantity);
                var form = new ReturnLineForm(line, remaining);
                EnsureWarehouse(form);
                _returnLines.Add(form);
            }
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private async Task CreateAsync()
    {
        if (_sourceInvoice is null || !_returnDate.HasValue || !_postingDate.HasValue)
        {
            Snackbar.Error("اختر فاتورة وحدد التاريخ.");
            return;
        }
        NormalizeDates();
        if (_returnPolicy is not null && !_returnPolicy.CanCreate)
        {
            Snackbar.Error(_returnPolicy.Reason ?? "الفاتورة غير قابلة للإرجاع.");
            return;
        }
        if (_returnPolicy?.LastReturnDateWithoutOverride is { } until && _returnDate.Value > until)
        {
            if (!_overrideReturnWindow)
            {
                Snackbar.Error("انتهت مدة الإرجاع النظامية. يلزم تجاوز مصرح به.");
                return;
            }
            if (string.IsNullOrWhiteSpace(_returnWindowOverrideReason))
            {
                Snackbar.Error("سجّل سبب تجاوز مدة الإرجاع.");
                return;
            }
        }
        var lines = new List<CreateSalesReturnLineRequest>();
        foreach (var form in _returnLines.Where(x => x.Selected))
        {
            if (!decimal.TryParse(form.QuantityText, out var quantity) || quantity <= 0m || quantity > form.Remaining)
            {
                Snackbar.Error($"تحقق من كمية السطر {form.Line.LineNumber}؛ الحد الأقصى {form.Remaining:N3}.");
                return;
            }
            Guid? warehouseId = null;
            SalesReturnCondition? condition = null;
            SalesReturnStockDisposition? disposition = null;
            if (form.RequiresInventory)
            {
                EnsureWarehouse(form);
                if (!Guid.TryParse(form.ReturnWarehouseIdText, out var parsedWarehouseId) ||
                    !EligibleWarehouses(form).Any(x => x.Id == parsedWarehouseId))
                {
                    Snackbar.Error($"لا يوجد مخزن مناسب لقرار السطر {form.Line.LineNumber}؛ جهّز مخزنًا نشطًا ملائمًا أولًا.");
                    return;
                }
                warehouseId = parsedWarehouseId;
                if (!Enum.TryParse(form.ReturnConditionText, out SalesReturnCondition parsedCondition) ||
                    !Enum.TryParse(form.StockDispositionText, out SalesReturnStockDisposition parsedDisposition))
                {
                    Snackbar.Error($"راجع حالة المخزون للسطر {form.Line.LineNumber}.");
                    return;
                }
                condition = parsedCondition;
                disposition = parsedDisposition;
            }
            lines.Add(new CreateSalesReturnLineRequest(form.Line.Id, quantity, warehouseId, condition, disposition));
        }
        if (lines.Count == 0) { Snackbar.Error("حدد سطرًا واحدًا على الأقل."); return; }
        _busy = true;
        try
        {
            var request = new CreateSalesReturnRequest(_sourceInvoice.Id, _returnDate.Value, _postingDate.Value,
                _reason, lines, _overrideReturnWindow, _returnWindowOverrideReason);
            var result = await Sales.CreateSalesReturnResultAsync(request);
            if (!TryGetApiResult(result, out var created)) return;
            if (created is not null)
            {
                _creating = false;
                _selected = created;
                _pageNumber = 1;
                Snackbar.Success("تم إنشاء مرتجع المبيعات.");
                await RefreshAsync();
            }
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
    private async Task ConfirmAsync()
    {
        if (_selected is null) return;
        await RunSelectedActionAsync(async () => await Sales.ConfirmSalesReturnResultAsync(
            _selected.Id, new SalesReturnActionRequest(_selected.RowVersion)), "تم تأكيد المرتجع.");
    }
    private async Task PostAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            // Non-mutating preflight: invalid historical accounts/periods produce a single snackbar,
            // instead of triggering an expected ConflictException in the posting command debugger.
            var readiness = await ApiClient.GetAsync<SalesReturnPostingReadinessDto>(
                $"api/sales/returns/{_selected.Id:D}/posting-readiness");
            if (readiness is null) { Snackbar.Error("تعذر التحقق من جاهزية المرتجع."); return; }
            if (!readiness.CanPost)
            {
                Snackbar.Error(string.Join(" | ", readiness.Issues.Select(x => x.Message).Distinct()));
                return;
            }
            var call = await Sales.PostSalesReturnResultAsync(_selected.Id, new SalesReturnActionRequest(_selected.RowVersion));
            if (!TryGetApiResult(call, out _)) return;
            _selected = await Sales.GetSalesReturnByIdAsync(_selected.Id);
            Snackbar.Success("تم ترحيل المرتجع.");
            await RefreshAsync();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
    private async Task CancelAsync()
    {
        if (_selected is null) return;
        await RunSelectedActionAsync(async () => await Sales.CancelSalesReturnResultAsync(
            _selected.Id, new CancelSalesReturnRequest(_selected.RowVersion, "إلغاء من واجهة مرتجعات المبيعات")),
            "تم إلغاء المرتجع.");
    }
    private InspectionLineForm GetInspectionForm(Guid id)
    {
        if (_inspectionForms.TryGetValue(id, out var form)) return form;
        form = new InspectionLineForm();
        _inspectionForms[id] = form;
        return form;
    }
    private void SyncInspectionForms()
    {
        if (_selected is null) return;
        var quarantined = _selected.Lines.Where(x => x.StockDisposition == SalesReturnStockDisposition.Quarantine)
            .Select(x => x.Id).ToHashSet();
        foreach (var id in _inspectionForms.Keys.Where(x => !quarantined.Contains(x)).ToArray()) _inspectionForms.Remove(id);
        foreach (var id in quarantined) _ = GetInspectionForm(id);
    }
    private async Task InspectLineAsync(SalesReturnLineDto line)
    {
        if (_selected is null) return;
        var form = GetInspectionForm(line.Id);
        if (!Enum.TryParse(form.ConditionText, out SalesReturnCondition condition) || condition == SalesReturnCondition.Unknown)
        { Snackbar.Error("حدد نتيجة الفحص."); return; }
        var disposition = condition == SalesReturnCondition.Resellable
            ? SalesReturnStockDisposition.Restock : SalesReturnStockDisposition.Quarantine;
        Guid? destinationId = null;
        if (disposition == SalesReturnStockDisposition.Restock)
        {
            if (!Guid.TryParse(form.DestinationWarehouseIdText, out var parsedWarehouseId) ||
                !_returnWarehouses.Any(x => x.Id == parsedWarehouseId && x.IsActive && x.AllowsSalesAllocation))
            { Snackbar.Error("جهّز مخزن بيع نشطًا قبل تسريح البضاعة."); return; }
            destinationId = parsedWarehouseId;
        }
        _busy = true;
        try
        {
            var call = await Sales.InspectSalesReturnLineResultAsync(_selected.Id, line.Id,
                new InspectSalesReturnLineRequest(line.RowVersion, condition, disposition, destinationId));
            if (!TryGetApiResult(call, out var result)) return;
            if (result is not null) _selected = result;
            SyncInspectionForms();
            Snackbar.Success(disposition == SalesReturnStockDisposition.Restock
                ? "تم الفحص والتسريح للمخزون القابل للبيع." : "تم تسجيل الفحص وبقي الصنف في الحجر.");
            await RefreshAsync();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
    private async Task RunSelectedActionAsync(Func<Task<ApiCallResult<SalesReturnDto>>> action, string message)
    {
        _busy = true;
        try
        {
            var result = await action();
            if (!TryGetApiResult(result, out var value)) return;
            if (value is not null) _selected = value;
            Snackbar.Success(message);
            await RefreshAsync();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
    private bool TryGetApiResult<T>(ApiCallResult<T> result, out T? value)
    {
        value = result.Value;
        if (result.Succeeded) return true;
        if (result.Error is not null) ApiFeedback.Show(result.Error);
        else ApiFeedback.ShowUnexpected();
        return false;
    }
    private Task CloseEditorAsync() { _creating = false; return Task.CompletedTask; }
    private static string StatusText(SalesReturnStatus status) => status switch
    {
        SalesReturnStatus.Draft => "مسودة", SalesReturnStatus.Confirmed => "مؤكد",
        SalesReturnStatus.Posted => "مرحل", SalesReturnStatus.Cancelled => "ملغي", _ => status.ToString()
    };
    private static AlertTone StatusTone(SalesReturnStatus status) => status switch
    {
        SalesReturnStatus.Posted => AlertTone.Success, SalesReturnStatus.Cancelled => AlertTone.Danger,
        SalesReturnStatus.Confirmed => AlertTone.Warning, _ => AlertTone.Info
    };
    private static string ReturnConditionText(SalesReturnCondition? condition) => condition switch
    {
        SalesReturnCondition.Resellable => "قابل لإعادة البيع", SalesReturnCondition.NeedsInspection => "يحتاج فحص",
        SalesReturnCondition.Damaged => "تالف / متضرر", _ => "غير محدد"
    };
    private static string StockDispositionText(SalesReturnStockDisposition? disposition) => disposition switch
    {
        SalesReturnStockDisposition.Restock => "إعادة للمخزون", SalesReturnStockDisposition.Quarantine => "حجر وفحص",
        SalesReturnStockDisposition.Dispose => "إتلاف", SalesReturnStockDisposition.NoStock => "بدون حركة مخزون", _ => "غير محدد"
    };
    private sealed class InspectionLineForm
    {
        public string ConditionText { get; set; } = nameof(SalesReturnCondition.NeedsInspection);
        public string? DestinationWarehouseIdText { get; set; }
    }
    private sealed class ReturnLineForm(SalesInvoiceLineDto line, decimal remaining)
    {
        public SalesInvoiceLineDto Line { get; } = line;
        public decimal Remaining { get; } = remaining;
        public bool RequiresInventory { get; } = line.LineType != SalesLineType.Service && line.ProductVariantId.HasValue && line.WarehouseId.HasValue;
        public bool Selected { get; set; }
        public string QuantityText { get; set; } = remaining > 0m ? Math.Min(remaining, line.Quantity).ToString("0.###") : "0";
        public bool RequiresQualityInspection { get; } = line.LineType == SalesLineType.Lens && (line.RequiresProduction || line.PrescriptionSnapshot is not null);
        public string ReturnConditionText { get; set; } = line.LineType == SalesLineType.Lens && (line.RequiresProduction || line.PrescriptionSnapshot is not null)
            ? nameof(SalesReturnCondition.NeedsInspection) : nameof(SalesReturnCondition.Resellable);
        public string StockDispositionText { get; set; } = line.LineType == SalesLineType.Lens && (line.RequiresProduction || line.PrescriptionSnapshot is not null)
            ? nameof(SalesReturnStockDisposition.Quarantine) : nameof(SalesReturnStockDisposition.Restock);
        public string? ReturnWarehouseIdText { get; set; } = line.LineType == SalesLineType.Lens && (line.RequiresProduction || line.PrescriptionSnapshot is not null)
            ? null : line.WarehouseId?.ToString("D");
    }
}
