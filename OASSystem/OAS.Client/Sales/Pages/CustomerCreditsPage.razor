@page "/sales/customer-credits/{CustomerId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using OAS.Contracts.Sales.Returns
@using OAS.Contracts.Sales.SalesInvoices
@using OAS.Contracts.Common.Pagination
@using OAS.Client.Services.Http
@using OAS.Contracts.Accounting.CashAccounts
@using OAS.Contracts.Accounting.BankAccounts
@using OAS.Contracts.Accounting.Currencies
@using OAS.Client.Accounting.Services
@using OAS.Client.Accounting.Components
@using OAS.UiLib.Services.Feedback
@using OAS.Client.Common.Feedback.Services
@inject OasApiClient Api
@inject IAccountingClientService Accounting
@inject IUiSnackbarService Snackbar
@inject IApiFeedbackService ApiFeedback

<PageTitle>تطبيق مرتجعات العميل | OAS</PageTitle>

<div class="customer-credit-page" dir="rtl">
    <CustomerRelatedPageHeader CustomerId="@CustomerId" Title="تطبيق مرتجعات العميل" Subtitle="تطبيق رصيد مرتجع مرحّل على فاتورة أو رد المبلغ للعميل">
        <Actions>
            <a class="cc-button cc-button--quiet" href="@($"/accounting/customers/{CustomerId:D}/account")">العودة إلى ملف العميل</a>
            <button type="button" class="cc-button cc-button--quiet" @onclick="ReloadAsync" disabled="@_busy">تحديث البيانات</button>
        </Actions>
    </CustomerRelatedPageHeader>

    @if (_state is null)
    {
        @if (_busy)
        {
            <div class="cc-loading-card"><span class="cc-spinner" aria-hidden="true"></span><div><strong>جارٍ تحميل أرصدة المرتجعات</strong><p>يتم التحقق من الرصيد والفواتير وحسابات الصندوق والبنك.</p></div></div>
        }
        else
        {
            <div class="cc-loading-card" role="alert">تعذر تحميل بيانات المرتجعات. تحقق من الاتصال ثم اضغط «تحديث البيانات».</div>
        }
    }
    else
    {
        <section class="cc-summary-grid" aria-label="ملخص الرصيد الدائن">
            <article class="cc-summary-card"><div><span>إجمالي الرصيد المكتسب</span><small>قيمة أرصدة المرتجعات</small></div><strong>@_state.EarnedBase.ToString("N2")</strong></article>
            <article class="cc-summary-card"><div><span>الرصيد المستخدم</span><small>التطبيقات والاستردادات المسجلة</small></div><strong>@_state.ConsumedBase.ToString("N2")</strong></article>
            <article class="cc-summary-card cc-summary-card--available"><div><span>الرصيد المتاح</span><small>يمكن تسويته حسب الضوابط</small></div><strong>@_state.AvailableBase.ToString("N2")</strong></article>
        </section>

        <section class="cc-panel">
            <div class="cc-panel-heading"><div><h2>تسوية رصيد مرتجع مرحّل</h2><p>اختر المرتجع وطريقة التسوية. لن يسمح النظام باستخدام الرصيد نفسه أكثر من مرة.</p></div><span class="cc-step-badge">1 <span>بيانات التسوية</span></span></div>
            <div class="cc-form-grid">
                <label class="cc-field cc-field--wide"><span>المرتجع الذي يحتوي على رصيد متاح <b>*</b></span>
                    <select class="cc-control" @bind="_returnId">
                        <option value="@Guid.Empty">اختر مرتجعًا</option>
                        @foreach (var x in _state.Returns.Where(x => RemainingCredit(x.SalesReturnId, x.EstimatedUnappliedBaseCredit) > 0m))
                        {
                            <option value="@x.SalesReturnId">@x.ReturnCode — متاح @RemainingCredit(x.SalesReturnId, x.EstimatedUnappliedBaseCredit).ToString("N2") @x.BaseCurrencyCode</option>
                        }
                    </select>
                    @if (!_state.Returns.Any(x => RemainingCredit(x.SalesReturnId, x.EstimatedUnappliedBaseCredit) > 0m)) { <small class="cc-help">لا يوجد مرتجع برصيد متاح حاليًا.</small> }
                </label>
                <label class="cc-field"><span>طريقة التسوية <b>*</b></span>
                    <select class="cc-control" @bind="_action">
                        <option value="apply">تطبيق على فاتورة أخرى</option>
                        <option value="refund">رد المبلغ للعميل</option>
                    </select>
                </label>

                @if (_action == "apply")
                {
                    <label class="cc-field cc-field--wide"><span>الفاتورة المستهدفة <b>*</b></span>
                        <select class="cc-control" @bind="_invoiceId">
                            <option value="@Guid.Empty">اختر فاتورة مفتوحة للعميل</option>
                            @foreach (var invoice in _invoices.Where(i => i.PaymentSummary.OutstandingAmount > 0m))
                            {
                                <option value="@invoice.Id">@invoice.InvoiceCode — المتبقي @invoice.PaymentSummary.OutstandingAmount.ToString("N2") @invoice.CurrencyCodeSnapshot</option>
                            }
                        </select>
                        <small class="cc-help">تظهر الفواتير التابعة لهذا العميل فقط. اختر الصفحة المطلوبة إذا لم تجد الفاتورة.</small>
                    </label>
                    <div class="cc-invoice-pager">
                        <span>صفحة @_invoicePage من @Math.Max(1L, (_invoiceTotal + InvoicePageSize - 1) / InvoicePageSize)</span>
                        <div><button type="button" class="cc-button cc-button--quiet" disabled="@(_busy || _invoicePage <= 1)" @onclick="PreviousInvoicesAsync">السابق</button><button type="button" class="cc-button cc-button--quiet" disabled="@(_busy || (long)_invoicePage * InvoicePageSize >= _invoiceTotal)" @onclick="NextInvoicesAsync">التالي</button></div>
                    </div>
                    @if (!_invoices.Any(i => i.PaymentSummary.OutstandingAmount > 0m)) { <div class="cc-inline-note">لا توجد فاتورة مفتوحة في الصفحة الحالية؛ انتقل للصفحة التالية أو اختر رد المبلغ.</div> }
                }
                else
                {
                    <label class="cc-field"><span>طريقة رد المبلغ <b>*</b></span>
                        <select class="cc-control" value="@_method" @onchange="OnMethodChanged"><option value="1">نقدًا</option><option value="3">حوالة بنكية</option></select>
                    </label>
                    <label class="cc-field"><span>عملة رد المبلغ <b>*</b></span>
                        <select class="cc-control" value="@_currencyId" @onchange="OnCurrencyChanged">
                            <option value="@Guid.Empty">اختر العملة</option>
                            @foreach (var x in _currencies.Where(x => x.IsActive)) { <option value="@x.Id">@x.Code — @x.NameAr</option> }
                        </select>
                    </label>
                    @if (_method == 1)
                    {
                        <label class="cc-field"><span>الصندوق <b>*</b></span>
                            <select class="cc-control" @bind="_selectedCash">
                                <option value="@Guid.Empty">اختر الصندوق</option>
                                @foreach (var account in AvailableCashAccounts) { <option value="@account.Id">@account.Code — @account.Name</option> }
                            </select>
                            @if (_currencyId != Guid.Empty && AvailableCashAccounts.Count == 0)
                            {
                                <small class="cc-help">لا يوجد صندوق نشط مربوط بهذه العملة.</small>
                            }
                        </label>
                    }
                    else
                    {
                        <label class="cc-field"><span>الحساب البنكي <b>*</b></span>
                            <select class="cc-control" @bind="_selectedBank">
                                <option value="@Guid.Empty">اختر الحساب البنكي</option>
                                @foreach (var account in AvailableBankAccounts) { <option value="@account.Id">@account.Code — @account.BankName (@account.AccountName)</option> }
                            </select>
                            @if (_currencyId != Guid.Empty && AvailableBankAccounts.Count == 0)
                            {
                                <small class="cc-help">لا يوجد حساب بنكي نشط مربوط بهذه العملة.</small>
                            }
                        </label>
                    }
                }

                <label class="cc-field"><span>@(_action == "apply" ? "المبلغ المراد تطبيقه بعملة الفاتورة" : "المبلغ المراد رده") <b>*</b></span>
                    <input class="cc-control" type="number" min="0.01" step="0.01" @bind="_amount" />
                    <small class="cc-help">الرصيد المتاح للمرتجع المختار بالعملة الأساسية: @SelectedReturnAvailableBase.ToString("N2"). يُفحص المبلغ وسعر الصرف قبل التنفيذ، مع بقاء تحقق الخادم النهائي.</small>
                </label>
            </div>
            <div class="cc-form-footer">
                <div class="cc-safety-note"><span aria-hidden="true">ⓘ</span><span>التطبيق يخفض رصيد فاتورة أخرى. أما رد المبلغ فينشئ سند استرداد وفق الصندوق أو البنك والعملة المحددة.</span></div>
                <button type="button" class="cc-button cc-button--primary cc-submit" disabled="@_busy" @onclick="SubmitAsync">@(_busy ? "جارٍ التنفيذ..." : _action == "apply" ? "تطبيق الرصيد" : "إنشاء سند الاسترداد وترحيله")</button>
            </div>
        </section>

        <section class="cc-panel">
            <div class="cc-panel-heading"><div><h2>سجل تسويات المرتجعات</h2><p>راجع عمليات تطبيق الرصيد أو رد المبلغ وحالة كل عملية.</p></div><span class="cc-record-count">@_state.Applications.Count عملية</span></div>
            <div class="cc-table-wrap">
                <table class="cc-table">
                    <thead><tr><th>التاريخ</th><th>رقم المرتجع</th><th>نوع التسوية</th><th>المبلغ الأساسي</th><th>الحالة</th><th>الإجراء</th></tr></thead>
                    <tbody>
                        @foreach (var x in _state.Applications)
                        {
                            <tr>
                                <td data-label="التاريخ">@x.AppliedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td data-label="رقم المرتجع"><span class="cc-code">@(_state.Returns.FirstOrDefault(r => r.SalesReturnId == x.SalesReturnId)?.ReturnCode ?? x.SalesReturnId.ToString("D"))</span></td>
                                <td data-label="نوع التسوية">@(x.SettlementKind == 1 ? "تطبيق على فاتورة" : "رد مبلغ")</td>
                                <td data-label="المبلغ الأساسي" class="cc-number">@x.AppliedSourceBaseAmount.ToString("N2")</td>
                                <td data-label="الحالة"><span class="cc-status @(x.Status == 1 ? "cc-status--active" : "cc-status--reversed")">@(x.Status == 1 ? "ساري" : "معكوس")</span></td>
                                <td data-label="الإجراء">@if (x.Status == 1 && x.SettlementKind == 1) { <button type="button" class="cc-button cc-button--danger" disabled="@_busy" @onclick="() => ReverseAsync(x)">عكس التطبيق</button> } else { <span class="cc-muted">—</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_state.Applications.Count == 0) { <div class="cc-empty-state">لا توجد تسويات مسجلة لهذا العميل حتى الآن.</div> }
        </section>
    }
</div>

@code {
    [Parameter] public Guid CustomerId { get; set; }
    private CustomerCreditBalanceDto? _state;
    private IReadOnlyList<SalesInvoiceDto> _invoices = [];
    private const int InvoicePageSize = 50;
    private int _invoicePage = 1;
    private long _invoiceTotal;
    private Guid _returnId, _invoiceId, _currencyId;
    private string _action = "apply", _error = "";
    private Guid _selectedCash, _selectedBank;
    private IReadOnlyList<CashAccountDto> _cash = [];
    private IReadOnlyList<BankAccountDto> _banks = [];
    private IReadOnlyList<CurrencyDto> _currencies = [];
    private decimal _amount;
    private byte _method = 1;
    private bool _busy;

    private CustomerReturnCreditItemDto? SelectedReturn =>
        _state?.Returns.FirstOrDefault(x => x.SalesReturnId == _returnId);

    private decimal SelectedReturnAvailableBase => SelectedReturn is { } selected
        ? RemainingCredit(selected.SalesReturnId, selected.EstimatedUnappliedBaseCredit)
        : 0m;

    private IReadOnlyList<CashAccountDto> AvailableCashAccounts =>
        _currencyId == Guid.Empty ? [] : _cash.Where(x => x.IsActive && x.CurrencyId == _currencyId).ToArray();

    private IReadOnlyList<BankAccountDto> AvailableBankAccounts =>
        _currencyId == Guid.Empty ? [] : _banks.Where(x => x.IsActive && x.CurrencyId == _currencyId).ToArray();

    private void OnCurrencyChanged(ChangeEventArgs args)
    {
        _currencyId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : Guid.Empty;
        _selectedCash = Guid.Empty;
        _selectedBank = Guid.Empty;
    }

    private void OnMethodChanged(ChangeEventArgs args)
    {
        _method = byte.TryParse(args.Value?.ToString(), out var method) ? method : (byte)1;
        _selectedCash = Guid.Empty;
        _selectedBank = Guid.Empty;
    }

    private bool Reject(string message)
    {
        _error = message;
        Snackbar.Warning(message);
        return false;
    }

    private void ShowFailure(Exception exception)
    {
        if (exception is ApiClientException apiError)
            ApiFeedback.Show(apiError.Error);
        else
            ApiFeedback.ShowUnexpected();
    }

    protected override async Task OnParametersSetAsync()
    {
        _invoicePage = 1;
        _invoiceId = Guid.Empty;
        _returnId = Guid.Empty;
        await ReloadAsync();
    }

    // The preview is gross credit. Only active applications consume it.
    private decimal RemainingCredit(Guid returnId, decimal gross) => Math.Max(0m,
        gross - (_state?.Applications.Where(a => a.SalesReturnId == returnId && a.Status == 1)
            .Sum(a => a.AppliedSourceBaseAmount) ?? 0m));

    private async Task LoadInvoicesAsync()
    {
        var page = await Api.GetAsync<PagedResult<SalesInvoiceDto>>(
            $"api/sales/customer-credit-target-invoices/{CustomerId:D}?pageNumber={_invoicePage}&pageSize={InvoicePageSize}");
        _invoices = page.Items;
        _invoiceTotal = page.TotalCount;
        _invoiceId = Guid.Empty; // Old page selection must never be applied to a new page.
    }

    private async Task PreviousInvoicesAsync()
    {
        if (_busy || _invoicePage <= 1) return;
        _busy = true;
        try { _invoicePage--; await LoadInvoicesAsync(); }
        catch (Exception ex) { ShowFailure(ex); _invoicePage++; }
        finally { _busy = false; }
    }

    private async Task NextInvoicesAsync()
    {
        if (_busy || (long)_invoicePage * InvoicePageSize >= _invoiceTotal) return;
        _busy = true;
        try { _invoicePage++; await LoadInvoicesAsync(); }
        catch (Exception ex) { ShowFailure(ex); _invoicePage--; }
        finally { _busy = false; }
    }

    private async Task<IReadOnlyList<T>> LoadAllPagesAsync<T>(
        Func<PageRequest, Task<PagedResult<T>>> fetch)
    {
        var result = new List<T>();
        for (var pageNumber = 1; ; pageNumber++)
        {
            var page = await fetch(new PageRequest
            {
                PageNumber = pageNumber,
                PageSize = PageRequest.MaximumPageSize
            });
            result.AddRange(page.Items);
            if (!page.HasNextPage) break;
        }
        return result;
    }

    private async Task ReloadAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = "";
        try
        {
            _state = await Api.GetAsync<CustomerCreditBalanceDto>($"api/sales/customer-credits/{CustomerId:D}");
            await LoadInvoicesAsync();
            _cash = await LoadAllPagesAsync<CashAccountDto>(request => Accounting.GetCashAccountsPageAsync(request));
            _banks = await LoadAllPagesAsync<BankAccountDto>(request => Accounting.GetBankAccountsPageAsync(request));
            _currencies = await LoadAllPagesAsync<CurrencyDto>(request => Accounting.GetCurrenciesPageAsync(request));
            if (_currencyId == Guid.Empty || !_currencies.Any(x => x.IsActive && x.Id == _currencyId))
                _currencyId = _state?.Returns.FirstOrDefault()?.CurrencyId ?? Guid.Empty;
            if (!AvailableCashAccounts.Any(x => x.Id == _selectedCash)) _selectedCash = Guid.Empty;
            if (!AvailableBankAccounts.Any(x => x.Id == _selectedBank)) _selectedBank = Guid.Empty;
        }
        catch (Exception ex)
        {
            _error = "تعذر تحديث بيانات تسويات العميل.";
            ShowFailure(ex);
        }
        finally { _busy = false; }
    }

    // No write is sent for predictable validation failures. The server's domain
    // guards remain the final authority for concurrent data and FX changes.
    private async Task<bool> ValidateSubmissionAsync()
    {
        if (_state is null || _returnId == Guid.Empty || _amount <= 0m)
            return Reject("اختر المرتجع وأدخل مبلغًا أكبر من صفر.");

        var source = SelectedReturn;
        if (source is null || SelectedReturnAvailableBase <= 0m)
            return Reject("هذا المرتجع ليس لديه رصيد متاح للتسوية.");

        if (_action == "apply")
        {
            var invoice = _invoices.FirstOrDefault(x => x.Id == _invoiceId && x.PaymentSummary.OutstandingAmount > 0m);
            if (invoice is null)
                return Reject("اختر فاتورة مفتوحة من القائمة الحالية.");
            if (invoice.Id == source.SalesInvoiceId)
                return Reject("المرتجع يُخفض فاتورته الأصلية تلقائيًا؛ اختر فاتورة أخرى.");
            if (invoice.BaseCurrencyId != source.BaseCurrencyId)
                return Reject("العملة الأساسية للفاتورة والمرتجع غير متطابقة.");

            var amount = Math.Round(_amount, invoice.CurrencyDecimalPlacesSnapshot, MidpointRounding.AwayFromZero);
            var baseAmount = Math.Round(amount * invoice.ExchangeRate,
                invoice.BaseCurrencyDecimalPlacesSnapshot, MidpointRounding.AwayFromZero);
            if (amount <= 0m || baseAmount <= 0m)
                return Reject("المبلغ أقل من الحد المسموح به لعملة الفاتورة.");
            if (baseAmount > SelectedReturnAvailableBase + 0.0001m)
                return Reject($"المبلغ يتجاوز رصيد المرتجع المتاح ({SelectedReturnAvailableBase:N2} {source.BaseCurrencyCode}).");
            // The client summary exposes the outstanding amount in invoice currency only.
            // The server independently validates the exact base-currency outstanding balance.
            if (amount > invoice.PaymentSummary.OutstandingAmount + 0.0001m)
                return Reject("المبلغ أكبر من المتبقي على الفاتورة المختارة.");
            return true;
        }

        if (_action != "refund")
            return Reject("طريقة التسوية غير صالحة.");

        var currency = _currencies.FirstOrDefault(x => x.Id == _currencyId && x.IsActive);
        if (currency is null)
            return Reject("اختر عملة نشطة لرد المبلغ.");
        if (_method == 1 && !AvailableCashAccounts.Any(x => x.Id == _selectedCash))
            return Reject("اختر صندوقًا نشطًا مطابقًا لعملة الاسترداد.");
        if (_method == 3 && !AvailableBankAccounts.Any(x => x.Id == _selectedBank))
            return Reject("اختر حسابًا بنكيًا نشطًا مطابقًا لعملة الاسترداد.");
        if (_method is not (1 or 3))
            return Reject("طريقة استرداد المبلغ غير صالحة.");

        // The refund command resolves an Accounting FX rate at the UTC voucher date.
        // Use the same rate and currency decimal rounding before posting.
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var rate = await Accounting.GetEffectiveExchangeRateAsync(_currencyId, today);
        if (rate is null || rate.Rate <= 0)
            return Reject("لا يتوفر سعر صرف فعّال للعملة المختارة اليوم.");

        var baseCurrency = _currencies.FirstOrDefault(x => x.Id == source.BaseCurrencyId);
        if (baseCurrency is null)
            return Reject("تعذر تحديد العملة الأساسية للمرتجع.");
        var transactionAmount = Math.Round(_amount, currency.DecimalPlaces, MidpointRounding.AwayFromZero);
        var baseAmountRefund = Math.Round(transactionAmount * rate.Rate,
            baseCurrency.DecimalPlaces, MidpointRounding.AwayFromZero);
        if (transactionAmount <= 0m || baseAmountRefund <= 0m)
            return Reject("المبلغ أقل من الحد المسموح به لعملة الاسترداد.");
        if (baseAmountRefund > SelectedReturnAvailableBase + 0.0001m)
            return Reject($"مبلغ الاسترداد بعد التحويل ({baseAmountRefund:N2} {source.BaseCurrencyCode}) يتجاوز رصيد المرتجع المتاح ({SelectedReturnAvailableBase:N2}).");
        return true;
    }

    private async Task SubmitAsync()
    {
        if (_busy || _state is null) return;
        _busy = true;
        _error = "";
        try
        {
            if (!await ValidateSubmissionAsync()) return;

            if (_action == "apply")
            {
                await Api.PostAsync<ApplyCustomerReturnCreditRequest, CustomerCreditSettlementDto>(
                    $"api/sales/customer-credits/{CustomerId:D}/apply",
                    new ApplyCustomerReturnCreditRequest(_returnId, _invoiceId, _amount, Guid.NewGuid().ToString("N")));
            }
            else
            {
                await Api.PostAsync<RefundCustomerReturnCreditRequest, CustomerCreditSettlementDto>(
                    $"api/sales/customer-credits/{CustomerId:D}/refund",
                    new RefundCustomerReturnCreditRequest(_returnId, _currencyId, _amount, _method,
                        _method == 1 ? _selectedCash : null, _method == 3 ? _selectedBank : null,
                        null, null, "استرداد رصيد مرتجع", Guid.NewGuid().ToString("N")));
            }
            Snackbar.Success("تمت التسوية بنجاح. راجع السند والقيود المرتبطة.");
            _amount = 0m;
            _returnId = Guid.Empty;
        }
        catch (Exception ex) { _error = "تعذر إتمام تسوية المرتجع."; ShowFailure(ex); }
        finally { _busy = false; }

        if (string.IsNullOrWhiteSpace(_error)) await ReloadAsync();
    }

    private async Task ReverseAsync(CustomerCreditSettlementDto x)
    {
        if (_busy) return;
        _busy = true;
        _error = "";
        try
        {
            await Api.PostAsync<ReverseCustomerReturnCreditRequest, CustomerCreditSettlementDto>(
                $"api/sales/customer-credits/{CustomerId:D}/applications/{x.Id:D}/reverse",
                new ReverseCustomerReturnCreditRequest(x.RowVersion, "عكس تطبيق الرصيد الدائن"));
            Snackbar.Success("تم عكس تطبيق الرصيد.");
        }
        catch (Exception ex) { _error = "تعذر عكس تسوية المرتجع."; ShowFailure(ex); }
        finally { _busy = false; }
        if (string.IsNullOrWhiteSpace(_error)) await ReloadAsync();
    }
}
