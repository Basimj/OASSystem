            <UiSelect Label="حالة السنة"
                      Value="@StatusValue"
                      ValueExpression="@(() => StatusValue)"
                      ValueChanged="OnStatusChanged"
                      Options="@AccountingArabicPresenter.FiscalYearStatusOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            @if (!string.IsNullOrWhiteSpace(RowVersion))
            {
                <UiInputText Label="إصدار السجل (RowVersion)"
                             Value="@RowVersion"
                             ValueExpression="@(() => RowVersion)"
                             ReadOnly="true"
                             Disabled="true"
                             Size="ControlSize.Small" />
            }

        </div>

    </UiAccountingFormSection>

</div>


@code {

    public sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public DateOnly? StartDate { get; set; }

        public DateOnly? EndDate { get; set; }

        public FiscalYearStatus Status { get; set; } = FiscalYearStatus.Open;
    }


    [Parameter]
    public FormModel Model { get; set; } = new()
    {
        StartDate = new DateOnly(DateTime.Today.Year, 1, 1),
        EndDate = new DateOnly(DateTime.Today.Year, 12, 31)
    };


    [Parameter]
    public bool IsEditable { get; set; }


    [Parameter]
    public bool IsNew { get; set; }


    [Parameter]
    public string? RowVersion { get; set; }


    [Parameter]
    public EventCallback OnModelChanged { get; set; }


    private string StatusValue
    {
        get => Model.Status.ToString();
        set
        {
            if (Enum.TryParse<FiscalYearStatus>(value, out var result))
            {
                Model.Status = result;
            }
        }
    }


    private Task OnChanged()
        => OnModelChanged.InvokeAsync();


    private async Task OnCodeChanged(string? value)
    {
        Model.Code = value ?? string.Empty;
        await OnChanged();
    }


    private async Task OnNameChanged(string? value)
    {
        Model.Name = value ?? string.Empty;
        await OnChanged();
    }


    private async Task OnStartDateChanged(DateOnly? value)
    {
        Model.StartDate = value;
        await OnChanged();
    }


    private async Task OnEndDateChanged(DateOnly? value)
    {
        Model.EndDate = value;
        await OnChanged();
    }


    private async Task OnStatusChanged(string? value)
    {
        if (Enum.TryParse<FiscalYearStatus>(
                value,
                out var result))
        {
            Model.Status = result;
            await OnChanged();
        }
    }
}