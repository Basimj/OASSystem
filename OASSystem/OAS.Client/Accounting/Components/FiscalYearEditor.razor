@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface>

    <UiAccountingFormSection Title="بيانات السنة المالية"
                             Subtitle="الرمز، الاسم، وتحديد فترة الدورة المحاسبية"
                             IconCssClass="fa-solid fa-calendar-days">

        <UiAccountingFormGrid Columns="2">

            <UiInputText Label="كود السنة المالية"
                         @bind-Value="Model.Code"
                         @bind-Value:after="NotifyModelChangedAsync"
                         Required="true"
                         Placeholder="مثال: FY-2026"
                         ReadOnly="@(!IsNew)"
                         Disabled="@(!IsEditable || !IsNew)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم السنة المالية"
                         @bind-Value="Model.Name"
                         @bind-Value:after="NotifyModelChangedAsync"
                         Required="true"
                         Placeholder="مثال: السنة المالية 2026"
                         Disabled="@(!CanEditDetails)"
                         Size="ControlSize.Small" />

            <UiInputDate Label="تاريخ بداية السنة"
                         @bind-Value="Model.StartDate"
                         @bind-Value:after="NotifyModelChangedAsync"
                         Required="true"
                         Disabled="@(!CanEditDetails)"
                         Size="ControlSize.Small" />

            <UiInputDate Label="تاريخ نهاية السنة"
                         @bind-Value="Model.EndDate"
                         @bind-Value:after="NotifyModelChangedAsync"
                         Required="true"
                         Disabled="@(!CanEditDetails)"
                         Size="ControlSize.Small" />

        </UiAccountingFormGrid>

    </UiAccountingFormSection>

    <UiAccountingFormSection Title="حالة السنة المالية"
                             Subtitle="إدارة دورة السنة المالية"
                             IconCssClass="fa-solid fa-lock">

        <UiAccountingFormGrid Columns="2">

            <UiSelect Label="حالة السنة"
                      @bind-Value="StatusValue"
                      @bind-Value:after="NotifyModelChangedAsync"
                      Options="@AccountingArabicPresenter.FiscalYearStatusOptions"
                      Disabled="@(!CanEditWorkflow)"
                      Size="ControlSize.Small" />

            @if (!string.IsNullOrWhiteSpace(Model.RowVersion))
            {
                <UiInputText Label="إصدار السجل"
                             @bind-Value="Model.RowVersion"
                             ReadOnly="true"
                             Disabled="true"
                             Size="ControlSize.Small" />
            }

        </UiAccountingFormGrid>

    </UiAccountingFormSection>

</UiAccountingEditorSurface>

@code {
    public sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public DateOnly? StartDate { get; set; }

        public DateOnly? EndDate { get; set; }

        public FiscalYearStatus Status { get; set; } =
            FiscalYearStatus.Open;

        public FiscalYearStatus OriginalStatus { get; set; } =
            FiscalYearStatus.Future;

        public string RowVersion { get; set; } = string.Empty;
    }

    [Parameter]
    public FormModel Model { get; set; } = new()
    {
        StartDate = new DateOnly(
            DateTime.Today.Year,
            1,
            1),

        EndDate = new DateOnly(
            DateTime.Today.Year,
            12,
            31),

        Status = FiscalYearStatus.Open,

        OriginalStatus = FiscalYearStatus.Future
    };

    [Parameter]
    public bool IsEditable { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public EventCallback OnModelChanged { get; set; }

    private bool CanEditDetails
    {
        get
        {
            return IsEditable &&
                   (IsNew ||
                    Model.OriginalStatus ==
                    FiscalYearStatus.Future);
        }
    }

    private bool CanEditWorkflow
    {
        get
        {
            return IsEditable &&
                   Model.Status !=
                   FiscalYearStatus.Closed;
        }
    }

    private string StatusValue
    {
        get
        {
            return Model.Status.ToString();
        }
        set
        {
            if (Enum.TryParse<FiscalYearStatus>(
                    value,
                    true,
                    out var status))
            {
                Model.Status = status;
            }
        }
    }

    private Task NotifyModelChangedAsync()
    {
        return OnModelChanged.InvokeAsync();
    }
}