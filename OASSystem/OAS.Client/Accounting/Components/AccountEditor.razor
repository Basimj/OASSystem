@namespace OAS.Client.Accounting.Components

@using OAS.Contracts.Accounting.Accounts
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface AdditionalCssClass="ui-acc-account-editor">

    <UiAccountingFormSection Title="المعلومات الأساسية"
                             IconCssClass="fa-solid fa-file-lines"
                             AdditionalCssClass="ui-acc-account-editor__section ui-acc-account-editor__section--basic">

        <UiAccountingFormGrid Columns="3" AdditionalCssClass="ui-acc-account-editor__basic-grid">

            <UiInputText Label="رمز الحساب"
                         Value="@Model.Code"
                         ValueExpression="@(() => Model.Code)"
                         ValueChanged="OnCodeChanged"
                         Required="true"
                         MaxLength="30"
                         InputMode="numeric"
                         Placeholder="أدخل رقم الحساب"
                         ErrorText="@Model.CodeError"
                         ReadOnly="@(!IsNew)"
                         Disabled="@(!IsEditable || !IsNew)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم الحساب (بالعربية)"
                         Value="@Model.NameAr"
                         ValueExpression="@(() => Model.NameAr)"
                         ValueChanged="OnNameArChanged"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم الحساب (بالإنجليزية)"
                         Value="@Model.NameEn"
                         ValueExpression="@(() => Model.NameEn)"
                         ValueChanged="OnNameEnChanged"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiLookup Label="الحساب الأب"
                      Value='@Model.ParentAccountId?.ToString("D")'
                      ValueChanged="OnParentAccountChanged"
                      SelectedItem="@ParentAccountLookupItem"
                      SearchAsync="AccountSearchAsync"
                      Placeholder="ابحث عن الحساب الأب..."
                      Disabled="@(!IsEditable)"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />

            <UiAccountingReadOnlyValue Label="المستوى في الشجرة"
                                       Value="@Model.Level.ToString()" />

        </UiAccountingFormGrid>

    </UiAccountingFormSection>

    <UiAccountingFormSection Title="التصنيف المحاسبي"
                             IconCssClass="fa-solid fa-chart-pie"
                             AdditionalCssClass="ui-acc-account-editor__section ui-acc-account-editor__section--classification">

        <UiAccountingFormGrid Columns="3">

            <UiSelect Label="تصنيف الحساب"
                      Value="@Model.AccountClassValue"
                      ValueExpression="@(() => Model.AccountClassValue)"
                      ValueChanged="OnClassChanged"
                      Options="@AccountingArabicPresenter.AccountClassOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            <UiSelect Label="نوع الحساب"
                      Value="@Model.AccountTypeValue"
                      ValueExpression="@(() => Model.AccountTypeValue)"
                      ValueChanged="OnTypeChanged"
                      Options="@AccountingArabicPresenter.AccountTypeOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            <UiSelect Label="طبيعة الحساب"
                      Value="@Model.NormalBalanceValue"
                      ValueExpression="@(() => Model.NormalBalanceValue)"
                      ValueChanged="OnNormalBalanceChanged"
                      Options="@AccountingArabicPresenter.NormalBalanceOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

        </UiAccountingFormGrid>

    </UiAccountingFormSection>

    <UiAccountingFormGrid Columns="2" AdditionalCssClass="ui-acc-account-editor__lower-grid">

        <UiAccountingFormSection Title="الإعدادات والتشغيل"
                                 IconCssClass="fa-solid fa-gear"
                                 AdditionalCssClass="ui-acc-account-editor__section ui-acc-account-editor__section--settings">

            <UiAccountingCheckGroup>

                <UiCheckbox Label="يقبل الترحيل (حساب ترحيل)"
                            Value="@Model.IsPostingAccount"
                            ValueChanged="OnIsPostingAccountChanged"
                            Disabled="@(!CanChangePostingAccount)" />

                <UiCheckbox Label="السماح بالترحيل اليدوي"
                            Value="@Model.AllowManualPosting"
                            ValueChanged="OnAllowManualPostingChanged"
                            Disabled="@(!CanChangeManualPosting)" />

                <UiCheckbox Label="حساب تحكمي (أستاذ مساعد)"
                            Value="@Model.IsControlAccount"
                            ValueChanged="OnIsControlAccountChanged"
                            Disabled="@(!CanChangeControlAccount)" />

                <UiCheckbox Label="حساب نظامي (أساسي)"
                            Value="@Model.IsSystemAccount"
                            ValueChanged="OnIsSystemAccountChanged"
                            Disabled="@(!IsEditable || !IsNew)" />

            </UiAccountingCheckGroup>

        </UiAccountingFormSection>

        <UiAccountingFormSection Title="الربط والحالة"
                                 IconCssClass="fa-solid fa-link"
                                 AdditionalCssClass="ui-acc-account-editor__section ui-acc-account-editor__section--status">

            <UiAccountingFormGrid Columns="2">

                <UiInputDate Label="تاريخ السريان"
                             Value="@Model.EffectiveDate"
                             ValueExpression="@(() => Model.EffectiveDate)"
                             ValueChanged="OnEffectiveDateChanged"
                             Disabled="@(!IsEditable)"
                             Size="ControlSize.Small" />

                <UiCheckbox Label="الحساب نشط (متاح للاستخدام)"
                            Value="@Model.IsActive"
                            ValueChanged="OnIsActiveChanged"
                            Disabled="@(!IsEditable)" />

            </UiAccountingFormGrid>

        </UiAccountingFormSection>

    </UiAccountingFormGrid>

    <div class="ui-acc-account-editor__definition-note" role="note" aria-live="polite">
        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
        <div>
            <strong>@DefinitionHintTitle</strong>
            <span>@DefinitionHintText</span>
        </div>
    </div>

</UiAccountingEditorSurface>


@code {

    public sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;

        public string? CodeError { get; set; }

        public string NameAr { get; set; } = string.Empty;

        public string? NameEn { get; set; }

        public Guid? ParentAccountId { get; set; }

        public int Level { get; set; } = 1;

        public AccountClass AccountClass { get; set; }
            = AccountClass.Asset;

        public AccountType AccountType { get; set; }
            = AccountType.Posting;

        public NormalBalance NormalBalance { get; set; }
            = NormalBalance.Debit;

        public bool IsPostingAccount { get; set; } = true;

        public bool IsControlAccount { get; set; }

        public bool AllowManualPosting { get; set; } = true;

        public bool IsSystemAccount { get; set; }

        public bool IsActive { get; set; } = true;

        public DateOnly? EffectiveDate { get; set; }
            = DateOnly.FromDateTime(DateTime.Today);

        public string RowVersion { get; set; }
            = string.Empty;


        public string AccountClassValue
        {
            get => AccountClass.ToString();

            set
            {
                if (Enum.TryParse<AccountClass>(
                        value,
                        out var result))
                {
                    AccountClass = result;
                }
            }
        }


        public string AccountTypeValue
        {
            get => AccountType.ToString();

            set
            {
                if (Enum.TryParse<AccountType>(
                        value,
                        out var result))
                {
                    AccountType = result;
                }
            }
        }


        public string NormalBalanceValue
        {
            get => NormalBalance.ToString();

            set
            {
                if (Enum.TryParse<NormalBalance>(
                        value,
                        out var result))
                {
                    NormalBalance = result;
                }
            }
        }
    }


    private bool CanChangePostingAccount => IsEditable && Model.AccountType != AccountType.Header;
    private bool CanChangeManualPosting => IsEditable && Model.AccountType != AccountType.Header && Model.IsPostingAccount;
    private bool CanChangeControlAccount => IsEditable && Model.AccountType != AccountType.Control;

    private string DefinitionHintTitle => Model.AccountType switch
    {
        AccountType.Header => "حساب تجميعي",
        AccountType.Control => "حساب تحكمي",
        AccountType.Subledger => "حساب أستاذ مساعد",
        _ => "حساب تفصيلي"
    };

    private string DefinitionHintText => Model.AccountType switch
    {
        AccountType.Header => "الحساب التجميعي لا يقبل الترحيل المباشر أو اليدوي، ويُستخدم فقط لتجميع الحسابات الفرعية.",
        AccountType.Control => "الحساب التحكمي يجب أن يبقى مفعّلًا كحساب تحكمي، ويُستخدم عادة لربط الأستاذ المساعد.",
        AccountType.Subledger => "حساب الأستاذ المساعد يصلح للحسابات المرتبطة بالأطراف أو السجلات الفرعية، مع بقاء المراجعة المحاسبية مطلوبة.",
        _ => "الحساب التفصيلي مخصص للترحيل المباشر، ويمكن ضبط الترحيل اليدوي وفق سياسة العمل لديك."
    };

    [Parameter]
    public FormModel Model { get; set; } = new();


    [Parameter]
    public bool IsEditable { get; set; }


    [Parameter]
    public bool IsNew { get; set; }


    [Parameter]
    public UiLookupItem? ParentAccountLookupItem { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        AccountSearchAsync
    { get; set; }


    [Parameter]
    public Func<Guid?, int>? AccountLevelResolver { get; set; }


    [Parameter]
    public EventCallback OnModelChanged { get; set; }


    private Task OnChanged()
        => OnModelChanged.InvokeAsync();


    private async Task OnCodeChanged(string? value)
    {
        var code =
            value?.Trim() ??
            string.Empty;

        Model.Code = code;

        if (string.IsNullOrWhiteSpace(code))
        {
            Model.CodeError =
                "كود الحساب مطلوب.";
        }
        else if (!IsNumericAccountCode(code))
        {
            Model.CodeError =
                "كود الحساب يجب أن يتكون من أرقام فقط.";
        }
        else if (code.Length > 30)
        {
            Model.CodeError =
                "كود الحساب يجب ألا يزيد عن 30 رقمًا.";
        }
        else
        {
            Model.CodeError = null;
        }

        await OnChanged();
    }


    private static bool IsNumericAccountCode(
        string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        foreach (var character in value)
        {
            if (character < '0' ||
                character > '9')
            {
                return false;
            }
        }

        return true;
    }


    private async Task OnNameArChanged(string? value)
    {
        Model.NameAr =
            value ?? string.Empty;

        await OnChanged();
    }


    private async Task OnNameEnChanged(string? value)
    {
        Model.NameEn = value;

        await OnChanged();
    }


    private async Task OnClassChanged(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (Enum.TryParse<AccountClass>(
                value,
                out var result))
        {
            Model.AccountClass = result;
            Model.NormalBalance = GetSuggestedNormalBalance(result);

            await OnChanged();
        }
    }


    private async Task OnTypeChanged(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (Enum.TryParse<AccountType>(
                value,
                out var result))
        {
            Model.AccountType = result;
            ApplyAccountTypeRules();

            await OnChanged();
        }
    }


    private async Task OnNormalBalanceChanged(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (Enum.TryParse<NormalBalance>(
                value,
                out var result))
        {
            Model.NormalBalance = result;

            await OnChanged();
        }
    }


    private async Task OnLevelChanged(
        decimal value)
    {
        Model.Level =
            Math.Clamp(
                (int)value,
                1,
                255);

        await OnChanged();
    }


    private async Task OnParentAccountChanged(
        string? value)
    {
        Model.ParentAccountId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        if (AccountLevelResolver is not null)
        {
            Model.Level = Math.Clamp(
                AccountLevelResolver(Model.ParentAccountId),
                1,
                255);
        }
        else
        {
            Model.Level = Model.ParentAccountId.HasValue ? Math.Max(2, Model.Level) : 1;
        }

        await OnChanged();
    }


    private async Task OnEffectiveDateChanged(
        DateOnly? value)
    {
        Model.EffectiveDate = value;

        await OnChanged();
    }


    private async Task OnIsPostingAccountChanged(
        bool value)
    {
        Model.IsPostingAccount = value;

        if (!Model.IsPostingAccount)
        {
            Model.AllowManualPosting = false;
        }

        await OnChanged();
    }


    private async Task OnIsControlAccountChanged(
        bool value)
    {
        Model.IsControlAccount = Model.AccountType == AccountType.Control || value;

        await OnChanged();
    }


    private async Task OnAllowManualPostingChanged(
        bool value)
    {
        Model.AllowManualPosting = Model.IsPostingAccount && value;

        await OnChanged();
    }


    private async Task OnIsSystemAccountChanged(
        bool value)
    {
        Model.IsSystemAccount = value;

        await OnChanged();
    }


    private async Task OnIsActiveChanged(
        bool value)
    {
        Model.IsActive = value;

        await OnChanged();
    }

    private static NormalBalance GetSuggestedNormalBalance(AccountClass accountClass)
        => accountClass is AccountClass.Asset or AccountClass.Expense
            ? NormalBalance.Debit
            : NormalBalance.Credit;

    private void ApplyAccountTypeRules()
    {
        switch (Model.AccountType)
        {
            case AccountType.Header:
                Model.IsPostingAccount = false;
                Model.AllowManualPosting = false;
                Model.IsControlAccount = false;
                break;

            case AccountType.Control:
                Model.IsPostingAccount = true;
                Model.AllowManualPosting = true;
                Model.IsControlAccount = true;
                break;

            case AccountType.Subledger:
                Model.IsPostingAccount = true;
                Model.AllowManualPosting = true;
                Model.IsControlAccount = false;
                break;

            default:
                Model.IsPostingAccount = true;
                Model.AllowManualPosting = true;
                if (Model.AccountType != AccountType.Control)
                {
                    Model.IsControlAccount = false;
                }
                break;
        }
    }
}