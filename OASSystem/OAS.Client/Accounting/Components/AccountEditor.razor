@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.Accounts
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<div class="ui-acc-editor" dir="rtl">
    <UiAccountingFormSection Title="المعلومات الأساسية"
                             Subtitle="الرمز، المسميات، وربط التبعية الشجرية"
                             IconCssClass="fa-solid fa-circle-info">
        <div class="ui-acc-form-grid ui-acc-form-grid--2col">
            <UiInputText Label="كود الحساب"
                         Value="@Model.Code"
                         ValueChanged="@(v => { Model.Code = v; OnChanged(); })"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم الحساب (بالعربية)"
                         Value="@Model.NameAr"
                         ValueChanged="@(v => { Model.NameAr = v; OnChanged(); })"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم الحساب (بالإنجليزية)"
                         Value="@Model.NameEn"
                         ValueChanged="@(v => { Model.NameEn = v; OnChanged(); })"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiLookup Label="الحساب الأب"
                      Value="@Model.ParentAccountId?.ToString("D")"
                      ValueChanged="OnParentAccountChanged"
                      SelectedItem="@ParentAccountLookupItem"
                      SearchAsync="AccountSearchAsync"
                      Placeholder="ابحث عن الحساب الأب..."
                      Disabled="@(!IsEditable)"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />
        </div>
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="التصنيف المحاسبي"
                             Subtitle="نوع الحساب، طبيعة الرصيد والمستوى الشجري"
                             IconCssClass="fa-solid fa-sitemap">
        <div class="ui-acc-form-grid ui-acc-form-grid--4col">
            <UiSelect Label="تصنيف الحساب"
                      Value="@Model.AccountClass.ToString()"
                      ValueChanged="OnClassChanged"
                      Options="@AccountingArabicPresenter.AccountClassOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            <UiSelect Label="نوع الحساب"
                      Value="@Model.AccountType.ToString()"
                      ValueChanged="OnTypeChanged"
                      Options="@AccountingArabicPresenter.AccountTypeOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            <UiSelect Label="طبيعة الحساب"
                      Value="@Model.NormalBalance.ToString()"
                      ValueChanged="OnNormalBalanceChanged"
                      Options="@AccountingArabicPresenter.NormalBalanceOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            <UiInputText Label="المستوى الشجري"
                         Value="@Model.Level.ToString()"
                         ReadOnly="true"
                         Disabled="true"
                         Size="ControlSize.Small" />
        </div>
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="خصائص وتشغيل الحساب"
                             Subtitle="صلاحيات الترحيل والتحكم وحالة النشاط"
                             IconCssClass="fa-solid fa-sliders">
        <div class="ui-acc-checks-group">
            <UiCheckbox Label="حساب ترحيل (يقبل القيود)"
                        Value="@Model.IsPostingAccount"
                        ValueChanged="@(v => { Model.IsPostingAccount = v; OnChanged(); })"
                        Disabled="@(!IsEditable)" />

            <UiCheckbox Label="حساب تحكمي (أستاذ مساعد)"
                        Value="@Model.IsControlAccount"
                        ValueChanged="@(v => { Model.IsControlAccount = v; OnChanged(); })"
                        Disabled="@(!IsEditable)" />

            <UiCheckbox Label="السماح بالترحيل اليدوي"
                        Value="@Model.AllowManualPosting"
                        ValueChanged="@(v => { Model.AllowManualPosting = v; OnChanged(); })"
                        Disabled="@(!IsEditable)" />

            <UiCheckbox Label="حساب نظامي (أساسي)"
                        Value="@Model.IsSystemAccount"
                        ValueChanged="@(v => { Model.IsSystemAccount = v; OnChanged(); })"
                        Disabled="@(!IsEditable || !IsNew)" />

            <UiCheckbox Label="الحساب نشط"
                        Value="@Model.IsActive"
                        ValueChanged="@(v => { Model.IsActive = v; OnChanged(); })"
                        Disabled="@(!IsEditable)" />
        </div>
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="الإعدادات الزمنية والنظامية"
                             Subtitle="تاريخ السريان والبيانات التدقيقية"
                             IconCssClass="fa-regular fa-clock"
                             Collapsible="true">
        <div class="ui-acc-form-grid ui-acc-form-grid--2col">
            <UiInputDate Label="تاريخ السريان"
                         Value="@Model.EffectiveDate"
                         ValueChanged="@(v => { if (v.HasValue) { Model.EffectiveDate = v.Value; OnChanged(); } })"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            @if (!string.IsNullOrWhiteSpace(RowVersion))
            {
                <UiInputText Label="إصدار السجل (RowVersion)"
                             Value="@RowVersion"
                             ReadOnly="true"
                             Disabled="true"
                             Size="ControlSize.Small" />
            }
        </div>
    </UiAccountingFormSection>
</div>

@code {
    public sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;
        public string NameAr { get; set; } = string.Empty;
        public string? NameEn { get; set; }
        public Guid? ParentAccountId { get; set; }
        public int Level { get; set; } = 1;
        public AccountClass AccountClass { get; set; } = AccountClass.Asset;
        public AccountType AccountType { get; set; } = AccountType.Posting;
        public NormalBalance NormalBalance { get; set; } = NormalBalance.Debit;
        public bool IsPostingAccount { get; set; } = true;
        public bool IsControlAccount { get; set; }
        public bool AllowManualPosting { get; set; } = true;
        public bool IsSystemAccount { get; set; }
        public bool IsActive { get; set; } = true;
        public DateOnly? EffectiveDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }

    [Parameter] public FormModel Model { get; set; } = new();
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public string? RowVersion { get; set; }
    [Parameter] public UiLookupItem? ParentAccountLookupItem { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? AccountSearchAsync { get; set; }
    [Parameter] public EventCallback OnModelChanged { get; set; }

    private void OnChanged() => OnModelChanged.InvokeAsync();

    private void OnClassChanged(string val)
    {
        if (Enum.TryParse<AccountClass>(val, out var res))
        {
            Model.AccountClass = res;
            OnChanged();
        }
    }

    private void OnTypeChanged(string val)
    {
        if (Enum.TryParse<AccountType>(val, out var res))
        {
            Model.AccountType = res;
            OnChanged();
        }
    }

    private void OnNormalBalanceChanged(string val)
    {
        if (Enum.TryParse<NormalBalance>(val, out var res))
        {
            Model.NormalBalance = res;
            OnChanged();
        }
    }

    private void OnParentAccountChanged(string? val)
    {
        Model.ParentAccountId = Guid.TryParse(val, out var id) ? id : null;
        OnChanged();
    }
}
