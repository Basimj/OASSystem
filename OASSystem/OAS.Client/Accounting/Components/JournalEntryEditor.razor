@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.Journals
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Accounting.Journals
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface AdditionalCssClass="oas-journal-editor--compact">
    <div class="oas-journal-editor__heading">
        <div class="oas-journal-editor__identity">
            <h2><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> @(IsNew ? "إضافة قيد يومية" : "تفاصيل قيد يومية")</h2>
            <span class="oas-journal-editor__number">@Model.JournalNumber</span>
        </div>
        <div class="oas-journal-editor__heading-actions">
            <span class="oas-journal-editor__status">@AccountingArabicPresenter.GetJournalStatusText(Model.Status)</span>
            @if (Model.ReversedJournalId.HasValue)
            {
                <span class="oas-journal-editor__number">القيد العكسي: @ReversedJournalCodeText</span>
            }
            @if (!IsNew && (!string.IsNullOrWhiteSpace(Model.SourceModule) ||
                 !string.IsNullOrWhiteSpace(Model.SourceDocumentType) || Model.SourceDocumentId.HasValue))
            {
                <details class="oas-journal-editor__source">
                    <summary><i class="fa-solid fa-link" aria-hidden="true"></i> المستند المصدر</summary>
                    <div class="oas-journal-editor__source-content">
                        <span>الوحدة: @SourceModuleText</span>
                        <span>النوع: @SourceDocumentTypeText</span>
                        <span>رقم المستند: @SourceDocumentCodeText</span>
                    </div>
                </details>
            }
        </div>
    </div>

    <section class="oas-journal-editor__meta" aria-label="بيانات القيد الأساسية">
        <div class="oas-journal-editor__meta-title">
            <strong><i class="fa-solid fa-file-invoice" aria-hidden="true"></i> بيانات القيد</strong>
            <small>الترحيل والاعتماد من شريط الإجراءات العلوي</small>
        </div>
        <div class="oas-journal-editor__fields">
            <UiInputText Label="رقم القيد"
                         Value="@Model.JournalNumber"
                         ValueExpression="@(() => Model.JournalNumber)"
                         ReadOnly="true" Disabled="true"
                         Placeholder="يولّد تلقائيًا" Size="ControlSize.Small" />
            <UiInputDate Label="تاريخ القيد"
                         Value="@Model.DocumentDateInput"
                         ValueExpression="@(() => Model.DocumentDateInput)"
                         ValueChanged="OnDocumentDateChanged"
                         Required="true" Disabled="@(!IsEditable)" Size="ControlSize.Small" />
            <UiInputDate Label="تاريخ الترحيل"
                         Value="@Model.PostingDateInput"
                         ValueExpression="@(() => Model.PostingDateInput)"
                         ValueChanged="OnPostingDateChanged"
                         Required="true" Disabled="@(!IsEditable)" Size="ControlSize.Small" />
            <UiLookup Label="الفترة المالية"
                      Value='@Model.FiscalPeriodId?.ToString("D")'
                      ValueChanged="OnPeriodChanged"
                      SelectedItem="@FiscalPeriodLookupItem"
                      SearchAsync="FiscalPeriodSearchAsync"
                      Placeholder="اختر الفترة المالية"
                      Disabled="@(!IsEditable)" MinimumSearchLength="0" DebounceMilliseconds="250" />
            <UiSelect Label="نوع القيد"
                      Value="@Model.JournalTypeValue"
                      ValueExpression="@(() => Model.JournalTypeValue)"
                      ValueChanged="OnTypeChanged"
                      Options="@AccountingArabicPresenter.JournalTypeOptions"
                      Disabled="@(!IsEditable)" Size="ControlSize.Small" />
        </div>
        <div class="oas-journal-editor__description">
            <UiInputText Label="البيان العام للقيد"
                         Value="@Model.Description"
                         ValueExpression="@(() => Model.Description)"
                         ValueChanged="OnDescriptionChanged"
                         Required="true" Disabled="@(!IsEditable)"
                         Placeholder="وصف مختصر لسبب القيد..." Size="ControlSize.Small" />
        </div>
    </section>

    <UiJournalLinesEditor Lines="@Model.Lines"
                          IsEditable="@IsEditable"
                          AccountSearchAsync="@AccountSearchAsync"
                          CostCenterSearchAsync="@CostCenterSearchAsync"
                          CustomerSearchAsync="@CustomerSearchAsync"
                          SupplierSearchAsync="@SupplierSearchAsync"
                          EmployeeSearchAsync="@EmployeeSearchAsync"
                          CurrencySearchAsync="@CurrencySearchAsync"
                          EffectiveRateAsync="@EffectiveRateAsync"
                          RateDate="@Model.DocumentDate"
                          OnLinesChanged="@OnChanged" />
</UiAccountingEditorSurface>

@code {

    public sealed class FormModel
    {
        public string JournalNumber { get; set; } =
            string.Empty;

        public JournalType JournalType { get; set; } =
            JournalType.Manual;

        public string JournalTypeValue
        {
            get => JournalType.ToString();

            set
            {
                if (Enum.TryParse<JournalType>(
                        value,
                        out var result))
                {
                    JournalType = result;
                }
            }
        }

        public DateOnly PostingDate { get; set; } =
            DateOnly.FromDateTime(DateTime.Today);

        public DateOnly? PostingDateInput
        {
            get => PostingDate;

            set
            {
                if (value.HasValue)
                {
                    PostingDate = value.Value;
                }
            }
        }

        public DateOnly DocumentDate { get; set; } =
            DateOnly.FromDateTime(DateTime.Today);

        public DateOnly? DocumentDateInput
        {
            get => DocumentDate;

            set
            {
                if (value.HasValue)
                {
                    DocumentDate = value.Value;
                }
            }
        }

        public Guid? FiscalPeriodId { get; set; }

        public string Description { get; set; } =
            string.Empty;

        /*
         * هذه البيانات تبقى كما هي داخلياً.
         * لكن SourceDocumentId لا يظهر للمستخدم.
         */
        public string? SourceModule { get; set; }

        public string? SourceDocumentType { get; set; }

        public Guid? SourceDocumentId { get; set; }

        /*
         * رقم المستند المعروض للمستخدم.
         *
         * مثال:
         * EXP-000001
         * RV-000001
         * PV-000001
         * JV-000001
         */
        public string? SourceDocumentCode { get; set; }

        public JournalEntryStatus Status { get; set; } =
            JournalEntryStatus.Draft;

        public Guid? ReversedJournalId { get; set; }

        /*
         * رقم القيد المرتبط بالعكس.
         * لا نعرض ReversedJournalId.
         */
        public string? ReversedJournalCode { get; set; }

        public string RowVersion { get; set; } =
            string.Empty;

        public List<UiJournalLinesEditor.EditableJournalLine>
            Lines
        { get; set; } =
            [];
    }


    [Parameter]
    public FormModel Model { get; set; } =
        new();


    [Parameter]
    public bool IsEditable { get; set; }


    [Parameter]
    public bool IsNew { get; set; }


    [Parameter]
    public UiLookupItem? FiscalPeriodLookupItem { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        FiscalPeriodSearchAsync
    {
        get;
        set;
    }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        AccountSearchAsync
    {
        get;
        set;
    }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        CostCenterSearchAsync
    {
        get;
        set;
    }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        CustomerSearchAsync
    {
        get;
        set;
    }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        SupplierSearchAsync
    {
        get;
        set;
    }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        EmployeeSearchAsync
    {
        get;
        set;
    }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        CurrencySearchAsync
    {
        get;
        set;
    }


    [Parameter]
    public Func<
        Guid,
        DateOnly,
        CancellationToken,
        Task<decimal?>>?
        EffectiveRateAsync
    {
        get;
        set;
    }


    [Parameter]
    public Func<DateOnly, Task<string?>>? ReserveNumberForPostingDateAsync { get; set; }

    [Parameter]
    public EventCallback OnModelChanged { get; set; }


    private string SourceModuleText =>
        Model.SourceModule?.Trim() switch
        {
            "Accounting" =>
                "المحاسبة",

            "Sales" =>
                "المبيعات",

            "Purchasing" =>
                "المشتريات",

            "Inventory" =>
                "المخزون",

            "Employees" =>
                "الموظفون",

            "Customers" =>
                "العملاء",

            "Suppliers" =>
                "الموردون",

            null or "" =>
                "-",

            _ =>
                "وحدة أخرى"
        };


    private string SourceDocumentTypeText =>
        Model.SourceDocumentType?.Trim() switch
        {
            "Expense" =>
                "مصروف",

            "ReceiptVoucher" =>
                "سند قبض",

            "PaymentVoucher" =>
                "سند صرف",

            "JournalEntry" =>
                "قيد يومية",

            "JournalEntryReversal" =>
                "قيد عكسي",

            "SalesInvoice" =>
                "فاتورة مبيعات",

            "PurchaseInvoice" =>
                "فاتورة مشتريات",

            "DebitAdjustment" =>
                "إشعار مدين",

            "CreditAdjustment" =>
                "إشعار دائن",

            "StockCount" =>
                "جرد مخزون",

            "InventoryTransaction" =>
                "حركة مخزون",

            "CashShift" =>
                "وردية صندوق",

            null or "" =>
                "-",

            _ =>
                "مستند آخر"
        };


    /*
     * لا يوجد fallback إلى GUID.
     */
    private string SourceDocumentCodeText =>
        string.IsNullOrWhiteSpace(
            Model.SourceDocumentCode)
                ? "غير متاح"
                : Model.SourceDocumentCode;


    private string ReversedJournalCodeText =>
        string.IsNullOrWhiteSpace(
            Model.ReversedJournalCode)
                ? "غير متاح"
                : Model.ReversedJournalCode;


    private Task OnChanged()
    {
        return OnModelChanged.InvokeAsync();
    }


    private async Task OnTypeChanged(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (!Enum.TryParse<JournalType>(
                value,
                out var result))
        {
            return;
        }

        Model.JournalType =
            result;

        await OnChanged();
    }


    private async Task OnPostingDateChanged(DateOnly? value)
    {
        if (!value.HasValue) return;
        var yearChanged = Model.PostingDate.Year != value.Value.Year;
        Model.PostingDate = value.Value;
        if (IsNew && yearChanged && ReserveNumberForPostingDateAsync is not null)
        {
            // A reserved number belongs to the posting year; refresh it when the year changes.
            Model.JournalNumber = await ReserveNumberForPostingDateAsync(value.Value) ?? string.Empty;
        }
        await OnChanged();
    }

    private async Task OnDocumentDateChanged(
        DateOnly? value)
    {
        if (value.HasValue)
        {
            Model.DocumentDate =
                value.Value;
        }

        await OnChanged();
    }


    private async Task OnPeriodChanged(
        string? value)
    {
        Model.FiscalPeriodId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnDescriptionChanged(
        string? value)
    {
        Model.Description =
            value ??
            string.Empty;

        await OnChanged();
    }
}