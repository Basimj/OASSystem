@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.Journals
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Accounting.Journals
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface>

    @if (!IsNew)
    {
        <UiAccountingFormSection Title="حالة القيد"
                                 Subtitle="حالة دورة الاعتماد والترحيل وعلاقة القيد العكسي"
                                 IconCssClass="fa-solid fa-circle-check">
            <UiAccountingStatusActionBar Label="الحالة الحالية"
                                         StatusText="@AccountingArabicPresenter.GetJournalStatusText(Model.Status)"
                                         StatusState="@Model.Status.ToString().ToLowerInvariant()" />
            @if (Model.ReversedJournalId.HasValue)
            {
                <UiAccountingReadOnlyValue Label="القيد المرتبط بالعكس"
                                           Value='@Model.ReversedJournalId.Value.ToString("D")'
                                           Tone="@UiAccountingReadOnlyValue.ValueTone.Primary" />
            }
        </UiAccountingFormSection>
    }

    <UiAccountingFormSection Title="ترويسة وبيانات القيد"
                             Subtitle="نوع القيد، التواريخ، والبيان العام"
                             IconCssClass="fa-solid fa-file-invoice">

        <UiAccountingFormGrid Columns="3">

            <UiInputText Label="رقم القيد"
                         Value="@Model.JournalNumber"
                         ValueExpression="@(() => Model.JournalNumber)"
                         ReadOnly="true"
                         Disabled="true"
                         Placeholder="توليد تلقائي..."
                         Size="ControlSize.Small" />

            <UiSelect Label="نوع القيد"
                      Value="@Model.JournalTypeValue"
                      ValueExpression="@(() => Model.JournalTypeValue)"
                      ValueChanged="OnTypeChanged"
                      Options="@AccountingArabicPresenter.JournalTypeOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            <UiLookup Label="الفترة المالية"
                      Value='@Model.FiscalPeriodId?.ToString("D")'
                      ValueChanged="OnPeriodChanged"
                      SelectedItem="@FiscalPeriodLookupItem"
                      SearchAsync="FiscalPeriodSearchAsync"
                      Placeholder="اختر الفترة المالية..."
                      Disabled="@(!IsEditable)"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />

            <UiInputDate Label="تاريخ الترحيل"
                         Value="@Model.PostingDateInput"
                         ValueExpression="@(() => Model.PostingDateInput)"
                         ValueChanged="OnPostingDateChanged"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiInputDate Label="تاريخ المستند"
                         Value="@Model.DocumentDateInput"
                         ValueExpression="@(() => Model.DocumentDateInput)"
                         ValueChanged="OnDocumentDateChanged"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

        </UiAccountingFormGrid>

        <UiAccountingStack>

            <UiInputText Label="البيان العام للقيد"
                         Value="@Model.Description"
                         ValueExpression="@(() => Model.Description)"
                         ValueChanged="OnDescriptionChanged"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Placeholder="شرح وافٍ عن طبيعة القيد والعملية المالية..." />

        </UiAccountingStack>

    </UiAccountingFormSection>


    @if (!IsNew && (!string.IsNullOrWhiteSpace(Model.SourceModule) || !string.IsNullOrWhiteSpace(Model.SourceDocumentType) || Model.SourceDocumentId.HasValue))
    {
        <UiAccountingFormSection Title="مرجع العملية المصدر"
                                 Subtitle="بيانات الربط بالمستند الذي أنشأ القيد تلقائياً"
                                 IconCssClass="fa-solid fa-link">
            <UiAccountingFormGrid Columns="3">
                <UiAccountingReadOnlyValue Label="الوحدة المصدر" Value="@SourceModuleText" />
                <UiAccountingReadOnlyValue Label="نوع المستند" Value="@SourceDocumentTypeText" />
                <UiAccountingReadOnlyValue Label="معرف المستند" Value="@SourceDocumentIdText" Tone="@UiAccountingReadOnlyValue.ValueTone.Primary" />
            </UiAccountingFormGrid>
        </UiAccountingFormSection>
    }

    <UiAccountingFormSection Title="أسطر القيد اليومي (الحسابات والمدين والدائن)"
                             Subtitle="إدخال الحسابات المحاسبية ومراكز التكلفة والمبالغ المتوازنة"
                             IconCssClass="fa-solid fa-scale-balanced">

        <UiJournalLinesEditor Lines="@Model.Lines"
                              IsEditable="@IsEditable"
                              AccountSearchAsync="@AccountSearchAsync"
                              CostCenterSearchAsync="@CostCenterSearchAsync"
                              OnLinesChanged="@OnChanged" />

    </UiAccountingFormSection>

</UiAccountingEditorSurface>


@code {

    public sealed class FormModel
    {
        public string JournalNumber { get; set; } = string.Empty;

        public JournalType JournalType { get; set; }
            = JournalType.Manual;

        public string JournalTypeValue
        {
            get => JournalType.ToString();

            set
            {
                if (Enum.TryParse<JournalType>(
                        value,
                        out var result))
                {
                    JournalType = result;
                }
            }
        }

        public DateOnly PostingDate { get; set; }
            = DateOnly.FromDateTime(DateTime.Today);

        public DateOnly? PostingDateInput
        {
            get => PostingDate;

            set
            {
                if (value.HasValue)
                {
                    PostingDate = value.Value;
                }
            }
        }

        public DateOnly DocumentDate { get; set; }
            = DateOnly.FromDateTime(DateTime.Today);

        public DateOnly? DocumentDateInput
        {
            get => DocumentDate;

            set
            {
                if (value.HasValue)
                {
                    DocumentDate = value.Value;
                }
            }
        }

        public Guid? FiscalPeriodId { get; set; }

        public string Description { get; set; }
            = string.Empty;

        // Preserve source references when editing an automatic/source journal.
        public string? SourceModule { get; set; }
        public string? SourceDocumentType { get; set; }
        public Guid? SourceDocumentId { get; set; }

        public JournalEntryStatus Status { get; set; }
            = JournalEntryStatus.Draft;

        public Guid? ReversedJournalId { get; set; }

        public string RowVersion { get; set; } = string.Empty;

        public List<UiJournalLinesEditor.EditableJournalLine> Lines { get; set; }
            = [];
    }


    [Parameter]
    public FormModel Model { get; set; } = new();


    [Parameter]
    public bool IsEditable { get; set; }


    [Parameter]
    public bool IsNew { get; set; }


    [Parameter]
    public UiLookupItem? FiscalPeriodLookupItem { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        FiscalPeriodSearchAsync
    { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        AccountSearchAsync
    { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        CostCenterSearchAsync
    { get; set; }


    [Parameter]
    public EventCallback OnModelChanged { get; set; }


    private string SourceModuleText => Model.SourceModule ?? "-";
    private string SourceDocumentTypeText => Model.SourceDocumentType ?? "-";
    private string SourceDocumentIdText => Model.SourceDocumentId?.ToString("D") ?? "-";

    private Task OnChanged()
        => OnModelChanged.InvokeAsync();


    private async Task OnTypeChanged(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (!Enum.TryParse<JournalType>(
                value,
                out var result))
        {
            return;
        }

        Model.JournalType = result;

        await OnChanged();
    }


    private async Task OnPostingDateChanged(DateOnly? value)
    {
        if (value.HasValue)
        {
            Model.PostingDate = value.Value;
        }

        await OnChanged();
    }


    private async Task OnDocumentDateChanged(DateOnly? value)
    {
        if (value.HasValue)
        {
            Model.DocumentDate = value.Value;
        }

        await OnChanged();
    }


    private async Task OnPeriodChanged(string? value)
    {
        Model.FiscalPeriodId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnDescriptionChanged(string? value)
    {
        Model.Description = value ?? string.Empty;

        await OnChanged();
    }
}