    private RenderFragment RenderPaymentAllocationsList() => __builder =>
    {
        <UiCard Title="تخصيصات السداد" Subtitle="تسوية الدفعات على فواتير المبيعات والمشتريات">
            @if (_allocationsPage.Items is not null && _allocationsPage.Items.Count > 0)
            {
                <div class="table-responsive">
                    <table class="ui-acc-grid-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>نوع المصدر</th>
                                <th>المستند الهدف</th>
                                <th>المبلغ المخصص</th>
                                <th>تاريخ التخصيص</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var idx = 1; }
                            @foreach (var a in _allocationsPage.Items)
                            {
                                <tr @onclick="@(() => OpenRecordInTab(AccountingEntityType.PaymentAllocations, a.Id, $"تخصيص #{a.AllocatedAmount:N0}"))" style="cursor: pointer;">
                                    <td>@idx</td>
                                    <td>@AccountingArabicPresenter.GetPaymentSourceTypeText(a.PaymentSourceType)</td>
                                    <td>@AccountingArabicPresenter.GetAllocationTargetDocumentTypeText(a.TargetDocumentType)</td>
                                    <td class="font-bold text-primary">@a.AllocatedAmount.ToString("N2")</td>
                                    <td>@a.AllocatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <UiAlert Message="لا توجد تخصيصات سداد مسجلة حالياً." Tone="AlertTone.Info" />
            }
        </UiCard>
    };
}
