@namespace OAS.Client.Accounting.Components
@inject IAccountingWorkspaceState Workspace
@inject IAccountingClientService AccountingService
@inject IUiSnackbarService Snackbar
@inject IUiDialogService Dialog
@implements IDisposable

@using OAS.Client.Accounting.Workspace
@using OAS.Client.Accounting.Common
@using OAS.Contracts.Accounting.Accounts
@using OAS.Contracts.Accounting.BankAccounts
@using OAS.Contracts.Accounting.CashAccounts
@using OAS.Contracts.Accounting.CashShifts
@using OAS.Contracts.Accounting.CostCenters
@using OAS.Contracts.Accounting.CustomerAccounts
@using OAS.Contracts.Accounting.Enums
@using OAS.Contracts.Accounting.Expenses
@using OAS.Contracts.Accounting.FiscalPeriods
@using OAS.Contracts.Accounting.FiscalYears
@using OAS.Contracts.Accounting.Journals
@using OAS.Contracts.Accounting.PaymentAllocations
@using OAS.Contracts.Accounting.PaymentVouchers
@using OAS.Contracts.Accounting.PostingProfiles
@using OAS.Contracts.Accounting.ReceiptVouchers
@using OAS.Contracts.Accounting.SupplierAccounts
@using OAS.Contracts.Common.Pagination
@using OAS.UiLib.Components.Accounting.Accounts
@using OAS.UiLib.Components.Accounting.CashBank
@using OAS.UiLib.Components.Accounting.CostCenters
@using OAS.UiLib.Components.Accounting.Expenses
@using OAS.UiLib.Components.Accounting.Fiscal
@using OAS.UiLib.Components.Accounting.Journals
@using OAS.UiLib.Components.Accounting.Parties
@using OAS.UiLib.Components.Accounting.PostingProfiles
@using OAS.UiLib.Components.Accounting.Vouchers
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Buttons
@using OAS.UiLib.Components.Feedback
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Components.Navigation
@using OAS.UiLib.Components.Surfaces
@using OAS.UiLib.Components.Workspace
@using OAS.UiLib.Core.Models

@{
    var activeTab = Workspace.ActiveTab;
    var isList = activeTab is null || activeTab.IsListTab;
}

<UiAccountingWorkspace>
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="جديد"
                      IconCssClass="fa-solid fa-plus"
                      Size="ControlSize.Small"
                      OnClick="OpenNewRecord" />

            <UiButton Text="تعديل"
                      IconCssClass="fa-solid fa-pen-to-square"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Disabled="@(!CanEditActive)"
                      OnClick="BeginEditActive" />

            <UiButton Text="حفظ"
                      IconCssClass="fa-solid fa-floppy-disk"
                      Size="ControlSize.Small"
                      Disabled="@(!CanSaveActive)"
                      Loading="@(activeTab?.IsSaving == true)"
                      OnClick="SaveActiveAsync" />

            <UiButton Text="إلغاء"
                      IconCssClass="fa-solid fa-ban"
                      Variant="ButtonVariant.Ghost"
                      Size="ControlSize.Small"
                      Disabled="@(!CanCancelActive)"
                      OnClick="CancelActiveEdit" />

            <UiButton Text="إغلاق"
                      IconCssClass="fa-solid fa-xmark"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Disabled="@(!CanCloseActive)"
                      OnClick="CloseActiveTabAsync" />

            <UiButton Text="تحديث"
                      IconCssClass="fa-solid fa-rotate"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Loading="@_isLoading"
                      OnClick="RefreshActiveAsync" />

            @if (isList)
            {
                <UiSearchInput @bind-Value="_searchText"
                               Placeholder="ابحث في السجلات..."
                               DebounceMilliseconds="300"
                               OnSearch="OnSearchAsync" />
            }
        </UiWorkspaceActionBar>
    </Actions>

    <Tabs>
        <UiApplicationTabStrip Tabs="@WorkspaceTabs"
                               AriaLabel="تبويبات المحاسبة العامة"
                               EnableContextMenu="true"
                               OnSelect="SelectTabAsync"
                               OnClose="CloseTabByIdAsync"
                               OnCloseOthers="CloseOtherTabsAsync"
                               OnCloseAll="CloseAllTabsAsync" />
    </Tabs>

    <Body>
        @if (activeTab is null || activeTab.IsListTab)
        {
            var entityType = activeTab?.EntityType ?? Section ?? AccountingEntityType.Accounts;
            @RenderListTabContent(entityType)
        }
        else
        {
            @RenderEditorTabContent(activeTab)
        }
    </Body>
</UiAccountingWorkspace>

@code {
    [Parameter] public AccountingEntityType? Section { get; set; }

    private bool _isLoading;
    private string _searchText = string.Empty;
    private int _pageNumber = 1;
    private int _pageSize = 25;

    // List caches
    private PagedResult<AccountDto> _accountsPage = new();
    private PagedResult<JournalEntryDto> _journalsPage = new();
    private PagedResult<ReceiptVoucherDto> _receiptsPage = new();
    private PagedResult<PaymentVoucherDto> _paymentsPage = new();
    private PagedResult<CashAccountDto> _cashAccountsPage = new();
    private PagedResult<BankAccountDto> _bankAccountsPage = new();
    private PagedResult<CashShiftDto> _cashShiftsPage = new();
    private PagedResult<ExpenseDto> _expensesPage = new();
    private PagedResult<ExpenseTypeDto> _expenseTypesPage = new();
    private PagedResult<CustomerAccountDto> _customerAccountsPage = new();
    private PagedResult<SupplierAccountDto> _supplierAccountsPage = new();
    private PagedResult<FiscalYearDto> _fiscalYearsPage = new();
    private PagedResult<FiscalPeriodDto> _fiscalPeriodsPage = new();
    private PagedResult<CostCenterDto> _costCentersPage = new();
    private PagedResult<PostingProfileDto> _postingProfilesPage = new();
    private PagedResult<PaymentAllocationDto> _allocationsPage = new();

    private IReadOnlyList<UiApplicationTabItem> WorkspaceTabs =>
        Workspace.Tabs.Select(t => new UiApplicationTabItem(
            t.TabId,
            t.Title,
            "/accounting",
            t.GetIconCss(),
            Workspace.ActiveTabId == t.TabId,
            CanClose: t.CanClose)).ToArray();

    private bool CanEditActive => Workspace.ActiveTab is { IsListTab: false, IsNew: false, IsEditMode: false, IsLoading: false, IsSaving: false };
    private bool CanSaveActive => Workspace.ActiveTab is { IsListTab: false, IsSaving: false } tab && (tab.IsNew || tab.IsEditMode);
    private bool CanCancelActive => Workspace.ActiveTab is { IsListTab: false, IsSaving: false } tab && (tab.IsNew || tab.IsEditMode);
    private bool CanCloseActive => Workspace.ActiveTab is { CanClose: true, IsSaving: false };

    protected override async Task OnInitializedAsync()
    {
        Workspace.OnChange += StateHasChanged;
        if (Section.HasValue)
        {
            Workspace.OpenOrActivateListTab(Section.Value);
        }
        await LoadActiveListDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Section.HasValue && (Workspace.ActiveTab is null || Workspace.ActiveTab.EntityType != Section.Value))
        {
            Workspace.OpenOrActivateListTab(Section.Value);
            await LoadActiveListDataAsync();
        }
    }

    public void Dispose()
    {
        Workspace.OnChange -= StateHasChanged;
    }

    private async Task SelectTabAsync(Guid tabId)
    {
        Workspace.ActiveTabId = tabId;
        var tab = Workspace.FindTab(tabId);
        if (tab is { IsListTab: true })
        {
            await LoadActiveListDataAsync();
        }
    }

    private async Task CloseActiveTabAsync()
    {
        if (Workspace.ActiveTab is { } tab)
        {
            await CloseTabByIdAsync(tab.TabId);
        }
    }

    private async Task CloseTabByIdAsync(Guid tabId)
    {
        var tab = Workspace.FindTab(tabId);
        if (tab is null || !tab.CanClose) return;

        if (tab.IsDirty)
        {
            var confirm = await Dialog.ConfirmAsync(
                "تغييرات غير محفوظة",
                $"توجد تغييرات لم يتم حفظها في تبويبة «{tab.Title}». هل تريد تجاهلها وإغلاق التبويبة؟",
                AlertTone.Warning,
                "تجاهل وإغلاق",
                "إلغاء");

            if (!confirm) return;
        }

        Workspace.RemoveTab(tabId);
    }

    private async Task CloseOtherTabsAsync(Guid tabId)
    {
        var others = Workspace.Tabs.Where(x => x.TabId != tabId && x.CanClose).ToArray();
        foreach (var t in others)
        {
            if (t.IsDirty)
            {
                var confirm = await Dialog.ConfirmAsync("تغييرات غير محفوظة", $"توجد تغييرات غير محفوظة في تبويبة «{t.Title}». هل تريد إغلاقها؟", AlertTone.Warning, "إغلاق", "إلغاء");
                if (!confirm) continue;
            }
            Workspace.RemoveTab(t.TabId);
        }
    }

    private async Task CloseAllTabsAsync()
    {
        var closeable = Workspace.Tabs.Where(x => x.CanClose).ToArray();
        foreach (var t in closeable)
        {
            if (t.IsDirty)
            {
                var confirm = await Dialog.ConfirmAsync("تغييرات غير محفوظة", $"توجد تغييرات غير محفوظة في تبويبة «{t.Title}». هل تريد إغلاقها؟", AlertTone.Warning, "إغلاق", "إلغاء");
                if (!confirm) continue;
            }
            Workspace.RemoveTab(t.TabId);
        }
    }

    private void BeginEditActive()
    {
        if (Workspace.ActiveTab is { IsListTab: false } tab)
        {
            tab.BeginEdit();
            Workspace.NotifyStateChanged();
        }
    }

    private void CancelActiveEdit()
    {
        if (Workspace.ActiveTab is { IsListTab: false } tab)
        {
            if (tab.IsNew)
            {
                Workspace.RemoveTab(tab.TabId);
            }
            else
            {
                tab.CancelEdit();
                Workspace.NotifyStateChanged();
            }
        }
    }

    private void OpenNewRecord()
    {
        var entityType =
            Section
            ?? Workspace.ActiveTab?.EntityType
            ?? AccountingEntityType.Accounts;

        try
        {
            var tab = Workspace.OpenNewEntityTab(entityType);

            InitializeNewModel(tab);

            // مهم جداً:
            // لا نعيد رسم الواجهة إلا بعد تجهيز Model.
            Workspace.NotifyStateChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Error(
                $"تعذر فتح نموذج جديد: {ex.Message}");
        }
    }

    private void InitializeNewModel(AccountingTabState tab)
    {
        tab.Model = tab.EntityType switch
        {
            AccountingEntityType.Accounts =>
                new AccountEditor.FormModel(),

            AccountingEntityType.FiscalYears =>
                new FiscalYearEditor.FormModel(),

            AccountingEntityType.FiscalPeriods =>
                new FiscalPeriodEditor.FormModel(),

            AccountingEntityType.Journals =>
                new JournalEntryEditor.FormModel(),

            AccountingEntityType.ReceiptVouchers =>
                new ReceiptVoucherEditor.FormModel(),

            AccountingEntityType.PaymentVouchers =>
                new PaymentVoucherEditor.FormModel(),

            AccountingEntityType.PaymentAllocations =>
                new PaymentAllocationEditor.FormModel(),

            AccountingEntityType.CashAccounts =>
                new CashAccountEditor.FormModel(),

            AccountingEntityType.BankAccounts =>
                new BankAccountEditor.FormModel(),

            AccountingEntityType.CashShifts =>
                new CashShiftEditor.FormModel(),

            AccountingEntityType.Expenses =>
                new ExpenseEditor.FormModel(),

            AccountingEntityType.ExpenseTypes =>
                new ExpenseTypeEditor.FormModel(),

            AccountingEntityType.CostCenters =>
                new CostCenterEditor.FormModel(),

            AccountingEntityType.CustomerAccounts =>
                new CustomerAccountEditor.FormModel(),

            AccountingEntityType.SupplierAccounts =>
                new SupplierAccountEditor.FormModel(),

            AccountingEntityType.PostingProfiles =>
                new PostingProfileEditor.FormModel(),

            _ => throw new InvalidOperationException(
                $"لا يوجد Editor مهيأ للنوع المحاسبي: {tab.EntityType}")
        };

        tab.IsInitialized = true;
    }

    private async Task RefreshActiveAsync()
    {
        if (Workspace.ActiveTab is { IsListTab: true })
        {
            await LoadActiveListDataAsync();
        }
        else if (Workspace.ActiveTab is { EntityId: { } id } tab)
        {
            await LoadExistingRecordAsync(tab, id);
        }
    }

    private async Task OnSearchAsync(string text)
    {
        _searchText = text;
        _pageNumber = 1;
        await LoadActiveListDataAsync();
    }

    private PageRequest BuildPageRequest() => new()
    {
        PageNumber = _pageNumber,
        PageSize = _pageSize,
        Search = string.IsNullOrWhiteSpace(_searchText) ? null : _searchText
    };

    private async Task LoadActiveListDataAsync()
    {
        var entityType = Workspace.ActiveTab?.EntityType ?? Section ?? AccountingEntityType.Accounts;
        _isLoading = true;
        try
        {
            var req = BuildPageRequest();
            switch (entityType)
            {
                case AccountingEntityType.Accounts:
                    _accountsPage = await AccountingService.GetAccountsPageAsync(req);
                    break;
                case AccountingEntityType.Journals:
                    _journalsPage = await AccountingService.GetJournalsPageAsync(req);
                    break;
                case AccountingEntityType.ReceiptVouchers:
                    _receiptsPage = await AccountingService.GetReceiptVouchersPageAsync(req);
                    break;
                case AccountingEntityType.PaymentVouchers:
                    _paymentsPage = await AccountingService.GetPaymentVouchersPageAsync(req);
                    break;
                case AccountingEntityType.CashAccounts:
                    _cashAccountsPage = await AccountingService.GetCashAccountsPageAsync(req);
                    break;
                case AccountingEntityType.BankAccounts:
                    _bankAccountsPage = await AccountingService.GetBankAccountsPageAsync(req);
                    break;
                case AccountingEntityType.CashShifts:
                    _cashShiftsPage = await AccountingService.GetCashShiftsPageAsync(req);
                    break;
                case AccountingEntityType.Expenses:
                    _expensesPage = await AccountingService.GetExpensesPageAsync(req);
                    break;
                case AccountingEntityType.ExpenseTypes:
                    _expenseTypesPage = await AccountingService.GetExpenseTypesPageAsync(req);
                    break;
                case AccountingEntityType.CustomerAccounts:
                    _customerAccountsPage = await AccountingService.GetCustomerAccountsPageAsync(req);
                    break;
                case AccountingEntityType.SupplierAccounts:
                    _supplierAccountsPage = await AccountingService.GetSupplierAccountsPageAsync(req);
                    break;
                case AccountingEntityType.FiscalYears:
                    _fiscalYearsPage = await AccountingService.GetFiscalYearsPageAsync(req);
                    break;
                case AccountingEntityType.FiscalPeriods:
                    _fiscalPeriodsPage = await AccountingService.GetFiscalPeriodsPageAsync(req);
                    break;
                case AccountingEntityType.CostCenters:
                    _costCentersPage = await AccountingService.GetCostCentersPageAsync(req);
                    break;
                case AccountingEntityType.PostingProfiles:
                    _postingProfilesPage = await AccountingService.GetPostingProfilesPageAsync(req);
                    break;
                case AccountingEntityType.PaymentAllocations:
                    _allocationsPage = await AccountingService.GetPaymentAllocationsPageAsync(req);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Error("حدث خطأ أثناء تحميل البيانات: " + ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenRecordInTab(AccountingEntityType entityType, Guid id, string title)
    {
        var tab = Workspace.OpenOrActivateEntityTab(entityType, id, title);
        if (!tab.IsInitialized)
        {
            await LoadExistingRecordAsync(tab, id);
        }
    }

    private async Task LoadExistingRecordAsync(AccountingTabState tab, Guid id)
    {
        tab.IsLoading = true;
        try
        {
            switch (tab.EntityType)
            {
                case AccountingEntityType.Accounts:
                    var acc = await AccountingService.GetAccountByIdAsync(id);
                    if (acc is not null)
                    {
                        tab.Model = new AccountEditor.FormModel
                        {
                            Code = acc.Code,
                            NameAr = acc.NameAr,
                            NameEn = acc.NameEn,
                            ParentAccountId = acc.ParentAccountId,
                            Level = acc.Level,
                            AccountClass = acc.AccountClass,
                            AccountType = acc.AccountType,
                            NormalBalance = acc.NormalBalance,
                            IsPostingAccount = acc.IsPostingAccount,
                            IsControlAccount = acc.IsControlAccount,
                            AllowManualPosting = acc.AllowManualPosting,
                            IsSystemAccount = acc.IsSystemAccount,
                            IsActive = acc.IsActive,
                            EffectiveDate = acc.EffectiveDate
                        };
                        tab.Title = $"{acc.Code} - {acc.NameAr}";
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.Journals:
                    var journal = await AccountingService.GetJournalByIdAsync(id);
                    if (journal is not null)
                    {
                        tab.Model = new JournalEntryEditor.FormModel
                        {
                            JournalNumber = journal.JournalNumber,
                            JournalType = journal.JournalType,
                            PostingDate = journal.PostingDate,
                            DocumentDate = journal.DocumentDate,
                            FiscalPeriodId = journal.FiscalPeriodId,
                            Description = journal.Description,
                            ReferenceNumber = journal.SourceDocumentType,
                            Status = journal.Status,
                            Lines = journal.Lines.Select(l => new UiJournalLinesEditor.EditableJournalLine
                            {
                                AccountId = l.AccountId,
                                AccountDisplay = l.AccountId.ToString()[..8],
                                Description = l.Description ?? string.Empty,
                                CostCenterId = l.CostCenterId,
                                CostCenterDisplay = l.CostCenterId?.ToString()[..8],
                                DebitAmount = l.DebitAmount,
                                CreditAmount = l.CreditAmount
                            }).ToList()
                        };
                        tab.Title = $"قيد #{journal.JournalNumber}";
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.ReceiptVouchers:
                    var rv = (await AccountingService.GetReceiptVouchersPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (rv is not null)
                    {
                        tab.Model = new ReceiptVoucherEditor.FormModel
                        {
                            VoucherNumber = rv.VoucherNumber,
                            VoucherDate = rv.VoucherDate,
                            PartyType = rv.PartyType,
                            CustomerId = rv.CustomerId,
                            ReceivedFrom = rv.ReceivedFrom,
                            CashAccountId = rv.CashAccountId,
                            BankAccountId = rv.BankAccountId,
                            PaymentMethod = rv.PaymentMethod,
                            TotalAmount = rv.TotalAmount,
                            Description = rv.Description ?? string.Empty,
                            Status = rv.Status
                        };
                        tab.Title = $"سند قبض #{rv.VoucherNumber}";
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.PaymentVouchers:
                    var pv = (await AccountingService.GetPaymentVouchersPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (pv is not null)
                    {
                        tab.Model = new PaymentVoucherEditor.FormModel
                        {
                            VoucherNumber = pv.VoucherNumber,
                            VoucherDate = pv.VoucherDate,
                            PartyType = pv.PartyType,
                            SupplierId = pv.SupplierId,
                            BeneficiaryName = pv.BeneficiaryName,
                            CashAccountId = pv.CashAccountId,
                            BankAccountId = pv.BankAccountId,
                            PaymentMethod = pv.PaymentMethod,
                            TotalAmount = pv.TotalAmount,
                            Description = pv.Description ?? string.Empty,
                            Status = pv.Status
                        };
                        tab.Title = $"سند صرف #{pv.VoucherNumber}";
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.Expenses:
                    var exp = (await AccountingService.GetExpensesPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (exp is not null)
                    {
                        tab.Model = new ExpenseEditor.FormModel
                        {
                            ExpenseNumber = exp.ExpenseNumber,
                            ExpenseDate = exp.ExpenseDate,
                            ExpenseTypeId = exp.ExpenseTypeId,
                            ExpenseAccountId = exp.ExpenseAccountId,
                            Beneficiary = exp.Beneficiary,
                            CashAccountId = exp.CashAccountId,
                            BankAccountId = exp.BankAccountId,
                            PaymentMethod = exp.PaymentMethod,
                            Amount = exp.Amount,
                            Description = exp.Description,
                            Status = exp.Status
                        };
                        tab.Title = $"مصروف #{exp.ExpenseNumber}";
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.FiscalYears:
                    var fy = await AccountingService.GetFiscalYearByIdAsync(id);
                    if (fy is not null)
                    {
                        tab.Model = new FiscalYearEditor.FormModel
                        {
                            Code = fy.Code,
                            Name = fy.Name,
                            StartDate = fy.StartDate,
                            EndDate = fy.EndDate,
                            Status = fy.Status
                        };
                        tab.Title = fy.Name;
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.CashShifts:
                    var shift = (await AccountingService.GetCashShiftsPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (shift is not null)
                    {
                        tab.Model = new CashShiftEditor.FormModel
                        {
                            ShiftNumber = shift.ShiftNumber,
                            CashAccountId = shift.CashAccountId,
                            OpeningBalance = shift.OpeningBalance,
                            ExpectedClosingBalance = shift.ExpectedClosingBalance,
                            ActualClosingBalance = shift.ActualClosingBalance,
                            DifferenceAmount = shift.DifferenceAmount,
                            Status = shift.Status
                        };
                        tab.Title = $"وردية #{shift.ShiftNumber}";
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.CostCenters:
                    var cc = (await AccountingService.GetCostCentersPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (cc is not null)
                    {
                        tab.Model = new CostCenterEditor.FormModel
                        {
                            Code = cc.Code,
                            NameAr = cc.NameAr,
                            NameEn = cc.NameEn,
                            ParentCostCenterId = cc.ParentCostCenterId,
                            IsActive = cc.IsActive
                        };
                        tab.Title = cc.NameAr;
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.CustomerAccounts:
                    var ca = (await AccountingService.GetCustomerAccountsPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (ca is not null)
                    {
                        tab.Model = new CustomerAccountEditor.FormModel
                        {
                            CustomerId = ca.CustomerId,
                            AccountId = ca.AccountId,
                            ControlAccountId = ca.ControlAccountId,
                            IsActive = ca.IsActive
                        };
                        tab.Title = "حساب عميل";
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.SupplierAccounts:
                    var sa = (await AccountingService.GetSupplierAccountsPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (sa is not null)
                    {
                        tab.Model = new SupplierAccountEditor.FormModel
                        {
                            SupplierId = sa.SupplierId,
                            AccountId = sa.AccountId,
                            ControlAccountId = sa.ControlAccountId,
                            IsActive = sa.IsActive
                        };
                        tab.Title = "حساب مورد";
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.CashAccounts:
                    var cashAcc = (await AccountingService.GetCashAccountsPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (cashAcc is not null)
                    {
                        tab.Model = new CashAccountEditor.FormModel
                        {
                            Code = cashAcc.Code,
                            Name = cashAcc.Name,
                            AccountId = cashAcc.AccountId,
                            IsDefault = cashAcc.IsDefault,
                            IsActive = cashAcc.IsActive
                        };
                        tab.Title = cashAcc.Name;
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.BankAccounts:
                    var bankAcc = (await AccountingService.GetBankAccountsPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (bankAcc is not null)
                    {
                        tab.Model = new BankAccountEditor.FormModel
                        {
                            Code = bankAcc.Code,
                            BankName = bankAcc.BankName,
                            AccountName = bankAcc.AccountName,
                            AccountNumber = bankAcc.AccountNumber,
                            IBAN = bankAcc.IBAN,
                            AccountId = bankAcc.AccountId,
                            IsActive = bankAcc.IsActive
                        };
                        tab.Title = bankAcc.BankName;
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.ExpenseTypes:
                    var et = (await AccountingService.GetExpenseTypesPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (et is not null)
                    {
                        tab.Model = new ExpenseTypeEditor.FormModel
                        {
                            Code = et.Code,
                            NameAr = et.NameAr,
                            NameEn = et.NameEn,
                            DefaultExpenseAccountId = et.DefaultExpenseAccountId,
                            IsActive = et.IsActive
                        };
                        tab.Title = et.NameAr;
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.PostingProfiles:
                    var pp = (await AccountingService.GetPostingProfilesPageAsync(new PageRequest { PageNumber = 1, PageSize = 100 })).Items?.FirstOrDefault(x => x.Id == id);
                    if (pp is not null)
                    {
                        tab.Model = new PostingProfileEditor.FormModel
                        {
                            Code = pp.Code,
                            Name = pp.Name,
                            Module = pp.Module,
                            DocumentType = pp.DocumentType,
                            IsActive = pp.IsActive,
                            Lines = pp.Lines.Select(l => new PostingProfileEditor.EditablePostingProfileLine
                            {
                                AccountRole = l.AccountRole,
                                AccountId = l.AccountId,
                                AccountDisplay = l.AccountId.ToString()[..8],
                                IsRequired = l.IsRequired
                            }).ToList()
                        };
                        tab.Title = pp.Name;
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;

                case AccountingEntityType.PaymentAllocations:
                    var alloc = await AccountingService.GetPaymentAllocationByIdAsync(id);
                    if (alloc is not null)
                    {
                        tab.Model = new PaymentAllocationEditor.FormModel
                        {
                            PaymentSourceType = alloc.PaymentSourceType,
                            PaymentSourceId = alloc.PaymentSourceId,
                            TargetDocumentType = alloc.TargetDocumentType,
                            TargetDocumentId = alloc.TargetDocumentId,
                            AllocatedAmount = alloc.AllocatedAmount,
                            AllocatedAtUtc = alloc.AllocatedAtUtc
                        };
                        tab.Title = $"تخصيص #{alloc.AllocatedAmount:N0}";
                        tab.CaptureBaseline(System.Text.Json.JsonSerializer.Serialize(tab.Model));
                    }
                    break;
            }
            tab.IsInitialized = true;
        }
        catch (Exception ex)
        {
            Snackbar.Error("فشل تحميل بيانات السجل: " + ex.Message);
            Workspace.RemoveTab(tab.TabId);
        }
        finally
        {
            tab.IsLoading = false;
        }
    }

    private async Task SaveActiveAsync()
    {
        var tab = Workspace.ActiveTab;
        if (tab is null || tab.IsListTab || tab.Model is null) return;

        tab.IsSaving = true;
        try
        {
            switch (tab.EntityType)
            {
                case AccountingEntityType.Accounts:
                    if (tab.Model is AccountEditor.FormModel accModel)
                    {
                        if (string.IsNullOrWhiteSpace(accModel.Code) || string.IsNullOrWhiteSpace(accModel.NameAr))
                        {
                            Snackbar.Warning("يرجى إدخال كود واسم الحساب.");
                            return;
                        }

                        if (tab.IsNew)
                        {
                            var req = new CreateAccountRequest(
                                accModel.Code,
                                accModel.NameAr,
                                accModel.NameEn,
                                accModel.ParentAccountId,
                                (byte)accModel.Level,
                                accModel.AccountClass,
                                accModel.AccountType,
                                accModel.NormalBalance,
                                accModel.IsPostingAccount,
                                accModel.IsControlAccount,
                                accModel.AllowManualPosting,
                                accModel.IsSystemAccount,
                                accModel.IsActive,
                                accModel.EffectiveDate);

                            var res = await AccountingService.CreateAccountAsync(req);
                            if (res is not null)
                            {
                                Snackbar.Success("تم إنشاء الحساب بنجاح.");
                                tab.CompleteSave(res.Id, $"{res.Code} - {res.NameAr}", accModel, System.Text.Json.JsonSerializer.Serialize(accModel));
                            }
                        }
                        else if (tab.EntityId.HasValue)
                        {
                            var req = new UpdateAccountRequest(
                                accModel.Code,
                                accModel.NameAr,
                                accModel.NameEn,
                                accModel.ParentAccountId,
                                (byte)accModel.Level,
                                accModel.AccountClass,
                                accModel.AccountType,
                                accModel.NormalBalance,
                                accModel.IsPostingAccount,
                                accModel.IsControlAccount,
                                accModel.AllowManualPosting,
                                accModel.IsSystemAccount,
                                accModel.IsActive,
                                accModel.EffectiveDate,
                                "rowversion");

                            var res = await AccountingService.UpdateAccountAsync(tab.EntityId.Value, req);
                            if (res is not null)
                            {
                                Snackbar.Success("تم تحديث الحساب بنجاح.");
                                tab.CompleteSave(res.Id, $"{res.Code} - {res.NameAr}", accModel, System.Text.Json.JsonSerializer.Serialize(accModel));
                            }
                        }
                    }
                    break;

                case AccountingEntityType.Journals:
                    if (tab.Model is JournalEntryEditor.FormModel jModel)
                    {
                        if (string.IsNullOrWhiteSpace(jModel.Description))
                        {
                            Snackbar.Warning("يرجى إدخال بيان القيد.");
                            return;
                        }

                        if (jModel.Lines.Count == 0)
                        {
                            Snackbar.Warning("يجب إضافة سطرين على الأقل للقيد.");
                            return;
                        }

                        var debit = jModel.Lines.Sum(l => l.DebitAmount);
                        var credit = jModel.Lines.Sum(l => l.CreditAmount);
                        if (debit != credit || debit == 0)
                        {
                            Snackbar.Warning("القيد غير متوازن، يجب أن يتساوى إجمالي المدين والدائن.");
                            return;
                        }

                        var lines = jModel.Lines.Select(l => new CreateJournalEntryLineRequest(
                            l.AccountId ?? Guid.Empty,
                            l.DebitAmount,
                            l.CreditAmount,
                            l.Description,
                            null,
                            null,
                            l.CostCenterId)).ToList();

                        var req = new CreateJournalEntryRequest(
                            jModel.JournalType,
                            jModel.PostingDate,
                            jModel.DocumentDate,
                            jModel.FiscalPeriodId ?? Guid.NewGuid(),
                            jModel.Description,
                            null,
                            null,
                            null,
                            lines);

                        var res = await AccountingService.CreateJournalAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم حفظ قيد اليومية بنجاح.");
                            jModel.JournalNumber = res.JournalNumber;
                            tab.CompleteSave(res.Id, $"قيد #{res.JournalNumber}", jModel, System.Text.Json.JsonSerializer.Serialize(jModel));
                        }
                    }
                    break;

                case AccountingEntityType.ReceiptVouchers:
                    if (tab.Model is ReceiptVoucherEditor.FormModel rvModel)
                    {
                        if (rvModel.TotalAmount <= 0)
                        {
                            Snackbar.Warning("يرجى إدخال مبلغ صحيح لسند القبض.");
                            return;
                        }

                        var req = new CreateReceiptVoucherRequest(
                            rvModel.VoucherDate,
                            rvModel.PartyType,
                            rvModel.CustomerId,
                            rvModel.ReceivedFrom,
                            rvModel.PaymentMethod,
                            rvModel.CashAccountId,
                            rvModel.BankAccountId,
                            rvModel.TotalAmount,
                            rvModel.Description,
                            []);

                        var res = await AccountingService.CreateReceiptVoucherAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إصدار سند القبض بنجاح.");
                            rvModel.VoucherNumber = res.VoucherNumber;
                            tab.CompleteSave(res.Id, $"سند قبض #{res.VoucherNumber}", rvModel, System.Text.Json.JsonSerializer.Serialize(rvModel));
                        }
                    }
                    break;

                case AccountingEntityType.PaymentVouchers:
                    if (tab.Model is PaymentVoucherEditor.FormModel pvModel)
                    {
                        if (pvModel.TotalAmount <= 0)
                        {
                            Snackbar.Warning("يرجى إدخال مبلغ صحيح لسند الصرف.");
                            return;
                        }

                        var req = new CreatePaymentVoucherRequest(
                            pvModel.VoucherDate,
                            pvModel.PartyType,
                            pvModel.SupplierId,
                            pvModel.BeneficiaryName,
                            pvModel.PaymentMethod,
                            pvModel.CashAccountId,
                            pvModel.BankAccountId,
                            pvModel.TotalAmount,
                            pvModel.Description,
                            []);

                        var res = await AccountingService.CreatePaymentVoucherAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إصدار سند الصرف بنجاح.");
                            pvModel.VoucherNumber = res.VoucherNumber;
                            tab.CompleteSave(res.Id, $"سند صرف #{res.VoucherNumber}", pvModel, System.Text.Json.JsonSerializer.Serialize(pvModel));
                        }
                    }
                    break;

                case AccountingEntityType.Expenses:
                    if (tab.Model is ExpenseEditor.FormModel expModel)
                    {
                        if (expModel.Amount <= 0 || !expModel.ExpenseTypeId.HasValue || !expModel.ExpenseAccountId.HasValue)
                        {
                            Snackbar.Warning("يرجى اختيار نوع وبند وحساب المصروف وإدخال المبلغ.");
                            return;
                        }

                        var req = new CreateExpenseRequest(
                            expModel.ExpenseDate,
                            expModel.ExpenseTypeId.Value,
                            expModel.ExpenseAccountId.Value,
                            expModel.Beneficiary,
                            expModel.Amount,
                            expModel.PaymentMethod,
                            expModel.CashAccountId,
                            expModel.BankAccountId,
                            expModel.Description);

                        var res = await AccountingService.CreateExpenseAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم حفظ سند المصروف بنجاح.");
                            expModel.ExpenseNumber = res.ExpenseNumber;
                            tab.CompleteSave(res.Id, $"مصروف #{res.ExpenseNumber}", expModel, System.Text.Json.JsonSerializer.Serialize(expModel));
                        }
                    }
                    break;

                case AccountingEntityType.CashAccounts:
                    if (tab.Model is CashAccountEditor.FormModel caModel)
                    {
                        if (string.IsNullOrWhiteSpace(caModel.Code) || string.IsNullOrWhiteSpace(caModel.Name) || !caModel.AccountId.HasValue)
                        {
                            Snackbar.Warning("يرجى استكمال كود واسم وحساب الصندوق.");
                            return;
                        }

                        var req = new CreateCashAccountRequest(caModel.Code, caModel.Name, caModel.AccountId.Value, caModel.IsDefault, caModel.IsActive);
                        var res = await AccountingService.CreateCashAccountAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إنشاء حساب الصندوق بنجاح.");
                            tab.CompleteSave(res.Id, res.Name, caModel, System.Text.Json.JsonSerializer.Serialize(caModel));
                        }
                    }
                    break;

                case AccountingEntityType.BankAccounts:
                    if (tab.Model is BankAccountEditor.FormModel baModel)
                    {
                        if (string.IsNullOrWhiteSpace(baModel.Code) || string.IsNullOrWhiteSpace(baModel.BankName) || string.IsNullOrWhiteSpace(baModel.AccountNumber) || !baModel.AccountId.HasValue)
                        {
                            Snackbar.Warning("يرجى استكمال كود وبيانات البنك ورقم الحساب والحساب المحاسبي.");
                            return;
                        }

                        var req = new CreateBankAccountRequest(baModel.Code, baModel.BankName, baModel.AccountName, baModel.AccountNumber, baModel.IBAN, baModel.AccountId.Value, baModel.IsActive);
                        var res = await AccountingService.CreateBankAccountAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إنشاء الحساب البنكي بنجاح.");
                            tab.CompleteSave(res.Id, res.BankName, baModel, System.Text.Json.JsonSerializer.Serialize(baModel));
                        }
                    }
                    break;

                case AccountingEntityType.CostCenters:
                    if (tab.Model is CostCenterEditor.FormModel ccModel)
                    {
                        if (string.IsNullOrWhiteSpace(ccModel.Code) || string.IsNullOrWhiteSpace(ccModel.NameAr))
                        {
                            Snackbar.Warning("يرجى إدخال كود واسم مركز التكلفة.");
                            return;
                        }

                        var req = new CreateCostCenterRequest(ccModel.Code, ccModel.NameAr, ccModel.NameEn, ccModel.ParentCostCenterId, ccModel.IsActive);
                        var res = await AccountingService.CreateCostCenterAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إنشاء مركز التكلفة بنجاح.");
                            tab.CompleteSave(res.Id, res.NameAr, ccModel, System.Text.Json.JsonSerializer.Serialize(ccModel));
                        }
                    }
                    break;

                case AccountingEntityType.FiscalYears:
                    if (tab.Model is FiscalYearEditor.FormModel fyModel)
                    {
                        if (string.IsNullOrWhiteSpace(fyModel.Code) || string.IsNullOrWhiteSpace(fyModel.Name))
                        {
                            Snackbar.Warning("يرجى إدخال كود واسم السنة المالية.");
                            return;
                        }

                        var req = new CreateFiscalYearRequest(fyModel.Code, fyModel.Name, fyModel.StartDate, fyModel.EndDate);
                        var res = await AccountingService.CreateFiscalYearAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إنشاء السنة المالية وفتراتها بنجاح.");
                            tab.CompleteSave(res.Id, res.Name, fyModel, System.Text.Json.JsonSerializer.Serialize(fyModel));
                        }
                    }
                    break;

                case AccountingEntityType.CustomerAccounts:
                    if (tab.Model is CustomerAccountEditor.FormModel custModel)
                    {
                        if (!custModel.CustomerId.HasValue || !custModel.AccountId.HasValue)
                        {
                            Snackbar.Warning("يرجى اختيار العميل والحساب المحاسبي.");
                            return;
                        }

                        var req = new CreateCustomerAccountRequest(custModel.CustomerId.Value, custModel.AccountId.Value, custModel.ControlAccountId ?? custModel.AccountId.Value, custModel.IsActive);
                        var res = await AccountingService.CreateCustomerAccountAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إنشاء حساب العميل المحاسبي بنجاح.");
                            tab.CompleteSave(res.Id, "حساب عميل", custModel, System.Text.Json.JsonSerializer.Serialize(custModel));
                        }
                    }
                    break;

                case AccountingEntityType.SupplierAccounts:
                    if (tab.Model is SupplierAccountEditor.FormModel supModel)
                    {
                        if (!supModel.SupplierId.HasValue || !supModel.AccountId.HasValue)
                        {
                            Snackbar.Warning("يرجى اختيار المورد والحساب المحاسبي.");
                            return;
                        }

                        var req = new CreateSupplierAccountRequest(supModel.SupplierId.Value, supModel.AccountId.Value, supModel.ControlAccountId ?? supModel.AccountId.Value, supModel.IsActive);
                        var res = await AccountingService.CreateSupplierAccountAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إنشاء حساب المورد المحاسبي بنجاح.");
                            tab.CompleteSave(res.Id, "حساب مورد", supModel, System.Text.Json.JsonSerializer.Serialize(supModel));
                        }
                    }
                    break;

                case AccountingEntityType.PostingProfiles:
                    if (tab.Model is PostingProfileEditor.FormModel ppModel)
                    {
                        if (string.IsNullOrWhiteSpace(ppModel.Code) || string.IsNullOrWhiteSpace(ppModel.Name))
                        {
                            Snackbar.Warning("يرجى إدخال كود واسم ملف الترحيل.");
                            return;
                        }

                        var lines = ppModel.Lines.Where(l => l.AccountId.HasValue).Select(l => new CreatePostingProfileLineRequest(l.AccountRole, l.AccountId!.Value, l.IsRequired)).ToList();
                        var req = new CreatePostingProfileRequest(ppModel.Code, ppModel.Name, ppModel.Module, ppModel.DocumentType, lines, ppModel.IsActive);
                        var res = await AccountingService.CreatePostingProfileAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إنشاء ملف الترحيل بنجاح.");
                            tab.CompleteSave(res.Id, res.Name, ppModel, System.Text.Json.JsonSerializer.Serialize(ppModel));
                        }
                    }
                    break;

                case AccountingEntityType.PaymentAllocations:
                    if (tab.Model is PaymentAllocationEditor.FormModel allocModel)
                    {
                        if (!allocModel.PaymentSourceId.HasValue || !allocModel.TargetDocumentId.HasValue || allocModel.AllocatedAmount <= 0)
                        {
                            Snackbar.Warning("يرجى اختيار مستند السداد والمستند الهدف وتحديد مبلغ التخصيص.");
                            return;
                        }

                        var req = new CreatePaymentAllocationRequest(
                            allocModel.PaymentSourceType,
                            allocModel.PaymentSourceId.Value,
                            allocModel.TargetDocumentType,
                            allocModel.TargetDocumentId.Value,
                            allocModel.AllocatedAmount);

                        var res = await AccountingService.CreatePaymentAllocationAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم إنشاء تخصيص السداد بنجاح.");
                            tab.CompleteSave(res.Id, $"تخصيص #{res.AllocatedAmount:N0}", allocModel, System.Text.Json.JsonSerializer.Serialize(allocModel));
                        }
                    }
                    break;

                case AccountingEntityType.CashShifts:
                    if (tab.Model is CashShiftEditor.FormModel shiftModel)
                    {
                        if (!shiftModel.CashAccountId.HasValue)
                        {
                            Snackbar.Warning("يرجى اختيار الصندوق.");
                            return;
                        }

                        var req = new CreateCashShiftRequest(shiftModel.CashAccountId.Value, shiftModel.OpeningBalance);
                        var res = await AccountingService.CreateCashShiftAsync(req);
                        if (res is not null)
                        {
                            Snackbar.Success("تم فتح الوردية النقدية بنجاح.");
                            shiftModel.ShiftNumber = res.ShiftNumber;
                            tab.CompleteSave(res.Id, $"وردية #{res.ShiftNumber}", shiftModel, System.Text.Json.JsonSerializer.Serialize(shiftModel));
                        }
                    }
                    break;
            }

            Workspace.NotifyStateChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Error("فشلت عملية الحفظ: " + ex.Message);
        }
        finally
        {
            tab.IsSaving = false;
        }
    }

