            <UiAlert Message="لا توجد حسابات مسجلة تطابق معايير البحث." Tone="AlertTone.Warning" />
        }
        else
        {
            @foreach (var acc in _accountsPage.Items)
            {
                <div @onclick="@(() => OpenRecordInTab(AccountingEntityType.Accounts, acc.Id, $"{acc.Code} - {acc.NameAr}"))" style="cursor: pointer;">
                    <UiAccountCard Code="@acc.Code"
                                   NameAr="@acc.NameAr"
                                   NameEn="@acc.NameEn"
                                   Level="@acc.Level"
                                   AccountClassText="@AccountingArabicPresenter.GetAccountClassText(acc.AccountClass)"
                                   AccountTypeText="@AccountingArabicPresenter.GetAccountTypeText(acc.AccountType)"
                                   NormalBalanceText="@AccountingArabicPresenter.GetNormalBalanceText(acc.NormalBalance)"
