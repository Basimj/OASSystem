@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Spreadsheets
@namespace OAS.Client.Accounting.Components
@using OAS.Client.Accounting.Workspace
@using OAS.Contracts.Accounting.Enums
@using OAS.UiLib.Components.Accounting.Accounts
@using OAS.UiLib.Components.Accounting.PostingProfiles
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Navigation
@using OAS.UiLib.Components.Workspace

@{
    var activeTab = Workspace.ActiveTab;
    var isList = activeTab is null || activeTab.IsListTab;
}

<UiAccountingWorkspace ShowTabs="@Section.HasValue"
                       InlineTabsWithActions="@(Section is AccountingEntityType.Accounts or AccountingEntityType.Journals or AccountingEntityType.ReceiptVouchers or AccountingEntityType.PaymentVouchers or AccountingEntityType.CashAccounts or AccountingEntityType.BankAccounts or AccountingEntityType.CashShifts or AccountingEntityType.FiscalYears or AccountingEntityType.CostCenters or AccountingEntityType.PostingProfiles)"
                       AdditionalCssClass='@(Section == AccountingEntityType.Accounts ? "ui-acc-workspace--account-management" : Section == AccountingEntityType.Journals ? "ui-acc-workspace--journals" : Section is AccountingEntityType.ReceiptVouchers or AccountingEntityType.PaymentVouchers ? "ui-acc-workspace--vouchers" : Section is AccountingEntityType.CashAccounts or AccountingEntityType.BankAccounts or AccountingEntityType.CashShifts ? "ui-acc-workspace--cashbank" : Section == AccountingEntityType.FiscalYears ? "ui-acc-workspace--fiscal" : Section == AccountingEntityType.CostCenters ? "ui-acc-workspace--cost-centers" : Section == AccountingEntityType.PostingProfiles ? "ui-acc-workspace--posting-profiles" : null)'>

    <Actions>

        <UiWorkspaceActionBar>

            @if (Section is null)
            {
                <UiButton Text="تحديث"
                          IconCssClass="fa-solid fa-rotate"
                          Variant="ButtonVariant.Secondary"
                          Size="ControlSize.Small"
                          OnClick="RefreshActiveAsync" />
            }
            else if (Section == AccountingEntityType.Accounts)
            {
                @if (isList)
                {
                    <UiButton Text="جديد"
                              IconCssClass="fa-solid fa-plus"
                              Size="ControlSize.Small"
                              OnClick="OpenNewRecord" />

                    <UiButton Text="تحديث"
                              IconCssClass="fa-solid fa-rotate"
                              Variant="ButtonVariant.Ghost"
                              Size="ControlSize.Small"
                              Loading="@_isLoading"
                              OnClick="RefreshActiveAsync" />
                }
                else
                {
                    @if (activeTab is not null && (activeTab.IsNew || activeTab.IsEditMode))
                    {
                        <UiButton Text="حفظ"
                                  IconCssClass="fa-solid fa-floppy-disk"
                                  Size="ControlSize.Small"
                                  Disabled="@(!CanSaveActive)"
                                  Loading="@(activeTab?.IsSaving == true)"
                                  OnClick="SaveActiveAsync" />

                        <UiButton Text="إلغاء"
                                  IconCssClass="fa-solid fa-arrow-rotate-left"
                                  Variant="ButtonVariant.Ghost"
                                  Size="ControlSize.Small"
                                  Disabled="@(!CanCancelActive)"
                                  OnClick="CancelActiveEdit" />
                    }
                    else
                    {
                        <UiButton Text="جديد"
                                  IconCssClass="fa-solid fa-plus"
                                  Variant="ButtonVariant.Secondary"
                                  Size="ControlSize.Small"
                                  OnClick="@(() => OpenNewRecord(AccountingEntityType.Accounts))" />

                        <UiButton Text="تعديل"
                                  IconCssClass="fa-solid fa-pen-to-square"
                                  Variant="ButtonVariant.Secondary"
                                  Size="ControlSize.Small"
                                  Disabled="@(!CanEditActive)"
                                  OnClick="BeginEditActive" />
                    }

                    <UiButton Text="تحديث"
                              IconCssClass="fa-solid fa-rotate"
                              Variant="ButtonVariant.Ghost"
                              Size="ControlSize.Small"
                              Disabled="@(activeTab?.IsNew == true)"
                              OnClick="RefreshActiveAsync" />

                    <UiButton Text="إغلاق"
                              IconCssClass="fa-solid fa-xmark"
                              Variant="ButtonVariant.Ghost"
                              Size="ControlSize.Small"
                              Disabled="@(!CanCloseActive)"
                              OnClick="CloseActiveTabAsync" />
                }
            }
            else if (isList)
            {
                @if (Section == AccountingEntityType.Journals)
                {
                    <UiButton Text="قيد جديد"
                              IconCssClass="fa-solid fa-plus"
                              Size="ControlSize.Small"
                              OnClick="@(() => OpenNewRecord(AccountingEntityType.Journals))" />
                }
                else if (Section == AccountingEntityType.CashAccounts)
                {
                    <UiButton Text="صندوق جديد"
                              IconCssClass="fa-solid fa-vault"
                              Size="ControlSize.Small"
                              OnClick="@(() => OpenNewRecord(AccountingEntityType.CashAccounts))" />
                }
                else if (Section == AccountingEntityType.BankAccounts)
                {
                    <UiButton Text="حساب بنكي جديد"
                              IconCssClass="fa-solid fa-building-columns"
                              Size="ControlSize.Small"
                              OnClick="@(() => OpenNewRecord(AccountingEntityType.BankAccounts))" />
                }
                else if (Section == AccountingEntityType.CashShifts)
                {
                    <UiButton Text="فتح وردية جديدة"
                              IconCssClass="fa-solid fa-cash-register"
                              Size="ControlSize.Small"
                              OnClick="@(() => OpenNewRecord(AccountingEntityType.CashShifts))" />
                }
                else if (Section == AccountingEntityType.FiscalYears)
                {
                    <UiButton Text="سنة مالية جديدة"
                              IconCssClass="fa-solid fa-calendar-plus"
                              Size="ControlSize.Small"
                              OnClick="@(() => OpenNewRecord(AccountingEntityType.FiscalYears))" />

                    <UiButton Text="فترة مالية جديدة"
                              IconCssClass="fa-solid fa-calendar-week"
                              Disabled="@(!_selectedFiscalYearId.HasValue)"
                              Variant="ButtonVariant.Secondary"
                              Size="ControlSize.Small"
                              OnClick="@(() => OpenNewRecord(AccountingEntityType.FiscalPeriods))" />
                }
                else if (Section == AccountingEntityType.PostingProfiles)
                {
                    <UiButton Text="ملف ترحيل جديد" IconCssClass="fa-solid fa-plus"
                              Size="ControlSize.Small"
                              OnClick="@(() => OpenNewRecord(AccountingEntityType.PostingProfiles))" />
                }
                else if (Section == AccountingEntityType.Expenses)
                {
                    <UiButton Text="مصروف جديد"
                              IconCssClass="fa-solid fa-receipt"
                              Size="ControlSize.Small"
                              OnClick="@(() => OpenNewRecord(AccountingEntityType.Expenses))" />

                    <UiButton Text="نوع مصروف جديد"
                              IconCssClass="fa-solid fa-tags"
                              Variant="ButtonVariant.Secondary"
                              Size="ControlSize.Small"
                              OnClick="@(() => OpenNewRecord(AccountingEntityType.ExpenseTypes))" />
                }
                else
                {
                    <UiButton Text="جديد"
                              IconCssClass="fa-solid fa-plus"
                              Size="ControlSize.Small"
                              OnClick="OpenNewRecord" />
                }

                @if (Section is AccountingEntityType.ReceiptVouchers
                            or AccountingEntityType.PaymentVouchers)
                {
                    <UiButton Text="تخصيص دفعة"
                              IconCssClass="fa-solid fa-link"
                              Variant="ButtonVariant.Secondary"
                              Size="ControlSize.Small"
                              OnClick="OpenNewAllocationForSectionAsync" />
                }

                <UiButton Text="تحديث"
                          IconCssClass="fa-solid fa-rotate"
                          Variant="ButtonVariant.Ghost"
                          Size="ControlSize.Small"
                          Loading="@_isLoading"
                          OnClick="RefreshActiveAsync" />

                @if (SpreadsheetSection(Section) is not null)
                {
                    <UiSpreadsheetActions CanImport="@SpreadsheetCanImport(Section)"
                                          Busy="_spreadsheetBusy"
                                          OnImport="@(() => OpenSpreadsheet(Section!.Value))"
                                          OnTemplate="@(() => DownloadSpreadsheet(Section!.Value, true))"
                                          OnExport="@(() => DownloadSpreadsheet(Section!.Value, false))" />
                }

                <UiSearchInput Value="@CurrentSearch"
                               ValueChanged="SetCurrentSearch"
                               OnSearch="OnSearchAsync"
                               Placeholder="@CurrentSearchPlaceholder"
                               DebounceMilliseconds="300" />
            }
            else
            {
                @if (activeTab is not null &&
                     (activeTab.EntityType == AccountingEntityType.CashAccounts ||
                      activeTab.EntityType == AccountingEntityType.BankAccounts ||
                      activeTab.EntityType == AccountingEntityType.CashShifts))
                {
                    @if (activeTab.IsNew || activeTab.IsEditMode)
                    {
                        <UiButton Text="حفظ" IconCssClass="fa-solid fa-floppy-disk"
                                  Size="ControlSize.Small" Disabled="@(!CanSaveActive)"
                                  Loading="@activeTab.IsSaving" OnClick="SaveActiveAsync" />
                        <UiButton Text="إلغاء" IconCssClass="fa-solid fa-arrow-rotate-left"
                                  Variant="ButtonVariant.Ghost" Size="ControlSize.Small"
                                  Disabled="@(!CanCancelActive)" OnClick="CancelActiveEdit" />
                    }
                    else if (activeTab.EntityType == AccountingEntityType.CashAccounts || activeTab.EntityType == AccountingEntityType.BankAccounts)
                    {
                        <UiButton Text="تعديل" IconCssClass="fa-solid fa-pen-to-square"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  Disabled="@(!CanEditActive)" OnClick="BeginEditActive" />
                    }
                }
                else if (ShowStandardEditActions && activeTab?.EntityType != AccountingEntityType.PaymentAllocations)
                {
                    <UiButton Text="تعديل"
                              IconCssClass="fa-solid fa-pen-to-square"
                              Variant="ButtonVariant.Secondary"
                              Size="ControlSize.Small"
                              Disabled="@(!CanEditActive)"
                              OnClick="BeginEditActive" />

                    <UiButton Text="@(activeTab?.EntityType == AccountingEntityType.Journals ? "حفظ المسودة" : "حفظ")"
                              IconCssClass="fa-solid fa-floppy-disk"
                              Size="ControlSize.Small"
                              Disabled="@(!CanSaveActive)"
                              Loading="@(activeTab?.IsSaving == true)"
                              OnClick="SaveActiveAsync" />

                    <UiButton Text="إلغاء التعديل"
                              IconCssClass="fa-solid fa-arrow-rotate-left"
                              Variant="ButtonVariant.Ghost"
                              Size="ControlSize.Small"
                              Disabled="@(!CanCancelActive)"
                              OnClick="CancelActiveEdit" />
                }

                @if (activeTab is { IsNew: false, EntityType: AccountingEntityType.PostingProfiles,
                    Model: PostingProfileEditor.FormModel postingProfile })
                {
                    <UiButton Text="@(postingProfile.IsActive ? "تعطيل ملف الترحيل" : "تفعيل ملف الترحيل")"
                              IconCssClass="@(postingProfile.IsActive ? "fa-solid fa-ban" : "fa-solid fa-circle-check")"
                              Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                              Disabled="@(!CanChangePostingProfileStatus)"
                              Loading="@_postingProfileActionBusy"
                              OnClick="@(() => ChangePostingProfileStatusAsync(!postingProfile.IsActive))" />
                }

                @if (activeTab is { IsNew: false, Model: FiscalYearEditor.FormModel activeYear } &&
                     activeTab.EntityType == AccountingEntityType.FiscalYears)
                {
                    @if (activeYear.Status == FiscalYearStatus.Future || activeYear.Status == FiscalYearStatus.Closing)
                    {
                        <UiButton Text="فتح السنة" IconCssClass="fa-solid fa-lock-open"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  Disabled="@(!CanRunFiscalAction(activeTab) || _fiscalActionBusy)"
                                  OnClick="@(() => ChangeActiveFiscalYearStatusAsync(FiscalYearStatus.Open))" />
                    }
                    @if (activeYear.Status == FiscalYearStatus.Open)
                    {
                        <UiButton Text="بدء الإقفال" IconCssClass="fa-solid fa-hourglass-start"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  Disabled="@(!CanRunFiscalAction(activeTab) || _fiscalActionBusy)"
                                  OnClick="@(() => ChangeActiveFiscalYearStatusAsync(FiscalYearStatus.Closing))" />
                    }
                    @if (activeYear.Status == FiscalYearStatus.Closing)
                    {
                        <UiButton Text="فحص الجاهزية" IconCssClass="fa-solid fa-list-check"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  Disabled="@(!CanRunFiscalAction(activeTab) || _fiscalActionBusy)"
                                  OnClick="CheckActiveFiscalReadinessAsync" />
                        <UiButton Text="الإقفال النهائي" IconCssClass="fa-solid fa-lock"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  Disabled="@(!CanRunFiscalAction(activeTab) || _fiscalActionBusy)"
                                  OnClick="@(() => ChangeActiveFiscalYearStatusAsync(FiscalYearStatus.Closed))" />
                    }
                }
                @if (activeTab is { IsNew: false, Model: FiscalPeriodEditor.FormModel activePeriod } &&
                     activeTab.EntityType == AccountingEntityType.FiscalPeriods)
                {
                    @if (activePeriod.Status == FiscalPeriodStatus.Open)
                    {
                        <UiButton Text="إغلاق مبدئي" IconCssClass="fa-solid fa-clock"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  Disabled="@(!CanRunFiscalAction(activeTab) || _fiscalActionBusy)"
                                  OnClick="@(() => ChangeActiveFiscalPeriodStatusAsync(FiscalPeriodStatus.SoftClosed))" />
                    }
                    @if (activePeriod.Status != FiscalPeriodStatus.Closed)
                    {
                        <UiButton Text="فحص الجاهزية" IconCssClass="fa-solid fa-list-check"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  Disabled="@(!CanRunFiscalAction(activeTab) || _fiscalActionBusy)"
                                  OnClick="CheckActiveFiscalReadinessAsync" />
                        @if (activePeriod.Status == FiscalPeriodStatus.SoftClosed)
                        {
                        <UiButton Text="إغلاق نهائي" IconCssClass="fa-solid fa-lock"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  Disabled="@(!CanRunFiscalAction(activeTab) || _fiscalActionBusy)"
                                  OnClick="@(() => ChangeActiveFiscalPeriodStatusAsync(FiscalPeriodStatus.Closed))" />
                        }
                    }
                }

                @if (activeTab is not null &&
                           !activeTab.IsNew &&
                           activeTab.EntityType is AccountingEntityType.ReceiptVouchers
                                                   or AccountingEntityType.PaymentVouchers)
                {
                    <UiButton Text="طباعة"
                              IconCssClass="fa-solid fa-print"
                              Variant="ButtonVariant.Secondary"
                              Size="ControlSize.Small"
                              Loading="@_isPrinting"
                              Disabled="@(!CanPrintActive || _isPrinting)"
                              OnClick="PrintActiveVoucherAsync" />
                }

                @if (activeTab is { IsNew: false, IsDirty: false } &&
                     (activeTab.Model is ReceiptVoucherEditor.FormModel { Status: ReceiptVoucherStatus.Posted } ||
                      activeTab.Model is PaymentVoucherEditor.FormModel { Status: PaymentVoucherStatus.Posted }))
                {
                    <UiButton Text="تخصيص دفعة"
                              IconCssClass="fa-solid fa-link"
                              Variant="ButtonVariant.Secondary"
                              Size="ControlSize.Small"
                              OnClick="OpenAllocationForActiveVoucherAsync" />
                }

                @if (activeTab is { EntityType: AccountingEntityType.CashShifts, EntityId: Guid, IsNew: false, IsSaving: false } &&
                     activeTab.Model is CashShiftEditor.FormModel activeShift)
                {
                    @if (activeShift.Status == CashShiftStatus.Open)
                    {
                        <UiButton Text="إغلاق الوردية" IconCssClass="fa-solid fa-lock"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  OnClick="CloseActiveCashShiftAsync" />
                    }
                    else if (activeShift.Status == CashShiftStatus.Closed)
                    {
                        <UiButton Text="اعتماد الوردية" IconCssClass="fa-solid fa-circle-check"
                                  Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                                  OnClick="ApproveActiveCashShiftAsync" />
                    }
                }

                <UiButton Text="تحديث"
                          IconCssClass="fa-solid fa-rotate"
                          Variant="ButtonVariant.Ghost"
                          Size="ControlSize.Small"
                          Disabled="@(activeTab?.IsNew == true)"
                          OnClick="RefreshActiveAsync" />

                @if (activeTab is not null)
                {
                    @if (activeTab.EntityType == AccountingEntityType.Journals &&
                                activeTab.Model is JournalEntryEditor.FormModel journal)
                    {
                        @if (journal.Status == JournalEntryStatus.Draft)
                        {
                            <UiButton Text="إرسال للاعتماد"
                                      IconCssClass="fa-solid fa-paper-plane"
                                      Variant="ButtonVariant.Secondary"
                                      Size="ControlSize.Small"
                                      Disabled="@(activeTab.IsNew || activeTab.IsDirty || activeTab.IsEditMode || activeTab.IsSaving)"
                                      OnClick="@(() => ChangeJournalStatusAsync(JournalEntryStatus.PendingApproval))" />
                        }
                        else if (journal.Status == JournalEntryStatus.PendingApproval)
                        {
                            <UiButton Text="اعتماد"
                                      IconCssClass="fa-solid fa-circle-check"
                                      Variant="ButtonVariant.Secondary"
                                      Size="ControlSize.Small"
                                      Disabled="@(activeTab.IsNew || activeTab.IsDirty || activeTab.IsEditMode || activeTab.IsSaving)"
                                      OnClick="@(() => ChangeJournalStatusAsync(JournalEntryStatus.Approved))" />
                        }
                        else if (journal.Status == JournalEntryStatus.Approved)
                        {
                            <UiButton Text="ترحيل"
                                      IconCssClass="fa-solid fa-check-double"
                                      Size="ControlSize.Small"
                                      Disabled="@(activeTab.IsNew || activeTab.IsDirty || activeTab.IsEditMode || activeTab.IsSaving)"
                                      OnClick="@(() => ChangeJournalStatusAsync(JournalEntryStatus.Posted))" />
                        }
                        else if (journal.Status == JournalEntryStatus.Posted && !journal.ReversedJournalId.HasValue)
                        {
                            <UiButton Text="عكس القيد"
                                      IconCssClass="fa-solid fa-arrow-rotate-left"
                                      Variant="ButtonVariant.Danger"
                                      Size="ControlSize.Small"
                                      Disabled="@(activeTab.IsNew || activeTab.IsDirty || activeTab.IsEditMode || activeTab.IsSaving)"
                                      OnClick="ReverseActiveJournalAsync" />
                        }
                    }
                    else if (activeTab.EntityType == AccountingEntityType.ReceiptVouchers &&
                    activeTab.Model is ReceiptVoucherEditor.FormModel receipt)
                    {
                        @if (receipt.Status == ReceiptVoucherStatus.Draft)
                        {
                            <UiButton Text="اعتماد"
                                      IconCssClass="fa-solid fa-circle-check"
                                      Variant="ButtonVariant.Secondary"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanApproveActiveVoucher)"
                                      OnClick="@(() => ChangeReceiptStatusAsync(ReceiptVoucherStatus.Approved))" />

                            <UiButton Text="إلغاء السند"
                                      IconCssClass="fa-solid fa-ban"
                                      Variant="ButtonVariant.Danger"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanCancelActiveVoucher)"
                                      OnClick="@(() => ChangeReceiptStatusAsync(ReceiptVoucherStatus.Cancelled))" />
                        }
                        else if (receipt.Status == ReceiptVoucherStatus.Approved)
                        {
                            <UiButton Text="ترحيل"
                                      IconCssClass="fa-solid fa-check-double"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanPostActiveVoucher)"
                                      OnClick="@(() => ChangeReceiptStatusAsync(ReceiptVoucherStatus.Posted))" />

                            <UiButton Text="إلغاء السند"
                                      IconCssClass="fa-solid fa-ban"
                                      Variant="ButtonVariant.Danger"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanCancelActiveVoucher)"
                                      OnClick="@(() => ChangeReceiptStatusAsync(ReceiptVoucherStatus.Cancelled))" />
                        }
                        else if (receipt.Status == ReceiptVoucherStatus.Posted && receipt.JournalEntryId.HasValue)
                        {
                            <UiButton Text="عرض القيد"
                                      IconCssClass="fa-solid fa-book-open"
                                      Variant="ButtonVariant.Secondary"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanViewGeneratedJournal)"
                                      OnClick="ViewGeneratedJournalAsync" />
                        }
                    }
                    else if (activeTab.EntityType == AccountingEntityType.PaymentVouchers &&
                    activeTab.Model is PaymentVoucherEditor.FormModel payment)
                    {
                        @if (payment.Status == PaymentVoucherStatus.Draft)
                        {
                            <UiButton Text="اعتماد"
                                      IconCssClass="fa-solid fa-circle-check"
                                      Variant="ButtonVariant.Secondary"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanApproveActiveVoucher)"
                                      OnClick="@(() => ChangePaymentStatusAsync(PaymentVoucherStatus.Approved))" />

                            <UiButton Text="إلغاء السند"
                                      IconCssClass="fa-solid fa-ban"
                                      Variant="ButtonVariant.Danger"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanCancelActiveVoucher)"
                                      OnClick="@(() => ChangePaymentStatusAsync(PaymentVoucherStatus.Cancelled))" />
                        }
                        else if (payment.Status == PaymentVoucherStatus.Approved)
                        {
                            <UiButton Text="ترحيل"
                                      IconCssClass="fa-solid fa-check-double"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanPostActiveVoucher)"
                                      OnClick="@(() => ChangePaymentStatusAsync(PaymentVoucherStatus.Posted))" />

                            <UiButton Text="إلغاء السند"
                                      IconCssClass="fa-solid fa-ban"
                                      Variant="ButtonVariant.Danger"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanCancelActiveVoucher)"
                                      OnClick="@(() => ChangePaymentStatusAsync(PaymentVoucherStatus.Cancelled))" />
                        }
                        else if (payment.Status == PaymentVoucherStatus.Posted && payment.JournalEntryId.HasValue)
                        {
                            <UiButton Text="عرض القيد"
                                      IconCssClass="fa-solid fa-book-open"
                                      Variant="ButtonVariant.Secondary"
                                      Size="ControlSize.Small"
                                      Disabled="@(!CanViewGeneratedJournal)"
                                      OnClick="ViewGeneratedJournalAsync" />
                        }
                    }
                    else if (activeTab.EntityType == AccountingEntityType.Expenses &&
                    activeTab.Model is ExpenseEditor.FormModel expense)
                    {
                        @if (expense.Status == ExpenseStatus.Draft)
                        {
                            <UiButton Text="اعتماد"
                                      IconCssClass="fa-solid fa-circle-check"
                                      Variant="ButtonVariant.Secondary"
                                      Size="ControlSize.Small"
                                      OnClick="@(() => ChangeExpenseStatusAsync(ExpenseStatus.Approved))" />
                        }
                        else if (expense.Status == ExpenseStatus.Approved)
                        {
                            <UiButton Text="ترحيل"
                                      IconCssClass="fa-solid fa-check-double"
                                      Size="ControlSize.Small"
                                      OnClick="@(() => ChangeExpenseStatusAsync(ExpenseStatus.Posted))" />
                        }
                    }
                }

                <UiButton Text="إغلاق"
                          IconCssClass="fa-solid fa-xmark"
                          Variant="ButtonVariant.Ghost"
                          Size="ControlSize.Small"
                          Disabled="@(!CanCloseActive)"
                          OnClick="CloseActiveTabAsync" />
            }

        </UiWorkspaceActionBar>

    </Actions>

    <Tabs>

        @if (Section.HasValue)
        {
            <UiApplicationTabStrip Tabs="@WorkspaceTabs"
                                   AriaLabel="@CurrentTabsAriaLabel"
                                   EnableContextMenu="true"
                                   OnSelect="SelectTabAsync"
                                   OnClose="CloseTabByIdAsync"
                                   OnCloseOthers="CloseOtherTabsAsync"
                                   OnCloseAll="CloseAllTabsAsync" />
        }

    </Tabs>

    <Body>

        @if (Section is null)
        {
            <UiAccountingFormSection Title="المحاسبة المالية"
                                     Subtitle="إدارة الدليل المحاسبي والقيود والتحصيل والصرف والصندوق والمصروفات من نقطة واحدة"
                                     IconCssClass="fa-solid fa-scale-balanced">

                <UiAccountingFormGrid Columns="3">

                    <UiAccountingHubTile Title="شجرة الحسابات"
                                         Description="بناء وتصنيف حسابات الأستاذ العام"
                                         Href="/accounting/accounts"
                                         IconCssClass="fa-solid fa-folder-tree" />

                    <UiAccountingHubTile Title="السنوات والفترات"
                                         Description="إدارة السنة المالية وفترات الترحيل والإقفال"
                                         Href="/accounting/fiscal-years"
                                         IconCssClass="fa-solid fa-calendar-days" />

                    <UiAccountingHubTile Title="القيود اليومية"
                                         Description="إنشاء واعتماد وترحيل وعكس القيود المحاسبية"
                                         Href="/accounting/journals"
                                         IconCssClass="fa-solid fa-book-journal-whills" />

                    <UiAccountingHubTile Title="ملفات الترحيل"
                                         Description="ربط أدوار العمليات بالحسابات"
                                         Href="/accounting/posting-profiles"
                                         IconCssClass="fa-solid fa-sliders" />

                    <UiAccountingHubTile Title="العملاء"
                                         Description="إدارة العملاء وربط كل عميل بحسابه المحاسبي تلقائيًا"
                                         Href="/accounting/customers"
                                         IconCssClass="fa-solid fa-users" />

                    <UiAccountingHubTile Title="الموردون"
                                         Description="إدارة الموردين وربط كل مورد بحسابه المحاسبي تلقائيًا"
                                         Href="/accounting/suppliers"
                                         IconCssClass="fa-solid fa-truck-field" />

                    <UiAccountingHubTile Title="سندات القبض"
                                         Description="إدارة المقبوضات وربطها بالقيود"
                                         Href="/accounting/receipt-vouchers"
                                         IconCssClass="fa-solid fa-money-bill-trend-up" />

                    <UiAccountingHubTile Title="سندات الصرف"
                                         Description="إدارة المدفوعات وربطها بالقيود"
                                         Href="/accounting/payment-vouchers"
                                         IconCssClass="fa-solid fa-money-bill-transfer" />

                    <UiAccountingHubTile Title="الصناديق"
                                         Description="تعريف الصناديق والخزائن وربطها بحسابات الأستاذ العام"
                                         Href="/accounting/cash-accounts"
                                         IconCssClass="fa-solid fa-vault" />

                    <UiAccountingHubTile Title="الحسابات البنكية"
                                         Description="تعريف الحسابات البنكية وربطها بحسابات الأستاذ العام"
                                         Href="/accounting/bank-accounts"
                                         IconCssClass="fa-solid fa-building-columns" />

                    <UiAccountingHubTile Title="ورديات الصندوق"
                                         Description="فتح وإغلاق واعتماد ورديات النقدية"
                                         Href="/accounting/cash-shifts"
                                         IconCssClass="fa-solid fa-cash-register" />

                    <UiAccountingHubTile Title="المصروفات"
                                         Description="المصروفات وأنواعها وحساباتها"
                                         Href="/accounting/expenses"
                                         IconCssClass="fa-solid fa-receipt" />

                    <UiAccountingHubTile Title="مراكز التكلفة"
                                         Description="هيكل اختياري لتوزيع وتحليل التكلفة"
                                         Href="/accounting/cost-centers"
                                         IconCssClass="fa-solid fa-network-wired" />

                </UiAccountingFormGrid>

            </UiAccountingFormSection>
        }
        else if (Section == AccountingEntityType.Accounts)
        {
            <UiAccountingSplitView>

                <Tree>

                    <UiAccountingFormSection Title="شجرة الحسابات"
                                             IconCssClass="fa-solid fa-folder-tree"
                                             AdditionalCssClass="ui-acc-account-tree-panel">

                        <div class="ui-acc-account-tree-toolbar ui-acc-account-tree-toolbar--inline">
                            <UiSearchInput Value="@_accountTreeSearch"
                                           ValueChanged="SetAccountTreeSearch"
                                           Placeholder="البحث في الحسابات..."
                                           AriaLabel="البحث في شجرة الحسابات"
                                           DebounceMilliseconds="0" />

                            <UiButton Text="@AccountTreeToggleText"
                                      IconCssClass="@AccountTreeToggleIcon"
                                      Variant="ButtonVariant.Secondary"
                                      Size="ControlSize.Small"
                                      OnClick="ToggleAccountTreeExpansionAsync" />
                        </div>

                        <UiAccountTreeView Nodes="@FilteredAccountTreeNodes"
                                           SelectedAccountId="@SelectedAccountId"
                                           AutoExpandAll="@(!string.IsNullOrWhiteSpace(_accountTreeSearch))"
                                           ExpandAllRequestKey="@_accountTreeExpandAllKey"
                                           CollapseAllRequestKey="@_accountTreeCollapseAllKey"
                                           OnSelect="OpenAccountFromTreeAsync" />

                    </UiAccountingFormSection>

                </Tree>

                <Detail>

                    @if (activeTab is { IsListTab: false } &&
                                    activeTab.Model is AccountEditor.FormModel accountModel)
                    {
                        <UiAccountOverviewHeader Title="@(activeTab.IsNew ? "حساب جديد" : accountModel.NameAr)"
                                                 Code="@(string.IsNullOrWhiteSpace(accountModel.Code) ? "—" : accountModel.Code)"
                                                 EnglishName="@accountModel.NameEn"
                                                 IsActive="@accountModel.IsActive"
                                                 IsNew="@activeTab.IsNew"
                                                 Breadcrumb="@GetAccountBreadcrumb(accountModel)"
                                                 BalanceText="@AccountBalanceText"
                                                 PeriodDebitText="@AccountPeriodDebitText"
                                                 PeriodCreditText="@AccountPeriodCreditText"
                                                 LastMovementText="@AccountLastMovementText"
                                                 CurrencyText="@_accountOverview.CurrencyText"
                                                 PeriodCaption="@_accountOverview.PeriodCaption"
                                                 MetricsLoading="@_accountOverviewLoading">
                            <Actions>
                                <div class="ui-acc-account-overview-actions">
                                    <UiButton Text="حساب فرعي جديد"
                                              IconCssClass="fa-solid fa-folder-plus"
                                              Variant="ButtonVariant.Secondary"
                                              Size="ControlSize.Small"
                                              Disabled="@(activeTab.IsNew)"
                                              OnClick="OpenChildAccountAsync" />
                                    @if (activeTab.EntityId is Guid accountId)
                                    {
                                        <a class="ui-acc-account-detail-actions__link"
                                           href="@($"/accounting/journal-report?accountId={accountId:D}")"
                                           title="عرض قيود هذا الحساب فقط">
                                            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                                            <span>قيود الحساب</span>
                                        </a>
                                    }
                                </div>
                            </Actions>
                        </UiAccountOverviewHeader>

                        <AccountEditor Model="@accountModel"
                                       IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                       IsNew="@activeTab.IsNew"
                                       ParentAccountLookupItem="@GetAccountLookup(accountModel.ParentAccountId)"
                                       AccountSearchAsync="SearchAccountsAsync"
                                       AccountLevelResolver="ResolveAccountLevel"
                                       OnModelChanged="MarkActiveDirty" />
                    }
                    else if (_isLoading)
                    {
                        <UiAccountingEmptyState Title="جاري تحميل شجرة الحسابات"
                                                Description="يتم الآن جلب الحسابات وإعداد الشجرة المحاسبية..."
                                                IconCssClass="fa-solid fa-circle-notch fa-spin" />
                    }
                    else
                    {
                        <UiAccountingEmptyState Title="اختر حساباً من الشجرة"
                                                Description="اختر حساباً لعرض بياناته في اللوحة، أو استخدم زر جديد لإنشاء حساب."
                                                IconCssClass="fa-solid fa-hand-pointer" />
                    }

                </Detail>

            </UiAccountingSplitView>
        }
        else if (activeTab is { IsListTab: false })
        {
            @switch (activeTab.EntityType)
            {
                case AccountingEntityType.Accounts
                    when activeTab.Model is AccountEditor.FormModel model:

                    <AccountEditor Model="@model"
                                   IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                   IsNew="@activeTab.IsNew"
                                   ParentAccountLookupItem="@GetAccountLookup(model.ParentAccountId)"
                                   AccountSearchAsync="SearchAccountsAsync"
                                   OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.FiscalYears
                    when activeTab.Model is FiscalYearEditor.FormModel model:

                    <FiscalYearEditor Model="@model"
                                      IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                      IsNew="@activeTab.IsNew"
                                      OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.FiscalPeriods
                    when activeTab.Model is FiscalPeriodEditor.FormModel model:

                    <FiscalPeriodEditor Model="@model"
                                        IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                        IsNew="@activeTab.IsNew"
                                        FiscalYearLookupItem="@GetFiscalYearLookup(model.FiscalYearId == Guid.Empty ? null : model.FiscalYearId)"
                                        FiscalYearSearchAsync="SearchFiscalYearsAsync"
                                        OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.Journals
                    when activeTab.Model is JournalEntryEditor.FormModel model:

                    <JournalEntryEditor Model="@model"
                                        IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                        IsNew="@activeTab.IsNew"
                                        FiscalPeriodLookupItem="@GetFiscalPeriodLookup(model.FiscalPeriodId)"
                                        FiscalPeriodSearchAsync="SearchFiscalPeriodsAsync"
                                        AccountSearchAsync="SearchManualJournalAccountsAsync"
                                        CostCenterSearchAsync="SearchCostCentersAsync"
                                        CustomerSearchAsync="SearchCustomersAsync"
                                        SupplierSearchAsync="SearchSuppliersAsync"
                                        EmployeeSearchAsync="SearchEmployeeAccountsAsync"
                                        CurrencySearchAsync="SearchCurrenciesAsync"
                                        EffectiveRateAsync="ResolveEffectiveRatePreviewAsync"
                                        ReserveNumberForPostingDateAsync="ReserveJournalNumberForDateAsync"
                                        OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.PostingProfiles
                    when activeTab.Model is PostingProfileEditor.FormModel model:

                    <PostingProfileEditor Model="@model"
                                          IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                          IsNew="@activeTab.IsNew"
                                          AccountSearchAsync="SearchPostingProfileAccountsAsync"
                                          OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.CostCenters
                    when activeTab.Model is CostCenterEditor.FormModel model:

                    <CostCenterEditor Model="@model"
                                      IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                      IsNew="@activeTab.IsNew"
                                      ParentCostCenterLookupItem="@GetCostCenterLookup(model.ParentCostCenterId)"
                                      ParentPath="@GetCostCenterParentPath(model.ParentCostCenterId)"
                                      CostCenterSearchAsync="SearchCostCentersAsync"
                                      OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.ReceiptVouchers
                    when activeTab.Model is ReceiptVoucherEditor.FormModel model:

                    <ReceiptVoucherEditor Model="@model"
                                          IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                          IsNew="@activeTab.IsNew"
                                          CustomerSearchAsync="SearchCustomersAsync"
                                          SupplierSearchAsync="SearchSuppliersAsync"
                                          EmployeeSearchAsync="SearchEmployeeAccountsAsync"
                                          CashAccountSearchAsync="SearchCashAccountsByCurrencyAsync"
                                          BankAccountSearchAsync="SearchBankAccountsByCurrencyAsync"
                                          CurrencySearchAsync="SearchCurrenciesAsync"
                                          CounterpartyAccountSearchAsync="SearchOtherCounterpartyAccountsAsync"
                                          SettlementAccountSearchAsync="SearchOtherSettlementAccountsAsync"
                                          EffectiveRateAsync="ResolveEffectiveRatePreviewAsync"
                                          OnNewVoucherYearChanged="RefreshVoucherNumberAfterYearChangeAsync"
                                          OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.PaymentVouchers
                    when activeTab.Model is PaymentVoucherEditor.FormModel model:

                    <PaymentVoucherEditor Model="@model"
                                          IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                          IsNew="@activeTab.IsNew"
                                          CustomerSearchAsync="SearchCustomersAsync"
                                          SupplierSearchAsync="SearchSuppliersAsync"
                                          EmployeeSearchAsync="SearchEmployeeAccountsAsync"
                                          CashAccountSearchAsync="SearchCashAccountsByCurrencyAsync"
                                          BankAccountSearchAsync="SearchBankAccountsByCurrencyAsync"
                                          CurrencySearchAsync="SearchCurrenciesAsync"
                                          CounterpartyAccountSearchAsync="SearchOtherCounterpartyAccountsAsync"
                                          SettlementAccountSearchAsync="SearchOtherSettlementAccountsAsync"
                                          EffectiveRateAsync="ResolveEffectiveRatePreviewAsync"
                                          OnNewVoucherYearChanged="RefreshVoucherNumberAfterYearChangeAsync"
                                          OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.PaymentAllocations
                    when activeTab.Model is PaymentAllocationEditor.FormModel model:

                    <PaymentAllocationEditor Model="@model"
                                             IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                             IsNew="@activeTab.IsNew"
                                             AllocationId="@activeTab.EntityId"
                                             OnAllocationsChanged="RefreshAllocationListAfterChangeAsync"
                                             OnOpenAllocation="OpenExistingAllocationAsync"
                                             OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.CashAccounts
                    when activeTab.Model is CashAccountEditor.FormModel model:

                    <CashAccountEditor Model="@model"
                                       IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                       IsNew="@activeTab.IsNew"
                                       AccountLookupItem="@GetAccountLookup(model.AccountId)"
                                       CurrencyLookupItem="@GetCurrencyLookup(model.CurrencyId)"
                                       CurrencySearchAsync="SearchCurrenciesAsync"
                                       OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.BankAccounts
                    when activeTab.Model is BankAccountEditor.FormModel model:

                    <BankAccountEditor Model="@model"
                                       IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                       IsNew="@activeTab.IsNew"
                                       AccountLookupItem="@GetAccountLookup(model.AccountId)"
                                       CurrencyLookupItem="@GetCurrencyLookup(model.CurrencyId)"
                                       CurrencySearchAsync="SearchCurrenciesAsync"
                                       OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.CashShifts
                    when activeTab.Model is CashShiftEditor.FormModel model:

                    <CashShiftEditor Model="@model"
                                     IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                     IsNew="@activeTab.IsNew"
                                     CashAccountLookupItem="@GetCashAccountLookup(model.CashAccountId)"
                                     CashAccountSearchAsync="SearchCashAccountsAsync"
                                     CurrencyLabel="@GetShiftCurrencyLabel(model.CashAccountId)"
                                     CurrencyDecimalPlaces="@GetShiftCurrencyDecimals(model.CashAccountId)"
                                     OnModelChanged="OnCashShiftModelChangedAsync" />

                    break;

                case AccountingEntityType.Expenses
                    when activeTab.Model is ExpenseEditor.FormModel model:

                    <ExpenseEditor Model="@model"
                                   IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                   IsNew="@activeTab.IsNew"
                                   ExpenseTypeLookupItem="@GetExpenseTypeLookup(model.ExpenseTypeId)"
                                   ExpenseAccountLookupItem="@GetAccountLookup(model.ExpenseAccountId, AccountingAccountEligibilityContext.ExpenseAccount)"
                                   CashAccountLookupItem="@GetCashAccountLookup(model.CashAccountId)"
                                   BankAccountLookupItem="@GetBankAccountLookup(model.BankAccountId)"
                                   ExpenseTypeSearchAsync="SearchExpenseTypesAsync"
                                   AccountSearchAsync="SearchExpenseAccountsAsync"
                                   CashAccountSearchAsync="SearchCashAccountsAsync"
                                   BankAccountSearchAsync="SearchBankAccountsAsync"
                                   OnModelChanged="MarkActiveDirty" />

                    break;

                case AccountingEntityType.ExpenseTypes
                    when activeTab.Model is ExpenseTypeEditor.FormModel model:

                    <ExpenseTypeEditor Model="@model"
                                       IsEditable="@(activeTab.IsNew || activeTab.IsEditMode)"
                                       IsNew="@activeTab.IsNew"
                                       AccountLookupItem="@GetAccountLookup(model.DefaultExpenseAccountId, AccountingAccountEligibilityContext.ExpenseAccount)"
                                       AccountSearchAsync="SearchExpenseAccountsAsync"
                                       OnModelChanged="MarkActiveDirty" />

                    break;

                default:

                    <UiAccountingEmptyState Title="تعذر عرض السجل"
                                            Description="نوع السجل المفتوح غير مدعوم في واجهة المحاسبة."
                                            IconCssClass="fa-solid fa-triangle-exclamation" />

                    break;
            }
        }
        else if (_isLoading)
        {
            <UiAccountingEmptyState Title="جاري تحميل البيانات"
                                    Description="يتم الآن جلب أحدث البيانات من النظام..."
                                    IconCssClass="fa-solid fa-circle-notch fa-spin" />
        }
        else
        {
            @if (Section == AccountingEntityType.CashAccounts)
            {
                <section class="oas-cashbank-directory" aria-label="قائمة الصناديق والخزائن">
                    <div class="oas-cashbank-directory__heading">
                        <div><h2><i class="fa-solid fa-vault" aria-hidden="true"></i> الصناديق والخزائن</h2><p>إدارة الصناديق وعملاتها وربطها بحسابات الأستاذ العام</p></div>
                        <span class="oas-cashbank-directory__page-label">الإجمالي يشمل جميع النتائج المطابقة؛ تفصيل النشاط يخص الصفحة الحالية</span>
                    </div>
                    <div class="oas-cashbank-kpis">
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-vault"></i><div><span>إجمالي الصناديق المطابقة للبحث</span><strong>@_cashAccountsPage.TotalCount</strong></div></div>
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-circle-check"></i><div><span>نشط في الصفحة</span><strong>@_cashAccountsPage.Items.Count(x => x.IsActive)</strong></div></div>
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-circle-pause"></i><div><span>غير نشط في الصفحة</span><strong>@_cashAccountsPage.Items.Count(x => !x.IsActive)</strong></div></div>
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-star"></i><div><span>افتراضي في الصفحة</span><strong>@_cashAccountsPage.Items.Count(x => x.IsDefault)</strong></div></div>
                    </div>
                    <div class="oas-cashbank-directory__filter">
                        <label for="oas-cash-state">الحالة</label>
                        <select id="oas-cash-state" value="@CashBankStatusFilter" @onchange="OnCashBankStatusFilterChanged">
                            <option value="">الكل</option><option value="active">نشط</option><option value="inactive">غير نشط</option>
                        </select>
                    </div>
                    <UiAccountingRecordList Items="@BuildCashAccountItems()"
                                            FinancialStyle="true"
                                            EmptyTitle="لا توجد صناديق مطابقة للبحث"
                                            OnOpen="OpenCashAccountRecord" />
                    <UiPagination PageNumber="@_cashAccountsPage.PageNumber" TotalPages="@_cashAccountsPage.TotalPages" TotalCount="@_cashAccountsPage.TotalCount"
                                  OnPrevious="@(() => ChangePageAsync(AccountingEntityType.CashAccounts, -1))" OnNext="@(() => ChangePageAsync(AccountingEntityType.CashAccounts, 1))" />
                </section>
            }
            else if (Section == AccountingEntityType.BankAccounts)
            {
                <section class="oas-cashbank-directory" aria-label="قائمة الحسابات البنكية">
                    <div class="oas-cashbank-directory__heading">
                        <div><h2><i class="fa-solid fa-building-columns" aria-hidden="true"></i> الحسابات البنكية</h2><p>الحسابات البنكية وربطها المحاسبي وبياناتها الحقيقية من النظام</p></div>
                        <span class="oas-cashbank-directory__page-label">لا تعرض القائمة رصيدًا غير متوفر من مصدر موثوق</span>
                    </div>
                    <div class="oas-cashbank-kpis">
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-building-columns"></i><div><span>إجمالي الحسابات المطابقة للبحث</span><strong>@_bankAccountsPage.TotalCount</strong></div></div>
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-circle-check"></i><div><span>نشط في الصفحة</span><strong>@_bankAccountsPage.Items.Count(x => x.IsActive)</strong></div></div>
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-circle-pause"></i><div><span>غير نشط في الصفحة</span><strong>@_bankAccountsPage.Items.Count(x => !x.IsActive)</strong></div></div>
                    </div>
                    <div class="oas-cashbank-directory__filter"><label for="oas-bank-state">الحالة</label>
                        <select id="oas-bank-state" value="@CashBankStatusFilter" @onchange="OnCashBankStatusFilterChanged">
                            <option value="">الكل</option><option value="active">نشط</option><option value="inactive">غير نشط</option>
                        </select>
                    </div>
                    <UiAccountingRecordList Items="@BuildBankAccountItems()"
                                            FinancialStyle="true"
                                            EmptyTitle="لا توجد حسابات بنكية مطابقة"
                                            OnOpen="OpenBankAccountRecord" />
                    <UiPagination PageNumber="@_bankAccountsPage.PageNumber" TotalPages="@_bankAccountsPage.TotalPages" TotalCount="@_bankAccountsPage.TotalCount"
                                  OnPrevious="@(() => ChangePageAsync(AccountingEntityType.BankAccounts, -1))" OnNext="@(() => ChangePageAsync(AccountingEntityType.BankAccounts, 1))" />
                </section>
            }
            else if (Section == AccountingEntityType.CashShifts)
            {
                <section class="oas-cashbank-directory" aria-label="قائمة ورديات الصندوق">
                    <div class="oas-cashbank-directory__heading"><div><h2><i class="fa-solid fa-cash-register"></i> ورديات الصندوق</h2><p>سجل الافتتاح والإغلاق والجرد، مع إبراز حالة كل وردية</p></div>
                        <span class="oas-cashbank-directory__page-label">الرصيد المتوقع وفرق الجرد مبدئيان حتى استكمال مطابقة الحركات</span>
                    </div>
                    <div class="oas-cashbank-kpis">
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-list-check"></i><div><span>إجمالي الورديات المطابقة للبحث</span><strong>@_cashShiftsPage.TotalCount</strong></div></div>
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-door-open"></i><div><span>مفتوحة في الصفحة</span><strong>@_cashShiftsPage.Items.Count(x => x.Status == CashShiftStatus.Open)</strong></div></div>
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-lock"></i><div><span>مغلقة في الصفحة</span><strong>@_cashShiftsPage.Items.Count(x => x.Status == CashShiftStatus.Closed)</strong></div></div>
                        <div class="oas-cashbank-kpi"><i class="fa-solid fa-circle-check"></i><div><span>معتمدة في الصفحة</span><strong>@_cashShiftsPage.Items.Count(x => x.Status == CashShiftStatus.Approved)</strong></div></div>
                    </div>
                    <div class="oas-cashbank-directory__filter"><label for="oas-shift-state">الحالة</label>
                        <select id="oas-shift-state" value="@CashBankStatusFilter" @onchange="OnCashBankStatusFilterChanged">
                            <option value="">الكل</option><option value="open">مفتوحة</option><option value="closing">قيد الإغلاق</option><option value="closed">مغلقة</option><option value="approved">معتمدة</option>
                        </select>
                    </div>
                    <UiAccountingRecordList Items="@BuildCashShiftItems()"
                                            FinancialStyle="true"
                                            EmptyTitle="لا توجد ورديات مطابقة للبحث"
                                            OnOpen="OpenCashShiftRecord" />
                    <UiPagination PageNumber="@_cashShiftsPage.PageNumber" TotalPages="@_cashShiftsPage.TotalPages" TotalCount="@_cashShiftsPage.TotalCount"
                                  OnPrevious="@(() => ChangePageAsync(AccountingEntityType.CashShifts, -1))" OnNext="@(() => ChangePageAsync(AccountingEntityType.CashShifts, 1))" />
                </section>
            }
            else if (Section == AccountingEntityType.FiscalYears)
            {
                <div class="oas-fiscal-overview" dir="rtl">
                    <section class="oas-fiscal-overview__years" aria-label="قائمة السنوات المالية">
                        <header class="oas-fiscal-overview__heading">
                            <div>
                                <h2><i class="fa-solid fa-calendar-days" aria-hidden="true"></i> السنوات المالية</h2>
                                <p>اختر السنة لعرض فتراتها، أو افتح سجلها لإدارة البيانات والحالة.</p>
                            </div>
                            <span class="oas-fiscal-overview__total">@_fiscalYearsPage.TotalCount سنة</span>
                        </header>
                        <div class="oas-fiscal-overview__year-list">
                            @if (_fiscalYearsPage.Items.Count == 0)
                            {
                                <UiAccountingEmptyState Title="لا توجد سنوات مالية" Description="أنشئ سنة مالية أولًا، ثم أضف الفترات التابعة لها." />
                            }
                            @foreach (var year in _fiscalYearsPage.Items)
                            {
                                <div class="@(_selectedFiscalYearId == year.Id ? "oas-fiscal-year is-selected" : "oas-fiscal-year")" @key="year.Id">
                                    <button type="button" class="oas-fiscal-year__select"
                                            aria-pressed="@(_selectedFiscalYearId == year.Id)"
                                            title="عرض فترات @year.Name" @onclick="@(() => SelectFiscalYearAsync(year.Id))">
                                        <span class="oas-fiscal-year__icon"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i></span>
                                        <span class="oas-fiscal-year__content">
                                            <strong dir="auto">@year.Code — @year.Name</strong>
                                            <small dir="ltr">@year.StartDate.ToString("yyyy/MM/dd") — @year.EndDate.ToString("yyyy/MM/dd")</small>
                                        </span>
                                        <span class="@($"oas-fiscal-state {FiscalYearState(year.Status)}")">@AccountingArabicPresenter.GetFiscalYearStatusText(year.Status)</span>
                                    </button>
                                    <button type="button" class="oas-fiscal-year__details"
                                            title="فتح بيانات السنة @year.Name" aria-label="فتح بيانات السنة @year.Name"
                                            @onclick="@(() => OpenFiscalYearDetailsAsync(year.Id))">
                                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                        </div>
                        <UiPagination PageNumber="@_fiscalYearsPage.PageNumber"
                                      TotalPages="@_fiscalYearsPage.TotalPages" TotalCount="@_fiscalYearsPage.TotalCount"
                                      OnPrevious="@(() => ChangePageAsync(AccountingEntityType.FiscalYears, -1))"
                                      OnNext="@(() => ChangePageAsync(AccountingEntityType.FiscalYears, 1))" />
                    </section>
                    <section class="oas-fiscal-overview__periods" aria-label="فترات السنة المحددة">
                        <header class="oas-fiscal-overview__heading">
                            <div>
                                <h2><i class="fa-solid fa-calendar-week" aria-hidden="true"></i> الفترات المالية</h2>
                                <p>@(_fiscalYearsPage.Items.FirstOrDefault(x => x.Id == _selectedFiscalYearId)?.Name ?? GetFiscalYearLookup(_selectedFiscalYearId)?.PrimaryText ?? "حدد سنة مالية لعرض فتراتها")</p>
                            </div>
                            <span class="oas-fiscal-overview__total">@_fiscalPeriodsPage.TotalCount فترة</span>
                        </header>
                        @if (_selectedFiscalYearId.HasValue)
                        {
                            <UiAccountingRecordList Items="@BuildFiscalPeriodItems()"
                                                    FinancialStyle="true" EmptyTitle="لا توجد فترات لهذه السنة"
                                                    EmptyDescription="أضف فترة مالية للسنة المحددة أو اختر سنة أخرى."
                                                    OnOpen="OpenSelectedFiscalPeriodAsync" />
                            <UiPagination PageNumber="@_fiscalPeriodsPage.PageNumber"
                                          TotalPages="@_fiscalPeriodsPage.TotalPages" TotalCount="@_fiscalPeriodsPage.TotalCount"
                                          OnPrevious="@(() => ChangePageAsync(AccountingEntityType.FiscalPeriods, -1))"
                                          OnNext="@(() => ChangePageAsync(AccountingEntityType.FiscalPeriods, 1))" />
                        }
                        else
                        {
                            <UiAccountingEmptyState Title="اختر السنة المالية" Description="ستظهر هنا الفترات المالية المرتبطة بالسنة المختارة." />
                        }
                    </section>
                </div>
            }
            else if (Section == AccountingEntityType.Expenses)
            {
                <nav class="oas-expense-directory__views" aria-label="التبديل بين المصروفات وأنواعها">
                    <button type="button" class="@(!_showExpenseTypes ? "is-active" : string.Empty)"
                            aria-pressed="@(!_showExpenseTypes)" @onclick="() => SetExpenseView(false)">
                        <i class="fa-solid fa-receipt" aria-hidden="true"></i> المصروفات
                    </button>
                    <button type="button" class="@(_showExpenseTypes ? "is-active" : string.Empty)"
                            aria-pressed="@(_showExpenseTypes)" @onclick="() => SetExpenseView(true)">
                        <i class="fa-solid fa-tags" aria-hidden="true"></i> أنواع المصروفات
                    </button>
                </nav>
                @if (!_showExpenseTypes)
                {
                <UiAccountingFormSection Title="المصروفات"
                                         Subtitle="المصروفات التشغيلية وحالة اعتمادها وترحيلها"
                                         IconCssClass="fa-solid fa-receipt">

                    <div class="oas-expense-directory__stats">
                        <div><small>المصروفات المطابقة للبحث والفلاتر</small><strong>@_expensesPage.TotalCount.ToString("N0")</strong></div>
                        <div><small>مرحلة في الصفحة الحالية</small><strong>@_expensesPage.Items.Count(x => x.Status == ExpenseStatus.Posted)</strong></div>
                        <div><small>غير مرحلة في الصفحة الحالية</small><strong>@_expensesPage.Items.Count(x => x.Status is ExpenseStatus.Draft or ExpenseStatus.Approved)</strong></div>
                    </div>
                    <div class="oas-financial-directory__filters oas-expense-directory__filters">
                        <label for="expense-status-filter">الحالة</label>
                        <select id="expense-status-filter" value="@_expenseStatusFilter" @onchange="OnExpenseStatusChanged">
                            <option value="">كل الحالات</option>
                            <option value="draft">مسودة</option>
                            <option value="approved">معتمد</option>
                            <option value="posted">مرحّل</option>
                            <option value="cancelled">ملغي</option>
                        </select>
                        <label for="expense-method-filter">طريقة الدفع</label>
                        <select id="expense-method-filter" value="@_expensePaymentFilter" @onchange="OnExpensePaymentChanged">
                            <option value="">جميع الطرق</option>
                            <option value="1">نقدًا</option>
                            <option value="2">بطاقة</option>
                            <option value="3">تحويل بنكي</option>
                            <option value="4">شيك</option>
                            <option value="5">أخرى</option>
                        </select>
                        <label for="expense-from-filter">من تاريخ</label>
                        <input id="expense-from-filter" type="date" value="@ExpenseDateFromText" @onchange="OnExpenseDateFromChanged" />
                        <label for="expense-to-filter">إلى تاريخ</label>
                        <input id="expense-to-filter" type="date" value="@ExpenseDateToText" min="@ExpenseDateFromText" @onchange="OnExpenseDateToChanged" />
                        <div class="oas-expense-directory__type-filter">
                            <UiLookup Label="نوع المصروف" Value='@_expenseTypeFilter?.ToString("D")'
                                      ValueChanged="OnExpenseTypeFilterChanged"
                                      SelectedItem="@GetExpenseTypeLookup(_expenseTypeFilter)"
                                      SearchAsync="SearchExpenseTypesAsync"
                                      Placeholder="جميع الأنواع" UsePopover="true"
                                      MinimumSearchLength="0" DebounceMilliseconds="250" />
                        </div>
                    </div>
                    <UiAccountingRecordList Items="@BuildExpenseItems()"
                                            FinancialStyle="true"
                                            EmptyTitle="لا توجد مصروفات"
                                            OnOpen='@(id => OpenRecordInTab(AccountingEntityType.Expenses, id, "مصروف"))' />

                    <UiPagination PageNumber="@_expensesPage.PageNumber"
                                  TotalPages="@_expensesPage.TotalPages"
                                  TotalCount="@_expensesPage.TotalCount"
                                  OnPrevious="@(() => ChangePageAsync(AccountingEntityType.Expenses, -1))"
                                  OnNext="@(() => ChangePageAsync(AccountingEntityType.Expenses, 1))" />

                </UiAccountingFormSection>
                }
                else
                {
                <UiAccountingFormSection Title="أنواع المصروفات"
                                         Subtitle="الأكواد والتصنيفات والحسابات الافتراضية، مع تصفية النشاط"
                                         IconCssClass="fa-solid fa-tags">

                    <UiWorkspaceActionBar>

                        <UiSpreadsheetActions CanImport="true"
                                              Busy="_spreadsheetBusy"
                                              OnImport="@(() => OpenSpreadsheet(AccountingEntityType.ExpenseTypes))"
                                              OnTemplate="@(() => DownloadSpreadsheet(AccountingEntityType.ExpenseTypes, true))"
                                              OnExport="@(() => DownloadSpreadsheet(AccountingEntityType.ExpenseTypes, false))" />

                    </UiWorkspaceActionBar>

                    <div class="oas-expense-types__toolbar" dir="rtl">
                        <span class="oas-expense-types__count"><i class="fa-solid fa-tags" aria-hidden="true"></i> @_expenseTypesPage.TotalCount.ToString("N0") نوع ضمن نتائج البحث</span>
                        <label for="oas-expense-type-status">الحالة</label>
                        <select id="oas-expense-type-status" value="@_expenseTypeStatusFilter" @onchange="OnExpenseTypeStatusChanged">
                            <option value="">جميع الأنواع</option>
                            <option value="active">الأنواع النشطة</option>
                            <option value="inactive">الأنواع المعطلة</option>
                        </select>
                    </div>
                    <UiAccountingRecordList Items="@BuildExpenseTypeItems()"
                                            FinancialStyle="true"
                                            EmptyTitle="لا توجد أنواع مطابقة"
                                            OnOpen='@(id => OpenRecordInTab(AccountingEntityType.ExpenseTypes, id, "نوع مصروف"))' />

                    <UiPagination PageNumber="@_expenseTypesPage.PageNumber"
                                  TotalPages="@_expenseTypesPage.TotalPages"
                                  TotalCount="@_expenseTypesPage.TotalCount"
                                  OnPrevious="@(() => ChangePageAsync(AccountingEntityType.ExpenseTypes, -1))"
                                  OnNext="@(() => ChangePageAsync(AccountingEntityType.ExpenseTypes, 1))" />

                </UiAccountingFormSection>
                }
            }
            else if (Section is AccountingEntityType.ReceiptVouchers
            or AccountingEntityType.PaymentVouchers)
            {
                <UiAccountingFormSection Title='@(Section == AccountingEntityType.ReceiptVouchers ? "سندات القبض" : "سندات الصرف")'
                                         Subtitle="عرض السندات وفتحها للتفاصيل أو التعديل حسب حالتها"
                                         IconCssClass='@(Section == AccountingEntityType.ReceiptVouchers ? "fa-solid fa-money-bill-trend-up" : "fa-solid fa-money-bill-transfer")'>

                    <VoucherDocumentsList IsReceipt="@(Section == AccountingEntityType.ReceiptVouchers)"
                                          Rows="@BuildVoucherDocumentRows()"
                                          StatusFilter="@CurrentVoucherStatusFilter"
                                          StatusFilterChanged="SetVoucherStatusFilter"
                                          TotalCount="@CurrentTotalCount"
                                          PageNumber="@CurrentPageNumber"
                                          TotalPages="@CurrentTotalPages"
                                          OnOpen="OpenCurrentRecordAsync" />

                    <UiPagination PageNumber="@CurrentPageNumber"
                                  TotalPages="@CurrentTotalPages"
                                  TotalCount="@CurrentTotalCount"
                                  OnPrevious="@(() => ChangePageAsync(CurrentListEntity, -1))"
                                  OnNext="@(() => ChangePageAsync(CurrentListEntity, 1))" />

                </UiAccountingFormSection>

                <UiAccountingFormSection Title="تخصيصات الدفعات"
                                         Subtitle="التخصيصات المرتبطة بهذا النوع من السندات؛ افتح السجل لتعديل المبلغ المخصص"
                                         IconCssClass="fa-solid fa-link"
                                         Collapsible="true">

                    <UiWorkspaceActionBar>

                        <UiSpreadsheetActions Busy="_spreadsheetBusy"
                                              OnExport="@(() => DownloadSpreadsheet(AccountingEntityType.PaymentAllocations, false))" />

                    </UiWorkspaceActionBar>

                    <UiAccountingRecordList Items="@BuildAllocationItems()"
                                            EmptyTitle="لا توجد تخصيصات سداد"
                                            EmptyDescription="أنشئ تخصيصاً من زر تخصيص دفعة عند الحاجة."
                                            OnOpen='@(id => OpenRecordInTab(AccountingEntityType.PaymentAllocations, id, "تخصيص سداد"))' />

                    <UiPagination PageNumber="@_allocationsPage.PageNumber"
                                  TotalPages="@_allocationsPage.TotalPages"
                                  TotalCount="@_allocationsPage.TotalCount"
                                  OnPrevious="@(() => ChangeAllocationPageAsync(-1))"
                                  OnNext="@(() => ChangeAllocationPageAsync(1))" />

                </UiAccountingFormSection>
            }
            else if (Section == AccountingEntityType.CostCenters)
            {
                <section class="oas-cost-tree-panel" aria-label="شجرة مراكز التكلفة" dir="rtl">
                    <header class="oas-fiscal-overview__heading">
                        <div>
                            <h2><i class="fa-solid fa-sitemap" aria-hidden="true"></i> شجرة مراكز التكلفة</h2>
                            <p>مراكز رئيسية وفرعية، مع إمكانية البحث في كامل الشجرة وفتح التفاصيل.</p>
                        </div>
                        <span class="oas-fiscal-overview__total">@_allCostCenters.Count مركز</span>
                    </header>
                    <div class="oas-cost-tree__toolbar">
                        <button type="button" @onclick="ToggleAllCostCentersAsync"><i class="fa-solid fa-list-tree" aria-hidden="true"></i> @(AllCostCentersExpanded ? "طي الكل" : "توسيع الكل")</button>
                        <label for="oas-cost-center-status">الحالة</label>
                        <select id="oas-cost-center-status" value="@_costCenterStatusFilter" @onchange="OnCostCenterStatusChanged">
                            <option value="">الكل</option><option value="active">نشط</option><option value="inactive">معطل</option>
                        </select>
                    </div>
                    <div class="oas-cost-tree" role="tree" aria-label="مراكز التكلفة">
                        @foreach (var node in BuildCostCenterTreeRows())
                        {
                            <div @key="node.Center.Id" class="oas-cost-tree__node" role="treeitem"
                                 aria-level="@(node.Depth + 1)"
                                 style="@CostCenterIndentStyle(node.Depth)">
                                <button type="button" class="oas-cost-tree__toggle"
                                        aria-label="@(node.HasChildren ? (node.IsExpanded ? "طي فروع " : "توسيع فروع ") + node.Center.NameAr : "مركز بدون فروع")"
                                        aria-expanded="@(node.HasChildren && node.IsExpanded)"
                                        disabled="@(!node.HasChildren)"
                                        @onclick="@(() => ToggleCostCenterTreeAsync(node.Center.Id))">
                                    <i class="@(node.HasChildren ? (node.IsExpanded ? "fa-solid fa-chevron-down" : "fa-solid fa-chevron-left") : "fa-regular fa-circle")" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="oas-cost-tree__record"
                                        @onclick="@(() => OpenRecordInTab(AccountingEntityType.CostCenters, node.Center.Id, "مركز تكلفة"))">
                                    <span class="oas-cost-tree__icon"><i class="fa-solid fa-folder-tree" aria-hidden="true"></i></span>
                                    <span class="oas-cost-tree__content">
                                        <strong dir="auto">@node.Center.Code — @node.Center.NameAr</strong>
                                        <small>@(node.Center.ParentCostCenterId.HasValue ? "يتبع: " + (GetCostCenterLookup(node.Center.ParentCostCenterId)?.PrimaryText ?? "المركز الأب") : "مركز رئيسي")</small>
                                    </span>
                                    <span class="@(node.Center.IsActive ? "oas-fiscal-state active" : "oas-fiscal-state inactive")">@(node.Center.IsActive ? "نشط" : "معطل")</span>
                                    <i class="fa-solid fa-chevron-left oas-cost-tree__open" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                        @if (BuildCostCenterTreeRows().Count == 0)
                        {
                            <UiAccountingEmptyState Title="لا توجد مراكز مطابقة" Description="غيّر البحث أو فلتر الحالة أو أضف مركزًا جديدًا." />
                        }
                    </div>
                </section>
            }
            else if (Section == AccountingEntityType.Accounts)
            {
                <UiAccountingSplitView>

                    <Tree>

                        <UiAccountingFormSection Title="شجرة الحسابات"
                                                 IconCssClass="fa-solid fa-folder-tree"
                                                 AdditionalCssClass="ui-acc-account-tree-panel">

                            <UiSearchInput Value="@_accountTreeSearch"
                                           ValueChanged="SetAccountTreeSearch"
                                           Placeholder="البحث في الحسابات..."
                                           AriaLabel="البحث في شجرة الحسابات"
                                           DebounceMilliseconds="0" />

                            <UiAccountTreeView Nodes="@FilteredAccountTreeNodes"
                                               SelectedAccountId="@SelectedAccountId"
                                                   OnSelect="OpenAccountFromTreeAsync" />

                        </UiAccountingFormSection>

                    </Tree>

                    <Detail>

                        <UiAccountingEmptyState Title="اختر حساباً أو أنشئ حساباً جديداً"
                                                Description="اختر حساباً من الشجرة لعرض بياناته أو استخدم زر جديد."
                                                IconCssClass="fa-solid fa-file-circle-plus" />

                    </Detail>

                </UiAccountingSplitView>
            }
            else
            {
                @if (CurrentListEntity == AccountingEntityType.PostingProfiles)
                {
                    <div class="oas-posting-stats" aria-label="مؤشرات ملفات الترحيل" dir="rtl">
                        <div><span>إجمالي الملفات</span><strong>@(_postingProfileTotalCount?.ToString("N0") ?? "—")</strong></div>
                        <div><span>الملفات النشطة</span><strong>@(_postingProfileActiveCount?.ToString("N0") ?? "—")</strong></div>
                        <div><span>الملفات المعطلة</span><strong>@(_postingProfileInactiveCount?.ToString("N0") ?? "—")</strong></div>
                    </div>
                    <div class="oas-posting-filters" dir="rtl" aria-label="مرشحات ملفات الترحيل">
                        <label>الوحدة
                            <select value="@_postingProfileModuleFilter" @onchange="OnPostingModuleFilterChanged">
                                <option value="">كل الوحدات</option>
                                @foreach (var option in PostingProfileUiCatalog.Modules)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                        </label>
                        <label>نوع المستند
                            <select value="@_postingProfileDocumentFilter" @onchange="OnPostingDocumentFilterChanged">
                                <option value="">كل المستندات</option>
                                @foreach (var option in PostingProfileUiCatalog.DocumentOptions(_postingProfileModuleFilter))
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                        </label>
                        <label>الحالة
                            <select value="@_postingProfileStatusFilter" @onchange="OnPostingStatusFilterChanged">
                                <option value="">الكل</option>
                                <option value="active">نشط</option>
                                <option value="inactive">معطل</option>
                            </select>
                        </label>
                    </div>
                }
                @if (CurrentListEntity == AccountingEntityType.Journals && !string.IsNullOrWhiteSpace(CurrentJournalStatusFilter))
                {
                    <div class="oas-journal-filter-indicator" role="status">
                        <span>مرشح القيود النشط: @JournalFilterText(CurrentJournalStatusFilter)</span>
                        <a href="/accounting/journals" class="oas-journal-filter-indicator__clear">عرض كل القيود</a>
                    </div>
                }
                @if (CurrentListEntity == AccountingEntityType.Journals)
                {
                    <JournalDocumentsList Rows="@_journalsPage.Items"
                                          TotalCount="@_journalsPage.TotalCount"
                                          StatusFilter="@CurrentJournalStatusFilter"
                                          StatusFilterChanged="ChangeJournalStatusFilterAsync"
                                          OnOpen="OpenCurrentRecordAsync" />
                }
                else
                {
                    <UiAccountingRecordList Items="@CurrentRecordItems"
                                            FinancialStyle="@(CurrentListEntity == AccountingEntityType.PostingProfiles)"
                                            EmptyTitle="@CurrentEmptyTitle"
                                            EmptyDescription="@CurrentEmptyDescription"
                                            EmptyIconCssClass="@CurrentEmptyIcon"
                                            OnOpen="OpenCurrentRecordAsync" />
                }
                @* Pagination remains server-side and preserves the active status filter. *@
                <UiPagination PageNumber="@CurrentPageNumber"
                              TotalPages="@CurrentTotalPages"
                              TotalCount="@CurrentTotalCount"
                              OnPrevious="@(() => ChangePageAsync(CurrentListEntity, -1))"
                              OnNext="@(() => ChangePageAsync(CurrentListEntity, 1))" />
            }
        }

    </Body>

</UiAccountingWorkspace>

@if (_spreadsheetOpen)
{
    <UiSpreadsheetImport @key="_spreadsheetImportSession"
                         Title="@SpreadsheetTitle"
                         Busy="_spreadsheetBusy"
                         Preview="SpreadsheetUiPreview"
                         OnValidate="PreviewSpreadsheet"
                         OnConfirm="ConfirmSpreadsheet"
                         OnClear="ClearSpreadsheetFile"
                         OnClose="CloseSpreadsheet" />
}