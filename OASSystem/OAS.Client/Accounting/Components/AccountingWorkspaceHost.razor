    private RenderFragment RenderAccountsList() => __builder =>
    {
        <div class="ui-acc-metrics">
            <UiAccountingMetricTile Label="إجمالي الحسابات" Value="@_accountsPage.TotalCount.ToString()" IconCssClass="fa-solid fa-calculator" />
            <UiAccountingMetricTile Label="حسابات الترحيل" Value="@(_accountsPage.Items?.Count(x => x.IsPostingAccount).ToString() ?? "0")" IconCssClass="fa-solid fa-check" Variant="UiAccountingMetricTile.MetricVariant.Debit" />
            <UiAccountingMetricTile Label="حسابات المراقبة" Value="@(_accountsPage.Items?.Count(x => x.IsControlAccount).ToString() ?? "0")" IconCssClass="fa-solid fa-shield" Variant="UiAccountingMetricTile.MetricVariant.Balance" />
