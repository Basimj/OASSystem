                </div>
            }
        }
    };

    private RenderFragment RenderJournalsList() => __builder =>
    {
        <div class="ui-acc-metrics">
            <UiAccountingMetricTile Label="إجمالي القيود" Value="@_journalsPage.TotalCount.ToString()" IconCssClass="fa-solid fa-book" />
            <UiAccountingMetricTile Label="إجمالي المدين" Value="@(_journalsPage.Items?.Sum(x => x.Lines.Sum(l => l.DebitAmount)).ToString("N2") ?? "0.00")" IconCssClass="fa-solid fa-arrow-down" Variant="UiAccountingMetricTile.MetricVariant.Debit" />
            <UiAccountingMetricTile Label="إجمالي الدائن" Value="@(_journalsPage.Items?.Sum(x => x.Lines.Sum(l => l.CreditAmount)).ToString("N2") ?? "0.00")" IconCssClass="fa-solid fa-arrow-up" Variant="UiAccountingMetricTile.MetricVariant.Credit" />
        </div>

        @if (_isLoading)
        {
            <UiAlert Message="جاري تحميل القيود المحاسبية..." Tone="AlertTone.Info" />
        }
        else if (_journalsPage.Items is null || _journalsPage.Items.Count == 0)
        {
            <UiAlert Message="لا توجد قيود يومية مسجلة." Tone="AlertTone.Warning" />
        }
        else
        {
            @foreach (var entry in _journalsPage.Items)
            {
                var debit = entry.Lines.Sum(l => l.DebitAmount);
                var credit = entry.Lines.Sum(l => l.CreditAmount);
                <div @onclick="@(() => OpenRecordInTab(AccountingEntityType.Journals, entry.Id, $"قيد #{entry.JournalNumber}"))" style="cursor: pointer;">
                    <UiJournalEntryCard EntryNumber="@entry.JournalNumber"
                                        DateText="@entry.PostingDate.ToString("yyyy-MM-dd")"
                                        EntryTypeText="@AccountingArabicPresenter.GetJournalTypeText(entry.JournalType)"
                                        Description="@entry.Description"
                                        TotalDebit="@debit"
                                        TotalCredit="@credit"
                                        IsBalanced="@(debit == credit)"
                                        StatusText="@AccountingArabicPresenter.GetJournalStatusText(entry.Status)"
                                        StatusState="@(entry.Status == JournalEntryStatus.Posted ? "posted" : (entry.Status == JournalEntryStatus.Draft ? "draft" : "reversed"))"
                                        OnView="@(() => OpenRecordInTab(AccountingEntityType.Journals, entry.Id, $"قيد #{entry.JournalNumber}"))" />
                </div>
            }
        }
    };

