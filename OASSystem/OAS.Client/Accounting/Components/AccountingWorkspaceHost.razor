    private RenderFragment RenderListTabContent(AccountingEntityType entityType) => __builder =>
    {
        switch (entityType)
        {
            case AccountingEntityType.Accounts:
                @RenderAccountsList();
                break;
            case AccountingEntityType.Journals:
                @RenderJournalsList();
                break;
            case AccountingEntityType.ReceiptVouchers:
                @RenderReceiptsList();
                break;
            case AccountingEntityType.PaymentVouchers:
                @RenderPaymentsList();
                break;
            case AccountingEntityType.CashAccounts:
            case AccountingEntityType.BankAccounts:
                @RenderCashBankList();
                break;
            case AccountingEntityType.CashShifts:
                @RenderCashShiftsList();
                break;
            case AccountingEntityType.Expenses:
            case AccountingEntityType.ExpenseTypes:
                @RenderExpensesList();
                break;
            case AccountingEntityType.FiscalYears:
            case AccountingEntityType.FiscalPeriods:
                @RenderFiscalList();
                break;
            case AccountingEntityType.CostCenters:
                @RenderCostCentersList();
                break;
            case AccountingEntityType.CustomerAccounts:
                @RenderCustomerAccountsList();
                break;
            case AccountingEntityType.SupplierAccounts:
                @RenderSupplierAccountsList();
                break;
            case AccountingEntityType.PostingProfiles:
                @RenderPostingProfilesList();
                break;
            case AccountingEntityType.PaymentAllocations:
                @RenderPaymentAllocationsList();
                break;
            default:
                @RenderAccountsList();
                break;
        }
    };

    private RenderFragment RenderEditorTabContent(AccountingTabState tab) => __builder =>
    {
        <div class="d-flex flex-column gap-3" dir="rtl">
            <UiDocumentHeaderBar Title="@tab.Title"
                                 Subtitle="@(tab.IsNew ? "إدخال بيانات السجل الجديد" : "عرض وتعديل تفاصيل السجل")"
                                 StatusText="@(tab.IsNew ? "جديد" : (tab.IsEditMode ? "قيد التعديل" : "محفوظ"))"
                                 StatusState="@(tab.IsNew ? "draft" : (tab.IsEditMode ? "open" : "posted"))" />

            @if (tab.IsLoading)
            {
                <UiAlert Message="جاري تحميل بيانات السجل..."
                         Tone="AlertTone.Info" />
            }
            else if (tab.Model is null)
            {
                <UiAlert Message="تعذر تهيئة نموذج الإدخال."
                         Tone="AlertTone.Warning" />
            }
            else
            {
                switch (tab.EntityType)
                {
                    case AccountingEntityType.Accounts when tab.Model is AccountEditor.FormModel accModel:
                        <AccountEditor Model="@accModel"
                                       IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                       IsNew="@tab.IsNew"
                                       AccountSearchAsync="@SearchAccountsAsync"
                                       OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(accModel)))" />
                        break;

                    case AccountingEntityType.Journals
                when tab.Model is JournalEntryEditor.FormModel jModel:

                        <JournalEntryEditor Model="@jModel"
                                            IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                            IsNew="@tab.IsNew"
                                            FiscalPeriodSearchAsync="@SearchFiscalPeriodsAsync"
                                            AccountSearchAsync="@SearchAccountsAsync"
                                            CostCenterSearchAsync="@SearchCostCentersAsync"
                                            OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(jModel)))" />
                        break;

                    case AccountingEntityType.ReceiptVouchers
                when tab.Model is ReceiptVoucherEditor.FormModel rvModel:

                        <ReceiptVoucherEditor Model="@rvModel"
                                              IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                              IsNew="@tab.IsNew"
                                              CustomerSearchAsync="@SearchCustomersAsync"
                                              CashAccountSearchAsync="@SearchCashAccountsAsync"
                                              BankAccountSearchAsync="@SearchBankAccountsAsync"
                                              OnModelChanged="@(() => tab.CheckDirty(
                                                                            System.Text.Json.JsonSerializer.Serialize(rvModel)))" />
                        break;
                    case AccountingEntityType.PaymentVouchers
                when tab.Model is PaymentVoucherEditor.FormModel pvModel:

                        <PaymentVoucherEditor Model="@pvModel"
                                              IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                              IsNew="@tab.IsNew"
                                              SupplierSearchAsync="@SearchSuppliersAsync"
                                              CashAccountSearchAsync="@SearchCashAccountsAsync"
                                              BankAccountSearchAsync="@SearchBankAccountsAsync"
                                              OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(pvModel)))" />
                        break;

                    case AccountingEntityType.Expenses when tab.Model is ExpenseEditor.FormModel expModel:
                        <ExpenseEditor Model="@expModel"
                                       IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                       IsNew="@tab.IsNew"
                                       ExpenseTypeSearchAsync="@SearchExpenseTypesAsync"
                                       AccountSearchAsync="@SearchAccountsAsync"
                                       CashAccountSearchAsync="@SearchCashAccountsAsync"
                                       BankAccountSearchAsync="@SearchBankAccountsAsync"
                                       OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(expModel)))" />
                        break;

                    case AccountingEntityType.FiscalYears when tab.Model is FiscalYearEditor.FormModel fyModel:
                        <FiscalYearEditor Model="@fyModel"
                                          IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                          IsNew="@tab.IsNew"
                                          OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(fyModel)))" />
                        break;

                    case AccountingEntityType.FiscalPeriods when tab.Model is FiscalPeriodEditor.FormModel fpModel:
                        <FiscalPeriodEditor Model="@fpModel"
                                            IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                            OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(fpModel)))" />
                        break;

                    case AccountingEntityType.CashAccounts when tab.Model is CashAccountEditor.FormModel caModel:
                        <CashAccountEditor Model="@caModel"
                                           IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                           IsNew="@tab.IsNew"
                                           AccountSearchAsync="@SearchAccountsAsync"
                                           OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(caModel)))" />
                        break;

                    case AccountingEntityType.BankAccounts when tab.Model is BankAccountEditor.FormModel baModel:
                        <BankAccountEditor Model="@baModel"
                                           IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                           IsNew="@tab.IsNew"
                                           AccountSearchAsync="@SearchAccountsAsync"
                                           OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(baModel)))" />
                        break;

                    case AccountingEntityType.CashShifts
                when tab.Model is CashShiftEditor.FormModel csModel:

                        <CashShiftEditor Model="@csModel"
                                         IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                         IsNew="@tab.IsNew"
                                         CashAccountSearchAsync="@SearchCashAccountsAsync"
                                         OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(csModel)))" />
                        break;

                    case AccountingEntityType.ExpenseTypes when tab.Model is ExpenseTypeEditor.FormModel etModel:
                        <ExpenseTypeEditor Model="@etModel"
                                           IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                           IsNew="@tab.IsNew"
                                           AccountSearchAsync="@SearchAccountsAsync"
                                           OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(etModel)))" />
                        break;

                    case AccountingEntityType.CostCenters when tab.Model is CostCenterEditor.FormModel ccModel:
                        <CostCenterEditor Model="@ccModel"
                                          IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                          IsNew="@tab.IsNew"
                                          CostCenterSearchAsync="@SearchCostCentersAsync"
                                          OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(ccModel)))" />
                        break;

                    case AccountingEntityType.CustomerAccounts when tab.Model is CustomerAccountEditor.FormModel custModel:
                        <CustomerAccountEditor Model="@custModel"
                                               IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                               IsNew="@tab.IsNew"
                                               CustomerSearchAsync="@SearchCustomersAsync"
                                               AccountSearchAsync="@SearchAccountsAsync"
                                               OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(custModel)))" />
                        break;

                    case AccountingEntityType.SupplierAccounts when tab.Model is SupplierAccountEditor.FormModel supModel:
                        <SupplierAccountEditor Model="@supModel"
                                               IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                               IsNew="@tab.IsNew"
                                               SupplierSearchAsync="@SearchSuppliersAsync"
                                               AccountSearchAsync="@SearchAccountsAsync"
                                               OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(supModel)))" />
                        break;

                    case AccountingEntityType.PostingProfiles when tab.Model is PostingProfileEditor.FormModel ppModel:
                        <PostingProfileEditor Model="@ppModel"
                                              IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                              IsNew="@tab.IsNew"
                                              AccountSearchAsync="@SearchAccountsAsync"
                                              OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(ppModel)))" />
                        break;

                    case AccountingEntityType.PaymentAllocations when tab.Model is PaymentAllocationEditor.FormModel allocModel:
                        <PaymentAllocationEditor Model="@allocModel"
                                                 IsEditable="@(tab.IsNew || tab.IsEditMode)"
                                                 IsNew="@tab.IsNew"
                                                 SourceSearchAsync="@SearchAccountsAsync"
                                                 TargetSearchAsync="@SearchAccountsAsync"
                                                 OnModelChanged="@(() => tab.CheckDirty(System.Text.Json.JsonSerializer.Serialize(allocModel)))" />
                        break;
                    default:
                        <UiAlert Message="لا يوجد محرر مهيأ لهذا النوع من البيانات المحاسبية."
                                 Tone="AlertTone.Warning" />
                        break;
                }
            }
        </div>
    };

