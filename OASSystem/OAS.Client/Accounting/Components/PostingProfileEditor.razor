@namespace OAS.Client.Accounting.Components
@using OAS.UiLib.Components.Accounting.PostingProfiles
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface>
    <UiAccountingFormSection Title="بيانات ملف الترحيل الآلي"
                             Subtitle="الرمز، الاسم، الوحدة التشغيلية، ونوع المستند"
                             IconCssClass="fa-solid fa-sliders">
        <UiAccountingFormGrid Columns="2">
            <UiInputText Label="كود ملف الترحيل"
                         Value="@Model.Code"
                         ValueChanged="OnCodeChanged"
                         Required="true"
                         Placeholder="مثال: PP-SALES-INV"
                         ReadOnly="@(!IsNew)"
                         Disabled="@(!IsEditable || !IsNew)"
                         Size="ControlSize.Small" />
            <UiInputText Label="اسم ملف الترحيل"
                         Value="@Model.Name"
                         ValueChanged="OnNameChanged"
                         Required="true"
                         Placeholder="مثال: ملف ترحيل فواتير المبيعات"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />
            <UiInputText Label="الوحدة / النظام"
                         Value="@Model.Module"
                         ValueChanged="OnModuleChanged"
                         Required="true"
                         Placeholder="Sales / Purchasing / Inventory"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />
            <UiInputText Label="نوع المستند"
                         Value="@Model.DocumentType"
                         ValueChanged="OnDocumentTypeChanged"
                         Required="true"
                         Placeholder="SalesInvoice / PurchaseInvoice"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />
        </UiAccountingFormGrid>
        <UiAccountingCheckGroup>
            <UiCheckbox Label="ملف الترحيل نشط"
                        Value="@Model.IsActive"
                        ValueChanged="OnActiveChanged"
                        Disabled="@(!IsEditable)" />
        </UiAccountingCheckGroup>
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="قواعد توجيه الحسابات"
                             Subtitle="ربط الأدوار المحاسبية بالحسابات المقابلة في دليل الحسابات"
                             IconCssClass="fa-solid fa-route">
        <UiPostingProfileLinesEditor Lines="@Model.Lines"
                                     IsEditable="@IsEditable"
                                     AccountSearchAsync="@AccountSearchAsync"
                                     OnLinesChanged="OnChanged" />
    </UiAccountingFormSection>
</UiAccountingEditorSurface>

@code {
    public sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Module { get; set; } = "Sales";
        public string DocumentType { get; set; } = "SalesInvoice";
        public bool IsActive { get; set; } = true;
        public string RowVersion { get; set; } = string.Empty;
        public List<UiPostingProfileLinesEditor.EditablePostingProfileLine> Lines { get; set; } = [];
    }

    [Parameter] public FormModel Model { get; set; } = new();
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? AccountSearchAsync { get; set; }
    [Parameter] public EventCallback OnModelChanged { get; set; }

    private Task OnChanged() => OnModelChanged.InvokeAsync();
    private async Task OnCodeChanged(string? value) { Model.Code = value ?? string.Empty; await OnChanged(); }
    private async Task OnNameChanged(string? value) { Model.Name = value ?? string.Empty; await OnChanged(); }
    private async Task OnModuleChanged(string? value) { Model.Module = value ?? string.Empty; await OnChanged(); }
    private async Task OnDocumentTypeChanged(string? value) { Model.DocumentType = value ?? string.Empty; await OnChanged(); }
    private async Task OnActiveChanged(bool value) { Model.IsActive = value; await OnChanged(); }
}
