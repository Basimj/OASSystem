@namespace OAS.Client.Accounting.Components
@using OAS.UiLib.Components.Accounting.PostingProfiles
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface AdditionalCssClass="oas-posting-editor">
    <UiAccountingFormSection Title="بيانات ملف الترحيل"
                             Subtitle="حدد الوحدة والمستند، ثم اربط الأدوار المحاسبية بحساباتها"
                             IconCssClass="fa-solid fa-file-circle-plus">
        <UiAccountingFormGrid Columns="2">
            <UiInputText Label="كود الملف"
                         Value="@Model.Code"
                         ValueChanged="OnCodeChanged"
                         Required="true"
                         ErrorText="@Model.CodeError"
                         Placeholder="مثال: PP-SALES-INV"
                         ReadOnly="@(!IsNew)"
                         Disabled="@(!IsEditable || !IsNew)"
                         Size="ControlSize.Small" />
            <UiInputText Label="اسم ملف الترحيل"
                         Value="@Model.Name"
                         ValueChanged="OnNameChanged"
                         Required="true"
                         Placeholder="مثال: ترحيل فواتير المبيعات"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />
            @if (IsNew || PostingProfileUiCatalog.IsKnownScope(Model.Module, Model.DocumentType))
            {
                <UiSelect Label="الوحدة" Value="@Model.Module" ValueChanged="OnModuleChanged"
                          Options="@PostingProfileUiCatalog.Modules" Required="true"
                          Disabled="@(!IsEditable || !IsNew)" Size="ControlSize.Small" />
                <UiSelect Label="نوع المستند" Value="@Model.DocumentType" ValueChanged="OnDocumentTypeChanged"
                          Options="@PostingProfileUiCatalog.DocumentOptions(Model.Module)" Required="true"
                          Disabled="@(!IsEditable || !IsNew)" Size="ControlSize.Small" />
            }
            else
            {
                <UiAccountingReadOnlyValue Label="الوحدة" Value="@PostingProfileUiCatalog.ModuleText(Model.Module)" />
                <UiAccountingReadOnlyValue Label="نوع المستند" Value="@PostingProfileUiCatalog.DocumentText(Model.DocumentType)" />
            }
        </UiAccountingFormGrid>
        <div class="oas-posting-editor__status">
            <span class="@(Model.IsActive ? "oas-posting-editor__active" : "oas-posting-editor__inactive")">
                <i class="@(Model.IsActive ? "fa-solid fa-circle-check" : "fa-solid fa-circle-minus")" aria-hidden="true"></i>
                @(Model.IsActive ? "ملف نشط" : "ملف معطل")
            </span>
            <span>@(IsNew
                ? "يُحفظ الملف الجديد معطلًا؛ يُفعّل بعد مراجعة القواعد."
                : "الحفظ لا يغيّر حالة التفعيل. استخدم زر التفعيل أو التعطيل المستقل.")</span>
        </div>
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="قواعد توجيه الحسابات"
                             Subtitle="لكل دور محاسبي حساب واحد مؤهل للترحيل؛ تظهر أخطاء السطر بجانب الحقل"
                             IconCssClass="fa-solid fa-route">
        <UiPostingProfileLinesEditor Lines="@Model.Lines"
                                     Module="@Model.Module"
                                     DocumentType="@Model.DocumentType"
                                     IsEditable="@IsEditable"
                                     AccountSearchAsync="@AccountSearchAsync"
                                     OnLinesChanged="OnChanged" />
        @if (!string.IsNullOrWhiteSpace(Model.LinesError))
        {
            <div class="oas-posting-editor__error" role="alert">@Model.LinesError</div>
        }
    </UiAccountingFormSection>
</UiAccountingEditorSurface>

@code {
    public sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;
        public string? CodeError { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Module { get; set; } = "Sales";
        public string DocumentType { get; set; } = "SalesInvoice";
        public bool IsActive { get; set; } = false;
        public string? LinesError { get; set; }
        public string RowVersion { get; set; } = string.Empty;
        public List<UiPostingProfileLinesEditor.EditablePostingProfileLine> Lines { get; set; } = [];
    }

    [Parameter] public FormModel Model { get; set; } = new();
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? AccountSearchAsync { get; set; }
    [Parameter] public EventCallback OnModelChanged { get; set; }

    private Task OnChanged() { Model.LinesError = null; return OnModelChanged.InvokeAsync(); }
    private async Task OnCodeChanged(string? value) { Model.Code = value ?? string.Empty; Model.CodeError = null; await OnChanged(); }
    private async Task OnNameChanged(string? value) { Model.Name = value ?? string.Empty; await OnChanged(); }
    private async Task OnModuleChanged(string? value)
    {
        if (!IsNew) return;
        Model.Module = value ?? string.Empty;
        Model.DocumentType = PostingProfileUiCatalog.DocumentOptions(Model.Module).FirstOrDefault()?.Value ?? string.Empty;
        // Never discard a user's existing rules silently after changing document scope.
        await OnChanged();
    }
    private async Task OnDocumentTypeChanged(string? value)
    {
        if (!IsNew) return;
        Model.DocumentType = value ?? string.Empty;
        await OnChanged();
    }
}
