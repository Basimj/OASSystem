@namespace OAS.Client.Accounting.Components
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface>
    <UiAccountingFormSection Title="بيانات الصندوق / الخزينة النقدية"
                             Subtitle="عند إنشاء صندوق جديد ينشئ النظام حسابه المحاسبي تلقائياً تحت الحساب الرئيسي المحدد في إعدادات المحاسبة."
                             IconCssClass="fa-solid fa-vault">
        <UiAccountingFormGrid Columns="2">
            <UiInputText Label="كود الصندوق (تلقائي)"
                         Value="@Model.Code"
                         ValueExpression="@(() => Model.Code)"
                         ValueChanged="OnCodeChanged"
                         Required="true"
                         ReadOnly="true"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم الصندوق"
                         Value="@Model.Name"
                         ValueExpression="@(() => Model.Name)"
                         ValueChanged="OnNameChanged"
                         Required="true"
                         Placeholder="مثال: الخزينة الرئيسية"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiLookup Label="العملة"
                      Value='@Model.CurrencyId?.ToString("D")'
                      ValueChanged="OnCurrencyChanged"
                      SelectedItem="@CurrencyLookupItem"
                      SearchAsync="CurrencySearchAsync"
                      Placeholder="اختر عملة الصندوق..."
                      Disabled="@(!IsEditable)"
                      Required="true"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />

            @if (Model.AccountId.HasValue)
            {
                <UiAccountingReadOnlyValue Label="الحساب المحاسبي المرتبط"
                                           Value="@(AccountLookupItem?.PrimaryText ?? Model.AccountId.Value.ToString("D"))"
                                           Tone="@UiAccountingReadOnlyValue.ValueTone.Primary" />
            }

            <UiAccountingCheckGroup>
                <UiCheckbox Label="الصندوق الافتراضي لهذه العملة"
                            Value="@Model.IsDefault"
                            ValueChanged="OnDefaultChanged"
                            Disabled="@(!IsEditable)" />
                <UiCheckbox Label="الصندوق نشط"
                            Value="@Model.IsActive"
                            ValueChanged="OnActiveChanged"
                            Disabled="@(!IsEditable)" />
            </UiAccountingCheckGroup>
        </UiAccountingFormGrid>
    </UiAccountingFormSection>
</UiAccountingEditorSurface>

@code {
    public sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;
        public string? CodeError { get; set; }
        public string Name { get; set; } = string.Empty;
        public Guid? AccountId { get; set; }
        public Guid? CurrencyId { get; set; }
        public bool IsDefault { get; set; }
        public bool IsActive { get; set; } = true;
        public string RowVersion { get; set; } = string.Empty;
    }

    [Parameter] public FormModel Model { get; set; } = new();
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public UiLookupItem? AccountLookupItem { get; set; }
    [Parameter] public UiLookupItem? CurrencyLookupItem { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CurrencySearchAsync { get; set; }
    [Parameter] public EventCallback OnModelChanged { get; set; }

    private Task OnChanged() => OnModelChanged.InvokeAsync();
    private async Task OnCodeChanged(string? value){ Model.Code=value??string.Empty;Model.CodeError=null;await OnChanged();}
    private async Task OnNameChanged(string? value){ Model.Name=value??string.Empty;await OnChanged();}
    private async Task OnCurrencyChanged(string? value){ Model.CurrencyId=Guid.TryParse(value,out var id)?id:null;await OnChanged();}
    private async Task OnDefaultChanged(bool value){Model.IsDefault=value;await OnChanged();}
    private async Task OnActiveChanged(bool value){Model.IsActive=value;await OnChanged();}
}
