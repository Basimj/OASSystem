@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface>
    <UiAccountingFormSection Title="دورة حياة الوردية النقدية"
                             Subtitle="متابعة حالة الوردية الحالية والتحولات المعتمدة"
                             IconCssClass="fa-solid fa-timeline">
        <UiAccountingStatusActionBar Label="الحالة الحالية"
                                     StatusText="@AccountingArabicPresenter.GetCashShiftStatusText(Model.Status)"
                                     StatusState="@StatusState"
                                     Actions="@StatusActions" />
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="بيانات فتح الوردية والصندوق"
                             Subtitle="رقم الوردية، الصندوق، ورصيد البداية"
                             IconCssClass="fa-solid fa-cash-register">

        <UiAccountingFormGrid Columns="2">
            <UiInputText Label="رقم الوردية"
                         Value="@Model.ShiftNumber"
                         ReadOnly="true"
                         Disabled="true"
                         Placeholder="توليد تلقائي..."
                         Size="ControlSize.Small" />

            <UiLookup Label="الصندوق / الخزينة"
                      Value="@CashAccountValue"
                      ValueChanged="OnCashAccountChanged"
                      SelectedItem="@CashAccountLookupItem"
                      SearchAsync="@CashAccountSearchAsync"
                      Placeholder="اختر الصندوق..."
                      Disabled="@CashAccountDisabled"
                      Required="true"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />

            <UiAccountingNumberField Label="رصيد الافتتاح (العهدة المستلمة)"
                                     Value="@Model.OpeningBalance"
                                     ValueChanged="OnOpeningBalanceChanged"
                                     Min="0"
                                     Disabled="@OpeningBalanceDisabled" />
        </UiAccountingFormGrid>
    </UiAccountingFormSection>

    @if (!IsNew)
    {
        <UiAccountingFormSection Title="بيانات الإغلاق والجرد الفعلي"
                                 Subtitle="المبالغ المتوقعة والجرد الفعلي والفارق المحسوب"
                                 IconCssClass="fa-solid fa-calculator">

            <UiAccountingFormGrid Columns="3">
                <UiAccountingReadOnlyValue Label="المبلغ المتوقع بالصندوق"
                                           Value="@ExpectedClosingBalanceText" />

                @if (Model.Status == CashShiftStatus.Open)
                {
                    <UiAccountingNumberField Label="الجرد الفعلي عند الإغلاق"
                                             Value="@ActualClosingBalanceValue"
                                             ValueChanged="OnActualClosingBalanceChanged"
                                             Min="0"
                                             Tone="@UiAccountingNumberField.NumberTone.Primary" />
                }
                else
                {
                    <UiAccountingReadOnlyValue Label="الجرد الفعلي المسجل"
                                               Value="@ActualClosingBalanceText"
                                               Tone="@UiAccountingReadOnlyValue.ValueTone.Primary" />
                }

                <UiAccountingReadOnlyValue Label="الفارق (عجز / زيادة)"
                                           Value="@DifferenceAmountText"
                                           Tone="@DifferenceTone" />
            </UiAccountingFormGrid>
        </UiAccountingFormSection>
    }
</UiAccountingEditorSurface>

@code {
    public sealed class FormModel
    {
        public string ShiftNumber { get; set; } = string.Empty;

        public Guid? CashAccountId { get; set; }

        public decimal OpeningBalance { get; set; }

        public decimal? ExpectedClosingBalance { get; set; }

        public decimal? ActualClosingBalance { get; set; }

        public decimal? DifferenceAmount { get; set; }

        public CashShiftStatus Status { get; set; } = CashShiftStatus.Open;

        public string RowVersion { get; set; } = string.Empty;
    }

    [Parameter]
    public FormModel Model { get; set; } = new();

    [Parameter]
    public bool IsEditable { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public UiLookupItem? CashAccountLookupItem { get; set; }

    [Parameter]
    public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>?
        CashAccountSearchAsync
    { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public EventCallback OnModelChanged { get; set; }

    private string? CashAccountValue
    {
        get
        {
            return Model.CashAccountId.HasValue
                ? Model.CashAccountId.Value.ToString("D")
                : null;
        }
    }

    private string StatusState
    {
        get
        {
            return Model.Status.ToString().ToLowerInvariant();
        }
    }

    private RenderFragment? StatusActions
    {
        get
        {
            return IsNew ? null : Actions;
        }
    }

    private bool CashAccountDisabled
    {
        get
        {
            return !IsEditable || !IsNew;
        }
    }

    private bool OpeningBalanceDisabled
    {
        get
        {
            return !IsEditable || !IsNew;
        }
    }

    private decimal ActualClosingBalanceValue
    {
        get
        {
            return Model.ActualClosingBalance ?? 0m;
        }
    }

    private string ExpectedClosingBalanceText
    {
        get
        {
            return Model.ExpectedClosingBalance.HasValue
                ? Model.ExpectedClosingBalance.Value.ToString("N2")
                : "0.00";
        }
    }

    private string ActualClosingBalanceText
    {
        get
        {
            return Model.ActualClosingBalance.HasValue
                ? Model.ActualClosingBalance.Value.ToString("N2")
                : "لم يتم الجرد بعد";
        }
    }

    private string DifferenceAmountText
    {
        get
        {
            return Model.DifferenceAmount.HasValue
                ? Model.DifferenceAmount.Value.ToString("N2")
                : "-";
        }
    }

    private UiAccountingReadOnlyValue.ValueTone DifferenceTone
    {
        get
        {
            if (!Model.DifferenceAmount.HasValue)
            {
                return UiAccountingReadOnlyValue.ValueTone.Default;
            }

            if (Model.DifferenceAmount.Value < 0m)
            {
                return UiAccountingReadOnlyValue.ValueTone.Danger;
            }

            if (Model.DifferenceAmount.Value > 0m)
            {
                return UiAccountingReadOnlyValue.ValueTone.Success;
            }

            return UiAccountingReadOnlyValue.ValueTone.Default;
        }
    }

    private Task OnChanged()
    {
        return OnModelChanged.InvokeAsync();
    }

    private async Task OnCashAccountChanged(string? value)
    {
        Model.CashAccountId = Guid.TryParse(value, out var id)
            ? id
            : null;

        await OnChanged();
    }

    private async Task OnOpeningBalanceChanged(decimal amount)
    {
        Model.OpeningBalance = amount;
        await OnChanged();
    }

    private async Task OnActualClosingBalanceChanged(decimal amount)
    {
        Model.ActualClosingBalance = amount;
        await OnChanged();
    }
}