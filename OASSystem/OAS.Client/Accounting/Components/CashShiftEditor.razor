@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.CashShifts
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Buttons
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<div class="ui-acc-editor" dir="rtl">

    <UiAccountingFormSection Title="دورة حياة الوردية النقدية"
                             Subtitle="متابعة حالة الوردية الحالية والتحولات المعتمدة"
                             IconCssClass="fa-solid fa-timeline">

        <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded border">

            <div class="d-flex align-items-center gap-2">

                <span class="fw-bold">
                    الحالة الحالية:
                </span>

                <UiAccountingStatusBadge Text="@AccountingArabicPresenter.GetCashShiftStatusText(Model.Status)"
                                         State="@Model.Status.ToString().ToLowerInvariant()" />

            </div>

            @if (!IsNew && Actions is not null)
            {
                <div class="d-flex gap-2">
                    @Actions
                </div>
            }

        </div>

    </UiAccountingFormSection>


    <UiAccountingFormSection Title="بيانات فتح الوردية والصندوق"
                             Subtitle="رقم الوردية، الصندوق، ورصيد البداية"
                             IconCssClass="fa-solid fa-cash-register">

        <div class="ui-acc-form-grid ui-acc-form-grid--2col">

            <UiInputText Label="رقم الوردية"
                         Value="@Model.ShiftNumber"
                         ValueExpression="@(() => Model.ShiftNumber)"
                         ReadOnly="true"
                         Disabled="true"
                         Placeholder="توليد تلقائي..."
                         Size="ControlSize.Small" />

            <UiLookup Label="الصندوق / الخزينة"
                      Value="@Model.CashAccountId?.ToString("D")"
                      ValueChanged="OnCashAccountChanged"
                      SelectedItem="@CashAccountLookupItem"
                      SearchAsync="CashAccountSearchAsync"
                      Placeholder="اختر الصندوق..."
                      Disabled="@(!IsEditable || !IsNew)"
                      Required="true"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />

            <div>

                <label class="ui-input-text__label mb-1 d-block">
                    رصيد الافتتاح (العُهدة المستلمة)
                </label>

                <input type="number"
                       step="0.01"
                       min="0"
                       class="ui-input-text__field text-start font-bold fs-5"
                       value="@Model.OpeningBalance"
                       disabled="@(!IsEditable || !IsNew)"
                       @onchange="OnOpeningBalanceChanged" />

            </div>

        </div>

    </UiAccountingFormSection>


    @if (!IsNew)
    {
        <UiAccountingFormSection Title="بيانات الإغلاق والجرد الفعلي"
                                 Subtitle="المبالغ المتوقعة والجرد الفعلي والفارق المحسوب"
                                 IconCssClass="fa-solid fa-calculator">

            <div class="ui-acc-form-grid ui-acc-form-grid--3col">

                <div>

                    <label class="ui-input-text__label mb-1 d-block">
                        المبلغ المتوقع بالصندوق
                    </label>

                    <div class="p-2 border rounded bg-light font-bold text-start">
                        @(Model.ExpectedClosingBalance.HasValue
                                            ? Model.ExpectedClosingBalance.Value.ToString("N2")
                                            : "0.00")
                                                 </div>

                </div>


                <div>

                    <label class="ui-input-text__label mb-1 d-block">
                        الجرد الفعلي المسجل
                    </label>

                    <div class="p-2 border rounded bg-light font-bold text-start text-primary">
                        @(Model.ActualClosingBalance.HasValue
                                            ? Model.ActualClosingBalance.Value.ToString("N2")
                                            : "لم يتم الجرد بعد")
                                                             </div>

                </div>


                <div>

                    <label class="ui-input-text__label mb-1 d-block">
                        الفارق (عجز / زيادة)
                    </label>

                    <div class="p-2 border rounded bg-light font-bold text-start @(GetDifferenceCssClass())">
                        @(Model.DifferenceAmount.HasValue
                                            ? Model.DifferenceAmount.Value.ToString("N2")
                                            : "-")
                </div>

                </div>

            </div>

        </UiAccountingFormSection>
        }

</div>


@code {

    public sealed class FormModel
    {
        public string ShiftNumber { get; set; } = string.Empty;

        public Guid? CashAccountId { get; set; }

        public decimal OpeningBalance { get; set; }

        public decimal? ExpectedClosingBalance { get; set; }

        public decimal? ActualClosingBalance { get; set; }

        public decimal? DifferenceAmount { get; set; }

        public CashShiftStatus Status { get; set; }
            = CashShiftStatus.Open;
    }


    [Parameter]
    public FormModel Model { get; set; } = new();


    [Parameter]
    public bool IsEditable { get; set; }


    [Parameter]
    public bool IsNew { get; set; }


    [Parameter]
    public UiLookupItem? CashAccountLookupItem { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        CashAccountSearchAsync
    { get; set; }


    [Parameter]
    public RenderFragment? Actions { get; set; }


    [Parameter]
    public EventCallback OnModelChanged { get; set; }


    private Task OnChanged()
        => OnModelChanged.InvokeAsync();


    private async Task OnCashAccountChanged(
        string? value)
    {
        Model.CashAccountId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnOpeningBalanceChanged(
        ChangeEventArgs e)
    {
        if (decimal.TryParse(
                e.Value?.ToString(),
                out var amount))
        {
            Model.OpeningBalance = amount;

            await OnChanged();
        }
    }


    private string GetDifferenceCssClass()
    {
        if (!Model.DifferenceAmount.HasValue)
        {
            return string.Empty;
        }

        if (Model.DifferenceAmount.Value < 0)
        {
            return "text-danger";
        }

        if (Model.DifferenceAmount.Value > 0)
        {
            return "text-success";
        }

        return string.Empty;
    }
}