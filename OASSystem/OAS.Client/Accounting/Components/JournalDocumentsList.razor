@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.Journals
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace

<section class="oas-journal-documents" dir="rtl" aria-label="قائمة القيود اليومية">
    <div class="oas-journal-documents__header">
        <div>
            <h2><i class="fa-solid fa-book-journal-whills" aria-hidden="true"></i> القيود اليومية</h2>
            <p>استعراض القيود حسب التاريخ والحالة والمصدر، وفتح أي قيد في تبويب مستقل.</p>
        </div>
        <span class="oas-journal-documents__count">@TotalCount قيد ضمن نتائج البحث</span>
    </div>
    <div class="oas-journal-documents__stats">
        <div><small>قيود في الصفحة</small><strong>@Rows.Count</strong></div>
        <div><small>مسودات</small><strong>@Rows.Count(x => x.Status == JournalEntryStatus.Draft)</strong></div>
        <div><small>بانتظار الاعتماد</small><strong>@Rows.Count(x => x.Status == JournalEntryStatus.PendingApproval)</strong></div>
        <div><small>قيود مرحلة</small><strong>@Rows.Count(x => x.Status == JournalEntryStatus.Posted)</strong></div>
    </div>
    <div class="oas-journal-documents__filters">
        <label for="oas-journal-status">حالة القيد</label>
        <select id="oas-journal-status" value="@StatusFilter" @onchange="OnStatusChanged">
            <option value="">جميع الحالات</option>
            <option value="draft">مسودة</option>
            <option value="pending">بانتظار الاعتماد</option>
            <option value="approved">معتمد</option>
            <option value="posted">مرحّل</option>
            <option value="reversed">معكوس</option>
            <option value="unposted">غير مرحّل</option>
        </select>
        <span>يطبق المرشح على جميع النتائج في الخادم، وليس الصفحة المعروضة فقط.</span>
    </div>
    <UiAccountingRecordList Items="@JournalItems"
                            FinancialStyle="true"
                            EmptyTitle="لا توجد قيود مطابقة"
                            EmptyDescription="غيّر البحث أو مرشح الحالة لعرض قيود أخرى."
                            OnOpen="OnOpen" />
    <p class="oas-journal-documents__hint">المدين والدائن معروضان بالعملة الأساسية من أسطر القيد. علامـة — تعني عدم وجود أسطر محملة، ولا تعني مبلغًا صفريًا.</p>
</section>

@code {
    [Parameter] public IReadOnlyList<JournalEntryDto> Rows { get; set; } = [];
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public string StatusFilter { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> StatusFilterChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    private IReadOnlyList<UiAccountingRecordList.RecordItem> JournalItems => Rows.Select(entry =>
        new UiAccountingRecordList.RecordItem(
            entry.Id,
            entry.JournalNumber,
            GetSourceText(entry.SourceModule),
            "fa-solid fa-book-journal-whills",
            [
                new("تاريخ الترحيل", entry.PostingDate.ToString("yyyy/MM/dd"))
            ],
            AccountingArabicPresenter.GetJournalStatusText(entry.Status),
            JournalState(entry.Status),
            $"مدين: {FormatBaseAmount(entry, true)}",
            $"دائن: {FormatBaseAmount(entry, false)} · أساسي",
            entry.Description)).ToArray();

    private static string JournalState(JournalEntryStatus status) => status switch
    {
        JournalEntryStatus.Posted => "posted",
        JournalEntryStatus.Approved => "approved",
        JournalEntryStatus.Reversed => "cancelled",
        JournalEntryStatus.PendingApproval => "pending",
        _ => "draft"
    };
    private Task OnStatusChanged(ChangeEventArgs e) => StatusFilterChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
    private static string FormatBaseAmount(JournalEntryDto entry, bool debit)
    {
        if (entry.Lines.Count == 0) return "—";
        var value = debit ? entry.Lines.Sum(x => x.DebitAmount) : entry.Lines.Sum(x => x.CreditAmount);
        var digits = Math.Clamp((int)(entry.BaseCurrencyDecimalPlacesSnapshot ?? 2), 0, 8);
        return value.ToString($"N{digits}");
    }

    private static string GetSourceText(string? source) => source?.Trim() switch
    {
        null or "" or "Accounting" => "يدوي / محاسبة",
        "Sales" => "المبيعات",
        "Purchasing" => "المشتريات",
        "Inventory" => "المخزون",
        "Employees" => "الموظفون",
        "Customers" => "العملاء",
        "Suppliers" => "الموردون",
        "CashBank" => "النقد والبنوك",
        _ => "وحدة أخرى"
    };
}
