@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.BankAccounts
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface>

    <UiAccountingFormSection Title="بيانات الحساب البنكي"
                             Subtitle="اسم البنك، رقم الحساب، واسم الحساب والآيبان"
                             IconCssClass="fa-solid fa-building-columns">

        <UiAccountingFormGrid Columns="2">

            <UiInputText Label="كود الحساب البنكي"
                         Value="@Model.Code"
                         ValueExpression="@(() => Model.Code)"
                         ValueChanged="OnCodeChanged"
                         Required="true"
                         Placeholder="مثال: BANK-01"
                         ReadOnly="@(!IsNew)"
                         Disabled="@(!IsEditable || !IsNew)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم البنك"
                         Value="@Model.BankName"
                         ValueExpression="@(() => Model.BankName)"
                         ValueChanged="OnBankNameChanged"
                         Required="true"
                         Placeholder="مثال: بنك اليمن والكويت"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم الحساب الرسمي"
                         Value="@Model.AccountName"
                         ValueExpression="@(() => Model.AccountName)"
                         ValueChanged="OnAccountNameChanged"
                         Required="true"
                         Placeholder="مثال: حساب العمليات الجاري"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiInputText Label="رقم الحساب البنكي"
                         Value="@Model.AccountNumber"
                         ValueExpression="@(() => Model.AccountNumber)"
                         ValueChanged="OnAccountNumberChanged"
                         Required="true"
                         Placeholder="مثال: 1020304050"
                         ReadOnly="@(!IsNew)"
                         Disabled="@(!IsEditable || !IsNew)"
                         Size="ControlSize.Small" />

            <UiInputText Label="رقم الآيبان (IBAN)"
                         Value="@Model.IBAN"
                         ValueExpression="@(() => Model.IBAN)"
                         ValueChanged="OnIbanChanged"
                         Placeholder="اختياري..."
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiLookup Label="الحساب المحاسبي في الدليل"
                      Value='@Model.AccountId?.ToString("D")'
                      ValueChanged="OnAccountChanged"
                      SelectedItem="@AccountLookupItem"
                      SearchAsync="AccountSearchAsync"
                      Placeholder="ابحث عن حساب البنك في الدليل..."
                      Disabled="@(!IsEditable)"
                      Required="true"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />

            <UiAccountingCheckGroup>

                <UiCheckbox Label="الحساب البنكي نشط"
                            Value="@Model.IsActive"
                            ValueChanged="OnActiveChanged"
                            Disabled="@(!IsEditable)" />

            </UiAccountingCheckGroup>

        </UiAccountingFormGrid>

    </UiAccountingFormSection>

</UiAccountingEditorSurface>


@code {

    public sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;

        public string BankName { get; set; } = string.Empty;

        public string AccountName { get; set; } = string.Empty;

        public string AccountNumber { get; set; } = string.Empty;

        public string? IBAN { get; set; }

        public Guid? AccountId { get; set; }

        public bool IsActive { get; set; } = true;

        public string RowVersion { get; set; } = string.Empty;
    }


    [Parameter]
    public FormModel Model { get; set; } = new();


    [Parameter]
    public bool IsEditable { get; set; }


    [Parameter]
    public bool IsNew { get; set; }


    [Parameter]
    public UiLookupItem? AccountLookupItem { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        AccountSearchAsync
    { get; set; }


    [Parameter]
    public EventCallback OnModelChanged { get; set; }


    private Task OnChanged()
        => OnModelChanged.InvokeAsync();


    private async Task OnCodeChanged(string? value)
    {
        Model.Code = value ?? string.Empty;

        await OnChanged();
    }


    private async Task OnBankNameChanged(string? value)
    {
        Model.BankName = value ?? string.Empty;

        await OnChanged();
    }


    private async Task OnAccountNameChanged(string? value)
    {
        Model.AccountName = value ?? string.Empty;

        await OnChanged();
    }


    private async Task OnAccountNumberChanged(string? value)
    {
        Model.AccountNumber = value ?? string.Empty;

        await OnChanged();
    }


    private async Task OnIbanChanged(string? value)
    {
        Model.IBAN = value;

        await OnChanged();
    }


    private async Task OnAccountChanged(string? value)
    {
        Model.AccountId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnActiveChanged(bool value)
    {
        Model.IsActive = value;

        await OnChanged();
    }
}