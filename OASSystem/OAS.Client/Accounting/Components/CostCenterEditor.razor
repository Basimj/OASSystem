@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.CostCenters
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface>

    <UiAccountingFormSection Title="بيانات مركز التكلفة"
                             Subtitle="الرمز، التسمية، والتبعية الهيكلية"
                             IconCssClass="fa-solid fa-network-wired">

        <UiAccountingFormGrid Columns="2">

            <UiInputText Label="كود مركز التكلفة"
                         Value="@Model.Code"
                         ValueExpression="@(() => Model.Code)"
                         ValueChanged="OnCodeChanged"
                         Required="true"
                         Placeholder="مثال: CC-100"
                         ReadOnly="@(!IsNew)"
                         Disabled="@(!IsEditable || !IsNew)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم مركز التكلفة (بالعربي)"
                         Value="@Model.NameAr"
                         ValueExpression="@(() => Model.NameAr)"
                         ValueChanged="OnNameArChanged"
                         Required="true"
                         Placeholder="مثال: الإدارة العامة / فرع صنعاء"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiInputText Label="اسم مركز التكلفة (بالإنجليزي)"
                         Value="@Model.NameEn"
                         ValueExpression="@(() => Model.NameEn)"
                         ValueChanged="OnNameEnChanged"
                         Placeholder="مثال: General Management"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiLookup Label="مركز التكلفة الأب"
                      Value='@Model.ParentCostCenterId?.ToString("D")'
                      ValueChanged="OnParentCostCenterChanged"
                      SelectedItem="@ParentCostCenterLookupItem"
                      SearchAsync="CostCenterSearchAsync"
                      Placeholder="ابحث عن مركز التكلفة الأب..."
                      Disabled="@(!IsEditable)"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />

            <UiAccountingCheckGroup>
                <UiCheckbox Label="مركز التكلفة نشط"
                            Value="@Model.IsActive"
                            ValueChanged="OnActiveChanged"
                            Disabled="@(!IsEditable)" />
            </UiAccountingCheckGroup>

        </UiAccountingFormGrid>

    </UiAccountingFormSection>

</UiAccountingEditorSurface>

@code {

    public sealed class FormModel
    {
        public string Code { get; set; } = string.Empty;

        public string NameAr { get; set; } = string.Empty;

        public string? NameEn { get; set; }

        public Guid? ParentCostCenterId { get; set; }

        public bool IsActive { get; set; } = true;

        public string RowVersion { get; set; } = string.Empty;
    }

    [Parameter]
    public FormModel Model { get; set; } = new();

    [Parameter]
    public bool IsEditable { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public UiLookupItem? ParentCostCenterLookupItem { get; set; }

    [Parameter]
    public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CostCenterSearchAsync { get; set; }

    [Parameter]
    public EventCallback OnModelChanged { get; set; }


    private Task OnChanged()
    {
        return OnModelChanged.InvokeAsync();
    }


    private async Task OnCodeChanged(string? value)
    {
        Model.Code = value ?? string.Empty;
        await OnChanged();
    }


    private async Task OnNameArChanged(string? value)
    {
        Model.NameAr = value ?? string.Empty;
        await OnChanged();
    }


    private async Task OnNameEnChanged(string? value)
    {
        Model.NameEn = value;
        await OnChanged();
    }


    private async Task OnParentCostCenterChanged(string? value)
    {
        Model.ParentCostCenterId =
            Guid.TryParse(value, out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnActiveChanged(bool value)
    {
        Model.IsActive = value;
        await OnChanged();
    }
}