@namespace OAS.Client.Accounting.Components
@using OAS.UiLib.Components.Accounting.Workspace

<section class="oas-financial-directory" dir="rtl" aria-label="@(IsReceipt ? "سندات القبض" : "سندات الصرف")">
    <header class="oas-financial-directory__heading">
        <span>@TotalCount.ToString("N0") سند ضمن نتائج البحث والتصفية</span>
    </header>
    <div class="oas-financial-directory__filters">
        <label for="voucher-status-filter">الحالة</label>
        <select id="voucher-status-filter" value="@StatusFilter" @onchange="StatusChanged">
            <option value="">جميع الحالات</option>
            <option value="draft">مسودة</option>
            <option value="approved">معتمد</option>
            <option value="posted">مرحّل</option>
            <option value="cancelled">ملغي</option>
        </select>
        <span>يشمل المرشح جميع النتائج، وليس الصفحة الحالية فقط.</span>
    </div>
    <UiAccountingRecordList Items="@DocumentItems"
                            FinancialStyle="true"
                            EmptyTitle="لا توجد سندات مطابقة"
                            EmptyDescription="جرّب تغيير الحالة أو عبارة البحث."
                            OnOpen="OnOpen" />
    <footer class="oas-financial-directory__footnote">الصفحة @PageNumber من @Math.Max(1, TotalPages) · لا تُجمع العملات المختلفة في مبلغ واحد.</footer>
</section>

@code {
    public sealed record VoucherRow(Guid Id, string Number, DateOnly Date, string Party, string Description,
        string CurrencySummary, string AmountSummary, string BaseTotal, string StatusText, string StatusState, string StatusCode);

    [Parameter] public bool IsReceipt { get; set; }
    [Parameter] public string StatusFilter { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> StatusFilterChanged { get; set; }
    [Parameter] public IReadOnlyList<VoucherRow> Rows { get; set; } = [];
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public int PageNumber { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    private Task StatusChanged(ChangeEventArgs e) => StatusFilterChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private IReadOnlyList<UiAccountingRecordList.RecordItem> DocumentItems => Rows.Select(item =>
        new UiAccountingRecordList.RecordItem(
            item.Id,
            item.Number,
            item.Party,
            IsReceipt ? "fa-solid fa-arrow-down-to-bracket" : "fa-solid fa-arrow-up-from-bracket",
            [
                new("التاريخ", item.Date.ToString("yyyy/MM/dd")),
                new("الإجمالي الأساسي", item.BaseTotal)
            ],
            item.StatusText,
            item.StatusState,
            item.AmountSummary,
            "مبلغ السند حسب العملة",
            item.Description is "—" or "" ? null : item.Description)).ToArray();
}
