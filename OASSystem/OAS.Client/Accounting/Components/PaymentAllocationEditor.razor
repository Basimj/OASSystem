@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.PaymentAllocations
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<UiAccountingEditorSurface>
    <UiAccountingFormSection Title="سطر السداد المصدر"
                             Subtitle="يتم التخصيص من سطر قبض أو صرف فعلي، وليس من رأس السند."
                             IconCssClass="fa-solid fa-money-check-dollar">
        <UiAccountingFormGrid Columns="2">
            <UiSelect Label="نوع المصدر"
                      Value="@Model.PaymentSourceType.ToString()"
                      ValueChanged="OnSourceTypeChanged"
                      Options="@SourceTypeOptions"
                      Disabled="@(!IsEditable || !IsNew)"
                      Size="ControlSize.Small" />

            <UiLookup Label="سطر السداد"
                      Value='@Model.SourceLineId?.ToString("D")'
                      ValueChanged="OnSourceLineChanged"
                      SelectedItem="@SourceLookupItem"
                      SearchAsync="SourceSearchAsync"
                      Placeholder="ابحث برقم السند أو الطرف..."
                      Disabled="@(!IsEditable || !IsNew)"
                      Required="true"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />
        </UiAccountingFormGrid>

        @if (!string.IsNullOrWhiteSpace(Model.CurrencyCodeSnapshot))
        {
            <UiAccountingReadOnlyValue Label="عملة سطر السداد"
                                       Value="@Model.CurrencyCodeSnapshot"
                                       Tone="@UiAccountingReadOnlyValue.ValueTone.Primary" />
        }
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="المستند الهدف المراد تسويته"
                             Subtitle="سيتم ربط الفواتير الفعلية من موديولات المبيعات والمشتريات لاحقاً؛ المعرّف يبقى داخلياً في المرحلة الحالية."
                             IconCssClass="fa-solid fa-file-invoice">
        <UiAccountingFormGrid Columns="2">
            <UiSelect Label="نوع المستند الهدف"
                      Value="@Model.TargetDocumentType.ToString()"
                      ValueChanged="OnTargetTypeChanged"
                      Options="@AccountingArabicPresenter.AllocationTargetDocumentTypeOptions"
                      Disabled="@(!IsEditable || !IsNew)"
                      Size="ControlSize.Small" />

            @if (TargetSearchAsync is not null)
            {
                <UiLookup Label="المستند المستهدف"
                          Value='@Model.TargetDocumentId?.ToString("D")'
                          ValueChanged="OnTargetIdChanged"
                          SelectedItem="@TargetLookupItem"
                          SearchAsync="TargetSearchAsync"
                          Placeholder="ابحث عن المستند..."
                          Disabled="@(!IsEditable || !IsNew)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />
            }
            else
            {
                <UiInputText Label="معرف المستند المستهدف"
                             Value="@Model.TargetDocumentIdText"
                             ValueChanged="OnTargetIdTextChanged"
                             Placeholder="سيتم استبداله باختيار الفاتورة عند تنفيذ الفواتير"
                             Disabled="@(!IsEditable || !IsNew)"
                             Required="true"
                             Size="ControlSize.Small" />
            }
        </UiAccountingFormGrid>
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="مبلغ التخصيص"
                             Subtitle="المبلغ بعملة سطر السداد؛ المبلغ الأساسي يحسبه السيرفر."
                             IconCssClass="fa-solid fa-receipt">
        <UiAccountingFormGrid Columns="2">
            <UiAccountingNumberField Label="المبلغ المخصص"
                                     Value="@Model.AllocatedAmount"
                                     ValueChanged="OnAllocatedAmountChanged"
                                     Min="0.0001"
                                     Tone="@UiAccountingNumberField.NumberTone.Primary"
                                     Disabled="@(!IsEditable)" />

            @if (!IsNew)
            {
                <UiAccountingReadOnlyValue Label="المبلغ الأساسي"
                                           Value="@(Model.BaseAllocatedAmount?.ToString("N4") ?? "-")"
                                           Tone="@UiAccountingReadOnlyValue.ValueTone.Default" />
            }
        </UiAccountingFormGrid>
    </UiAccountingFormSection>
</UiAccountingEditorSurface>

@code {
    public sealed class FormModel
    {
        public PaymentSourceType PaymentSourceType { get; set; } = PaymentSourceType.ReceiptVoucher;
        public Guid? ReceiptVoucherLineId { get; set; }
        public Guid? PaymentVoucherLineId { get; set; }
        public Guid? SourceLineId
        {
            get => PaymentSourceType == PaymentSourceType.ReceiptVoucher ? ReceiptVoucherLineId : PaymentVoucherLineId;
            set
            {
                if (PaymentSourceType == PaymentSourceType.ReceiptVoucher) { ReceiptVoucherLineId = value; PaymentVoucherLineId = null; }
                else { PaymentVoucherLineId = value; ReceiptVoucherLineId = null; }
            }
        }
        public AllocationTargetDocumentType TargetDocumentType { get; set; } = AllocationTargetDocumentType.SalesInvoice;
        public Guid? TargetDocumentId { get; set; }
        public string TargetDocumentIdText { get => TargetDocumentId?.ToString("D") ?? string.Empty; set => TargetDocumentId = Guid.TryParse(value, out var id) ? id : null; }
        public Guid? CurrencyId { get; set; }
        public string? CurrencyCodeSnapshot { get; set; }
        public decimal AllocatedAmount { get; set; }
        public decimal? ExchangeRate { get; set; }
        public decimal? BaseAllocatedAmount { get; set; }
        public DateTimeOffset AllocatedAtUtc { get; set; } = DateTimeOffset.UtcNow;
    }

    private static readonly IReadOnlyList<UiSelectOption> SourceTypeOptions =
    [
        new(PaymentSourceType.ReceiptVoucher.ToString(), "سند قبض"),
        new(PaymentSourceType.PaymentVoucher.ToString(), "سند صرف")
    ];

    [Parameter] public FormModel Model { get; set; } = new();
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public UiLookupItem? SourceLookupItem { get; set; }
    [Parameter] public UiLookupItem? TargetLookupItem { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SourceSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? TargetSearchAsync { get; set; }
    [Parameter] public EventCallback OnModelChanged { get; set; }

    private Task ChangedAsync() => OnModelChanged.InvokeAsync();

    private async Task OnSourceTypeChanged(string val)
    {
        if (Enum.TryParse<PaymentSourceType>(val, out var value))
        {
            Model.PaymentSourceType = value;
            Model.ReceiptVoucherLineId = null;
            Model.PaymentVoucherLineId = null;
            Model.CurrencyId = null;
            Model.CurrencyCodeSnapshot = null;
            Model.BaseAllocatedAmount = null;
            await ChangedAsync();
        }
    }

    private async Task OnSourceLineChanged(string? value)
    {
        Model.SourceLineId = Guid.TryParse(value, out var id) ? id : null;
        await ChangedAsync();
    }

    private async Task OnTargetTypeChanged(string value)
    {
        if (Enum.TryParse<AllocationTargetDocumentType>(value, out var parsed)) Model.TargetDocumentType = parsed;
        await ChangedAsync();
    }

    private async Task OnTargetIdChanged(string? value) { Model.TargetDocumentId = Guid.TryParse(value, out var id) ? id : null; await ChangedAsync(); }
    private async Task OnTargetIdTextChanged(string? value) { Model.TargetDocumentIdText = value ?? string.Empty; await ChangedAsync(); }
    private async Task OnAllocatedAmountChanged(decimal value) { Model.AllocatedAmount = value; await ChangedAsync(); }
}
