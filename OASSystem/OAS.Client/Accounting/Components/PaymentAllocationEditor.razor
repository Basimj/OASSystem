@namespace OAS.Client.Accounting.Components
@using OAS.Client.Accounting.Services
@using OAS.Client.Purchasing.Services
@using OAS.Client.Sales.Services
@using OAS.Contracts.Accounting.Enums
@using OAS.Contracts.Accounting.PaymentAllocations
@using OAS.Contracts.Accounting.ReceiptVouchers
@using OAS.Contracts.Accounting.PaymentVouchers
@using OAS.Contracts.Purchasing.SupplierAllocations
@using OAS.Contracts.Sales.Enums
@using OAS.Contracts.Common.Pagination
@inject IAccountingClientService Accounting
@inject IPurchasingClientService Purchasing
@inject ISalesClientService Sales

<div class="oas-allocation" dir="rtl">
    <div class="oas-allocation__heading">
        <div>
            <p class="oas-allocation__breadcrumb">المحاسبة / @(IsReceipt ? "سندات القبض" : "سندات الصرف") / تخصيص دفعة</p>
            <h2><i class="fa-solid fa-link" aria-hidden="true"></i> @(IsReceipt ? "تخصيص مبلغ قبض" : "تخصيص مبلغ صرف")</h2>
            <p>ربط مبلغ من سطر سند مرحّل بفواتير @(IsReceipt ? "العميل" : "المورد") المفتوحة، مع متابعة المتاح قبل الحفظ.</p>
        </div>
        <span class="oas-allocation__tag">@(IsReceipt ? "سند قبض" : "سند صرف")</span>
    </div>

    @if (!IsNew)
    {
        <section class="oas-allocation__card">
            <h3>تفاصيل التخصيص المسجل</h3>
            <div class="oas-allocation__metrics">
                <div><small>المبلغ المخصص</small><strong>@Amount(Model.AllocatedAmount) @Model.CurrencyCodeSnapshot</strong></div>
                <div><small>المبلغ الأساسي</small><strong>@Amount(Model.BaseAllocatedAmount ?? 0m)</strong></div>
                <div><small>الحالة</small><strong>@(Model.IsReversed ? "معكوس" : "نشط")</strong></div>
            </div>
            <p class="oas-allocation__hint">المبالغ المسجلة على الفواتير لا تعدَّل مباشرة بعد الحفظ. لتصحيحها، اعكس التخصيص ثم أنشئ تخصيصًا جديدًا.</p>
            @if (Model.IsReversed)
            {
                <p class="oas-allocation__hint">الحالة: معكوس. السبب المسجل: @Model.ReversalReason</p>
            }
            else
            {
                <div class="oas-allocation__reverse">
                    <label>تاريخ العكس <input type="date" class="oas-allocation__input" value="@_reverseDateText" @onchange="HandleReverseDateChange" /></label>
                    <label>سبب العكس (إلزامي) <input class="oas-allocation__input" @bind="_reverseReason" placeholder="سبب تصحيح التخصيص..." /></label>
                    <button type="button" class="oas-allocation__btn is-danger" disabled="@(_busy || string.IsNullOrWhiteSpace(_reverseReason))" @onclick="ReverseAsync">عكس التخصيص</button>
                </div>
            }
        </section>
    }
    else
    {
        <section class="oas-allocation__card oas-allocation__source">
            <div class="oas-allocation__section-title">
                <h3><i class="fa-solid fa-file-invoice" aria-hidden="true"></i> بيانات السند</h3>
                @if (_voucherId.HasValue)
                {
                    <span class="oas-allocation__tag is-posted">مرحّل</span>
                }
            </div>
            <div class="oas-allocation__lookup-row">
                <UiLookup Label="السند المرحّل"
                          Value="@(_voucherId?.ToString("D"))"
                          SelectedItem="@VoucherLookupItem"
                          SearchAsync="SearchVoucherOptionsAsync"
                          ValueChanged="OnVoucherLookupChangedAsync"
                          Placeholder="افتح القائمة أو اكتب رقم السند أو بيانه..."
                          EmptyText="لا توجد سندات مرحلة مطابقة؛ جرّب رقمًا أدق."
                          ClearText="إلغاء تحديد السند"
                          Disabled="@_busy" />
                <span class="oas-allocation__hint">تظهر السندات المرحلة فقط. لا تحتاج لكتابة رقم أو معرف السند كاملًا.</span>
            </div>
            @if (_voucherId.HasValue)
            {
                <div class="oas-allocation__metrics">
                    <div><small>رقم السند</small><strong>@_voucherNumber</strong></div>
                    <div><small>التاريخ</small><strong>@_voucherDate.ToString("yyyy/MM/dd")</strong></div>
                    <div><small>الطرف</small><strong>@(_partyName ?? "يُحدد حسب السطر")</strong></div>
                    <div><small>النوع</small><strong>@(IsReceipt ? "قبض" : "صرف")</strong></div>
                </div>
            }
        </section>

        @if (_voucherId.HasValue)
        {
            <div class="oas-allocation__columns">
                <section class="oas-allocation__card">
                    <div class="oas-allocation__section-title"><h3><i class="fa-solid fa-layer-group" aria-hidden="true"></i> أسطر السند</h3></div>
                    <p class="oas-allocation__hint">اختر طريقة السداد من القائمة، أو اختر السطر من الجدول. إذا كان السند بسطر مؤهل واحد يختاره النظام تلقائيًا.</p>
                    <div class="oas-allocation__lookup-row">
                        <UiLookup Label="سطر القبض / الصرف"
                                  Value="@(_selectedLineId?.ToString("D"))"
                                  SelectedItem="@SourceLineLookupItem"
                                  SearchAsync="SearchSourceLinesAsync"
                                  ValueChanged="OnSourceLineLookupChangedAsync"
                                  Placeholder="ابحث بطريقة الدفع أو العملة أو الطرف..."
                                  EmptyText="لا توجد أسطر مؤهلة للتخصيص."
                                  Disabled="@(_busy || _loadingInvoices)" />
                    </div>
                    <div class="oas-allocation__table-wrap">
                        <table class="oas-allocation__table">
                            <thead><tr><th>اختيار</th><th>طريقة الدفع</th><th>العملة</th><th>المبلغ</th><th>المخصص</th><th>المتاح</th></tr></thead>
                            <tbody>
                                @foreach (var line in _sourceLines)
                                {
                                    <tr class="@(line.Id == _selectedLineId ? "is-selected" : "")">
                                        <td><button type="button" class="oas-allocation__choose" disabled="@(_busy || line.CurrencyId is null || line.ExchangeRate <= 0m || line.PartyId is null)" @onclick="() => SelectLineAsync(line)">@(line.Id == _selectedLineId ? "✓" : "اختيار")</button></td>
                                        <td>@line.Method</td><td>@line.Currency</td><td>@Amount(line.Amount)</td><td>@Amount(line.Applied)</td><td><strong>@Amount(line.Available)</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
                <section class="oas-allocation__card oas-allocation__summary">
                    <div class="oas-allocation__section-title"><h3><i class="fa-solid fa-chart-pie" aria-hidden="true"></i> ملخص التخصيص</h3></div>
                    <div class="oas-allocation__summary-row"><span>قيمة سطر السداد</span><strong>@Amount(SelectedLine?.Amount ?? 0m) @SelectedLine?.Currency</strong></div>
                    <div class="oas-allocation__summary-row"><span>المخصص سابقًا</span><strong>@Amount(SelectedLine?.Applied ?? 0m) @SelectedLine?.Currency</strong></div>
                    <div class="oas-allocation__summary-row is-available"><span>المتاح للتخصيص</span><strong>@Amount(SelectedLine?.Available ?? 0m) @SelectedLine?.Currency</strong></div>
                    <div class="oas-allocation__summary-row"><span>المحدد الآن</span><strong>@Amount(PendingTotal) @SelectedLine?.Currency</strong></div>
                    <div class="oas-allocation__summary-row"><span>المتبقي بعد الحفظ</span><strong>@Amount((SelectedLine?.Available ?? 0m) - PendingTotal) @SelectedLine?.Currency</strong></div>
                </section>
            </div>
        }

        @if (_selectedLineId.HasValue)
        {
            <section class="oas-allocation__card">
                <div class="oas-allocation__section-title">
                    <h3><i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i> فواتير @(IsReceipt ? "العميل" : "المورد") المفتوحة (@_invoiceRows.Count)</h3>
                </div>
                <div class="oas-allocation__lookup-row oas-allocation__invoice-lookup">
                    <UiLookup Label="البحث واختيار فاتورة للتخصيص"
                              Value="@_invoiceLookupValue"
                              SelectedItem="@InvoiceLookupItem"
                              ValueChanged="OnInvoiceLookupChangedAsync"
                              SearchAsync="SearchInvoiceOptionsAsync"
                              Placeholder="اختر فاتورة، أو ابحث بالرقم..."
                              EmptyText="لم تُعثر على فاتورة مفتوحة مطابقة لهذا الطرف."
                              Disabled="@(_busy || _loadingInvoices)" />
                    <span class="oas-allocation__hint">عند الاختيار يُقترح مبلغ التخصيص تلقائيًا، ويمكن تعديله في الجدول للسداد الجزئي.</span>
                </div>
                @if (_loadingInvoices)
                {
                    <p class="oas-allocation__hint">جاري تحميل الفواتير والأرصدة الفعلية...</p>
                }
                else if (_invoiceRows.Count == 0)
                {
                    <p class="oas-allocation__empty">لا توجد فواتير مرحلة بأرصدة مفتوحة لهذا الطرف، أو تعذر استرجاعها.</p>
                }
                else
                {
                    <div class="oas-allocation__table-wrap">
                        <table class="oas-allocation__table">
                            <thead><tr><th>اختيار</th><th>الفاتورة</th><th>التاريخ</th><th>العملة</th><th>الإجمالي</th><th>المسوّى سابقًا</th><th>المتبقي</th><th>تخصيص من السند</th></tr></thead>
                            <tbody>
                                @foreach (var invoice in FilteredInvoices)
                                {
                                    <tr class="@(invoice.Amount > 0 ? "is-selected" : "")">
                                        <td><input type="checkbox" checked="@(invoice.Amount > 0)" disabled="@(_busy || invoice.Saved || invoice.RequestKey is not null)" @onchange="e => ToggleInvoice(invoice, e.Value is true)" aria-label="تخصيص الفاتورة @invoice.Code" /></td>
                                        <td><strong>@invoice.Code</strong>@if (invoice.Saved) { <span class="oas-allocation__tag is-posted">تم الحفظ</span> }</td>
                                        <td>@invoice.Date.ToString("yyyy/MM/dd")</td><td>@invoice.Currency</td><td>@Amount(invoice.Total)</td><td>@Amount(invoice.Paid)</td><td><strong>@Amount(invoice.Outstanding)</strong></td>
                                        <td><input type="number" min="0" step="0.0001" class="oas-allocation__input oas-allocation__amount" disabled="@(_busy || invoice.Saved || invoice.RequestKey is not null)" title="الحد الأعلى المتاح من هذه الفاتورة بعملة السند: @Amount(invoice.MaxSourceAmount)" value="@invoice.Amount" @onchange="e => ChangeInvoiceAmount(invoice, e.Value?.ToString())" aria-label="مبلغ التخصيص للفاتورة @invoice.Code بعملة سطر السند" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="oas-allocation__hint">تُدخل مبالغ التخصيص بعملة <strong>@SelectedLine?.Currency</strong>؛ وعند اختلاف عملة الفاتورة، يُعرض الحد التقريبي بناءً على أسعار الصرف. يعيد الخادم التحقق من المتاح والفروق عند الحفظ.</p>
                }
            </section>
            <section class="oas-allocation__bottom">
                <div class="oas-allocation__card">
                    <h3>حالة التخصيص</h3>
                    <div class="oas-allocation__progress"><span style="width: @ProgressPercent%"></span></div>
                    <p>@ProgressPercent.ToString("N1")% من المتاح المحدد</p>
                </div>
                <div class="oas-allocation__card">
                    <h3>مراجعة المبلغ</h3>
                    <div class="oas-allocation__summary-row"><span>إجمالي المحدد</span><strong>@Amount(PendingTotal) @SelectedLine?.Currency</strong></div>
                    <div class="oas-allocation__summary-row"><span>الباقي غير المخصص</span><strong>@Amount((SelectedLine?.Available ?? 0m) - PendingTotal) @SelectedLine?.Currency</strong></div>
                </div>
            </section>
            <div class="oas-allocation__footer">
                <span>كل فاتورة تحفظ كتخصيص مستقل مرتبط بسطر السند؛ لا يُعتبر الحفظ الجماعي معاملة واحدة.</span>
                <button type="button" class="oas-allocation__btn is-secondary" disabled="@_busy" @onclick="() => _showHistory = !_showHistory">@(_showHistory ? "إخفاء التخصيصات" : "عرض التخصيصات الحالية")</button>
                <button type="button" class="oas-allocation__btn is-secondary" disabled="@(_busy || PendingTotal <= 0m)" @onclick="ClearDraftAmountsAsync">إلغاء المبالغ المحددة</button>
                <button type="button" class="oas-allocation__btn is-secondary" disabled="@_busy" @onclick="ReloadSelectedAsync">تحديث الأرصدة</button>
                <button type="button" class="oas-allocation__btn is-primary" disabled="@(_busy || _loadingInvoices || PendingTotal <= 0 || SelectedLine is null || PendingTotal > SelectedLine.Available || _invoiceRows.Any(x => !x.Saved && x.Amount > x.MaxSourceAmount))" @onclick="SaveAllocationsAsync">@(_busy ? "جاري الحفظ..." : "حفظ التخصيصات المحددة")</button>
            </div>
            @if (_showHistory)
            {
                <section class="oas-allocation__card">
                    <h3>تخصيصات سطر السند المسجلة</h3>
                    @if (_selectedAllocations.Count == 0)
                    {
                        <p class="oas-allocation__empty">لا توجد تخصيصات سابقة لهذا السطر.</p>
                    }
                    else
                    {
                        <div class="oas-allocation__table-wrap">
                            <table class="oas-allocation__table">
                                <thead><tr><th>تاريخ التخصيص</th><th>المبلغ</th><th>العملة</th><th>الحالة</th><th>إجراء</th></tr></thead>
                                <tbody>
                                    @foreach (var allocation in _selectedAllocations)
                                    {
                                        <tr>
                                            <td>@allocation.AllocatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd")</td>
                                            <td>@Amount(allocation.AllocatedAmount)</td>
                                            <td>@allocation.CurrencyCodeSnapshot</td>
                                            <td>@(allocation.IsReversed ? "معكوس" : "نشط")</td>
                                            <td><button class="oas-allocation__choose" type="button" disabled="@_busy" @onclick="() => OpenAllocationAsync(allocation.Id)">تفاصيل / عكس</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        }
    }
</div>
