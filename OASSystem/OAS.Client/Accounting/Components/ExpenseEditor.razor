@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.Expenses
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<div class="ui-acc-editor" dir="rtl">

    <UiAccountingFormSection Title="بيانات سند المصروف"
                             Subtitle="الرقم، التاريخ، ونوع وبند المصروف والمستفيد"
                             IconCssClass="fa-solid fa-receipt">

        <div class="ui-acc-form-grid ui-acc-form-grid--3col">

            <UiInputText Label="رقم سند المصروف"
                         Value="@Model.ExpenseNumber"
                         ValueExpression="@(() => Model.ExpenseNumber)"
                         ReadOnly="true"
                         Disabled="true"
                         Placeholder="توليد تلقائي..."
                         Size="ControlSize.Small" />

            <UiInputDate Label="تاريخ المصروف"
                         Value="@Model.ExpenseDateInput"
                         ValueExpression="@(() => Model.ExpenseDateInput)"
                         ValueChanged="OnExpenseDateChanged"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <UiLookup Label="نوع / بند المصروف"
                      Value="@Model.ExpenseTypeId?.ToString("D")"
                      ValueChanged="OnExpenseTypeChanged"
                      SelectedItem="@ExpenseTypeLookupItem"
                      SearchAsync="ExpenseTypeSearchAsync"
                      Placeholder="اختر بند المصروف..."
                      Disabled="@(!IsEditable)"
                      Required="true"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />

        </div>

        <div class="ui-acc-form-grid ui-acc-form-grid--2col mt-3">

            <UiLookup Label="حساب المصروف التفصيلي في الدليل"
                      Value="@Model.ExpenseAccountId?.ToString("D")"
                      ValueChanged="OnExpenseAccountChanged"
                      SelectedItem="@ExpenseAccountLookupItem"
                      SearchAsync="AccountSearchAsync"
                      Placeholder="ابحث عن حساب المصروف في الدليل..."
                      Disabled="@(!IsEditable)"
                      Required="true"
                      MinimumSearchLength="0"
                      DebounceMilliseconds="250" />

            <UiInputText Label="المستفيد / الجهة الصادر إليها"
                         Value="@Model.Beneficiary"
                         ValueExpression="@(() => Model.Beneficiary)"
                         ValueChanged="OnBeneficiaryChanged"
                         Disabled="@(!IsEditable)"
                         Placeholder="اسم الشخص أو المورد أو الجهة المستفيدة..."
                         Size="ControlSize.Small" />

        </div>

        <div class="mt-3">

            <UiInputText Label="بيان وتفاصيل المصروف"
                         Value="@Model.Description"
                         ValueExpression="@(() => Model.Description)"
                         ValueChanged="OnDescriptionChanged"
                         Disabled="@(!IsEditable)"
                         Placeholder="شرح وافٍ عن سبب النفقة..." />

        </div>

    </UiAccountingFormSection>


    <UiAccountingFormSection Title="المبلغ وطريقة السداد"
                             Subtitle="مبلغ النفقة وطريقة الدفع (صندوق أو بنك)"
                             IconCssClass="fa-solid fa-coins">

        <div class="ui-acc-form-grid ui-acc-form-grid--3col">

            <div>
                <label class="ui-input-text__label mb-1 d-block">
                    مبلغ المصروف
                </label>

                <input type="number"
                       step="0.01"
                       min="0.01"
                       class="ui-input-text__field text-start font-bold fs-5 text-danger"
                       value="@Model.Amount"
                       disabled="@(!IsEditable)"
                       @onchange="OnAmountChanged" />
            </div>


            <UiSelect Label="طريقة الدفع"
                      Value="@Model.PaymentMethodValue"
                      ValueExpression="@(() => Model.PaymentMethodValue)"
                      ValueChanged="OnPaymentMethodChanged"
                      Options="@AccountingArabicPresenter.PaymentMethodOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />


            @if (Model.PaymentMethod == PaymentMethod.Cash)
            {
                <UiLookup Label="الصندوق / الخزينة النقدية"
                          Value="@Model.CashAccountId?.ToString("D")"
                          ValueChanged="OnCashAccountChanged"
                          SelectedItem="@CashAccountLookupItem"
                          SearchAsync="CashAccountSearchAsync"
                          Placeholder="اختر الصندوق..."
                          Disabled="@(!IsEditable)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />
            }
            else
            {
                <UiLookup Label="الحساب البنكي"
                          Value="@Model.BankAccountId?.ToString("D")"
                          ValueChanged="OnBankAccountChanged"
                          SelectedItem="@BankAccountLookupItem"
                          SearchAsync="BankAccountSearchAsync"
                          Placeholder="اختر الحساب البنكي..."
                          Disabled="@(!IsEditable)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />
            }

        </div>

    </UiAccountingFormSection>

</div>


@code {

    public sealed class FormModel
    {
        public string ExpenseNumber { get; set; } = string.Empty;


        /*
         * المجال Domain/Contract يحتاج DateOnly.
         *
         * UiInputDate يستخدم DateOnly? لأنه InputBase<DateOnly?>.
         * لذلك نستخدم خاصية UI وسيطة بدون تغيير ExpenseDate الأصلية.
         */
        public DateOnly ExpenseDate { get; set; }
            = DateOnly.FromDateTime(DateTime.Today);


        public DateOnly? ExpenseDateInput
        {
            get => ExpenseDate;

            set
            {
                if (value.HasValue)
                {
                    ExpenseDate = value.Value;
                }
            }
        }


        public Guid? ExpenseTypeId { get; set; }

        public Guid? ExpenseAccountId { get; set; }

        public string? Beneficiary { get; set; }

        public decimal Amount { get; set; }


        public PaymentMethod PaymentMethod { get; set; }
            = PaymentMethod.Cash;


        /*
         * UiSelect يعمل على string.
         * لا نستخدم:
         *
         * ValueExpression="@(() => Model.PaymentMethod.ToString())"
         *
         * لأن Blazor لا يقبل MethodCallExpression هنا.
         */
        public string PaymentMethodValue
        {
            get => PaymentMethod.ToString();

            set
            {
                if (Enum.TryParse<PaymentMethod>(
                        value,
                        out var result))
                {
                    PaymentMethod = result;
                }
            }
        }


        public Guid? CashAccountId { get; set; }

        public Guid? BankAccountId { get; set; }

        public string? Description { get; set; }

        public ExpenseStatus Status { get; set; }
            = ExpenseStatus.Draft;
    }


    [Parameter]
    public FormModel Model { get; set; } = new();


    [Parameter]
    public bool IsEditable { get; set; }


    [Parameter]
    public bool IsNew { get; set; }


    [Parameter]
    public UiLookupItem? ExpenseTypeLookupItem { get; set; }


    [Parameter]
    public UiLookupItem? ExpenseAccountLookupItem { get; set; }


    [Parameter]
    public UiLookupItem? CashAccountLookupItem { get; set; }


    [Parameter]
    public UiLookupItem? BankAccountLookupItem { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        ExpenseTypeSearchAsync
    { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        AccountSearchAsync
    { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        CashAccountSearchAsync
    { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        BankAccountSearchAsync
    { get; set; }


    [Parameter]
    public EventCallback OnModelChanged { get; set; }


    private Task OnChanged()
        => OnModelChanged.InvokeAsync();


    private async Task OnExpenseDateChanged(
        DateOnly? value)
    {
        if (value.HasValue)
        {
            Model.ExpenseDate = value.Value;
        }

        await OnChanged();
    }


    private async Task OnBeneficiaryChanged(
        string? value)
    {
        Model.Beneficiary = value;

        await OnChanged();
    }


    private async Task OnDescriptionChanged(
        string? value)
    {
        Model.Description = value;

        await OnChanged();
    }


    private async Task OnAmountChanged(
        ChangeEventArgs e)
    {
        if (decimal.TryParse(
                e.Value?.ToString(),
                out var amount))
        {
            Model.Amount = amount;

            await OnChanged();
        }
    }


    private async Task OnPaymentMethodChanged(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }


        if (!Enum.TryParse<PaymentMethod>(
                value,
                out var paymentMethod))
        {
            return;
        }


        Model.PaymentMethod = paymentMethod;


        /*
         * إذا تغيرت طريقة الدفع،
         * لا نحتفظ بالحساب الخاص بالطريقة السابقة.
         */
        if (paymentMethod == PaymentMethod.Cash)
        {
            Model.BankAccountId = null;
        }
        else
        {
            Model.CashAccountId = null;
        }


        await OnChanged();
    }


    private async Task OnExpenseTypeChanged(
        string? value)
    {
        Model.ExpenseTypeId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnExpenseAccountChanged(
        string? value)
    {
        Model.ExpenseAccountId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnCashAccountChanged(
        string? value)
    {
        Model.CashAccountId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnBankAccountChanged(
        string? value)
    {
        Model.BankAccountId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }
}