@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.PaymentVouchers
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<div class="ui-acc-editor" dir="rtl">

    <UiAccountingFormSection Title="بيانات سند الصرف الأساسية"
                             Subtitle="رقم السند، التاريخ، والمبلغ المدفوع"
                             IconCssClass="fa-solid fa-money-bill-transfer">

        <div class="ui-acc-form-grid ui-acc-form-grid--3col">

            <UiInputText Label="رقم السند"
                         Value="@Model.VoucherNumber"
                         ValueExpression="@(() => Model.VoucherNumber)"
                         ReadOnly="true"
                         Disabled="true"
                         Placeholder="توليد تلقائي..."
                         Size="ControlSize.Small" />

            <UiInputDate Label="تاريخ السند"
                         Value="@Model.VoucherDateInput"
                         ValueExpression="@(() => Model.VoucherDateInput)"
                         ValueChanged="OnVoucherDateChanged"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <div>
                <label class="ui-input-text__label mb-1 d-block">
                    المبلغ المدفوع
                </label>

                <input type="number"
                       step="0.01"
                       min="0.01"
                       class="ui-input-text__field text-start font-bold fs-5 text-danger"
                       value="@Model.TotalAmount"
                       disabled="@(!IsEditable)"
                       @onchange="OnTotalAmountChanged" />
            </div>

        </div>

    </UiAccountingFormSection>


    <UiAccountingFormSection Title="الجهة المستفيدة (الطرف الثاني)"
                             Subtitle="مورد، موظف، أو جهة أخرى"
                             IconCssClass="fa-solid fa-user-tag">

        <div class="ui-acc-form-grid ui-acc-form-grid--2col">

            <UiSelect Label="نوع المستفيد"
                      Value="@Model.PartyTypeValue"
                      ValueExpression="@(() => Model.PartyTypeValue)"
                      ValueChanged="OnPartyTypeChanged"
                      Options="@AccountingArabicPresenter.PaymentPartyTypeOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            @if (Model.PartyType == PaymentPartyType.Supplier)
            {
                <UiLookup Label="المورد"
                          Value="@Model.SupplierId?.ToString("D")"
                          ValueChanged="OnSupplierChanged"
                          SelectedItem="@SupplierLookupItem"
                          SearchAsync="SupplierSearchAsync"
                          Placeholder="ابحث باسم أو كود المورد..."
                          Disabled="@(!IsEditable)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />
            }
            else
            {
                <UiInputText Label="اسم المستفيد"
                             Value="@Model.BeneficiaryName"
                             ValueExpression="@(() => Model.BeneficiaryName)"
                             ValueChanged="OnBeneficiaryNameChanged"
                             Required="true"
                             Disabled="@(!IsEditable)"
                             Placeholder="اكتب اسم الشخص أو المستفيد..."
                             Size="ControlSize.Small" />
            }

        </div>

    </UiAccountingFormSection>


    <UiAccountingFormSection Title="طريقة الصرف وحساب الدفع"
                             Subtitle="نقداً عبر الصندوق أو تحويل/شيك عبر البنك"
                             IconCssClass="fa-solid fa-credit-card">

        <div class="ui-acc-form-grid ui-acc-form-grid--2col">

            <UiSelect Label="طريقة الدفع"
                      Value="@Model.PaymentMethodValue"
                      ValueExpression="@(() => Model.PaymentMethodValue)"
                      ValueChanged="OnPaymentMethodChanged"
                      Options="@AccountingArabicPresenter.PaymentMethodOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            @if (Model.PaymentMethod == PaymentMethod.Cash)
            {
                <UiLookup Label="الصندوق / الخزينة النقدية"
                          Value="@Model.CashAccountId?.ToString("D")"
                          ValueChanged="OnCashAccountChanged"
                          SelectedItem="@CashAccountLookupItem"
                          SearchAsync="CashAccountSearchAsync"
                          Placeholder="اختر الصندوق..."
                          Disabled="@(!IsEditable)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />
            }
            else
            {
                <UiLookup Label="الحساب البنكي"
                          Value="@Model.BankAccountId?.ToString("D")"
                          ValueChanged="OnBankAccountChanged"
                          SelectedItem="@BankAccountLookupItem"
                          SearchAsync="BankAccountSearchAsync"
                          Placeholder="اختر الحساب البنكي..."
                          Disabled="@(!IsEditable)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />
            }

        </div>

        <div class="mt-3">

            <UiInputText Label="البيان / الوصف"
                         Value="@Model.Description"
                         ValueExpression="@(() => Model.Description)"
                         ValueChanged="OnDescriptionChanged"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Placeholder="شرح سبب الصرف أو أرقام الفواتير والمطالبات..." />

        </div>

    </UiAccountingFormSection>

</div>


@code {

    public sealed class FormModel
    {
        public string VoucherNumber { get; set; } = string.Empty;


        public DateOnly VoucherDate { get; set; }
            = DateOnly.FromDateTime(DateTime.Today);


        public DateOnly? VoucherDateInput
        {
            get => VoucherDate;

            set
            {
                if (value.HasValue)
                {
                    VoucherDate = value.Value;
                }
            }
        }


        public PaymentPartyType PartyType { get; set; }
            = PaymentPartyType.Supplier;


        public string PartyTypeValue
        {
            get => PartyType.ToString();

            set
            {
                if (Enum.TryParse<PaymentPartyType>(
                        value,
                        out var result))
                {
                    PartyType = result;
                }
            }
        }


        public Guid? SupplierId { get; set; }


        public string? BeneficiaryName { get; set; }


        public Guid? CashAccountId { get; set; }


        public Guid? BankAccountId { get; set; }


        public PaymentMethod PaymentMethod { get; set; }
            = PaymentMethod.Cash;


        public string PaymentMethodValue
        {
            get => PaymentMethod.ToString();

            set
            {
                if (Enum.TryParse<PaymentMethod>(
                        value,
                        out var result))
                {
                    PaymentMethod = result;
                }
            }
        }


        public decimal TotalAmount { get; set; }


        public string Description { get; set; }
            = string.Empty;


        public PaymentVoucherStatus Status { get; set; }
            = PaymentVoucherStatus.Draft;
    }


    [Parameter]
    public FormModel Model { get; set; } = new();


    [Parameter]
    public bool IsEditable { get; set; }


    [Parameter]
    public bool IsNew { get; set; }


    [Parameter]
    public UiLookupItem? SupplierLookupItem { get; set; }


    [Parameter]
    public UiLookupItem? CashAccountLookupItem { get; set; }


    [Parameter]
    public UiLookupItem? BankAccountLookupItem { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        SupplierSearchAsync
    { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        CashAccountSearchAsync
    { get; set; }


    [Parameter]
    public Func<
        string,
        CancellationToken,
        Task<IReadOnlyList<UiLookupItem>>>?
        BankAccountSearchAsync
    { get; set; }


    [Parameter]
    public EventCallback OnModelChanged { get; set; }


    private Task OnChanged()
        => OnModelChanged.InvokeAsync();


    private async Task OnVoucherDateChanged(
        DateOnly? value)
    {
        if (value.HasValue)
        {
            Model.VoucherDate = value.Value;
        }

        await OnChanged();
    }


    private async Task OnTotalAmountChanged(
        ChangeEventArgs e)
    {
        if (decimal.TryParse(
                e.Value?.ToString(),
                out var amount))
        {
            Model.TotalAmount = amount;

            await OnChanged();
        }
    }


    private async Task OnPartyTypeChanged(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (!Enum.TryParse<PaymentPartyType>(
                value,
                out var result))
        {
            return;
        }

        Model.PartyType = result;

        if (result == PaymentPartyType.Supplier)
        {
            Model.BeneficiaryName = null;
        }
        else
        {
            Model.SupplierId = null;
        }

        await OnChanged();
    }


    private async Task OnPaymentMethodChanged(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (!Enum.TryParse<PaymentMethod>(
                value,
                out var result))
        {
            return;
        }

        Model.PaymentMethod = result;

        if (result == PaymentMethod.Cash)
        {
            Model.BankAccountId = null;
        }
        else
        {
            Model.CashAccountId = null;
        }

        await OnChanged();
    }


    private async Task OnSupplierChanged(
        string? value)
    {
        Model.SupplierId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnBeneficiaryNameChanged(
        string? value)
    {
        Model.BeneficiaryName = value;

        await OnChanged();
    }


    private async Task OnCashAccountChanged(
        string? value)
    {
        Model.CashAccountId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnBankAccountChanged(
        string? value)
    {
        Model.BankAccountId =
            Guid.TryParse(
                value,
                out var id)
                ? id
                : null;

        await OnChanged();
    }


    private async Task OnDescriptionChanged(
        string? value)
    {
        Model.Description = value ?? string.Empty;

        await OnChanged();
    }
}