@namespace OAS.Client.Accounting.Components
@using OAS.Contracts.Accounting.PaymentVouchers
@using OAS.Contracts.Accounting.Enums
@using OAS.Client.Accounting.Common
@using OAS.UiLib.Components.Accounting.Workspace
@using OAS.UiLib.Components.Inputs
@using OAS.UiLib.Core.Models

<div class="ui-acc-editor" dir="rtl">
    <UiAccountingFormSection Title="بيانات سند الصرف الأساسية"
                             Subtitle="رقم السند، التاريخ، والمبلغ المدفوع"
                             IconCssClass="fa-solid fa-money-bill-transfer">
        <div class="ui-acc-form-grid ui-acc-form-grid--3col">
            <UiInputText Label="رقم السند"
                         Value="@Model.VoucherNumber"
                         ReadOnly="true"
                         Disabled="true"
                         Placeholder="توليد تلقائي..."
                         Size="ControlSize.Small" />

            <UiInputDate Label="تاريخ السند"
                         Value="@Model.VoucherDate"
                         ValueChanged="@(v => { if (v.HasValue) { Model.VoucherDate = v.Value; OnChanged(); } })"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Size="ControlSize.Small" />

            <div>
                <label class="ui-input-text__label mb-1 d-block">المبلغ المدفوع</label>
                <input type="number" step="0.01" min="0.01"
                       class="ui-input-text__field text-start font-bold fs-5 text-danger"
                       value="@Model.TotalAmount"
                       disabled="@(!IsEditable)"
                       @onchange="@(e => { if (decimal.TryParse(e.Value?.ToString(), out var amt)) { Model.TotalAmount = amt; OnChanged(); } })" />
            </div>
        </div>
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="الجهة المستفيدة (الطرف الثاني)"
                             Subtitle="مورد، موظف، أو جهة أخرى"
                             IconCssClass="fa-solid fa-user-tag">
        <div class="ui-acc-form-grid ui-acc-form-grid--2col">
            <UiSelect Label="نوع المستفيد"
                      Value="@Model.PartyType.ToString()"
                      ValueChanged="OnPartyTypeChanged"
                      Options="@AccountingArabicPresenter.PaymentPartyTypeOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            @if (Model.PartyType == PaymentPartyType.Supplier)
            {
                <UiLookup Label="المورد"
                          Value="@Model.SupplierId?.ToString("D")"
                          ValueChanged="OnSupplierChanged"
                          SelectedItem="@SupplierLookupItem"
                          SearchAsync="SupplierSearchAsync"
                          Placeholder="ابحث باسم أو كود المورد..."
                          Disabled="@(!IsEditable)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />
            }
            else
            {
                <UiInputText Label="اسم المستفيد"
                             Value="@Model.BeneficiaryName"
                             ValueChanged="@(v => { Model.BeneficiaryName = v; OnChanged(); })"
                             Required="true"
                             Disabled="@(!IsEditable)"
                             Placeholder="اكتب اسم الشخص أو المستفيد..."
                             Size="ControlSize.Small" />
            }
        </div>
    </UiAccountingFormSection>

    <UiAccountingFormSection Title="طريقة الصرف وحساب الدفع"
                             Subtitle="نقداً عبر الصندوق أو تحويل/شيك عبر البنك"
                             IconCssClass="fa-solid fa-credit-card">
        <div class="ui-acc-form-grid ui-acc-form-grid--2col">
            <UiSelect Label="طريقة الدفع"
                      Value="@Model.PaymentMethod.ToString()"
                      ValueChanged="OnPaymentMethodChanged"
                      Options="@AccountingArabicPresenter.PaymentMethodOptions"
                      Disabled="@(!IsEditable)"
                      Size="ControlSize.Small" />

            @if (Model.PaymentMethod == PaymentMethod.Cash)
            {
                <UiLookup Label="الصندوق / الخزينة النقدية"
                          Value="@Model.CashAccountId?.ToString("D")"
                          ValueChanged="OnCashAccountChanged"
                          SelectedItem="@CashAccountLookupItem"
                          SearchAsync="CashAccountSearchAsync"
                          Placeholder="اختر الصندوق..."
                          Disabled="@(!IsEditable)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />
            }
            else
            {
                <UiLookup Label="الحساب البنكي"
                          Value="@Model.BankAccountId?.ToString("D")"
                          ValueChanged="OnBankAccountChanged"
                          SelectedItem="@BankAccountLookupItem"
                          SearchAsync="BankAccountSearchAsync"
                          Placeholder="اختر الحساب البنكي..."
                          Disabled="@(!IsEditable)"
                          Required="true"
                          MinimumSearchLength="0"
                          DebounceMilliseconds="250" />
            }
        </div>

        <div class="mt-3">
            <UiInputText Label="البيان / الوصف"
                         Value="@Model.Description"
                         ValueChanged="@(v => { Model.Description = v; OnChanged(); })"
                         Required="true"
                         Disabled="@(!IsEditable)"
                         Placeholder="شرح سبب الصرف أو أرقام الفواتير والمطالبات..." />
        </div>
    </UiAccountingFormSection>
</div>

@code {
    public sealed class FormModel
    {
        public string VoucherNumber { get; set; } = string.Empty;
        public DateOnly VoucherDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public PaymentPartyType PartyType { get; set; } = PaymentPartyType.Supplier;
        public Guid? SupplierId { get; set; }
        public string? BeneficiaryName { get; set; }
        public Guid? CashAccountId { get; set; }
        public Guid? BankAccountId { get; set; }
        public PaymentMethod PaymentMethod { get; set; } = PaymentMethod.Cash;
        public decimal TotalAmount { get; set; }
        public string Description { get; set; } = string.Empty;
        public PaymentVoucherStatus Status { get; set; } = PaymentVoucherStatus.Draft;
    }

    [Parameter] public FormModel Model { get; set; } = new();
    [Parameter] public bool IsEditable { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public UiLookupItem? SupplierLookupItem { get; set; }
    [Parameter] public UiLookupItem? CashAccountLookupItem { get; set; }
    [Parameter] public UiLookupItem? BankAccountLookupItem { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? SupplierSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? CashAccountSearchAsync { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<UiLookupItem>>>? BankAccountSearchAsync { get; set; }
    [Parameter] public EventCallback OnModelChanged { get; set; }

    private void OnChanged() => OnModelChanged.InvokeAsync();

    private void OnPartyTypeChanged(string val)
    {
        if (Enum.TryParse<PaymentPartyType>(val, out var res))
        {
            Model.PartyType = res;
            OnChanged();
        }
    }

    private void OnPaymentMethodChanged(string val)
    {
        if (Enum.TryParse<PaymentMethod>(val, out var res))
        {
            Model.PaymentMethod = res;
            OnChanged();
        }
    }

    private void OnSupplierChanged(string? val)
    {
        Model.SupplierId = Guid.TryParse(val, out var id) ? id : null;
        OnChanged();
    }

    private void OnCashAccountChanged(string? val)
    {
        Model.CashAccountId = Guid.TryParse(val, out var id) ? id : null;
        OnChanged();
    }

    private void OnBankAccountChanged(string? val)
    {
        Model.BankAccountId = Guid.TryParse(val, out var id) ? id : null;
        OnChanged();
    }
}
