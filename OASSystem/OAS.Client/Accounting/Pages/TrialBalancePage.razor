@page "/accounting/reports/trial-balance"
@attribute [Authorize]
@using OAS.Contracts.Accounting.Enums
@using OAS.UiLib.Components.Reports
<PageTitle>ميزان المراجعة | OAS</PageTitle>
<div class="trial-report @StatusClass">
<UiReportWorkspace Title="ميزان المراجعة" TitleIcon="fa-solid fa-scale-balanced" StatusText="@Status" StatusIcon="@StatusIcon" Search="@_search" SearchChanged="OnSearch" FiltersOpen="@_filtersOpen" FiltersOpenChanged="@(v => _filtersOpen = v)">
    <Toolbar>
        <button type="button" class="oas-report__tool" title="تحديث" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-rotate"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--pdf" title="طباعة أو حفظ PDF" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-regular fa-file-pdf"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--excel" title="تصدير Excel" disabled="@(!CanExport)" @onclick="ExportAsync"><i class="fa-regular fa-file-excel"></i></button>
        <button type="button" class="oas-report__tool" title="طباعة" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-solid fa-print"></i></button>
        @if (IsTree && !_busy && _error is null)
        {
            <button type="button" class="oas-report__tool" title="@(_collapsed ? "توسيع الشجرة" : "طي الشجرة")" @onclick="ToggleTree"><i class="fa-solid @(_collapsed ? "fa-angles-down" : "fa-angles-up")"></i></button>
        }
        <button type="button" class="oas-report__tool" title="إظهار أو إخفاء الفلاتر" @onclick="@(() => _filtersOpen = !_filtersOpen)"><i class="fa-solid fa-ellipsis-vertical"></i></button>
    </Toolbar>
    <QuickFilters>
        @foreach (var chip in Chips)
        {
            <div class="oas-report__chip" title="@($"{chip.Label}: {chip.Value}")"><span class="oas-report__chip-label">@chip.Label:</span><strong>@chip.Value</strong></div>
        }
    </QuickFilters>
    <FilterPanel>
        <div class="trial-fields">
            <label class="oas-report__field">السنة المالية<select value="@_draft.Year" @onchange="OnYear" disabled="@_busy"><option value="">نطاق مخصص</option>@foreach (var y in _years){<option value="@y.Id">@y.Name</option>}</select></label>
            <label class="oas-report__field">الفترة المالية<select value="@_draft.Period" @onchange="OnPeriod" disabled="@(_busy || string.IsNullOrEmpty(_draft.Year))"><option value="">جميع الفترات</option>@foreach (var p in PeriodOptions){<option value="@p.Id">@p.Name</option>}</select></label>
            <div class="oas-report__date-pair">
                <label class="oas-report__field">من تاريخ<input type="date" @bind="_draft.From" @bind:format="yyyy-MM-dd" disabled="@(_busy || !string.IsNullOrEmpty(_draft.Year))" /></label>
                <label class="oas-report__field">إلى تاريخ<input type="date" @bind="_draft.To" @bind:format="yyyy-MM-dd" disabled="@(_busy || !string.IsNullOrEmpty(_draft.Year))" /></label>
            </div>
            <div class="oas-report__field"><UiReportSearchPicker Label="الحساب" ItemLabel="حساب" DialogTitle="اختيار الحساب" SearchPlaceholder="ابحث باسم الحساب أو رقمه..." Value="@_draft.Account" ValueChanged="OnAccount" Options="@AccountOptions" Placeholder="جميع الحسابات" /></div>
            <label class="oas-report__field">تصنيف الحساب<select @bind="_draft.Class"><option value="0">جميع التصنيفات</option>@foreach (var c in Enum.GetValues<AccountClass>()){<option value="@((int)c)">@ClassName((int)c)</option>}</select></label>
            <label class="oas-report__field">مستوى الحساب<select @bind="_draft.Level" disabled="@(_draft.View == "roots")"><option value="0">جميع المستويات</option>@foreach (var level in Levels){<option value="@level">حتى المستوى @level</option>}</select></label>
            <label class="oas-report__field">نوع التقرير<select @bind="_draft.Mode"><option value="all">ميزان المراجعة الشامل</option><option value="balances">بالأرصدة</option><option value="gross">بالمجاميع</option><option value="movement">بالحركة</option></select></label>
            <label class="oas-report__field">طريقة العرض<select @bind="_draft.View"><option value="posting">حسابات الترحيل فقط</option><option value="tree">شجرة الحسابات</option><option value="roots">الحسابات الرئيسية</option></select></label>
            <label class="oas-report__field">العملة<select @bind="_draft.Currency"><option value="">@_baseName (الأساسية)</option>@foreach (var c in _currencies.Where(c => c.IsActive && c.Id != _baseId)){<option value="@c.Id">@c.NameAr (@c.Code)</option>}</select></label>
            <label class="oas-report__field">طبيعة الرصيد<select @bind="_draft.Balance"><option value="all">الكل</option><option value="debit">مدين</option><option value="credit">دائن</option><option value="zero">صفري</option></select></label>
            <label class="oas-report__field-check"><input type="checkbox" @bind="_draft.Children" disabled="@string.IsNullOrEmpty(_draft.Account)" /> تضمين الحسابات الفرعية</label>
            <label class="oas-report__field-check"><input type="checkbox" @bind="_draft.IncludeZero" /> إظهار الحسابات التي لا حركة ولا رصيد لها</label>
            <label class="oas-report__field-check"><input type="checkbox" @bind="_draft.HideClosingZero" disabled="@(_draft.Balance == "zero")" /> إخفاء الحسابات ذات الرصيد الختامي الصفري</label>
            @if (_validation is not null){<div role="alert" class="trial-warning">@_validation</div>}
        </div>
        <div class="oas-report__apply"><button type="button" class="primary" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-filter"></i> تطبيق</button><button type="button" disabled="@_busy" @onclick="ResetAsync"><i class="fa-solid fa-rotate-left"></i> إعادة تعيين</button></div>
    </FilterPanel>
    <TableContent>
        <table class="oas-report__table trial-table @(Groups.Length == 1 ? "trial-short" : "")">
            <thead>
                <tr class="trial-group-head">
                    <UiReportSortHeader Label="رقم الحساب" RowSpan="2" Active="@(_sortKey == "code")" Descending="@_descending" OnSort="@(() => SortBy("code"))" />
                    <UiReportSortHeader Label="اسم الحساب" RowSpan="2" Active="@(_sortKey == "name")" Descending="@_descending" OnSort="@(() => SortBy("name"))" />
                    @foreach (var g in Groups){<th colspan="2" scope="colgroup">@g.Label</th>}
                </tr>
                <tr>
                    @foreach (var col in Columns)
                    {
                        <UiReportSortHeader @key="col.Key" Label="@col.Label" Active="@(_sortKey == col.Key)" Descending="@_descending" OnSort="@(() => SortBy(col.Key))" />
                    }
                </tr>
            </thead>
            <tbody>
                @if (_busy){<tr><td colspan="@ColumnCount" class="oas-report__empty">جارٍ تحميل ميزان المراجعة...</td></tr>}
                else if (_error is not null){<tr><td colspan="@ColumnCount" class="oas-report__empty" role="alert">@_error</td></tr>}
                else if (_visible.Count == 0){<tr><td colspan="@ColumnCount" class="oas-report__empty">لا توجد حسابات مطابقة للفلاتر.</td></tr>}
                else
                {
                    @foreach (var row in PageRows)
                    {
                        <tr @key="row.Account.AccountId" class="@(row.Aggregate ? "trial-parent" : "")">
                            <td class="trial-code">@row.Account.AccountCode</td>
                            <td class="trial-name"><button type="button" class="trial-link" style="@($"padding-inline-start:{Math.Min(row.Depth, 12)*12}px")" title="فتح كشف الحساب خلال الفترة" @onclick="@(() => OpenStatement(row))"><i class="fa-solid @(row.Aggregate ? "fa-folder" : "fa-file-lines")"></i> @row.Account.AccountNameAr</button></td>
                            @foreach (var col in Columns){<td class="oas-report__amount @col.Css">@Money(row.Amounts.Value(col.Key))</td>}
                        </tr>
                    }
                    <tr class="trial-total">
                        <td colspan="2" title="إجمالي الحسابات المباشرة المطابقة دون تكرار الأرصدة الشجرية">إجمالي النتائج</td>
                        @foreach (var col in Columns){<td class="oas-report__amount @col.Css">@Money(_totals.Value(col.Key), false)</td>}
                    </tr>
                }
            </tbody>
        </table>
    </TableContent>
    <Pagination>
        <div class="oas-report__pager"><button @onclick="@(() => GoPage(1))" disabled="@(_page == 1)">»</button><button @onclick="@(() => GoPage(_page-1))" disabled="@(_page == 1)">‹</button><button class="active" disabled>@_page</button><button @onclick="@(() => GoPage(_page+1))" disabled="@(_page >= TotalPages)">›</button><button @onclick="@(() => GoPage(TotalPages))" disabled="@(_page >= TotalPages)">«</button></div>
        <span>عرض @(_visible.Count == 0 ? 0 : (_page-1)*_pageSize+1) - @Math.Min(_page*_pageSize, _visible.Count) من @_visible.Count نتيجة</span>
        <label>لكل صفحة <select value="@_pageSize" @onchange="ChangePageSize"><option>10</option><option>25</option><option>50</option><option>100</option></select></label>
    </Pagination>
    <Metrics>
        <UiReportMetric Label="الرصيد الافتتاحي المدين" Value="@Metric(_totals.OpeningDebit)" Tone="red" Icon="fa-solid fa-arrow-up" />
        <UiReportMetric Label="الرصيد الافتتاحي الدائن" Value="@Metric(_totals.OpeningCredit)" Tone="green" Icon="fa-solid fa-arrow-down" />
        <UiReportMetric Label="إجمالي حركة المدين" Value="@Metric(_totals.PeriodDebit)" Tone="red" Icon="fa-solid fa-arrow-up-right-dots" />
        <UiReportMetric Label="إجمالي حركة الدائن" Value="@Metric(_totals.PeriodCredit)" Tone="green" Icon="fa-solid fa-arrow-down" />
        <UiReportMetric Label="الرصيد الختامي المدين" Value="@Metric(_totals.ClosingDebit)" Tone="purple" Icon="fa-solid fa-coins" />
        <UiReportMetric Label="الرصيد الختامي الدائن" Value="@Metric(_totals.ClosingCredit)" Tone="blue" Icon="fa-solid fa-database" />
    </Metrics>
</UiReportWorkspace>
</div>
