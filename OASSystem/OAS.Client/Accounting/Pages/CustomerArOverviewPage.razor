@page "/accounting/customer-ar"
@attribute [Authorize]
@using OAS.Contracts.Accounting.Reports
@using OAS.Client.Services.Http
@using OAS.Client.Common.Feedback.Services
@using OAS.Client.Services.Browser
@using OAS.UiLib.Services.Feedback
@inject BrowserFileDownloadService Downloads
@inject IUiSnackbarService Snackbar
@inject OasApiClient Api
@inject IApiFeedbackService ApiFeedback

<PageTitle>أرصدة العملاء وأعمار الديون | OAS</PageTitle>

<div class="customer-ar-page" dir="rtl">
    <header class="ar-page-header">
        <div>
            <div class="ar-breadcrumb">المحاسبة والمالية <span>/</span> العملاء <span>/</span> التقارير</div>
            <h1>أرصدة العملاء</h1>
            <p>تابع الأرصدة المدينة والدائنة وأعمار الديون، وافتح كشف حساب أي عميل مباشرة.</p>
        </div>
        <div class="ar-page-actions">
            <button type="button" class="ar-button ar-button--quiet" @onclick="BackToCustomersAsync">قائمة العملاء</button>
            <button type="button" class="ar-button ar-button--quiet" @onclick="LoadAsync" disabled="@_busy">تحديث</button>
            <button type="button" class="ar-button ar-button--secondary" @onclick="ExportBalancesAsync" disabled="@_busy">تصدير الأرصدة CSV</button>
            <button type="button" class="ar-button ar-button--secondary" @onclick="ExportAgingAsync" disabled="@_busy">تصدير أعمار الديون</button>
        </div>
    </header>

    <section class="ar-filter-panel" aria-label="تصفية تقرير الأرصدة">
        <label class="ar-field"><span>الأرصدة حتى تاريخ</span><input type="date" value="@(_asOf?.ToString("yyyy-MM-dd"))" @onchange="OnAsOfChangedAsync" /></label>
        <label class="ar-field ar-search-field"><span>البحث عن عميل</span><input type="search" placeholder="اسم العميل أو رقمه أو الحساب..." @bind="_search" @bind:event="oninput" /></label>
        <button type="button" class="ar-button ar-button--primary" @onclick="() => SearchAsync(_search)" disabled="@_busy">بحث</button>
        @if (_busy) { <span class="ar-loading-label"><span class="ar-spinner" aria-hidden="true"></span> جارٍ التحديث</span> }
    </section>

    @if (_balances is not null)
    {
        <section class="ar-metric-grid" aria-label="ملخص الأرصدة">
            <article class="ar-metric ar-metric--blue"><div class="ar-metric-top"><span>صافي ذمم العملاء</span><span class="ar-metric-icon" aria-hidden="true">↗</span></div><strong>@_balances.NetReceivableBase.ToString("N2")</strong><small>@_balances.BaseCurrencyCode · حتى @_balances.AsOf.ToString("yyyy-MM-dd")</small></article>
            <article class="ar-metric"><div class="ar-metric-top"><span>الأرصدة المدينة</span><span class="ar-metric-icon" aria-hidden="true">＋</span></div><strong>@_balances.DebitBalancesBase.ToString("N2")</strong><small>مبالغ مستحقة من العملاء</small></article>
            <article class="ar-metric ar-metric--green"><div class="ar-metric-top"><span>الأرصدة الدائنة</span><span class="ar-metric-icon" aria-hidden="true">−</span></div><strong>@_balances.CreditBalancesBase.ToString("N2")</strong><small>أرصدة لصالح العملاء</small></article>
            <article class="ar-metric"><div class="ar-metric-top"><span>عدد العملاء في التقرير</span><span class="ar-metric-icon" aria-hidden="true">♙</span></div><strong>@_balances.TotalCount.ToString("N0")</strong><small>إجمالي السجلات المطابقة</small></article>
        </section>

        <section class="ar-panel">
            <div class="ar-panel-heading"><div><h2>أرصدة العملاء حسب الحساب</h2><p>اضغط على اسم العميل لفتح ملفه المالي وكشف الحساب.</p></div><span class="ar-record-count">@_balances.Customers.Count سجل في هذه الصفحة</span></div>
            <div class="ar-table-wrap">
                <table class="ar-table">
                    <thead><tr><th>رقم العميل</th><th>اسم العميل</th><th>رقم الحساب</th><th>مدين</th><th>دائن</th><th>الرصيد</th><th>الإجراء</th></tr></thead>
                    <tbody>
                        @foreach (var c in _balances.Customers)
                        {
                            <tr>
                                <td data-label="رقم العميل"><span class="ar-code">@c.CustomerCode</span></td>
                                <td data-label="اسم العميل"><a class="ar-customer-link" href="@($"/accounting/customers/{c.CustomerId:D}/account")">@c.CustomerName</a></td>
                                <td data-label="رقم الحساب"><span class="ar-code">@c.AccountCode</span></td>
                                <td data-label="مدين" class="ar-number">@c.DebitBase.ToString("N2")</td>
                                <td data-label="دائن" class="ar-number">@c.CreditBase.ToString("N2")</td>
                                <td data-label="الرصيد" class="ar-number ar-number--strong">@c.BalanceBase.ToString("N2")</td>
                                <td data-label="الإجراء"><a class="ar-row-action" href="@($"/accounting/customers/{c.CustomerId:D}/account")">كشف الحساب <span aria-hidden="true">←</span></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ar-mobile-customer-list">
                @foreach (var c in _balances.Customers)
                {
                    <a class="ar-mobile-customer" href="@($"/accounting/customers/{c.CustomerId:D}/account")">
                        <span class="ar-mobile-customer-head"><strong>@c.CustomerName</strong><span class="ar-code">@c.CustomerCode</span></span>
                        <span class="ar-mobile-customer-meta">الحساب @c.AccountCode</span>
                        <span class="ar-mobile-customer-balance"><span>الرصيد</span><strong>@c.BalanceBase.ToString("N2") @_balances.BaseCurrencyCode</strong></span>
                    </a>
                }
            </div>
            @if (_balances.Customers.Count == 0) { <div class="ar-empty-state">لا توجد نتائج مطابقة. غيّر البحث أو تاريخ التقرير.</div> }
            <div class="ar-pagination">
                <span>عرض @_balances.Customers.Count من أصل @_balances.TotalCount · الصفحة @_page</span>
                <div><button type="button" class="ar-button ar-button--quiet" disabled="@(_page <= 1 || _busy)" @onclick="PreviousAsync">السابق</button><button type="button" class="ar-button ar-button--quiet" disabled="@((long)_page * 50 >= _balances.TotalCount || _busy)" @onclick="NextAsync">التالي</button></div>
            </div>
        </section>

        @if (_aging is not null)
        {
            <section class="ar-panel">
                <div class="ar-panel-heading"><div><h2>أعمار الديون</h2><p>المبالغ المتبقية على الفواتير حسب تاريخ الاستحقاق حتى تاريخ التقرير.</p></div><span class="ar-record-count">العملة الأساسية: @_aging.BaseCurrencyCode</span></div>
                <div class="ar-aging-grid">
                    <article><span>غير مستحق</span><strong>@_aging.NotDueBase.ToString("N2")</strong></article>
                    <article><span>0–30 يومًا</span><strong>@_aging.Days0To30Base.ToString("N2")</strong></article>
                    <article><span>31–60 يومًا</span><strong>@_aging.Days31To60Base.ToString("N2")</strong></article>
                    <article><span>61–90 يومًا</span><strong>@_aging.Days61To90Base.ToString("N2")</strong></article>
                    <article class="ar-aging-danger"><span>أكثر من 90 يومًا</span><strong>@_aging.Over90Base.ToString("N2")</strong></article>
                    <article><span>استحقاق غير محدد</span><strong>@_aging.UnknownBase.ToString("N2")</strong></article>
                </div>
                <div class="ar-aging-footer">
                    <div><span>إجمالي المتبقي على الفواتير</span><strong>@_aging.TotalOutstandingBase.ToString("N2")</strong></div>
                    <div><span>مقبوضات غير مخصصة</span><strong>@_aging.UnappliedReceiptsBase.ToString("N2")</strong></div>
                    <div><span>مرتجعات غير مطبقة</span><strong>@_aging.UnappliedReturnCreditsBase.ToString("N2")</strong></div>
                    <div><span>عربون العملاء (التزام مستقل)</span><strong>@_aging.CustomerAdvancesLiabilityBase.ToString("N2")</strong></div>
                </div>
            </section>
        }

        @if (_reconcile is not null)
        {
            <section class="ar-panel ar-reconciliation">
                <div class="ar-panel-heading"><div><h2>مطابقة حساب ذمم العملاء</h2><p>يقارن النظام حساب الرقابة مع أرصدة حسابات العملاء الفرعية دون إجراء تسوية تلقائية.</p></div><span class="@(_reconcile.IsReconciled ? "ar-status ar-status--ok" : "ar-status ar-status--warning")">@(_reconcile.IsReconciled ? "متطابق" : "يحتاج مراجعة")</span></div>
                <div class="ar-reconciliation-grid">
                    <div><span>حساب الرقابة</span><strong>@(_reconcile.ControlAccountCode ?? "غير محدد")</strong></div>
                    <div><span>رصيد حساب الرقابة</span><strong>@_reconcile.ControlAccountBalanceBase.ToString("N2")</strong></div>
                    <div><span>مجموع حسابات العملاء</span><strong>@_reconcile.CustomerSubledgerBase.ToString("N2")</strong></div>
                    <div class="@(!_reconcile.IsReconciled ? "ar-difference-warning" : "")"><span>الفرق</span><strong>@_reconcile.DifferenceBase.ToString("N2")</strong></div>
                </div>
                @if (!_reconcile.IsReconciled) { <div class="ar-warning-message">@(_reconcile.Message ?? "توجد فروق تحتاج إلى مراجعة قبل إقفال الفترة.")</div> }
            </section>
        }
    }
    else if (_busy)
    {
        <div class="ar-empty-state"><span class="ar-spinner" aria-hidden="true"></span> جارٍ تحميل تقرير الأرصدة...</div>
    }
    else
    {
        <div class="ar-empty-state">لا توجد بيانات لعرضها حتى الآن. اضغط «تحديث» للمحاولة مرة أخرى.</div>
    }
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private DateOnly? _asOf = DateOnly.FromDateTime(DateTime.Today);
    private CustomerBalancesReportDto? _balances;
    private CustomerAgingReportDto? _aging;
    private CustomerArReconciliationDto? _reconcile;
    private int _page = 1;
    private string _search = string.Empty;
    private async Task OnAsOfChangedAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParse(args.Value?.ToString(), out var value))
        {
            _asOf = value;
            _page = 1;
            await LoadAsync();
        }
    }

    private async Task SearchAsync(string? search)
    {
        _search = search ?? string.Empty;
        _page = 1;
        await LoadAsync();
    }
    private bool _busy;
    protected override Task OnInitializedAsync() => LoadAsync();

    private Task ExportBalancesAsync() => ExportAsync("balances", "Customer-Balances.csv");
    private Task ExportAgingAsync() => ExportAsync("aging", "Customer-Aging.csv");
    private async Task ExportAsync(string category, string filename)
    {
        if (!_asOf.HasValue || _busy) return;
        _busy = true;
        try
        {
            var date = _asOf.Value.ToString("yyyy-MM-dd");
            var search = category == "balances" ? $"&search={Uri.EscapeDataString(_search)}" : string.Empty;
            var bytes = await Api.GetFileAsync($"api/accounting/reports/customers/{category}.csv?asOfDate={date}{search}");
            await Downloads.DownloadAsync(bytes, filename, "text/csv;charset=utf-8");
            Snackbar.Success("تم تصدير التقرير بنجاح.");
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private Task BackToCustomersAsync()
    {
        Navigation.NavigateTo("/accounting/customers");
        return Task.CompletedTask;
    }

    private void OpenCustomer(Guid id) => Navigation.NavigateTo($"/accounting/customers/{id:D}/account");
    private async Task PreviousAsync() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextAsync() { _page++; await LoadAsync(); }
    private async Task LoadAsync()
    {
        if (!_asOf.HasValue) return;
        _busy = true;
        try
        {
            var date = _asOf.Value.ToString("yyyy-MM-dd");
            var baseUrl = "api/accounting/reports/customers";
            var term = Uri.EscapeDataString(_search);
            var balancesTask = Api.GetAsync<CustomerBalancesReportDto>($"{baseUrl}/balances?asOfDate={date}&pageNumber={_page}&pageSize=50&search={term}");
            var agingTask = Api.GetAsync<CustomerAgingReportDto>($"{baseUrl}/aging?asOfDate={date}&pageNumber=1&pageSize=25");
            var reconTask = Api.GetAsync<CustomerArReconciliationDto>($"{baseUrl}/reconciliation?asOfDate={date}");
            await Task.WhenAll(balancesTask, agingTask, reconTask);
            _balances = await balancesTask;
            _aging = await agingTask;
            _reconcile = await reconTask;
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
}
