@page "/accounting/customer-ar"
@attribute [Authorize]
@using OAS.Contracts.Accounting.Reports
@using OAS.Client.Services.Http
@using OAS.Client.Common.Feedback.Services
@using OAS.Client.Services.Browser
@using OAS.UiLib.Services.Feedback
@inject BrowserFileDownloadService Downloads
@inject IUiSnackbarService Snackbar
@inject OasApiClient Api
@inject IApiFeedbackService ApiFeedback

<PageTitle>أرصدة العملاء وأعمار الديون | OAS</PageTitle>
<UiWorkspaceLayout ShowAside="false" ShowFilters="false">
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="قائمة العملاء" IconCssClass="fa-solid fa-users" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="BackToCustomersAsync" />
            <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Loading="@_busy" Size="ControlSize.Small" OnClick="LoadAsync" />
            <UiButton Text="تصدير الأرصدة CSV" Loading="@_busy" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="ExportBalancesAsync" />
            <UiButton Text="تصدير الأعمار CSV" Loading="@_busy" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="ExportAgingAsync" />
        </UiWorkspaceActionBar>
    </Actions>
    <Content>
        <UiStackLayout Gap="StackGap.Small">
            <UiCard Title="أرصدة العملاء" Subtitle="رصيد مدين موجب ورصيد دائن سالب؛ جميع الأرقام بالعملة الأساسية.">
                <UiGrid Columns="2">
                    <UiInputDate Label="حتى تاريخ" Value="@_asOf" ValueChanged="@(v => _asOf = v)" Size="ControlSize.Small" />
                    <UiSearchInput Value="@_search" ValueChanged="@(v => _search = v ?? string.Empty)" OnSearch="SearchAsync" Placeholder="اسم العميل أو رمزه أو رقم الحساب" />
                </UiGrid>
                @if (_balances is not null)
                {
                    <UiGrid Columns="2">
                        <UiKeyValue Label="صافي الذمم" Value="@_balances.NetReceivableBase.ToString("N2")" />
                        <UiKeyValue Label="إجمالي أرصدة العملاء المدينة" Value="@_balances.DebitBalancesBase.ToString("N2")" />
                        <UiKeyValue Label="إجمالي أرصدة العملاء الدائنة" Value="@_balances.CreditBalancesBase.ToString("N2")" />
                        <UiKeyValue Label="العملة" Value="@_balances.BaseCurrencyCode" />
                    </UiGrid>
                }
            </UiCard>
            @if (_balances is not null)
            {
                <UiCard Title="العملاء" Subtitle="افتح العميل لعرض كشف حسابه والمستندات وأعمار ديونه.">
                    @foreach (var c in _balances.Customers)
                    {
                        <UiRecordRow Title="@($"{c.CustomerCode} - {c.CustomerName}")" Subtitle="@($"الرصيد {c.BalanceBase:N2} {_balances.BaseCurrencyCode}")" OnClick="@(() => OpenCustomer(c.CustomerId))" />
                    }
                    <UiWorkspaceActionBar>
                        <UiButton Text="السابق" Size="ControlSize.Small" Variant="ButtonVariant.Secondary" Disabled="@(_page<=1)" OnClick="PreviousAsync" />
                        <UiButton Text="التالي" Size="ControlSize.Small" Variant="ButtonVariant.Secondary" Disabled="@((long)_page*50>=_balances.TotalCount)" OnClick="NextAsync" />
                    </UiWorkspaceActionBar>
                </UiCard>
            }
            @if (_aging is not null)
            {
                <UiCard Title="أعمار الديون الإجمالية" Subtitle="المستحقات المحاسبية المفتوحة حتى التاريخ المحدد.">
                    <UiGrid Columns="2">
                        <UiKeyValue Label="غير مستحق" Value="@_aging.NotDueBase.ToString("N2")" />
                        <UiKeyValue Label="0–30" Value="@_aging.Days0To30Base.ToString("N2")" />
                        <UiKeyValue Label="31–60" Value="@_aging.Days31To60Base.ToString("N2")" />
                        <UiKeyValue Label="61–90" Value="@_aging.Days61To90Base.ToString("N2")" />
                        <UiKeyValue Label="أكثر من 90" Value="@_aging.Over90Base.ToString("N2")" />
                        <UiKeyValue Label="استحقاق غير معروف" Value="@_aging.UnknownBase.ToString("N2")" />
                        <UiKeyValue Label="مقبوضات غير مخصصة" Value="@_aging.UnappliedReceiptsBase.ToString("N2")" />
                        <UiKeyValue Label="رصيد مرتجعات غير مطبق" Value="@_aging.UnappliedReturnCreditsBase.ToString("N2")" />
                    </UiGrid>
                </UiCard>
            }
            @if (_reconcile is not null)
            {
                <UiCard Title="مطابقة حساب رقابة العملاء" Subtitle="تُعرض الفروق ولا تُسوَّى أو تُصفّر تلقائيًا.">
                    <UiKeyValue Label="حساب الرقابة" Value="@(_reconcile.ControlAccountCode ?? "يحتاج تحديدًا")" />
                    <UiKeyValue Label="إجمالي الرقابة" Value="@_reconcile.ControlAccountBalanceBase.ToString("N2")" />
                    <UiKeyValue Label="إجمالي حسابات العملاء" Value="@_reconcile.CustomerSubledgerBase.ToString("N2")" />
                    <UiKeyValue Label="الفرق" Value="@_reconcile.DifferenceBase.ToString("N2")" />
                    @if (!_reconcile.IsReconciled)
                    {
                        <UiAlert Tone="AlertTone.Warning" Message="@(_reconcile.Message ?? "توجد فروق تحتاج مراجعة.")" />
                    }
                </UiCard>
            }
        </UiStackLayout>
    </Content>
</UiWorkspaceLayout>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private DateOnly? _asOf = DateOnly.FromDateTime(DateTime.Today);
    private CustomerBalancesReportDto? _balances;
    private CustomerAgingReportDto? _aging;
    private CustomerArReconciliationDto? _reconcile;
    private int _page = 1;
    private string _search = string.Empty;
    private async Task SearchAsync(string? search)
    {
        _search = search ?? string.Empty;
        _page = 1;
        await LoadAsync();
    }
    private bool _busy;
    protected override Task OnInitializedAsync() => LoadAsync();

    private Task ExportBalancesAsync() => ExportAsync("balances", "Customer-Balances.csv");
    private Task ExportAgingAsync() => ExportAsync("aging", "Customer-Aging.csv");
    private async Task ExportAsync(string category, string filename)
    {
        if (!_asOf.HasValue || _busy) return;
        _busy = true;
        try
        {
            var date = _asOf.Value.ToString("yyyy-MM-dd");
            var search = category == "balances" ? $"&search={Uri.EscapeDataString(_search)}" : string.Empty;
            var bytes = await Api.GetFileAsync($"api/accounting/reports/customers/{category}.csv?asOfDate={date}{search}");
            await Downloads.DownloadAsync(bytes, filename, "text/csv;charset=utf-8");
            Snackbar.Success("تم تصدير التقرير بنجاح.");
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private Task BackToCustomersAsync()
    {
        Navigation.NavigateTo("/accounting/customers");
        return Task.CompletedTask;
    }

    private void OpenCustomer(Guid id) => Navigation.NavigateTo($"/accounting/customers/{id:D}/account");
    private async Task PreviousAsync() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextAsync() { _page++; await LoadAsync(); }
    private async Task LoadAsync()
    {
        if (!_asOf.HasValue) return;
        _busy = true;
        try
        {
            var date = _asOf.Value.ToString("yyyy-MM-dd");
            var baseUrl = "api/accounting/reports/customers";
            var term = Uri.EscapeDataString(_search);
            var balancesTask = Api.GetAsync<CustomerBalancesReportDto>($"{baseUrl}/balances?asOfDate={date}&pageNumber={_page}&pageSize=50&search={term}");
            var agingTask = Api.GetAsync<CustomerAgingReportDto>($"{baseUrl}/aging?asOfDate={date}&pageNumber=1&pageSize=25");
            var reconTask = Api.GetAsync<CustomerArReconciliationDto>($"{baseUrl}/reconciliation?asOfDate={date}");
            await Task.WhenAll(balancesTask, agingTask, reconTask);
            _balances = await balancesTask;
            _aging = await agingTask;
            _reconcile = await reconTask;
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
}
