@page "/accounting/accounts"
@attribute [Authorize]
@inject IAccountingClientService AccountingService
@inject IUiSnackbarService Snackbar
@using OAS.Contracts.Accounting.Accounts
@using OAS.Contracts.Accounting.Enums

<PageTitle>دليل شجرة الحسابات | OAS</PageTitle>

<UiAccountingWorkspace>
    <Actions>
        <UiButton Text="حساب جديد"
                  IconCssClass="fa-solid fa-plus"
                  Size="ControlSize.Small"
                  OnClick="OpenCreateModal" />
        <UiButton Text="تحديث"
                  IconCssClass="fa-solid fa-rotate"
                  Variant="ButtonVariant.Secondary"
                  Size="ControlSize.Small"
                  Loading="@_loading"
                  OnClick="LoadDataAsync" />
        <UiSearchInput @bind-Value="_searchTerm"
                       Placeholder="ابحث برقم الحساب أو الاسم..."
                       DebounceMilliseconds="300"
                       OnSearch="SearchChangedAsync" />
    </Actions>

    <Metrics>
        <UiAccountingMetricTile Label="إجمالي الحسابات" Value="@_totalCount.ToString()" IconCssClass="fa-solid fa-calculator" />
        <UiAccountingMetricTile Label="حسابات الترحيل" Value="@_items.Count(x => x.IsPostingAccount).ToString()" IconCssClass="fa-solid fa-check" Variant="UiAccountingMetricTile.MetricVariant.Debit" />
        <UiAccountingMetricTile Label="حسابات المراقبة" Value="@_items.Count(x => x.IsControlAccount).ToString()" IconCssClass="fa-solid fa-shield" Variant="UiAccountingMetricTile.MetricVariant.Balance" />
    </Metrics>

    <Body>
        @if (_loading)
        {
            <UiAlert Message="جاري تحميل دليل الحسابات..." Tone="AlertTone.Info" />
        }
        else if (_items.Count == 0)
        {
            <UiAlert Message="لا توجد حسابات مسجلة تطابق معايير البحث." Tone="AlertTone.Warning" />
        }
        else
        {
            @foreach (var acc in _items)
            {
                <UiAccountCard Code="@acc.Code"
                               NameAr="@acc.NameAr"
                               NameEn="@acc.NameEn"
                               Level="@acc.Level"
                               AccountClassText="@acc.AccountClass.ToString()"
                               AccountTypeText="@acc.AccountType.ToString()"
                               NormalBalanceText="@(acc.NormalBalance == NormalBalance.Debit ? "مدين" : "دائن")"
                               IsPostingAccount="@acc.IsPostingAccount"
                               IsControlAccount="@acc.IsControlAccount"
                               IsActive="@acc.IsActive"
                               OnToggleStatus="@(() => ToggleStatusAsync(acc))" />
            }
        }
    </Body>
</UiAccountingWorkspace>

@if (_showCreateModal)
{
    <UiAccountingDialog Title="إضافة حساب مالي جديد" OnClose="CloseCreateModal">
        <ChildContent>
            <UiInputText Label="كود الحساب" @bind-Value="_createCode" />
            <UiInputText Label="الاسم العربي" @bind-Value="_createNameAr" />
            <UiInputText Label="الاسم الإنجليزي" @bind-Value="_createNameEn" />
        </ChildContent>
        <Footer>
            <UiButton Text="حفظ الحساب" IconCssClass="fa-solid fa-floppy-disk" Loading="@_saving" OnClick="SaveAccountAsync" />
            <UiButton Text="إلغاء" Variant="ButtonVariant.Ghost" OnClick="CloseCreateModal" />
        </Footer>
    </UiAccountingDialog>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string _searchTerm = string.Empty;
    private int _pageNumber = 1;
    private int _pageSize = 50;
    private long _totalCount;
    private IReadOnlyList<AccountDto> _items = [];

    private bool _showCreateModal;
    private string _createCode = string.Empty;
    private string _createNameAr = string.Empty;
    private string _createNameEn = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var req = new PageRequest { PageNumber = _pageNumber, PageSize = _pageSize, Search = _searchTerm };
            var res = await AccountingService.GetAccountsPageAsync(req);
            _items = res.Items ?? [];
            _totalCount = res.TotalCount;
        }
        catch (Exception ex)
        {
            Snackbar.Error("تعذر تحميل الحسابات: " + ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchChangedAsync(string text)
    {
        _searchTerm = text;
        _pageNumber = 1;
        await LoadDataAsync();
    }

    private async Task ToggleStatusAsync(AccountDto acc)
    {
        var nextStatus = !acc.IsActive;
        var req = new SetAccountStatusRequest(nextStatus, acc.RowVersion);
        var success = await AccountingService.SetAccountStatusAsync(acc.Id, req);
        if (success)
        {
            Snackbar.Success(nextStatus ? "تم تفعيل الحساب." : "تم تعطيل الحساب.");
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Error("تعذر تحديث حالة الحساب.");
        }
    }

    private void OpenCreateModal()
    {
        _createCode = string.Empty;
        _createNameAr = string.Empty;
        _createNameEn = string.Empty;
        _showCreateModal = true;
    }

    private void CloseCreateModal() => _showCreateModal = false;

    private async Task SaveAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(_createCode) || string.IsNullOrWhiteSpace(_createNameAr))
        {
            Snackbar.Warning("يرجى إدخال كود واسم الحساب.");
            return;
        }

        _saving = true;
        try
        {
            var req = new CreateAccountRequest(
                _createCode,
                _createNameAr,
                string.IsNullOrWhiteSpace(_createNameEn) ? null : _createNameEn,
                null,
                1,
                AccountClass.Asset,
                AccountType.Posting,
                NormalBalance.Debit,
                true,
                false,
                true,
                false,
                true,
                DateOnly.FromDateTime(DateTime.Today));

            var result = await AccountingService.CreateAccountAsync(req);
            if (result is not null)
            {
                Snackbar.Success("تم إنشاء الحساب بنجاح.");
                CloseCreateModal();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Error("فشل حفظ الحساب: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }
}
