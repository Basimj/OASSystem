@page "/accounting/reports/supplier-debts"
@attribute [Authorize]
@using System.Globalization
@using OAS.Client.Accounting.Pages
@using OAS.Contracts.Accounting.Reports
@using OAS.Contracts.Accounting.Currencies
@using OAS.Contracts.Accounting.Enums
@using OAS.UiLib.Components.Reports
@inject IAccountingClientService Accounting
@inject OasApiClient Api
@inject IJSRuntime JS
@inject IApiFeedbackService ApiFeedback

<PageTitle>الموردون | OAS</PageTitle>
<div class="supplier-debts-report">
<UiReportWorkspace Title="الموردون" StatusText="@(_busy ? "جارٍ التحميل" : _error is null ? "مستحقات الموردين" : "تعذر التحميل")" Search="@_search" SearchChanged="OnSearch" FiltersOpen="@_filtersOpen" FiltersOpenChanged="@(v => _filtersOpen = v)">
    <Toolbar>
        <button type="button" class="oas-report__tool" title="تحديث" disabled="@_busy" @onclick="RefreshAsync"><i class="fa-solid fa-rotate"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--pdf" title="طباعة أو حفظ PDF" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-regular fa-file-pdf"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--excel" title="تصدير Excel" disabled="@(!CanExport)" @onclick="ExportAsync"><i class="fa-regular fa-file-excel"></i></button>
        <button type="button" class="oas-report__tool" title="طباعة جميع النتائج" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-solid fa-print"></i></button>
        <button type="button" class="oas-report__tool" title="إظهار أو إخفاء الفلاتر" @onclick="@(() => _filtersOpen = !_filtersOpen)"><i class="fa-solid fa-ellipsis-vertical"></i></button>
    </Toolbar>
    <QuickFilters>
        @foreach (var chip in Chips)
        {
            <div class="oas-report__chip" title="@($"{chip.Label}: {chip.Value}")"><i class="@chip.Icon"></i><span class="oas-report__chip-label">@chip.Label:</span><strong>@chip.Value</strong></div>
        }
    </QuickFilters>
    <FilterPanel>
        <div class="debt-filter-fields">
            <div class="oas-report__field">
                <UiReportSearchPicker Label="المورد" ItemLabel="مورد" DialogTitle="اختيار المورد" SearchPlaceholder="ابحث باسم المورد أو رقمه..." Value="@_draft.Supplier" ValueChanged="OnSupplier" Options="@_options" Placeholder="جميع الموردين" />
            </div>
            <label class="oas-report__field">إلى تاريخ<input type="date" @bind="_draft.AsOf" @bind:format="yyyy-MM-dd" /></label>
            <label class="oas-report__field">العملة<select @bind="_draft.Currency"><option value="">@_baseName (الأساسية)</option>@foreach (var c in _currencies.Where(x => x.IsActive && x.Id != _baseId)){<option value="@c.Id">@c.NameAr (@c.Code)</option>}</select></label>
            <label class="oas-report__field">نوع التقرير<select @bind="_draft.Mode"><option value="summary">إجمالي حسب المورد</option><option value="detail">تفصيلي حسب المستند</option><option value="aging">أعمار الديون</option></select></label>
            <label class="oas-report__field">حالة الرصيد<select @bind="_draft.Balance"><option value="debit">مدين</option><option value="credit">دائن</option><option value="all">الكل</option><option value="nonzero">غير صفري</option><option value="zero">صفري</option></select></label>
            <label class="oas-report__field" title="اختيار الموردين الذين لديهم مستندات بالحالة المحددة">حالة الاستحقاق<select @bind="_draft.Due"><option value="all">الكل</option><option value="due">مستحق</option><option value="future">غير مستحق</option><option value="today">مستحق اليوم</option><option value="overdue">متأخر</option><option value="unknown">استحقاق غير محدد</option></select></label>
            <div class="oas-report__date-pair">
                <label class="oas-report__field">مطلق رصيد المورد من<input type="number" min="0" step="any" @bind="_draft.Min" placeholder="بدون حد" /></label>
                <label class="oas-report__field">مطلق رصيد المورد إلى<input type="number" min="0" step="any" @bind="_draft.Max" placeholder="بدون حد" /></label>
            </div>
            <label class="oas-report__field-check"><input type="checkbox" @bind="_draft.IncludeInactive" /> تضمين الموردين غير النشطين</label>
            @if (_validation is not null){<div role="alert" class="debt-validation">@_validation</div>}
        </div>
        <div class="oas-report__apply"><button type="button" class="primary" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-filter"></i> تطبيق</button><button type="button" disabled="@_busy" @onclick="ResetAsync"><i class="fa-solid fa-rotate-left"></i> إعادة تعيين</button></div>
    </FilterPanel>
    <TableContent>
        <table class="oas-report__table debt-table debt-table--@_applied.Mode">
            <thead><tr>
                @foreach (var col in Columns)
                {
                    <UiReportSortHeader @key="col.Key" Label="@col.Label" Active="@(_sortKey == col.Key)" Descending="@_descending" OnSort="@(() => SortBy(col.Key))" />
                }
            </tr></thead>
            <tbody>
                @if (_busy){<tr><td colspan="@Columns.Length" class="oas-report__empty">جارٍ تحميل مستحقات الموردين...</td></tr>}
                else if (_error is not null){<tr><td colspan="@Columns.Length" class="oas-report__empty" role="alert">@_error</td></tr>}
                else if (_rows.Count == 0){<tr><td colspan="@Columns.Length" class="oas-report__empty">لا توجد نتائج مطابقة للفلاتر.</td></tr>}
                else
                {
                    @foreach (var row in _rows.Skip((_page-1)*_pageSize).Take(_pageSize))
                    {
                        <tr @key="row.Id">
                            @for (var i=0; i<Columns.Length; i++)
                            {
                                var col = Columns[i]; var cell = row.Cells[i];
                                <td class="@col.Css" title="@Display(cell)">
                                    @if (col.Key == "name") { <a href="@($"/accounting/suppliers/{row.SupplierId:D}/center")">@Display(cell)</a> }
                                    else if (col.Key == "state") { <span class="debt-state @(Display(cell)=="متأخر" ? "debt-state--late" : Display(cell)=="مدين" || Display(cell)=="غير محدد" ? "debt-state--credit" : "")">@Display(cell)</span> }
                                    else { @Display(cell) }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </TableContent>
    <Pagination>
        <div class="oas-report__pager"><button @onclick="@(() => GoPage(1))" disabled="@(_page==1)">»</button><button @onclick="@(() => GoPage(_page-1))" disabled="@(_page==1)">‹</button><button class="active" disabled>@_page</button><button @onclick="@(() => GoPage(_page+1))" disabled="@(_page>=TotalPages)">›</button><button @onclick="@(() => GoPage(TotalPages))" disabled="@(_page>=TotalPages)">«</button></div>
        <span title="الأرصدة من القيود المرحلة؛ التأخر والاستحقاق من المستندات المفتوحة وقد يختلفان عن الرصيد المحاسبي.">عرض @(_rows.Count==0?0:(_page-1)*_pageSize+1) - @Math.Min(_page*_pageSize,_rows.Count) من @_rows.Count نتيجة</span>
        <label>لكل صفحة <select value="@_pageSize" @onchange="ChangePageSize"><option>10</option><option>25</option><option>50</option><option>100</option></select></label>
    </Pagination>
    <Metrics>
        <UiReportMetric Label="الموردون الدائنون" Value="@MetricCount(_scope.Count(x=>x.LiabilityBalanceBaseAmount>0))" Tone="blue" Icon="fa-solid fa-users" />
        <UiReportMetric Label="الموردون المتأخر سدادهم" Value="@MetricCount(_open.Where(IsOverdue).Select(x=>x.SupplierId).Distinct().Count())" Tone="violet" Icon="fa-solid fa-user-clock" />
        <UiReportMetric Label="متأخر على المستندات" Value="@MetricMoney(_open.Where(IsOverdue).Sum(x=>x.OutstandingBaseAmount))" Tone="red" Icon="fa-solid fa-clock" />
        <UiReportMetric Label="غير مستحق (مستندات)" Value="@MetricMoney(_open.Where(x=>DueDays(x)<0).Sum(x=>x.OutstandingBaseAmount))" Tone="green" Icon="fa-solid fa-calendar-check" />
        <UiReportMetric Label="أرصدة لصالح المنشأة" Value="@MetricMoney(-_scope.Where(x=>x.LiabilityBalanceBaseAmount<0).Sum(x=>x.LiabilityBalanceBaseAmount))" Tone="orange" Icon="fa-solid fa-wallet" />
        <UiReportMetric Label="إجمالي الأرصدة الدائنة" Value="@MetricMoney(_scope.Where(x=>x.LiabilityBalanceBaseAmount>0).Sum(x=>x.LiabilityBalanceBaseAmount))" Tone="purple" Icon="fa-solid fa-coins" />
    </Metrics>
</UiReportWorkspace>
</div>

@code {
    private sealed record Filters
    {
        public string Supplier {get;set;} = "";
        public DateTime AsOf {get;set;} = DateTime.Today;
        public Guid? Currency {get;set;}
        public string Mode {get;set;} = "summary";
        public string Balance {get;set;} = "credit";
        public string Due {get;set;} = "all";
        public decimal? Min {get;set;}
        public decimal? Max {get;set;}
        public bool IncludeInactive {get;set;} = true;
    }
    private sealed record Column(string Key,string Label,string Css="");
    private sealed record Row(Guid Id,Guid SupplierId,object?[] Cells);
    private static readonly Column[] SummaryColumns = [new("code","رقم المورد"),new("name","اسم المورد"),new("debit","المدين","oas-report__amount oas-report__debit"),new("credit","الدائن","oas-report__amount oas-report__credit"),new("balance","الرصيد","oas-report__amount"),new("overdue","المتأخر","oas-report__amount oas-report__debit"),new("state","الحالة")];
    private static readonly Column[] DetailColumns = [new("code","رقم المورد"),new("name","اسم المورد"),new("source","نوع المستند"),new("invoice","رقم المستند"),new("date","تاريخ المستند"),new("due","الاستحقاق"),new("original","قيمة المستند","oas-report__amount"),new("paid","المسدد","oas-report__amount oas-report__credit"),new("returns","أرصدة مرتجعات مطبقة","oas-report__amount"),new("applied","تسويات افتتاحية","oas-report__amount"),new("outstanding","المتبقي","oas-report__amount oas-report__debit"),new("days","أيام التأخير"),new("state","الحالة")];
    private static readonly Column[] AgingColumns = [new("code","رقم المورد"),new("name","اسم المورد"),new("future","غير مستحق","oas-report__amount"),new("today","مستحق اليوم","oas-report__amount"),new("30","1–30 يومًا","oas-report__amount"),new("60","31–60 يومًا","oas-report__amount"),new("90","61–90 يومًا","oas-report__amount"),new("over90","أكثر من 90","oas-report__amount oas-report__debit"),new("unknown","غير محدد","oas-report__amount"),new("outstanding","إجمالي المستندات","oas-report__amount")];
    private Column[] Columns => _applied.Mode switch {"detail"=>DetailColumns,"aging"=>AgingColumns,_=>SummaryColumns};
    private Filters _draft = new(), _applied = new();
    private SupplierDebtSnapshotDto? _snapshot;
    private List<CurrencyDto> _currencies = [];
    private IReadOnlyList<UiSelectOption> _options = [new("","جميع الموردين")];
    private List<SupplierBalanceRowDto> _scope = [];
    private List<SupplierAgingLineDto> _open = [];
    private List<Row> _rows = [];
    private Guid? _baseId;
    private string _baseName="العملة الأساسية", _currencyName="العملة الأساسية", _search="", _sortKey="balance";
    private bool _descending=true,_busy,_filtersOpen=true;
    private int _page=1,_pageSize=25;
    private decimal _rate=1m;
    private string? _error,_validation;
    private int TotalPages=>Math.Max(1,(int)Math.Ceiling(_rows.Count/(double)_pageSize));
    private bool CanExport=>!_busy && _error is null && _snapshot is not null && _rows.Count>0;
    private static string ModeName(string v)=>v switch{"detail"=>"تفصيلي","aging"=>"أعمار الديون",_=>"إجمالي"};
    private static string BalanceName(string v)=>v switch{"debit"=>"مدين","credit"=>"دائن","zero"=>"صفري","nonzero"=>"غير صفري",_=>"الكل"};
    private static string DueName(string v)=>v switch{"due"=>"مستحق","future"=>"غير مستحق","today"=>"مستحق اليوم","overdue"=>"متأخر","unknown"=>"غير محدد",_=>"الكل"};
    private (string Label,string Value,string Icon)[] Chips => [
        ("المورد",_options.FirstOrDefault(x=>x.Value==_applied.Supplier)?.Text??"جميع الموردين","fa-solid fa-users"),
        ("إلى تاريخ",_applied.AsOf.ToString("dd/MM/yyyy",CultureInfo.InvariantCulture),"fa-regular fa-calendar"),
        ("العملة",_currencyName,"fa-solid fa-coins"),("نوع التقرير",ModeName(_applied.Mode),"fa-regular fa-file-lines"),
        ("الرصيد",BalanceName(_applied.Balance),"fa-solid fa-wallet"),("الاستحقاق",DueName(_applied.Due),"fa-solid fa-clock")];
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings=await Accounting.GetAccountingSettingsAsync(); _baseId=settings?.BaseCurrencyId;
            for(int page=1;;page++) { var result=await Accounting.GetCurrenciesPageAsync(new PageRequest{PageNumber=page,PageSize=100}); _currencies.AddRange(result.Items); if(!result.HasNextPage) break; }
            _baseName=_currencies.FirstOrDefault(x=>x.Id==_baseId)?.NameAr??settings?.BaseCurrencyCode??"العملة الأساسية";
        }
        catch { _currencies=[]; } // Base-currency report remains available.
        await ApplyAsync();
    }
    private void OnSupplier(string? value)=>_draft.Supplier=value??"";
    private Task RefreshAsync()=>LoadAsync(_applied with {},true);
    private Task ApplyAsync()
    {
        _validation=null;
        if(_draft.Min is < 0 || _draft.Max is < 0 || (_draft.Min.HasValue && _draft.Max.HasValue && _draft.Min>_draft.Max)){_validation="تحقق من نطاق المستحقات.";return Task.CompletedTask;}
        return LoadAsync(_draft with {},false);
    }
    private async Task ResetAsync(){_draft=new();_search="";await ApplyAsync();}
    private async Task LoadAsync(Filters filters,bool force)
    {
        if(_busy)return;
        _busy=true; _error=null; _validation=null;
        try
        {
            var date=DateOnly.FromDateTime(filters.AsOf);
            var dateText=date.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture);
            var rate=1m; var currencyName=_baseName;
            if(filters.Currency is Guid id && id!=_baseId)
            {
                var currency=_currencies.FirstOrDefault(c=>c.Id==id && c.IsActive)??throw new InvalidOperationException("العملة غير متاحة.");
                var effective=await Accounting.GetEffectiveExchangeRateAsync(id,date,ExchangeRateType.Accounting);
                if(effective is null || effective.Rate<=0)throw new InvalidOperationException("لا يوجد سعر صرف محاسبي صالح حتى تاريخ التقرير.");
                rate=effective.Rate;currencyName=$"{currency.NameAr} ({currency.Code})";
            }
            var snapshot=_snapshot;
            if(force || snapshot is null || snapshot.AsOf!=date)
                snapshot=await Api.GetAsync<SupplierDebtSnapshotDto>($"api/accounting/reports/suppliers/debt-snapshot?asOfDate={dateText}")??throw new InvalidOperationException("لم يُرجع الخادم بيانات التقرير.");
            if(_applied.Mode!=filters.Mode){_sortKey=filters.Mode=="summary"?"balance":"outstanding";_descending=true;}
            _snapshot=snapshot; _applied=filters;_rate=rate;_currencyName=currencyName;
            _options=new[]{new UiSelectOption("","جميع الموردين")}.Concat(snapshot.Suppliers.OrderBy(x=>x.SupplierCode).Select(x=>new UiSelectOption(x.SupplierId.ToString(),$"{x.SupplierCode} - {x.SupplierName}"))).ToArray();
            BuildRows();
        }
        catch(ApiClientException ex){_error="تعذر تحميل بيانات التقرير من الخادم.";ApiFeedback.Show(ex.Error);ClearRows();}
        catch(Exception ex){_error=ex.Message;ClearRows();}
        finally{_busy=false;}
    }
    private void ClearRows(){_rows=[];_scope=[];_open=[];_page=1;}
    private static int? DueDays(SupplierAgingLineDto x)=>x.NeedsReview?null:x.DaysPastDue;
    private static bool IsOverdue(SupplierAgingLineDto x)=>DueDays(x)>0;
    private bool DueMatches(SupplierAgingLineDto x)=>_applied.Due switch{"due"=>DueDays(x)>=0,"future"=>DueDays(x)<0,"today"=>DueDays(x)==0,"overdue"=>IsOverdue(x),"unknown"=>DueDays(x) is null,_=>true};
    private static decimal Sum(IEnumerable<SupplierAgingLineDto> list,Func<SupplierAgingLineDto,bool> match)=>list.Where(match).Sum(x=>x.OutstandingBaseAmount);
    private static string Normalize(string s)=>new(s.Select(c=>c is >= '\u0660' and <= '\u0669'?(char)('0'+c-'\u0660'):c is >= '\u06f0' and <= '\u06f9'?(char)('0'+c-'\u06f0'):c).ToArray());
    private bool Matches(string text)=>Normalize(text).Contains(Normalize(_search.Trim()),StringComparison.CurrentCultureIgnoreCase);
    private void BuildRows()
    {
        if(_snapshot is null || _error is not null)return;
        var invoices=_snapshot.Documents.ToLookup(x=>x.SupplierId);
        _scope=_snapshot.Suppliers.Where(c=>{
            var b=c;var amount=b.LiabilityBalanceBaseAmount;var magnitude=Math.Abs(amount/_rate);
            return (_applied.IncludeInactive||c.IsActive) && (string.IsNullOrEmpty(_applied.Supplier)||b.SupplierId.ToString()==_applied.Supplier)
            && (_applied.Balance switch{"debit"=>amount<0,"credit"=>amount>0,"zero"=>amount==0,"nonzero"=>amount!=0,_=>true})
            && (!_applied.Min.HasValue||magnitude>=_applied.Min.Value) && (!_applied.Max.HasValue||magnitude<=_applied.Max.Value)
            && (_applied.Due=="all"||invoices[b.SupplierId].Any(DueMatches))
            && (Matches($"{b.SupplierCode} {b.SupplierName} {b.AccountCode}")||(_applied.Mode=="detail"&&invoices[b.SupplierId].Any(x=>DueMatches(x)&&Matches(x.Reference))));
        }).ToList();
        // Balance filters select suppliers. In summary/aging, show all open documents of matching suppliers.
        _open=_scope.SelectMany(c=>invoices[c.SupplierId]).ToList();
        _rows=[];
        foreach(var c in _scope)
        {
            var b=c;var list=invoices[b.SupplierId];var overdue=Sum(list,IsOverdue);
            if(_applied.Mode=="summary")
            {
                var state=overdue>0?"متأخر":b.LiabilityBalanceBaseAmount<0?"مدين":b.LiabilityBalanceBaseAmount==0?"صفري":list.Any(x=>DueDays(x)==0)?"مستحق اليوم":list.Any(x=>DueDays(x) is null)||!list.Any()?"غير محدد":"منتظم";
                _rows.Add(new(b.SupplierId,b.SupplierId,[b.SupplierCode,b.SupplierName,b.DebitToDateBaseAmount,b.CreditToDateBaseAmount,b.LiabilityBalanceBaseAmount,overdue,state]));
            }
            else if(_applied.Mode=="aging")
            {
                _rows.Add(new(b.SupplierId,b.SupplierId,[b.SupplierCode,b.SupplierName,Sum(list,x=>DueDays(x)<0),Sum(list,x=>DueDays(x)==0),Sum(list,x=>DueDays(x) is >0 and <=30),Sum(list,x=>DueDays(x) is >30 and <=60),Sum(list,x=>DueDays(x) is >60 and <=90),Sum(list,x=>DueDays(x)>90),Sum(list,x=>DueDays(x) is null),list.Sum(x=>x.OutstandingBaseAmount)]));
            }
            else foreach(var x in list.Where(x=>DueMatches(x)&&(Matches($"{b.SupplierCode} {b.SupplierName} {b.AccountCode}")||Matches(x.Reference))))
            {
                var state=DueDays(x) switch{null=>"غير محدد",>0=>"متأخر",0=>"مستحق اليوم",_=>"غير مستحق"};
                _rows.Add(new(x.SourceId,b.SupplierId,[b.SupplierCode,b.SupplierName,x.SourceType=="SupplierOpening"?"رصيد افتتاحي":"فاتورة مشتريات",x.Reference,x.DocumentDate,x.DueDate,x.OriginalBaseAmount,x.PaymentBaseAmount,x.CreditAppliedBaseAmount,x.OpeningAppliedBaseAmount,x.OutstandingBaseAmount,DueDays(x) is int days ? (int?)Math.Max(0,days) : null,state]));
            }
        }
        if(_applied.Mode=="detail")
        {
            var visibleDocumentIds=_rows.Select(r=>r.Id).ToHashSet();
            _open=_open.Where(x=>visibleDocumentIds.Contains(x.SourceId)).ToList();
            var visibleSuppliers=_rows.Select(r=>r.SupplierId).ToHashSet();
            _scope=_scope.Where(c=>visibleSuppliers.Contains(c.SupplierId)).ToList();
        }
        Sort();_page=1;
    }
    private void OnSearch(string value){_search=value;BuildRows();}
    private void SortBy(string key){_descending=_sortKey==key&&!_descending;_sortKey=key;Sort();_page=1;}
    private void Sort(){var i=Array.FindIndex(Columns,c=>c.Key==_sortKey);if(i<0)return;_rows=(_descending?_rows.OrderByDescending(x=>x.Cells[i]):_rows.OrderBy(x=>x.Cells[i])).ThenBy(x=>x.Id).ToList();}
    private void GoPage(int page)=>_page=Math.Clamp(page,1,TotalPages);
    private void ChangePageSize(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var n)&&n is 10 or 25 or 50 or 100)_pageSize=n;_page=1;}
    private string Money(decimal v)=>(v/_rate).ToString("N2",CultureInfo.InvariantCulture);
    private string MetricMoney(decimal v)=>_error is not null||_busy?"—":Money(v);
    private string MetricCount(int v)=>_error is not null||_busy?"—":v.ToString("N0",CultureInfo.InvariantCulture);
    private string Display(object? v)=>v switch{null=>"—",decimal d=>Money(d),DateOnly date=>date.ToString("dd/MM/yyyy",CultureInfo.InvariantCulture),_=>v.ToString()??""};
    private string ReportSubtitle=>$"حتى {_applied.AsOf:dd/MM/yyyy} | {_currencyName} | {ModeName(_applied.Mode)} | الأرصدة من القيود المرحلة والاستحقاقات من المستندات المفتوحة | نطاق الرصيد المطلق: {_applied.Min?.ToString()??"—"} – {_applied.Max?.ToString()??"—"} | غير النشطين: {(_applied.IncludeInactive?"نعم":"لا")} | البحث: {_search}";
    private async Task PrintAsync(){if(!CanExport)return;await using var m=await JS.InvokeAsync<IJSObjectReference>("import","./js/customer-debts-export.js");await m.InvokeVoidAsync("printReport","مستحقات الموردين",ReportSubtitle,Chips.Select(x=>$"{x.Label}: {x.Value}").ToArray(),Columns.Select(x=>x.Label).ToArray(),_rows.Select(r=>r.Cells.Select(Display).ToArray()).ToArray());}
    private async Task ExportAsync(){if(!CanExport)return;var bytes=CustomerDebtsWorkbook.Create(ReportSubtitle+" | "+string.Join(" | ",Chips.Select(x=>$"{x.Label}: {x.Value}")),Columns.Select(x=>x.Label).ToArray(),_rows.Select(r=>r.Cells.Select(x=>x is decimal d?(object)(d/_rate):x is DateOnly date?date.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture):x).ToArray()), suppliers: true);await using var m=await JS.InvokeAsync<IJSObjectReference>("import","./js/customer-debts-export.js");await m.InvokeVoidAsync("saveWorkbook",Convert.ToBase64String(bytes),"supplier-debts.xlsx");}
}
