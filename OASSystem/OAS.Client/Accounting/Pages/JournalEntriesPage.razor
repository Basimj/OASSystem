@page "/accounting/journals"
@attribute [Authorize]
@inject IAccountingClientService AccountingService
@inject IUiSnackbarService Snackbar
@using OAS.Contracts.Accounting.Journals
@using OAS.Contracts.Accounting.Enums

<PageTitle>القيود المحاسبية | OAS</PageTitle>

<UiAccountingWorkspace>
    <Actions>
        <UiButton Text="قيد يومية جديد"
                  IconCssClass="fa-solid fa-plus"
                  Size="ControlSize.Small"
                  OnClick="OpenCreateModal" />
        <UiButton Text="تحديث"
                  IconCssClass="fa-solid fa-rotate"
                  Variant="ButtonVariant.Secondary"
                  Size="ControlSize.Small"
                  Loading="@_loading"
                  OnClick="LoadDataAsync" />
        <UiSearchInput @bind-Value="_searchTerm"
                       Placeholder="ابحث برقم القيد أو البيان..."
                       DebounceMilliseconds="300"
                       OnSearch="SearchChangedAsync" />
    </Actions>

    <Metrics>
        <UiAccountingMetricTile Label="إجمالي القيود" Value="@_totalCount.ToString()" IconCssClass="fa-solid fa-book" />
        <UiAccountingMetricTile Label="إجمالي المدين" Value="@_items.Sum(x => x.Lines.Sum(l => l.DebitAmount)).ToString("N2")" IconCssClass="fa-solid fa-arrow-down" Variant="UiAccountingMetricTile.MetricVariant.Debit" />
        <UiAccountingMetricTile Label="إجمالي الدائن" Value="@_items.Sum(x => x.Lines.Sum(l => l.CreditAmount)).ToString("N2")" IconCssClass="fa-solid fa-arrow-up" Variant="UiAccountingMetricTile.MetricVariant.Credit" />
    </Metrics>

    <Body>
        @if (_loading)
        {
            <UiAlert Message="جاري تحميل القيود المحاسبية..." Tone="AlertTone.Info" />
        }
        else if (_items.Count == 0)
        {
            <UiAlert Message="لا توجد قيود محاسبية مسجلة." Tone="AlertTone.Warning" />
        }
        else
        {
            @foreach (var entry in _items)
            {
                var debit = entry.Lines.Sum(l => l.DebitAmount);
                var credit = entry.Lines.Sum(l => l.CreditAmount);
                <UiJournalEntryCard EntryNumber="@entry.JournalNumber"
                                    DateText="@entry.PostingDate.ToString("yyyy-MM-dd")"
                                    EntryTypeText="@entry.JournalType.ToString()"
                                    Description="@entry.Description"
                                    TotalDebit="@debit"
                                    TotalCredit="@credit"
                                    IsBalanced="@(debit == credit)"
                                    StatusText="@entry.Status.ToString()"
                                    StatusState="@(entry.Status == JournalEntryStatus.Posted ? "posted" : (entry.Status == JournalEntryStatus.Draft ? "draft" : "reversed"))"
                                    CanPost="@(entry.Status == JournalEntryStatus.Draft)"
                                    CanReverse="@(entry.Status == JournalEntryStatus.Posted)"
                                    OnView="@(() => ViewEntry(entry))"
                                    OnPost="@(() => PostEntryAsync(entry))"
                                    OnReverse="@(() => ReverseEntryAsync(entry))" />
            }
        }

        @if (_selectedEntry is not null)
        {
            var selDebit = _selectedEntry.Lines.Sum(l => l.DebitAmount);
            var selCredit = _selectedEntry.Lines.Sum(l => l.CreditAmount);
            <UiCard Title="@($"تفاصيل القيد رقم: {_selectedEntry.JournalNumber}")" Subtitle="@(_selectedEntry.Description)">
                <UiJournalLinesTable Lines="@_viewLines"
                                     TotalDebit="@selDebit"
                                     TotalCredit="@selCredit" />
            </UiCard>
        }
    </Body>
</UiAccountingWorkspace>

@if (_showCreateModal)
{
    <UiAccountingDialog Title="إنشاء قيد يومية متوازن جديد" OnClose="CloseCreateModal">
        <ChildContent>
            <UiInputText Label="البيان العام للقيد" @bind-Value="_createDescription" />
            <UiAlert Message="سيتم توليد رقم القيد آلياً وضبط التاريخ لليوم مع خطوط الحسابات المتوازنة." Tone="AlertTone.Info" />
        </ChildContent>
        <Footer>
            <UiButton Text="حفظ القيد" IconCssClass="fa-solid fa-floppy-disk" Loading="@_saving" OnClick="SaveEntryAsync" />
            <UiButton Text="إلغاء" Variant="ButtonVariant.Ghost" OnClick="CloseCreateModal" />
        </Footer>
    </UiAccountingDialog>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string _searchTerm = string.Empty;
    private int _pageNumber = 1;
    private int _pageSize = 50;
    private long _totalCount;
    private IReadOnlyList<JournalEntryDto> _items = [];
    private JournalEntryDto? _selectedEntry;
    private IReadOnlyList<UiJournalLinesTable.JournalLineItem> _viewLines = [];

    private bool _showCreateModal;
    private string _createDescription = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var req = new PageRequest { PageNumber = _pageNumber, PageSize = _pageSize, Search = _searchTerm };
            var res = await AccountingService.GetJournalsPageAsync(req);
            _items = res.Items ?? [];
            _totalCount = res.TotalCount;
        }
        catch (Exception ex)
        {
            Snackbar.Error("تعذر تحميل القيود: " + ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchChangedAsync(string text)
    {
        _searchTerm = text;
        _pageNumber = 1;
        await LoadDataAsync();
    }

    private void ViewEntry(JournalEntryDto entry)
    {
        _selectedEntry = entry;
        _viewLines = entry.Lines.Select(l => new UiJournalLinesTable.JournalLineItem(
            l.AccountId.ToString()[..8],
            "حساب مالي",
            l.Description ?? string.Empty,
            l.CostCenterId?.ToString()[..8],
            l.DebitAmount,
            l.CreditAmount)).ToList();
    }

    private async Task PostEntryAsync(JournalEntryDto entry)
    {
        var req = new SetJournalEntryStatusRequest(JournalEntryStatus.Posted, entry.RowVersion);
        var ok = await AccountingService.SetJournalStatusAsync(entry.Id, req);
        if (ok)
        {
            Snackbar.Success("تم ترحيل القيد بنجاح.");
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Error("تعذر ترحيل القيد.");
        }
    }

    private async Task ReverseEntryAsync(JournalEntryDto entry)
    {
        var res = await AccountingService.ReverseJournalAsync(entry.Id);
        if (res is not null)
        {
            Snackbar.Success("تم عكس القيد بنجاح.");
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Error("تعذر عكس القيد.");
        }
    }

    private void OpenCreateModal()
    {
        _createDescription = string.Empty;
        _showCreateModal = true;
    }

    private void CloseCreateModal() => _showCreateModal = false;

    private async Task SaveEntryAsync()
    {
        if (string.IsNullOrWhiteSpace(_createDescription))
        {
            Snackbar.Warning("يرجى كتابة بيان القيد.");
            return;
        }

        _saving = true;
        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var req = new CreateJournalEntryRequest(
                JournalType.Manual,
                today,
                today,
                Guid.NewGuid(),
                _createDescription,
                null,
                null,
                null,
                []);

            var res = await AccountingService.CreateJournalAsync(req);
            if (res is not null)
            {
                Snackbar.Success("تم حفظ القيد.");
                CloseCreateModal();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Error("فشل حفظ القيد: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }
}
