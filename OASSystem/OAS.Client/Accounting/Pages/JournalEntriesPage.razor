@page "/accounting/journals"
@attribute [Authorize]
@using OAS.Client.Accounting.Components
@using OAS.Client.Accounting.Workspace

<PageTitle>القيود المحاسبية | OAS</PageTitle>

<AccountingWorkspaceHost Section="AccountingEntityType.Journals"
                         InitialRecordId="JournalIdFromQuery"
                         InitialJournalStatus="StatusFromQuery"
                         OpenNewJournalFromDashboard="OpenNewFromQuery" />

@code {
    [Parameter, SupplyParameterFromQuery(Name = "status")]
    public string? StatusFromQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "journalId")]
    public Guid? JournalIdFromQuery { get; set; }

    // The accounting dashboard's primary action opens the editor, not just the list.
    [Parameter, SupplyParameterFromQuery(Name = "new")]
    public bool OpenNewFromQuery { get; set; }
}
