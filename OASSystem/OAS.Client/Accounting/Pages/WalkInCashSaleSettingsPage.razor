@page "/accounting/settings/walk-in-customer"
@attribute [Authorize]
@using OAS.Contracts.Accounting.Settings
@using OAS.Contracts.Common.Pagination
@using OAS.Client.Accounting.Services
@using OAS.Client.Services.Http
@using OAS.UiLib.Core.Models
@inject IAccountingClientService Accounting
@inject OasApiClient Api
@inject OAS.UiLib.Services.Feedback.IUiSnackbarService Snackbar
@inject OAS.Client.Common.Feedback.Services.IApiFeedbackService ApiFeedback

<PageTitle>العميل النقدي الافتراضي | إعدادات المحاسبة | OAS</PageTitle>

<UiAccountingWorkspace ShowTabs="false">
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="حفظ الإعدادات" IconCssClass="fa-solid fa-floppy-disk"
                      Disabled="@_busy" Loading="@_busy" Size="ControlSize.Small" OnClick="SaveAsync" />
            <a class="ui-button ui-button--secondary ui-button--small" href="/accounting/settings">إعدادات المحاسبة</a>
            <a class="ui-button ui-button--ghost ui-button--small" href="/accounting/customers">إدارة العملاء</a>
        </UiWorkspaceActionBar>
    </Actions>
    <Body>
        <UiAccountingEditorSurface>
            <UiAccountingFormSection Title="إعدادات البيع النقدي المباشر"
                                     Subtitle="اختر سجل عميل عام واحدًا يستخدم حساب الذمم المرتبط به تلقائيًا، دون إنشاء حساب مستقل لكل زبون."
                                     IconCssClass="fa-solid fa-cash-register">
                <UiAccountingFormGrid Columns="2">
                    <UiLookup Label="العميل النقدي الافتراضي"
                              Value="@_customerId"
                              ValueChanged="OnCustomerChanged"
                              SelectedItem="@_selected"
                              SearchAsync="SearchCashCustomersAsync"
                              Placeholder="ابحث باسم العميل النقدي العام..."
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250"
                              EmptyText="أنشئ عميلًا نقديًا عامًا فعالًا وغير آجل أولًا."
                              ClearText="إلغاء العميل الافتراضي"
                              Disabled="@_busy" />
                </UiAccountingFormGrid>
                <UiAlert Tone="AlertTone.Info" Message="يشترط الدفع الكامل في فواتير العميل النقدي العام. البيع الجزئي والآجل يتطلبان اختيار عميل مسجل مختلف." />
                @if (_selected is not null)
                {
                    <p class="small">حساب الذمم سيكون الحساب الفرعي المرتبط بسجل العميل أعلاه. لا تختَر حساب التجميع الرئيسي.</p>
                }
            </UiAccountingFormSection>
        </UiAccountingEditorSurface>
    </Body>
</UiAccountingWorkspace>

@code {
    private bool _busy;
    private string _customerId = string.Empty;
    private UiLookupItem? _selected;
    private readonly Dictionary<string, UiLookupItem> _options = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            var current = await Api.GetAsync<WalkInCashCustomerSettingsDto>("api/accounting/walk-in-customer");
            _customerId = current?.CustomerId?.ToString("D") ?? string.Empty;
            _selected = current?.CustomerId is { } id
                ? new UiLookupItem(id.ToString("D"), $"{current.CustomerCode} - {current.CustomerName} | ذمم: {current.ReceivablesAccountCode}")
                : null;
        }
        catch (ApiClientException e) { ApiFeedback.Show(e.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private async Task<IReadOnlyList<UiLookupItem>> SearchCashCustomersAsync(string search, CancellationToken ct)
    {
        try
        {
            var page = await Accounting.GetCustomersPageAsync(new PageRequest
            {
                PageNumber = 1, PageSize = 40, Search = search
            }, cancellationToken: ct);
            var found = page.Items.Where(x => x.IsActive && !x.IsCreditAllowed)
                .Select(x => new UiLookupItem(x.Id.ToString("D"), $"{x.CustomerCode} - {x.NameAr} | ذمم: {x.AccountCode}"))
                .ToArray();
            foreach (var item in found) _options[item.Value] = item;
            return found;
        }
        catch (ApiClientException e) { ApiFeedback.Show(e.Error); return []; }
    }

    private Task OnCustomerChanged(string? value)
    {
        _customerId = value ?? string.Empty;
        _selected = _options.GetValueOrDefault(_customerId);
        return Task.CompletedTask;
    }

    private async Task SaveAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs _)
    {
        _busy = true;
        try
        {
            Guid? id = Guid.TryParse(_customerId, out var customer) ? customer : null;
            var saved = await Api.PutAsync<UpdateWalkInCashCustomerSettingsRequest, WalkInCashCustomerSettingsDto>(
                "api/accounting/walk-in-customer", new UpdateWalkInCashCustomerSettingsRequest(id));
            if (saved is null) return;
            _customerId = saved.CustomerId?.ToString("D") ?? string.Empty;
            _selected = saved.CustomerId.HasValue
                ? new UiLookupItem(saved.CustomerId.Value.ToString("D"), $"{saved.CustomerCode} - {saved.CustomerName} | ذمم: {saved.ReceivablesAccountCode}")
                : null;
            Snackbar.Success("تم حفظ إعدادات البيع النقدي المباشر.");
        }
        catch (ApiClientException e) { ApiFeedback.Show(e.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }
}
