@page "/accounting/cash-bank"
@attribute [Authorize]
@inject IAccountingClientService AccountingService
@inject IUiSnackbarService Snackbar
@using OAS.Contracts.Accounting.CashAccounts
@using OAS.Contracts.Accounting.BankAccounts

<PageTitle>الصندوق والبنوك | OAS</PageTitle>

<UiAccountingWorkspace>
    <Actions>
        <UiButton Text="تحديث"
                  IconCssClass="fa-solid fa-rotate"
                  Variant="ButtonVariant.Secondary"
                  Size="ControlSize.Small"
                  Loading="@_loading"
                  OnClick="LoadDataAsync" />
        <UiSearchInput @bind-Value="_searchTerm"
                       Placeholder="ابحث باسم الحساب أو الكود..."
                       DebounceMilliseconds="300"
                       OnSearch="SearchChangedAsync" />
    </Actions>

    <Metrics>
        <UiAccountingMetricTile Label="الخزائن النقدية" Value="@_cashAccounts.Count.ToString()" IconCssClass="fa-solid fa-vault" Variant="UiAccountingMetricTile.MetricVariant.Debit" />
        <UiAccountingMetricTile Label="الحسابات البنكية" Value="@_bankAccounts.Count.ToString()" IconCssClass="fa-solid fa-building-columns" Variant="UiAccountingMetricTile.MetricVariant.Balance" />
    </Metrics>

    <Body>
        <UiCard Title="خزائن الصندوق (Cash Accounts)" Subtitle="الخزائن النقدية ونقاط البيع">
            @if (_cashAccounts.Count == 0)
            {
                <UiAlert Message="لا توجد خزائن نقدية مسجلة." Tone="AlertTone.Warning" />
            }
            else
            {
                @foreach (var c in _cashAccounts)
                {
                    <UiCashAccountCard Code="@c.Code"
                                       NameAr="@c.Name"
                                       BranchName="الفرع الرئيسي"
                                       GlAccountCode="@c.AccountId.ToString()[..8]"
                                       CurrencyCode="SAR"
                                       RequiresShift="true"
                                       IsActive="@c.IsActive" />
                }
            }
        </UiCard>

        <UiCard Title="الحسابات البنكية (Bank Accounts)" Subtitle="البنوك والحسابات المصرفية الجارية">
            @if (_bankAccounts.Count == 0)
            {
                <UiAlert Message="لا توجد حسابات بنكية مسجلة." Tone="AlertTone.Warning" />
            }
            else
            {
                @foreach (var b in _bankAccounts)
                {
                    <UiBankAccountCard Code="@b.Code"
                                       BankName="@b.BankName"
                                       AccountName="@b.AccountName"
                                       AccountNumber="@b.AccountNumber"
                                       Iban="@(string.IsNullOrWhiteSpace(b.IBAN) ? "-" : b.IBAN)"
                                       GlAccountCode="@b.AccountId.ToString()[..8]"
                                       CurrencyCode="SAR"
                                       IsActive="@b.IsActive" />
                }
            }
        </UiCard>
    </Body>
</UiAccountingWorkspace>

@code {
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private IReadOnlyList<CashAccountDto> _cashAccounts = [];
    private IReadOnlyList<BankAccountDto> _bankAccounts = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var req = new PageRequest { PageNumber = 1, PageSize = 50, Search = _searchTerm };
            var cashRes = await AccountingService.GetCashAccountsPageAsync(req);
            _cashAccounts = cashRes.Items ?? [];

            var bankRes = await AccountingService.GetBankAccountsPageAsync(req);
            _bankAccounts = bankRes.Items ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Error("تعذر تحميل حسابات الصندوق والبنوك: " + ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchChangedAsync(string text)
    {
        _searchTerm = text;
        await LoadDataAsync();
    }
}
