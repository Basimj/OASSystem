@page "/accounting/customers/{CustomerId:guid}/account"
@attribute [Authorize]
@using OAS.Contracts.Accounting.Reports
@using OAS.Client.Services.Http
@using OAS.Client.Services.Browser
@using OAS.Client.Common.Feedback.Services
@using OAS.UiLib.Services.Feedback
@inject OasApiClient Api
@inject BrowserFileDownloadService Downloads
@inject IApiFeedbackService ApiFeedback
@inject IUiSnackbarService Snackbar
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>ملف العميل المالي | OAS</PageTitle>

<div class="customer-workspace-page" dir="rtl">
    <header class="cw-page-header">
        <div class="cw-heading">
            <div class="cw-breadcrumb">المحاسبة والمالية <span>/</span> العملاء <span>/</span> ملف العميل المالي</div>
            <h1>ملف العميل المالي</h1>
            <p>كشف الحساب، المستحقات، أعمار الديون والمستندات المرتبطة بالعميل في مكان واحد.</p>
        </div>
        <div class="cw-header-actions">
            <button type="button" class="cw-button cw-button--quiet" @onclick="BackToCustomersAsync"><span aria-hidden="true">←</span> قائمة العملاء</button>
            <button type="button" class="cw-button cw-button--quiet" @onclick="LoadAsync" disabled="@_busy">تحديث</button>
            <button type="button" class="cw-button cw-button--secondary" @onclick="ExportCsvAsync" disabled="@(_busy || _model is null)">تصدير الكشف</button>
            <a class="cw-button cw-button--primary" href="@($"/sales/customer-credits/{CustomerId:D}")">تطبيق المرتجعات</a>
            <button type="button" class="cw-button cw-button--quiet" @onclick="PrintAsync" disabled="@(_model is null)">طباعة</button>
        </div>
    </header>

    @if (_busy && _model is null)
    {
        <div class="cw-state-card"><span class="cw-spinner" aria-hidden="true"></span><div><strong>جارٍ تحميل ملف العميل</strong><p>يتم جلب الأرصدة والحركات والمستندات من النظام.</p></div></div>
    }
    else if (_model is not null)
    {
        <section class="cw-customer-banner">
            <div class="cw-customer-avatar" aria-hidden="true">@(_model.CustomerName.Length > 0 ? _model.CustomerName[..1] : "ع")</div>
            <div class="cw-customer-main">
                <span class="cw-eyebrow">بيانات العميل</span>
                <h2>@_model.CustomerName</h2>
                <div class="cw-customer-meta">
                    <span>رقم العميل: <strong>@_model.CustomerCode</strong></span>
                    <span>الحساب: <strong>@_model.Statement.AccountCode</strong></span>
                    <span>العملة: <strong>@_model.Statement.BaseCurrencyCode</strong></span>
                </div>
            </div>
            <div class="cw-closing-balance">
                <span>الرصيد الختامي</span>
                <strong>@_model.Statement.ClosingBase.ToString("N2")</strong>
                <small>@_model.Statement.BaseCurrencyCode · موجب = مدين، سالب = دائن</small>
            </div>
        </section>

        <section class="cw-filter-panel" aria-label="تحديد فترة التقرير">
            <div class="cw-date-field"><UiInputDate Label="من تاريخ" Value="@_from" ValueChanged="OnFromChanged" Size="ControlSize.Small" /></div>
            <div class="cw-date-field"><UiInputDate Label="إلى تاريخ" Value="@_to" ValueChanged="OnToChanged" Size="ControlSize.Small" /></div>
            <button type="button" class="cw-button cw-button--primary cw-show-report" @onclick="LoadAsync" disabled="@_busy">عرض التقرير</button>
            @if (_busy) { <span class="cw-loading-note">جارٍ التحديث...</span> }
        </section>

        <nav class="cw-section-nav" aria-label="أقسام ملف العميل">
            <a href="#cw-financial">المركز المالي</a>
            <a href="#cw-statement">كشف الحساب</a>
            <a href="#cw-aging">أعمار الديون</a>
            <a href="#cw-documents">مستندات العميل</a>
        </nav>

        <section id="cw-financial" class="cw-panel">
            <div class="cw-panel-heading"><div><h2>المركز المالي للعميل</h2><p>ملخص الحركة والأرصدة حتى تاريخ التقرير.</p></div><span class="cw-panel-icon" aria-hidden="true">▤</span></div>
            <div class="cw-metric-grid">
                <article class="cw-metric"><span>الرصيد الافتتاحي</span><strong>@_model.Statement.OpeningBase.ToString("N2")</strong><small>@_model.Statement.BaseCurrencyCode</small></article>
                <article class="cw-metric"><span>إجمالي المدين</span><strong>@_model.Statement.PeriodDebitBase.ToString("N2")</strong><small>حركة الفترة</small></article>
                <article class="cw-metric"><span>إجمالي الدائن</span><strong>@_model.Statement.PeriodCreditBase.ToString("N2")</strong><small>حركة الفترة</small></article>
                <article class="cw-metric cw-metric--accent"><span>المستحق على الفواتير</span><strong>@_model.Aging.TotalOutstandingBase.ToString("N2")</strong><small>@_model.Statement.BaseCurrencyCode</small></article>
                <article class="cw-metric"><span>مرتجعات غير مطبقة</span><strong>@_model.UnappliedReturnCreditsBase.ToString("N2")</strong><small>رصيد دائن متاح للمراجعة</small></article>
                <article class="cw-metric"><span>مقبوضات غير مخصصة</span><strong>@_model.UnappliedReceiptsBase.ToString("N2")</strong><small>تحتاج إلى تخصيص</small></article>
                <article class="cw-metric"><span>عربون العميل</span><strong>@_model.CustomerAdvancesLiabilityBase.ToString("N2")</strong><small>التزام مستقل عن الذمم</small></article>
            </div>
        </section>

        <section id="cw-statement" class="cw-panel">
            <div class="cw-panel-heading"><div><h2>كشف حساب العميل</h2><p>الحركات المرحلة من الأستاذ العام، مع رصيد متراكم بعد كل حركة.</p></div><span class="cw-record-count">@_model.Statement.TotalCount حركة</span></div>
            <div class="cw-table-wrap">
                <table class="cw-table">
                    <thead><tr><th>تاريخ الترحيل</th><th>رقم القيد</th><th>نوع المستند</th><th>البيان</th><th>مدين</th><th>دائن</th><th>الرصيد</th></tr></thead>
                    <tbody>
                        @foreach (var row in _model.Statement.Movements)
                        {
                            <tr>
                                <td data-label="تاريخ الترحيل">@row.PostingDate.ToString("yyyy-MM-dd")</td>
                                <td data-label="رقم القيد"><span class="cw-mono">@row.JournalNumber</span></td>
                                <td data-label="نوع المستند">@(row.SourceDocumentType ?? "تسوية")</td>
                                <td data-label="البيان" class="cw-description">@row.Description</td>
                                <td data-label="مدين" class="cw-number">@row.DebitBase.ToString("N2")</td>
                                <td data-label="دائن" class="cw-number">@row.CreditBase.ToString("N2")</td>
                                <td data-label="الرصيد" class="cw-number cw-number--strong">@row.BalanceBase.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_model.Statement.Movements.Count == 0) { <div class="cw-empty-state">لا توجد حركات في الفترة المحددة. جرّب تغيير تاريخ البداية أو النهاية.</div> }
            <div class="cw-table-summary">
                <div><span>إجمالي المدين</span><strong>@_model.Statement.PeriodDebitBase.ToString("N2")</strong></div>
                <div><span>إجمالي الدائن</span><strong>@_model.Statement.PeriodCreditBase.ToString("N2")</strong></div>
                <div><span>الرصيد الختامي</span><strong>@_model.Statement.ClosingBase.ToString("N2")</strong></div>
            </div>
            <div class="cw-pagination">
                <span>الصفحة @_page · إجمالي الحركات @_model.Statement.TotalCount</span>
                <div><button type="button" class="cw-button cw-button--quiet" disabled="@(_page <= 1 || _busy)" @onclick="PreviousAsync">السابق</button><button type="button" class="cw-button cw-button--quiet" disabled="@((long)_page * 50 >= _model.Statement.TotalCount || _busy)" @onclick="NextAsync">التالي</button></div>
            </div>
        </section>

        <section id="cw-aging" class="cw-panel">
            <div class="cw-panel-heading"><div><h2>أعمار ديون العميل</h2><p>تصنيف المبالغ المتبقية حسب تاريخ الاستحقاق المحفوظ للفواتير.</p></div><span class="cw-record-count">@_model.Aging.TotalCount فاتورة</span></div>
            <div class="cw-aging-grid">
                <article><span>غير مستحق</span><strong>@_model.Aging.NotDueBase.ToString("N2")</strong></article>
                <article><span>0–30 يومًا</span><strong>@_model.Aging.Days0To30Base.ToString("N2")</strong></article>
                <article><span>31–60 يومًا</span><strong>@_model.Aging.Days31To60Base.ToString("N2")</strong></article>
                <article><span>61–90 يومًا</span><strong>@_model.Aging.Days61To90Base.ToString("N2")</strong></article>
                <article class="cw-aging-danger"><span>أكثر من 90 يومًا</span><strong>@_model.Aging.Over90Base.ToString("N2")</strong></article>
                <article><span>استحقاق غير محدد</span><strong>@_model.Aging.UnknownBase.ToString("N2")</strong></article>
            </div>
            <div class="cw-table-wrap">
                <table class="cw-table cw-table--wide">
                    <thead><tr><th>الفاتورة</th><th>تاريخ الفاتورة</th><th>تاريخ الاستحقاق</th><th>العمر</th><th>الأصل</th><th>المدفوع</th><th>المرتجع</th><th>الرصيد المطبق</th><th>المتبقي</th></tr></thead>
                    <tbody>
                        @foreach (var row in _model.Aging.Invoices)
                        {
                            <tr>
                                <td data-label="الفاتورة"><span class="cw-mono">@row.InvoiceNumber</span></td>
                                <td data-label="تاريخ الفاتورة">@row.InvoiceDate.ToString("yyyy-MM-dd")</td>
                                <td data-label="تاريخ الاستحقاق">@(row.DueDate?.ToString("yyyy-MM-dd") ?? "غير محدد")</td>
                                <td data-label="العمر"><span class="cw-status">@ArabicBucket(row.Bucket)</span></td>
                                <td data-label="الأصل" class="cw-number">@row.OriginalBase.ToString("N2")</td>
                                <td data-label="المدفوع" class="cw-number">@row.PaymentBase.ToString("N2")</td>
                                <td data-label="المرتجع" class="cw-number">@row.ReturnBase.ToString("N2")</td>
                                <td data-label="الرصيد المطبق" class="cw-number">@row.CreditAppliedBase.ToString("N2")</td>
                                <td data-label="المتبقي" class="cw-number cw-number--strong">@row.OutstandingBase.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_model.Aging.Invoices.Count == 0) { <div class="cw-empty-state">لا توجد فواتير مفتوحة ضمن أعمار الديون في هذه الفترة.</div> }
        </section>

        <section id="cw-documents" class="cw-panel">
            <div class="cw-panel-heading"><div><h2>مستندات العميل</h2><p>الفواتير والمرتجعات وسندات القبض والعربون وتسويات الرصيد الدائن.</p></div></div>
            <div class="cw-document-tabs" role="group" aria-label="نوع المستند">
                <button type="button" class="@(_docKind == "invoices" ? "is-active" : "")" aria-pressed="@(_docKind == "invoices")" @onclick='() => ChangeDocumentKindAsync("invoices")'>الفواتير</button>
                <button type="button" class="@(_docKind == "returns" ? "is-active" : "")" aria-pressed="@(_docKind == "returns")" @onclick='() => ChangeDocumentKindAsync("returns")'>المرتجعات</button>
                <button type="button" class="@(_docKind == "receipts" ? "is-active" : "")" aria-pressed="@(_docKind == "receipts")" @onclick='() => ChangeDocumentKindAsync("receipts")'>سندات القبض</button>
                <button type="button" class="@(_docKind == "advances" ? "is-active" : "")" aria-pressed="@(_docKind == "advances")" @onclick='() => ChangeDocumentKindAsync("advances")'>العربون</button>
                <button type="button" class="@(_docKind == "credits" ? "is-active" : "")" aria-pressed="@(_docKind == "credits")" @onclick='() => ChangeDocumentKindAsync("credits")'>تطبيق الرصيد / الاسترداد</button>
            </div>
            @if (_documents is not null)
            {
                <div class="cw-table-wrap">
                    <table class="cw-table">
                        <thead><tr><th>رقم المستند</th><th>النوع</th><th>التاريخ</th><th>المبلغ الأساسي</th><th>العملة</th><th>الحالة</th><th>القيد</th></tr></thead>
                        <tbody>
                            @foreach (var doc in _documents.Rows)
                            {
                                <tr>
                                    <td data-label="رقم المستند"><span class="cw-mono">@doc.Number</span></td><td data-label="النوع">@doc.Kind</td>
                                    <td data-label="التاريخ">@doc.PostingDate.ToString("yyyy-MM-dd")</td>
                                    <td data-label="المبلغ الأساسي" class="cw-number">@doc.BaseAmount.ToString("N2")</td>
                                    <td data-label="العملة">@doc.Currency</td><td data-label="الحالة"><span class="cw-status">@doc.Status</span></td>
                                    <td data-label="القيد"><span class="cw-mono">@(doc.JournalEntryId?.ToString("D") ?? "—")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (_documents.Rows.Count == 0) { <div class="cw-empty-state">لا توجد مستندات من هذا النوع حتى تاريخ التقرير.</div> }
                <div class="cw-pagination">
                    <span>صفحة @_docPage · إجمالي المستندات @_documents.TotalCount</span>
                    <div><button type="button" class="cw-button cw-button--quiet" disabled="@(_docPage <= 1 || _busy)" @onclick="DocumentPreviousAsync">السابق</button><button type="button" class="cw-button cw-button--quiet" disabled="@((long)_docPage * 50 >= _documents.TotalCount || _busy)" @onclick="DocumentNextAsync">التالي</button></div>
                </div>
            }
        </section>
    }
    else if (!_busy)
    {
        <div class="cw-empty-state">تعذر تحميل ملف العميل. حاول التحديث أو ارجع إلى قائمة العملاء.</div>
    }
</div>

@code {
    [Parameter] public Guid CustomerId { get; set; }
    private CustomerArWorkspaceDto? _model;
    private DateOnly? _from = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly? _to = DateOnly.FromDateTime(DateTime.Today);
    private int _page = 1;
    private bool _busy;
    private string _docKind = "invoices";
    private int _docPage = 1;
    private CustomerArDocumentPageDto? _documents;

    protected override async Task OnParametersSetAsync()
    {
        _page = 1;
        _docPage = 1;
        await LoadAsync();
    }

    private void OnFromChanged(DateOnly? value)
    {
        _from = value;
        if (_to < _from) _to = _from;
        _page = 1;
    }
    private void OnToChanged(DateOnly? value)
    {
        _to = value;
        if (_from > _to) _from = _to;
        _page = 1;
    }
    private async Task PreviousAsync() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextAsync() { _page++; await LoadAsync(); }

    private async Task LoadAsync()
    {
        if (CustomerId == Guid.Empty || !_from.HasValue || !_to.HasValue) return;
        _busy = true;
        try
        {
            var url = $"api/accounting/reports/customers/{CustomerId:D}/workspace?fromDate={_from:yyyy-MM-dd}&toDate={_to:yyyy-MM-dd}&pageNumber={_page}&pageSize=50";
            _model = await Api.GetAsync<CustomerArWorkspaceDto>(url);
            await LoadDocumentsAsync();
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private async Task ChangeDocumentKindAsync(string kind)
    {
        _docKind = kind;
        _docPage = 1;
        await LoadDocumentsAsync();
    }
    private async Task DocumentPreviousAsync()
    {
        if (_docPage > 1) { _docPage--; await LoadDocumentsAsync(); }
    }
    private async Task DocumentNextAsync() { _docPage++; await LoadDocumentsAsync(); }
    private async Task LoadDocumentsAsync()
    {
        if (!_to.HasValue) return;
        try
        {
            var uri = $"api/accounting/reports/customers/{CustomerId:D}/documents?asOfDate={_to:yyyy-MM-dd}&kind={_docKind}&pageNumber={_docPage}&pageSize=50";
            _documents = await Api.GetAsync<CustomerArDocumentPageDto>(uri);
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
    }

    private async Task ExportCsvAsync()
    {
        if (!_from.HasValue || !_to.HasValue || _busy) return;
        _busy = true;
        try
        {
            var uri = $"api/accounting/reports/customers/{CustomerId:D}/statement.csv?fromDate={_from:yyyy-MM-dd}&toDate={_to:yyyy-MM-dd}";
            var bytes = await Api.GetFileAsync(uri);
            await Downloads.DownloadAsync(bytes, $"Customer-{CustomerId:N}-Statement.csv", "text/csv;charset=utf-8");
            Snackbar.Success("تم تجهيز كشف حساب العميل للتصدير.");
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _busy = false; }
    }

    private Task BackToCustomersAsync()
    {
        Navigation.NavigateTo("/accounting/customers");
        return Task.CompletedTask;
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("print").AsTask();
    private static string ArabicBucket(string bucket) => bucket switch
    {
        "NotDue" => "غير مستحق", "0-30" => "0–30", "31-60" => "31–60",
        "61-90" => "61–90", "+90" => ">90", _ => "مراجعة الاستحقاق"
    };
}
