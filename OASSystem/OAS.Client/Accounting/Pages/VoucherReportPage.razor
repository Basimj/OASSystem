@page "/accounting/reports/vouchers"
@attribute [Authorize]
@using OAS.UiLib.Components.Reports
<PageTitle>سندات القبض والصرف | OAS</PageTitle>
<div class="trial-report">
<UiReportWorkspace Title="سندات القبض والصرف" TitleIcon="fa-solid fa-receipt" StatusText="@Status" Search="@_search" SearchChanged="OnSearch" FiltersOpen="@_filtersOpen" FiltersOpenChanged="@(v => _filtersOpen = v)">
    <Toolbar>
        <button type="button" class="oas-report__tool" title="تحديث" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-rotate"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--pdf" title="حفظ PDF" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-regular fa-file-pdf"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--excel" title="Excel" disabled="@(!CanExport)" @onclick="ExportAsync"><i class="fa-regular fa-file-excel"></i></button>
        <button type="button" class="oas-report__tool" title="طباعة" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-solid fa-print"></i></button>
        <button type="button" class="oas-report__tool" title="إظهار أو إخفاء الفلاتر" @onclick="@(() => _filtersOpen = !_filtersOpen)"><i class="fa-solid fa-ellipsis-vertical"></i></button>
    </Toolbar>
    <QuickFilters>
        @foreach(var chip in Chips){<div class="oas-report__chip" title="@chip"><strong>@chip</strong></div>}
    </QuickFilters>
    <FilterPanel>
        <div class="trial-fields">
            <label class="oas-report__field">نوع التقرير<select @bind="_draft.Mode" @bind:after="ModeChanged">@foreach(var m in Modes){<option value="@m.Key">@m.Value</option>}</select></label>
            <label class="oas-report__field">السنة المالية<select value="@_draft.Year" @onchange="OnYear" disabled="@_busy"><option value="">نطاق مخصص</option>@foreach(var y in _years){<option value="@y.Id">@y.Name</option>}</select></label>
            <label class="oas-report__field">الفترة المالية<select value="@_draft.Period" @onchange="OnPeriod" disabled="@(_busy || string.IsNullOrEmpty(_draft.Year) || !PeriodOptions.Any())"><option value="">جميع الفترات</option>@foreach(var p in PeriodOptions){<option value="@p.Id">@p.Name</option>}</select></label>
            @if (_referenceWarning is not null) { <div class="trial-warning" role="status">@_referenceWarning</div> }
            <div class="oas-report__date-pair">
                <label class="oas-report__field">من تاريخ<input type="date" @bind="_draft.From" @bind:format="yyyy-MM-dd" disabled="@(!string.IsNullOrEmpty(_draft.Year))" /></label>
                <label class="oas-report__field">إلى تاريخ<input type="date" @bind="_draft.To" @bind:format="yyyy-MM-dd" disabled="@(!string.IsNullOrEmpty(_draft.Year))" /></label>
            </div>
            <label class="oas-report__field">نوع السند<select @bind="_draft.Kind"><option value="all">الكل</option><option value="receipt">قبض</option><option value="payment">صرف</option></select></label>
            <label class="oas-report__field">حالة السند<select @bind="_draft.Status"><option value="posted">المرحلة (شامل العكس)</option><option value="all">الكل</option><option value="draft">مسودة</option><option value="approved">معتمد</option><option value="cancelled">ملغى</option><option value="reversed">معكوس</option></select></label>
            <div class="oas-report__field"><UiReportSearchPicker Label="الحساب المحاسبي" DialogTitle="اختيار الحساب" Value="@_draft.Account" ValueChanged="OnAccount" Options="@AccountOptions" Placeholder="الكل" /></div>
            <div class="oas-report__field"><UiReportSearchPicker Label="الصندوق / البنك" DialogTitle="اختيار الصندوق أو البنك" Value="@_draft.Settlement" ValueChanged="OnSettlement" Options="@SettlementOptions" Placeholder="الكل" /></div>
            <label class="oas-report__field">عملة السند<select @bind="_draft.Currency"><option value="">الكل</option>@foreach(var c in Currencies){<option value="@c.Id">@c.Name (@c.Code)</option>}</select></label>
            <label class="oas-report__field">وسيلة الدفع<select @bind="_draft.Method"><option value="">الكل</option><option value="1">نقدي</option><option value="2">بطاقة</option><option value="3">تحويل بنكي</option><option value="4">شيك</option><option value="5">أخرى</option></select></label>
            @if (!PartyMode)
            {
                <label class="oas-report__field">نوع الطرف<select @bind="_draft.PartyType"><option value="">الكل</option><option value="1">عميل</option><option value="2">مورد</option><option value="3">موظف</option><option value="4">أخرى</option></select></label>
            }
            <label class="oas-report__field">@PartyLabel<input @bind="_draft.Party" maxlength="200" /></label>
            <label class="oas-report__field">المستخدم المرحّل<select @bind="_draft.PostedBy"><option value="">الكل</option>@foreach(var op in Operators){<option value="@op.Id">@op.Name</option>}</select></label>
            <label class="oas-report__field">عملة العرض<select @bind="_draft.DisplayCurrency"><option value="">@BaseCode (الأساسية)</option>@foreach(var c in Currencies.Where(c=>c.Id!=_report?.BaseCurrencyId)){<option value="@c.Id">@c.Name (@c.Code)</option>}</select></label>
            @if (_validation is not null){<div class="trial-warning" role="alert">@_validation</div>}
        </div>
        <div class="oas-report__apply"><button type="button" class="primary" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-filter"></i> تطبيق</button><button type="button" disabled="@_busy" @onclick="ResetAsync"><i class="fa-solid fa-rotate-left"></i> إعادة تعيين</button></div>
    </FilterPanel>
    <TableContent>
        @if (CanExport && _report is not null && _report.Warnings.Count > 0)
        {
            <details class="cashbank-notes" open><summary>ملاحظات التقرير (@_report.Warnings.Count)</summary>@foreach(var warning in _report.Warnings){<div>@warning</div>}</details>
        }
        <table class="oas-report__table trial-table cashbank-table">
            <thead><tr>@for(var i=0;i<Headers.Length;i++){var index=i;<UiReportSortHeader Label="@(Headers[index])" Active="@(_sort==index)" Descending="@_descending" OnSort="@(()=>SortBy(index))" />}</tr></thead>
            <tbody>
                @if(_busy){<tr><td colspan="@Headers.Length" class="oas-report__empty">جارٍ تحميل التقرير...</td></tr>}
                else if(_error is not null){<tr><td colspan="@Headers.Length" class="oas-report__empty" role="alert">@_error</td></tr>}
                else if(_visible.Count==0){<tr><td colspan="@Headers.Length" class="oas-report__empty">لا توجد بيانات مطابقة.</td></tr>}
                else
                {
                    @foreach(var row in PageRows)
                    {
                        <tr>
                            @foreach(var cell in row.Cells)
                            {
                                <td class="@(cell.Format=="text"?"":"oas-report__amount") @(cell.Amount<0?"oas-report__debit":"")">
                                    @if(cell.LinkId.HasValue && cell.LinkKind is not null){<button type="button" class="trial-link" title="فتح التفاصيل" @onclick="()=>OpenLink(cell)">@Format(cell)</button>}
                                    else { @Format(cell) }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
            @if(CanExport && _report?.TotalRow is { } total)
            {
                <tfoot><tr class="trial-total">@foreach(var cell in total.Cells){<td class="@(cell.Format=="text"?"":"oas-report__amount")">@Format(cell)</td>}</tr></tfoot>
            }
        </table>
    </TableContent>
    <Pagination>
        <div class="oas-report__pager"><button @onclick="@(()=>GoPage(1))" disabled="@(_page==1)">»</button><button @onclick="@(()=>GoPage(_page-1))" disabled="@(_page==1)">‹</button><button class="active" disabled>@_page</button><button @onclick="@(()=>GoPage(_page+1))" disabled="@(_page>=TotalPages)">›</button><button @onclick="@(()=>GoPage(TotalPages))" disabled="@(_page>=TotalPages)">«</button></div>
        <span>عرض @(_visible.Count==0?0:(_page-1)*_pageSize+1) - @Math.Min(_page*_pageSize,_visible.Count) من @_visible.Count</span>
        <label>لكل صفحة <select value="@_pageSize" @onchange="ChangePageSize"><option>10</option><option>25</option><option>50</option><option>100</option></select></label>
    </Pagination>
    <Metrics>
        @for(var i=0;i<6;i++)
        {
            var metric = _report?.Metrics.ElementAtOrDefault(i);
            <UiReportMetric Label="@(metric?.Label??DefaultMetricLabels[i])" Value="@(CanExport && metric is not null?Format(metric.Value):"—")" Tone="@(Tones[i])" Icon="@(Icons[i])" />
        }
    </Metrics>
</UiReportWorkspace>
</div>
