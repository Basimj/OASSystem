@page "/accounting/expenses"
@attribute [Authorize]
@inject IAccountingClientService AccountingService
@inject IUiSnackbarService Snackbar
@using OAS.Contracts.Accounting.Expenses
@using OAS.Contracts.Accounting.Enums

<PageTitle>إدارة المصروفات | OAS</PageTitle>

<UiAccountingWorkspace>
    <Actions>
        <UiButton Text="تسجيل مصروف جديد"
                  IconCssClass="fa-solid fa-plus"
                  Size="ControlSize.Small"
                  OnClick="OpenCreateModal" />
        <UiButton Text="تحديث"
                  IconCssClass="fa-solid fa-rotate"
                  Variant="ButtonVariant.Secondary"
                  Size="ControlSize.Small"
                  Loading="@_loading"
                  OnClick="LoadDataAsync" />
        <UiSearchInput @bind-Value="_searchTerm"
                       Placeholder="ابحث برقم المصروف أو البيان..."
                       DebounceMilliseconds="300"
                       OnSearch="SearchChangedAsync" />
    </Actions>

    <Metrics>
        <UiAccountingMetricTile Label="إجمالي المصروفات" Value="@_totalCount.ToString()" IconCssClass="fa-solid fa-receipt" />
        <UiAccountingMetricTile Label="المبلغ الإجمالي" Value="@_items.Sum(x => x.Amount).ToString("N2")" IconCssClass="fa-solid fa-money-bill-wave" Variant="UiAccountingMetricTile.MetricVariant.Credit" />
    </Metrics>

    <Body>
        @if (_loading)
        {
            <UiAlert Message="جاري تحميل المصروفات..." Tone="AlertTone.Info" />
        }
        else if (_items.Count == 0)
        {
            <UiAlert Message="لا توجد مصروفات مسجلة." Tone="AlertTone.Warning" />
        }
        else
        {
            @foreach (var exp in _items)
            {
                <UiExpenseCard ExpenseNumber="@exp.ExpenseNumber"
                               DateText="@exp.ExpenseDate.ToString("yyyy-MM-dd")"
                               ExpenseTypeName="@(string.IsNullOrWhiteSpace(exp.Beneficiary) ? "مصروف عام" : exp.Beneficiary)"
                               Amount="@exp.Amount"
                               TaxAmount="0"
                               TotalAmount="@exp.Amount"
                               PaymentMethodText="@exp.PaymentMethod.ToString()"
                               Description="@exp.Description"
                               StatusText="@exp.Status.ToString()"
                               StatusState="@(exp.Status == ExpenseStatus.Posted ? "posted" : "draft")"
                               CanPost="@(exp.Status == ExpenseStatus.Draft)"
                               OnPost="@(() => PostExpenseAsync(exp))" />
            }
        }
    </Body>
</UiAccountingWorkspace>

@if (_showCreateModal)
{
    <UiAccountingDialog Title="تسجيل مصروف تشغيلي جديد" OnClose="CloseCreateModal">
        <ChildContent>
            <UiInputText Label="المستفيد / الجهة" @bind-Value="_createBeneficiary" />
            <UiAccountingMoneyInput @bind-Value="_createAmount" Currency="ر.س" IsCredit="true" />
            <UiInputText Label="بيان المصروف" @bind-Value="_createDesc" />
        </ChildContent>
        <Footer>
            <UiButton Text="حفظ المصروف" IconCssClass="fa-solid fa-floppy-disk" Loading="@_saving" OnClick="SaveExpenseAsync" />
            <UiButton Text="إلغاء" Variant="ButtonVariant.Ghost" OnClick="CloseCreateModal" />
        </Footer>
    </UiAccountingDialog>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string _searchTerm = string.Empty;
    private int _pageNumber = 1;
    private int _pageSize = 50;
    private long _totalCount;
    private IReadOnlyList<ExpenseDto> _items = [];

    private bool _showCreateModal;
    private string _createBeneficiary = string.Empty;
    private string _createDesc = string.Empty;
    private decimal _createAmount;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var req = new PageRequest { PageNumber = _pageNumber, PageSize = _pageSize, Search = _searchTerm };
            var res = await AccountingService.GetExpensesPageAsync(req);
            _items = res.Items ?? [];
            _totalCount = res.TotalCount;
        }
        catch (Exception ex)
        {
            Snackbar.Error("تعذر تحميل المصروفات: " + ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchChangedAsync(string text)
    {
        _searchTerm = text;
        _pageNumber = 1;
        await LoadDataAsync();
    }

    private async Task PostExpenseAsync(ExpenseDto exp)
    {
        var req = new SetExpenseStatusRequest(ExpenseStatus.Posted, exp.RowVersion);
        var ok = await AccountingService.SetExpenseStatusAsync(exp.Id, req);
        if (ok)
        {
            Snackbar.Success("تم ترحيل المصروف بنجاح.");
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Error("تعذر ترحيل المصروف.");
        }
    }

    private void OpenCreateModal()
    {
        _createBeneficiary = string.Empty;
        _createDesc = string.Empty;
        _createAmount = 0;
        _showCreateModal = true;
    }

    private void CloseCreateModal() => _showCreateModal = false;

    private async Task SaveExpenseAsync()
    {
        if (_createAmount <= 0)
        {
            Snackbar.Warning("يرجى إدخال مبلغ صحيح للمصروف.");
            return;
        }

        _saving = true;
        try
        {
            var req = new CreateExpenseRequest(
                DateOnly.FromDateTime(DateTime.Today),
                Guid.NewGuid(),
                Guid.NewGuid(),
                _createBeneficiary,
                _createAmount,
                PaymentMethod.Cash,
                null,
                null,
                _createDesc);

            var res = await AccountingService.CreateExpenseAsync(req);
            if (res is not null)
            {
                Snackbar.Success("تم حفظ المصروف بنجاح.");
                CloseCreateModal();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Error("فشل حفظ المصروف: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }
}
