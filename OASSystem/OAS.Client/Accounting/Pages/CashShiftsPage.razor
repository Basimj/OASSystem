@page "/accounting/cash-shifts"
@attribute [Authorize]
@inject IAccountingClientService AccountingService
@inject IUiSnackbarService Snackbar
@using OAS.Contracts.Accounting.CashShifts
@using OAS.Contracts.Accounting.Enums

<PageTitle>ورديات الصندوق | OAS</PageTitle>

<UiAccountingWorkspace>
    <Actions>
        <UiButton Text="فتح وردية جديدة"
                  IconCssClass="fa-solid fa-plus"
                  Size="ControlSize.Small"
                  OnClick="OpenCreateModal" />
        <UiButton Text="تحديث"
                  IconCssClass="fa-solid fa-rotate"
                  Variant="ButtonVariant.Secondary"
                  Size="ControlSize.Small"
                  Loading="@_loading"
                  OnClick="LoadDataAsync" />
        <UiSearchInput @bind-Value="_searchTerm"
                       Placeholder="ابحث برقم الوردية..."
                       DebounceMilliseconds="300"
                       OnSearch="SearchChangedAsync" />
    </Actions>

    <Metrics>
        <UiAccountingMetricTile Label="إجمالي الورديات" Value="@_totalCount.ToString()" IconCssClass="fa-solid fa-cash-register" />
        <UiAccountingMetricTile Label="الورديات المفتوحة" Value="@_items.Count(x => x.Status == CashShiftStatus.Open).ToString()" IconCssClass="fa-solid fa-door-open" Variant="UiAccountingMetricTile.MetricVariant.Debit" />
        <UiAccountingMetricTile Label="الورديات المغلقة بانتظار الاعتماد" Value="@_items.Count(x => x.Status == CashShiftStatus.Closed).ToString()" IconCssClass="fa-solid fa-clock" Variant="UiAccountingMetricTile.MetricVariant.Balance" />
    </Metrics>

    <Body>
        @if (_loading)
        {
            <UiAlert Message="جاري تحميل ورديات الصندوق..." Tone="AlertTone.Info" />
        }
        else if (_items.Count == 0)
        {
            <UiAlert Message="لا توجد ورديات صندوق مسجلة." Tone="AlertTone.Warning" />
        }
        else
        {
            @foreach (var s in _items)
            {
                <UiCashShiftCard ShiftNumber="@s.ShiftNumber"
                                 CashierName="@($"كاشير: {s.OpenedBy.ToString()[..8]}")"
                                 StartedAtText="@s.OpenedAtUtc.ToString("yyyy-MM-dd HH:mm")"
                                 OpeningCash="@s.OpeningBalance"
                                 EndingCash="@s.ActualClosingBalance"
                                 Variance="@s.DifferenceAmount"
                                 StatusText="@s.Status.ToString()"
                                 StatusState="@(s.Status == CashShiftStatus.Approved ? "approved" : (s.Status == CashShiftStatus.Open ? "open" : "closed"))"
                                 CanClose="@(s.Status == CashShiftStatus.Open)"
                                 CanApprove="@(s.Status == CashShiftStatus.Closed)"
                                 OnClose="@(() => OpenCloseShiftModal(s))"
                                 OnApprove="@(() => ApproveShiftAsync(s))" />
            }
        }
    </Body>
</UiAccountingWorkspace>

@if (_showCreateModal)
{
    <UiAccountingDialog Title="فتح وردية صندوق جديدة" OnClose="CloseCreateModal">
        <ChildContent>
            <UiAlert Message="أدخل رصيد العهدة النقدية الافتتاحي لبدء الوردية." Tone="AlertTone.Info" />
            <UiAccountingMoneyInput @bind-Value="_createOpeningCash" Currency="ر.س" IsDebit="true" />
        </ChildContent>
        <Footer>
            <UiButton Text="بدء الوردية" IconCssClass="fa-solid fa-play" Loading="@_saving" OnClick="SaveCreateShiftAsync" />
            <UiButton Text="إلغاء" Variant="ButtonVariant.Ghost" OnClick="CloseCreateModal" />
        </Footer>
    </UiAccountingDialog>
}

@if (_showCloseModal && _targetShift is not null)
{
    <UiAccountingDialog Title="@($"إغلاق الوردية رقم: {_targetShift.ShiftNumber}")" OnClose="CloseCloseShiftModal">
        <ChildContent>
            <UiAlert Message="أدخل مبلغ النقد الفعلي الموجود في الدرج وقت الإغلاق." Tone="AlertTone.Warning" />
            <UiAccountingMoneyInput @bind-Value="_closingEndingCash" Currency="ر.س" IsDebit="true" />
        </ChildContent>
        <Footer>
            <UiButton Text="تأكيد إغلاق الوردية" IconCssClass="fa-solid fa-lock" Loading="@_saving" OnClick="ConfirmCloseShiftAsync" />
            <UiButton Text="إلغاء" Variant="ButtonVariant.Ghost" OnClick="CloseCloseShiftModal" />
        </Footer>
    </UiAccountingDialog>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string _searchTerm = string.Empty;
    private int _pageNumber = 1;
    private int _pageSize = 50;
    private long _totalCount;
    private IReadOnlyList<CashShiftDto> _items = [];

    private bool _showCreateModal;
    private decimal _createOpeningCash;

    private bool _showCloseModal;
    private CashShiftDto? _targetShift;
    private decimal _closingEndingCash;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var req = new PageRequest { PageNumber = _pageNumber, PageSize = _pageSize, Search = _searchTerm };
            var res = await AccountingService.GetCashShiftsPageAsync(req);
            _items = res.Items ?? [];
            _totalCount = res.TotalCount;
        }
        catch (Exception ex)
        {
            Snackbar.Error("تعذر تحميل ورديات الصندوق: " + ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchChangedAsync(string text)
    {
        _searchTerm = text;
        _pageNumber = 1;
        await LoadDataAsync();
    }

    private void OpenCreateModal()
    {
        _createOpeningCash = 0;
        _showCreateModal = true;
    }

    private void CloseCreateModal() => _showCreateModal = false;

    private async Task SaveCreateShiftAsync()
    {
        _saving = true;
        try
        {
            var req = new CreateCashShiftRequest(Guid.NewGuid(), _createOpeningCash);
            var res = await AccountingService.CreateCashShiftAsync(req);
            if (res is not null)
            {
                Snackbar.Success("تم فتح الوردية بنجاح.");
                CloseCreateModal();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Error("فشل فتح الوردية: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenCloseShiftModal(CashShiftDto shift)
    {
        _targetShift = shift;
        _closingEndingCash = shift.OpeningBalance;
        _showCloseModal = true;
    }

    private void CloseCloseShiftModal() => _showCloseModal = false;

    private async Task ConfirmCloseShiftAsync()
    {
        if (_targetShift is null) return;
        _saving = true;
        try
        {
            var req = new SetCashShiftClosingRequest(_closingEndingCash, _targetShift.RowVersion);
            var res = await AccountingService.CloseCashShiftAsync(_targetShift.Id, req);
            if (res is not null)
            {
                Snackbar.Success("تم إغلاق الوردية بنجاح.");
                CloseCloseShiftModal();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Error("فشل إغلاق الوردية: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ApproveShiftAsync(CashShiftDto shift)
    {
        var res = await AccountingService.ApproveCashShiftAsync(shift.Id, shift.RowVersion);
        if (res is not null)
        {
            Snackbar.Success("تم اعتماد الوردية بنجاح.");
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Error("تعذر اعتماد الوردية.");
        }
    }
}
