@page "/accounting/receipt-vouchers"
@attribute [Authorize]
@using OAS.Client.Accounting.Components
@using OAS.Client.Accounting.Workspace

<PageTitle>سندات القبض | OAS</PageTitle>

<AccountingWorkspaceHost Section="AccountingEntityType.ReceiptVouchers"
                         InitialRecordId="@VoucherIdFromQuery"
                         OpenNewRecordFromDashboard="@OpenNewFromQuery" />

@code {
    [Parameter, Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "voucherId")]
    public Guid? VoucherIdFromQuery { get; set; }

    [Parameter, Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "new")]
    public bool OpenNewFromQuery { get; set; }
}
