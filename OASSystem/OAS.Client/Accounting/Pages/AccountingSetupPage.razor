@page "/accounting/settings"
@page "/accounting/currencies"
@page "/accounting/exchange-rates"
@page "/accounting/employee-accounts"

@attribute [Authorize]

@using OAS.Contracts.Accounting.Enums

<PageTitle>إعدادات المحاسبة والعملات | OAS</PageTitle>

<UiAccountingWorkspace ShowTabs="false">
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="تحديث"
                      IconCssClass="fa-solid fa-rotate"
                      Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small"
                      Loading="@_busy"
                      OnClick="LoadAsync" />
        </UiWorkspaceActionBar>
    </Actions>

    <Body>
        <UiAccountingEditorSurface>
            <UiAccountingFormSection Title="إعدادات المحاسبة الأساسية"
                                     Subtitle="حدد العملة الأساسية والحسابات الرئيسية وحسابات الترحيل، بما فيها دفعات العملاء المقدمة، التي يستخدمها النظام تلقائيًا."
                                     IconCssClass="fa-solid fa-sliders">
                <UiAccountingFormGrid Columns="3">
                    <UiSelect Label="العملة الأساسية"
                              Value="@ToLookupValue(_settingsBaseCurrencyId)"
                              ValueChanged="SetBaseCurrency"
                              Options="@BaseCurrencyOptions"
                              Placeholder="-- اختر العملة --"
                              Size="ControlSize.Small" />

                    <UiLookup Label="الحساب الرئيسي لذمم الموظفين"
                              Value="@ToLookupValue(_settingsEmployeeParentAccountId)"
                              ValueChanged="SetEmployeeParentAccount"
                              SelectedItem="@EmployeeParentAccountLookupItem"
                              SearchAsync="SearchParentAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات مطابقة."
                              ClearText="إلغاء اختيار حساب ذمم الموظفين"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="200" />

                    <UiLookup Label="الحساب الرئيسي للصناديق"
                              Value="@ToLookupValue(_settingsCashParentAccountId)"
                              ValueChanged="SetCashParentAccount"
                              SelectedItem="@CashParentAccountLookupItem"
                              SearchAsync="SearchParentAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات مطابقة."
                              ClearText="إلغاء اختيار الحساب الرئيسي للصناديق"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="200" />

                    <UiLookup Label="الحساب الرئيسي للبنوك"
                              Value="@ToLookupValue(_settingsBankParentAccountId)"
                              ValueChanged="SetBankParentAccount"
                              SelectedItem="@BankParentAccountLookupItem"
                              SearchAsync="SearchParentAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات مطابقة."
                              ClearText="إلغاء اختيار الحساب الرئيسي للبنوك"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="200" />

                    <UiLookup Label="حساب إيرادات المبيعات"
                              Value="@ToLookupValue(_settingsSalesRevenueAccountId)"
                              ValueChanged="SetSalesRevenueAccount"
                              SelectedItem="@SalesRevenueAccountLookupItem"
                              SearchAsync="SearchSalesRevenueAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات إيرادات صالحة للترحيل."
                              ClearText="إلغاء اختيار حساب إيرادات المبيعات"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب الضرائب المستحقة"
                              Value="@ToLookupValue(_settingsTaxPayableAccountId)"
                              ValueChanged="SetTaxPayableAccount"
                              SelectedItem="@TaxPayableAccountLookupItem"
                              SearchAsync="SearchTaxPayableAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات التزامات صالحة للترحيل."
                              ClearText="إلغاء اختيار حساب الضرائب المستحقة"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب دفعات مقدمة من العملاء"
                              Value="@ToLookupValue(_settingsCustomerAdvancesAccountId)"
                              ValueChanged="SetCustomerAdvancesAccount"
                              SelectedItem="@CustomerAdvancesAccountLookupItem"
                              SearchAsync="SearchCustomerAdvancesAccountsAsync"
                              Placeholder="ابحث عن حساب التزام دائن..."
                              EmptyText="لا توجد حسابات التزامات صالحة لعربون العميل."
                              ClearText="إلغاء اختيار حساب دفعات مقدمة من العملاء"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب المخزون"
                              Value="@ToLookupValue(_settingsInventoryAccountId)"
                              ValueChanged="SetInventoryAccount"
                              SelectedItem="@InventoryAccountLookupItem"
                              SearchAsync="SearchInventoryAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات أصول صالحة للترحيل."
                              ClearText="إلغاء اختيار حساب المخزون"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب تكلفة البضاعة المباعة"
                              Value="@ToLookupValue(_settingsCogsAccountId)"
                              ValueChanged="SetCogsAccount"
                              SelectedItem="@CogsAccountLookupItem"
                              SearchAsync="SearchCogsAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات مصروفات صالحة للترحيل."
                              ClearText="إلغاء اختيار حساب تكلفة البضاعة المباعة"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب بضاعة مستلمة غير مفوترة (GRNI)"
                              Value="@ToLookupValue(_settingsGrniAccountId)"
                              ValueChanged="SetGrniAccount"
                              SelectedItem="@GrniAccountLookupItem"
                              SearchAsync="SearchGrniAccountsAsync"
                              Placeholder="ابحث عن حساب التزام دائن..."
                              EmptyText="لا توجد حسابات التزامات صالحة لـ GRNI."
                              ClearText="إلغاء اختيار حساب GRNI"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب ضريبة المشتريات"
                              Value="@ToLookupValue(_settingsPurchaseTaxAccountId)"
                              ValueChanged="SetPurchaseTaxAccount"
                              SelectedItem="@PurchaseTaxAccountLookupItem"
                              SearchAsync="SearchPurchaseTaxAccountsAsync"
                              Placeholder="ابحث عن حساب أصل مدين..."
                              EmptyText="لا توجد حسابات أصول صالحة لضريبة المشتريات."
                              ClearText="إلغاء اختيار حساب ضريبة المشتريات"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب فرق سعر المشتريات"
                              Value="@ToLookupValue(_settingsPurchasePriceVarianceAccountId)"
                              ValueChanged="SetPurchasePriceVarianceAccount"
                              SelectedItem="@PurchasePriceVarianceAccountLookupItem"
                              SearchAsync="SearchPurchasePriceVarianceAccountsAsync"
                              Placeholder="ابحث عن حساب مصروف مدين..."
                              EmptyText="لا توجد حسابات مصروفات صالحة لفروقات سعر المشتريات."
                              ClearText="إلغاء اختيار حساب فرق سعر المشتريات"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب أرباح فروقات الصرف"
                              Value="@ToLookupValue(_settingsExchangeGainAccountId)"
                              ValueChanged="SetExchangeGainAccount"
                              SelectedItem="@ExchangeGainAccountLookupItem"
                              SearchAsync="SearchExchangeGainAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات مطابقة."
                              ClearText="إلغاء اختيار حساب أرباح فروق العملة"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب خسائر فروقات الصرف"
                              Value="@ToLookupValue(_settingsExchangeLossAccountId)"
                              ValueChanged="SetExchangeLossAccount"
                              SelectedItem="@ExchangeLossAccountLookupItem"
                              SearchAsync="SearchExchangeLossAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات مطابقة."
                              ClearText="إلغاء اختيار حساب خسائر فروق العملة"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />

                    <UiLookup Label="حساب الأرباح المحتجزة"
                              Value="@ToLookupValue(_settingsRetainedEarningsAccountId)"
                              ValueChanged="SetRetainedEarningsAccount"
                              SelectedItem="@RetainedEarningsAccountLookupItem"
                              SearchAsync="SearchRetainedEarningsAccountsAsync"
                              Placeholder="ابحث برقم الحساب أو الاسم..."
                              EmptyText="لا توجد حسابات حقوق ملكية صالحة للترحيل."
                              ClearText="إلغاء اختيار حساب الأرباح المحتجزة"
                              MinimumSearchLength="0"
                              DebounceMilliseconds="250" />
                </UiAccountingFormGrid>

                <UiAlert Message="البحث يعرض الحسابات المطابقة ويعطّل الحساب غير المؤهل مع توضيح السبب. للمشتريات: المخزون أصل مدين، GRNI التزام دائن، ضريبة المشتريات أصل مدين، وفرق سعر المشتريات مصروف مدين. عند حفظ المجموعة كاملة ينشئ النظام أو يحدّث ملفات ترحيل PurchaseReceipt وPurchaseInvoice تلقائيًا. جميع الحسابات يجب أن تكون نشطة وقابلة للترحيل."
                         Tone="AlertTone.Info" />

                @if (_settings is null)
                {
                    <UiAlert Message="لن يبدأ استخدام Multi-Currency في المستندات الجديدة قبل حفظ هذه الإعدادات."
                             Tone="AlertTone.Warning" />
                }

                <UiButton Text="حفظ الإعدادات"
                          IconCssClass="fa-solid fa-floppy-disk"
                          Size="ControlSize.Small"
                          Disabled="@_busy"
                          OnClick="SaveSettingsAsync" />
            </UiAccountingFormSection>

            <UiAccountingFormSection Title="العملات"
                                     Subtitle="إدارة العملات ودقتها. كود العملة لا يتغير بعد الإنشاء."
                                     IconCssClass="fa-solid fa-coins">
                <UiAccountingFormGrid Columns="4">
                    <UiInputText Label="الكود"
                                 Value="@_currencyCode"
                                 ValueChanged="@(value => _currencyCode = value ?? string.Empty)"
                                 ValueExpression="@(() => _currencyCode)"
                                 Disabled="@_editingCurrencyId.HasValue" />

                    <UiInputText Label="الاسم العربي"
                                 Value="@_currencyNameAr"
                                 ValueChanged="@(value => _currencyNameAr = value ?? string.Empty)"
                                 ValueExpression="@(() => _currencyNameAr)" />

                    <UiInputText Label="الاسم الإنجليزي"
                                 Value="@_currencyNameEn"
                                 ValueChanged="@(value => _currencyNameEn = value)"
                                 ValueExpression="@(() => _currencyNameEn)" />

                    <UiInputText Label="الرمز"
                                 Value="@_currencySymbol"
                                 ValueChanged="@(value => _currencySymbol = value)"
                                 ValueExpression="@(() => _currencySymbol)" />

                    <UiSelect Label="الدقة"
                              Value="@_currencyDecimalPlaces.ToString()"
                              ValueChanged="SetCurrencyDecimalPlaces"
                              Options="@CurrencyDecimalOptions"
                              Size="ControlSize.Small" />

                    <UiCheckbox Label="نشطة"
                                Value="@_currencyIsActive"
                                ValueChanged="@(value => _currencyIsActive = value)" />
                </UiAccountingFormGrid>

                <UiWorkspaceActionBar>
                    <UiButton Text="@(_editingCurrencyId.HasValue ? "حفظ" : "إضافة")"
                              IconCssClass="fa-solid fa-check"
                              Size="ControlSize.Small"
                              OnClick="SaveCurrencyAsync" />
                    @if (_editingCurrencyId.HasValue)
                    {
                        <UiButton Text="إلغاء"
                                  IconCssClass="fa-solid fa-xmark"
                                  Variant="ButtonVariant.Ghost"
                                  Size="ControlSize.Small"
                                  OnClick="CancelCurrencyEdit" />
                    }
                </UiWorkspaceActionBar>
            </UiAccountingFormSection>

            <UiAccountingFormSection Title="قائمة العملات"
                                     Subtitle="العملات المعرفة حاليًا في المحاسبة"
                                     IconCssClass="fa-solid fa-list">
                @if (_currencies.Count == 0)
                {
                    <UiAccountingEmptyState Title="لا توجد عملات"
                                            Description="أضف أول عملة لبدء إعداد المحاسبة متعددة العملات."
                                            IconCssClass="fa-solid fa-coins" />
                }
                else
                {
                    <UiStackLayout Gap="StackGap.Small">
                        @foreach (var currency in _currencies)
                        {
                            <UiAccountingFormSection Title="@($"{currency.Code} - {currency.NameAr}")"
                                                     Subtitle="@(IsBaseCurrency(currency.Id) ? "العملة الأساسية" : (currency.IsActive ? "نشطة" : "معطلة"))"
                                                     IconCssClass="fa-solid fa-coins">
                                <UiAccountingFormGrid Columns="4">
                                    <UiAccountingReadOnlyValue Label="الرمز" Value="@(currency.Symbol ?? "—")" />
                                    <UiAccountingReadOnlyValue Label="الدقة" Value="@currency.DecimalPlaces.ToString()" />
                                    <UiAccountingReadOnlyValue Label="الحالة" Value="@(currency.IsActive ? "نشطة" : "معطلة")" />
                                    <UiButton Text="تعديل"
                                              IconCssClass="fa-solid fa-pen"
                                              Variant="ButtonVariant.Ghost"
                                              Size="ControlSize.Small"
                                              OnClick="@(() => EditCurrency(currency))" />
                                </UiAccountingFormGrid>
                            </UiAccountingFormSection>
                        }
                    </UiStackLayout>
                }
            </UiAccountingFormSection>

            <UiAccountingFormSection Title="أسعار الصرف"
                                     Subtitle="السعر = عدد وحدات العملة الأساسية مقابل وحدة واحدة من العملة المحددة."
                                     IconCssClass="fa-solid fa-arrow-right-arrow-left">
                <UiAccountingFormGrid Columns="4">
                    <UiSelect Label="العملة"
                              Value="@ToLookupValue(_rateCurrencyId)"
                              ValueChanged="SetRateCurrency"
                              Options="@RateCurrencyOptions"
                              Placeholder="-- اختر العملة --"
                              Disabled="@_editingRateId.HasValue"
                              Size="ControlSize.Small" />

                    <UiInputDate Label="تاريخ السعر"
                                 Value="@_rateDate"
                                 ValueExpression="@(() => _rateDate)"
                                 ValueChanged="@(value => _rateDate = value)"
                                 Required="true"
                                 Size="ControlSize.Small" />

                    <UiAccountingNumberField Label="السعر"
                                             Value="@_rateValue"
                                             ValueChanged="@(value => _rateValue = value)"
                                             Disabled="@IsSelectedRateBaseCurrency"
                                             Step="0.00000001"
                                             Min="0.00000001"
                                             Hint="@(IsSelectedRateBaseCurrency ? "سعر العملة الأساسية ثابت = 1." : null)" />

                    <UiSelect Label="نوع السعر"
                              Value="@RateTypeValue"
                              ValueChanged="SetRateType"
                              Options="@RateTypeOptions"
                              Size="ControlSize.Small" />

                    <UiCheckbox Label="نشط"
                                Value="@_rateIsActive"
                                ValueChanged="@(value => _rateIsActive = value)" />
                </UiAccountingFormGrid>

                @if (IsSelectedRateBaseCurrency)
                {
                    <UiAlert Message="هذه هي العملة الأساسية وسعر صرفها ثابت = 1."
                             Tone="AlertTone.Info" />
                }

                <UiWorkspaceActionBar>
                    <UiButton Text="@(_editingRateId.HasValue ? "حفظ" : "إضافة")"
                              IconCssClass="fa-solid fa-check"
                              Size="ControlSize.Small"
                              OnClick="SaveRateAsync" />
                    @if (_editingRateId.HasValue)
                    {
                        <UiButton Text="إلغاء"
                                  IconCssClass="fa-solid fa-xmark"
                                  Variant="ButtonVariant.Ghost"
                                  Size="ControlSize.Small"
                                  OnClick="CancelRateEdit" />
                    }
                </UiWorkspaceActionBar>
            </UiAccountingFormSection>

            <UiAccountingFormSection Title="قائمة أسعار الصرف"
                                     Subtitle="أسعار الصرف المسجلة مرتبة حسب التاريخ"
                                     IconCssClass="fa-solid fa-chart-line">
                @if (_rates.Count == 0)
                {
                    <UiAccountingEmptyState Title="لا توجد أسعار صرف"
                                            Description="أضف سعر صرف للعملات غير الأساسية."
                                            IconCssClass="fa-solid fa-arrow-right-arrow-left" />
                }
                else
                {
                    <UiStackLayout Gap="StackGap.Small">
                        @foreach (var rate in _rates)
                        {
                            <UiAccountingFormSection Title="@rate.CurrencyCode"
                                                     Subtitle="@(IsBaseCurrency(rate.CurrencyId) ? "العملة الأساسية" : (rate.IsActive ? "نشط" : "معطل"))"
                                                     IconCssClass="fa-solid fa-arrow-right-arrow-left">
                                <UiAccountingFormGrid Columns="4">
                                    <UiAccountingReadOnlyValue Label="التاريخ" Value="@rate.RateDate.ToString("yyyy-MM-dd")" />
                                    <UiAccountingReadOnlyValue Label="السعر" Value="@FormatExchangeRate(rate.Rate)" />
                                    <UiAccountingReadOnlyValue Label="النوع" Value="@(rate.RateType == ExchangeRateType.Accounting ? "محاسبي" : rate.RateType.ToString())" />
                                    <UiButton Text="تعديل"
                                              IconCssClass="fa-solid fa-pen"
                                              Variant="ButtonVariant.Ghost"
                                              Size="ControlSize.Small"
                                              OnClick="@(() => EditRate(rate))" />
                                </UiAccountingFormGrid>
                            </UiAccountingFormSection>
                        }
                    </UiStackLayout>
                }
            </UiAccountingFormSection>

            <UiAccountingFormSection Title="الربط المحاسبي للموظفين"
                                     Subtitle="يتم إنشاء الحساب المحاسبي للموظف فقط عند تفعيله محاسبيًا هنا."
                                     IconCssClass="fa-solid fa-user-tie">
                <UiAccountingFormGrid Columns="2">
                    <UiSelect Label="الموظف"
                              Value="@ToLookupValue(_employeeToActivateId)"
                              ValueChanged="SetEmployeeToActivate"
                              Options="@AvailableEmployeeOptions"
                              Placeholder="-- اختر موظفًا --"
                              Size="ControlSize.Small" />

                    <UiButton Text="تفعيل محاسبي"
                              IconCssClass="fa-solid fa-user-plus"
                              Size="ControlSize.Small"
                              Disabled="@(!_employeeToActivateId.HasValue)"
                              OnClick="ActivateEmployeeAsync" />
                </UiAccountingFormGrid>

                @if (_employeeAccounts.Count == 0)
                {
                    <UiAccountingEmptyState Title="لا توجد روابط محاسبية للموظفين"
                                            Description="اختر موظفًا نشطًا ثم فعّله محاسبيًا."
                                            IconCssClass="fa-solid fa-user-tie" />
                }
                else
                {
                    <UiStackLayout Gap="StackGap.Small">
                        @foreach (var item in _employeeAccounts)
                        {
                            <UiAccountingFormSection Title="@($"{item.EmployeeCode} - {item.EmployeeName}")"
                                                     Subtitle="@($"{item.AccountCode} - {item.AccountName}")"
                                                     IconCssClass="fa-solid fa-user-tie">
                                <UiAccountingFormGrid Columns="2">
                                    <UiAccountingReadOnlyValue Label="الحالة" Value="@(item.IsActive ? "نشط" : "معطل")" />
                                    <UiButton Text="@(item.IsActive ? "تعطيل" : "تفعيل")"
                                              IconCssClass="fa-solid fa-power-off"
                                              Variant="ButtonVariant.Ghost"
                                              Size="ControlSize.Small"
                                              OnClick="@(() => ToggleEmployeeAccountAsync(item))" />
                                </UiAccountingFormGrid>
                            </UiAccountingFormSection>
                        }
                    </UiStackLayout>
                }
            </UiAccountingFormSection>
        </UiAccountingEditorSurface>
    </Body>
</UiAccountingWorkspace>
