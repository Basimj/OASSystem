@page "/accounting/suppliers"
@attribute [Authorize]
@using OAS.UiLib.Components.Accounting.Parties
@using OAS.UiLib.Components.Spreadsheets
@using OAS.UiLib.Components.Navigation
@using OAS.Client.Accounting.Components

<PageTitle>الموردون | المحاسبة | OAS</PageTitle>

<SupplierRelatedPageHeader Title="الموردون"
                           IsListView="@(!EditorOpen)"
                           TabItems="@WorkspaceTabs"
                           OnTabSelect="SelectTabAsync"
                           OnTabClose="CloseTabAsync"
                           OnTabCloseOthers="CloseOtherTabsAsync"
                           OnTabCloseAll="CloseAllTabsAsync">
    <Actions>
        @if (!EditorOpen)
        {
            <button type="button" class="crh-button crh-button--primary" disabled="@_busy" @onclick="NewAsync"><i class="fa-solid fa-plus"></i> مورد جديد</button>
            <button type="button" class="crh-button" disabled="@_busy" @onclick="OpenImport">استيراد</button>
            <button type="button" class="crh-button" disabled="@_busy" @onclick="DownloadTemplateAsync">قالب Excel</button>
            <button type="button" class="crh-button" disabled="@_busy" @onclick="ExportAsync">تصدير</button>
            <button type="button" class="crh-button" disabled="@_busy" @onclick="LoadAsync">تحديث</button>
            <a class="crh-button" href="/accounting/suppliers/aging">أعمار ديون الموردين</a>
            <a class="crh-button" href="/accounting/suppliers/openings">الأرصدة الافتتاحية</a>
        }
    </Actions>
</SupplierRelatedPageHeader>

@if (!EditorOpen)
{
    <UiSupplierListDashboard HideDefaultHeader="true" Busy="@_busy"
                             Items="@_items"
                             Search="@_search"
                             Filter="@_filter"
                             PageNumber="@_pageNumber"
                             TotalPages="@_totalPages"
                             TotalCount="@_totalCount"
                             SearchChanged="SetSearch"
                             OnSearch="SearchAsync"
                             FilterChanged="FilterChangedAsync"
                             OnNew="NewAsync"
                             OnRefresh="LoadAsync"
                             OnOpen="OpenAsync"
                             OnEdit="OpenSupplierForEditingAsync"
                             OnPreviousPage="PreviousPageAsync"
                             OnNextPage="NextPageAsync"
                             OnImport="OpenImport"
                             OnTemplate="DownloadTemplateAsync"
                             OnExport="ExportAsync" />
}
else
{
    <UiSupplierProfileWorkspace @key="ActiveEditorTab!.TabId"
                                Busy="@_busy"
                                IsNew="@IsNew"
                                StartInEditMode="@(_startInEditModeFor.HasValue && _startInEditModeFor == ActiveEditorTab?.EntityId)"
                                Form="@ActiveForm"
                                ParentLookupItem="@ParentAccountLookupItem"
                                ParentSearchAsync="SearchParentAccountsAsync"
                                OnFormChanged="MarkActiveTabDirty"
                                OnBack="BackToSupplierListAsync"
                                OnSave="SaveAsync"
                                OnCancel="CancelAsync"
                                OnToggleStatus="ToggleStatusAsync" />
}

@if (_importOpen)
{
    <UiSpreadsheetImport @key="_importKey"
                         Title="الموردين"
                         Busy="@_spreadsheetBusy"
                         Preview="@UiPreview"
                         OnValidate="PreviewImportAsync"
                         OnConfirm="ConfirmImportAsync"
                         OnClear="ClearImport"
                         OnClose="CloseImport" />
}
