@page "/accounting/suppliers"
@attribute [Authorize]
@using OAS.UiLib.Components.Accounting.Parties
@using OAS.UiLib.Components.Spreadsheets
@using OAS.UiLib.Components.Navigation

<PageTitle>الموردون | المحاسبة | OAS</PageTitle>

<div class="oas-customer-workspace-tabs" dir="rtl">
    <UiApplicationTabStrip Tabs="@WorkspaceTabs"
                           AriaLabel="تبويبات الموردين"
                           EnableContextMenu="true"
                           OnSelect="SelectTabAsync"
                           OnClose="CloseTabAsync"
                           OnCloseOthers="CloseOtherTabsAsync"
                           OnCloseAll="CloseAllTabsAsync" />
</div>

@if (!EditorOpen)
{
    <UiSupplierListDashboard Busy="@_busy"
                             Items="@_items"
                             Search="@_search"
                             Filter="@_filter"
                             PageNumber="@_pageNumber"
                             TotalPages="@_totalPages"
                             TotalCount="@_totalCount"
                             SearchChanged="SetSearch"
                             OnSearch="SearchAsync"
                             FilterChanged="FilterChangedAsync"
                             OnNew="NewAsync"
                             OnRefresh="LoadAsync"
                             OnOpen="OpenAsync"
                             OnEdit="OpenSupplierForEditingAsync"
                             OnPreviousPage="PreviousPageAsync"
                             OnNextPage="NextPageAsync"
                             OnImport="OpenImport"
                             OnTemplate="DownloadTemplateAsync"
                             OnExport="ExportAsync" />
}
else
{
    <UiSupplierProfileWorkspace @key="ActiveEditorTab!.TabId"
                                Busy="@_busy"
                                IsNew="@IsNew"
                                StartInEditMode="@(_startInEditModeFor.HasValue && _startInEditModeFor == ActiveEditorTab?.EntityId)"
                                Form="@ActiveForm"
                                ParentLookupItem="@ParentAccountLookupItem"
                                ParentSearchAsync="SearchParentAccountsAsync"
                                OnFormChanged="MarkActiveTabDirty"
                                OnBack="BackToSupplierListAsync"
                                OnSave="SaveAsync"
                                OnCancel="CancelAsync"
                                OnToggleStatus="ToggleStatusAsync" />
}

@if (_importOpen)
{
    <UiSpreadsheetImport @key="_importKey"
                         Title="الموردين"
                         Busy="@_spreadsheetBusy"
                         Preview="@UiPreview"
                         OnValidate="PreviewImportAsync"
                         OnConfirm="ConfirmImportAsync"
                         OnClear="ClearImport"
                         OnClose="CloseImport" />
}
