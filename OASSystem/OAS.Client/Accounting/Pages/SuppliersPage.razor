@page "/accounting/suppliers"
@attribute [Authorize]
@using OAS.UiLib.Components.Accounting.Parties
@using OAS.UiLib.Components.Spreadsheets

<PageTitle>الموردون | المحاسبة | OAS</PageTitle>

<div class="d-flex gap-2 flex-wrap align-items-center px-2 py-2" dir="rtl">
    <a class="btn btn-outline-primary btn-sm" href="/accounting/suppliers/aging">أعمار ديون الموردين</a>
    <a class="btn btn-outline-secondary btn-sm" href="/accounting/suppliers/openings">الأرصدة الافتتاحية للموردين</a>
    @if (ActiveEditorTab?.EntityId is Guid selectedSupplierId)
    {
        <a class="btn btn-primary btn-sm" href="@("/accounting/suppliers/" + selectedSupplierId.ToString("D") + "/center")">مركز المورد المالي</a>
    }
</div>

<UiAccountingPartyWorkspace IsSupplier="true"
                            Busy="@_busy"
                            EditorOpen="@EditorOpen"
                            IsNew="@IsNew"
                            Form="@ActiveForm"
                            Items="@_items"
                            WorkspaceTabs="@WorkspaceTabs"
                            OnSelectTab="SelectTabAsync"
                            OnCloseTab="CloseTabAsync"
                            OnCloseOtherTabs="CloseOtherTabsAsync"
                            OnCloseAllTabs="CloseAllTabsAsync"
                            OnFormChanged="MarkActiveTabDirty"
                            ParentLookupItem="@ParentAccountLookupItem"
                            ParentSearchAsync="SearchParentAccountsAsync"
                            Search="@_search"
                            Filter="@_filter"
                            PageNumber="@_pageNumber"
                            TotalPages="@_totalPages"
                            TotalCount="@_totalCount"
                            SearchChanged="SetSearch"
                            FilterChanged="FilterChangedAsync"
                            OnSearch="SearchAsync"
                            OnNew="NewAsync"
                            OnRefresh="LoadAsync"
                            OnOpen="OpenAsync"
                            OnSave="SaveAsync"
                            OnCancel="CancelAsync"
                            OnToggleStatus="ToggleStatusAsync"
                            OnPreviousPage="PreviousPageAsync"
                            OnNextPage="NextPageAsync"
                            OnImport="OpenImport"
                            OnTemplate="DownloadTemplateAsync"
                            OnExport="ExportAsync" />

@if (_importOpen)
{
    <UiSpreadsheetImport @key="_importKey"
                         Title="الموردين"
                         Busy="@_spreadsheetBusy"
                         Preview="@UiPreview"
                         OnValidate="PreviewImportAsync"
                         OnConfirm="ConfirmImportAsync"
                         OnClear="ClearImport"
                         OnClose="CloseImport" />
}
