@page "/accounting/customers"
@attribute [Authorize]
@using OAS.UiLib.Components.Accounting.Parties
@using OAS.UiLib.Components.Spreadsheets
@using OAS.UiLib.Components.Navigation
@using OAS.Client.Accounting.Components

<PageTitle>العملاء | المحاسبة | OAS</PageTitle>

<div class="oas-customer-document-header">
@if (EditorOpen)
{
    <CustomerRelatedPageHeader Title="تفاصيل العميل"
                               CustomerId="@(ActiveEditorTab?.EntityId ?? Guid.Empty)"
                               TabItems="@WorkspaceTabs"
                               OnTabSelect="SelectTabAsync"
                               OnTabClose="CloseTabAsync"
                               OnTabCloseOthers="CloseOtherTabsAsync"
                               OnTabCloseAll="CloseAllTabsAsync" />
}
else
{
    <CustomerRelatedPageHeader Title="جميع العملاء"
                               IsListView="true"
                               TabItems="@WorkspaceTabs"
                               OnTabSelect="SelectTabAsync"
                               OnTabClose="CloseTabAsync"
                               OnTabCloseOthers="CloseOtherTabsAsync"
                               OnTabCloseAll="CloseAllTabsAsync">
        <Actions>
            <button type="button" class="crh-button crh-button--primary" disabled="@_busy" @onclick="NewCustomerWithSuggestedAccountAsync"><i class="fa-solid fa-plus" aria-hidden="true"></i> عميل جديد</button>
            <button type="button" class="crh-button" disabled="@_busy" @onclick="OpenImport"><i class="fa-solid fa-file-import" aria-hidden="true"></i> استيراد</button>
            <button type="button" class="crh-button" disabled="@_busy" @onclick="DownloadTemplateAsync"><i class="fa-solid fa-download" aria-hidden="true"></i> قالب Excel</button>
            <button type="button" class="crh-button" disabled="@_busy" @onclick="ExportAsync"><i class="fa-solid fa-file-export" aria-hidden="true"></i> تصدير</button>
            <button type="button" class="crh-button" disabled="@_busy" @onclick="LoadAsync"><i class="fa-solid fa-rotate" aria-hidden="true"></i> تحديث</button>
            <a class="crh-button" href="/accounting/customer-ar"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i> أرصدة العملاء</a>
        </Actions>
    </CustomerRelatedPageHeader>
}
</div>

@* The list and editor retain their dedicated layout and share one tab state. *@
@if (!EditorOpen)
{
    <UiCustomerListDashboard HideDefaultHeader="true" Busy="@_busy"
                             Items="@_items"
                             Search="@_search"
                             Filter="@_filter"
                             PageNumber="@_pageNumber"
                             TotalPages="@_totalPages"
                             TotalCount="@_totalCount"
                             SearchChanged="SetSearch"
                             OnSearch="SearchAsync"
                             FilterChanged="FilterChangedAsync"
                             OnNew="NewCustomerWithSuggestedAccountAsync"
                             OnRefresh="LoadAsync"
                             OnOpen="OpenAsync"
                             OnEdit="OpenCustomerForEditingAsync"
                             OnPreviousPage="PreviousPageAsync"
                             OnNextPage="NextPageAsync"
                             OnImport="OpenImport"
                             OnTemplate="DownloadTemplateAsync"
                             OnExport="ExportAsync">
    </UiCustomerListDashboard>
}
else
{
    <UiCustomerProfileWorkspace @key="ActiveEditorTab!.TabId"
                                Busy="@(_busy || _resolvingCustomerParent)"
                                IsNew="@IsNew"
                                StartInEditMode="@(_startInEditModeFor.HasValue && _startInEditModeFor == ActiveEditorTab?.EntityId)"
                                Form="@ActiveForm"
                                OnFormChanged="MarkActiveTabDirty"
                                OnBack="BackToCustomerListAsync"
                                OnSave="SaveCustomerWithAutoParentAsync"
                                OnCancel="CancelCustomerEditAsync"
                                OnToggleStatus="ToggleCustomerStatusWithConfirmationAsync" />
}

@if (_importOpen)
{
    <UiSpreadsheetImport @key="_importKey"
                         Title="العملاء"
                         Busy="@_spreadsheetBusy"
                         Preview="@UiPreview"
                         OnValidate="PreviewImportAsync"
                         OnConfirm="ConfirmImportAsync"
                         OnClear="ClearImport"
                         OnClose="CloseImport" />
}
