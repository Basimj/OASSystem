@if (CanImport)
{
    <UiButton AdditionalCssClass="inventory-icon-tool" IconCssClass="fa-solid fa-file-import" title="استيراد Excel" aria-label="استيراد Excel"
              Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="Busy" OnClick="@(_ => OnImport.InvokeAsync())" />
    <UiButton AdditionalCssClass="inventory-icon-tool" IconCssClass="fa-solid fa-download" title="تنزيل القالب" aria-label="تنزيل القالب"
              Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="Busy" OnClick="@(_ => OnTemplate.InvokeAsync())" />
}
<UiButton AdditionalCssClass="inventory-icon-tool" IconCssClass="fa-solid fa-file-export" title="تصدير Excel" aria-label="تصدير Excel"
          Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="Busy" OnClick="@(_ => OnExport.InvokeAsync())" />

@code {
    [Parameter] public bool CanImport { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnImport { get; set; }
    [Parameter] public EventCallback OnTemplate { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
}
