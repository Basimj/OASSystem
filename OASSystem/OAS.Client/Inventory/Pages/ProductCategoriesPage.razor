@page "/inventory/product-categories"
@attribute [Authorize]
@using OAS.Client.Inventory.Services
@using OAS.Client.Services.Browser
@using OAS.Contracts.Inventory
@using OAS.Contracts.Inventory.Products
@using OAS.UiLib.Components.Spreadsheets

<PageTitle>تصنيفات المنتجات | OAS</PageTitle>

<UiWorkspaceLayout ShowAside="true" ShowFilters="false">
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="جديد" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small" Disabled="@IsEditing" OnClick="BeginCreateAsync" />
            <UiButton Text="حفظ" IconCssClass="fa-solid fa-floppy-disk" Size="ControlSize.Small" Disabled="@(!IsEditing)" Loading="@_saving" OnClick="SaveAsync" />
            <UiButton Text="تعديل" IconCssClass="fa-solid fa-pen" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(!CanEdit)" OnClick="BeginEditAsync" />
            <UiButton Text="إلغاء" IconCssClass="fa-solid fa-xmark" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Disabled="@(!IsEditing)" OnClick="CancelAsync" />
            <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@IsEditing" Loading="@_loading" OnClick="RefreshAsync" />
            <UiSpreadsheetActions CanImport="true" Busy="@(_exporting || _spreadsheetBusy)" OnImport="OpenSpreadsheetImportAsync" OnTemplate="DownloadTemplateAsync" OnExport="ExportAsync" />
            <UiSearchInput @bind-Value="_search" Placeholder="ابحث بالكود أو اسم التصنيف..." AriaLabel="البحث في تصنيفات المنتجات" ClearText="مسح البحث" DebounceMilliseconds="250" OnSearch="SearchChangedAsync" />
        </UiWorkspaceActionBar>
    </Actions>
    <Content>
        <UiDataGridPanel Title="تصنيفات المنتجات" Subtitle="@($"{FilteredItems.Count} تصنيف")">
            <Body>
                @if (_loading) { <UiAlert Message="جاري تحميل تصنيفات المنتجات..." /> }
                else
                {
                    <UiDataTable TItem="ProductCategoryDto" Items="@FilteredItems" Headers="@Headers" EmptyText="لا توجد تصنيفات منتجات مطابقة." SidebarTypography="true" UniformCellTypography="true" OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                        <RowTemplate Context="item">
                            <td><strong>@item.Code</strong></td>
                            <td>@item.Name</td>
                            <td>@ProductTypeName(item.ProductTypeId)</td>
                            <td><UiBadge Text="@(item.IsActive ? "نشط" : "غير نشط")" Tone="@(item.IsActive ? AlertTone.Success : AlertTone.Danger)" /></td>
                        </RowTemplate>
                    </UiDataTable>
                }
            </Body>
        </UiDataGridPanel>
    </Content>
    <Aside>
        <UiCard Title="@EditorTitle" Subtitle="@(_selectedId.HasValue ? _code : null)">
            @if (_mode == EditorMode.Empty) { <UiAlert Message="اختر تصنيفًا من القائمة أو اضغط «جديد»." /> }
            else
            {
                <div class="inventory-master-editor">
                    <UiInputText Label="كود التصنيف" Value="@_code" ValueExpression="@(() => _code)" ValueChanged="@(v => SetField(CodeField, () => _code = v ?? string.Empty))" Required="true" ErrorText="@ErrorFor(CodeField)" MaxLength="32" Disabled="@(!IsEditing)" Size="ControlSize.Small" />
                    <UiInputText Label="اسم التصنيف" Value="@_name" ValueExpression="@(() => _name)" ValueChanged="@(v => SetField(NameField, () => _name = v ?? string.Empty))" Required="true" ErrorText="@ErrorFor(NameField)" MaxLength="100" Disabled="@(!IsEditing)" Size="ControlSize.Small" />
                    <UiSelect Label="نوع المنتج" Value="@_productTypeId" ValueChanged="SetProductTypeAsync" Options="@ProductTypeOptions" Required="true" ErrorText="@ErrorFor(ProductTypeField)" Disabled="@(!IsEditing)" Size="ControlSize.Small" />
                    <UiCheckbox Label="التصنيف نشط" Value="@_isActive" ValueChanged="SetActiveAsync" Disabled="@(!IsEditing || _mode == EditorMode.Create)" />
                </div>
            }
        </UiCard>
    </Aside>
</UiWorkspaceLayout>

@if (_spreadsheetImportOpen)
{
    <InventorySpreadsheetImportHost Section="product-categories" Title="تصنيفات المنتجات" OnClose="CloseSpreadsheetImportAsync" OnImported="ReloadAfterSpreadsheetImportAsync" />
}

@code {
    private enum EditorMode { Empty, View, Create, Edit }
    private const string CodeField = "كود التصنيف";
    private const string NameField = "اسم التصنيف";
    private const string ProductTypeField = "نوع المنتج";

    [Inject] private IInventoryClientService Inventory { get; set; } = default!;
    [Inject] private InventorySpreadsheetClient SpreadsheetClient { get; set; } = default!;
    [Inject] private BrowserFileDownloadService SpreadsheetDownload { get; set; } = default!;
    [Inject] private IApiFeedbackService ApiFeedback { get; set; } = default!;
    [Inject] private IUiSnackbarService Snackbar { get; set; } = default!;

    private static readonly IReadOnlyList<string> Headers = ["الكود", "الاسم", "نوع المنتج", "الحالة"];
    private IReadOnlyList<ProductCategoryDto> _items = [];
    private IReadOnlyList<ProductTypeDto> _productTypes = [];
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);
    private EditorMode _mode = EditorMode.Empty;
    private Guid? _selectedId;
    private bool _loading = true, _saving, _exporting, _spreadsheetBusy, _spreadsheetImportOpen;
    private string? _search, _productTypeId;
    private string _code = string.Empty, _name = string.Empty;
    private bool _isActive = true;

    private bool IsEditing => _mode is EditorMode.Create or EditorMode.Edit;
    private bool CanEdit => _mode == EditorMode.View && _selectedId.HasValue;
    private string EditorTitle => _mode switch { EditorMode.Create => "تصنيف جديد", EditorMode.Edit => "تعديل التصنيف", EditorMode.View => "تفاصيل التصنيف", _ => "تفاصيل التصنيف" };
    private IReadOnlyList<ProductCategoryDto> FilteredItems => _items.Where(x => Match(_search, x.Code, x.Name, ProductTypeName(x.ProductTypeId))).OrderBy(x => x.Code, StringComparer.CurrentCultureIgnoreCase).ToArray();
    private IReadOnlyList<UiSelectOption> ProductTypeOptions => _productTypes.Where(x => x.IsActive || string.Equals(x.Id.ToString("D"), _productTypeId, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase).Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.Code} - {x.Name}")).ToArray();

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var request = new PageRequest { PageNumber = 1, PageSize = PageRequest.MaximumPageSize };
            var categoriesTask = Inventory.GetProductCategoriesAsync(request);
            var productTypesTask = Inventory.GetProductTypesAsync(request);
            await Task.WhenAll(categoriesTask, productTypesTask);
            _items = categoriesTask.Result.Items; _productTypes = productTypesTask.Result.Items;
            if (_selectedId.HasValue && !_items.Any(x => x.Id == _selectedId.Value)) { _selectedId = null; _mode = EditorMode.Empty; ClearForm(); }
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); } catch { ApiFeedback.ShowUnexpected(); } finally { _loading = false; }
    }
    private Task RefreshAsync(MouseEventArgs args) => LoadAsync();
    private Task SearchChangedAsync(string? value) => Task.CompletedTask;
    private async Task BeginCreateAsync(MouseEventArgs args) { if (IsEditing) return; _selectedId = null; _mode = EditorMode.Create; ClearForm(); _isActive = true; await AssignGeneratedCodeAsync(InventoryCodeKinds.ProductCategory); }
    private Task BeginEditAsync(MouseEventArgs args) { if (!CanEdit) return Task.CompletedTask; ClearValidation(); _mode = EditorMode.Edit; return Task.CompletedTask; }
    private Task CancelAsync(MouseEventArgs args) { ClearValidation(); if (_selectedId.HasValue) { _mode = EditorMode.View; LoadSelected(_selectedId.Value); } else { _mode = EditorMode.Empty; ClearForm(); } return Task.CompletedTask; }

    private async Task SaveAsync(MouseEventArgs args)
    {
        if (!IsEditing || _saving || !ValidateForm()) return;
        _saving = true;
        try
        {
            var productTypeId = Guid.Parse(_productTypeId!);
            ProductCategoryDto? saved = _mode == EditorMode.Create
                ? await Inventory.CreateProductCategoryAsync(new CreateProductCategoryRequest(_code.Trim(), _name.Trim(), productTypeId))
                : await Inventory.UpdateProductCategoryAsync(_selectedId!.Value, new UpdateProductCategoryRequest(_code.Trim(), _name.Trim(), productTypeId, _isActive));
            if (saved is null) return;
            _selectedId = saved.Id; _mode = EditorMode.View; await LoadAsync(); LoadSelected(saved.Id); Snackbar.Success("تم حفظ تصنيف المنتجات بنجاح.");
        }
        catch (ApiClientException ex) { if (string.Equals(ex.Error.Code, "unique_constraint_conflict", StringComparison.OrdinalIgnoreCase)) { await LoadAsync(); ApplyDuplicateErrors(); Snackbar.Error("توجد بيانات مكررة. راجع الحقول المميزة باللون الأحمر."); } else ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); } finally { _saving = false; }
    }

    private bool ValidateForm()
    {
        ClearValidation(); var missing = false;
        if (string.IsNullOrWhiteSpace(_code)) { SetError(CodeField, "هذا الحقل إجباري."); missing = true; }
        if (string.IsNullOrWhiteSpace(_name)) { SetError(NameField, "هذا الحقل إجباري."); missing = true; }
        if (!Guid.TryParse(_productTypeId, out _)) { SetError(ProductTypeField, "يجب اختيار نوع المنتج."); missing = true; }
        ValidateMaxLength(CodeField, _code, 32); ValidateMaxLength(NameField, _name, 100); ApplyDuplicateErrors();
        if (_fieldErrors.Count == 0) return true;
        Snackbar.Error(missing ? "هناك بيانات إجبارية لم يتم إدخالها." : "توجد بيانات غير صحيحة. راجع الحقول المميزة باللون الأحمر."); return false;
    }
    private void ApplyDuplicateErrors() { if (!string.IsNullOrWhiteSpace(_code) && _items.Any(x => x.Id != _selectedId && string.Equals(x.Code, _code.Trim(), StringComparison.OrdinalIgnoreCase))) SetError(CodeField, "هذا الكود مستخدم مسبقًا."); }
    private string ProductTypeName(Guid id) { var type = _productTypes.FirstOrDefault(x => x.Id == id); return type is null ? "—" : $"{type.Code} - {type.Name}"; }
    private void Select(Guid id) { if (IsEditing || _saving) return; _selectedId = id; _mode = EditorMode.View; LoadSelected(id); }
    private void LoadSelected(Guid id) { ClearValidation(); var item = _items.FirstOrDefault(x => x.Id == id); if (item is null) return; _code = item.Code; _name = item.Name; _productTypeId = item.ProductTypeId.ToString("D"); _isActive = item.IsActive; }
    private void ClearForm() { ClearValidation(); _code = string.Empty; _name = string.Empty; _productTypeId = _productTypes.FirstOrDefault(x => x.IsActive)?.Id.ToString("D"); _isActive = true; }
    private Task SetProductTypeAsync(string? value) { _productTypeId = value; ClearFieldError(ProductTypeField); return Task.CompletedTask; }
    private async Task AssignGeneratedCodeAsync(string kind) { try { var suggestion = await Inventory.GetNextCodeAsync(kind); if (_mode == EditorMode.Create && suggestion is not null) _code = suggestion.Code; } catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); } catch { ApiFeedback.ShowUnexpected(); } }
    private Task SetActiveAsync(bool value) { _isActive = value; return Task.CompletedTask; }
    private void ValidateMaxLength(string key, string? value, int max) { if (!string.IsNullOrEmpty(value) && value.Length > max) SetError(key, $"الحد الأقصى {max} حرفًا."); }
    private string? ErrorFor(string key) => _fieldErrors.TryGetValue(key, out var value) ? value : null;
    private void SetError(string key, string message) => _fieldErrors[key] = message;
    private void ClearFieldError(string key) => _fieldErrors.Remove(key);
    private void ClearValidation() => _fieldErrors.Clear();
    private void SetField(string key, Action setter) { setter(); ClearFieldError(key); }
    private static bool Match(string? search, params string?[] values) { if (string.IsNullOrWhiteSpace(search)) return true; var term = search.Trim(); return values.Any(x => x?.Contains(term, StringComparison.CurrentCultureIgnoreCase) == true); }
    private Task OpenSpreadsheetImportAsync() { _spreadsheetImportOpen = true; return Task.CompletedTask; }
    private Task CloseSpreadsheetImportAsync() { _spreadsheetImportOpen = false; return Task.CompletedTask; }
    private async Task ReloadAfterSpreadsheetImportAsync() => await LoadAsync();
    private async Task DownloadTemplateAsync() { if (_spreadsheetBusy) return; _spreadsheetBusy = true; try { var bytes = await SpreadsheetClient.TemplateAsync("product-categories"); await SpreadsheetDownload.SaveAsync(bytes, "inventory-product-categories-template.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"); } catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); } catch { ApiFeedback.ShowUnexpected(); } finally { _spreadsheetBusy = false; } }
    private async Task ExportAsync() { if (_exporting) return; _exporting = true; try { var bytes = await SpreadsheetClient.ExportAsync("product-categories", new PageRequest { Search = _search }); await SpreadsheetDownload.SaveAsync(bytes, "inventory-product-categories.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"); } catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); } catch { ApiFeedback.ShowUnexpected(); } finally { _exporting = false; } }
}
