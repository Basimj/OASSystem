@page "/inventory"
@page "/inventory/balances"
@attribute [Authorize]
@using OAS.Client.Inventory.Common
@using OAS.Client.Services.Browser
@using OAS.Contracts.Inventory.Stock
@using OAS.UiLib.Components.Spreadsheets
<PageTitle>أرصدة المخزون | OAS</PageTitle>
<span class="oas-inventory-view" hidden aria-hidden="true"></span>

<UiWorkspaceLayout ShowAside="false" ShowFilters="true">
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Loading="@_loading" OnClick="@(_ => LoadAsync())" />
            <UiSpreadsheetActions CanImport="false" Busy="@(_exporting || _loading || _failed)" OnExport="ExportAsync" />
            <UiSearchInput @bind-Value="_search" Placeholder="ابحث بالمنتج أو رمز الصنف أو الباركود..." AriaLabel="البحث في أرصدة المخزون" ClearText="مسح البحث" DebounceMilliseconds="250" OnSearch="SearchChangedAsync" />
        </UiWorkspaceActionBar>
    </Actions>
    <Filters>
        <div class="inventory-balance__filters">
            <label>المخزن
                <select value="@_warehouse" @onchange="WarehouseChanged"><option value="">جميع المخازن</option>@foreach (var item in Lookups.Warehouses) { <option value="@item.Id">@item.Name</option> }</select>
            </label>
            <label>نوع المنتج
                <select value="@_type" @onchange="TypeChanged"><option value="">جميع الأنواع</option>@foreach (var item in Lookups.Types) { <option value="@item.Id">@item.Name</option> }</select>
            </label>
            <label>التصنيف
                <select value="@_category" @onchange="CategoryChanged"><option value="">جميع التصنيفات</option>@foreach (var item in Lookups.Categories.Where(x => string.IsNullOrEmpty(_type) || x.ParentId == Parse(_type))) { <option value="@item.Id">@item.Name</option> }</select>
            </label>
            <label>العلامة التجارية
                <select value="@_brand" @onchange="BrandChanged"><option value="">جميع العلامات</option>@foreach (var item in Lookups.Brands) { <option value="@item.Id">@item.Name</option> }</select>
            </label>
            <label>المنتج (الاسم أو الرمز)
                <input type="search" value="@_productSearch" @onchange="ProductChanged" placeholder="اسم المنتج أو رمزه" />
            </label>
            <label>حالة الرصيد
                <select value="@_balanceStatus" @onchange="BalanceChanged"><option value="">الكل</option><option value="available">متوفر</option><option value="zero">نافد (الرصيد الفعلي صفر)</option><option value="reserved">محجوز بالكامل</option></select>
            </label>
            <label>حالة الشراء
                <select value="@_purchaseStatus" @onchange="PurchaseChanged"><option value="">الكل</option><option value="ordered">قيد الطلب</option><option value="notordered">غير مطلوب</option></select>
            </label>
            <label>حالة الصنف
                <select value="@_activityStatus" @onchange="ActivityChanged"><option value="">الكل</option><option value="active">نشط</option><option value="inactive">غير نشط (له رصيد)</option></select>
            </label>
            <button type="button" class="balance-reset" @onclick="ResetAsync">إعادة تعيين الفلاتر</button>
        </div>
    </Filters>
    <Content>
        <UiDataGridPanel Title="أرصدة المخزون" Subtitle="@(_result is null || _loading || _failed ? "" : $"{_result.Summary.RowCount} رصيد")">
            <Body>
                @if (_loading)
                {
                    <UiAlert Message="جاري تحميل أرصدة المخزون..." />
                }
                else if (_failed || _result is null)
                {
                    <UiAlert Message="تعذر تحميل أرصدة المخزون. اضغط تحديث لإعادة المحاولة." />
                }
                else
                {
                    <div class="balance-workspace" dir="rtl">
                        <div class="balance-summary">
                            <div><span>عدد الأصناف</span><strong>@_result.Summary.VariantCount</strong></div>
                            <div><span>عدد سجلات العرض</span><strong>@_result.Summary.RowCount</strong></div>
                            <div><span>قيمة المخزون (@Currency)</span><strong>@N(_result.Summary.InventoryValue)</strong></div>
                            <div><span>العملة الأساسية</span><strong>@(_result.CurrencyName ?? "غير محددة")</strong></div>
                        </div>
                        <div class="balance-table-wrap">
                            <table class="balance-table">
                                <thead><tr>
                                    @foreach (var header in Headers)
                                    {
                                        <th scope="col" aria-sort="@(header.Key == _sort ? (_direction == SortDirection.Ascending ? "ascending" : "descending") : "none")">
                                            @if (header.Key == "actions") { <span>@header.Label</span> }
                                            else { <button type="button" @onclick="() => SortAsync(header.Key)">@header.Label <span aria-hidden="true">@(header.Key == _sort ? (_direction == SortDirection.Ascending ? "↑" : "↓") : "↕")</span></button> }
                                        </th>
                                    }
                                </tr></thead>
                                <tbody>
                                    @if (_result.Page.Items.Count == 0)
                                    { <tr><td colspan="@Headers.Count" class="balance-empty">لا توجد أرصدة مطابقة للفلاتر.</td></tr> }
                                    @foreach (var row in _result.Page.Items)
                                    {
                                        <tr @key="(row.WarehouseId, row.VariantId)">
                                            <td>@row.ProductName<small>@row.ProductCode</small></td>
                                            <td>@(row.VariantName ?? "—")<small>@row.SKU · @(row.Barcode ?? "—")</small>@if (!row.IsActive) { <small class="balance-inactive">غير نشط</small> }</td>
                                            @if (AllWarehouses) { <td>@row.WarehouseName @if (!row.WarehouseActive) { <small class="balance-inactive">غير نشط</small> }</td> }
                                            <td>@(row.UnitName ?? "—")</td>
                                            <td class="balance-num">@N(row.OnHand)</td><td class="balance-num">@N(row.Reserved)</td>
                                            <td class="balance-num @(row.Available <= 0 ? "balance-inactive" : "balance-available")">@N(row.Available)</td>
                                            <td class="balance-num">@N(row.OnOrder)</td><td class="balance-num">@N(row.AverageCost)</td><td class="balance-num">@N(row.Value)</td>
                                            <td class="balance-date">@InventoryDisplayFormat.DateTime(row.LastMovement?.ToLocalTime())</td>
                                            <td><div class="inventory-balance__actions">
                                                <UiButton IconCssClass="fa-solid fa-box" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" title="فتح المنتج" aria-label="فتح المنتج" OnClick="@(_ => OpenProduct(row))" />
                                                <UiButton IconCssClass="fa-solid fa-list" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" title="فتح حركات الصنف في المخزن" aria-label="فتح حركات الصنف في المخزن" OnClick="@(_ => OpenMovements(row))" />
                                            </div></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot><tr><td colspan="@(AllWarehouses ? 8 : 7)">إجمالي قيمة المخزون لجميع النتائج</td><td colspan="1">—</td><td class="balance-num">@N(_result.Summary.InventoryValue)</td><td colspan="2"></td></tr></tfoot>
                            </table>
                        </div>
                        <nav class="balance-pager" aria-label="التنقل بين صفحات الأرصدة">
                            <button type="button" disabled="@(!_result.Page.HasPreviousPage)" @onclick="() => GoPageAsync(-1)">السابق</button>
                            <span>صفحة @_result.Page.PageNumber من @Math.Max(1, _result.Page.TotalPages)</span>
                            <button type="button" disabled="@(!_result.Page.HasNextPage)" @onclick="() => GoPageAsync(1)">التالي</button>
                            <label>عدد الصفوف <select value="@_pageSize" @onchange="PageSizeChanged"><option value="12">12</option><option value="25">25</option><option value="50">50</option></select></label>
                        </nav>
                        <details class="balance-unit-totals">
                            <summary>إجماليات الكميات حسب وحدة القياس (جميع النتائج المطابقة)</summary>
                            <table class="balance-table"><thead><tr><th>الوحدة</th><th>الفعلي</th><th>المحجوز</th><th>المتاح</th><th>قيد الطلب</th></tr></thead><tbody>
                                @foreach (var total in _result.Summary.Units) { <tr><td>@(total.UnitName ?? "غير محددة")</td><td>@N(total.OnHand)</td><td>@N(total.Reserved)</td><td>@N(total.Available)</td><td>@N(total.OnOrder)</td></tr> }
                            </tbody></table>
                        </details>
                    </div>
                }
            </Body>
        </UiDataGridPanel>
    </Content>
</UiWorkspaceLayout>

@code {
    [Inject] private OasApiClient Api { get; set; } = default!;
    [Inject] private BrowserFileDownloadService SpreadsheetDownload { get; set; } = default!;
    [Inject] private IApiFeedbackService ApiFeedback { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private InventoryBalanceWorkspaceDto? _result;
    private static readonly BalanceWorkspaceLookups EmptyLookups = new([], [], [], []);
    private BalanceWorkspaceLookups Lookups => _result?.Lookups ?? EmptyLookups;
    private bool _loading = true, _exporting, _failed;
    private int _version, _page = 1, _pageSize = 12;
    private string? _search, _productSearch;
    private string _warehouse = "", _type = "", _category = "", _brand = "", _balanceStatus = "", _purchaseStatus = "", _activityStatus = "";
    private string _sort = "product";
    private SortDirection _direction = SortDirection.Ascending;
    private bool AllWarehouses => string.IsNullOrEmpty(_warehouse);
    private string Currency => _result?.CurrencyCode ?? "غير محددة";
    private IReadOnlyList<(string Key, string Label)> Headers => [ ("product", "المنتج"), ("sku", "الصنف / الرمز / الباركود"), .. (AllWarehouses ? new[] { ("warehouse", "المخزن") } : Array.Empty<(string,string)>()), ("unit", "الوحدة"), ("onhand", "الفعلي"), ("reserved", "المحجوز"), ("available", "المتاح"), ("onorder", "قيد الطلب"), ("cost", $"متوسط التكلفة ({Currency})"), ("value", $"القيمة ({Currency})"), ("lastmovement", "آخر حركة"), ("actions", "إجراءات") ];
    private static Guid? Parse(string? value) => Guid.TryParse(value, out var id) ? id : null;
    private static string N(decimal value) => InventoryDisplayFormat.Number(value);
    private static string V(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private string Url(bool export = false)
    {
        var parameters = new Dictionary<string,string?> { ["pageNumber"] = _page.ToString(), ["pageSize"] = _pageSize.ToString(), ["sortBy"] = _sort, ["sortDirection"] = _direction.ToString(), ["search"] = _search, ["warehouseId"] = _warehouse, ["productTypeId"] = _type, ["categoryId"] = _category, ["brandId"] = _brand, ["productSearch"] = _productSearch, ["balanceStatus"] = _balanceStatus, ["purchaseStatus"] = _purchaseStatus, ["activityStatus"] = _activityStatus };
        return "api/inventory/balances/workspace" + (export ? "/export" : "") + "?" + string.Join("&", parameters.Where(p => !string.IsNullOrWhiteSpace(p.Value)).Select(p => $"{p.Key}={Uri.EscapeDataString(p.Value!)}"));
    }
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        var version = ++_version;
        _loading = true; _failed = false;
        try
        {
            var result = await Api.GetAsync<InventoryBalanceWorkspaceDto>(Url());
            if (version != _version) return;
            _result = result ?? throw new InvalidOperationException("Empty balance response.");
            _page = _result.Page.PageNumber;
        }
        catch (ApiClientException ex) { if (version == _version) { _failed = true; ApiFeedback.Show(ex.Error); } }
        catch (Exception) { if (version == _version) { _failed = true; ApiFeedback.ShowUnexpected(); } }
        finally { if (version == _version) _loading = false; }
    }
    private Task Changed() { _page = 1; return LoadAsync(); }
    private Task WarehouseChanged(ChangeEventArgs e) { _warehouse = V(e); if (!AllWarehouses && _sort == "warehouse") _sort = "product"; return Changed(); }
    private Task TypeChanged(ChangeEventArgs e) { _type = V(e); _category = ""; return Changed(); }
    private Task CategoryChanged(ChangeEventArgs e) { _category = V(e); return Changed(); }
    private Task BrandChanged(ChangeEventArgs e) { _brand = V(e); return Changed(); }
    private Task ProductChanged(ChangeEventArgs e) { _productSearch = V(e); return Changed(); }
    private Task BalanceChanged(ChangeEventArgs e) { _balanceStatus = V(e); return Changed(); }
    private Task PurchaseChanged(ChangeEventArgs e) { _purchaseStatus = V(e); return Changed(); }
    private Task ActivityChanged(ChangeEventArgs e) { _activityStatus = V(e); return Changed(); }
    private Task SearchChangedAsync(string? value) { _search = value; return Changed(); }
    private Task PageSizeChanged(ChangeEventArgs e) { if (int.TryParse(V(e), out var size)) _pageSize = size; return Changed(); }
    private Task GoPageAsync(int delta) { _page = Math.Max(1, _page + delta); return LoadAsync(); }
    private Task SortAsync(string key) { _direction = _sort == key && _direction == SortDirection.Ascending ? SortDirection.Descending : SortDirection.Ascending; _sort = key; return Changed(); }
    private Task ResetAsync() { _warehouse = _type = _category = _brand = _balanceStatus = _purchaseStatus = _activityStatus = ""; _search = _productSearch = null; _sort = "product"; _direction = SortDirection.Ascending; return Changed(); }
    private void OpenProduct(InventoryBalanceWorkspaceRow row) => Navigation.NavigateTo($"/products?productId={row.ProductId:D}");
    private void OpenMovements(InventoryBalanceWorkspaceRow row) => Navigation.NavigateTo($"/inventory/ledger?variantId={row.VariantId:D}&warehouseId={row.WarehouseId:D}");
    private async Task ExportAsync()
    {
        if (_exporting || _loading || _failed || _result is null) return;
        _exporting = true;
        try { var bytes = await Api.GetFileAsync(Url(true)); await SpreadsheetDownload.SaveAsync(bytes, "inventory-balances.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"); }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch (Exception) { ApiFeedback.ShowUnexpected(); }
        finally { _exporting = false; }
    }
}
