@page "/inventory"
@page "/inventory/balances"
@attribute [Authorize]
@using OAS.Client.Inventory.Services
@using OAS.Client.Services.Browser
@using OAS.Contracts.Inventory.Products
@using OAS.Contracts.Inventory.Stock
@using OAS.Contracts.Inventory.Warehouses

@using OAS.UiLib.Components.Spreadsheets
<PageTitle>أرصدة المخزون | OAS</PageTitle>

<UiWorkspaceLayout ShowAside="false" ShowFilters="true">
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small" Loading="@_loading" OnClick="RefreshAsync" />
            <UiSpreadsheetActions CanImport="false" Busy="@_exporting" OnExport="ExportAsync" />
            <UiSearchInput @bind-Value="_search" Placeholder="ابحث بالمنتج أو SKU أو Barcode..."
                           AriaLabel="البحث في أرصدة المخزون" ClearText="مسح البحث"
                           DebounceMilliseconds="250" OnSearch="SearchChangedAsync" />
        </UiWorkspaceActionBar>
    </Actions>

    <Filters>
        <div class="inventory-balance__filters">
            <UiSelect Value="@(_warehouseFilter ?? string.Empty)"
                      ValueExpression="@(() => _warehouseFilter)"
                      ValueChanged="OnWarehouseChangedAsync"
                      Label="المخزن"
                      Options="@WarehouseFilterOptions"
                      Placeholder="اختر مخزنًا..." Required="true"
                      Size="ControlSize.Small" />
        </div>
    </Filters>

    <Content>
        <UiDataGridPanel Title="أرصدة المخزون" Subtitle="@($"{FilteredBalances.Count} صنف")">
            <Body>
                @if (_loading)
                {
                    <UiAlert Message="جاري تحميل أرصدة المخزون..." />
                }
                else if (!Guid.TryParse(_warehouseFilter, out _))
                {
                    <UiAlert Message="اختر مخزنًا لعرض جميع الأصناف المخزنية وأرصدتها، بما فيها الأرصدة الصفرية." />
                }
                else
                {
                    <UiDataTable TItem="InventoryDisplayRow" Items="@FilteredBalances" Headers="@BalanceHeaders" EmptyText="لا توجد أصناف مخزنية مطابقة للفلتر الحالي."
                                 SidebarTypography="true"
                                 UniformCellTypography="true" Compact="true" FitToContainer="true">
                        <RowTemplate Context="row">
                            <td>@row.Product.NameAr<br /><UiTextLabel Text="@row.Product.ProductCode" Size="ControlSize.Small" Tone="TextTone.Muted" /></td>
                            <td>@(row.Variant.VariantName ?? "—")<br /><UiTextLabel Text="@VariantIdentity(row.Variant)" Size="ControlSize.Small" Tone="TextTone.Muted" /></td>
                            <td>@WarehouseName(row.WarehouseId)</td>
                            <td>@row.OnHandQuantity.ToString("N3")</td>
                            <td>@row.ReservedQuantity.ToString("N3")</td>
                            <td>@row.AvailableQuantity.ToString("N3")</td>
                            <td>@row.OnOrderQuantity.ToString("N3")</td>
                            <td>@row.AverageUnitCost.ToString("N2")</td>
                            <td>@row.InventoryValue.ToString("N2")</td>
                            <td>
                                <div class="inventory-balance__actions">
                                    <UiButton IconCssClass="fa-solid fa-box" Variant="ButtonVariant.Ghost" Size="ControlSize.Small"
                                              title="فتح الصنف" aria-label="فتح الصنف"
                                              OnClick="@(_ => OpenProduct(row.Variant.Id))" />
                                    <UiButton IconCssClass="fa-solid fa-list" Variant="ButtonVariant.Ghost" Size="ControlSize.Small"
                                              title="فتح الحركات" aria-label="فتح الحركات"
                                              OnClick="@(_ => OpenMovements(row.Variant.Id))" />
                                </div>
                            </td>
                        </RowTemplate>
                    </UiDataTable>
                }
            </Body>
        </UiDataGridPanel>
    </Content>
</UiWorkspaceLayout>

@code {
    [Inject] private IInventoryClientService Inventory { get; set; } = default!;
    [Inject] private InventorySpreadsheetClient SpreadsheetClient { get; set; } = default!;
    [Inject] private BrowserFileDownloadService SpreadsheetDownload { get; set; } = default!;
    [Inject] private IApiFeedbackService ApiFeedback { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool _loading = true;
    private bool _exporting;
    private string? _search;
    private string? _warehouseFilter;
    private IReadOnlyList<InventoryBalanceDto> _balances = [];
    private static readonly IReadOnlyList<string> BalanceHeaders = ["المنتج", "Variant / SKU / Barcode", "المخزن", "On Hand", "Reserved", "Available", "On Order", "متوسط التكلفة", "القيمة", "إجراءات"];
    private IReadOnlyList<WarehouseDto> _warehouses = [];
    private IReadOnlyList<ProductDto> _products = [];
    private IReadOnlyList<ProductVariantDto> _variants = [];

    private IReadOnlyList<UiSelectOption> WarehouseFilterOptions =>
        _warehouses.Where(x => x.IsActive)
            .OrderByDescending(x => x.IsDefault)
            .ThenBy(x => x.NameAr)
            .Select(x => new UiSelectOption(x.Id.ToString("D"), x.IsDefault ? $"{x.NameAr} (افتراضي)" : x.NameAr))
            .ToArray();

    private sealed record InventoryDisplayRow(Guid WarehouseId, ProductDto Product, ProductVariantDto Variant, InventoryBalanceDto? Balance)
    {
        public decimal OnHandQuantity => Balance?.OnHandQuantity ?? 0m;
        public decimal ReservedQuantity => Balance?.ReservedQuantity ?? 0m;
        public decimal OnOrderQuantity => Balance?.OnOrderQuantity ?? 0m;
        public decimal AvailableQuantity => Balance?.AvailableQuantity ?? 0m;
        public decimal AverageUnitCost => Balance?.AverageUnitCost ?? 0m;
        public decimal InventoryValue => Balance?.InventoryValue ?? 0m;
    }

    private IReadOnlyList<InventoryDisplayRow> FilteredBalances
    {
        get
        {
            if (!Guid.TryParse(_warehouseFilter, out var warehouseId))
                return [];

            var balances = _balances
                .Where(x => x.WarehouseId == warehouseId)
                .ToDictionary(x => x.ProductVariantId);
            var products = _products
                .Where(x => x.IsActive && x.IsStockItem)
                .ToDictionary(x => x.Id);

            return _variants
                .Where(x => x.IsActive && products.ContainsKey(x.ProductId))
                .Select(variant => new InventoryDisplayRow(
                    warehouseId,
                    products[variant.ProductId],
                    variant,
                    balances.GetValueOrDefault(variant.Id)))
                .Where(row =>
                {
                    if (string.IsNullOrWhiteSpace(_search)) return true;
                    var term = _search.Trim();
                    return new[] { row.Variant.SKU, row.Variant.Barcode, row.Variant.VariantName, row.Product.ProductCode, row.Product.NameAr, row.Product.NameEn }
                        .Any(x => x?.Contains(term, StringComparison.CurrentCultureIgnoreCase) == true);
                })
                .OrderBy(x => x.Product.NameAr)
                .ThenBy(x => x.Variant.SKU)
                .ToArray();
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var warehousesTask = LoadAllPagesAsync(page => Inventory.GetWarehousesAsync(page));
            var productsTask = LoadAllPagesAsync(page => Inventory.GetProductsAsync(page));
            var variantsTask = LoadAllPagesAsync(page => Inventory.GetProductVariantsAsync(page));

            await Task.WhenAll(warehousesTask, productsTask, variantsTask);

            _warehouses = warehousesTask.Result;
            _products = productsTask.Result;
            _variants = variantsTask.Result;

            if (!Guid.TryParse(_warehouseFilter, out var selectedWarehouseId) || !_warehouses.Any(x => x.Id == selectedWarehouseId && x.IsActive))
                _warehouseFilter = _warehouses.FirstOrDefault(x => x.IsActive && x.IsDefault)?.Id.ToString("D");

            await LoadBalancesForSelectedWarehouseAsync();
        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(ex.Error);
        }
        catch (Exception)
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _loading = false;
        }
    }

    private static async Task<IReadOnlyList<T>> LoadAllPagesAsync<T>(Func<PageRequest, Task<PagedResult<T>>> loader)
    {
        var items = new List<T>();
        var pageNumber = 1;

        while (true)
        {
            var result = await loader(new PageRequest
            {
                PageNumber = pageNumber,
                PageSize = PageRequest.MaximumPageSize
            });

            items.AddRange(result.Items);

            if (!result.HasNextPage)
                break;

            pageNumber++;
        }

        return items;
    }

    private Task RefreshAsync(MouseEventArgs args) => LoadAsync();

    private async Task OnWarehouseChangedAsync(string? value)
    {
        _warehouseFilter = value;
        _loading = true;
        try
        {
            await LoadBalancesForSelectedWarehouseAsync();
        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(ex.Error);
        }
        catch (Exception)
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadBalancesForSelectedWarehouseAsync()
    {
        if (!Guid.TryParse(_warehouseFilter, out var warehouseId))
        {
            _balances = [];
            return;
        }

        _balances = await LoadAllPagesAsync(page => Inventory.GetInventoryBalancesAsync(page, warehouseId));
    }

    private Task SearchChangedAsync(string? _) => Task.CompletedTask;
    private ProductVariantDto? FindVariant(Guid id) => _variants.FirstOrDefault(x => x.Id == id);
    private string VariantIdentity(ProductVariantDto variant) => $"{variant.SKU} · {variant.Barcode ?? "—"}";
    private string WarehouseName(Guid id) => _warehouses.FirstOrDefault(x => x.Id == id)?.NameAr ?? "—";

    private void OpenProduct(Guid variantId)
    {
        var variant = FindVariant(variantId);
        if (variant is not null) Navigation.NavigateTo($"/products?productId={variant.ProductId:D}");
    }

    private void OpenMovements(Guid variantId) => Navigation.NavigateTo($"/inventory/ledger?variantId={variantId:D}");

    private async Task ExportAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var warehouseId = Guid.TryParse(_warehouseFilter, out var parsedWarehouseId) ? parsedWarehouseId : (Guid?)null;
            var bytes = await SpreadsheetClient.ExportAsync("balances", new PageRequest { Search = _search }, warehouseId: warehouseId);
            await SpreadsheetDownload.SaveAsync(bytes, "inventory-balances.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch (Exception) { ApiFeedback.ShowUnexpected(); }
        finally { _exporting = false; }
    }
}
