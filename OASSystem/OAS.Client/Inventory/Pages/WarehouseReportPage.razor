@page "/inventory/reports/warehouses"
@attribute [Authorize]
@using OAS.Contracts.Inventory.Reports
@using OAS.UiLib.Core.Models

<PageTitle>المخازن | OAS</PageTitle>
<div class="warehouse-report">
<UiReportWorkspace Title="المخازن" StatusText="@(_busy ? "جارٍ التحميل" : _error is null ? ModeName(_applied.Mode) : "تعذر التحميل")" Search="@_search" SearchChanged="OnSearch" FiltersOpen="@_filtersOpen" FiltersOpenChanged="@(v => _filtersOpen = v)">
    <Toolbar>
        <button type="button" class="oas-report__tool" title="تحديث" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-rotate"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--pdf" title="حفظ PDF" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-regular fa-file-pdf"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--excel" title="تصدير Excel" disabled="@(!CanExport)" @onclick="ExportAsync"><i class="fa-regular fa-file-excel"></i></button>
        <button type="button" class="oas-report__tool" title="طباعة" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-solid fa-print"></i></button>
        <button type="button" class="oas-report__tool" title="إظهار أو إخفاء الفلاتر" @onclick="@(() => _filtersOpen = !_filtersOpen)"><i class="fa-solid fa-ellipsis-vertical"></i></button>
    </Toolbar>
    <QuickFilters>
        @foreach (var c in Chips)
        {<div class="oas-report__chip" title="@($"{c.Label}: {c.Value}")"><span class="oas-report__chip-label">@c.Label:</span><strong>@c.Value</strong></div>}
    </QuickFilters>
    <FilterPanel>
        <div class="warehouse-fields">
            <label class="oas-report__field">نوع التقرير<select @bind="_draft.Mode"><option value="summary">إجمالي أرصدة المخازن</option><option value="details">أرصدة المخازن حسب الأصناف</option><option value="qty">حركة المخازن - كميات</option><option value="cost">حركة المخازن - تكاليف</option><option value="transfers">التحويلات بين المخازن</option><option value="counts">الجرد والفروقات</option></select></label>
            <div class="oas-report__field"><UiReportSearchPicker Label="المخزن" ItemLabel="مخزن" DialogTitle="اختيار المخزن" Value="@_draft.Warehouse" ValueChanged="OnWarehouse" Options="@WarehouseOptions" Placeholder="جميع المخازن" /></div>
            <div class="oas-report__field"><UiReportSearchPicker Label="الصنف" ItemLabel="صنف" DialogTitle="اختيار الصنف" Value="@_draft.Variant" ValueChanged="OnVariant" Options="@VariantOptions" Placeholder="جميع الأصناف" /></div>
            @if (string.IsNullOrEmpty(_draft.Variant))
            {<label class="oas-report__field">المنتج<select disabled><option>اختر الصنف أولاً</option></select></label>}
            else
            {<div class="oas-report__field"><UiReportSearchPicker Label="المنتج" ItemLabel="منتج" DialogTitle="المنتج المرتبط بالصنف" Value="@_draft.Product" ValueChanged="OnProduct" Options="@ProductOptions" Placeholder="المنتج المرتبط" /></div>}
            <label class="oas-report__field">التصنيف<select value="@_draft.Category" @onchange="OnCategory"><option value="">جميع التصنيفات</option>@foreach(var c in Categories){<option value="@c.Id">@c.Name</option>}</select></label>
            @if (IsRange(_draft.Mode))
            {<label class="oas-report__field">من تاريخ<input type="date" @bind="_draft.From" @bind:format="yyyy-MM-dd" /></label>}
            <label class="oas-report__field">إلى تاريخ<input type="date" @bind="_draft.To" @bind:format="yyyy-MM-dd" /></label>
            @if (IsBalance(_draft.Mode))
            {<label class="oas-report__field">حالة المخزون<select @bind="_draft.StockState"><option value="all">الكل</option><option value="available">@(IsCurrent(_draft)?"متوفر":"رصيد موجب")</option><option value="out">نافد</option>@if(IsCurrent(_draft)){<option value="reserved">محجوز بالكامل</option>}</select></label>}
            @if (_draft.Mode == "transfers")
            {
                <label class="oas-report__field">المخزن المصدر<select @bind="_draft.Source"><option value="">الكل</option>@foreach(var w in Warehouses){<option value="@w.Id">@w.Name</option>}</select></label>
                <label class="oas-report__field">المخزن المستلم<select @bind="_draft.Destination"><option value="">الكل</option>@foreach(var w in Warehouses){<option value="@w.Id">@w.Name</option>}</select></label>
                <label class="oas-report__field">حالة التحويل<select @bind="_draft.TransferStatus"><option value="0">الكل</option><option value="1">مسودة</option><option value="2">مرحل</option></select></label>
            }
            @if (_draft.Mode == "counts")
            {
                <label class="oas-report__field">رقم الجرد<input @bind="_draft.CountNumber" placeholder="الكل" /></label>
                <label class="oas-report__field">حالة الجرد<select @bind="_draft.CountStatus"><option value="0">الكل</option>@for(var i=1;i<=6;i++){<option value="@i">@CountState(i)</option>}</select></label>
                <label class="oas-report__field">نوع الفرق<select @bind="_draft.Variance"><option value="all">الكل</option><option value="plus">زيادة</option><option value="minus">عجز</option><option value="equal">مطابق</option><option value="pending">لم يُجرد</option></select></label>
            }
            @if (_draft.Mode != "qty")
            {<label class="oas-report__field">العملة<select @bind="_draft.Currency"><option value="">@_baseName (الأساسية)</option>@foreach(var c in _currencies.Where(x=>x.IsActive&&x.Id!=_baseId)){<option value="@c.Id">@c.NameAr (@c.Code)</option>}</select></label>}
            <label class="oas-report__field-check"><input type="checkbox" @bind="_draft.IncludeInactive" /> تضمين المخازن غير النشطة</label>
            @if (_draft.Mode is "summary" or "details" or "qty" or "cost")
            {<label class="oas-report__field-check"><input type="checkbox" @bind="_draft.HideZero" /> إخفاء الأرصدة والحركات الصفرية</label>}
            @if(_validation is not null){<div class="warehouse-warning" role="alert">@_validation</div>}
        </div>
        <div class="oas-report__apply"><button type="button" class="primary" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-filter"></i> تطبيق</button><button type="button" disabled="@_busy" @onclick="ResetAsync"><i class="fa-solid fa-rotate-left"></i> إعادة تعيين</button></div>
    </FilterPanel>
    <TableContent>
        @if (_busy){<div class="oas-report__empty">جارٍ تحميل بيانات المخازن...</div>}
        else if (_error is not null){<div class="oas-report__empty" role="alert">@_error</div>}
        else
        {
            <table class="oas-report__table warehouse-table @(_applied.Mode=="summary"?"warehouse-summary":"")">
                <thead>
                    @if (_applied.Mode is "qty" or "cost")
                    {<tr class="warehouse-group-head"><th colspan="3" scope="colgroup">بيانات الصنف</th><th colspan="5" scope="colgroup">@( _applied.Mode=="qty" ? "الكميات الواردة" : "قيمة الوارد" )</th><th colspan="4" scope="colgroup">@(_applied.Mode=="qty"?"الكميات الصادرة":"قيمة الصادر")</th><th scope="col">المتبقي</th></tr>}
                    <tr>@foreach(var c in Columns){<UiReportSortHeader @key="c.Key" Label="@c.Label" Active="@(_sortKey==c.Key)" Descending="@_descending" OnSort="@(()=>SortBy(c.Key))" />}</tr>
                </thead>
                <tbody>
                    @if(_rows.Count==0){<tr><td colspan="@Columns.Length" class="oas-report__empty">لا توجد نتائج مطابقة للفلاتر.</td></tr>}
                    @foreach(var group in PageRows.GroupBy(GroupKey))
                    {
                        if(Grouped)
                        {<tr class="warehouse-group"><td colspan="@Columns.Length"><i class="fa-solid fa-warehouse" aria-hidden="true"></i> @WarehouseCaption(group.Key)</td></tr>}
                        @foreach(var row in group)
                        {
                            <tr>
                                @foreach(var c in Columns)
                                {
                                    var value=Cell(row,c.Key);
                                    <td class="@c.Css" title="@(value is null ? "غير متاح" : Format(value,c))">
                                        @if(c.Key=="warehouseName" && _applied.Mode=="summary")
                                        {<button type="button" class="warehouse-link" @onclick="@(()=>OpenWarehouseAsync(row.WarehouseId))">@Format(value,c)</button>}
                                        else if(c.Key=="status")
                                        {<span class="@StatusCss(row)">@Format(value,c)</span>}
                                        else {@Format(value,c)}
                                    </td>
                                }
                            </tr>
                        }
                        if(Grouped)
                        {
                            var all = _rows.Where(r=>GroupKey(r)==group.Key).ToArray();
                            <tr class="warehouse-total"><td colspan="@IdentityCount">إجمالي المخزن (كل النتائج)</td>@foreach(var c in Columns.Skip(IdentityCount)){<td class="@c.Css">@Format(Total(all,c),c)</td>}</tr>
                        }
                    }
                    @if(_rows.Count>0){<tr class="warehouse-total"><td colspan="@IdentityCount">إجمالي النتائج</td>@foreach(var c in Columns.Skip(IdentityCount)){<td class="@c.Css">@Format(Total(_rows,c),c)</td>}</tr>}
                </tbody>
            </table>
        }
    </TableContent>
    <Pagination>
        <div class="oas-report__pager"><button @onclick="@(()=>GoPage(1))" disabled="@(_page==1)">»</button><button @onclick="@(()=>GoPage(_page-1))" disabled="@(_page==1)">‹</button><button class="active" disabled>@_page</button><button @onclick="@(()=>GoPage(_page+1))" disabled="@(_page>=TotalPages)">›</button><button @onclick="@(()=>GoPage(TotalPages))" disabled="@(_page>=TotalPages)">«</button></div>
        <span>عرض @(_rows.Count==0?0:(_page-1)*_pageSize+1) - @Math.Min(_page*_pageSize,_rows.Count) من @_rows.Count نتيجة</span>
        <label>لكل صفحة <select value="@_pageSize" @onchange="ChangePageSize"><option>10</option><option>25</option><option>50</option><option>100</option></select></label>
    </Pagination>
    <Metrics>@foreach(var m in Metrics){<UiReportMetric Label="@m.Label" Value="@m.Value" Tone="@m.Tone" Icon="@m.Icon" />}</Metrics>
</UiReportWorkspace>
</div>
