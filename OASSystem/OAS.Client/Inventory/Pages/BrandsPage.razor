@page "/inventory/brands"
@page "/inventory/brands/{Screen}"
@page "/inventory/brands/{Screen}/{RecordId:guid}"
@attribute [Authorize]
@using OAS.Client.Inventory.Services
@using OAS.Client.Services.Browser
@using OAS.Contracts.Inventory
@using OAS.Contracts.Inventory.Products
@using OAS.UiLib.Components.Spreadsheets

@using OAS.UiLib.Components.Inventory
<PageTitle>العلامات التجارية | OAS</PageTitle>
@if (!_catalogReady)
{
    <div class="oas-inventory-workspace inv-catalog-loading" role="status" aria-live="polite">جاري تحميل البيانات…</div>
}
else
{
    <UiInventoryWorkspace Busy="@_loading" EditorTitle="بيانات العلامة التجارية" EditorKey="@CatalogEditorKey">
        <Actions>
            <UiInventoryCatalogToolbar Editing="@IsEditing" Saving="@_saving" Loading="@_loading"
                                   SpreadsheetBusy="@(_exporting || _spreadsheetBusy || _spreadsheetImportOpen)"
                                   CanEdit="@CanEdit" CanSave="@CanSave" CanPrevious="@CanMovePrevious" CanNext="@CanMoveNext"
                                   @bind-Search="_search" OnSearch="SearchChangedAsync" OnNavigate="NavigateRecord"
                                   OnCreate="BeginCreateAsync" OnEdit="BeginEditAsync" OnSave="SaveAsync" OnCancel="CancelAsync" OnRefresh="RefreshAsync"
                                   OnImport="OpenSpreadsheetImportAsync" OnTemplate="DownloadTemplateAsync" OnExport="ExportAsync" />
        </Actions>
        <Editor>
            <div class="inv-form-grid">
                    <UiInputText Label="كود العلامة التجارية"
                                 Value="@_code" ValueExpression="@(() => _code)"
                                 ValueChanged="@(v => SetField(CodeField, () => _code = v ?? string.Empty))"
                                 Required="true" ErrorText="@ErrorFor(CodeField)" MaxLength="32"
                                 Disabled="@(!IsEditing || _saving)" Size="ControlSize.Small" />

                    <UiInputText Label="اسم العلامة التجارية"
                                 Value="@_name" ValueExpression="@(() => _name)"
                                 ValueChanged="@(v => SetField(NameField, () => _name = v ?? string.Empty))"
                                 Required="true" ErrorText="@ErrorFor(NameField)" MaxLength="100"
                                 Disabled="@(!IsEditing || _saving)" Size="ControlSize.Small" />

                    <UiCheckbox Label="متاح للاستخدام"
                                Value="@_isActive" ValueChanged="SetActiveAsync"
                                Disabled="@(!IsEditing || _saving || _mode == EditorMode.Create)" />
                </div>
        </Editor>
        <Table>
            <UiDataTable TItem="BrandDto" Items="@PageItems" Compact="true" Headers="@Headers" EmptyText="@(CatalogEmptyText("لا توجد علامات تجارية مطابقة."))"
                                 SidebarTypography="false" UniformCellTypography="true"
                                 OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                        <RowTemplate Context="item">
                            <td>@item.Code</td>
                            <td>@item.Name</td>
                            <td>@(item.IsActive ? "نشط" : "غير نشط")</td>
                        </RowTemplate>
                    </UiDataTable>
        </Table>
        <Footer>
            <UiInventoryPagination Page="@CurrentPage" PageSize="@CatalogPageSize" TotalCount="@VisibleCount" Disabled="@(IsEditing || _loading || _saving)" OnPageChanged="ChangePage" />
        </Footer>
    </UiInventoryWorkspace>
}

@if (_spreadsheetImportOpen)
{
    <InventorySpreadsheetImportHost Section="brands"
                                    Title="العلامات التجارية"
                                    OnClose="CloseSpreadsheetImportAsync"
                                    OnImported="ReloadAfterSpreadsheetImportAsync" />
}

@code {
    [Parameter] public string? Screen { get; set; }
    [Parameter] public Guid? RecordId { get; set; }
    private string? _appliedInventoryRoute;
    private Task? _initialCatalogLoad;
    private bool _catalogReady;
    private object CatalogEditorKey => _mode;
    private const int CatalogPageSize = 12;
    private int _page = 1;
    private int VisibleCount => FilteredBrands.Count;
    private int CurrentPage => Math.Clamp(_page, 1, Math.Max(1, (VisibleCount + CatalogPageSize - 1) / CatalogPageSize));
    private IReadOnlyList<BrandDto> PageItems => FilteredBrands.Skip((CurrentPage - 1) * CatalogPageSize).Take(CatalogPageSize).ToArray();
    private Guid[] VisibleIds => FilteredBrands.Select(x => x.Id).ToArray();
    private int SelectedIndex => Array.IndexOf(VisibleIds, _selectedId ?? Guid.Empty);
    private bool CanSave => IsEditing && !_loading && !_saving;
    private bool CanMovePrevious => !IsEditing && !_loading && !_saving && SelectedIndex > 0;
    private bool CanMoveNext => !IsEditing && !_loading && !_saving && SelectedIndex < VisibleCount - 1;
    private string CatalogEmptyText(string emptyText) => _loading ? "جاري تحميل البيانات..." : emptyText;
    private void ChangePage(int page) { if (!IsEditing && !_saving && !_loading) _page = page; }
    private void RevealSelected()
    {
        var index = SelectedIndex;
        if (index >= 0) _page = index / CatalogPageSize + 1;
    }
    private void NavigateRecord(int direction)
    {
        if (IsEditing || _saving || _loading) return;
        var ids = VisibleIds;
        if (ids.Length == 0) return;
        var index = Array.IndexOf(ids, _selectedId ?? Guid.Empty);
        index = direction switch { -2 => 0, 2 => ids.Length - 1, _ => Math.Clamp(index + direction, 0, ids.Length - 1) };
        Select(ids[index]);
        RevealSelected();
    }
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Screen}/{RecordId}";
        if (_appliedInventoryRoute == key) return;
        _appliedInventoryRoute = key;
        _catalogReady = false;
        _mode = EditorMode.Empty;
        _selectedId = null;
        _page = 1;
        _search = null;
        ClearForm();
        await (_initialCatalogLoad ??= LoadAsync());
        if (_appliedInventoryRoute != key) return;
        ClearForm();
        if (Screen == "new") await BeginCreateAsync(new MouseEventArgs());
        else if (RecordId is { } id && _brands.Any(x => x.Id == id) && Screen is ("details" or "edit"))
        {
            Select(id);
            if (Screen == "edit") await BeginEditAsync(new MouseEventArgs());
        }
        else if (VisibleIds.FirstOrDefault() is var first && first != Guid.Empty) Select(first);
        RevealSelected();
        _catalogReady = true;
    }
    private async Task ReloadCatalogAsync()
    {
        await LoadAsync();
        if (_selectedId is { } id && _brands.Any(x => x.Id == id)) LoadSelected(id);
        else if (VisibleIds.FirstOrDefault() is var first && first != Guid.Empty) Select(first);
        RevealSelected();
    }
    private static async Task<IReadOnlyList<T>> LoadAllPagesAsync<T>(Func<PageRequest, Task<PagedResult<T>>> loader)
    {
        var items = new List<T>();
        for (var pageNumber = 1; ; pageNumber++)
        {
            var page = await loader(new PageRequest { PageNumber = pageNumber, PageSize = PageRequest.MaximumPageSize });
            items.AddRange(page.Items);
            if (!page.HasNextPage) return items;
        }
    }

    private enum EditorMode { Empty, View, Create, Edit }

    private const string CodeField = "كود العلامة التجارية";
    private const string NameField = "اسم العلامة التجارية";

    [Inject] private IInventoryClientService Inventory { get; set; } = default!;
    [Inject] private InventorySpreadsheetClient SpreadsheetClient { get; set; } = default!;
    [Inject] private BrowserFileDownloadService SpreadsheetDownload { get; set; } = default!;
    [Inject] private IApiFeedbackService ApiFeedback { get; set; } = default!;
    [Inject] private IUiSnackbarService Snackbar { get; set; } = default!;

    private static readonly IReadOnlyList<string> Headers = ["الكود", "الاسم", "الحالة"];
    private IReadOnlyList<BrandDto> _brands = [];
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);
    private EditorMode _mode = EditorMode.Empty;
    private Guid? _selectedId;
    private bool _loading = true;
    private bool _saving;
    private bool _exporting;
    private bool _spreadsheetBusy;
    private bool _spreadsheetImportOpen;
    private string? _search;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private bool _isActive = true;

    private bool IsEditing => _mode is EditorMode.Create or EditorMode.Edit;
    private bool CanEdit => _mode == EditorMode.View && _selectedId.HasValue;

    private IReadOnlyList<BrandDto> FilteredBrands => _brands
        .Where(x => Match(_search, x.Code, x.Name))
        .OrderBy(x => x.Code, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();



    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _brands = await LoadAllPagesAsync(page => Inventory.GetBrandsAsync(page));
            if (_selectedId.HasValue && !_brands.Any(x => x.Id == _selectedId.Value))
            {
                _selectedId = null;
                _mode = EditorMode.Empty;
                ClearForm();
            }
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _loading = false; }
    }

    private async Task RefreshAsync(MouseEventArgs args) => await ReloadCatalogAsync();
    private Task SearchChangedAsync(string? value) { _page = 1; return Task.CompletedTask; }

    private async Task BeginCreateAsync(MouseEventArgs args)
    {
        if (IsEditing || _saving || _loading) return;
        _selectedId = null;
        _mode = EditorMode.Create;
        ClearForm();
        _isActive = true;
        await AssignGeneratedCodeAsync(InventoryCodeKinds.Brand);
    }

    private Task BeginEditAsync(MouseEventArgs args)
    {
        if (!CanEdit || _saving || _loading) return Task.CompletedTask;
        ClearValidation();
        _mode = EditorMode.Edit;
        return Task.CompletedTask;
    }

    private Task CancelAsync(MouseEventArgs args)
    {
        if (_saving) return Task.CompletedTask;
        ClearValidation();
        if (_selectedId.HasValue)
        {
            _mode = EditorMode.View;
            LoadSelected(_selectedId.Value);
        }
        else
        {
            _mode = EditorMode.Empty;
            ClearForm();
        }
        return Task.CompletedTask;
    }

    private async Task SaveAsync(MouseEventArgs args)
    {
        if (!IsEditing || _saving || _loading || !ValidateForm()) return;
        _saving = true;
        try
        {
            BrandDto? saved = _mode == EditorMode.Create
                ? await Inventory.CreateBrandAsync(new CreateBrandRequest(_code.Trim(), _name.Trim()))
                : await Inventory.UpdateBrandAsync(_selectedId!.Value, new UpdateBrandRequest(_code.Trim(), _name.Trim(), _isActive));

            if (saved is null) return;
            _selectedId = saved.Id;
            _mode = EditorMode.View;
            await LoadAsync();
            LoadSelected(saved.Id);
            Snackbar.Success("تم حفظ العلامة التجارية بنجاح."); _search = null; RevealSelected();
        }
        catch (ApiClientException ex)
        {
            if (string.Equals(ex.Error.Code, "unique_constraint_conflict", StringComparison.OrdinalIgnoreCase))
            {
                await LoadAsync();
                ApplyDuplicateErrors();
                Snackbar.Error("توجد بيانات مكررة. راجع الحقول المميزة باللون الأحمر.");
            }
            else ApiFeedback.Show(ex.Error);
        }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _saving = false; }
    }

    private bool ValidateForm()
    {
        ClearValidation();
        var missing = false;
        if (string.IsNullOrWhiteSpace(_code)) { SetError(CodeField, "هذا الحقل إجباري."); missing = true; }
        if (string.IsNullOrWhiteSpace(_name)) { SetError(NameField, "هذا الحقل إجباري."); missing = true; }
        ValidateMaxLength(CodeField, _code, 32);
        ValidateMaxLength(NameField, _name, 100);
        ApplyDuplicateErrors();

        if (_fieldErrors.Count == 0) return true;
        Snackbar.Error(missing ? "هناك بيانات إجبارية لم يتم إدخالها." : "توجد بيانات غير صحيحة. راجع الحقول المميزة باللون الأحمر.");
        return false;
    }

    private void ApplyDuplicateErrors()
    {
        if (!string.IsNullOrWhiteSpace(_code) &&
            _brands.Any(x => x.Id != _selectedId && string.Equals(x.Code, _code.Trim(), StringComparison.OrdinalIgnoreCase)))
            SetError(CodeField, "هذا الكود مستخدم مسبقًا.");

        if (!string.IsNullOrWhiteSpace(_name) &&
            _brands.Any(x => x.Id != _selectedId && string.Equals(x.Name, _name.Trim(), StringComparison.CurrentCultureIgnoreCase)))
            SetError(NameField, "اسم العلامة التجارية مستخدم مسبقًا.");
    }

    private void Select(Guid id)
    {
        if (IsEditing || _saving || _loading) return;
        _selectedId = id;
        _mode = EditorMode.View;
        LoadSelected(id);
    }

    private void LoadSelected(Guid id)
    {
        ClearValidation();
        var item = _brands.FirstOrDefault(x => x.Id == id);
        if (item is null) return;
        _code = item.Code;
        _name = item.Name;
        _isActive = item.IsActive;
    }

    private void ClearForm()
    {
        ClearValidation();
        _code = string.Empty;
        _name = string.Empty;
        _isActive = true;
    }

    private async Task AssignGeneratedCodeAsync(string kind)
    {
        try
        {
            var suggestion = await Inventory.GetNextCodeAsync(kind);
            if (_mode == EditorMode.Create && suggestion is not null)
                _code = suggestion.Code;
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
    }

    private Task SetActiveAsync(bool value) { _isActive = value; return Task.CompletedTask; }
    private void ValidateMaxLength(string key, string? value, int max) { if (!string.IsNullOrEmpty(value) && value.Length > max) SetError(key, $"الحد الأقصى {max} حرفًا."); }
    private string? ErrorFor(string key) => _fieldErrors.TryGetValue(key, out var value) ? value : null;
    private void SetError(string key, string message) => _fieldErrors[key] = message;
    private void ClearFieldError(string key) => _fieldErrors.Remove(key);
    private void ClearValidation() => _fieldErrors.Clear();
    private void SetField(string key, Action setter) { setter(); ClearFieldError(key); }
    private static bool Match(string? search, params string?[] values)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;
        var term = search.Trim();
        return values.Any(x => x?.Contains(term, StringComparison.CurrentCultureIgnoreCase) == true);
    }

    private Task OpenSpreadsheetImportAsync()
    {
        _spreadsheetImportOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseSpreadsheetImportAsync()
    {
        _spreadsheetImportOpen = false;
        return Task.CompletedTask;
    }

    private async Task ReloadAfterSpreadsheetImportAsync()
    {
        await ReloadCatalogAsync();
    }

    private async Task DownloadTemplateAsync()
    {
        if (_spreadsheetBusy) return;
        _spreadsheetBusy = true;
        try
        {
            var bytes = await SpreadsheetClient.TemplateAsync("brands");
            await SpreadsheetDownload.SaveAsync(bytes, "inventory-brands-template.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _spreadsheetBusy = false; }
    }

    private async Task ExportAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var bytes = await SpreadsheetClient.ExportAsync("brands", new PageRequest { Search = _search });
            await SpreadsheetDownload.SaveAsync(bytes, "inventory-brands.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _exporting = false; }
    }
}
