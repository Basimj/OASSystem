@page "/inventory/reports/products"
@attribute [Authorize]
@using System.Globalization
@using OAS.Client.Accounting.Pages
@using OAS.Client.Inventory.Services
@using OAS.Client.Common.Feedback.Services
@using OAS.Client.Services.Http
@using OAS.Contracts.Common.Pagination
@using OAS.Contracts.Inventory.Products
@using OAS.Contracts.Inventory.Stock
@using OAS.Contracts.Inventory.Transactions
@using OAS.Contracts.Inventory.Warehouses
@using OAS.Contracts.Accounting.Currencies
@using OAS.Contracts.Accounting.Enums
@using OAS.Contracts.Enums.Inventory
@using OAS.UiLib.Core.Models
@inject IInventoryClientService Inventory
@inject IAccountingClientService Accounting
@inject IJSRuntime JS
@inject IApiFeedbackService ApiFeedback

<PageTitle>المنتجات | OAS</PageTitle>
<div class="products-report">
<UiReportWorkspace Title="المنتجات" StatusText="@(_busy ? "جارٍ التحميل" : ReportTypeName(_applied.ReportType))" Search="@_search" SearchChanged="OnSearch" FiltersOpen="@_filtersOpen" FiltersOpenChanged="@(v=>_filtersOpen=v)">
    <Toolbar>
        <button type="button" class="oas-report__tool" title="تحديث" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-rotate"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--pdf" title="حفظ PDF" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-regular fa-file-pdf"></i></button>
        <button type="button" class="oas-report__tool oas-report__tool--excel" title="تصدير Excel" disabled="@(!CanExport)" @onclick="ExportAsync"><i class="fa-regular fa-file-excel"></i></button>
        <button type="button" class="oas-report__tool" title="طباعة" disabled="@(!CanExport)" @onclick="PrintAsync"><i class="fa-solid fa-print"></i></button>
        <button type="button" class="oas-report__tool" title="إظهار أو إخفاء الفلاتر" @onclick="@(()=>_filtersOpen=!_filtersOpen)"><i class="fa-solid fa-ellipsis-vertical"></i></button>
    </Toolbar>
    <QuickFilters>
        @foreach (var chip in Chips)
        {
            <div class="oas-report__chip" title="@($"{chip.Label}: {chip.Value}")">
                <span class="oas-report__chip-label">@chip.Label:</span>
                <strong>@chip.Value</strong>
            </div>
        }
    </QuickFilters>
    <FilterPanel>
        <div class="product-fields">
            <div class="oas-report__field">
                <UiReportSearchPicker Label="الصنف" ItemLabel="صنف" DialogTitle="اختيار الصنف" SearchPlaceholder="ابحث بالاسم أو رمز الصنف..." Value="@_draft.Variant" ValueChanged="OnVariant" Options="@VariantOptions" Placeholder="جميع الأصناف" />
            </div>
            @if (string.IsNullOrEmpty(_draft.Variant))
            {
                <label class="oas-report__field">المنتج<select disabled><option>اختر الصنف أولاً</option></select></label>
            }
            else
            {
                <div class="oas-report__field">
                    <UiReportSearchPicker Label="المنتج" ItemLabel="منتج" DialogTitle="المنتج المرتبط بالصنف" Value="@_draft.Product" ValueChanged="OnProduct" Options="@ProductOptions" Placeholder="المنتج المرتبط" />
                </div>
            }
            <label class="oas-report__field">التصنيف<select value="@_draft.Category" @onchange="OnCategory"><option value="">جميع التصنيفات</option>@foreach(var o in Categories){<option value="@o.Id">@o.Name</option>}</select></label>
            <label class="oas-report__field">العلامة التجارية<select @bind="_draft.Brand"><option value="">جميع العلامات</option>@foreach(var o in Brands){<option value="@o.Id">@o.Name</option>}</select></label>
            <label class="oas-report__field">المستودع<select @bind="_draft.Warehouse"><option value="">جميع المستودعات</option>@foreach(var o in Warehouses){<option value="@o.Id">@o.Name</option>}</select></label>
            <label class="oas-report__field">نوع التقرير<select @bind="_draft.ReportType"><option value="balances">أرصدة المنتجات</option><option value="movement-qty">حركة المنتجات - كميات</option><option value="movement-cost">حركة المنتجات - تكاليف</option><option value="prices">قائمة المنتجات والأسعار</option><option value="valuation">تقييم المخزون</option><option value="stagnant">المنتجات الراكدة والنوافد</option></select></label>
            @if (NeedsDateRange)
            {
                <div class="oas-report__date-pair">
                    <label class="oas-report__field">من تاريخ<input type="date" @bind="_draft.From" @bind:format="yyyy-MM-dd" /></label>
                    <label class="oas-report__field">إلى تاريخ<input type="date" @bind="_draft.To" @bind:format="yyyy-MM-dd" /></label>
                </div>
            }
            else if (NeedsToDate)
            {
                <label class="oas-report__field">إلى تاريخ<input type="date" @bind="_draft.To" @bind:format="yyyy-MM-dd" /></label>
            }
            @if (_draft.ReportType == "stagnant")
            {
                <label class="oas-report__field">أيام الركود<select @bind="_draft.StagnantDays"><option value="30">30 يوم</option><option value="60">60 يوم</option><option value="90">90 يوم</option><option value="180">180 يوم</option></select></label>
            }
            <label class="oas-report__field">حالة المخزون<select @bind="_draft.StockState"><option value="all">الكل</option><option value="available">متوفر</option><option value="out">نافد</option><option value="reserved">محجوز</option><option value="stagnant">راكد</option></select></label>
            <label class="oas-report__field">العملة<select @bind="_draft.Currency" disabled="@(!UsesCurrency)"><option value="">@_baseName (الأساسية)</option>@foreach(var c in _currencies.Where(x=>x.IsActive&&x.Id!=_baseId)){<option value="@c.Id">@c.NameAr (@c.Code)</option>}</select></label>
            <label class="oas-report__field-check"><input type="checkbox" @bind="_draft.HideZero" /> إخفاء الصفوف الصفرية</label>
            <label class="oas-report__field-check"><input type="checkbox" @bind="_draft.IncludeInactive" /> تضمين الأصناف غير النشطة</label>
            @if (_validation is not null)
            {
                <div role="alert" class="product-warning">@_validation</div>
            }
        </div>
        <div class="oas-report__apply"><button type="button" class="primary" disabled="@_busy" @onclick="ApplyAsync"><i class="fa-solid fa-filter"></i> تطبيق</button><button type="button" disabled="@_busy" @onclick="ResetAsync"><i class="fa-solid fa-rotate-left"></i> إعادة تعيين</button></div>
    </FilterPanel>
    <TableContent>
        @if (_busy)
        {
            <div class="oas-report__empty">جارٍ تحميل بيانات تقرير المنتجات...</div>
        }
        else if (_error is not null)
        {
            <div class="oas-report__empty" role="alert">@_error</div>
        }
        else
        {
            <table class="oas-report__table product-table">
                <thead>
                    <tr>
                        @foreach (var col in CurrentColumns)
                        {
                            <UiReportSortHeader @key="col.Key" Label="@col.Label" Active="@(_sortKey==col.Key)" Descending="@_descending" OnSort="@(()=>SortBy(col.Key))" />
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr><td colspan="@CurrentColumns.Length" class="oas-report__empty">لا توجد نتائج مطابقة للفلاتر.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PageRows)
                        {
                            <tr>
                                @foreach (var col in CurrentColumns)
                                {
                                    var value = Cell(row, col.Key);
                                    <td class="@col.Css" title="@FormatValue(value, col.Key)">@FormatValue(value, col.Key)</td>
                                }
                            </tr>
                        }
                        <tr class="product-total">
                            <td colspan="@IdentityCount">إجمالي النتائج</td>
                            @foreach (var col in CurrentColumns.Skip(IdentityCount))
                            {
                                <td class="@col.Css">@FormatValue(Total(_rows, col.Key), col.Key)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </TableContent>
    <Pagination>
        <div class="oas-report__pager"><button @onclick="@(()=>GoPage(1))" disabled="@(_page==1)">»</button><button @onclick="@(()=>GoPage(_page-1))" disabled="@(_page==1)">‹</button><button class="active" disabled>@_page</button><button @onclick="@(()=>GoPage(_page+1))" disabled="@(_page>=TotalPages)">›</button><button @onclick="@(()=>GoPage(TotalPages))" disabled="@(_page>=TotalPages)">«</button></div>
        <span>عرض @(_rows.Count==0?0:(_page-1)*_pageSize+1) - @Math.Min(_page*_pageSize,_rows.Count) من @_rows.Count نتيجة</span>
        <label>لكل صفحة <select value="@_pageSize" @onchange="ChangePageSize"><option>10</option><option selected>25</option><option>50</option><option>100</option></select></label>
    </Pagination>
    <Metrics>
        @foreach (var metric in Metrics)
        {
            <UiReportMetric Label="@metric.Label" Value="@metric.Value" Tone="@metric.Tone" Icon="@metric.Icon" />
        }
    </Metrics>
</UiReportWorkspace>
</div>

@code {
    private sealed record Filters
    {
        public string Variant { get; set; } = "";
        public string Product { get; set; } = "";
        public string Category { get; set; } = "";
        public string Brand { get; set; } = "";
        public string Warehouse { get; set; } = "";
        public string ReportType { get; set; } = "balances";
        public string StockState { get; set; } = "all";
        public DateTime From { get; set; } = new(DateTime.Today.Year, 1, 1);
        public DateTime To { get; set; } = DateTime.Today;
        public int StagnantDays { get; set; } = 90;
        public Guid? Currency { get; set; }
        public bool HideZero { get; set; }
        public bool IncludeInactive { get; set; }
    }

    private sealed record VariantView(
        ProductVariantDto Variant,
        ProductDto Product,
        ProductCategoryDto? Category,
        ProductTypeDto? Type,
        BrandDto? Brand,
        UnitDto? Unit)
    {
        public string VariantCode => Variant.SKU;
        public string VariantName => string.IsNullOrWhiteSpace(Variant.VariantName) ? Product.Name : Variant.VariantName!;
        public string ProductName => Product.Name;
        public string ProductCode => Product.ProductCode;
        public string CategoryName => Category?.Name ?? "—";
        public string BrandName => Brand?.Name ?? "—";
        public string UnitName => Unit?.Name ?? "غير محددة";
        public bool IsActive => Variant.IsActive && Product.IsActive;
        public bool IsStockItem => Product.IsStockItem;
    }

    private sealed record ProductReportRow(
        VariantView Item,
        string WarehouseName,
        decimal OnHand,
        decimal Reserved,
        decimal Available,
        decimal OnOrder,
        decimal AverageCost,
        decimal InventoryValue,
        DateTimeOffset? LastMovementAt,
        decimal OpeningQty,
        decimal InQty,
        decimal OutQty,
        decimal ClosingQty,
        decimal OpeningCost,
        decimal InCost,
        decimal OutCost,
        decimal ClosingCost,
        int DaysIdle)
    {
        public string Status => OnHand <= 0 ? "نافد" : Reserved >= OnHand && OnHand > 0 ? "محجوز" : DaysIdle > 0 ? "متوفر" : "متوفر";
    }

    private sealed record ColumnDef(string Key, string Label, string Css = "");
    private sealed record MetricDef(string Label, string Value, string Tone, string Icon);

    private static readonly ColumnDef[] BalanceColumns =
    [
        new("code", "رقم الصنف"), new("name", "اسم الصنف"), new("product", "المنتج"), new("unit", "الوحدة"), new("warehouse", "المستودع"),
        new("onHand", "الرصيد الفعلي"), new("reserved", "المحجوز", "neg"), new("available", "المتاح", "pos"), new("onOrder", "قيد الطلب", "info"),
        new("avgCost", "متوسط التكلفة"), new("value", "قيمة المخزون"), new("last", "آخر حركة")
    ];
    private static readonly ColumnDef[] MovementColumns =
    [
        new("code", "رقم الصنف"), new("name", "اسم الصنف"), new("product", "المنتج"), new("unit", "الوحدة"), new("warehouse", "المستودع"),
        new("opening", "الرصيد الافتتاحي"), new("incoming", "الوارد", "pos"), new("outgoing", "الصادر", "neg"), new("closing", "المتبقي")
    ];
    private static readonly ColumnDef[] PriceColumns =
    [
        new("code", "رقم الصنف"), new("name", "اسم الصنف"), new("product", "المنتج"), new("category", "التصنيف"), new("brand", "العلامة"),
        new("barcode", "الباركود"), new("unit", "الوحدة"), new("purchasePrice", "سعر الشراء"), new("sellingPrice", "سعر البيع"), new("active", "الحالة")
    ];
    private static readonly ColumnDef[] ValuationColumns =
    [
        new("code", "رقم الصنف"), new("name", "اسم الصنف"), new("product", "المنتج"), new("unit", "الوحدة"), new("warehouse", "المستودع"),
        new("onHand", "الرصيد"), new("avgCost", "متوسط التكلفة"), new("value", "قيمة المخزون"), new("share", "نسبة القيمة"), new("last", "آخر حركة")
    ];
    private static readonly ColumnDef[] StagnantColumns =
    [
        new("code", "رقم الصنف"), new("name", "اسم الصنف"), new("product", "المنتج"), new("warehouse", "المستودع"), new("available", "المتاح", "pos"),
        new("onHand", "الرصيد"), new("last", "آخر حركة"), new("daysIdle", "أيام الركود"), new("stockStatus", "الحالة")
    ];

    private Filters _draft = new();
    private Filters _applied = new();
    private bool _busy;
    private bool _filtersOpen = true;
    private string _search = "";
    private string? _error;
    private string? _validation;
    private string _sortKey = "code";
    private bool _descending;
    private int _page = 1;
    private int _pageSize = 25;
    private decimal _rate = 1m;
    private Guid? _baseId;
    private string _baseName = "العملة الأساسية";
    private string _currencyName = "العملة الأساسية";
    private List<CurrencyDto> _currencies = [];
    private IReadOnlyList<ProductDto> _products = [];
    private IReadOnlyList<ProductVariantDto> _variants = [];
    private IReadOnlyList<ProductCategoryDto> _categories = [];
    private IReadOnlyList<ProductTypeDto> _productTypes = [];
    private IReadOnlyList<BrandDto> _brands = [];
    private IReadOnlyList<UnitDto> _units = [];
    private IReadOnlyList<WarehouseDto> _warehouses = [];
    private IReadOnlyList<InventoryBalanceDto> _balances = [];
    private IReadOnlyList<InventoryLedgerDto> _ledger = [];
    private IReadOnlyDictionary<Guid, InventoryTransactionDto> _transactions = new Dictionary<Guid, InventoryTransactionDto>();
    private IReadOnlyList<ProductReportRow> _rows = [];

    private IReadOnlyList<ProductCategoryDto> Categories => _categories.OrderBy(x => x.Name).ToArray();
    private IReadOnlyList<BrandDto> Brands => _brands.OrderBy(x => x.Name).ToArray();
    private IReadOnlyList<WarehouseDto> Warehouses => _warehouses.OrderBy(x => x.Name).ToArray();
    private IReadOnlyList<UiSelectOption> VariantOptions => VariantViews
        .Where(x => _draft.IncludeInactive || x.IsActive)
        .OrderBy(x => x.VariantCode).ThenBy(x => x.VariantName)
        .Select(x => new UiSelectOption(x.Variant.Id.ToString(), $"{x.VariantCode} - {x.VariantName}"))
        .ToArray();
    private IReadOnlyList<UiSelectOption> ProductOptions
    {
        get
        {
            if (!Guid.TryParse(_draft.Variant, out var variantId)) return [];
            var item = VariantViews.FirstOrDefault(x => x.Variant.Id == variantId);
            return item is null ? [] : [new UiSelectOption(item.Product.Id.ToString(), $"{item.Product.ProductCode} - {item.Product.Name}")];
        }
    }
    private IReadOnlyList<VariantView> VariantViews =>
        (from v in _variants
         join p in _products on v.ProductId equals p.Id
         let category = _categories.FirstOrDefault(x => x.Id == p.CategoryId)
         let type = category is null ? null : _productTypes.FirstOrDefault(x => x.Id == category.ProductTypeId)
         let brand = p.BrandId is Guid brandId ? _brands.FirstOrDefault(x => x.Id == brandId) : null
         let unit = v.UnitId is Guid unitId ? _units.FirstOrDefault(x => x.Id == unitId) : null
         select new VariantView(v, p, category, type, brand, unit)).ToArray();
    private ColumnDef[] CurrentColumns => _applied.ReportType switch
    {
        "movement-qty" => MovementColumns,
        "movement-cost" => MovementColumns,
        "prices" => PriceColumns,
        "valuation" => ValuationColumns,
        "stagnant" => StagnantColumns,
        _ => BalanceColumns
    };
    private int IdentityCount => _applied.ReportType switch
    {
        "movement-qty" or "movement-cost" => 5,
        "prices" => 6,
        "valuation" => 5,
        "stagnant" => 4,
        _ => 5
    };
    private bool NeedsDateRange => _draft.ReportType is "movement-qty" or "movement-cost";
    private bool NeedsToDate => _draft.ReportType is "balances" or "valuation" or "prices" or "stagnant";
    private bool UsesCurrency => _draft.ReportType is not "movement-qty" and not "prices";
    private bool AppliedNeedsDateRange => _applied.ReportType is "movement-qty" or "movement-cost";
    private bool AppliedUsesCurrency => _applied.ReportType is not "movement-qty" and not "prices";
    private bool CanExport => !_busy && _error is null && _rows.Count > 0;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));
    private IReadOnlyList<ProductReportRow> PageRows => _rows.Skip((_page - 1) * _pageSize).Take(_pageSize).ToArray();
    private IReadOnlyList<(string Label, string Value)> Chips =>
    [
        ("الصنف", SelectedVariantLabel),
        ("المنتج", SelectedProductLabel),
        ("التصنيف", Name(Categories, _applied.Category, "الكل")),
        ("العلامة", Name(Brands, _applied.Brand, "الكل")),
        ("المستودع", Name(Warehouses, _applied.Warehouse, "الكل")),
        ("النوع", ReportTypeName(_applied.ReportType)),
        ("الحالة", StockStateName(_applied.StockState)),
        (AppliedNeedsDateRange ? "الفترة" : "إلى تاريخ", AppliedNeedsDateRange ? $"{_applied.From:dd/MM/yyyy} – {_applied.To:dd/MM/yyyy}" : _applied.To.ToString("dd/MM/yyyy")),
        ("العملة", AppliedUsesCurrency ? _currencyName : "—")
    ];
    private string SelectedVariantLabel => VariantViews.FirstOrDefault(x => x.Variant.Id.ToString() == _applied.Variant) is { } item ? $"{item.VariantCode} - {item.VariantName}" : "الكل";
    private string SelectedProductLabel => VariantViews.FirstOrDefault(x => x.Product.Id.ToString() == _applied.Product) is { } item ? item.ProductName : "الكل";

    private IReadOnlyList<MetricDef> Metrics => _applied.ReportType switch
    {
        "movement-qty" =>
        [
            new("عدد المنتجات", CountText(_rows.Select(x => x.Item.Product.Id).Distinct().Count()), "blue", "fa-solid fa-cube"),
            new("عدد الأصناف", CountText(_rows.Count), "violet", "fa-solid fa-boxes-stacked"),
            new("الرصيد الافتتاحي", Metric("opening"), "orange", "fa-solid fa-box-open"),
            new("إجمالي الوارد", Metric("incoming"), "green", "fa-solid fa-arrow-down"),
            new("إجمالي الصادر", Metric("outgoing"), "red", "fa-solid fa-arrow-up"),
            new("الرصيد المتبقي", Metric("closing"), "purple", "fa-solid fa-scale-balanced")
        ],
        "movement-cost" =>
        [
            new("عدد المنتجات", CountText(_rows.Select(x => x.Item.Product.Id).Distinct().Count()), "blue", "fa-solid fa-cube"),
            new("عدد الأصناف", CountText(_rows.Count), "violet", "fa-solid fa-boxes-stacked"),
            new("قيمة الافتتاح", Metric("opening"), "orange", "fa-solid fa-box-open"),
            new("إجمالي الوارد", Metric("incoming"), "green", "fa-solid fa-arrow-down"),
            new("إجمالي الصادر", Metric("outgoing"), "red", "fa-solid fa-arrow-up"),
            new("قيمة المتبقي", Metric("closing"), "purple", "fa-solid fa-coins")
        ],
        "prices" =>
        [
            new("عدد المنتجات", CountText(_rows.Select(x => x.Item.Product.Id).Distinct().Count()), "blue", "fa-solid fa-cube"),
            new("عدد الأصناف", CountText(_rows.Count), "violet", "fa-solid fa-boxes-stacked"),
            new("سعر شراء مرجعي", Metric("purchasePrice"), "orange", "fa-solid fa-cart-shopping"),
            new("سعر بيع مرجعي", Metric("sellingPrice"), "green", "fa-solid fa-tags"),
            new("الأصناف النشطة", CountText(_rows.Count(x => x.Item.IsActive)), "purple", "fa-solid fa-circle-check"),
            new("الأصناف غير النشطة", CountText(_rows.Count(x => !x.Item.IsActive)), "red", "fa-solid fa-circle-stop")
        ],
        "valuation" =>
        [
            new("إجمالي قيمة المخزون", Metric("value"), "purple", "fa-solid fa-coins"),
            new("الرصيد الفعلي", Metric("onHand"), "green", "fa-solid fa-cubes-stacked"),
            new("متوسط التكلفة", Metric("avgCost"), "orange", "fa-solid fa-scale-balanced"),
            new("عدد الأصناف", CountText(_rows.Count), "violet", "fa-solid fa-boxes-stacked"),
            new("عدد المنتجات", CountText(_rows.Select(x => x.Item.Product.Id).Distinct().Count()), "blue", "fa-solid fa-cube"),
            new("آخر تحديث", _rows.MaxBy(x => x.LastMovementAt)?.LastMovementAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—", "red", "fa-solid fa-clock")
        ],
        "stagnant" =>
        [
            new("الأصناف الراكدة", CountText(_rows.Count(x => x.DaysIdle >= _applied.StagnantDays && x.OnHand > 0)), "red", "fa-solid fa-hourglass-end"),
            new("الأصناف النافدة", CountText(_rows.Count(x => x.OnHand <= 0)), "purple", "fa-solid fa-box-open"),
            new("قيمة المخزون الراكد", FormatValue(_rows.Where(x => x.DaysIdle >= _applied.StagnantDays && x.OnHand > 0).Sum(x => x.InventoryValue), "value"), "orange", "fa-solid fa-coins"),
            new("عدد الأصناف", CountText(_rows.Count), "violet", "fa-solid fa-boxes-stacked"),
            new("عدد المنتجات", CountText(_rows.Select(x => x.Item.Product.Id).Distinct().Count()), "blue", "fa-solid fa-cube"),
            new("أعلى ركود", CountText(_rows.Where(x => x.DaysIdle < int.MaxValue).Select(x => x.DaysIdle).DefaultIfEmpty().Max()), "green", "fa-solid fa-calendar-xmark")
        ],
        _ =>
        [
            new("إجمالي قيمة المخزون", Metric("value"), "purple", "fa-solid fa-coins"),
            new("قيمة المخزون المحجوز", FormatValue(_rows.Sum(x => x.Reserved * x.AverageCost), "value"), "orange", "fa-solid fa-lock"),
            new("الأصناف المتوفرة", CountText(_rows.Count(x => x.Available > 0)), "green", "fa-solid fa-circle-check"),
            new("الأصناف النافدة", CountText(_rows.Count(x => x.OnHand <= 0)), "red", "fa-solid fa-circle-xmark"),
            new("عدد الأصناف", CountText(_rows.Count), "violet", "fa-solid fa-boxes-stacked"),
            new("عدد المنتجات", CountText(_rows.Select(x => x.Item.Product.Id).Distinct().Count()), "blue", "fa-solid fa-cube")
        ]
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadReferenceDataAsync();
        await ApplyAsync();
    }

    private async Task LoadReferenceDataAsync()
    {
        try
        {
            var settingsTask = Accounting.GetAccountingSettingsAsync();
            var categoriesTask = LoadAllPagesAsync(page => Inventory.GetProductCategoriesAsync(page));
            var typesTask = LoadAllPagesAsync(page => Inventory.GetProductTypesAsync(page));
            var brandsTask = LoadAllPagesAsync(page => Inventory.GetBrandsAsync(page));
            var unitsTask = LoadAllPagesAsync(page => Inventory.GetUnitsAsync(page));
            var productsTask = LoadAllPagesAsync(page => Inventory.GetProductsAsync(page));
            var variantsTask = LoadAllPagesAsync(page => Inventory.GetProductVariantsAsync(page));
            var warehousesTask = LoadAllPagesAsync(page => Inventory.GetWarehousesAsync(page));
            var balancesTask = LoadAllPagesAsync(page => Inventory.GetInventoryBalancesAsync(page));
            await Task.WhenAll(settingsTask, categoriesTask, typesTask, brandsTask, unitsTask, productsTask, variantsTask, warehousesTask, balancesTask);
            var settings = await settingsTask;
            _baseId = settings?.BaseCurrencyId;
            _products = await productsTask;
            _variants = await variantsTask;
            _categories = await categoriesTask;
            _productTypes = await typesTask;
            _brands = await brandsTask;
            _units = await unitsTask;
            _warehouses = await warehousesTask;
            _balances = await balancesTask;
            for (var p = 1; ; p++)
            {
                var r = await Accounting.GetCurrenciesPageAsync(new PageRequest { PageNumber = p, PageSize = 100 });
                _currencies.AddRange(r.Items);
                if (!r.HasNextPage) break;
            }
            _baseName = _currencies.FirstOrDefault(x => x.Id == _baseId)?.NameAr ?? settings?.BaseCurrencyCode ?? "العملة الأساسية";
            _currencyName = _baseName;
        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(ex.Error);
            _error = "تعذر تحميل البيانات المرجعية لتقرير المنتجات.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static async Task<IReadOnlyList<T>> LoadAllPagesAsync<T>(Func<PageRequest, Task<PagedResult<T>>> loader)
    {
        var items = new List<T>();
        var pageNumber = 1;
        while (true)
        {
            var result = await loader(new PageRequest { PageNumber = pageNumber, PageSize = PageRequest.MaximumPageSize });
            items.AddRange(result.Items);
            if (!result.HasNextPage) break;
            pageNumber++;
        }
        return items;
    }

    private void OnVariant(string? value)
    {
        _draft.Variant = value ?? "";
        _draft.Product = VariantViews.FirstOrDefault(x => x.Variant.Id.ToString() == _draft.Variant)?.Product.Id.ToString() ?? "";
    }

    private void OnProduct(string? value)
    {
        if (ProductOptions.Any(x => x.Value == value)) _draft.Product = value ?? "";
    }

    private void OnCategory(ChangeEventArgs e)
    {
        _draft.Category = e.Value?.ToString() ?? "";
        if (Guid.TryParse(_draft.Variant, out var variantId))
        {
            var item = VariantViews.FirstOrDefault(x => x.Variant.Id == variantId);
            if (item is not null && item.Category?.Id.ToString() != _draft.Category)
            {
                OnVariant("");
            }
        }
    }

    private async Task ResetAsync()
    {
        _draft = new();
        _search = "";
        await ApplyAsync();
    }

    private async Task ApplyAsync()
    {
        _validation = null;
        if (NeedsDateRange && _draft.From.Date > _draft.To.Date)
        {
            _validation = "تحقق من تاريخ بداية ونهاية الفترة.";
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            var next = new Filters
            {
                Variant = _draft.Variant,
                Product = _draft.Product,
                Category = _draft.Category,
                Brand = _draft.Brand,
                Warehouse = _draft.Warehouse,
                ReportType = _draft.ReportType,
                StockState = _draft.StockState,
                From = _draft.From,
                To = _draft.To,
                StagnantDays = _draft.StagnantDays,
                Currency = _draft.Currency,
                HideZero = _draft.HideZero,
                IncludeInactive = _draft.IncludeInactive
            };

            var rate = 1m;
            var currency = _baseName;
            if (UsesCurrency && next.Currency is Guid currencyId && currencyId != _baseId)
            {
                var c = _currencies.FirstOrDefault(x => x.Id == currencyId && x.IsActive) ?? throw new InvalidOperationException("العملة غير متاحة.");
                var r = await Accounting.GetEffectiveExchangeRateAsync(currencyId, DateOnly.FromDateTime(next.To), ExchangeRateType.Accounting);
                if (r is null || r.Rate <= 0) throw new InvalidOperationException("لا يوجد سعر صرف محاسبي صالح لهذه العملة.");
                rate = r.Rate;
                currency = $"{c.NameAr} ({c.Code})";
            }

            _ledger = [];
            _transactions = new Dictionary<Guid, InventoryTransactionDto>();
            if (next.ReportType is "movement-qty" or "movement-cost")
            {
                await LoadMovementDataAsync(next);
            }

            _rate = rate;
            _currencyName = currency;
            _applied = next;
            BuildRows();
        }
        catch (ApiClientException ex)
        {
            _error = "تعذر تحميل بيانات تقرير المنتجات.";
            ApiFeedback.Show(ex.Error);
            _rows = [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _rows = [];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadMovementDataAsync(Filters next)
    {
        var warehouseId = Guid.TryParse(next.Warehouse, out var parsedWarehouse) ? parsedWarehouse : (Guid?)null;
        var variantId = Guid.TryParse(next.Variant, out var parsedVariant) ? parsedVariant : (Guid?)null;
        var toDate = ToEndOfDay(next.To);
        var ledger = await LoadAllPagesAsync(page => Inventory.GetInventoryLedgerAsync(page, warehouseId: warehouseId, productVariantId: variantId, fromDate: null, toDate: toDate));
        var transactions = await LoadAllPagesAsync(page => Inventory.GetInventoryTransactionsAsync(page));
        _ledger = ledger;
        _transactions = transactions.ToDictionary(x => x.Id);
    }

    private static DateTimeOffset? ToEndOfDay(DateTime date)
    {
        var local = date.Date.AddDays(1).AddTicks(-1);
        return new DateTimeOffset(local, TimeZoneInfo.Local.GetUtcOffset(local));
    }

    private void BuildRows()
    {
        var filteredItems = VariantViews.Where(MatchFilters).ToArray();
        var list = new List<ProductReportRow>();
        var selectedWarehouseName = Name(Warehouses, _applied.Warehouse, "جميع المستودعات");
        var balanceLookup = _balances
            .Where(x => !Guid.TryParse(_applied.Warehouse, out var warehouseId) || x.WarehouseId == warehouseId)
            .GroupBy(x => x.ProductVariantId)
            .ToDictionary(g => g.Key, BuildBalanceAggregate);
        var movementLookup = BuildMovementLookup();
                foreach (var item in filteredItems)
        {
            balanceLookup.TryGetValue(item.Variant.Id, out var bal);
            movementLookup.TryGetValue(item.Variant.Id, out var mov);
            var row = new ProductReportRow(
                item,
                selectedWarehouseName,
                bal.OnHand,
                bal.Reserved,
                bal.Available,
                bal.OnOrder,
                bal.AverageCost,
                bal.InventoryValue,
                bal.LastMovement,
                mov.OpeningQty,
                mov.InQty,
                mov.OutQty,
                mov.ClosingQty,
                mov.OpeningCost,
                mov.InCost,
                mov.OutCost,
                mov.ClosingCost,
                bal.LastMovement is DateTimeOffset dt ? Math.Max(0, (int)Math.Floor((DateTimeOffset.Now - dt).TotalDays)) : int.MaxValue);
            if (_applied.HideZero && IsZeroRow(row)) continue;
            if (!MatchesStockState(row)) continue;
            if (!MatchesSearch(row)) continue;
            list.Add(row);
        }
        _rows = list;
        if (!CurrentColumns.Any(x => x.Key == _sortKey)) _sortKey = "code";
        Sort();
        _page = 1;
    }

    private bool MatchFilters(VariantView item)
    {
        if (!_applied.IncludeInactive && !item.IsActive) return false;
        if (!item.IsStockItem && _applied.ReportType is not "prices") return false;
        if (Guid.TryParse(_applied.Variant, out var variantId) && item.Variant.Id != variantId) return false;
        if (Guid.TryParse(_applied.Product, out var productId) && item.Product.Id != productId) return false;
        if (Guid.TryParse(_applied.Category, out var categoryId) && item.Category?.Id != categoryId) return false;
        if (Guid.TryParse(_applied.Brand, out var brandId) && item.Brand?.Id != brandId) return false;
        return true;
    }

    private static (decimal OnHand, decimal Reserved, decimal Available, decimal OnOrder, decimal AverageCost, decimal InventoryValue, DateTimeOffset? LastMovement) BuildBalanceAggregate(IGrouping<Guid, InventoryBalanceDto> group)
    {
        var onHand = group.Sum(x => x.OnHandQuantity);
        var inventoryValue = group.Sum(x => x.InventoryValue);
        return (
            onHand,
            group.Sum(x => x.ReservedQuantity),
            group.Sum(x => x.AvailableQuantity),
            group.Sum(x => x.OnOrderQuantity),
            onHand > 0 ? inventoryValue / onHand : group.Where(x => x.AverageUnitCost > 0).Select(x => x.AverageUnitCost).DefaultIfEmpty().Average(),
            inventoryValue,
            group.Max(x => x.LastMovementAtUtc));
    }

    private IReadOnlyDictionary<Guid, (decimal OpeningQty, decimal InQty, decimal OutQty, decimal ClosingQty, decimal OpeningCost, decimal InCost, decimal OutCost, decimal ClosingCost)> BuildMovementLookup()
    {
        var map = new Dictionary<Guid, (decimal, decimal, decimal, decimal, decimal, decimal, decimal, decimal)>();
        if (_applied.ReportType is not "movement-qty" and not "movement-cost") return map;
        var from = new DateTimeOffset(_applied.From.Date, TimeZoneInfo.Local.GetUtcOffset(_applied.From.Date));
        var to = ToEndOfDay(_applied.To) ?? DateTimeOffset.Now;
        foreach (var group in _ledger.GroupBy(x => x.ProductVariantId))
        {
            var ordered = group.OrderBy(x => x.MovementDate).ThenBy(x => x.SequenceNumber).ToArray();
            var before = ordered.LastOrDefault(x => x.MovementDate < from);
            var period = ordered.Where(x => x.MovementDate >= from && x.MovementDate <= to).ToArray();
            var closing = ordered.LastOrDefault(x => x.MovementDate <= to);
            var openingQty = before?.BalanceAfter ?? 0m;
            var openingCost = before?.InventoryValueAfter ?? 0m;
            var incomingQty = period.Sum(x => x.QuantityIn);
            var outgoingQty = period.Sum(x => x.QuantityOut);
            var incomingCost = period.Sum(x => x.QuantityIn * x.UnitCost);
            var outgoingCost = period.Sum(x => x.QuantityOut * x.UnitCost);
            var closingQty = closing?.BalanceAfter ?? (openingQty + incomingQty - outgoingQty);
            var closingCost = closing?.InventoryValueAfter ?? (openingCost + incomingCost - outgoingCost);
            map[group.Key] = (openingQty, incomingQty, outgoingQty, closingQty, openingCost, incomingCost, outgoingCost, closingCost);
        }
        return map;
    }

    private bool IsZeroRow(ProductReportRow row) => _applied.ReportType switch
    {
        "movement-qty" => row.OpeningQty == 0 && row.InQty == 0 && row.OutQty == 0 && row.ClosingQty == 0,
        "movement-cost" => row.OpeningCost == 0 && row.InCost == 0 && row.OutCost == 0 && row.ClosingCost == 0,
        "prices" => false,
        _ => row.OnHand == 0 && row.Reserved == 0 && row.Available == 0 && row.InventoryValue == 0
    };

    private bool MatchesStockState(ProductReportRow row)
    {
        return _applied.StockState switch
        {
            "available" => row.Available > 0,
            "out" => row.OnHand <= 0,
            "reserved" => row.Reserved > 0,
            "stagnant" => row.DaysIdle >= _applied.StagnantDays && row.OnHand > 0,
            _ => _applied.ReportType != "stagnant" || row.OnHand <= 0 || row.DaysIdle >= _applied.StagnantDays
        };
    }

    private bool MatchesSearch(ProductReportRow row)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var term = Normalize(_search.Trim());
        return Normalize($"{row.Item.VariantCode} {row.Item.VariantName} {row.Item.ProductCode} {row.Item.ProductName} {row.Item.CategoryName} {row.Item.BrandName} {row.Item.Variant.Barcode} {row.WarehouseName}")
            .Contains(term, StringComparison.CurrentCultureIgnoreCase);
    }

    private static string Normalize(string s) => new(s.Select(c => c is >= '\u0660' and <= '\u0669' ? (char)('0' + c - '\u0660') : c is >= '\u06F0' and <= '\u06F9' ? (char)('0' + c - '\u06F0') : c).ToArray());

    private void OnSearch(string value)
    {
        _search = value;
        BuildRows();
    }

    private void SortBy(string key)
    {
        _descending = _sortKey == key && !_descending;
        _sortKey = key;
        Sort();
        _page = 1;
    }

    private void Sort()
    {
        Func<ProductReportRow, object?> selector = row => Cell(row, _sortKey);
        _rows = (_descending ? _rows.OrderByDescending(selector) : _rows.OrderBy(selector))
            .ThenBy(x => x.Item.VariantCode)
            .ToArray();
    }

    private object? Cell(ProductReportRow row, string key)
    {
        var totalValue = _rows.Sum(x => x.InventoryValue);
        return key switch
        {
            "code" => row.Item.VariantCode,
            "name" => row.Item.VariantName,
            "product" => row.Item.ProductName,
            "category" => row.Item.CategoryName,
            "brand" => row.Item.BrandName,
            "barcode" => row.Item.Variant.Barcode,
            "unit" => row.Item.UnitName,
            "warehouse" => row.WarehouseName,
            "onHand" => row.OnHand,
            "reserved" => row.Reserved,
            "available" => row.Available,
            "onOrder" => row.OnOrder,
            "avgCost" => row.AverageCost,
            "value" => row.InventoryValue,
            "last" => row.LastMovementAt?.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            "opening" => _applied.ReportType == "movement-cost" ? row.OpeningCost : row.OpeningQty,
            "incoming" => _applied.ReportType == "movement-cost" ? row.InCost : row.InQty,
            "outgoing" => _applied.ReportType == "movement-cost" ? row.OutCost : row.OutQty,
            "closing" => _applied.ReportType == "movement-cost" ? row.ClosingCost : row.ClosingQty,
            "purchasePrice" => row.Item.Variant.PurchasePrice,
            "sellingPrice" => row.Item.Variant.SellingPrice,
            "active" => row.Item.IsActive ? "نشط" : "غير نشط",
            "share" => totalValue <= 0 ? 0m : row.InventoryValue / totalValue * 100m,
            "daysIdle" => row.DaysIdle == int.MaxValue ? null : row.DaysIdle,
            "stockStatus" => row.OnHand <= 0 ? "نافد" : row.DaysIdle >= _applied.StagnantDays ? "راكد" : row.Available > 0 ? "متوفر" : "محجوز",
            _ => null
        };
    }

    private object? Total(IReadOnlyCollection<ProductReportRow> rows, string key)
    {
        if (rows.Count == 0) return null;
        return key switch
        {
            "onHand" => rows.Sum(x => x.OnHand),
            "reserved" => rows.Sum(x => x.Reserved),
            "available" => rows.Sum(x => x.Available),
            "onOrder" => rows.Sum(x => x.OnOrder),
            "avgCost" => rows.Sum(x => x.OnHand) > 0 ? rows.Sum(x => x.InventoryValue) / rows.Sum(x => x.OnHand) : null,
            "value" => rows.Sum(x => x.InventoryValue),
            "opening" => _applied.ReportType == "movement-cost" ? rows.Sum(x => x.OpeningCost) : rows.Sum(x => x.OpeningQty),
            "incoming" => _applied.ReportType == "movement-cost" ? rows.Sum(x => x.InCost) : rows.Sum(x => x.InQty),
            "outgoing" => _applied.ReportType == "movement-cost" ? rows.Sum(x => x.OutCost) : rows.Sum(x => x.OutQty),
            "closing" => _applied.ReportType == "movement-cost" ? rows.Sum(x => x.ClosingCost) : rows.Sum(x => x.ClosingQty),
            "purchasePrice" => rows.Average(x => x.Item.Variant.PurchasePrice),
            "sellingPrice" => rows.Average(x => x.Item.Variant.SellingPrice),
            "share" => 100m,
            _ => null
        };
    }

    private void GoPage(int p) => _page = Math.Clamp(p, 1, TotalPages);
    private void ChangePageSize(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var n) && n is 10 or 25 or 50 or 100) _pageSize = n; _page = 1; }

    private string FormatValue(object? value, string? key = null)
    {
        return value switch
        {
            null => "—",
            decimal d when key == "share" => d.ToString("N2", CultureInfo.InvariantCulture) + "%",
            decimal d when _applied.ReportType == "movement-cost" => (d / _rate).ToString("N2", CultureInfo.InvariantCulture),
            decimal d when _applied.ReportType == "movement-qty" => d.ToString("#,##0.###", CultureInfo.InvariantCulture),
            decimal d when key is "purchasePrice" or "sellingPrice" or "avgCost" or "value" => (d / _rate).ToString("N2", CultureInfo.InvariantCulture),
            decimal d when key is "onHand" or "reserved" or "available" or "onOrder" or "opening" or "incoming" or "outgoing" or "closing" => d.ToString("#,##0.###", CultureInfo.InvariantCulture),
            decimal d when AppliedUsesCurrency => (d / _rate).ToString("N2", CultureInfo.InvariantCulture),
            decimal d => d.ToString("#,##0.###", CultureInfo.InvariantCulture),
            int n => n.ToString("N0", CultureInfo.InvariantCulture),
            _ => value.ToString() ?? ""
        };
    }

    private string Metric(string key) => _busy || _error is not null ? "—" : FormatValue(Total(_rows, key), key);
    private string CountText(int n) => _busy || _error is not null ? "—" : n.ToString("N0", CultureInfo.InvariantCulture);
    private string Subtitle => $"{ReportTypeName(_applied.ReportType)} | {(AppliedNeedsDateRange ? $"{_applied.From:dd/MM/yyyy} – {_applied.To:dd/MM/yyyy}" : $"حتى {_applied.To:dd/MM/yyyy}")} | {string.Join(" | ", Chips.Select(c => $"{c.Label}: {c.Value}"))}";
    private string[] ExportHeaders => CurrentColumns.Select(c => c.Label).ToArray();
    private IEnumerable<object?[]> ExportRows() => _rows.Select(r => CurrentColumns.Select(c => Cell(r, c.Key)).ToArray());
    private object? NormalizeExportValue(object? value, string key) => value is decimal d && ShouldConvertCurrency(key) ? d / _rate : value;
    private bool ShouldConvertCurrency(string key) => _applied.ReportType == "movement-cost" || key is "purchasePrice" or "sellingPrice" or "avgCost" or "value";

    private async Task ExportAsync()
    {
        if (!CanExport) return;
        var bytes = CustomerDebtsWorkbook.Create(Subtitle, ExportHeaders, _rows.Select(r => CurrentColumns.Select(c => NormalizeExportValue(Cell(r, c.Key), c.Key)).ToArray()), sheetName: "المنتجات");
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/customer-debts-export.js");
        await module.InvokeVoidAsync("saveWorkbook", Convert.ToBase64String(bytes), "products-report.xlsx");
    }

    private async Task PrintAsync()
    {
        if (!CanExport) return;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/products-report-print.js");
        await module.InvokeVoidAsync("printReport", "المنتجات", Subtitle, Chips.Select(c => $"{c.Label}: {c.Value}").ToArray(), ExportHeaders, ExportRows().Select(r => r.Select((x, i) => FormatValue(x, CurrentColumns[i].Key)).ToArray()).ToArray(), CurrentColumns.Skip(IdentityCount).Select(c => FormatValue(Total(_rows, c.Key), c.Key)).ToArray(), IdentityCount);
    }

    private static string ReportTypeName(string key) => key switch
    {
        "movement-qty" => "حركة المنتجات - كميات",
        "movement-cost" => "حركة المنتجات - تكاليف",
        "prices" => "قائمة المنتجات والأسعار",
        "valuation" => "تقييم المخزون",
        "stagnant" => "المنتجات الراكدة والنوافد",
        _ => "أرصدة المنتجات"
    };
    private static string StockStateName(string key) => key switch
    {
        "available" => "متوفر",
        "out" => "نافد",
        "reserved" => "محجوز",
        "stagnant" => "راكد",
        _ => "الكل"
    };
    private static string Name<T>(IEnumerable<T> items, string id, string fallback) where T : class
    {
        if (!Guid.TryParse(id, out var parsed)) return fallback;
        var propId = typeof(T).GetProperty("Id");
        var propName = typeof(T).GetProperty("Name") ?? typeof(T).GetProperty("NameAr");
        var item = items.FirstOrDefault(x => propId?.GetValue(x) is Guid g && g == parsed);
        return propName?.GetValue(item)?.ToString() ?? fallback;
    }
}
