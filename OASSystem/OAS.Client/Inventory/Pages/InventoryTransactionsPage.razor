@page "/inventory/transactions"
@page "/inventory/transactions/{Screen}"
@page "/inventory/transactions/{Screen}/{RecordId:guid}"
@attribute [Authorize]
@using OAS.Client.Inventory.Common
@using OAS.Client.Inventory.Components
@using OAS.Client.Inventory.Services
@using OAS.Client.Services.Browser
@using OAS.Contracts.Enums.Inventory
@using OAS.Contracts.Inventory.Products
@using OAS.UiLib.Core.Formatting
@using OAS.Contracts.Inventory.Transactions
@using OAS.Contracts.Inventory.Warehouses
@using System.Globalization

@using OAS.UiLib.Components.Spreadsheets
<PageTitle>عمليات المخزون | OAS</PageTitle>
@using OAS.UiLib.Components.Inventory

<section class="oas-inventory-workspace oas-inventory-catalog txn-workspace" dir="rtl" aria-busy="@(Busy ? "true" : "false")">
    <div class="inv-toolbar">
        <div class="inv-actions">
            <UiButton Text="إضافة جديد" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small" Disabled="@(Busy || Creating)" OnClick="BeginCreateAsync" />
            <UiButton Text="حفظ" AdditionalCssClass="inv-save" IconCssClass="fa-solid fa-floppy-disk" Size="ControlSize.Small" Disabled="@(!Creating || Busy)" Loading="@_saving" OnClick="SaveAsync" />
            @if (Creating)
            {
                <UiButton Text="إلغاء" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@Busy" OnClick="CancelCreateAsync" />
            }
            <UiButton Text="ترحيل" IconCssClass="fa-solid fa-check-double" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(!CanPost || Busy)" Loading="@_posting" OnClick="PostAsync" />
            <UiButton Text="تحديث" AdditionalCssClass="inv-refresh" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(Busy || Creating)" Loading="@_loading" OnClick="RefreshAsync" />
            <UiButton Text="استلام مشتريات" AdditionalCssClass="inv-receipt" IconCssClass="fa-solid fa-truck-ramp-box" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(Busy || Creating)" OnClick="OpenPurchaseReceiptsAsync" />
            <details class="inv-excel">
                <summary>ملفات Excel <i class="fa-solid fa-angle-down" aria-hidden="true"></i></summary>
                <div class="inv-excel-menu">
                    <UiSpreadsheetActions CanImport="false" Busy="@(Busy || Creating)" OnExport="ExportAsync" />
                </div>
            </details>
        </div>
        <div class="inv-toolbar-navigation">
            <UiSearchInput Value="@_search" ValueChanged="@(v => _search = v)" Placeholder="ابحث برقم العملية أو المرجع..." AriaLabel="البحث في عمليات المخزون" ClearText="مسح البحث" Disabled="@(Busy || Creating)" DebounceMilliseconds="250" OnSearch="SearchChangedAsync" />
            <UiInventoryRecordNavigation CanPrevious="@CanPrevious" CanNext="@CanNext" OnNavigate="NavigateRecordAsync" />
        </div>
    </div>

    @if (_loading && _selectedTransaction is null)
    {
        <UiAlert Message="جاري تحميل عمليات المخزون..." />
    }
    @if (Creating && !_warehouses.Any(x => x.IsActive))
    {
        <UiAlert Tone="AlertTone.Danger" Message="لا يوجد مخزن نشط يمكن استخدامه في عملية مخزون جديدة." />
    }
    @if (Creating && !_variants.Any(IsUsableVariant))
    {
        <UiAlert Tone="AlertTone.Danger" Message="لا توجد أصناف نشطة ومخزنية." />
    }
    @if (_selectedTransaction is { Status: InventoryTransactionStatus.Draft } oldDraft &&
         oldDraft.TransactionType is (InventoryTransactionType.Receipt or InventoryTransactionType.Opening or InventoryTransactionType.AdjustmentIncrease or InventoryTransactionType.SalesReturn))
    {
        <UiAlert Tone="AlertTone.Warning" Message="هذه مسودة وارد يدوي قديمة ولا يمكن ترحيلها. أنشئ سند استلام مشتريات بدلاً منها." />
    }
    <details class="inv-editor inv-editor-panel txn-panel" @key="DataPanelKey" open>
        <summary><span><i class="fa-solid fa-file-lines" aria-hidden="true"></i> بيانات العملية</span><i class="fa-solid fa-angle-down inv-editor-chevron" aria-hidden="true"></i></summary>
        <div class="inv-editor-content inv-form-grid txn-fields">
            @if (Creating)
            {
                <div class="txn-read-field"><span>رقم العملية</span><div>يُولد عند الحفظ</div></div>
                <div class="txn-read-field"><span>الحالة</span><div>مسودة</div></div>
                            <div class="inventory-transactions__field">
                                <UiSearchableSelect InlineDropdown="true" UseAngleDownIcon="true" Label="نوع العملية"
                                          Value="@_transactionType"
                                          ValueExpression="@(() => _transactionType)"
                                          ValueChanged="OnTransactionTypeChanged"
                                          Options="@InventoryArabicPresenter.TransactionTypeOptions"
                                          ErrorText="@_transactionTypeError"
                                          Disabled="@Busy" Required="true"
                                          Size="ControlSize.Small" />
                            </div>
                            <div class="inventory-transactions__field">
                                <UiInputDate Label="تاريخ العملية"
                                             Value="@_transactionDate"
                                             ValueExpression="@(() => _transactionDate)"
                                             ValueChanged="OnTransactionDateChanged"
                                             ErrorText="@_transactionDateError"
                                             Disabled="@Busy" Required="true"
                                             Size="ControlSize.Small" />
                            </div>

                            @if (RequiresSourceWarehouse)
                            {
                                <div class="inventory-transactions__field">
                                    <UiSearchableSelect InlineDropdown="true" UseAngleDownIcon="true" Label="من مخزن"
                                              Value="@_sourceWarehouseId"
                                              ValueExpression="@(() => _sourceWarehouseId)"
                                              ValueChanged="OnSourceWarehouseChanged"
                                              Options="@WarehouseOptions"
                                              ErrorText="@_sourceWarehouseError"
                                              Disabled="@Busy" Required="true"
                                              Size="ControlSize.Small" />
                                </div>
                            }

                            @if (RequiresDestinationWarehouse)
                            {
                                <div class="inventory-transactions__field">
                                    <UiSearchableSelect InlineDropdown="true" UseAngleDownIcon="true" Label="إلى مخزن"
                                              Value="@_destinationWarehouseId"
                                              ValueExpression="@(() => _destinationWarehouseId)"
                                              ValueChanged="OnDestinationWarehouseChanged"
                                              Options="@WarehouseOptions"
                                              ErrorText="@_destinationWarehouseError"
                                              Disabled="@Busy" Required="true"
                                              Size="ControlSize.Small" />
                                </div>
                            }

                            <div class="inventory-transactions__field inventory-transactions__field--reason">
                                @if (IsAdjustment)
                                {
                                    <InventorySuggestedInput Label="سبب تعديل الرصيد" Value="@_reason" ValueChanged="OnReasonChanged"
                                                             Suggestions="@AdjustmentReasons" ErrorText="@_reasonError"
                                                             Disabled="@Busy" Required="true" MaxLength="500" />
                                }
                                else
                                {
                                    <InventorySuggestedInput Label="سبب العملية (اختياري)" Value="@_reason" ValueChanged="OnReasonChanged"
                                                             Disabled="@Busy" Suggestions="@CommonReasons" ErrorText="@_reasonError" MaxLength="500" />
                                }
                            </div>
                            <div class="txn-notes">
                                    <UiInputText Label="ملاحظات" Value="@_notes" ValueExpression="@(() => _notes)"
                                                 ValueChanged="OnNotesChanged" ErrorText="@_notesError"
                                                 Disabled="@Busy" MaxLength="1000" Size="ControlSize.Small" />
                            </div>

            }
            else if (_selectedTransaction is { } transaction)
            {
                <div class="txn-read-field"><span>رقم العملية</span><div>@transaction.TransactionNumber</div></div>
                <div class="txn-read-field"><span>نوع العملية</span><div>@InventoryArabicPresenter.TransactionTypeText(transaction.TransactionType)</div></div>
                <div class="txn-read-field"><span>تاريخ العملية</span><div>@InventoryDisplayFormat.Date(transaction.TransactionDate.ToLocalTime())</div></div>
                <div class="txn-read-field"><span>من مخزن</span><div>@WarehouseName(transaction.SourceWarehouseId)</div></div>
                <div class="txn-read-field"><span>إلى مخزن</span><div>@WarehouseName(transaction.DestinationWarehouseId)</div></div>
                <div class="txn-read-field"><span>الحالة</span><div>@InventoryArabicPresenter.TransactionStatusText(transaction.Status)</div></div>
                <div class="txn-read-field"><span>نوع المرجع</span><div>@(transaction.ReferenceType ?? "—")</div></div>
                <div class="txn-read-field"><span>سبب العملية</span><div>@(transaction.Reason ?? "—")</div></div>
                <div class="txn-read-field txn-notes"><span>ملاحظات</span><div>@(transaction.Notes ?? "—")</div></div>
            }
            else
            {
                <span>لا توجد عملية محددة.</span>
            }
        </div>
    </details>
    @if (Creating || _selectedTransaction is not null)
    {
    <details class="inv-editor inv-editor-panel txn-panel txn-line-details" @key="LinePanelKey" open="@Creating">
        <summary><span><i class="fa-solid fa-box" aria-hidden="true"></i> بنود العملية (@LineCount)</span><i class="fa-solid fa-angle-down inv-editor-chevron" aria-hidden="true"></i></summary>
        @if (Creating)
        {
            <div class="txn-section-head">
                <div class="inv-actions">
                    <UiButton Text="إضافة بند" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small" Disabled="@Busy" OnClick="@(_ => AddLine())" />
                    <UiButton Text="حذف بند" IconCssClass="fa-solid fa-trash" AdditionalCssClass="txn-delete" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(Busy || _selectedDraftLine is null || _draftLines.Count <= 1)" OnClick="RemoveSelectedLine" />
                </div>
            </div>
        }
        <div class="txn-lines-scroll">
            @if (Creating)
            {
                <table class="ui-data-table txn-lines-table">
                    <thead><tr><th scope="col">#</th><th scope="col">الصنف</th><th scope="col">الوحدة</th><th scope="col">الكمية</th><th scope="col">تكلفة الوحدة</th><th scope="col">الإجمالي</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < _draftLines.Count; i++)
                        {
                            var line = _draftLines[i];
                            <tr @key="line" class="@(ReferenceEquals(_selectedDraftLine, line) ? "ui-data-table__row--selected" : null)" @onclick="() => _selectedDraftLine = line">
                                <td><button type="button" class="txn-line-select" aria-label="اختيار البند @(i + 1)" @onclick="() => _selectedDraftLine = line">@(i + 1)</button></td>
                                    <td class="txn-product">
                                        <UiSearchableSelect InlineDropdown="true" UseAngleDownIcon="true" Label="الصنف"
                                                  Value="@line.ProductVariantId"
                                                  ValueExpression="@(() => line.ProductVariantId)"
                                                  ValueChanged="@(v => OnLineVariantChanged(line, v))"
                                                  Options="@VariantOptions"
                                                  ErrorText="@line.ProductVariantError"
                                                  Disabled="@Busy" Required="true"
                                                  Size="ControlSize.Small" />
                                    </td>
                                    <td>@UnitName(ParseGuid(line.ProductVariantId))</td>
                                    <td class="txn-quantity">
                                        <UiInputText Label="الكمية"
                                                     Value="@line.Quantity"
                                                     ValueExpression="@(() => line.Quantity)"
                                                     ValueChanged="@(v => OnLineQuantityChanged(line, v))"
                                                     ErrorText="@line.QuantityError"
                                                     Type="number"
                                                     InputMode="@(UsesWholeQuantity(line) ? "numeric" : "decimal")"
                                                     step="@(UsesWholeQuantity(line) ? "1" : "0.001")" min="@(UsesWholeQuantity(line) ? "1" : "0.001")"
                                                     Disabled="@Busy" Required="true"
                                                     Size="ControlSize.Small" />
                                    </td>
                                    <td class="txn-cost">
                                        <UiInputText Label="تكلفة الوحدة"
                                                     Value="@line.UnitCost"
                                                     ValueExpression="@(() => line.UnitCost)"
                                                     ValueChanged="@(v => OnLineUnitCostChanged(line, v))"
                                                     ErrorText="@line.UnitCostError"
                                                     Type="number"
                                                     InputMode="decimal"
                                                     step="0.01" min="0"
                                                     Disabled="@Busy" Required="true"
                                                     Size="ControlSize.Small" />
                                    </td>

                                <td>@InventoryDisplayFormat.Number(DraftLineTotal(line))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <UiDataTable TItem="InventoryTransactionLineDto" Items="@VisibleLines" Headers="@LineHeaders" Compact="true" UniformCellTypography="true" EmptyText="لا توجد بنود."
                             OnRowClick="@(x => { _selectedLineId = x.Id; })" IsRowSelected="@(x => x.Id == _selectedLineId)">
                    <RowTemplate Context="line">
                        <td>@VariantSku(line.ProductVariantId)</td>
                        <td>@VariantLabel(line.ProductVariantId)</td>
                        <td>@UnitName(line.ProductVariantId)</td>
                        <td>@InventoryDisplayFormat.Number(line.Quantity)</td>
                        <td>@InventoryDisplayFormat.Number(line.UnitCost)</td>
                        <td>@InventoryDisplayFormat.Number(line.TotalCost)</td>
                    </RowTemplate>
                </UiDataTable>
            }
        </div>
        <div class="txn-totals">
            <div><span>عدد البنود</span><strong>@LineCount</strong></div>
            <div><span>إجمالي الكمية</span><strong>@InventoryDisplayFormat.Number(TotalQuantity)</strong></div>
            <div><span>إجمالي القيمة</span><strong>@InventoryDisplayFormat.Number(TotalValue)</strong></div>
        </div>
        @if (!Creating)
        {
            <div class="txn-line-footer"><UiInventoryPagination Page="@LinePage" PageSize="@LinePageSize" TotalCount="@_selectedLines.Count" Disabled="@Busy" OnPageChanged="@(p => _linePage = p)" /></div>
        }
    </details>
    }
    <details class="inv-editor inv-editor-panel txn-panel txn-filters">
        <summary><span><i class="fa-solid fa-filter" aria-hidden="true"></i> فلاتر العمليات</span><i class="fa-solid fa-angle-down inv-editor-chevron" aria-hidden="true"></i></summary>
        <div class="inv-editor-content">
            <div class="inv-form-grid txn-filter-grid">
                <UiSearchableSelect InlineDropdown="true" UseAngleDownIcon="true" Label="نوع العملية" Value="@_typeFilter" ValueExpression="@(() => _typeFilter)" ValueChanged="OnTypeFilterChanged" Options="@TransactionTypeFilterOptions" Disabled="@(Busy || Creating)" Size="ControlSize.Small" />
                <UiSearchableSelect InlineDropdown="true" UseAngleDownIcon="true" Label="الحالة" Value="@_statusFilter" ValueExpression="@(() => _statusFilter)" ValueChanged="OnStatusFilterChanged" Options="@InventoryArabicPresenter.TransactionStatusOptions" Disabled="@(Busy || Creating)" Size="ControlSize.Small" />
                <UiSearchableSelect InlineDropdown="true" UseAngleDownIcon="true" Label="المخزن" Value="@_warehouseFilter" ValueExpression="@(() => _warehouseFilter)" ValueChanged="OnWarehouseFilterChanged" Options="@WarehouseFilterOptions" Disabled="@(Busy || Creating)" Size="ControlSize.Small" />
            </div>
        </div>
    </details>
    <div class="txn-list-title"><strong>عمليات المخزون</strong><span>@FilteredTransactions.Count عملية</span></div>
    <div class="inv-table-slot txn-history" aria-busy="@(Busy ? "true" : "false")">
        <UiDataTable TItem="InventoryTransactionDto" Items="@VisibleTransactions" Headers="@TransactionHeaders" Compact="true" UniformCellTypography="true" EmptyText="لا توجد عمليات مطابقة."
                     OnRowClick="@(x => SelectFromHistoryAsync(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
            <RowTemplate Context="transaction">
                <td>@transaction.TransactionNumber</td>
                <td>@InventoryArabicPresenter.TransactionTypeText(transaction.TransactionType)</td>
                <td>@InventoryDisplayFormat.Date(transaction.TransactionDate.ToLocalTime())</td>
                <td>@WarehouseName(transaction.SourceWarehouseId)</td>
                <td>@WarehouseName(transaction.DestinationWarehouseId)</td>
                <td>@InventoryArabicPresenter.TransactionStatusText(transaction.Status)</td>
                <td class="txn-reason" title="@transaction.Reason">@(string.IsNullOrWhiteSpace(transaction.Reason) ? "—" : transaction.Reason)</td>
            </RowTemplate>
        </UiDataTable>
    </div>
    <div class="inv-footer"><UiInventoryPagination Page="@HistoryPage" PageSize="@HistoryPageSize" TotalCount="@FilteredTransactions.Count" Disabled="@(Busy || Creating)" OnPageChanged="ChangeHistoryPageAsync" /></div>
</section>

@code {
    [Inject] private NavigationManager InventoryNavigation { get; set; } = default!;
    [Parameter] public string? Screen { get; set; }
    [Parameter] public Guid? RecordId { get; set; }
    private string? _appliedInventoryRoute;
    private bool Creating => _mode == ViewMode.Create;
    private bool Busy => _loading || _saving || _posting || _exporting || _selecting;
    private bool _selecting;
    private int _linePage = 1, _historyPage = 1;
    private int _validationPanelRevision;
    private object DataPanelKey => ("data", Creating, _validationPanelRevision);
    private object LinePanelKey => ("lines", Creating, _selectedId, _validationPanelRevision);
    private const int LinePageSize = 12, HistoryPageSize = 12;
    private int LinePage => Math.Clamp(_linePage, 1, Math.Max(1, (_selectedLines.Count + LinePageSize - 1) / LinePageSize));
    private int HistoryPage => Math.Clamp(_historyPage, 1, Math.Max(1, (FilteredTransactions.Count + HistoryPageSize - 1) / HistoryPageSize));
    private IReadOnlyList<InventoryTransactionLineDto> VisibleLines => _selectedLines.Skip((LinePage - 1) * LinePageSize).Take(LinePageSize).ToArray();
    private IReadOnlyList<InventoryTransactionDto> VisibleTransactions => FilteredTransactions.Skip((HistoryPage - 1) * HistoryPageSize).Take(HistoryPageSize).ToArray();
    private static readonly IReadOnlyList<string> LineHeaders = ["رمز الصنف", "الصنف", "الوحدة", "الكمية", "تكلفة الوحدة", "الإجمالي"];
    private Guid? _selectedLineId;
    private TransactionLineForm? _selectedDraftLine;
    private int LineCount => Creating ? _draftLines.Count : _selectedLines.Count;
    private decimal TotalQuantity => Creating ? _draftLines.Sum(x => SafeNumber(x.Quantity, 18, 3)) : _selectedLines.Sum(x => x.Quantity);
    private decimal TotalValue => Creating ? _draftLines.Sum(DraftLineTotal) : _selectedLines.Sum(x => x.TotalCost);
    private static decimal SafeNumber(string? text, int precision, int scale) => TryParseDecimal(text, out var value) && value >= 0 && FitsPrecision(value, precision, scale) ? value : 0m;
    private static decimal DraftLineTotal(TransactionLineForm line)
    {
        var quantity = SafeNumber(line.Quantity, 18, 3);
        var cost = SafeNumber(line.UnitCost, 18, 2);
        return TotalCostFitsDatabase(quantity, cost) ? quantity * cost : 0m;
    }
    private string UnitName(Guid? variantId)
    {
        var unitId = _variants.FirstOrDefault(x => x.Id == variantId)?.UnitId;
        return _units.FirstOrDefault(x => x.Id == unitId)?.Name ?? "—";
    }
    private int RecordIndex => Array.FindIndex(FilteredTransactions.ToArray(), x => x.Id == _selectedId);
    private bool CanPrevious => !Busy && !Creating && RecordIndex > 0;
    private bool CanNext => !Busy && !Creating && RecordIndex < FilteredTransactions.Count - 1;
    private async Task NavigateRecordAsync(int direction)
    {
        if (Busy || Creating) return;
        var rows = FilteredTransactions;
        if (rows.Count == 0) return;
        var index = Array.FindIndex(rows.ToArray(), x => x.Id == _selectedId);
        var next = direction switch { -2 => 0, 2 => rows.Count - 1, _ => Math.Clamp(index + direction, 0, rows.Count - 1) };
        await SelectAsync(rows[next].Id);
    }
    private async Task ChangeHistoryPageAsync(int page)
    {
        if (Busy || Creating) return;
        var rows = FilteredTransactions;
        var next = rows.Skip((page - 1) * HistoryPageSize).FirstOrDefault();
        if (next is not null) await SelectAsync(next.Id);
    }
    private Task SelectFromHistoryAsync(Guid id) => Busy || Creating ? Task.CompletedTask : SelectAsync(id);
    private async Task ApplyFiltersAsync()
    {
        _historyPage = 1;
        if (Creating) return;
        var rows = FilteredTransactions;
        var index = Array.FindIndex(rows.ToArray(), x => x.Id == _selectedId);
        if (index >= 0)
        {
            _historyPage = index / HistoryPageSize + 1;
            return;
        }
        if (rows.Count > 0) await SelectAsync(rows[0].Id);
        else { _selectedId = null; _selectedTransaction = null; _selectedLines = []; _selectedLineId = null; _linePage = 1; _mode = ViewMode.Empty; }
    }
    private async Task OnTypeFilterChanged(string? value) { _typeFilter = value; await ApplyFiltersAsync(); }
    private async Task OnStatusFilterChanged(string? value) { _statusFilter = value; await ApplyFiltersAsync(); }
    private async Task OnWarehouseFilterChanged(string? value) { _warehouseFilter = value; await ApplyFiltersAsync(); }
    private Task OpenPurchaseReceiptsAsync(MouseEventArgs _) { InventoryNavigation.NavigateTo("/purchases/receipts"); return Task.CompletedTask; }
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Screen}/{RecordId}/{TransactionIdFromQuery}";
        if (_appliedInventoryRoute == key) return;
        _appliedInventoryRoute = key;
        if (Screen == "new") { await BeginCreateAsync(new MouseEventArgs()); return; }
        var id = RecordId ?? TransactionIdFromQuery;
        _mode = ViewMode.Empty;
        _draftLines.Clear();
        if (id.HasValue) await SelectAsync(id.Value);
        else await ApplyFiltersAsync();
    }

    private enum ViewMode { Empty, View, Create }
    private sealed class TransactionLineForm
    {
        public string? ProductVariantId { get; set; }
        public string Quantity { get; set; } = "1";
        public string UnitCost { get; set; } = "0";
        public string? ProductVariantError { get; set; }
        public string? QuantityError { get; set; }
        public string? UnitCostError { get; set; }
    }

    [Inject] private IInventoryClientService Inventory { get; set; } = default!;
    [Inject] private InventorySpreadsheetClient SpreadsheetClient { get; set; } = default!;
    [Inject] private BrowserFileDownloadService SpreadsheetDownload { get; set; } = default!;
    [Inject] private IApiFeedbackService ApiFeedback { get; set; } = default!;
    [Inject] private IUiSnackbarService Snackbar { get; set; } = default!;

    [Parameter, SupplyParameterFromQuery(Name = "transactionId")]
    public Guid? TransactionIdFromQuery { get; set; }

    private IReadOnlyList<InventoryTransactionDto> _transactions = [];
    private static readonly IReadOnlyList<string> TransactionHeaders = ["رقم العملية", "نوع العملية", "تاريخ العملية", "من مخزن", "إلى مخزن", "الحالة", "سبب العملية"];
    private IReadOnlyList<WarehouseDto> _warehouses = [];
    private IReadOnlyList<ProductDto> _products = [];
    private IReadOnlyList<ProductVariantDto> _variants = [];
    private IReadOnlyList<UnitDto> _units = [];
    private IReadOnlyList<InventoryTransactionLineDto> _selectedLines = [];
    private InventoryTransactionDto? _selectedTransaction;
    private Guid? _selectedId;
    private ViewMode _mode = ViewMode.Empty;
    private bool _loading = true;
    private bool _exporting;
    private bool _saving;
    private bool _posting;
    private string? _search;
    private string? _typeFilter;
    private string? _statusFilter;
    private string? _warehouseFilter;

    private string _transactionType = ((int)InventoryTransactionType.Issue).ToString();
    private DateOnly? _transactionDate = DateOnly.FromDateTime(DateTime.Today);
    private string? _sourceWarehouseId;
    private string? _destinationWarehouseId;
    private string? _reason;
    private string? _notes;
    private string? _transactionTypeError;
    private string? _transactionDateError;
    private string? _sourceWarehouseError;
    private string? _destinationWarehouseError;
    private string? _reasonError;
    private string? _notesError;
    private readonly List<TransactionLineForm> _draftLines = [];

    // Offer proven historic values alongside common reasons. The operator can always enter a new reason.
    private IReadOnlyList<string> CommonReasons => new[] { "صرف للمبيعات", "نقل بين المخازن", "مرتجع", "تصحيح رصيد" }
        .Concat(_transactions.Select(x => x.Reason).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!))
        .Distinct(StringComparer.CurrentCultureIgnoreCase).ToArray();
    private IReadOnlyList<string> AdjustmentReasons => new[] { "فرق جرد", "تالف", "خطأ في تسجيل الكمية", "فاقد", "تسوية مخزون" }
        .Concat(CommonReasons).Distinct(StringComparer.CurrentCultureIgnoreCase).ToArray();
    private string? DefaultWarehouseId => _warehouses.FirstOrDefault(x => x.IsActive && x.IsDefault)?.Id.ToString("D")
        ?? (_warehouses.Count(x => x.IsActive) == 1 ? _warehouses.First(x => x.IsActive).Id.ToString("D") : null);

    private IReadOnlyList<UiSelectOption> TransactionTypeFilterOptions =>
        [new UiSelectOption(string.Empty, "كل الأنواع"), .. InventoryArabicPresenter.TransactionTypeHistoryOptions];

    private IReadOnlyList<UiSelectOption> WarehouseFilterOptions =>
        [new UiSelectOption(string.Empty, "كل المخازن"), .. _warehouses.Select(x => new UiSelectOption(x.Id.ToString("D"), x.Name))];

    private IReadOnlyList<UiSelectOption> WarehouseOptions =>
        [new UiSelectOption(string.Empty, "اختر المخزن"), .. _warehouses.Where(x => x.IsActive).Select(x => new UiSelectOption(x.Id.ToString("D"), $"{x.Code} - {x.Name}"))];

    private IReadOnlyList<UiSelectOption> VariantOptions => _variants.Where(IsUsableVariant)
        .Select(x => new UiSelectOption(x.Id.ToString("D"), $"{ProductName(x.ProductId)} - {x.SKU}{(string.IsNullOrWhiteSpace(x.VariantName) ? string.Empty : $" - {x.VariantName}")}"))
        .ToArray();

    private InventoryTransactionType CurrentType => Enum.TryParse<InventoryTransactionType>(_transactionType, out var parsedByName)
        ? parsedByName
        : int.TryParse(_transactionType, out var raw) ? (InventoryTransactionType)raw : InventoryTransactionType.Issue;

    private bool RequiresSourceWarehouse => CurrentType is InventoryTransactionType.Issue
        or InventoryTransactionType.Transfer
        or InventoryTransactionType.AdjustmentDecrease
        or InventoryTransactionType.PurchaseReturn
        or InventoryTransactionType.Scrap;

    private bool RequiresDestinationWarehouse => CurrentType is InventoryTransactionType.Opening
        or InventoryTransactionType.Receipt
        or InventoryTransactionType.Transfer
        or InventoryTransactionType.AdjustmentIncrease
        or InventoryTransactionType.SalesReturn;

    private bool IsAdjustment => CurrentType is InventoryTransactionType.AdjustmentIncrease or InventoryTransactionType.AdjustmentDecrease;
    private bool CanPost => _mode == ViewMode.View && _selectedTransaction is { Status: InventoryTransactionStatus.Draft } transaction &&
        transaction.TransactionType is not (InventoryTransactionType.Opening or InventoryTransactionType.Receipt or
            InventoryTransactionType.AdjustmentIncrease or InventoryTransactionType.SalesReturn) && !_posting;

    private IReadOnlyList<InventoryTransactionDto> FilteredTransactions => _transactions.Where(x =>
    {
        if (int.TryParse(_typeFilter, out var type) && (int)x.TransactionType != type) return false;
        if (int.TryParse(_statusFilter, out var status) && (int)x.Status != status) return false;
        if (Guid.TryParse(_warehouseFilter, out var warehouseId) && x.SourceWarehouseId != warehouseId && x.DestinationWarehouseId != warehouseId) return false;
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return Match(_search, x.TransactionNumber, x.ReferenceType, x.ReferenceId?.ToString(), x.Reason, x.Notes, WarehouseName(x.SourceWarehouseId), WarehouseName(x.DestinationWarehouseId));
    }).OrderByDescending(x => x.TransactionDate).ToArray();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var transactionsTask = LoadAllPagesAsync(page => Inventory.GetInventoryTransactionsAsync(page));
            var warehousesTask = LoadAllPagesAsync(page => Inventory.GetWarehousesAsync(page));
            var productsTask = LoadAllPagesAsync(page => Inventory.GetProductsAsync(page));
            var variantsTask = LoadAllPagesAsync(page => Inventory.GetProductVariantsAsync(page));
            await Task.WhenAll(transactionsTask, warehousesTask, productsTask, variantsTask);

            _transactions = transactionsTask.Result;
            _warehouses = warehousesTask.Result;
            _products = productsTask.Result;
            _variants = variantsTask.Result;
            // Units are optional lookup metadata; failure must not block inventory operations.
            try { _units = await LoadAllPagesAsync(page => Inventory.GetUnitsAsync(page)); }
            catch (ApiClientException) { _units = []; }


        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(ex.Error);
        }
        catch (Exception)
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _loading = false;
        }
    }

    private static async Task<IReadOnlyList<T>> LoadAllPagesAsync<T>(Func<PageRequest, Task<PagedResult<T>>> loader)
    {
        var items = new List<T>();
        var pageNumber = 1;

        while (true)
        {
            var result = await loader(new PageRequest
            {
                PageNumber = pageNumber,
                PageSize = PageRequest.MaximumPageSize
            });

            items.AddRange(result.Items);
            if (!result.HasNextPage)
                break;

            pageNumber++;
        }

        return items;
    }

    private async Task RefreshAsync(MouseEventArgs args)
    {
        if (Busy || Creating) return;
        await LoadAsync();
        if (_selectedId is { } id && FilteredTransactions.Any(x => x.Id == id)) await SelectAsync(id);
        else await ApplyFiltersAsync();
    }
    private Task SearchChangedAsync(string? _) => Busy || Creating ? Task.CompletedTask : ApplyFiltersAsync();

    private Task BeginCreateAsync(MouseEventArgs args)
    {
        _mode = ViewMode.Create;
        _selectedId = null;
        _selectedTransaction = null;
        _selectedLines = [];
        _selectedLineId = null;
        _linePage = 1;
        _transactionType = ((int)InventoryTransactionType.Issue).ToString();
        _transactionDate = DateOnly.FromDateTime(DateTime.Today);
        _sourceWarehouseId = DefaultWarehouseId;
        _destinationWarehouseId = null;
        _reason = null;
        _notes = null;
        ClearValidationErrors();
        _draftLines.Clear();
        AddLine();
        return Task.CompletedTask;
    }

    private async Task CancelCreateAsync(MouseEventArgs args)
    {
        if (Busy) return;
        _mode = ViewMode.Empty;
        _draftLines.Clear();
        _selectedDraftLine = null;
        ClearValidationErrors();
        if (Screen == "new") InventoryNavigation.NavigateTo("/inventory/transactions", replace: true);
        else await ApplyFiltersAsync();
    }

    private void OnTransactionTypeChanged(string? value)
    {
        _transactionType = value ?? string.Empty;
        _transactionTypeError = null;

        if (!RequiresSourceWarehouse)
        {
            _sourceWarehouseId = null;
            _sourceWarehouseError = null;
        }

        if (!RequiresDestinationWarehouse)
        {
            _destinationWarehouseId = null;
            _destinationWarehouseError = null;
        }

        if (RequiresSourceWarehouse && string.IsNullOrWhiteSpace(_sourceWarehouseId))
            _sourceWarehouseId = DefaultWarehouseId;
        if (RequiresDestinationWarehouse && string.IsNullOrWhiteSpace(_destinationWarehouseId))
        {
            _destinationWarehouseId = _warehouses.Where(x => x.IsActive)
                .FirstOrDefault(x => x.Id.ToString("D") != _sourceWarehouseId && x.IsDefault)?.Id.ToString("D")
                ?? _warehouses.FirstOrDefault(x => x.IsActive && x.Id.ToString("D") != _sourceWarehouseId)?.Id.ToString("D");
        }
        if (CurrentType == InventoryTransactionType.Transfer && _sourceWarehouseId == _destinationWarehouseId)
            _destinationWarehouseId = _warehouses.FirstOrDefault(x => x.IsActive && x.Id.ToString("D") != _sourceWarehouseId)?.Id.ToString("D");
        if (!IsAdjustment)
            _reasonError = null;
    }

    private void OnTransactionDateChanged(DateOnly? value)
    {
        _transactionDate = value;
        _transactionDateError = null;
    }

    private void OnSourceWarehouseChanged(string? value)
    {
        _sourceWarehouseId = value;
        _sourceWarehouseError = null;
        if (_sourceWarehouseId != _destinationWarehouseId)
            _destinationWarehouseError = null;
    }

    private void OnDestinationWarehouseChanged(string? value)
    {
        _destinationWarehouseId = value;
        _destinationWarehouseError = null;
        if (_sourceWarehouseId != _destinationWarehouseId)
            _sourceWarehouseError = null;
    }

    private void OnReasonChanged(string? value)
    {
        _reason = value;
        _reasonError = null;
    }

    private void OnNotesChanged(string? value)
    {
        _notes = value;
        _notesError = null;
    }

    private void AddLine()
    {
        var line = new TransactionLineForm();
        _draftLines.Add(line);
        _selectedDraftLine = line;
    }
    private void RemoveSelectedLine(MouseEventArgs _)
    {
        if (Busy || _selectedDraftLine is null || _draftLines.Count <= 1) return;
        var index = _draftLines.IndexOf(_selectedDraftLine);
        if (index < 0) return;
        _draftLines.RemoveAt(index);
        _selectedDraftLine = _draftLines[Math.Min(index, _draftLines.Count - 1)];
    }

    private void OnLineVariantChanged(TransactionLineForm line, string? value)
    {
        line.ProductVariantId = value;
        line.ProductVariantError = null;
        if (Guid.TryParse(value, out var variantId) && _variants.FirstOrDefault(x => x.Id == variantId) is { } selected)
        {
            // Purchase price is a suggestion only; the operator can change it before saving.
            if ((CurrentType is InventoryTransactionType.Receipt or InventoryTransactionType.Opening or InventoryTransactionType.AdjustmentIncrease)
                && (string.IsNullOrWhiteSpace(line.UnitCost) || line.UnitCost == "0"))
                line.UnitCost = selected.PurchasePrice.ToString("0.##", CultureInfo.InvariantCulture);
        }
    }

    private bool UsesWholeQuantity(TransactionLineForm line)
    {
        if (!Guid.TryParse(line.ProductVariantId, out var variantId)) return false;
        var unitId = _variants.FirstOrDefault(x => x.Id == variantId)?.UnitId;
        var unit = _units.FirstOrDefault(x => x.Id == unitId);
        return QuantityInputRules.UsesWholeNumbers(unit?.Code, unit?.Name);
    }

    private void OnLineQuantityChanged(TransactionLineForm line, string? value)
    {
        line.Quantity = value ?? string.Empty;
        line.QuantityError = null;
        line.UnitCostError = null;
    }

    private void OnLineUnitCostChanged(TransactionLineForm line, string? value)
    {
        line.UnitCost = value ?? string.Empty;
        line.UnitCostError = null;
        line.QuantityError = null;
    }

    private async Task SaveAsync(MouseEventArgs args)
    {
        if (_mode != ViewMode.Create || Busy)
            return;

        if (!TryBuildCreateRequest(out var request, out var hasRequiredErrors))
        {
            _validationPanelRevision++;
            Snackbar.Error(hasRequiredErrors
                ? "هناك بيانات إجبارية لم يتم إدخالها."
                : "توجد قيم غير صحيحة. يرجى مراجعة الحقول المميزة باللون الأحمر.");
            return;
        }

        _saving = true;
        try
        {
            var saved = await Inventory.CreateInventoryTransactionAsync(request);
            if (saved is null)
                return;

            // A successful create must leave create mode before loading the saved document.
            _mode = ViewMode.Empty;
            _draftLines.Clear();
            _selectedDraftLine = null;
            _search = _typeFilter = _statusFilter = _warehouseFilter = null;
            await LoadAsync();
            await SelectAsync(saved.Id, allowWhileSaving: true);
            Snackbar.Success("تم إنشاء عملية المخزون.");
            if (Screen == "new") InventoryNavigation.NavigateTo($"/inventory/transactions/details/{saved.Id:D}", replace: true);
        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(ex.Error);
        }
        catch (Exception)
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _saving = false;
        }
    }

    private bool TryBuildCreateRequest(out CreateInventoryTransactionRequest request, out bool hasRequiredErrors)
    {
        ClearValidationErrors();
        hasRequiredErrors = false;
        var isValid = true;

        if (!int.TryParse(_transactionType, out var transactionTypeValue) ||
            !Enum.IsDefined(typeof(InventoryTransactionType), transactionTypeValue) ||
            !InventoryArabicPresenter.TransactionTypeOptions.Any(x => x.Value == _transactionType))
        {
            _transactionTypeError = "نوع العملية غير صحيح.";
            isValid = false;
        }

        if (!_transactionDate.HasValue)
        {
            _transactionDateError = "هذا الحقل إجباري.";
            hasRequiredErrors = true;
            isValid = false;
        }

        Guid? sourceWarehouseId = null;
        if (RequiresSourceWarehouse)
        {
            if (!Guid.TryParse(_sourceWarehouseId, out var sourceId))
            {
                _sourceWarehouseError = "هذا الحقل إجباري.";
                hasRequiredErrors = true;
                isValid = false;
            }
            else
            {
                sourceWarehouseId = sourceId;
            }
        }

        Guid? destinationWarehouseId = null;
        if (RequiresDestinationWarehouse)
        {
            if (!Guid.TryParse(_destinationWarehouseId, out var destinationId))
            {
                _destinationWarehouseError = "هذا الحقل إجباري.";
                hasRequiredErrors = true;
                isValid = false;
            }
            else
            {
                destinationWarehouseId = destinationId;
            }
        }

        if (CurrentType == InventoryTransactionType.Transfer &&
            sourceWarehouseId.HasValue && destinationWarehouseId.HasValue &&
            sourceWarehouseId.Value == destinationWarehouseId.Value)
        {
            const string message = "يجب أن يختلف مخزن المصدر عن مخزن الوجهة.";
            _sourceWarehouseError = message;
            _destinationWarehouseError = message;
            isValid = false;
        }

        var reason = NullIfBlank(_reason);
        if (IsAdjustment && string.IsNullOrWhiteSpace(reason))
        {
            _reasonError = "هذا الحقل إجباري.";
            hasRequiredErrors = true;
            isValid = false;
        }
        else if (reason?.Length > 500)
        {
            _reasonError = "الحد الأقصى 500 حرف.";
            isValid = false;
        }

        var notes = NullIfBlank(_notes);
        if (notes?.Length > 1000)
        {
            _notesError = "الحد الأقصى 1000 حرف.";
            isValid = false;
        }

        var lines = new List<CreateInventoryTransactionLineRequest>();
        var parsedVariants = new List<Guid?>();

        foreach (var line in _draftLines)
        {
            Guid? variantId = null;
            if (!Guid.TryParse(line.ProductVariantId, out var parsedVariantId))
            {
                line.ProductVariantError = "هذا الحقل إجباري.";
                hasRequiredErrors = true;
                isValid = false;
            }
            else if (!_variants.Any(x => x.Id == parsedVariantId && IsUsableVariant(x)))
            {
                line.ProductVariantError = "الصنف المحدد غير نشط أو غير معرف كصنف مخزني.";
                isValid = false;
            }
            else
            {
                variantId = parsedVariantId;
            }

            decimal quantity = 0;
            if (string.IsNullOrWhiteSpace(line.Quantity))
            {
                line.QuantityError = "هذا الحقل إجباري.";
                hasRequiredErrors = true;
                isValid = false;
            }
            else if (!TryParseDecimal(line.Quantity, out quantity))
            {
                line.QuantityError = "أدخل كمية رقمية صحيحة.";
                isValid = false;
            }
            else if (quantity <= 0)
            {
                line.QuantityError = "يجب أن تكون الكمية أكبر من صفر.";
                isValid = false;
            }
            else if (UsesWholeQuantity(line) && !QuantityInputRules.IsWhole(quantity))
            {
                line.QuantityError = QuantityInputRules.WholeNumberMessage;
                isValid = false;
            }
            else if (!FitsPrecision(quantity, 18, 3))
            {
                line.QuantityError = "الكمية تسمح بحد أقصى 15 رقمًا صحيحًا و3 منازل عشرية.";
                isValid = false;
            }

            decimal unitCost = 0;
            if (string.IsNullOrWhiteSpace(line.UnitCost))
            {
                line.UnitCostError = "هذا الحقل إجباري.";
                hasRequiredErrors = true;
                isValid = false;
            }
            else if (!TryParseDecimal(line.UnitCost, out unitCost))
            {
                line.UnitCostError = "أدخل تكلفة رقمية صحيحة.";
                isValid = false;
            }
            else if (unitCost < 0)
            {
                line.UnitCostError = "لا يمكن أن تكون التكلفة سالبة.";
                isValid = false;
            }
            else if (!FitsPrecision(unitCost, 18, 2))
            {
                line.UnitCostError = "التكلفة تسمح بحد أقصى 16 رقمًا صحيحًا ومنزلتين عشريتين.";
                isValid = false;
            }

            if (quantity > 0 && unitCost >= 0 &&
                FitsPrecision(quantity, 18, 3) && FitsPrecision(unitCost, 18, 2) &&
                !TotalCostFitsDatabase(quantity, unitCost))
            {
                line.UnitCostError = "إجمالي السطر أكبر من الحد الذي تسمح به قاعدة البيانات.";
                isValid = false;
            }

            parsedVariants.Add(variantId);
            if (variantId.HasValue && line.QuantityError is null && line.UnitCostError is null)
                lines.Add(new CreateInventoryTransactionLineRequest(variantId.Value, quantity, unitCost, null));
        }

        var duplicateIds = parsedVariants
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .GroupBy(x => x)
            .Where(x => x.Count() > 1)
            .Select(x => x.Key)
            .ToHashSet();

        if (duplicateIds.Count > 0)
        {
            foreach (var line in _draftLines)
            {
                if (Guid.TryParse(line.ProductVariantId, out var id) && duplicateIds.Contains(id))
                    line.ProductVariantError = "الصنف مكرر في أكثر من بند.";
            }
            isValid = false;
        }

        if (_draftLines.Count == 0)
        {
            hasRequiredErrors = true;
            isValid = false;
        }

        var transactionDate = _transactionDate ?? DateOnly.FromDateTime(DateTime.Today);
        var dateTime = DateTime.SpecifyKind(transactionDate.ToDateTime(new TimeOnly(12, 0)), DateTimeKind.Utc);

        request = new CreateInventoryTransactionRequest(
            string.Empty,
            CurrentType,
            sourceWarehouseId,
            destinationWarehouseId,
            new DateTimeOffset(dateTime),
            null,
            null,
            reason,
            notes,
            lines);

        return isValid && lines.Count == _draftLines.Count;
    }

    private async Task SelectAsync(Guid id, bool allowWhileSaving = false)
    {
        if (Creating || (_saving && !allowWhileSaving) || _selecting) return;
        _selecting = true;
        try
        {
            var transaction = _transactions.FirstOrDefault(x => x.Id == id) ?? await Inventory.GetInventoryTransactionAsync(id);
            if (transaction is null) return;
            var lines = await Inventory.GetInventoryTransactionLinesAsync(id);
            _selectedId = id;
            _selectedTransaction = transaction;
            _selectedLines = lines;
            _selectedLineId = lines.FirstOrDefault()?.Id;
            _linePage = 1;
            var index = RecordIndex;
            if (index >= 0) _historyPage = index / HistoryPageSize + 1;
            _mode = ViewMode.View;
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch (Exception) { ApiFeedback.ShowUnexpected(); }
        finally { _selecting = false; }
    }

    private async Task PostAsync(MouseEventArgs args)
    {
        if (!CanPost || !_selectedId.HasValue || Busy)
            return;

        _posting = true;
        try
        {
            var posted = await Inventory.PostInventoryTransactionAsync(_selectedId.Value, new PostInventoryTransactionRequest());
            if (posted is null)
                return;

            _selectedTransaction = posted;
            await LoadAsync();
            await SelectAsync(posted.Id);
            Snackbar.Success("تم ترحيل عملية المخزون بنجاح.");
        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(ex.Error);
        }
        catch (Exception)
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _posting = false;
        }
    }

    private void ClearValidationErrors()
    {
        _transactionTypeError = null;
        _transactionDateError = null;
        _sourceWarehouseError = null;
        _destinationWarehouseError = null;
        _reasonError = null;
        _notesError = null;

        foreach (var line in _draftLines)
        {
            line.ProductVariantError = null;
            line.QuantityError = null;
            line.UnitCostError = null;
        }
    }

    private static bool TryParseDecimal(string? text, out decimal value)
    {
        if (decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out value))
            return true;

        return decimal.TryParse(text, NumberStyles.Number, CultureInfo.CurrentCulture, out value);
    }

    private static bool FitsPrecision(decimal value, int precision, int scale)
    {
        if (value == decimal.MinValue)
            return false;

        var absolute = Math.Abs(value);
        var integerLimit = Pow10(precision - scale);
        if (absolute >= integerLimit)
            return false;

        var factor = Pow10(scale);
        return decimal.Truncate(absolute * factor) == absolute * factor;
    }

    private static bool TotalCostFitsDatabase(decimal quantity, decimal unitCost)
    {
        if (unitCost == 0)
            return true;

        const decimal maxTotal = 9999999999999999.99m;
        return quantity <= maxTotal / unitCost;
    }

    private static decimal Pow10(int exponent)
    {
        var value = 1m;
        for (var i = 0; i < exponent; i++)
            value *= 10m;
        return value;
    }

    private bool IsUsableVariant(ProductVariantDto variant) =>
        variant.IsActive && _products.Any(x => x.Id == variant.ProductId && x.IsActive && x.IsStockItem);

    private string WarehouseName(Guid? id) => id.HasValue ? _warehouses.FirstOrDefault(x => x.Id == id.Value)?.Name ?? "—" : "—";
    private string ProductName(Guid id) => _products.FirstOrDefault(x => x.Id == id)?.Name ?? "—";
    private ProductVariantDto? Variant(Guid id) => _variants.FirstOrDefault(x => x.Id == id);
    private string VariantLabel(Guid id) { var v = Variant(id); return v is null ? "—" : $"{ProductName(v.ProductId)}{(string.IsNullOrWhiteSpace(v.VariantName) ? string.Empty : $" - {v.VariantName}")}"; }
    private string VariantSku(Guid id) => Variant(id)?.SKU ?? "—";
    private static Guid? ParseGuid(string? value) => Guid.TryParse(value, out var id) ? id : null;
    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static bool Match(string? search, params string?[] values)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;
        var term = search.Trim();
        return values.Any(x => x?.Contains(term, StringComparison.CurrentCultureIgnoreCase) == true);
    }

    private async Task ExportAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            InventoryTransactionType? type = int.TryParse(_typeFilter, out var typeValue) && Enum.IsDefined(typeof(InventoryTransactionType), typeValue)
                ? (InventoryTransactionType)typeValue : null;
            InventoryTransactionStatus? status = int.TryParse(_statusFilter, out var statusValue) && Enum.IsDefined(typeof(InventoryTransactionStatus), statusValue)
                ? (InventoryTransactionStatus)statusValue : null;
            var warehouseId = Guid.TryParse(_warehouseFilter, out var parsedWarehouseId) ? parsedWarehouseId : (Guid?)null;
            var bytes = await SpreadsheetClient.ExportAsync(
                "transactions", new PageRequest { Search = _search, SortDirection = SortDirection.Descending }, warehouseId: warehouseId,
                transactionType: type, transactionStatus: status);
            await SpreadsheetDownload.SaveAsync(bytes, "inventory-transactions.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch (Exception) { ApiFeedback.ShowUnexpected(); }
        finally { _exporting = false; }
    }
