@page "/products"
@attribute [Authorize]
@using OAS.Client.Inventory.Services
@using OAS.Contracts.Inventory.Products
@using OAS.UiLib.Components.Spreadsheets

<PageTitle>المنتجات | OAS</PageTitle>

<UiWorkspaceLayout ShowAside="true" ShowFilters="false">
    <Actions>
        <UiWorkspaceActionBar>
            <UiButton Text="جديد" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small"
                      Disabled="@(IsEditing || _saving)" OnClick="BeginCreateAsync" />
            <UiButton Text="حفظ" IconCssClass="fa-solid fa-floppy-disk" Size="ControlSize.Small"
                      Disabled="@(!CanSave)" Loading="@_saving" OnClick="SaveAsync" />
            <UiButton Text="تعديل" IconCssClass="fa-solid fa-pen" Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small" Disabled="@(!CanEdit)" OnClick="BeginEditAsync" />
            <UiButton Text="إلغاء" IconCssClass="fa-solid fa-xmark" Variant="ButtonVariant.Ghost"
                      Size="ControlSize.Small" Disabled="@((!IsEditing || _saving))" OnClick="CancelEditAsync" />
            <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary"
                      Size="ControlSize.Small" Disabled="@(IsEditing || _saving)" Loading="@_loading" OnClick="RefreshAsync" />
            <UiSpreadsheetActions CanImport="false" Busy="@_exporting" OnExport="ExportAsync" />
            <UiSearchInput @bind-Value="_search" Placeholder="ابحث في القسم الحالي..."
                           AriaLabel="البحث في المنتجات" ClearText="مسح البحث"
                           DebounceMilliseconds="250" OnSearch="SearchChangedAsync" />
        </UiWorkspaceActionBar>
    </Actions>

    <Content>
        <div class="inventory-products">
            <UiSectionTabStrip Tabs="@SectionTabs" OnSelect="ChangeSectionKeyAsync" />

            <UiDataGridPanel Title="@SectionTitle" Subtitle="@SectionSubtitle">
                <Body>
                    @if (_loading)
                    {
                        <UiAlert Message="جاري تحميل البيانات..." />
                    }
                    else if (_section == ProductSection.Categories)
                    {
                        <UiDataTable TItem="ProductCategoryDto" Items="@FilterCategories()" Headers="@SimpleHeaders" EmptyText="لا توجد تصنيفات مطابقة."
                                     SidebarTypography="true"
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td><strong>@item.Code</strong></td>
                                <td>@item.NameAr</td>
                                <td><UiBadge Text="@StatusText(item.IsActive)" Tone="@(item.IsActive ? AlertTone.Success : AlertTone.Danger)" /></td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else if (_section == ProductSection.Brands)
                    {
                        <UiDataTable TItem="BrandDto" Items="@FilterBrands()" Headers="@SimpleHeaders" EmptyText="لا توجد علامات تجارية مطابقة."
                                     SidebarTypography="true"
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td><strong>@item.Code</strong></td>
                                <td>@item.Name</td>
                                <td><UiBadge Text="@StatusText(item.IsActive)" Tone="@(item.IsActive ? AlertTone.Success : AlertTone.Danger)" /></td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else if (_section == ProductSection.ProductTypes)
                    {
                        <UiDataTable TItem="ProductTypeDto" Items="@FilterProductTypes()" Headers="@SimpleHeaders" EmptyText="لا توجد أنواع منتجات مطابقة."
                                     SidebarTypography="true"
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td><strong>@item.Code</strong></td>
                                <td>@item.NameAr</td>
                                <td><UiBadge Text="@StatusText(item.IsActive)" Tone="@(item.IsActive ? AlertTone.Success : AlertTone.Danger)" /></td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else if (_section == ProductSection.Units)
                    {
                        <UiDataTable TItem="UnitDto" Items="@FilterUnits()" Headers="@SimpleHeaders" EmptyText="لا توجد وحدات مطابقة."
                                     SidebarTypography="true"
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td><strong>@item.Code</strong></td>
                                <td>@item.NameAr</td>
                                <td><UiBadge Text="@StatusText(item.IsActive)" Tone="@(item.IsActive ? AlertTone.Success : AlertTone.Danger)" /></td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else if (_section == ProductSection.Products)
                    {
                        <UiDataTable TItem="ProductDto" Items="@FilterProducts()" Headers="@ProductHeaders" EmptyText="لا توجد منتجات مطابقة."
                                     SidebarTypography="true"
                                     UniformCellTypography="true"
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td>@item.ProductCode</td>
                                <td>@item.NameAr</td>
                                <td>@ProductTypeName(item.ProductTypeId)</td>
                                <td><UiBadge Text="@(item.IsStockItem ? "نعم" : "لا")" Tone="@(item.IsStockItem ? AlertTone.Success : AlertTone.Info)" /></td>
                                <td>@ProductVariantCount(item.Id)</td>
                                <td>@ProductInventoryStatus(item)</td>
                                <td><UiBadge Text="@StatusText(item.IsActive)" Tone="@(item.IsActive ? AlertTone.Success : AlertTone.Danger)" /></td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else
                    {
                        <UiDataTable TItem="ProductVariantDto" Items="@FilterVariants()" Headers="@VariantHeaders" EmptyText="لا توجد متغيرات مطابقة."
                                     SidebarTypography="true"
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td><strong>@item.SKU</strong></td>
                                <td>@(item.VariantName ?? ProductName(item.ProductId))</td>
                                <td>@(item.Barcode ?? "—")</td>
                                <td>@item.SellingPrice.ToString("N2")</td>
                                <td><UiBadge Text="@StatusText(item.IsActive)" Tone="@(item.IsActive ? AlertTone.Success : AlertTone.Danger)" /></td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                </Body>
            </UiDataGridPanel>
        </div>
    </Content>

    <Aside>
        <div class="inventory-products__aside">
            <UiCard Title="@EditorTitle" Subtitle="@EditorSubtitle">
                @if (_mode == EditorMode.Empty)
                {
                    <UiAlert Message="اختر سجلًا من القائمة أو اضغط «جديد»." />
                }
                else
                {
                    @RenderEditor()

                    @if (_section == ProductSection.Products && IsServiceProductType)
                    {
                        <UiAlert Tone="AlertTone.Info" Message="المنتج من نوع خدمة؛ لذلك لا يمكن تفعيله كصنف مخزني ولا إضافة رصيد افتتاحي له." />
                    }

                    @if (ShowInitialVariantSection)
                    {
                        <UiCard Title="الصنف الأول القابل للبيع والتخزين" Subtitle="يتم إنشاؤه مع المنتج في نفس العملية">
                            <UiStackLayout Gap="StackGap.Small">
                                <UiInputText Label="SKU الأول" Value="@_initialSku" ValueExpression="@(() => _initialSku)"
                                             ValueChanged="@(v => SetField(InitialSkuField, () => _initialSku = v ?? string.Empty))"
                                             Required="true" ErrorText="@ErrorFor(InitialSkuField)" MaxLength="64" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="باركود الصنف الأول" Value="@_initialBarcode" ValueExpression="@(() => _initialBarcode)"
                                             ValueChanged="@(v => SetField(InitialBarcodeField, () => _initialBarcode = v))"
                                             Placeholder="(اختياري)" ErrorText="@ErrorFor(InitialBarcodeField)" MaxLength="64" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="اسم الصنف الأول" Value="@_initialVariantName" ValueExpression="@(() => _initialVariantName)"
                                             ValueChanged="@(v => _initialVariantName = v)" Placeholder="(اختياري)" MaxLength="100" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiGrid Columns="2">
                                    <UiInputText Label="اللون" Value="@_initialColor" ValueExpression="@(() => _initialColor)" ValueChanged="@(v => _initialColor = v)" Placeholder="(اختياري)" MaxLength="50" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    <UiInputText Label="المقاس" Value="@_initialSize" ValueExpression="@(() => _initialSize)" ValueChanged="@(v => _initialSize = v)" Placeholder="(اختياري)" MaxLength="50" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                </UiGrid>
                                <UiSelect Label="الوحدة" Value="@(_initialUnitId ?? string.Empty)" ValueExpression="@(() => _initialUnitId)"
                                          ValueChanged="@(v => _initialUnitId = v)" Options="@UnitOptions.Where(x => !string.IsNullOrWhiteSpace(x.Value)).ToArray()"
                                          Placeholder="(اختياري)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiGrid Columns="2">
                                    <UiInputText Label="سعر شراء الصنف الأول" Value="@_initialPurchasePrice" ValueExpression="@(() => _initialPurchasePrice)"
                                                 ValueChanged="@(v => SetField(InitialPurchasePriceField, () => _initialPurchasePrice = v ?? string.Empty))" Type="number" InputMode="decimal" Required="true"
                                                 ErrorText="@ErrorFor(InitialPurchasePriceField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    <UiInputText Label="سعر بيع الصنف الأول" Value="@_initialSellingPrice" ValueExpression="@(() => _initialSellingPrice)"
                                                 ValueChanged="@(v => SetField(InitialSellingPriceField, () => _initialSellingPrice = v ?? string.Empty))" Type="number" InputMode="decimal" Required="true"
                                                 ErrorText="@ErrorFor(InitialSellingPriceField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                </UiGrid>
                            </UiStackLayout>
                        </UiCard>
                    }

                    @if (ShowOpeningInventorySection)
                    {
                        <UiCard Title="الرصيد الافتتاحي" Subtitle="اختياري — يضاف إلى المخزن عند حفظ المنتج">
                            <UiStackLayout Gap="StackGap.Small">
                                <UiCheckbox Label="إضافة رصيد افتتاحي" Value="@_addOpeningInventory"
                                            ValueChanged="ToggleOpeningInventory"
                                            Disabled="@((!IsEditing || _saving))" />
                                @if (_addOpeningInventory)
                                {
                                    <UiSelect Label="مخزن الرصيد الافتتاحي" Value="@(_openingWarehouseId ?? string.Empty)" ValueExpression="@(() => _openingWarehouseId)"
                                              ValueChanged="@(v => SetField(OpeningWarehouseField, () => _openingWarehouseId = v))" Options="@OpeningWarehouseOptions"
                                              Placeholder="اختر مخزنًا فعالًا..." Required="true" ErrorText="@ErrorFor(OpeningWarehouseField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    <UiGrid Columns="2">
                                        <UiInputText Label="الكمية الافتتاحية" Value="@_openingQuantity" ValueExpression="@(() => _openingQuantity)"
                                                     ValueChanged="@(v => SetField(OpeningQuantityField, () => _openingQuantity = v ?? string.Empty))" Type="number" InputMode="decimal" Required="true"
                                                     ErrorText="@ErrorFor(OpeningQuantityField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                        <UiInputText Label="تكلفة الوحدة الافتتاحية" Value="@_openingUnitCost" ValueExpression="@(() => _openingUnitCost)"
                                                     ValueChanged="@(v => SetField(OpeningUnitCostField, () => _openingUnitCost = v ?? string.Empty))" Type="number" InputMode="decimal" Required="true"
                                                     ErrorText="@ErrorFor(OpeningUnitCostField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    </UiGrid>
                                    <UiKeyValue Label="القيمة الإجمالية" Value="@OpeningTotalValueText" />
                                }
                            </UiStackLayout>
                        </UiCard>
                    }

                    @if (ShowsFrameDetails)
                    {
                        <div class="inventory-products__specialized">
                            <h4>تفاصيل الإطار</h4>
                            <UiInputText Label="الموديل" Value="@_frameModel" ValueExpression="@(() => _frameModel)"
                                         ValueChanged="@(v => SetField(FrameModelField, () => _frameModel = v ?? string.Empty))"
                                         Required="@HasFrameDetailsInput()" Placeholder="@OptionalPlaceholder(HasFrameDetailsInput())"
                                         ErrorText="@ErrorFor(FrameModelField)" MaxLength="100" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            <UiInputText Label="الخامة" Value="@_frameMaterial" ValueExpression="@(() => _frameMaterial)"
                                         ValueChanged="@(v => SetField(FrameMaterialField, () => _frameMaterial = v))" Placeholder="(اختياري)"
                                         ErrorText="@ErrorFor(FrameMaterialField)" MaxLength="50" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            <UiInputText Label="نوع الإطار / Rim" Value="@_frameRimType" ValueExpression="@(() => _frameRimType)"
                                         ValueChanged="@(v => SetField(FrameRimField, () => _frameRimType = v))" Placeholder="(اختياري)"
                                         ErrorText="@ErrorFor(FrameRimField)" MaxLength="50" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            <UiInputText Label="الجنس" Value="@_frameGender" ValueExpression="@(() => _frameGender)"
                                         ValueChanged="@(v => SetField(FrameGenderField, () => _frameGender = v))" Placeholder="(اختياري)"
                                         ErrorText="@ErrorFor(FrameGenderField)" MaxLength="20" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            <UiInputText Label="الشكل" Value="@_frameShape" ValueExpression="@(() => _frameShape)"
                                         ValueChanged="@(v => SetField(FrameShapeField, () => _frameShape = v))" Placeholder="(اختياري)"
                                         ErrorText="@ErrorFor(FrameShapeField)" MaxLength="50" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            <div class="inventory-products__specialized-grid">
                                <UiInputText Label="طول الذراع" Value="@_templeLength" ValueExpression="@(() => _templeLength)"
                                             ValueChanged="@(v => SetField(TempleLengthField, () => _templeLength = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)"
                                             ErrorText="@ErrorFor(TempleLengthField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="مقاس الجسر" Value="@_bridgeSize" ValueExpression="@(() => _bridgeSize)"
                                             ValueChanged="@(v => SetField(BridgeSizeField, () => _bridgeSize = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)"
                                             ErrorText="@ErrorFor(BridgeSizeField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="عرض العدسة" Value="@_lensWidth" ValueExpression="@(() => _lensWidth)"
                                             ValueChanged="@(v => SetField(LensWidthField, () => _lensWidth = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)"
                                             ErrorText="@ErrorFor(LensWidthField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            </div>
                        </div>
                    }
                    @if (ShowsLensDetails)
                    {
                        <div class="inventory-products__specialized">
                            <h4>تفاصيل العدسة</h4>
                            <UiInputText Label="نوع العدسة" Value="@_lensType" ValueExpression="@(() => _lensType)"
                                         ValueChanged="@(v => SetField(LensTypeField, () => _lensType = v ?? string.Empty))"
                                         Required="@HasLensDetailsInput()" Placeholder="@OptionalPlaceholder(HasLensDetailsInput())"
                                         ErrorText="@ErrorFor(LensTypeField)" MaxLength="50" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            <UiInputText Label="خامة العدسة" Value="@_lensMaterial" ValueExpression="@(() => _lensMaterial)"
                                         ValueChanged="@(v => SetField(LensMaterialField, () => _lensMaterial = v))" Placeholder="(اختياري)"
                                         ErrorText="@ErrorFor(LensMaterialField)" MaxLength="50" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            <UiInputText Label="الطلاء / Coating" Value="@_lensCoating" ValueExpression="@(() => _lensCoating)"
                                         ValueChanged="@(v => SetField(LensCoatingField, () => _lensCoating = v))" Placeholder="(اختياري)"
                                         ErrorText="@ErrorFor(LensCoatingField)" MaxLength="50" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            <UiInputText Label="معامل الانكسار" Value="@_refractiveIndex" ValueExpression="@(() => _refractiveIndex)"
                                         ValueChanged="@(v => SetField(RefractiveIndexField, () => _refractiveIndex = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)"
                                         ErrorText="@ErrorFor(RefractiveIndexField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            <div class="inventory-products__specialized-grid">
                                <UiInputText Label="Sphere Min" Value="@_sphereMin" ValueExpression="@(() => _sphereMin)" ValueChanged="@(v => SetField(SphereMinField, () => _sphereMin = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(SphereMinField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="Sphere Max" Value="@_sphereMax" ValueExpression="@(() => _sphereMax)" ValueChanged="@(v => SetField(SphereMaxField, () => _sphereMax = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(SphereMaxField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="Cylinder Min" Value="@_cylinderMin" ValueExpression="@(() => _cylinderMin)" ValueChanged="@(v => SetField(CylinderMinField, () => _cylinderMin = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(CylinderMinField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="Cylinder Max" Value="@_cylinderMax" ValueExpression="@(() => _cylinderMax)" ValueChanged="@(v => SetField(CylinderMaxField, () => _cylinderMax = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(CylinderMaxField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="Add Min" Value="@_addMin" ValueExpression="@(() => _addMin)" ValueChanged="@(v => SetField(AddMinField, () => _addMin = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(AddMinField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="Add Max" Value="@_addMax" ValueExpression="@(() => _addMax)" ValueChanged="@(v => SetField(AddMaxField, () => _addMax = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(AddMaxField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            </div>
                            <UiCheckbox Label="عدسة طبية / Prescription" Value="@_isPrescriptionLens" ValueChanged="@(v => _isPrescriptionLens = v)" Disabled="@((!IsEditing || _saving))" />
                        </div>
                    }
                }
            </UiCard>
        </div>
    </Aside>
</UiWorkspaceLayout>
