@page "/products"
@page "/inventory/catalog/{CatalogSection}"
@page "/products/{Screen}"
@page "/products/{Screen}/{RecordId:guid}"
@attribute [Authorize]
@using OAS.Client.Inventory.Common
@using OAS.Client.Inventory.Services
@using OAS.Client.Inventory.Components
@using OAS.Contracts.Inventory.Products
@using OAS.UiLib.Components.Spreadsheets

@using OAS.UiLib.Components.Inventory
<PageTitle>@SectionTitle | OAS</PageTitle>
@if (!_catalogReady)
{
    <div class="oas-inventory-workspace inv-catalog-loading" role="status" aria-live="polite">جاري تحميل البيانات…</div>
}
else
{
<UiInventoryWorkspace Busy="@_loading" EditorTitle="@CatalogEditorTitle" EditorKey="@CatalogEditorKey">
    <Actions>
        <UiInventoryCatalogToolbar Editing="@IsEditing" Saving="@_saving" Loading="@_loading"
                                   SpreadsheetBusy="@(_exporting || _spreadsheetBusy || _spreadsheetImportOpen)"
                                   CanEdit="@CanEdit" CanSave="@CanSave" CanPrevious="@CanMovePrevious" CanNext="@CanMoveNext"
                                   @bind-Search="_search" OnSearch="SearchChangedAsync" OnNavigate="NavigateRecord"
                                   OnCreate="BeginCreateAsync" OnEdit="BeginEditAsync" OnSave="SaveAsync" OnCancel="CancelEditAsync" OnRefresh="RefreshAsync"
                                   OnImport="OpenSpreadsheetImportAsync" OnTemplate="DownloadTemplateAsync" OnExport="ExportAsync">
            <ExtraActions>
            @if (_section == ProductSection.Products)
            {
                <UiButton Text="استلام مشتريات" AdditionalCssClass="inv-receipt" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="@(IsEditing || _saving)" OnClick="OpenPurchaseReceiptsAsync" />
            }
            </ExtraActions>
        </UiInventoryCatalogToolbar>
    </Actions>
    <Editor>
        <div @key="_section">
            @RenderEditor()
        </div>
        @if (ShowInitialVariantSection)
        {
            <div class="inv-initial-variant">
                <strong>بيانات الصنف الأول</strong>
                            <div class="inventory-products__variant-fields">
                                <UiInputText Label="رمز الصنف (SKU)" Value="@_initialSku" ValueExpression="@(() => _initialSku)"
                                             ValueChanged="@(v => SetField(InitialSkuField, () => _initialSku = v ?? string.Empty))"
                                             Required="true" ErrorText="@ErrorFor(InitialSkuField)" MaxLength="64" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="الباركود (اختياري)" Value="@_initialBarcode" ValueExpression="@(() => _initialBarcode)"
                                             ValueChanged="@(v => SetField(InitialBarcodeField, () => _initialBarcode = v))"
                                             Placeholder="(اختياري)" ErrorText="@ErrorFor(InitialBarcodeField)" MaxLength="64" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="اسم الصنف عند البيع (اختياري)" Value="@_initialVariantName" ValueExpression="@(() => _initialVariantName)"
                                             ValueChanged="@(v => _initialVariantName = v)" Placeholder="(اختياري)" MaxLength="100" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <InventorySuggestedInput UseAngleDownIcon="true" Label="اللون" Value="@_initialColor" ValueChanged="@(v => _initialColor = v)" Suggestions="@ColorSuggestions" MaxLength="100" Disabled="@((!IsEditing || _saving))" />
                                <InventorySuggestedInput UseAngleDownIcon="true" Label="المقاس" Value="@_initialSize" ValueChanged="@(v => _initialSize = v)" Suggestions="@SizeSuggestions" MaxLength="100" Disabled="@((!IsEditing || _saving))" />
                                <UiSearchableSelect InlineDropdown="true" UseAngleDownIcon="true" Label="الوحدة" Value="@(_initialUnitId ?? string.Empty)" ValueExpression="@(() => _initialUnitId)"
                                          ValueChanged="@(v => _initialUnitId = v)" Options="@UnitOptions.Where(x => !string.IsNullOrWhiteSpace(x.Value)).ToArray()"
                                          Placeholder="(اختياري)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="سعر الشراء" Value="@_initialPurchasePrice" ValueExpression="@(() => _initialPurchasePrice)"
                                                 ValueChanged="@(v => SetField(InitialPurchasePriceField, () => _initialPurchasePrice = v ?? string.Empty))" Type="number" InputMode="decimal" Required="true"
                                                 ErrorText="@ErrorFor(InitialPurchasePriceField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <UiInputText Label="سعر البيع" Value="@_initialSellingPrice" ValueExpression="@(() => _initialSellingPrice)"
                                                 ValueChanged="@(v => SetField(InitialSellingPriceField, () => _initialSellingPrice = v ?? string.Empty))" Type="number" InputMode="decimal" Required="true"
                                                 ErrorText="@ErrorFor(InitialSellingPriceField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                            </div>

            </div>
        }
    </Editor>
    <SearchAndDetails>
        <div class="inv-specifications" @key="(_section, _selectedId, _mode)">
                    @if (ShowsFrameDetails)
                    {
                        <details class="inventory-products__specialized" open="@(_mode == EditorMode.Edit && HasFrameDetailsInput())">
                            <summary>مواصفات الإطار</summary>
                            <div class="inventory-products__specialized-fields">
                                <UiInputText Label="الموديل" Value="@_frameModel" ValueExpression="@(() => _frameModel)"
                                         ValueChanged="@(v => SetField(FrameModelField, () => _frameModel = v ?? string.Empty))"
                                         Required="@HasFrameDetailsInput()" Placeholder="@OptionalPlaceholder(HasFrameDetailsInput())"
                                         ErrorText="@ErrorFor(FrameModelField)" MaxLength="100" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <InventorySuggestedInput UseAngleDownIcon="true" Label="الخامة" Value="@_frameMaterial" ValueChanged="@(v => SetField(FrameMaterialField, () => _frameMaterial = v))" Suggestions="@FrameMaterialSuggestions" ErrorText="@ErrorFor(FrameMaterialField)" MaxLength="100" Disabled="@((!IsEditing || _saving))" />
                                <InventorySuggestedInput UseAngleDownIcon="true" Label="تصميم الإطار" Value="@_frameRimType" ValueChanged="@(v => SetField(FrameRimField, () => _frameRimType = v))" Suggestions="@FrameRimSuggestions" ErrorText="@ErrorFor(FrameRimField)" MaxLength="100" Disabled="@((!IsEditing || _saving))" />
                                <InventorySuggestedInput UseAngleDownIcon="true" Label="الجنس" Value="@_frameGender" ValueChanged="@(v => SetField(FrameGenderField, () => _frameGender = v))" Suggestions="@FrameGenderSuggestions" ErrorText="@ErrorFor(FrameGenderField)" MaxLength="20" Disabled="@((!IsEditing || _saving))" />
                                <InventorySuggestedInput UseAngleDownIcon="true" Label="الشكل" Value="@_frameShape" ValueChanged="@(v => SetField(FrameShapeField, () => _frameShape = v))" Suggestions="@FrameShapeSuggestions" ErrorText="@ErrorFor(FrameShapeField)" MaxLength="100" Disabled="@((!IsEditing || _saving))" />
                                <div class="inventory-products__specialized-grid">
                                    <UiInputText Label="طول ذراع النظارة (مم)" Value="@_templeLength" ValueExpression="@(() => _templeLength)"
                                             ValueChanged="@(v => SetField(TempleLengthField, () => _templeLength = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)"
                                             ErrorText="@ErrorFor(TempleLengthField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    <UiInputText Label="عرض الجسر (مم)" Value="@_bridgeSize" ValueExpression="@(() => _bridgeSize)"
                                             ValueChanged="@(v => SetField(BridgeSizeField, () => _bridgeSize = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)"
                                             ErrorText="@ErrorFor(BridgeSizeField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    <UiInputText Label="عرض العدسة (مم)" Value="@_lensWidth" ValueExpression="@(() => _lensWidth)"
                                             ValueChanged="@(v => SetField(LensWidthField, () => _lensWidth = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)"
                                             ErrorText="@ErrorFor(LensWidthField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                </div>
                            </div>
                        </details>
                    }
                    @if (ShowsLensSection)
                    {
                        <details class="inventory-products__specialized">
                            <summary>مواصفات العدسة</summary>
                            @if (_section == ProductSection.Products && _mode != EditorMode.Create && LensVariantOptions.Count > 0)
                            {
                                <div class="inventory-products__specialized-fields">
                                    <UiSearchableSelect InlineDropdown="true" UseAngleDownIcon="true" Label="الصنف (SKU)" Value="@_lensVariantId" ValueExpression="@(() => _lensVariantId)"
                                                        ValueChanged="SelectLensVariant" Options="@LensVariantOptions" Required="true"
                                                        Disabled="@(IsEditing || _saving || _loading || LensVariantOptions.Count == 1)" Size="ControlSize.Small" />
                                </div>
                            }
                            @if (ShowsLensDetails)
                            {
                            <div class="inventory-products__specialized-fields" @key="LensDetailsVariantId">
                                <InventorySuggestedInput UseAngleDownIcon="true" Label="نوع العدسة" Value="@_lensType" ValueChanged="@(v => SetField(LensTypeField, () => _lensType = v ?? string.Empty))" Suggestions="@LensTypeSuggestions" Required="@HasLensDetailsInput()" ErrorText="@ErrorFor(LensTypeField)" MaxLength="100" Disabled="@((!IsEditing || _saving))" />
                                <InventorySuggestedInput UseAngleDownIcon="true" Label="خامة العدسة" Value="@_lensMaterial" ValueChanged="@(v => SetField(LensMaterialField, () => _lensMaterial = v))" Suggestions="@LensMaterialSuggestions" ErrorText="@ErrorFor(LensMaterialField)" MaxLength="100" Disabled="@((!IsEditing || _saving))" />
                                <InventorySuggestedInput UseAngleDownIcon="true" Label="طبقة حماية العدسة" Value="@_lensCoating" ValueChanged="@(v => SetField(LensCoatingField, () => _lensCoating = v))" Suggestions="@LensCoatingSuggestions" ErrorText="@ErrorFor(LensCoatingField)" MaxLength="100" Disabled="@((!IsEditing || _saving))" />
                                <UiInputText Label="معامل الانكسار" Value="@_refractiveIndex" ValueExpression="@(() => _refractiveIndex)"
                                         ValueChanged="@(v => SetField(RefractiveIndexField, () => _refractiveIndex = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)"
                                         ErrorText="@ErrorFor(RefractiveIndexField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                <div class="inventory-products__specialized-grid">
                                    <UiInputText Label="SPH" Value="@_sph" ValueExpression="@(() => _sph)" ValueChanged="@(v => SetField(SphField, () => _sph = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(SphField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    <UiInputText Label="CYL" Value="@_cyl" ValueExpression="@(() => _cyl)" ValueChanged="@(v => SetField(CylField, () => _cyl = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(CylField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    <UiInputText Label="ADD" Value="@_add" ValueExpression="@(() => _add)" ValueChanged="@(v => SetField(AddField, () => _add = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(AddField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    <UiInputText Label="تقوّس العدسة (Base Curve)" Value="@_baseCurve" ValueExpression="@(() => _baseCurve)" ValueChanged="@(v => SetField(BaseCurveField, () => _baseCurve = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(BaseCurveField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                    <UiInputText Label="قطر العدسة (مم)" Value="@_diameter" ValueExpression="@(() => _diameter)" ValueChanged="@(v => SetField(DiameterField, () => _diameter = v))" Type="number" InputMode="decimal" Placeholder="(اختياري)" ErrorText="@ErrorFor(DiameterField)" Disabled="@((!IsEditing || _saving))" Size="ControlSize.Small" />
                                </div>
                            </div>
                            <UiCheckbox Label="عدسة طبية بوصفة" Value="@_isPrescriptionLens" ValueChanged="@(v => _isPrescriptionLens = v)" Disabled="@((!IsEditing || _saving))" />
                            }
                            else
                            {
                                <div class="inventory-products__specialized-fields">
                                    <span>مواصفات العدسة مرتبطة بالصنف. يجب إضافة صنف للمنتج أولاً.</span>
                                </div>
                            }
                        </details>
                    }

        </div>
    </SearchAndDetails>
    <Table>
                    @if (_section == ProductSection.Categories)
                    {
                        <UiDataTable TItem="ProductCategoryDto" Items="@PageItems(FilterCategories())" Compact="true" UniformCellTypography="true" Headers="@SimpleHeaders" EmptyText="@(CatalogEmptyText("لا توجد تصنيفات مطابقة."))"
                                     
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@StatusText(item.IsActive)</td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else if (_section == ProductSection.Brands)
                    {
                        <UiDataTable TItem="BrandDto" Items="@PageItems(FilterBrands())" Compact="true" UniformCellTypography="true" Headers="@SimpleHeaders" EmptyText="@(CatalogEmptyText("لا توجد علامات تجارية مطابقة."))"
                                     
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@StatusText(item.IsActive)</td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else if (_section == ProductSection.ProductTypes)
                    {
                        <UiDataTable TItem="ProductTypeDto" Items="@PageItems(FilterProductTypes())" Compact="true" UniformCellTypography="true" Headers="@SimpleHeaders" EmptyText="@(CatalogEmptyText("لا توجد أنواع منتجات مطابقة."))"
                                     
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@StatusText(item.IsActive)</td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else if (_section == ProductSection.Units)
                    {
                        <UiDataTable TItem="UnitDto" Items="@PageItems(FilterUnits())" Compact="true" UniformCellTypography="true" Headers="@SimpleHeaders" EmptyText="@(CatalogEmptyText("لا توجد وحدات مطابقة."))"
                                     
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@StatusText(item.IsActive)</td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else if (_section == ProductSection.Products)
                    {
                        <UiDataTable TItem="ProductDto" Items="@PageItems(FilterProducts())" Compact="true" Headers="@ProductHeaders" EmptyText="@(CatalogEmptyText("لا توجد منتجات مطابقة."))"
                                     
                                     UniformCellTypography="true"
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td>@item.ProductCode</td>
                                <td>@item.Name</td>
                                <td>@ProductTypeNameForCategory(item.CategoryId)</td>
                                <td>@(item.IsStockItem ? "نعم" : "لا")</td>
                                <td>@ProductVariantCount(item.Id)</td>
                                <td>@ProductInventoryStatus(item)</td>
                                <td>@StatusText(item.IsActive)</td>
                            </RowTemplate>
                        </UiDataTable>
                    }
                    else
                    {
                        <UiDataTable TItem="ProductVariantDto" Items="@PageItems(FilterVariants())" Compact="true" UniformCellTypography="true" Headers="@VariantHeaders" EmptyText="@(CatalogEmptyText("لا توجد أصناف مطابقة."))"
                                     
                                     OnRowClick="@(x => Select(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                            <RowTemplate Context="item">
                                <td>@item.SKU</td>
                                <td>@(item.VariantName ?? ProductName(item.ProductId))</td>
                                <td>@(item.Barcode ?? "—")</td>
                                <td>@InventoryDisplayFormat.Number(item.SellingPrice)</td>
                                <td>@StatusText(item.IsActive)</td>
                            </RowTemplate>
                        </UiDataTable>
                    }

    </Table>
    <Footer>
        <UiInventoryPagination Page="@CurrentPage" PageSize="@CatalogPageSize" TotalCount="@VisibleCount" Disabled="@(IsEditing || _loading || _saving)" OnPageChanged="ChangePage" />
    </Footer>
</UiInventoryWorkspace>
}
@if (_spreadsheetImportOpen)
{
    <InventorySpreadsheetImportHost Section="@CurrentSpreadsheetSection"
                                    Title="@SectionTitle"
                                    OnClose="CloseSpreadsheetImportAsync"
                                    OnImported="ReloadAfterSpreadsheetImportAsync" />
}

@code {
    [Inject] private NavigationManager InventoryNavigation { get; set; } = default!;
    [Parameter] public string? Screen { get; set; }
    [Parameter] public Guid? RecordId { get; set; }
    [Parameter] public string? CatalogSection { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "section")] public string? InventorySection { get; set; }
    private string? _appliedInventoryRoute;
    private Task? _initialCatalogLoad;
    private bool _catalogReady;
    private string CatalogEditorTitle => _section switch
    {
        ProductSection.Variants => "بيانات الصنف",
        ProductSection.Units => "بيانات الوحدة",
        ProductSection.Categories => "بيانات التصنيف",
        ProductSection.Brands => "بيانات العلامة التجارية",
        ProductSection.ProductTypes => "بيانات نوع المنتج",
        _ => "بيانات المنتج"
    };
    private object CatalogEditorKey => (_section, _mode);
    private string CatalogEmptyText(string emptyText) => _loading ? "جاري تحميل البيانات..." : emptyText;
    private const int CatalogPageSize = 12;
    private int _page = 1;
    private int CurrentPage => Math.Clamp(_page, 1, Math.Max(1, (VisibleCount + CatalogPageSize - 1) / CatalogPageSize));
    private IReadOnlyList<T> PageItems<T>(IReadOnlyList<T> items) => items.Skip((CurrentPage - 1) * CatalogPageSize).Take(CatalogPageSize).ToArray();
    private void ChangePage(int page) => _page = page;
    private Guid[] VisibleIds => _section switch
    {
        ProductSection.Categories => FilterCategories().Select(x => x.Id).ToArray(),
        ProductSection.Brands => FilterBrands().Select(x => x.Id).ToArray(),
        ProductSection.ProductTypes => FilterProductTypes().Select(x => x.Id).ToArray(),
        ProductSection.Units => FilterUnits().Select(x => x.Id).ToArray(),
        ProductSection.Variants => FilterVariants().Select(x => x.Id).ToArray(),
        _ => FilterProducts().Select(x => x.Id).ToArray()
    };
    private int SelectedIndex => Array.IndexOf(VisibleIds, _selectedId ?? Guid.Empty);
    private bool CanMovePrevious => !IsEditing && !_saving && !_loading && SelectedIndex > 0;
    private bool CanMoveNext => !IsEditing && !_saving && !_loading && SelectedIndex < VisibleCount - 1;
    private void NavigateRecord(int direction)
    {
        if (IsEditing || _saving || _loading) return;
        var ids = VisibleIds;
        if (ids.Length == 0) return;
        var index = Array.IndexOf(ids, _selectedId ?? Guid.Empty);
        index = direction switch { -2 => 0, 2 => ids.Length - 1, _ => Math.Clamp(index + direction, 0, ids.Length - 1) };
        Select(ids[index]);
        _page = index / CatalogPageSize + 1;
    }
    private void RevealSelected()
    {
        var index = SelectedIndex;
        if (index >= 0) _page = index / CatalogPageSize + 1;
    }
    private Task OpenPurchaseReceiptsAsync(MouseEventArgs _)
    {
        InventoryNavigation.NavigateTo("/purchases/receipts");
        return Task.CompletedTask;
    }
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{CatalogSection}/{Screen}/{RecordId}/{InventorySection}/{ProductIdFromQuery}";
        if (_appliedInventoryRoute == key) return;
        _appliedInventoryRoute = key;
        _catalogReady = false;
        _section = Enum.TryParse<ProductSection>(CatalogSection ?? InventorySection, true, out var section) && Enum.IsDefined(section) ? section : ProductSection.Products;
        _mode = EditorMode.Empty;
        _selectedId = null;
        _page = 1;
        _search = null;
        ClearForm();

        // Resolve the route before starting the first asynchronous load. This prevents
        // an initial products render when opening variants or units. Mount the
        // workspace only after data and initial selection are ready.
        await (_initialCatalogLoad ??= LoadAsync());
        if (_appliedInventoryRoute != key) return;
        ClearForm();
        if (Screen == "new") await BeginCreateAsync(new MouseEventArgs());
        else if ((RecordId ?? ProductIdFromQuery) is { } id && SelectionExists(id))
        {
            Select(id);
            if (Screen == "edit") await BeginEditAsync(new MouseEventArgs());
        }
        else if (VisibleIds.FirstOrDefault() is var first && first != Guid.Empty) Select(first);
        RevealSelected();
        _catalogReady = true;
    }
}
