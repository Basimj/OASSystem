@page "/inventory/warehouses"
@page "/inventory/warehouses/{Screen}"
@page "/inventory/warehouses/{Screen}/{RecordId:guid}"
@attribute [Authorize]
@using OAS.Client.Inventory.Services
@using OAS.Client.Services.Browser
@using OAS.Contracts.Inventory
@using OAS.Contracts.Inventory.Warehouses

@using OAS.UiLib.Components.Spreadsheets
<PageTitle>@(IsFormRoute ? "نموذج المخزون" : "قائمة المخزون") - المخازن | OAS</PageTitle>
<span class="oas-inventory-view" hidden aria-hidden="true"></span>

<UiWorkspaceLayout ShowAside="false" ShowFilters="false">
    <Actions>
        <UiWorkspaceActionBar>
            @if (IsFormRoute)
            {
                <UiButton Text="العودة إلى القائمة" IconCssClass="fa-solid fa-arrow-right" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="BackToListAsync" />
                <UiButton Text="حفظ" IconCssClass="fa-solid fa-floppy-disk" Size="ControlSize.Small"
                      Disabled="@(!IsEditing)" Loading="@_saving" OnClick="SaveAsync" />
                <UiButton Text="تعديل" IconCssClass="fa-solid fa-pen" Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                      Disabled="@(!CanEdit)" OnClick="OpenEditScreenAsync" />
            }
            else
            {
                <UiButton Text="جديد" IconCssClass="fa-solid fa-plus" Size="ControlSize.Small"
                      Disabled="@IsEditing" OnClick="OpenCreateScreenAsync" />
                <UiButton Text="تحديث" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary" Size="ControlSize.Small"
                      Disabled="@IsEditing" Loading="@_loading" OnClick="RefreshAsync" />
                <UiSpreadsheetActions CanImport="true" Busy="@(_exporting || _spreadsheetBusy)" OnImport="OpenSpreadsheetImportAsync" OnTemplate="DownloadTemplateAsync" OnExport="ExportAsync" />
                <UiSearchInput @bind-Value="_search" Placeholder="ابحث بالكود أو اسم المخزن..."
                           AriaLabel="البحث في المخازن" ClearText="مسح البحث"
                           DebounceMilliseconds="250" OnSearch="SearchChangedAsync" />
            }
        </UiWorkspaceActionBar>
    </Actions>
    <Content>
        @if (IsFormRoute)
        {
            <div class="oas-inventory-form-screen">
                <div class="oas-inventory-form-screen__intro">
                    <div>
                        <div class="oas-inventory-form-screen__eyebrow">إدارة المخزون</div>
                        <h2>@EditorTitle</h2>
                        <p>راجع البيانات ثم احفظ التغييرات. الحقول الإضافية تظهر عند الحاجة.</p>
                    </div>
                </div>
                <div class="oas-inventory-form-screen__body">
        <UiCard Title="@EditorTitle" Subtitle="@(_selectedId.HasValue ? _code : null)">
            @if (_mode == EditorMode.Empty)
            {
                <UiAlert Message="اختر مخزنًا من القائمة أو اضغط «جديد»." />
            }
            else
            {
                <div class="inventory-warehouses__editor">
                    <UiInputText Label="كود المخزن"
                                 Value="@_code"
                                 ValueExpression="@(() => _code)"
                                 ValueChanged="@(v => SetField(CodeField, () => _code = v ?? string.Empty))"
                                 Required="true"
                                 ErrorText="@ErrorFor(CodeField)"
                                 MaxLength="32"
                                 Disabled="@(!IsEditing)"
                                 Size="ControlSize.Small" />

                    <UiInputText Label="اسم المخزن"
                                 Value="@_name"
                                 ValueExpression="@(() => _name)"
                                 ValueChanged="@(v => SetField(NameField, () => _name = v ?? string.Empty))"
                                 Required="true"
                                 ErrorText="@ErrorFor(NameField)"
                                 MaxLength="100"
                                 Disabled="@(!IsEditing)"
                                 Size="ControlSize.Small" />

                    <UiInputText Label="الوصف"
                                 Value="@_description"
                                 ValueExpression="@(() => _description)"
                                 ValueChanged="@(v => SetField(DescriptionField, () => _description = v))"
                                 Placeholder="(اختياري)"
                                 ErrorText="@ErrorFor(DescriptionField)"
                                 MaxLength="500"
                                 Disabled="@(!IsEditing)"
                                 Size="ControlSize.Small" />

                    <UiCheckbox Label="المخزن الافتراضي"
                                Value="@_isDefault"
                                ValueChanged="SetDefaultAsync"
                                ErrorText="@ErrorFor(DefaultField)"
                                Disabled="@(!IsEditing)" />

                    <UiCheckbox Label="يسمح بالحجز والبيع من هذا المخزن"
                                Value="@_allowsSalesAllocation"
                                ValueChanged="@(value => _allowsSalesAllocation = value)"
                                Disabled="@(!IsEditing)" />

                    <UiCheckbox Label="المخزن نشط"
                                Value="@_isActive"
                                ValueChanged="SetActiveAsync"
                                ErrorText="@ErrorFor(ActiveField)"
                                Disabled="@(!IsEditing || _mode == EditorMode.Create)" />
                </div>
            }
        </UiCard>

                </div>
            </div>
        }
        else
        {
        <UiDataGridPanel Title="المخازن" Subtitle="@($"{FilteredWarehouses.Count} مخزن")">
            <Body>
                @if (_loading)
                {
                    <UiAlert Message="جاري تحميل المخازن..." />
                }
                else
                {
                    <UiDataTable TItem="WarehouseDto" Items="@FilteredWarehouses" PageSize="12" Headers="@WarehouseHeaders" EmptyText="لا توجد مخازن مطابقة."
                                 SidebarTypography="true"
                                 UniformCellTypography="true"
                                 OnRowClick="@(x => OpenDetailsScreen(x.Id))" IsRowSelected="@(x => x.Id == _selectedId)">
                        <RowTemplate Context="warehouse">
                            <td>@warehouse.Code</td>
                            <td>@warehouse.Name</td>
                            <td>
                                @if (warehouse.IsDefault)
                                {
                                    <UiBadge Text="افتراضي" Tone="AlertTone.Info" />
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td><UiBadge Text="@(warehouse.AllowsSalesAllocation ? "متاح للبيع" : "حجر / غير مخصص للبيع")" Tone="@(warehouse.AllowsSalesAllocation ? AlertTone.Success : AlertTone.Warning)" /></td>
                            <td><UiBadge Text="@(warehouse.IsActive ? "نشط" : "غير نشط")" Tone="@(warehouse.IsActive ? AlertTone.Success : AlertTone.Danger)" /></td>
                        </RowTemplate>
                    </UiDataTable>
                }
            </Body>
        </UiDataGridPanel>

        }
    </Content>
</UiWorkspaceLayout>

@if (_spreadsheetImportOpen)
{
    <InventorySpreadsheetImportHost Section="warehouses"
                                    Title="المخازن"
                                    OnClose="CloseSpreadsheetImportAsync"
                                    OnImported="ReloadAfterSpreadsheetImportAsync" />
}

@code {
    // Each CRUD action has its own route. No editable form is mounted on the list screen.
    [Microsoft.AspNetCore.Components.Inject]
    private Microsoft.AspNetCore.Components.NavigationManager InventoryNavigation { get; set; } = default!;

    [Microsoft.AspNetCore.Components.Parameter]
    public string? Screen { get; set; }

    [Microsoft.AspNetCore.Components.Parameter]
    public Guid? RecordId { get; set; }

    private const string InventoryListRoute = "/inventory/warehouses";
    private bool IsFormRoute => Screen is "new" or "edit" or "details";
    private string? _appliedInventoryRoute;

    private Task OpenCreateScreenAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs _) {
        InventoryNavigation.NavigateTo($"{InventoryListRoute}/new");
        return Task.CompletedTask;
    }

    private Task OpenEditScreenAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs _) {
        if (_selectedId is { } id)
            InventoryNavigation.NavigateTo($"{InventoryListRoute}/edit/{id:D}");
        return Task.CompletedTask;
    }

    private void OpenDetailsScreen(Guid id) =>
        InventoryNavigation.NavigateTo($"{InventoryListRoute}/details/{id:D}");

    private Task BackToListAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs _) {
        InventoryNavigation.NavigateTo($"{InventoryListRoute}");
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Screen}/{RecordId}";
        if (_appliedInventoryRoute == key) return;
        _appliedInventoryRoute = key;
        if (Screen == "new")
            await BeginCreateAsync(new Microsoft.AspNetCore.Components.Web.MouseEventArgs());
        else if (RecordId is { } id && Screen is ("details" or "edit"))
        {
            _mode = EditorMode.Empty;
            Select(id);
            if (Screen == "edit")
                await BeginEditAsync(new Microsoft.AspNetCore.Components.Web.MouseEventArgs());
        }
        else
        {
            _selectedId = null;
            _mode = EditorMode.Empty;
        }
    }

    private enum EditorMode { Empty, View, Create, Edit }

    private const string CodeField = "كود المخزن";
    private const string NameField = "اسم المخزن";
    private const string DescriptionField = "الوصف";
    private const string DefaultField = "المخزن الافتراضي";
    private const string ActiveField = "المخزن نشط";

    [Inject] private IInventoryClientService Inventory { get; set; } = default!;
    [Inject] private InventorySpreadsheetClient SpreadsheetClient { get; set; } = default!;
    [Inject] private BrowserFileDownloadService SpreadsheetDownload { get; set; } = default!;
    [Inject] private IApiFeedbackService ApiFeedback { get; set; } = default!;
    [Inject] private IUiSnackbarService Snackbar { get; set; } = default!;

    private IReadOnlyList<WarehouseDto> _warehouses = [];
    private static readonly IReadOnlyList<string> WarehouseHeaders = ["الكود", "اسم المخزن", "الافتراضي", "سياسة البيع", "الحالة"];
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);
    private EditorMode _mode = EditorMode.Empty;
    private Guid? _selectedId;
    private bool _loading = true;
    private bool _exporting;
    private bool _spreadsheetBusy;
    private bool _spreadsheetImportOpen;
    private bool _saving;
    private string? _search;

    private string _code = string.Empty;
    private string _name = string.Empty;
    private string? _description;
    private bool _isDefault;
    private bool _isActive = true;
    private bool _allowsSalesAllocation = true;

    private bool IsEditing => _mode is EditorMode.Create or EditorMode.Edit;
    private bool CanEdit => _mode == EditorMode.View && _selectedId.HasValue;
    private string EditorTitle => _mode switch
    {
        EditorMode.Create => "مخزن جديد",
        EditorMode.Edit => "تعديل المخزن",
        EditorMode.View => "تفاصيل المخزن",
        _ => "تفاصيل المخزن"
    };

    private IReadOnlyList<WarehouseDto> FilteredWarehouses => _warehouses
        .Where(x => string.IsNullOrWhiteSpace(_search) ||
                    Match(_search, x.Code, x.Name, x.Description))
        .ToArray();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var page = await Inventory.GetWarehousesAsync(new PageRequest { PageNumber = 1, PageSize = PageRequest.MaximumPageSize });
            _warehouses = page.Items;
            if (_selectedId.HasValue && !_warehouses.Any(x => x.Id == _selectedId.Value))
            {
                _selectedId = null;
                _mode = EditorMode.Empty;
                ClearForm();
            }
        }
        catch (ApiClientException ex)
        {
            ApiFeedback.Show(ex.Error);
        }
        catch
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _loading = false;
        }
    }

    private Task RefreshAsync(MouseEventArgs args) => LoadAsync();
    private Task SearchChangedAsync(string? value) => Task.CompletedTask;

    private async Task BeginCreateAsync(MouseEventArgs args)
    {
        if (IsEditing) return;
        _selectedId = null;
        _mode = EditorMode.Create;
        ClearForm();
        _isActive = true;
        await AssignGeneratedCodeAsync(InventoryCodeKinds.Warehouse);
    }

    private Task BeginEditAsync(MouseEventArgs args)
    {
        if (CanEdit)
        {
            ClearValidation();
            _mode = EditorMode.Edit;
        }
        return Task.CompletedTask;
    }

    private Task CancelAsync(MouseEventArgs args)
    {
        ClearValidation();
        if (_selectedId.HasValue)
        {
            _mode = EditorMode.View;
            LoadSelected(_selectedId.Value);
        }
        else
        {
            _mode = EditorMode.Empty;
            ClearForm();
        }
        return Task.CompletedTask;
    }

    private async Task SaveAsync(MouseEventArgs args)
    {
        if (!IsEditing || _saving) return;
        if (!ValidateForm()) return;

        _saving = true;
        try
        {
            WarehouseDto? saved;
            if (_mode == EditorMode.Create)
            {
                saved = await Inventory.CreateWarehouseAsync(new CreateWarehouseRequest(
                    _code.Trim(), _name.Trim(), NullIfBlank(_description), _isDefault, _allowsSalesAllocation));
            }
            else
            {
                saved = await Inventory.UpdateWarehouseAsync(_selectedId!.Value, new UpdateWarehouseRequest(
                    _code.Trim(), _name.Trim(), NullIfBlank(_description), _isDefault, _isActive, _allowsSalesAllocation));
            }

            if (saved is null) return;
            _selectedId = saved.Id;
            _mode = EditorMode.View;
            await LoadAsync();
            LoadSelected(saved.Id);
            Snackbar.Success("تم حفظ المخزن بنجاح."); InventoryNavigation.NavigateTo(InventoryListRoute);
        }
        catch (ApiClientException ex)
        {
            if (string.Equals(ex.Error.Code, "unique_constraint_conflict", StringComparison.OrdinalIgnoreCase))
            {
                await LoadAsync();
                if (_warehouses.Any(x => x.Id != _selectedId && string.Equals(x.Code, _code.Trim(), StringComparison.OrdinalIgnoreCase)))
                {
                    SetError(CodeField, "هذا الكود مستخدم مسبقًا.");
                    Snackbar.Error("توجد بيانات غير صحيحة. راجع الحقول المميزة باللون الأحمر.");
                }
                else
                {
                    ApiFeedback.Show(ex.Error);
                }
            }
            else
            {
                ApiFeedback.Show(ex.Error);
            }
        }
        catch
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _saving = false;
        }
    }

    private bool ValidateForm()
    {
        ClearValidation();
        var missingRequired = false;

        if (string.IsNullOrWhiteSpace(_code))
        {
            SetError(CodeField, "هذا الحقل إجباري.");
            missingRequired = true;
        }
        if (string.IsNullOrWhiteSpace(_name))
        {
            SetError(NameField, "هذا الحقل إجباري.");
            missingRequired = true;
        }

        ValidateMaxLength(CodeField, _code, 32);
        ValidateMaxLength(NameField, _name, 100);
        ValidateMaxLength(DescriptionField, _description, 500);

        if (!string.IsNullOrWhiteSpace(_code) &&
            _warehouses.Any(x => x.Id != _selectedId && string.Equals(x.Code, _code.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            SetError(CodeField, "هذا الكود مستخدم مسبقًا.");
        }

        if (_isDefault)
        {
            var anotherDefault = _warehouses.Any(x => x.IsDefault && x.Id != _selectedId);
            if (anotherDefault)
                SetError(DefaultField, "يوجد مخزن افتراضي آخر. ألغِ تعيينه أولًا.");

            if (!_isActive)
            {
                SetError(DefaultField, "المخزن الافتراضي يجب أن يكون نشطًا.");
                SetError(ActiveField, "لا يمكن تعطيل المخزن وهو المخزن الافتراضي.");
            }
        }

        if (_fieldErrors.Count == 0) return true;

        Snackbar.Error(missingRequired
            ? "هناك بيانات إجبارية لم يتم إدخالها."
            : "توجد بيانات غير صحيحة. راجع الحقول المميزة باللون الأحمر.");
        return false;
    }

    private void ValidateMaxLength(string key, string? value, int max)
    {
        if (!string.IsNullOrEmpty(value) && value.Length > max)
            SetError(key, $"الحد الأقصى {max} حرفًا.");
    }

    private Task SetDefaultAsync(bool value)
    {
        _isDefault = value;
        ClearFieldError(DefaultField);
        if (!value) ClearFieldError(ActiveField);
        return Task.CompletedTask;
    }

    private async Task AssignGeneratedCodeAsync(string kind)
    {
        try
        {
            var suggestion = await Inventory.GetNextCodeAsync(kind);
            if (_mode == EditorMode.Create && suggestion is not null)
                _code = suggestion.Code;
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
    }

    private Task SetActiveAsync(bool value)
    {
        _isActive = value;
        ClearFieldError(ActiveField);
        if (value) ClearFieldError(DefaultField);
        return Task.CompletedTask;
    }

    private void Select(Guid id)
    {
        if (IsEditing || _saving) return;
        ClearValidation();
        _selectedId = id;
        _mode = EditorMode.View;
        LoadSelected(id);
    }

    private void LoadSelected(Guid id)
    {
        ClearValidation();
        var item = _warehouses.FirstOrDefault(x => x.Id == id);
        if (item is null) return;
        _code = item.Code;
        _name = item.Name;
        _description = item.Description;
        _isDefault = item.IsDefault;
        _isActive = item.IsActive;
        _allowsSalesAllocation = item.AllowsSalesAllocation;
    }

    private void ClearForm()
    {
        ClearValidation();
        _code = string.Empty;
        _name = string.Empty;
        _description = null;
        _isDefault = false;
        _isActive = true;
        _allowsSalesAllocation = true;
    }

    private string? ErrorFor(string key) => _fieldErrors.TryGetValue(key, out var error) ? error : null;
    private void SetError(string key, string message) => _fieldErrors[key] = message;
    private void ClearFieldError(string key) => _fieldErrors.Remove(key);
    private void ClearValidation() => _fieldErrors.Clear();

    private void SetField(string key, Action setter)
    {
        setter();
        ClearFieldError(key);
    }

    private static bool Match(string? search, params string?[] values)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;
        var term = search.Trim();
        return values.Any(x => x?.Contains(term, StringComparison.CurrentCultureIgnoreCase) == true);
    }

    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private Task OpenSpreadsheetImportAsync()
    {
        _spreadsheetImportOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseSpreadsheetImportAsync()
    {
        _spreadsheetImportOpen = false;
        return Task.CompletedTask;
    }

    private async Task ReloadAfterSpreadsheetImportAsync()
    {
        await LoadAsync();
    }

    private async Task DownloadTemplateAsync()
    {
        if (_spreadsheetBusy) return;
        _spreadsheetBusy = true;
        try
        {
            var bytes = await SpreadsheetClient.TemplateAsync("warehouses");
            await SpreadsheetDownload.SaveAsync(bytes, "inventory-warehouses-template.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch { ApiFeedback.ShowUnexpected(); }
        finally { _spreadsheetBusy = false; }
    }

    private async Task ExportAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var bytes = await SpreadsheetClient.ExportAsync("warehouses", new PageRequest { Search = _search });
            await SpreadsheetDownload.SaveAsync(bytes, "inventory-warehouses.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (ApiClientException ex) { ApiFeedback.Show(ex.Error); }
        catch (Exception) { ApiFeedback.ShowUnexpected(); }
        finally { _exporting = false; }
    }
}
