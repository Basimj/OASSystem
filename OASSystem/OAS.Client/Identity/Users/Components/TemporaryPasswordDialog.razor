<UiStackLayout Gap="StackGap.Small">
    <UiAlert Tone="AlertTone.Warning" Message="@Message" />
    <UiSecretValue Value="@TemporaryPassword" CopyText="@L["Users_CopyPassword"]" OnCopy="CopyAsync" />
    <UiTextLabel Text="@L["Users_TemporaryPasswordOneTime"]" Tone="TextTone.Muted" Size="ControlSize.Small" />
    <UiButton Text="@L["Common_Close"]" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="CloseAsync" />
</UiStackLayout>
