<UiStackLayout Gap="StackGap.Small">
    @if (Roles.Count == 0)
    {
        <UiAlert Message="@L["Users_RolesEmpty"]" />
    }
    else
    {
        @foreach (var role in Roles)
        {
            <UiKeyValue Label="@TranslateRole(role.Name)" Value="@role.Name" />
        }
    }
</UiStackLayout>
