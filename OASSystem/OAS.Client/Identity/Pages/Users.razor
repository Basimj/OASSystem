@page "/identity/users"
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>@L["Users_Title"]</PageTitle>

<UiWorkspaceLayout ShowAside="true" ShowFilters="false">
    <Actions>
        <UiWorkspaceActionBar>
            @if (Workspace.Mode is UserEditorMode.Create or UserEditorMode.Edit)
            {
                <UiButton Text="@L["Users_Save"]" IconCssClass="fa-solid fa-floppy-disk" Size="ControlSize.Small" Loading="_saving" OnClick="SaveAsync" />
                <UiButton Text="@L["Users_SaveClose"]" IconCssClass="fa-solid fa-check" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="_saving" OnClick="SaveAndCloseAsync" />
                <UiButton Text="@L["Users_Revert"]" IconCssClass="fa-solid fa-rotate-left" Variant="ButtonVariant.Ghost" Size="ControlSize.Small" Disabled="@(!Workspace.IsDirty)" OnClick="RevertAsync" />
            }
            else
            {
                <UiButton Text="@L["Users_New"]" IconCssClass="fa-solid fa-user-plus" Size="ControlSize.Small" OnClick="OpenNewAsync" />
                @if (Workspace.SelectedUserId.HasValue)
                {
                    <UiButton Text="@L["Users_Edit"]" IconCssClass="fa-solid fa-pen" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="BeginEditAsync" />
                    <UiButton Text="@L["Users_ResetPassword"]" IconCssClass="fa-solid fa-key" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="ResetPasswordAsync" />
                    @if (Workspace.Editor.Details is { } details)
                    {
                        <UiButton Text="@(details.IsActive ? L["Users_Deactivate"] : L["Users_Activate"])" IconCssClass="fa-solid fa-power-off" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="ToggleStatusAsync" />
                        @if (details.IsLocked)
                        {
                            <UiButton Text="@L["Users_Unlock"]" IconCssClass="fa-solid fa-lock-open" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" OnClick="UnlockAsync" />
                        }
                    }
                }
                <UiButton Text="@L["Users_Refresh"]" IconCssClass="fa-solid fa-rotate" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Loading="_loading" OnClick="RefreshAsync" />
                <UiButton Text="@L["Users_Export"]" IconCssClass="fa-solid fa-download" Variant="ButtonVariant.Secondary" Size="ControlSize.Small" Disabled="_exporting" Loading="_exporting" OnClick="ExportUsersAsync" />
            }

            <UiSearchInput @bind-Value="Workspace.Search"
                           Placeholder="@L["Users_Search"]"
                           AriaLabel="@L["Users_Search"]"
                           ClearText="@L["Users_ResetFilters"]"
                           DebounceMilliseconds="300"
                           OnSearch="SearchChangedAsync" />
        </UiWorkspaceActionBar>
    </Actions>

    <Content>
        <UiDataGridPanel Title="@L["Users_All"]" Subtitle="@string.Format(L["Users_TotalFormat"], _page.TotalCount)">
            <Toolbar>
                <div class="users-grid-filters">
                    <UiSelect @bind-Value="Workspace.StatusFilter"
                              Options="@StatusFilterOptions"
                              OnValueChanged="StatusFilterChangedAsync"
                              Size="ControlSize.Small" />
                    <UiSelect @bind-Value="Workspace.RoleFilter"
                              Placeholder="@L["Users_AllRoles"]"
                              Options="@RoleFilterOptions"
                              OnValueChanged="RoleFilterChangedAsync"
                              Size="ControlSize.Small" />
                </div>
            </Toolbar>
            <Header>
                <UiRecordListHeader Primary="@L["Users_Name"]"
                                    Column1="@L["Users_Email"]"
                                    Column2="@L["Users_Role"]"
                                    Column3="@L["Users_LastLogin"]"
                                    Trailing="@L["Users_Status"]" />
            </Header>
            <Body>
                @if (_loading)
                {
                    <UiAlert Message="@L["Loading"]" />
                }
                else if (_page.Items.Count == 0)
                {
                    <UiAlert Message="@L["Users_Empty"]" />
                }
                else
                {
                    @foreach (var user in _page.Items)
                    {
                        <UiRecordRow Title="@user.DisplayName"
                                     Subtitle="@user.UserName"
                                     Selected="@(Workspace.SelectedUserId == user.Id)"
                                     OnClick="@(() => SelectUserAsync(user))">
                            <Leading>
                                <UiAvatar Initials="@GetInitials(user.DisplayName)" ImageUrl="@GetUserImageUrl(user.Id)" AltText="@user.DisplayName" />
                            </Leading>
                            <Content>
                                <UiGrid Columns="3">
                                    <UiTextLabel Text="@(user.Email ?? "—")" Size="ControlSize.Small" Tone="TextTone.Muted" />
                                    <UiTextLabel Text="@FormatRoles(user.Roles)" Size="ControlSize.Small" Tone="TextTone.Muted" />
                                    <UiTextLabel Text="@FormatDate(user.LastLoginAtUtc)" Size="ControlSize.Small" Tone="TextTone.Muted" />
                                </UiGrid>
                            </Content>
                            <Trailing>
                                @if (user.IsLocked)
                                {
                                    <UiBadge Text="@L["Users_Locked"]" Tone="AlertTone.Danger" />
                                }
                                @if (user.MustChangePassword)
                                {
                                    <UiBadge Text="@L["Users_PasswordSetupRequired"]" Tone="AlertTone.Warning" />
                                }
                                <UiBadge Text="@(user.IsActive ? L["Users_Active"] : L["Users_Inactive"])" Tone="@(user.IsActive ? AlertTone.Success : AlertTone.Danger)" />
                            </Trailing>
                        </UiRecordRow>
                    }
                }
            </Body>
            <Footer>
                <UiPagination PageNumber="@_page.PageNumber" TotalPages="@_page.TotalPages" TotalCount="@_page.TotalCount" OnPrevious="PreviousPageAsync" OnNext="NextPageAsync" />
            </Footer>
        </UiDataGridPanel>
    </Content>

    <Aside>
        <div class="users-aside-stack">
            <UiCard Title="@L["Users_Details"]">
                @if (Workspace.IsLoading)
                {
                    <UiAlert Message="@L["Loading"]" />
                }
                else if (Workspace.Mode == UserEditorMode.Empty)
                {
                    <UiDetailsHeader Initials="" Title="@L["Users_Details"]" Subtitle="@L["Users_Empty"]" />
                }
                else
                {
                    <UiDetailsHeader Initials="@GetInitials(EditorTitle)"
                                     ImageUrl="@SelectedImageUrl"
                                     Title="@EditorTitle"
                                     Subtitle="@GetEditorSubtitle()"
                                     StatusText="@GetEditorStatusText()"
                                     StatusTone="@GetEditorStatusTone()" />
                }
            </UiCard>

            <div class="users-editor-host">
                <UserEditor @ref="_editorComponent"
                            State="@Workspace.Editor"
                            Mode="@Workspace.Mode"
                            Roles="@_roles"
                            ImageUrl="@SelectedImageUrl"
                            OnImageSelected="UserImageSelectedAsync"
                            OnImageRemoved="UserImageRemovedAsync" />
            </div>
        </div>
    </Aside>
</UiWorkspaceLayout>
