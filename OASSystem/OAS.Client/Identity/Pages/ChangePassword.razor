@page "/identity/change-password"
@attribute [Authorize]
@inject IAuthClientService AuthService
@inject OasAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IApiFeedbackService ApiFeedback
@inject IUiSnackbarService Snackbar

<PageTitle>@L["ChangePassword_Title"]</PageTitle>

<UiPage Placement="PagePlacement.Center">
    <UiCard Width="SurfaceWidth.Compact">
        <UiForm Model="_model" OnSubmit="SubmitAsync">
            <UiStackLayout Gap="StackGap.Small">
                <UiTextLabel Text="@L["ChangePassword_Title"]" Weight="TextWeight.Bold" />
                <UiInputText @bind-Value="_model.CurrentPassword"
                             Type="password"
                             RevealPassword="true"
                             Label="@L["ChangePassword_Current"]"
                             Required="true"
                             EnableNativeValidation="false"
                             Size="ControlSize.Small"
                             AutoComplete="current-password" />
                <UiInputText @bind-Value="_model.NewPassword"
                             Type="password"
                             RevealPassword="true"
                             Label="@L["ChangePassword_New"]"
                             Required="true"
                             EnableNativeValidation="false"
                             Size="ControlSize.Small"
                             AutoComplete="new-password" />
                <UiInputText @bind-Value="_model.ConfirmPassword"
                             Type="password"
                             RevealPassword="true"
                             Label="@L["ChangePassword_Confirm"]"
                             Required="true"
                             EnableNativeValidation="false"
                             Size="ControlSize.Small"
                             AutoComplete="new-password" />
                <UiButton Type="submit"
                          Text="@L["ChangePassword_Button"]"
                          Loading="_saving"
                          FullWidth="true"
                          Size="ControlSize.Small" />
            </UiStackLayout>
        </UiForm>
    </UiCard>
</UiPage>

@code {
    private readonly Model _model = new();
    private bool _saving;

    private async Task SubmitAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            var result = await AuthService.ChangePasswordAsync(
                new ChangePasswordRequest(_model.CurrentPassword, _model.NewPassword, _model.ConfirmPassword));

            if (!result.Succeeded || result.Value is null)
            {
                if (result.Error is not null) ApiFeedback.Show(result.Error);
                else ApiFeedback.ShowUnexpected();
                return;
            }

            AuthState.SetAuthenticated(result.Value);
            Snackbar.Success(L["password_change_success"]);
            Navigation.NavigateTo("/", replace: true);
        }
        catch (OperationCanceledException) { }
        catch
        {
            ApiFeedback.ShowUnexpected();
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class Model
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
