@page "/identity/password-setup"
@attribute [Authorize]

<PageTitle>@L["PasswordSetup_Title"]</PageTitle>

<UiPage Placement="PagePlacement.Center">
    <UiCard Width="SurfaceWidth.Compact" Title="@L["PasswordSetup_Title"]" Subtitle="@L["PasswordSetup_Subtitle"]">
        <UiForm Model="_model" OnSubmit="SubmitAsync">
            <UiStackLayout Gap="StackGap.Small">
                <UiAlert Tone="AlertTone.Info" Message="@L["PasswordSetup_RequiredMessage"]" />
                <UiInputText @bind-Value="_model.NewPassword"
                             Type="password"
                             RevealPassword="true"
                             Label="@L["PasswordSetup_New"]"
                             Required="true"
                             EnableNativeValidation="false"
                             Size="ControlSize.Small"
                             AutoComplete="new-password" />
                <UiInputText @bind-Value="_model.ConfirmPassword"
                             Type="password"
                             RevealPassword="true"
                             Label="@L["PasswordSetup_Confirm"]"
                             Required="true"
                             EnableNativeValidation="false"
                             Size="ControlSize.Small"
                             AutoComplete="new-password" />
                <UiTextLabel Text="@L["Users_PasswordPolicy"]" Tone="TextTone.Muted" Size="ControlSize.Small" />
                <UiButton Type="submit"
                          Text="@L["PasswordSetup_Button"]"
                          Loading="_saving"
                          FullWidth="true"
                          Size="ControlSize.Small" />
            </UiStackLayout>
        </UiForm>
    </UiCard>
</UiPage>
