<Window x:Class="OAS.Print.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OAS Print"
        Width="1360"
        Height="800"
        MinWidth="960"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        FlowDirection="RightToLeft"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Grid Background="{StaticResource OasBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Global header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource OasBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight">
                    <Border Background="{StaticResource OasPrimarySoftBrush}"
                            BorderBrush="{StaticResource OasPrimaryBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot"
                                     Width="8"
                                     Height="8"
                                     Fill="#98A2B3"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeaderConnectionText"
                                       Text="جاري فحص الاتصال"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Width="1" Height="34" Background="{StaticResource OasBorderBrush}" Margin="6,0,12,0"/>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="UserText"
                                   Text="المستخدم"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource OasTextBrush}"/>
                        <TextBlock Text="مستخدم محطة الطباعة"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="ClockText"
                                   Text="00:00:00"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="DateText"
                                   Text="00/00/0000"
                                   Style="{StaticResource MutedTextStyle}"
                                   FlowDirection="LeftToRight"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="OAS SYSTEM"
                                   FontSize="21"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource OasHeaderBrush}"
                                   FlowDirection="LeftToRight"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="مركز الطباعة وإدارة القوالب"
                                   FontSize="11.5"
                                   Foreground="{StaticResource OasMutedTextBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Width="46" Height="46"
                            Background="{StaticResource OasPrimaryBrush}"
                            CornerRadius="12">
                        <TextBlock Text="P"
                                   Foreground="White"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FlowDirection="LeftToRight"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- App body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Main navigation -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource OasBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="14,18,14,10">
                        <TextBlock Text="الطباعة"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource OasMutedTextBrush}"
                                   Margin="8,0,8,8"/>

                        <Button x:Name="NavDashboardButton"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavDashboard_Click"
                                Content="⌂   الرئيسية"/>
                        <Button x:Name="NavTemplatesButton"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavTemplates_Click"
                                Content="▤   القوالب"/>
                        <Button x:Name="NavDesignerButton"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavDesigner_Click"
                                Content="✎   مصمم القوالب"/>
                        <Button x:Name="NavJobsButton"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavJobs_Click"
                                Content="↻   سجل الطباعة"/>
                        <Button x:Name="NavPrintersButton"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavPrinters_Click"
                                Content="▣   الطابعات"/>

                        <Separator Margin="8,12"/>

                        <Button x:Name="NavSettingsButton"
                                Style="{StaticResource NavButtonStyle}"
                                Click="NavSettings_Click"
                                Content="⚙   الإعدادات"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="12"
                            Background="{StaticResource OasPrimarySoftBrush}"
                            BorderBrush="{StaticResource OasPrimaryBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="محطة الطباعة"
                                       FontSize="11"
                                       Foreground="{StaticResource OasMutedTextBrush}"/>
                            <TextBlock x:Name="SidebarWorkstationText"
                                       Text="DEFAULT"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OasPrimaryBrush}"
                                       Margin="0,3,0,8"
                                       FlowDirection="LeftToRight"/>
                            <TextBlock x:Name="SidebarPrinterText"
                                       Text="لم تحدد طابعة"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content area -->
            <Grid Grid.Column="1" Margin="18">

                <!-- DASHBOARD -->
                <Grid x:Name="DashboardPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="مركز الطباعة" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="إدارة القوالب والطابعات ومهام الطباعة من OAS في مكان واحد."
                                       Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="فتح المصمم"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="NavDesigner_Click"
                                Padding="18,8"/>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="القوالب" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="TemplatesCountText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="قوالب جاهزة ومتاحة" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="الطابعات" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="PrintersCountText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="طابعات Windows المتاحة" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="مهام الجلسة" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="JobsCountText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="المهام المستلمة منذ التشغيل" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="تم بنجاح" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="SuccessJobsCountText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock Text="مهام طباعة مكتملة" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="آخر مهام الطباعة" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Right"/>
                                    <Button Content="عرض السجل" Style="{StaticResource ToolbarButtonStyle}" Click="NavJobs_Click" DockPanel.Dock="Left"/>
                                </DockPanel>
                                <DataGrid x:Name="DashboardJobsGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="الوقت" Binding="{Binding ReceivedAt, StringFormat=HH:mm:ss}" Width="90"/>
                                        <DataGridTextColumn Header="المستند" Binding="{Binding DocumentName}" Width="*"/>
                                        <DataGridTextColumn Header="الرقم" Binding="{Binding DocumentNumber}" Width="130"/>
                                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="جاهزية محطة الطباعة" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="يعمل برنامج الطباعة بشكل مستقل، ويستقبل المهام من OAS API عند توفر الاتصال."
                                           Style="{StaticResource PageSubtitleStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,16"/>

                                <Border Background="{StaticResource OasPrimarySoftBrush}"
                                        BorderBrush="{StaticResource OasPrimaryBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="الطابعة الافتراضية" Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock x:Name="DashboardPrinterText" Text="-" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC"
                                        BorderBrush="{StaticResource OasBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="عنوان OAS API" Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock x:Name="DashboardApiText" Text="-" FontSize="12" Margin="0,4,0,0" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- TEMPLATES -->
                <Grid x:Name="TemplatesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right">
                            <TextBlock Text="القوالب" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="إدارة قوالب المستندات وتحديد القالب الافتراضي لكل نوع."
                                       Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" FlowDirection="LeftToRight">
                            <Button Content="قالب جديد" Style="{StaticResource ToolbarButtonStyle}" Click="NewTemplate_Click"/>
                            <Button Content="نسخ" Style="{StaticResource ToolbarButtonStyle}" Click="DuplicateTemplate_Click"/>
                            <Button Content="فتح في المصمم" Style="{StaticResource PrimaryButtonStyle}" Click="OpenSelectedTemplateInDesigner_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="قوالب الطباعة" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                                <ListBox x:Name="TemplatesList"
                                         Grid.Row="1"
                                         DisplayMemberPath="Name"
                                         SelectionChanged="TemplatesList_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="القالب المحدد" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="TemplateSummaryName" Text="-" FontSize="22" FontWeight="Bold" Margin="0,12,0,4"/>
                                <TextBlock x:Name="TemplateSummaryCode" Text="-" Foreground="{StaticResource OasPrimaryBrush}" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                <Separator Margin="0,18"/>
                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource MiniInfoCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="نوع المستند" Style="{StaticResource MutedTextStyle}"/>
                                            <TextBlock x:Name="TemplateSummaryType" Text="-" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MiniInfoCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="مقاس الورق" Style="{StaticResource MutedTextStyle}"/>
                                            <TextBlock x:Name="TemplateSummaryPaper" Text="-" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MiniInfoCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="العناصر" Style="{StaticResource MutedTextStyle}"/>
                                            <TextBlock x:Name="TemplateSummaryElements" Text="0" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Separator Margin="0,18"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="معاينة" Style="{StaticResource ToolbarButtonStyle}" Click="Preview_Click"/>
                                    <Button Content="طباعة تجريبية" Style="{StaticResource ToolbarButtonStyle}" Click="Print_Click"/>
                                    <Button Content="حذف القالب" Style="{StaticResource DangerButtonStyle}" Click="DeleteTemplate_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- DESIGNER -->
                <Grid x:Name="DesignerPanel" Visibility="Collapsed" FlowDirection="LeftToRight">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="10"
                            Margin="0,0,0,10"
                            FlowDirection="RightToLeft">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ComboBox x:Name="DesignerTemplateCombo"
                                          Width="240"
                                          Margin="3"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="DesignerTemplateCombo_SelectionChanged"/>
                                <Button Content="جديد" Style="{StaticResource ToolbarButtonStyle}" Click="NewTemplate_Click"/>
                                <Button Content="حفظ" Style="{StaticResource PrimaryButtonStyle}" Click="SaveTemplate_Click"/>
                                <Button Content="نسخ" Style="{StaticResource ToolbarButtonStyle}" Click="DuplicateTemplate_Click"/>
                                <Button Content="معاينة" Style="{StaticResource ToolbarButtonStyle}" Click="Preview_Click"/>
                                <Button Content="طباعة" Style="{StaticResource ToolbarButtonStyle}" Click="Print_Click"/>
                                <Button Content="بيانات JSON" Style="{StaticResource ToolbarButtonStyle}" Click="LoadData_Click"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Left"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        FlowDirection="LeftToRight">
                                <Button Content="−" Width="34" Style="{StaticResource ToolbarButtonStyle}" Click="ZoomOut_Click"/>
                                <Slider x:Name="ZoomSlider"
                                        Width="145"
                                        Minimum="25"
                                        Maximum="200"
                                        Value="100"
                                        TickFrequency="25"
                                        Margin="6,0"
                                        ValueChanged="ZoomSlider_ValueChanged"/>
                                <Button Content="+" Width="34" Style="{StaticResource ToolbarButtonStyle}" Click="ZoomIn_Click"/>
                                <TextBlock x:Name="ZoomText" Text="100%" Width="52" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Content="100%" Style="{StaticResource ToolbarButtonStyle}" Click="ActualSize_Click"/>
                                <Button Content="احتواء" Style="{StaticResource ToolbarButtonStyle}" Click="FitToScreen_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>

                        <!-- Toolbox -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" FlowDirection="RightToLeft">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="إضافة عنصر" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="اسحب العناصر بعد إضافتها إلى موضعها داخل الورقة."
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,12"/>
                                    <Button Content="نص ثابت" Style="{StaticResource ToolPaletteButtonStyle}" Click="AddText_Click"/>
                                    <Button Content="حقل بيانات" Style="{StaticResource ToolPaletteButtonStyle}" Click="AddField_Click"/>
                                    <Button Content="جدول" Style="{StaticResource ToolPaletteButtonStyle}" Click="AddTable_Click"/>
                                    <Button Content="صورة / شعار" Style="{StaticResource ToolPaletteButtonStyle}" Click="AddImage_Click"/>
                                    <Button Content="بطاقة / مستطيل" Style="{StaticResource ToolPaletteButtonStyle}" Click="AddRectangle_Click"/>
                                    <Button Content="خط" Style="{StaticResource ToolPaletteButtonStyle}" Click="AddLine_Click"/>
                                    <Separator Margin="0,12"/>
                                    <CheckBox x:Name="SnapCheck" Content="محاذاة تلقائية 1 مم" IsChecked="True"/>
                                    <Button Content="حذف العنصر المحدد" Style="{StaticResource DangerButtonStyle}" Click="DeleteElement_Click" Margin="0,12,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Canvas -->
                        <Border Grid.Column="2"
                                Background="#EDEFF4"
                                BorderBrush="{StaticResource OasBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="0">
                            <ScrollViewer x:Name="DesignerScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Top"
                                          PreviewMouseWheel="DesignerScrollViewer_PreviewMouseWheel">
                                <Border x:Name="DesignerPageBorder"
                                        Background="White"
                                        BorderBrush="#C8CCD5"
                                        BorderThickness="1"
                                        Margin="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        SnapsToDevicePixels="True">
                                    <Border.LayoutTransform>
                                        <ScaleTransform x:Name="DesignerScaleTransform" ScaleX="1" ScaleY="1"/>
                                    </Border.LayoutTransform>
                                    <Canvas x:Name="DesignerCanvas"
                                            Background="White"
                                            PreviewMouseLeftButtonDown="DesignerCanvas_MouseLeftButtonDown"
                                            PreviewMouseMove="DesignerCanvas_MouseMove"
                                            PreviewMouseLeftButtonUp="DesignerCanvas_MouseLeftButtonUp"/>
                                </Border>
                            </ScrollViewer>
                        </Border>

                        <!-- Properties -->
                        <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" FlowDirection="RightToLeft">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="خصائص القالب" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="الاسم" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TemplateNameText" TextChanged="TemplateHeader_Changed"/>
                                    <TextBlock Text="الكود" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TemplateCodeText" TextChanged="TemplateHeader_Changed" FlowDirection="LeftToRight"/>
                                    <TextBlock Text="نوع المستند" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="DocumentTypeCombo" SelectionChanged="DocumentTypeCombo_SelectionChanged"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="عرض الورق (مم)" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="PaperWidthText" TextChanged="TemplateHeader_Changed" FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="ارتفاع الورق (مم)" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="PaperHeightText" TextChanged="TemplateHeader_Changed" FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="LandscapeCheck" Content="اتجاه أفقي Landscape" Checked="TemplateHeaderCheck_Changed" Unchecked="TemplateHeaderCheck_Changed"/>
                                    <CheckBox x:Name="DefaultTemplateCheck" Content="القالب الافتراضي لهذا النوع" Checked="TemplateHeaderCheck_Changed" Unchecked="TemplateHeaderCheck_Changed"/>

                                    <Separator Margin="0,12"/>
                                    <TextBlock Text="خصائص العنصر" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="SelectedElementTypeText" Text="لم يتم تحديد عنصر" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,8"/>
                                    <TextBlock Text="اسم العنصر" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="ElementNameText"/>
                                    <TextBlock Text="النص" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="ContentText" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                                    <TextBlock Text="مسار الحقل" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="FieldPathCombo" IsEditable="True" DisplayMemberPath="DisplayName" SelectedValuePath="Path"/>
                                    <TextBlock Text="التنسيق (مثال N2 أو yyyy/MM/dd)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="FormatText" FlowDirection="LeftToRight"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="X مم" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="XText" FlowDirection="LeftToRight"/>
                                            <TextBlock Text="العرض مم" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="WidthText" FlowDirection="LeftToRight"/>
                                            <TextBlock Text="حجم الخط" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="FontSizeText" FlowDirection="LeftToRight"/>
                                            <TextBlock Text="الـ Padding مم" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="PaddingText" FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Y مم" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="YText" FlowDirection="LeftToRight"/>
                                            <TextBlock Text="الارتفاع مم" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="HeightText" FlowDirection="LeftToRight"/>
                                            <TextBlock Text="سمك الحد/الخط" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="BorderText" FlowDirection="LeftToRight"/>
                                            <TextBlock Text="استدارة الزوايا مم" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="CornerRadiusText" FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="ألوان العنصر (Hex)" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="ForegroundText" ToolTip="لون النص" FlowDirection="LeftToRight" Margin="0,4,3,8"/>
                                        <TextBox Grid.Column="1" x:Name="BackgroundText" ToolTip="لون الخلفية" FlowDirection="LeftToRight" Margin="3,4,3,8"/>
                                        <TextBox Grid.Column="2" x:Name="BorderColorText" ToolTip="لون الحد" FlowDirection="LeftToRight" Margin="3,4,0,8"/>
                                    </Grid>

                                    <TextBlock Text="المحاذاة" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="AlignmentCombo" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="يمين" Tag="Right"/>
                                        <ComboBoxItem Content="وسط" Tag="Center"/>
                                        <ComboBoxItem Content="يسار" Tag="Left"/>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="BoldCheck" Content="عريض Bold" Margin="0,6,14,6"/>
                                        <CheckBox x:Name="RtlCheck" Content="RTL" Margin="0,6"/>
                                    </StackPanel>

                                    <TextBlock Text="إعدادات الجدول" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="RowHeightText" ToolTip="ارتفاع الصف مم" FlowDirection="LeftToRight" Margin="0,4,4,8"/>
                                        <TextBox Grid.Column="1" x:Name="MaxRowsText" ToolTip="أقصى عدد صفوف" FlowDirection="LeftToRight" Margin="4,4,0,8"/>
                                    </Grid>

                                    <TextBlock Text="مسار الصورة/الشعار" Style="{StaticResource FieldLabelStyle}"/>
                                    <DockPanel>
                                        <Button Content="..." Width="42" Click="BrowseImage_Click" DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}"/>
                                        <TextBox x:Name="ImagePathText" FlowDirection="LeftToRight"/>
                                    </DockPanel>

                                    <Button Content="تطبيق خصائص العنصر"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            FontWeight="SemiBold"
                                            Click="ApplyElement_Click"
                                            Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- JOBS -->
                <Grid x:Name="JobsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="سجل الطباعة" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="سجل مهام الطباعة المستلمة أثناء جلسة تشغيل البرنامج الحالية."
                                   Style="{StaticResource PageSubtitleStyle}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                        <DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="وقت الاستلام" Binding="{Binding ReceivedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="160"/>
                                <DataGridTextColumn Header="نوع المستند" Binding="{Binding DocumentName}" Width="150"/>
                                <DataGridTextColumn Header="رقم المستند" Binding="{Binding DocumentNumber}" Width="140"/>
                                <DataGridTextColumn Header="الطابعة" Binding="{Binding PrinterName}" Width="*"/>
                                <DataGridTextColumn Header="النسخ" Binding="{Binding Copies}" Width="70"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="110"/>
                                <DataGridTextColumn Header="التفاصيل" Binding="{Binding Error}" Width="240"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- PRINTERS -->
                <Grid x:Name="PrintersPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="الطابعات" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="عرض طابعات Windows المتاحة وتحديد الطابعة الافتراضية للمحطة."
                                   Style="{StaticResource PageSubtitleStyle}"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="الطابعات المتاحة" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Right"/>
                                    <Button Content="تحديث" Style="{StaticResource ToolbarButtonStyle}" Click="RefreshPrinters_Click" DockPanel.Dock="Left"/>
                                </DockPanel>
                                <ListBox x:Name="PrintersList" Grid.Row="1"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="الطابعة الافتراضية" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="تستخدم عندما لا يحدد OAS طابعة معينة للمهمة."
                                           Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,12"/>
                                <ComboBox x:Name="DefaultPrinterCombo"/>
                                <Button Content="حفظ الطابعة الافتراضية" Style="{StaticResource PrimaryButtonStyle}" Click="SaveDefaultPrinter_Click"/>
                                <Separator Margin="0,18"/>
                                <TextBlock Text="الطابعة النشطة في المصمم" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="PrinterCombo" SelectionChanged="PrinterCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- SETTINGS -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="الإعدادات" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="إعداد اتصال محطة الطباعة بـ OAS وسلوك استقبال المهام."
                                   Style="{StaticResource PageSubtitleStyle}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="900" HorizontalAlignment="Right">
                            <StackPanel>
                                <TextBlock Text="اتصال OAS API" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="عنوان API" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="SettingsApiUrlText" FlowDirection="LeftToRight"/>
                                <TextBlock Text="رمز محطة العمل" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="SettingsWorkstationText" FlowDirection="LeftToRight"/>
                                <TextBlock Text="اسم مستخدم محطة الطباعة" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="SettingsOperatorText"/>
                                <TextBlock Text="Print API Key (اختياري)" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox x:Name="SettingsApiKeyBox" FlowDirection="LeftToRight"/>
                                <CheckBox x:Name="SettingsPollCheck" Content="استقبال مهام الطباعة من OAS API"/>
                                <TextBlock Text="فترة الفحص بالثواني (1 - 60)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="SettingsIntervalText" Width="140" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                                <Separator Margin="0,16"/>
                                <TextBlock Text="الطابعة الافتراضية" Style="{StaticResource SectionTitleStyle}"/>
                                <ComboBox x:Name="SettingsPrinterCombo"/>
                                <TextBlock Text="توجيه الطباعة حسب نوع المستند" Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,4"/>
                                <TextBlock Text="سندات القبض" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="SettingsReceiptPrinterCombo"/>
                                <TextBlock Text="سندات الصرف" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="SettingsPaymentPrinterCombo"/>
                                <TextBlock Text="فواتير المبيعات" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="SettingsSalesInvoicePrinterCombo"/>
                                <TextBlock Text="فواتير المشتريات" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="SettingsPurchaseInvoicePrinterCombo"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button Content="حفظ الإعدادات" Style="{StaticResource PrimaryButtonStyle}" Click="SaveSettingsInline_Click"/>
                                    <Button Content="إعادة تحميل" Style="{StaticResource ToolbarButtonStyle}" Click="ReloadSettings_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#24213B" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ConnectionText"
                           Grid.Column="0"
                           Foreground="#D0CBDF"
                           Text="OAS Print"
                           VerticalAlignment="Center"
                           FlowDirection="LeftToRight"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Foreground="White"
                           Text="جاهز"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
